{
  "name": "connected-lectures",
  "scripts": {
    "watch": "npx parcel serve src/index.html --open",
    "build": "rm -rf docs && npx parcel build src/index.html --dist-dir docs --public-url . && npm run sw",
    "sw": "npx workbox injectManifest workbox-config.js"
  },
  "browserslist": [
    "cover 95.0%"
  ],
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.15.4",
    "@parcel/transformer-vue": "^2.15.4",
    "@parcel/transformer-webmanifest": "^2.15.4",
    "parcel": "^2.15.4",
    "parcel-reporter-static-files-copy": "^1.5.3",
    "vue": "^3.5.17",
    "vuetify": "^3.9.0",
    "workbox-cli": "^7.1.0"
  },
  "dependencies": {
    "@comunica/query-sparql": "^4.3.0",
    "@mdi/font": "^7.4.47",
    "3d-force-graph": "^1.78.4",
    "splitpanes": "^4.0.4",
    "three": "^0.178.0"
  },
  "alias": {
    "three/webgpu": "./node_modules/three/build/three.webgpu.js"
  }
}
