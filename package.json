    "vue": "^3.5.17",
    "vuetify": "^3.9.0"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "3d-force-graph": "^1.78.4",
    "three": "^0.178.0"
  },
  "alias": {
