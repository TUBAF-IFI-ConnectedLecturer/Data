oer:6-OuQNqvr40E a edu:LearningResource ;
    sim:similarTo oer:6E-_zenMLTwc,
        oer:9NUSW9eh1Jc0,
        oer:9YbHAZOD42KA,
        oer:9wAjsR0aqZ_M ;
    dcterms:creator <http://example.org/education/person/Mascel> ;
    dcterms:description "In diesem Praktikumsbericht werden die Kennlinien linearer und nichtlinearer Spannungsquellen untersucht und verglichen. Die Messwerte werden in Diagrammen dargestellt, um die Effizienz von Solarzellen in Parallel- und Reihenschaltung zu ermitteln. Durch diese Untersuchung können Studierende die Grundlagen der Elektrotechnik und die Messmethoden für Strom- und Spannungsquellen kennenlernen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6-OuQNqvr40E" ;
    dcterms:subject <http://example.org/education/concept/Elektromesstechnik>,
