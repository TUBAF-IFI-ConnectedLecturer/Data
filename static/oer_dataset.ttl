    dcterms:title "Veränderungen in unserer Gesellschaft"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:12AmBJ9GcLiZI a edu:LearningResource ;
    dcterms:description "Die Vorlesung behandelt die parasoziale Interaktion zwischen Zuschauern und Medienfiguren, insbesondere im Fernsehen, und erläutert die Merkmale, Funktionen und Auswirkungen dieser Beziehung auf die Zuschauer. Durch die Lektüre dieser Materialien können Lerner ein Verständnis dafür entwickeln, wie Medien unsere sozialen Beziehungen beeinflussen und wie wir unsere Erfahrungen mit Medienfiguren interpretieren. Die Vorlesung bietet einen Überblick über die Forschungsergebnisse zu diesem Thema und hilft bei der Reflexion über die Rolle von Medien in unserem Alltag."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12AmBJ9GcLiZI" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Altersforschung>,
        <http://example.org/education/concept/Bildungsforschung>,
        <http://example.org/education/concept/Fernsehen>,
        <http://example.org/education/concept/Fernsehkonsum>,
        <http://example.org/education/concept/Kommunikationsmodell>,
        <http://example.org/education/concept/Medienrezeption>,
        <http://example.org/education/concept/Medienwissenschaft>,
        <http://example.org/education/concept/Parasoziale_Beziehung>,
        <http://example.org/education/concept/Soziale_Interaktion>,
        <http://example.org/education/concept/Soziologie> ;
    dcterms:title "Parasoziale Interaktion"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

