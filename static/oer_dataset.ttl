oer:9VxGJapQeb7o a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Coch%C3%A9>,
        <http://example.org/education/person/Georgiev>,
        <http://example.org/education/person/Knollmann> ;
    dcterms:description "Das BOXconcept ist ein nachhaltiges Verpackungssystem, das herkömmliche Verpackungen durch wiederverwendbare Behälter ersetzen soll, um Verpackungsmüll vollständig zu verhindern und einen nachhaltigen Konsum zu etablieren. Durch die Implementierung des Systems soll eine kreislauffähige Wirtschaft im Jahr 2050 erreicht werden. Die Umsetzung des BOXconcepts erfordert die Zusammenarbeit von Unternehmen, Politik und Gesellschaft, um eine umfassende Lösung für das Problem der nicht abbaubaren Plastikmüll zu finden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9VxGJapQeb7o" ;
    dcterms:subject <http://example.org/education/concept/Bev%C3%B6lkerungswachstum>,
        <http://example.org/education/concept/Einwegplastik>,
        <http://example.org/education/concept/Kreislaufwirtschaft>,
        <http://example.org/education/concept/Lebensmittelverschwendung>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Pfandsysteme>,
        <http://example.org/education/concept/Plastikabbau>,
        <http://example.org/education/concept/Recycling>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Verpackungssysteme> ;
    dcterms:title "BOXconcept waste less, live more Strategieentwicklung"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:9WRZSAQY7RiE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hoerrmann> ;
    dcterms:description "Künstliche Intelligenz (KI) spielt eine entscheidende Rolle in der Steuerung und Optimierung von Bewegungsabläufen humanoider Roboter, indem sie eﬀiziente und menschenähnliche Bewegungen ermöglicht. Durch die Integration von KI in Robotersysteme können diese komplexe Aufgaben mit Anpassungsfähigkeit und Präzision ausführen, insbesondere in industriellen und medizinischen Anwendungen. Die Forschung konzentriert sich auf die weitere Integration von KI in physikalische Robotersysteme und die Erforschung neuer Paradigmen in der Mensch-Roboter-Interaktion."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9WRZSAQY7RiE" ;
    dcterms:publisher <http://example.org/education/organization/HTWK_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Bewegungssteuerung>,
        <http://example.org/education/concept/Bildverarbeitung>,
        <http://example.org/education/concept/Deep_Reinforcement_Learning>,
        <http://example.org/education/concept/Echtzeit-Datenverarbeitung>,
        <http://example.org/education/concept/Industrielle_Anwendungen>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Medizinische_Anwendungen>,
        <http://example.org/education/concept/Mensch-Roboter-Interaktion>,
        <http://example.org/education/concept/Neuronale_Netze>,
        <http://example.org/education/concept/Robotik> ;
    dcterms:title "KI-gesteuerte Bewegungsabläufe von Robotern"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:9XFmjOPhnVyc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Sell> ;
    dcterms:description "Der Reisetrend Coolcation konzentriert sich auf die Auswahl von Urlaubszielen mit gemäßigtem oder kühlem Klima, um extreme Hitze zu vermeiden und neue Naturerfahrungen zu sammeln. Durch den fortschreitenden Klimawandel und die damit einhergehenden Hitzewellen in klassischen Urlaubsländern gewinnt Coolcation an Relevanz für die Tourismusbranche. Lernende können aus diesem Dokument Kenntnisse über die Zielgruppen, Vorteile und Risiken von Coolcation sowie die Bedeutung nachhaltigen Tourismus für die Umwelt und die Wirtschaft gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9XFmjOPhnVyc" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Did_Not_Find_Any_Hints_About_The_Author%27s_Institution_Of_Origin._Therefore__I_Will_Return_An_Empty_String.> ;
    dcterms:subject <http://example.org/education/concept/%C3%96kotourismus>,
        <http://example.org/education/concept/Coolcation>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Nordische_L%C3%A4nder>,
        <http://example.org/education/concept/Reise>,
        <http://example.org/education/concept/Reisetrend>,
        <http://example.org/education/concept/Slow_Travel>,
        <http://example.org/education/concept/Tourismus>,
        <http://example.org/education/concept/Urlaub> ;
    dcterms:title "Der Reisetrend Coolcation: Eine Analyse des modernen Tourismusphänomens"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:9YHqr0iRrTek a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Neumann> ;
    dcterms:description "Die Studie untersucht die sprachlichen Ressourcen von jugendlichen Flüchtlingen aus Afrika in Deutschland und zeigt, dass ihre Kenntnisse in Englisch und Französisch systematisch ignoriert werden, obwohl sie für den Bildungserfolg von großer Bedeutung sind. Durch die Analyse der Selbstbewertungen der Jugendlichen wird deutlich, dass sie über umfassende Sprachkompetenzen verfügen, die jedoch im deutschen Bildungssystem nicht genutzt werden. Die Studie verdeutlicht die Notwendigkeit einer inklusiven Bildungspolitik, die die sprachlichen Ressourcen von Migrantinnen und Migranten anerkennt und fördert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9YHqr0iRrTek" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Afrika>,
        <http://example.org/education/concept/Bildungssystem>,
        <http://example.org/education/concept/Deutsch_als_Zweitsprache>,
        <http://example.org/education/concept/Deutschland>,
        <http://example.org/education/concept/Diskriminierung>,
        <http://example.org/education/concept/Fl%C3%BCchtlinge>,
        <http://example.org/education/concept/Kolonialsprachen>,
        <http://example.org/education/concept/Mehrsprachigkeit>,
        <http://example.org/education/concept/Postkolonialismus>,
        <http://example.org/education/concept/Sprachkompetenz> ;
    dcterms:title "Postkoloniale Mehrsprachigkeit und Deutsch als Zweitsprache"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:9gig4MsjKXnY a edu:LearningResource ;
    dcterms:description "Die Aufgabe behandelt ein logisches Problem, bei dem drei Herren (Lehmann, Müller und Richter) verschiedenen Regionen (Sachsen, Thüringen und Brandenburg) zugeordnet werden müssen. Durch Ausschlussverfahren und Modellierung mit aussagenlogischen Formeln kann die eindeutige Lösung gefunden werden. Die Lösung lautet: Herr Lehmann ist Sachse, Herr Müller ist Brandenburger und Herr Richter ist Thüringer."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9gig4MsjKXnY" ;
    dcterms:subject <http://example.org/education/concept/Aussagenlogik>,
        <http://example.org/education/concept/Deduktion>,
        <http://example.org/education/concept/Formeln>,
        <http://example.org/education/concept/Logik>,
        <http://example.org/education/concept/Logisches_Denken>,
        <http://example.org/education/concept/Modellierung>,
        <http://example.org/education/concept/Probleml%C3%B6sung>,
        <http://example.org/education/concept/R%C3%A4tsel>,
        <http://example.org/education/concept/Schlussfolgerung>,
        <http://example.org/education/concept/Situationen> ;
    dcterms:title "Aufgabe 1.3 Hörrmann"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

