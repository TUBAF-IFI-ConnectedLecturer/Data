oer:1gnG44_FmP1E a edu:LearningResource ;
    sim:similarTo oer:3N-Fs0EC36ZM,
        oer:3POA6uYgOrMo,
        oer:3fRGNNr-KxbI,
        oer:4nu4UVXtK2eI,
