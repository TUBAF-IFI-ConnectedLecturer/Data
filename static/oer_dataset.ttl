    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Henschel>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Diese Übungsaufgaben zum Mathematik-Kurs WS2022/23 an der Hochschule für Technik und Wirtschaft Dresden behandeln verschiedene Aspekte der Analysis, wie partielle Ableitungen, Nullstellen, Extrempunkte und Wendepunkte von Funktionen. Durch die Lösung dieser Aufgaben können Studierende ihre Fähigkeiten in der Berechnung und Analyse von Funktionen verbessern und ein tieferes Verständnis der mathematischen Konzepte erlangen. Die Übungsaufgaben decken eine breite Palette an Themen ab, von einfachen Funktionen bis hin zu komplexeren mathematischen Strukturen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4icR9OjD1s5c" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Differentialrechnung>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Extrempunkte>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Lineare_Approximation>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Monotonie>,
        <http://example.org/education/concept/Partielle_Ableitungen>,
        <http://example.org/education/concept/Wendepunkte> ;
    dcterms:title "Mathematik 1 - WS2022/23 Übungsblatt 13"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

