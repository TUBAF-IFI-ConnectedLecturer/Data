oer:9Ui_-x-atFHQ a edu:LearningResource ;
    dcterms:description "Das Übungsblatt behandelt die Implementierung eines modular-sequentiellen Lösungsverfahrens für ein System mit Rückführströmen und beschreibt die Berechnungsreihenfolge sowie die Implementierung in MATLAB. Durch das Verständnis dieses Verfahrens können Studierende komplexe Systeme mit Rückführströmen lösen und die notwendigen Iterationsschleifen erkennen. Die Lösung wird durch zwei geschachtelte Iterationsschleifen realisiert, die jeweils bis zur Konvergenz bestimmter Ströme iteriert werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9Ui_-x-atFHQ" ;
    dcterms:subject <http://example.org/education/concept/Berechnungsreihenfolge>,
        <http://example.org/education/concept/Iterationsschleifen>,
        <http://example.org/education/concept/Mischer>,
        <http://example.org/education/concept/Modular-sequentielle_L%C3%B6sungsverfahren>,
        <http://example.org/education/concept/Prozessleittechnik>,
        <http://example.org/education/concept/R%C3%BCckf%C3%BChrstr%C3%B6me>,
        <http://example.org/education/concept/Reaktor>,
        <http://example.org/education/concept/Separator>,
        <http://example.org/education/concept/Systemverfahrenstechnik>,
        <http://example.org/education/concept/W%C3%A4rme%C3%BCbertrager> ;
    dcterms:title "ÜBUNG 2 LÖSUNG - MODULAR-SEQUENTIELLES LÖSUNGSVERFAHREN"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9aM_ZRn9RcHI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Seminar \"Komplexe Systeme\" behandelt aktuelle Fragenstellungen zum Elektroenergiesystem und findet virtuell statt. Die Teilnehmer können sich bis zum 28.10.2020 anmelden und erhalten dann die Seminaraufgaben. Durch das Seminar sollen die Studierenden Kenntnisse über das Elektroenergiesystem erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9aM_ZRn9RcHI" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Elektroenergiesystem>,
        <http://example.org/education/concept/Elektroforschung>,
        <http://example.org/education/concept/Elektrotechnik>,
