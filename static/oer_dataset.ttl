oer:8EVYFC-BIuww a edu:LearningResource ;
    sim:similarTo oer:8FPLZdES6U3I,
        oer:8Iq1XDtZbkZo,
        oer:8Vy--T0Sbb2I,
        oer:9T-qFy0rnpPE,
        oer:9aG6x_KvBAzw ;
    dcterms:creator <http://example.org/education/person/Babick>,
        <http://example.org/education/person/Wessely> ;
    dcterms:description "Die Grundlagen der Mechanischen Verfahrenstechnik behandeln die Trennung und Klassierung disperser Systeme, um Stoffströme mit identischer Zusammensetzung zu erhalten oder heterodisperse Stoffsysteme nach stofflichen Eigenschaften zu sortieren. Durch das Studium dieser Materialien können Lernende die Prinzipien und Verfahren der Siebklassierung, Strömungsklassierung und Sortierung von dispersen Systemen verstehen und anwenden. Dieses Wissen ermöglicht es, in verschiedenen industriellen Anwendungen wie der Staubabscheidung, Klären und Entfeuchten effiziente Lösungen zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8EVYFC-BIuww" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Flotation>,
        <http://example.org/education/concept/Gasentstaubung>,
        <http://example.org/education/concept/Klassieren_von_dispersen_Systemen>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Partikeltechnologie>,
        <http://example.org/education/concept/Schwimm-Sink-Sortierung>,
        <http://example.org/education/concept/Siebklassierung>,
        <http://example.org/education/concept/Stoffsysteme>,
        <http://example.org/education/concept/Str%C3%B6mungsklassierung>,
        <http://example.org/education/concept/Trennen_disperser_Systeme> ;
    dcterms:title "Grundlagen der Mechanischen Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9ItNJGgzqC6M a edu:LearningResource ;
    sim:similarTo oer:9cZgXivTQ9t8,
        oer:9gzKRPe1QBes,
        oer:9oymdMlIaP4g ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die Pragmatik als Teilgebiet der Linguistik untersucht die Beziehung zwischen sprachlichen Äußerungen und ihren spezifischen Verwendungssituationen, um die kommunikative Kompetenz von Sprechern zu beschreiben. Durch das Studium dieser Theorien und Modelle können Lerner die Fähigkeit erwerben, komplexe Kommunikationsprozesse zu analysieren und effektive Kommunikationsstrategien zu entwickeln. Insbesondere werden die Konversationsmaximen nach Grice, die Sprechakttheorie von Austin und Searle sowie die Theorie der kommunikativen Implikatur behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9ItNJGgzqC6M" ;
    dcterms:subject <http://example.org/education/concept/Diskursanalyse>,
        <http://example.org/education/concept/Gespr%C3%A4chsanalyse>,
        <http://example.org/education/concept/Kommunikationstheorie>,
        <http://example.org/education/concept/Konversationsanalyse>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Pragmatik>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Sprachwissenschaft>,
        <http://example.org/education/concept/Sprechakttheorie>,
        <http://example.org/education/concept/Textlinguistik> ;
    dcterms:title "Einführung in die germanistische Sprachwissenschaft"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

