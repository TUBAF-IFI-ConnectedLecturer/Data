    dcterms:creator <http://example.org/education/person/Tusch%D1%83> ;
    dcterms:description "Das Lehrmaterial behandelt quadratische Funktionen für Schüler der 9. Klasse und umfasst die Einführung des Begriffs, verschiedene Darstellungsformen wie Wertetabelle, Graph und Funktionsgleichung sowie Eigenschaften wie Definitions-, Wertebereich, Nullstellen und Monotonieverhalten. Durch die Arbeit mit diesem Material können Lernende quadratische Funktionen erkennen, darstellen und interpretieren sowie ihre wesentlichen Eigenschaften verstehen. Zudem wird der Einfluss von Parametern auf den Graphen untersucht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4DLflrbaxW3o" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Funktionsdarstellungen>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Monotonieverhalten>,
        <http://example.org/education/concept/Nullstellen>,
        <http://example.org/education/concept/Sekundarstufe>,
        <http://example.org/education/concept/Wertetabellen>,
        <http://example.org/education/concept/quadratische_Funktionen> ;
    dcterms:title "Quadratische Funktionen (MS 9)"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

