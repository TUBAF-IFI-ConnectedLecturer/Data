        <http://example.org/education/concept/Informationswissenschaft>,
        <http://example.org/education/concept/Katalogisierung>,
        <http://example.org/education/concept/Schlagwortkatalog>,
        <http://example.org/education/concept/Wissensorganisation> ;
    dcterms:title "Bibliographische Katalogisierung und Indexierung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:1lVZt3OHeEbE a edu:LearningResource ;
    sim:similarTo oer:1pkom9GhZ4Lo,
        oer:4dN1P6F_BmAc ;
    dcterms:description "Die Determinante einer Matrix kann rekursiv berechnet werden, indem die algebraischen Komplemente der Matrixelemente bestimmt und dann die Unterdeterminanten entwickelt werden. Durch diese Methode können Learner den Wert der Determinante für eine gegebene Matrix berechnen. Die Anwendung dieser Methode wird anhand von Beispielen illustriert, um das Verständnis der Berechnung von Determinanten zu fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1lVZt3OHeEbE" ;
    dcterms:subject <http://example.org/education/concept/Algebraische_Strukturen>,
        <http://example.org/education/concept/Berechnung_von_Determinanten>,
        <http://example.org/education/concept/Determinanten>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Lineare_Gleichungen>,
        <http://example.org/education/concept/Mathematische_Analyse>,
        <http://example.org/education/concept/Matrixoperationen>,
        <http://example.org/education/concept/Matrizen>,
        <http://example.org/education/concept/Numerische_Mathematik>,
        <http://example.org/education/concept/Rekursion> ;
    dcterms:title "Determinanten n-ter Ordnung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:1pkom9GhZ4Lo a edu:LearningResource ;
    dcterms:description "Die Determinante einer Matrix wird durch bestimmte Operationen wie Transposition, Vertauschen von Spalten und Addition oder Multiplikation von Spalten beeinflusst. Diese Operationen werden durch spezifische Regeln beschrieben, die den Einfluss auf die Determinante der Matrix bestimmen. Durch das Verständnis dieser Regeln können Lernende die Berechnung von Determinanten für Matrizen beliebiger Ordnung beherrschen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1pkom9GhZ4Lo" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Determinanten>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Matrixoperationen>,
        <http://example.org/education/concept/Matrizen>,
        <http://example.org/education/concept/Rechenregeln>,
        <http://example.org/education/concept/Vektoren>,
        <http://example.org/education/concept/lineare_Transformationen>,
        <http://example.org/education/concept/multilineare_Algebra> ;
    dcterms:title "Determinante Satz 8.12"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

