    dcterms:title "Projektarbeit Wege zum Erfolg"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:7CJIrl2jtK9M a edu:LearningResource ;
    dcterms:description "Die Erfindung des Buchdrucks durch Johannes Gutenberg hat eine Medienrevolution ausgelöst, indem sie die Verbreitung von Wissen und Informationen massiv beschleunigt und die Zugänglichkeit zu Literatur für breite Bevölkerungsschichten ermöglicht hat. Durch den Buchdruck konnten mehr Menschen ihr Wissen und Meinungen verbreiten, was zu einer Veränderung in den sozialen Schichten führte. Die Medienkomplementarität und -koexistenz werden erläutert, indem verschiedene Medienarten wie Sprache, Schrift, Radio und Fernsehen nebeneinander genutzt werden, ohne sich gegenseitig zu verdrängen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "7CJIrl2jtK9M" ;
    dcterms:subject <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Buchdruck>,
        <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Lizenzierung>,
        <http://example.org/education/concept/Medienkoexistenz>,
        <http://example.org/education/concept/Medienkomplementarit%C3%A4t>,
        <http://example.org/education/concept/Medienrevolution>,
        <http://example.org/education/concept/Phonographie>,
        <http://example.org/education/concept/Schreibsysteme>,
        <http://example.org/education/concept/Silbenschrift> ;
    dcterms:title "Semantik und Medien"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7Eau7i_tKFEA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Lernpaket behandelt die Berechnung von Strahlennetzen und thematisiert die Vor- und Nachteile des Einzelschrittverfahrens sowie den Vorteil der iterativen Leistungsflussberechnung. Es werden die Bedingungen für die Anwendung der Näherungsberechnung erläutert und eine Aufgabe zur Netzberechnung und Schutztechnik gestellt, bei der die Spannungen an Verbrauchern in einem Niederspannungsnetz berechnet werden müssen. Durch das Lernpaket können Studierende ihre Fähigkeiten in der Netzanalyse und -berechnung verbessern und die Anwendung von Berechnungsmethoden in der Elektrotechnik verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7Eau7i_tKFEA" ;
    dcterms:subject <http://example.org/education/concept/Elektroenergiesysteme>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Energie%C3%BCbertragung>,
        <http://example.org/education/concept/Kabelnetze>,
        <http://example.org/education/concept/Leistungsflussberechnung>,
        <http://example.org/education/concept/Netzberechnung>,
        <http://example.org/education/concept/Niederspannungsleitung>,
        <http://example.org/education/concept/Schutztechnik>,
        <http://example.org/education/concept/Spannungsberechnung>,
        <http://example.org/education/concept/Stromversorgung> ;
    dcterms:title "NbSt Lernpaket 4 Berechnung von Strahlennetzen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7Gflv_c218zc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Fischer>,
        <http://example.org/education/person/Vo%C3%9F-B%C3%B6hme> ;
    dcterms:description "Diese Hausaufgabe im Fach Wirtschaftsmathematik II behandelt zwei Aufgaben, die sich mit Kostenfunktionen und Preis-Absatz-Beziehungen beschäftigen. Die Lösung dieser Aufgaben soll den Studierenden helfen, mathematische Konzepte wie Grenzkostenfunktionen, Elastizität und Differentialrechnung anzuwenden, um betriebswirtschaftliche Probleme zu lösen. Durch die Bearbeitung dieser Aufgaben können die Studierenden ihre Fähigkeiten im Bereich der Wirtschaftsmathematik verbessern und komplexere ökonomische Zusammenhänge verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7Gflv_c218zc" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
