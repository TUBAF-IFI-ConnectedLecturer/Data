oer:12OcXBuyYKLrk a edu:LearningResource ;
    sim:similarTo oer:12plZF6xssBnU,
        oer:7vWE16fX7-S8 ;
    dcterms:creator <http://example.org/education/person/Meier> ;
    dcterms:description "Der Studiengang Lehramt Biologie bietet eine umfassende Ausbildung in den Fächern Biologie, Fachdidaktik und Bildungswissenschaften, um Lehrerinnen und Lehrer auszubilden, die Schülerinnen und Schüler auf ihrem Weg zum Verständnis der biologischen Grundlagen und ihrer Anwendung unterstützen können. Durch das Studium werden Kenntnisse in verschiedenen biologischen Disziplinen wie Genetik, Biochemie, Mikrobiologie, Zoologie, Botanik und Ökologie erworben, die für den Unterricht in der Sekundarstufe I und II erforderlich sind. Zudem werden Fähigkeiten zur Planung, Durchführung und Reflexion von Unterrichtseinheiten vermittelt, um eine professionelle Lehrpraxis zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12OcXBuyYKLrk" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologie>,
        <http://example.org/education/concept/Biologieunterricht>,
        <http://example.org/education/concept/Biologische_Makromolek%C3%BCle>,
        <http://example.org/education/concept/Botanik>,
        <http://example.org/education/concept/Fachdidaktik>,
        <http://example.org/education/concept/Genetik>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Mikrobiologie>,
        <http://example.org/education/concept/Zellbiologie>,
        <http://example.org/education/concept/Zoologie> ;
    dcterms:title "Herzlich Willkommen! Studiengang Lehramt Biologie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

