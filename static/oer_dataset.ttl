        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Studierende> ;
    dcterms:title "Finanzen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5jklMt5RQUVE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Wieser> ;
    dcterms:description "Die Sage über Daniel Knappe erzählt die Geschichte eines Bergmanns, der im 15. Jahrhundert einen Silberfund machte und damit die Gründung der Stadt Annaberg-Buchholz initiierte. Durch das Lesen dieser Sage können Lernende Hintergrundwissen über die Entstehung der Stadt und die Bedeutung des Bergmanns Daniel Knappe erwerben. Darüber hinaus wird die Aufgabe gestellt, ein Verschwinden einer Holzfigur des Bergmanns aufzuklären, um logisches Denken und Problemlösungsstrategien zu üben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5jklMt5RQUVE" ;
    dcterms:subject <http://example.org/education/concept/Annaberg-Buchholz>,
        <http://example.org/education/concept/Bergbau>,
        <http://example.org/education/concept/Bergmann>,
        <http://example.org/education/concept/Bergstadt>,
        <http://example.org/education/concept/Figur_%28Kunst%29>,
        <http://example.org/education/concept/Legende>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Sachsens>,
        <http://example.org/education/concept/Silberabbau>,
        <http://example.org/education/concept/Stadtgeschichte> ;
    dcterms:title "Der Traum des Daniel Knappe"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

