oer:5FfPlIcv0168 a edu:LearningResource ;
    sim:similarTo oer:5KnABjKGRnjc,
        oer:5LwP9N2fwl1s,
        oer:5fGq783LJRFY,
        oer:5mx5w1RGlPg4,
        oer:5rGVxJhbXqtY ;
    dcterms:creator <http://example.org/education/person/Achtziger>,
        <http://example.org/education/person/Leucht>,
        <http://example.org/education/person/Opitz> ;
    dcterms:description "Das Bildungsmaterial behandelt die Biodiversität in Weinbergen und informiert über die Vielfalt von Tieren, die in diesen Lebensräumen vorkommen. Durch die Lektüre können Lernende Kenntnisse über die Biologie und Ökologie von Wirbeltieren wie Eidechsen, Schlangen und Feldhasen erwerben und verstehen, wie diese Tiere an ihre Umgebung angepasst sind. Zudem werden die Bedeutung der Biodiversität für den Weinbau und die Anpassung an den Klimawandel thematisiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5FfPlIcv0168" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
