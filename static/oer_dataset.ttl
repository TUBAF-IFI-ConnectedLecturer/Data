        <http://example.org/education/concept/Schmelztemperatur>,
        <http://example.org/education/concept/Sedimentation>,
        <http://example.org/education/concept/optische_Eigenschaften> ;
    dcterms:title "Kolloidchemische Grundlagen der Nanotechnologie I"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

