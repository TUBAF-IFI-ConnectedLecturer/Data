oer:6vSEjaZS6tpU a edu:LearningResource ;
    sim:similarTo oer:6yfd26GSDwTc ;
    dcterms:creator <http://example.org/education/person/Krauth%C3%A4user> ;
    dcterms:description "Die Eichung in der klassischen elektromagnetischen Feldtheorie ermöglicht die Transformation von elektrischen und magnetischen Feldern in skalare Potentiale, um die Lösung von Problemen zu vereinfachen. Durch die Wahl einer geeigneten Eichbedingung können die Divergenz des Vektorpotentials und die zeitliche Änderung des Skalarpotentials auf beliebige Werte gesetzt werden. Dieser Ansatz erlaubt es, elektromagnetische Felder in verschiedenen Koordinatensystemen zu beschreiben und Lösungen für verschiedene physikalische Probleme zu finden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6vSEjaZS6tpU" ;
    dcterms:subject <http://example.org/education/concept/Coulombsches_Gesetz>,
        <http://example.org/education/concept/Eichtransformation>,
        <http://example.org/education/concept/Elektrodynamik>,
        <http://example.org/education/concept/Elektromagnetismus>,
        <http://example.org/education/concept/Feldtheorie>,
        <http://example.org/education/concept/Lorenz-Eichung>,
        <http://example.org/education/concept/Maxwellsche_Gleichungen>,
        <http://example.org/education/concept/Theoretische_Elektrotechnik>,
        <http://example.org/education/concept/elektromagnetische_Induktion>,
        <http://example.org/education/concept/elektromagnetische_Wellen> ;
    dcterms:title "TET Vertiefung: Eichung Theoretische Elektrotechnik und EMV"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

