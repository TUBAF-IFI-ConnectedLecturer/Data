        <http://example.org/education/concept/Quadratische_Funktionen>,
        <http://example.org/education/concept/Sekundarstufe_II> ;
    dcterms:title "Quadratische Funktionen (MS 9)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

