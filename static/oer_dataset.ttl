        <http://example.org/education/concept/Hochschuldidaktik>,
        <http://example.org/education/concept/Hochschullehre>,
        <http://example.org/education/concept/Lehren_mit_Medien>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Mediendidaktik>,
        <http://example.org/education/concept/Weiterbildung> ;
    dcterms:title "E-Teaching in der Hochschullehre"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

oer:1A2IpxGZsEq8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Gr%C3%BCttm%C3%BCller>,
        <http://example.org/education/person/Merker> ;
    dcterms:description "Das 10. Treffen des Netzwerks Facharbeitskreises Mathematik-Physik E-Learning behandelt aktuelle Entwicklungen und Herausforderungen im Bereich der elektronischen Mathematiklehre. Die Veranstaltung bietet eine Plattform für den Austausch von Erfahrungen und Ideen zwischen Experten aus Hochschulen und Unternehmen. Teilnehmer können sich über neue Ansätze und Tools zur Unterstützung des Mathematiklernens informieren und an Diskussionen teilnehmen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1A2IpxGZsEq8" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik__Wirtschaft_und_Kultur_Leipzig> ;
