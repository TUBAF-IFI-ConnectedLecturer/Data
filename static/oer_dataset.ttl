        <http://example.org/education/concept/Selbstlernmaterial>,
        <http://example.org/education/concept/Trigonometrie> ;
    dcterms:title "Digitale Medien in der Schule Universität Leipzig Heike Fischer Aufgabenpool"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenpool> .

