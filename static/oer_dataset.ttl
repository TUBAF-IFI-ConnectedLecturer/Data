oer:8OS6hijxen1w a edu:LearningResource ;
    sim:similarTo oer:8nQgLPwKyxec,
        oer:8wntomkrcr6g ;
    dcterms:creator <http://example.org/education/person/Wolfram> ;
    dcterms:description "InstaHub ist ein soziales Netzwerk ähnlich wie Instagram, das jedoch ausschließlich zu Unterrichtszwecken dient und voll funktionsfähig ist. Als Datenbank-Administratoren können SuS auf alle Funktionen des sozialen Netzwerks zugreifen, einschließlich der Möglichkeit, Daten mit SQL-Befehlen zu ändern. Durch die Nutzung von InstaHub können Lerner Kenntnisse über Datenbanken und SQL erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8OS6hijxen1w" ;
    dcterms:subject <http://example.org/education/concept/Abfrage-Editor>,
