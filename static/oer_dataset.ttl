        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Schalld%C3%A4mpfungsspektroskopie>,
        <http://example.org/education/concept/Sedimentationsanalyse>,
        <http://example.org/education/concept/Spektroskopie> ;
    dcterms:title "Fahrplan"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:481cfLK0mTpA a edu:LearningResource ;
    sim:similarTo oer:4dVZlo9s3Xy0,
        oer:7xq9znLfwWO8,
        oer:7y2Vvnr6LpnI,
