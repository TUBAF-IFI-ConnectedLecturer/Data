        <http://example.org/education/concept/quantitative_Forschung>,
        <http://example.org/education/concept/wissenschaftliche_Arbeit> ;
    dcterms:title "Die Methodik der Bachelorarbeit in 4 Schritten"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

