    dcterms:creator <http://example.org/education/person/Benabdellah>,
        <http://example.org/education/person/L%C3%B6ffler> ;
    dcterms:description "Die Anforderungen an Triebfahrzeuge werden durch nationale und europäische Gesetzgebungen geregelt, um die Sicherheit und Interoperabilität des Eisenbahnverkehrs zu gewährleisten. Durch das Studium dieser Materialien können Lernende die grundlegenden Anforderungen und Vorschriften für Triebfahrzeuge verstehen und ihre Kenntnisse über die technischen und sicherheitsrelevanten Aspekte von Eisenbahnen erweitern. Insbesondere werden sie Einblick in die relevanten Gesetze, Verordnungen und Normen erhalten, die für den sicheren und effizienten Betrieb von Triebfahrzeugen erforderlich sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11D0UqfRVi3yw" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_Hints_Pointing_To_The_Author%27s_Institution_Of_Origin%3A%2A%2Aprofessur_F%C3%BCr_Technik_Spurgef%C3%BChrter_Fahrzeuge%2A%2Athis_Suggests_That_The_Author_Is_Affiliated_With_a_University_Or_Institution_That_Has_a_Professorship_In_The_Field_Of_Rail_Vehicle_Technology.the_Prominent_Institution_Mentioned_Is%3A%2A%2Anone_%28but_Likely_a_German_University%29%2A%2Aalthough_No_Specific_University_Name_Is_Mentioned__The_Language_And_Terminology_Used_Suggest_a_German_Academic_Environment.> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Eisenbahn-Bau-_und_Betriebsordnung>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/G%C3%BCterzuglokomotive>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Personenwagen>,
        <http://example.org/education/concept/Reisezuglokomotive>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Technische_Spezifikationen_zur_Interoperabilit%C3%A4t>,
        <http://example.org/education/concept/Triebfahrzeuge> ;
    dcterms:title "Anforderungen an Triebfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

