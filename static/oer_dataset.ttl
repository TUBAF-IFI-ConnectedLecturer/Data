    dcterms:creator <http://example.org/education/person/Benabdellah>,
        <http://example.org/education/person/L%C3%B6ffler> ;
    dcterms:description "Die Entwicklung von Dieseltriebfahrzeugen wird dargestellt, beginnend mit den ersten Serienfahrzeugen ab 1905 in den USA und Europa, gefolgt von der Beschleunigung der Entwicklung nach dem Ersten Weltkrieg in Europa. Die verschiedenen Leistungsübertragungsarten wie mechanische, hydrodynamische, hydrostatische und elektrische Übertragung werden erläutert, einschließlich ihrer Vorteile und Nachteile. Durch das Studium dieser Materialien können Lernende ein Verständnis der Entwicklungsgeschichte und der technischen Grundlagen von Dieseltriebfahrzeugen erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4QGu_RrZZPWU" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_The_Following_Hints_About_The_Author%27s_Institution%3A%2A_%22professur_F%C3%BCr_Technik_Spurgef%C3%BChrter_Fahrzeuge%22_%28professorship_For_Technology_Of_Rail_Vehicles%29%2A_%22sommersemester_2020%22_%28summer_Semester_2020%29these_Hints_Suggest_That_The_Author_Is_Affiliated_With_a_University_Or_Technical_University_In_Germany._The_Most_Prominent_Mention_Is%3A%2A%2Auniversit%C3%A4t%2A%2Aplease_Note_That_I_Couldn%27t_Find_a_Specific_University_Name__But_The_Context_And_Language_Used_Indicate_a_German_Academic_Institution.> ;
    dcterms:subject <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Diesellokomotiven>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Elektrotriebfahrzeuge>,
        <http://example.org/education/concept/Fahrzeugentwicklung>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragungssysteme>,
        <http://example.org/education/concept/Lokomotivbau>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

