    dcterms:title "Statistik und Quantitative Methoden BA"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9SX181GMEJNM a edu:LearningResource ;
    sim:similarTo oer:9kX-vo8iZpfw ;
    dcterms:creator <http://example.org/education/person/Hagedorn> ;
    dcterms:description "Die Audioproduktion führt Schülerinnen und Schüler in das Thema Märchen ein und gibt einen Überblick darüber, was Märchen sind und wie sie im Alltag erlebt werden. Durch die Verwendung von Zitaten aus bekannten Märchen wird ein Bezug zur Lebenswelt der Kinder geschaffen und ein flüssiger Übergang in den nachfolgenden Unterricht gewährleistet. Die Materialhandreichung eignet sich für die Einstiegsphase im Fach Deutsch an Grundschulen, um grundlegende Kompetenzen wie Fach-, Methoden-, Selbst- und Sozialkompetenz zu fördern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9SX181GMEJNM" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Audioproduktion>,
        <http://example.org/education/concept/Deutschunterricht>,
        <http://example.org/education/concept/Einstiegsphase>,
        <http://example.org/education/concept/Grundschule>,
        <http://example.org/education/concept/Kompetenzorientierter_Unterricht>,
        <http://example.org/education/concept/Lernphase>,
        <http://example.org/education/concept/M%C3%A4rchen>,
        <http://example.org/education/concept/Medienp%C3%A4dagogik>,
