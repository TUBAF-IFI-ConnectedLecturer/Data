    dcterms:title "Planung von Niederspannungsnetzen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:7u_5AC_JCSWI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Linke> ;
    dcterms:description "Der TRIZ-Trainer unterstützt die bibliographische Katalogisierung und Indexierung akademischer Arbeiten durch die Anwendung von TRIZ-Methodiken zur Lösung komplexer Probleme. Durch die Arbeit mit dem TRIZ-Trainer erwerben Lernende Kenntnisse über die Modellierung von Systemen, die Identifizierung von Konflikten und die Entwicklung von Lösungen nach bewährten TRIZ-Prinzipien. Am Ende des Prozesses stehen Lernende in der Lage, komplexe Probleme systematisch zu analysieren und innovative Lösungen zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7u_5AC_JCSWI" ;
    dcterms:subject <http://example.org/education/concept/Algorithmus>,
        <http://example.org/education/concept/Indexierung>,
