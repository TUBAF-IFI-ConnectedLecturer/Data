oer:8PESeNaUrDcg a edu:LearningResource ;
    sim:similarTo oer:8jAylCQPT248 ;
    dcterms:creator <http://example.org/education/person/Hirte>,
        <http://example.org/education/person/Mankiw>,
        <http://example.org/education/person/Taylor> ;
    dcterms:description "Die Vorlesung \"Einführung in die VWL\" behandelt grundlegende Konzepte der Volkswirtschaftslehre, einschließlich der kapitalistischen Revolution, Marktmechanismen und Wirtschaftspolitik. Durch diese Veranstaltung sollen Studierende ein Verständnis für die Funktionsweise von Märkten und die Auswirkungen wirtschaftspolitischer Maßnahmen entwickeln. Die Vorlesung richtet sich an Studierende der Bachelor- und Diplomstudiengänge in Wirtschaftswissenschaften, Verkehrswissenschaften und verwandten Fächern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8PESeNaUrDcg" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
