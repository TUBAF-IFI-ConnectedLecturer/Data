    dcterms:title "Die Fibonacci-Folge"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5xB6tTtmCYgs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kie%C3%9Fling> ;
    dcterms:description "Das Fachseminar Lehramt Informatik behandelt die Didaktik der Informatik und bietet Anwendungsaufgaben für den Einsatz von RaspberryPi und Lego-Robotern im Unterricht. Durch die Bearbeitung dieser Aufgaben können Studierende praktische Erfahrungen im Bereich der Programmierung und Steuerung von Hardware-Komponenten sammeln. Die Aufgaben umfassen unter anderem das Ansteuern von LEDs, die Verwendung von Sensoren und die Implementierung autonomer Fahrfunktionen für den Lego-Roboter."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5xB6tTtmCYgs" ;
    dcterms:subject <http://example.org/education/concept/Computertechnologie>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Lego-Roboter>,
