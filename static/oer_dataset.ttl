        <http://example.org/education/concept/Polygon>,
        <http://example.org/education/concept/Teilungsverh%C3%A4ltnis>,
        <http://example.org/education/concept/Vektoren> ;
    dcterms:title "I383 Geometrie - Sommer 2025 Übungsblatt 4 Aufgaben mit Lösungshilfe."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

