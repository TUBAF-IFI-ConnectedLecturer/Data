oer:11IX_zyHu9ewM a edu:LearningResource ;
    sim:similarTo oer:11d4cRXzt7sao,
        oer:11oBdgdq4biBk ;
    dcterms:creator <http://example.org/education/person/Bloom>,
        <http://example.org/education/person/Engelhart>,
        <http://example.org/education/person/Messner> ;
    dcterms:description "Die Bloomsche Taxonomie umfasst sechs Ebenen kognitiver Fähigkeiten, die von der reproduktiven Kenntnisnahme bis hin zur begründeten Bewertung reichen. Durch das Verständnis dieser Ebenen können Lernende ihre intellektuellen Fähigkeiten verbessern und anspruchsvollere kognitive Leistungen erbringen. Die Taxonomie unterstützt Lehrer bei der Planung von Unterrichtsstunden, indem sie ihnen hilft, Lernziele zu setzen und die kognitiven Anforderungen an die Schüler zu bestimmen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11IX_zyHu9ewM" ;
    dcterms:subject <http://example.org/education/concept/Analyse>,
        <http://example.org/education/concept/Anwendung>,
        <http://example.org/education/concept/Bildungsforschung>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Lernziele>,
        <http://example.org/education/concept/Synthese>,
        <http://example.org/education/concept/Unterrichtsplanung>,
        <http://example.org/education/concept/Verstehen>,
        <http://example.org/education/concept/Wissen>,
        <http://example.org/education/concept/kognitive_F%C3%A4higkeiten> ;
    dcterms:title "TAXONOMIE VON LERNZIELEN - KOGNITIVE BEREICH"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:11Mc9-MLpTYgk a edu:LearningResource ;
    sim:similarTo oer:11_lTdl0IfaUY,
        oer:12-cvcBTTdcsc ;
    dcterms:creator <http://example.org/education/person/Hacker> ;
    dcterms:description "Die Seminarsitzung behandelt die Entwicklung und Bedeutung von Informations- und Dokumentationsdienstleistungen (IuD) in verschiedenen Fachdisziplinen, insbesondere in den Naturwissenschaften und der Medizin. Die Diskussion konzentriert sich auf die Gründung und Funktion von IuD-Einrichtungen, ihre Ziele und Aufgaben sowie ihre Bedeutung für die Forschung und Wirtschaft. Durch die Lektüre dieser Sitzung können Studierende Einblicke in die Geschichte und Entwicklung der Dokumentation gewinnen und verstehen, wie IuD-Dienstleistungen die wissenschaftliche Arbeit unterstützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11Mc9-MLpTYgk" ;
    dcterms:subject <http://example.org/education/concept/Archivwesen>,
