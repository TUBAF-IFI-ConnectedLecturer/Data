        <http://example.org/education/concept/Kompetenz>,
        <http://example.org/education/concept/Lehrmethoden>,
        <http://example.org/education/concept/Naturerleben>,
        <http://example.org/education/concept/Projektarbeit>,
        <http://example.org/education/concept/Selbstst%C3%A4ndigkeit>,
        <http://example.org/education/concept/Soziale_Einbindung> ;
    dcterms:title "Kriterien für einen interessanten Biologieunterricht"@de ;
