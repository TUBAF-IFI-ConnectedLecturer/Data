        <http://example.org/education/concept/Marketingstrategie>,
        <http://example.org/education/concept/Medienwirkung>,
        <http://example.org/education/concept/Unternehmenskommunikation> ;
    dcterms:title "Axel Gundlach Wirkungsvolle Live-Kommunikation"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:1tMPU2R0LTM8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Gnahs>,
