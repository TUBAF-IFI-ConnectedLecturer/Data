        <http://example.org/education/concept/Hochschuldidaktik>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Lehrveranstaltung>,
        <http://example.org/education/concept/Lernziele>,
        <http://example.org/education/concept/Studierendenorientierung>,
        <http://example.org/education/concept/Umfrage> ;
    dcterms:title "LEHRWERKSTATT die Vorlesung Ein digitaler Spaziergang durch Invote und ARSnova"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:88juTNhOIb4s a edu:LearningResource ;
    sim:similarTo oer:8PN8r2Jb9cDg,
        oer:8PO7X_Dq2RGM,
