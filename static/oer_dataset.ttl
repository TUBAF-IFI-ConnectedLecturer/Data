    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:91EkmF2g6ASo a edu:LearningResource ;
    dcterms:description "Dieses Lehrmaterial behandelt die biomechanischen Aspekte von drei Wurfarten im Sport: Druckwurf, Drehwurf und Schlagwurf. Durch die Erläuterungen zu den Hauptaktionen und Bewegungsabläufen können Lernende die jeweiligen Techniken besser verstehen und ihre Ausführung verbessern. Insbesondere werden die Bedeutung von Ellenbogenstellung und Armkreisen für eine maximale Abwurfgeschwindigkeit hervorgehoben."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "91EkmF2g6ASo" ;
    dcterms:subject <http://example.org/education/concept/Armbewegungen>,
        <http://example.org/education/concept/Bewegungslehre>,
        <http://example.org/education/concept/Biomechanik>,
        <http://example.org/education/concept/Geschwindigkeit>,
        <http://example.org/education/concept/Kugelsto%C3%9Fen>,
