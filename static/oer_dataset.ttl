    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von Bahnfahrzeugen wird anhand von Zugkraft-Geschwindigkeits-Diagrammen und Antriebskräften erläutert. Die Vorlesungsinhalte umfassen Einführung, Grundlagen, Fahrwiderstandskräfte, Antriebskräfte, Bewertung des Traktionsvermögens und Leistungs- und Energiebedarf. Durch das Studium dieser Materialien können Lernende die Fahrdynamik von Bahnfahrzeugen verstehen und ihre Kenntnisse in der Berechnung von Fahrzeiten und Energiebedarf erweitern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3HaLFx_qfGME" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Fahrzeugelektrifizierung>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Geschwindigkeit>,
        <http://example.org/education/concept/Schienenfahrzeug>,
        <http://example.org/education/concept/Traktion>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik Bahnfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

