    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Diese Übungssammlung behandelt geometrische Aufgaben und Algorithmen für die Berechnung von Schwerpunkten, Bézierkurven und konvexen Hüllen. Durch das Lösen der Aufgaben können Studierende ihre Fähigkeiten in der Anwendung mathematischer Konzepte und Algorithmen verbessern und ein tieferes Verständnis für die Geometrie entwickeln. Die Übungsaufgaben decken ein breites Spektrum an Themen ab, von einfachen geometrischen Berechnungen bis hin zu komplexeren Aufgaben mit Bézierkurven und Sterntetraedern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "93TuA_ufL5c8" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Algebraische_Geometrie>,
        <http://example.org/education/concept/B%C3%A9zierkurven>,
        <http://example.org/education/concept/Bernstein-Polynome>,
        <http://example.org/education/concept/Dreieck>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Koordinatensysteme>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Sterntetraeder>,
        <http://example.org/education/concept/Tetraeder>,
        <http://example.org/education/concept/W%C3%BCrfel> ;
    dcterms:title "Hochschule für Technik und Wirtschaft Dresden - Übungsblatt 5 - Geometrie - Sommer 2025"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

