        <http://example.org/education/concept/Wasserspiegel>,
        <http://example.org/education/concept/Wehr> ;
    dcterms:title "Kein Titel gefunden."@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:8qdecEw1tp7M a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Fritzsch> ;
    dcterms:description "Dieser Podcast behandelt die Suche nach geeigneten Open Educational Resources (OER) für Lehrende an der Technischen Universität Dresden und bietet Tipps und Anleitungen zur Recherche und Auswahl passender Materialien. Durch die Nutzung institutioneller Repositorien, nationaler und ationaler OER-Portale, fachspezifischer Angebote und Suchmaschinen mit Filtern können Lehrende hochwertige und freie Bildungsressourcen für ihre Lehrveranstaltungen finden. Der Austausch in Communitys und Netzwerken kann zudem eine wertvolle Quelle für OER-Materialien sein, um von den Erfahrungen anderer zu profitieren und sich über Best Practices auszutauschen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "8qdecEw1tp7M" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Hochschulbildung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Lehre>,
        <http://example.org/education/concept/Lehrmaterialien>,
        <http://example.org/education/concept/Lernmaterialien>,
        <http://example.org/education/concept/Medienbildung>,
        <http://example.org/education/concept/OER-Plattformen>,
        <http://example.org/education/concept/Open_Educational_Resources>,
        <http://example.org/education/concept/freie_Bildungsressourcen> ;
    dcterms:title "Lehramt an Grundschulen 5. Fachsemester Wintersemester 202425 Podcast-Episode: Wo findet man geeignete OER-Materialien?"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:8wSG8iHhwxOY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schramm>,
        <http://example.org/education/person/Stenning>,
        <http://example.org/education/person/van_Lambalgen> ;
    dcterms:description "Die Arbeit untersucht die Interpretationsschwierigkeiten bei Wasons Selection-Task und identifiziert zwei Hauptfaktoren, die deskriptive und deontische Interpretation, welche das Verhalten der Probanden beeinflussen. Durch Manipulationen an der Aufgabe können die Autoren zeigen, dass die Theorien der mentalen Modelle und der Relevanz-Theorie die Beobachtungen am besten erklären. Die Ergebnisse haben Implikationen für die evolutionären Theorien und die Beziehung zwischen Logik und Psychologie, was für die Forschung und Anwendung in diesem Bereich von Bedeutung ist."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8wSG8iHhwxOY" ;
    dcterms:subject <http://example.org/education/concept/Bayessche_Information-Gain-Theorie>,
        <http://example.org/education/concept/Deontische_Semantik>,
        <http://example.org/education/concept/Deskriptive_Semantik>,
        <http://example.org/education/concept/Kognitive_Psychologie>,
        <http://example.org/education/concept/Konditionale>,
        <http://example.org/education/concept/Logik>,
        <http://example.org/education/concept/Rationale-Analyse-Theorie>,
        <http://example.org/education/concept/Relevanz-Theorie>,
        <http://example.org/education/concept/Theorie_der_mentalen_Modelle>,
        <http://example.org/education/concept/Wahrheitsfunktionale_Semantik> ;
    dcterms:title "From Logic via Exploration to Controlled Experiment"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

