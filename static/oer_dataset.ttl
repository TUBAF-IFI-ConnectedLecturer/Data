oer:9sJ-qO4M0wzA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Ackerknecht>,
        <http://example.org/education/person/Adelung>,
        <http://example.org/education/person/von_Aretin> ;
    dcterms:description "Die Liste enthält Namen von Personen, die bedeutende Beiträge zur Entwicklung der Bibliothekswissenschaft und -praxis geleistet haben. Durch das Studium dieser Persönlichkeiten können Lernende Einblick in die Geschichte und Entwicklung der Bibliotheken und des bibliographischen Arbeitens gewinnen. Die Kenntnis dieser Personen hilft bei der Verständigung von Konzepten, Theorien und Methoden, die in der Bibliothekswissenschaft Anwendung finden."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9sJ-qO4M0wzA" ;
    dcterms:subject <http://example.org/education/concept/Bibliographie>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Buchgeschichte>,
        <http://example.org/education/concept/Dokumentation>,
        <http://example.org/education/concept/Informationswissenschaft>,
        <http://example.org/education/concept/Katalogisierung>,
        <http://example.org/education/concept/Lexikographie>,
        <http://example.org/education/concept/Schriftsteller>,
        <http://example.org/education/concept/Verlagswesen>,
        <http://example.org/education/concept/Wissenschaftsgeschichte> ;
    dcterms:title "Verzeichnis von Bibliothekaren und Gelehrten"@de ;
    dcterms:type <http://example.org/education/type/Sonstiges> .

oer:9sa8oMgQ6wwM a edu:LearningResource ;
    dcterms:description "Die Aufgabe behandelt die Umformulierung von Aussagen in aussagenlogische Formeln und ihre Negationen. Die Learner sollen Aussagenvariablen wie Regen, Tragen eines Schirms, Gehen ins Kino oder Konzert verwenden, um logische Formeln zu erstellen. Durch diese Übung können sie ihre Fähigkeiten im Bereich der Aussagenlogik verbessern und komplexere logische Operationen durchführen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9sa8oMgQ6wwM" ;
    dcterms:subject <http://example.org/education/concept/Aussagenlogik>,
        <http://example.org/education/concept/Aussagenvariablen>,
        <http://example.org/education/concept/Formale_Semantik>,
        <http://example.org/education/concept/Kino>,
        <http://example.org/education/concept/Konzert>,
        <http://example.org/education/concept/Logische_Operationen>,
        <http://example.org/education/concept/Negation>,
        <http://example.org/education/concept/Propositionale_Logik>,
        <http://example.org/education/concept/Regenschirm>,
        <http://example.org/education/concept/Wetterbedingungen> ;
    dcterms:title "serie1 aufg2 Hörrmann Aufgabe 1.2"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9v6eFcbqlOrc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Lesch> ;
