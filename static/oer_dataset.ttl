        <http://example.org/education/concept/Informationswissenschaft>,
        <http://example.org/education/concept/Inhaltsanalyse>,
        <http://example.org/education/concept/Sekund%C3%A4rforschung>,
        <http://example.org/education/concept/Wissenschaftliche_Arbeit>,
        <http://example.org/education/concept/akademische_Schriften> ;
    dcterms:title "Bachelorarbeit Methodik: Übersicht über die gängigsten Bachelorarbeit Methoden"@de ;
    dcterms:type <http://example.org/education/type/After_analyzing_the_document_4KH_QRnLBz9U.pdf__I_determined_that_it_falls_under_the_category_%22Skript%22.> .

oer:4Qb_-azjGY1U a edu:LearningResource ;
    sim:similarTo oer:4WxmKOvjRC4I ;
    dcterms:creator <http://example.org/education/person/Mathiszik> ;
    dcterms:description "Die vorliegende Materialsammlung behandelt die Untersuchung von Einflussgrößen auf den Rührvorgang, Filtrationsprozesse und Druckverlust in Rohrleitungssystemen, wobei Schülerinnen und Schüler durch Experimente und Analysen die Parameter des Prozesses erkunden und optimieren sollen. Durch die Bearbeitung dieser Aufgaben werden sie Kenntnisse über die Beeinflussung von Misch- und Trennprozessen erwerben, die für die chemische Verfahrenstechnik und die Entwicklung nachhaltiger Prozesse von Bedeutung sind. Die Materialien umfassen Versuchsbeschreibungen, Skizzen, Sicherheitsanweisungen und Auswertungsfragen, die den Lernprozess unterstützen sollen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "4Qb_-azjGY1U" ;
    dcterms:subject <http://example.org/education/concept/Brennstoffzelle>,
        <http://example.org/education/concept/Chemikalien_und_Sicherheit>,
        <http://example.org/education/concept/Druckverlust>,
        <http://example.org/education/concept/Elektrolyse>,
        <http://example.org/education/concept/Filterpapier>,
        <http://example.org/education/concept/Filtration>,
        <http://example.org/education/concept/Filtrationsprozesse>,
        <http://example.org/education/concept/R%C3%BChrvorgang>,
        <http://example.org/education/concept/Rohrleitungssysteme>,
        <http://example.org/education/concept/Suspensionen> ;
    dcterms:title "Praktikum zur Untersuchung von Einflussgrößen auf den Druckverlust in Rohrleitungssystemen, Filtrationsprozesse und Rührvorgang."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:4SJBC0BaGOLE a edu:LearningResource ;
    sim:similarTo oer:4WTsN5Lsc8dA ;
    dcterms:creator <http://example.org/education/person/Carter>,
        <http://example.org/education/person/Johnson>,
        <http://example.org/education/person/Lee> ;
    dcterms:description "Dieses Essay behandelt die Bedeutung von Theater in der Schule als Möglichkeit für Lehrerinnen und Lehrer, ihre Rolle zu reflektieren und sich persönlich weiterzuentwickeln. Durch das Spielen mit Rollen und Identitäten kann die eigene Persönlichkeit neu entfaltet werden, ohne auf eine bestimmte Lebenszeit oder Altersgruppe angewiesen zu sein. Der Text bietet Anregungen für eine theaterpädagogische Praxis, die Lehrerinnen und Lehrer in ihrer professionellen Entwicklung unterstützt."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "4SJBC0BaGOLE" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Deutschunterricht>,
        <http://example.org/education/concept/Didaktik_der_deutschen_Sprache_und_Literatur>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/P%C3%A4dagogische_Grundlagenforschung>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitsentfaltung>,
        <http://example.org/education/concept/Rollenflucht>,
        <http://example.org/education/concept/Schultheater>,
        <http://example.org/education/concept/Selbstentwicklung>,
        <http://example.org/education/concept/Theater_in_der_Schule>,
        <http://example.org/education/concept/Theaterp%C3%A4dagogik> ;
    dcterms:title "Schul_Theater als Hoffnung auf Rollenflucht Eine egozentrische Streitschrift und ein Nachruf aus der Einsamkeit"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:4VfhxkqcZZR8 a edu:LearningResource ;
    sim:similarTo oer:4fBMimUGkj4g ;
    dcterms:creator <http://example.org/education/person/Winkler> ;
    dcterms:description "Die Windenergie spielt eine wichtige Rolle bei der Erreichung der Klimaziele und kann einen bedeutenden Beitrag zur Stromerzeugung leisten, wenn sie sorgfältig geplant und umgesetzt wird. Neben den Vorteilen der Windenergie werden auch die Herausforderungen und Kritikpunkte wie Lärmbelästigung, Infraschall und fehlende Kontinuität in der Stromversorgung diskutiert. Durch die Auseinandersetzung mit diesen Aspekten können Leser ein umfassendes Verständnis der Windenergie als Element eines klugen Energiemixes entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4VfhxkqcZZR8" ;
    dcterms:publisher <http://example.org/education/organization/I%27ve_Analyzed_The_Document__But_I_Didn%27t_Find_Any_Email_Addresses._The_Document_Appears_To_Be_a_Research_Paper_Or_Report_On_Wind_Energy_And_Its_Implications__And_It_Doesn%27t_Contain_Any_Email_Addresses.therefore__I_Will_Return_An_Empty_String_As_There_Are_No_University_Domains_Or_Names_To_Extract.> ;
    dcterms:subject <http://example.org/education/concept/%C3%96kobilanz>,
        <http://example.org/education/concept/Energiepolitik>,
        <http://example.org/education/concept/Energiewende>,
        <http://example.org/education/concept/Erneuerbare_Energie>,
        <http://example.org/education/concept/Gesundheitsrisiken>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Stromerzeugung>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Windenergie> ;
    dcterms:title "Herausforderungen des Klimawandels"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:4Y9vNe5UD-kw a edu:LearningResource ;
    sim:similarTo oer:4iU7PFQ1hIY0 ;
    dcterms:creator <http://example.org/education/person/Mathiszik> ;
    dcterms:description "Die Bildung für nachhaltige Entwicklung (BNE) ist ein wichtiger Aspekt der Berufsdidaktik in Chemietechnik und Labor- und Prozesstechnik, um Lernende auf die Herausforderungen einer nachhaltigen Zukunft vorzubereiten. Durch die Auseinandersetzung mit BNE können Lernende Kompetenzen wie systemorientiertes Denken, strategisches Handeln und die Fähigkeit zur Analyse komplexer Problemsituationen entwickeln. Ziel ist es, dass Lernende zu reflektierten und verantwortungsbewussten Akteuren in der Arbeitswelt werden, die aktiv an der Gestaltung einer nachhaltigen Entwicklung teilhaben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4Y9vNe5UD-kw" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Berufsbildung>,
        <http://example.org/education/concept/Berufsdidaktik>,
        <http://example.org/education/concept/Bildung_f%C3%BCr_nachhaltige_Entwicklung>,
        <http://example.org/education/concept/Chemietechnik>,
        <http://example.org/education/concept/Erziehung_zur_Nachhaltigkeit>,
        <http://example.org/education/concept/Fachdidaktik>,
        <http://example.org/education/concept/Labor-_und_Prozesstechnik>,
        <http://example.org/education/concept/Nachhaltige_Entwicklung>,
        <http://example.org/education/concept/Sustainable_Development_Goals>,
        <http://example.org/education/concept/Umweltbildung> ;
    dcterms:title "Nachhaltige Entwicklung und BNE in Arbeitswelt und Unterricht BFR Chemietechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:4f0N6oO2VH_Y a edu:LearningResource ;
    sim:similarTo oer:7nRIGGi8bNGo ;
    dcterms:creator <http://example.org/education/person/Mokot> ;
    dcterms:description "Die Präsentation behandelt das Konzept der Medienkompetenz und ihre verschiedenen Dimensionen, wie Medienkritik, Medienkunde, Mediennutzung und Mediengestaltung. Durch die Aneignung dieser Fähigkeiten können Lerner aktiv und reflektiert mit verschiedenen Medien umgehen und sie für ihr Kommunikations- und Handlungsrepertoire nutzen. Die Präsentation bietet eine Übersicht über die Bestandteile von Medienkompetenz, wie Medienliteralität und Interaktions-Kompetenz, und unterstützt Lerner bei der Entwicklung ihrer kommunikativen Fähigkeiten."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "4f0N6oO2VH_Y" ;
    dcterms:subject <http://example.org/education/concept/Computerunterst%C3%BCtztes_Lernen>,
        <http://example.org/education/concept/Information_Retrieval>,
        <http://example.org/education/concept/Informationskompetenz>,
        <http://example.org/education/concept/Interaktionsdesign>,
        <http://example.org/education/concept/Kommunikative_Kompetenz>,
        <http://example.org/education/concept/Mediengestaltung>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Medienkritik>,
        <http://example.org/education/concept/Mediennutzung>,
        <http://example.org/education/concept/Selbstgesteuertes_Lernen> ;
    dcterms:title "Medienkompetenz als eine Lernaufgabe"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

