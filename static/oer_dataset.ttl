        oer:9oymdMlIaP4g ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die Grundlagen der Linguistik und Sprachgeschichte des Deutschen behandeln die Wortarten, ihre Klassifikation und Deklination, sowie die Morphologie und Flexion von Substantiven, Adjektiven, Pronomen, Verben, Adverbien, Präpositionen, Konjunktionen und Partikeln. Durch das Studium dieser Inhalte können Lernende die Struktur und Bildung von Wörtern und Sätzen verstehen und ihre Fähigkeiten in der Analyse und Erstellung von Texten verbessern. Zudem werden sie mit den grundlegenden Begriffen und Konzepten der Linguistik vertraut, um ihre Kenntnisse über die deutsche Sprache zu erweitern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7G3jrWbBmHdY" ;
    dcterms:subject <http://example.org/education/concept/Deklination>,
        <http://example.org/education/concept/Flexion>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Konjugation>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Morphologie>,
        <http://example.org/education/concept/Phonologie>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Sprachwissenschaft>,
        <http://example.org/education/concept/Wortarten> ;
    dcterms:title "Grundlagen der Linguistik und Sprachgeschichte des Deutschen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

