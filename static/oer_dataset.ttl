        <http://example.org/education/concept/Sicherheitskonzepte>,
        <http://example.org/education/concept/Verschl%C3%BCsselung> ;
    dcterms:title "Beabsichtigter Stundenverlauf Kurs: Informatik 11. Klasse FOS"@de ;
    dcterms:type <http://example.org/education/type/Stundenplanung> .

