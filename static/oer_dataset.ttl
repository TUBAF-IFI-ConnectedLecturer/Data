    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von spurgeführten Fahrzeugen und vergleicht den Grund- und Luftwiderstand bei verschiedenen Fahrzeugtypen wie Güterzügen, Straßenfahrzeugen und Hochgeschwindigkeitszügen. Durch die Analyse von Beispielen und Diagrammen können Studierende die Einflussfaktoren auf den Widerstand von Fahrzeugen verstehen und berechnen. Die Vorlesung bietet eine Einführung in die Ermittlung von Fahrzeugwiderständen und ihre Anwendung in der Praxis."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "17xxNPzzfKJ0k" ;
    dcterms:subject <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Fahrzeugdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/G%C3%BCtertransport>,
        <http://example.org/education/concept/Grundwiderstand>,
        <http://example.org/education/concept/Hochgeschwindigkeitsverkehr>,
        <http://example.org/education/concept/Luftwiderstand>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Stra%C3%9Fenverkehr>,
        <http://example.org/education/concept/Widerstand> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

