        <http://example.org/education/concept/Sachsen>,
        <http://example.org/education/concept/Sicherheit>,
        <http://example.org/education/concept/Verschl%C3%BCsselung> ;
    dcterms:title "Mündliche Abiturprüfung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3IFcAFKeH-Zk a edu:LearningResource ;
    sim:similarTo oer:3U5yNPASal48,
