    dcterms:creator <http://example.org/education/person/Benabdellah>,
        <http://example.org/education/person/L%C3%B6ffler> ;
    dcterms:description "Die Vorlesung Triebfahrzeugtechnik behandelt die Plattform- und Baukastenkonzepte von Triebfahrzeugen und präsentiert verschiedene Ausführungsbeispiele von Herstellern wie Stadler, Alstom, Vossloh, Bombardier und Siemens. Durch diese Beispiele können Studierende die unterschiedlichen Konzepte und Technologien von Triebfahrzeugen kennenlernen und vergleichen. Die Vorlesung bietet einen Überblick über die verschiedenen Plattform- und Baukastenkonzepte und ihre Anwendung in der Praxis."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11I1pkMJ9ITAg" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Baukastenkonzept>,
        <http://example.org/education/concept/Dieselmotor>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Elektromotor>,
