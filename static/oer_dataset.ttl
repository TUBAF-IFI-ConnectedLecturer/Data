oer:11CY0kNiYNQVw a edu:LearningResource ;
    sim:similarTo oer:11jlJ48JWrZy0,
        oer:3ZIWanWe9XPs,
        oer:3iHSCL63l5dI,
        oer:52Li3YcIz_0s ;
    dcterms:creator <http://example.org/education/person/Reithmeier> ;
    dcterms:description "Ein Router verwendet eine Routingtabelle, um Pakete anhand von Zieladressen und Netzadressen zu leiten. Die Tabelle enthält Informationen wie IP-Adress-Bereiche des Ziels, die IP-Adresse des nächsten Routers und den Weg zum Ziel. Durch das Verständnis der Funktionsweise von Routern und Routingtabellen können Lerner die Grundlagen von Netzwerken und Datenübertragung besser verstehen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "11CY0kNiYNQVw" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Computerkommunikation>,
        <http://example.org/education/concept/Daten%C3%BCbertragung>,
        <http://example.org/education/concept/Gateway>,
        <http://example.org/education/concept/IP-Adresse>,
        <http://example.org/education/concept/Kommunikationsprotokolle>,
        <http://example.org/education/concept/Netzwerkarchitektur>,
        <http://example.org/education/concept/Netzwerke>,
        <http://example.org/education/concept/Paketvermittlung>,
        <http://example.org/education/concept/Router>,
        <http://example.org/education/concept/Routing> ;
    dcterms:title "Routingtabellen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:11DbW0-GhlHlI a edu:LearningResource ;
    sim:similarTo oer:12V_QgBpb2svQ,
        oer:6vjvaLSf1iBc,
        oer:9OL5yl-XUgL8,
        oer:9eaZL3SsAYMY ;
    dcterms:creator <http://example.org/education/person/Spallek> ;
    dcterms:description "Die Speicherhierarchie eines Computers besteht aus verschiedenen Ebenen, von Registern über Cache und Haupt-speicher bis hin zu sekundären Speichern, die sich in ihrer Kapazität, Zugriffszeit und Bandbreite unterscheiden. Durch die Verwendung von Caches kann die Geschwindigkeit des Systems erhöht werden, indem häufig benötigte Daten schnell verfügbar gemacht werden. Die Wahl der richtigen Cache-Organisation und -Verwaltung ist entscheidend für die Leistung eines Computersystems."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11DbW0-GhlHlI" ;
    dcterms:subject <http://example.org/education/concept/Cache-Speicher>,
        <http://example.org/education/concept/Computer-Hardware>,
        <http://example.org/education/concept/Datenspeicherung>,
        <http://example.org/education/concept/Hauptspeicher>,
        <http://example.org/education/concept/Prozessor-_Architektur>,
        <http://example.org/education/concept/Rechnerstrukturen>,
        <http://example.org/education/concept/Registersatz>,
        <http://example.org/education/concept/Speicherarchitektur>,
        <http://example.org/education/concept/Speicherhierarchie>,
        <http://example.org/education/concept/Stack> ;
    dcterms:title "Speicherarchitektur Rechnerstrukturen und -organisation"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:11HctxVZiYAH0 a edu:LearningResource ;
    sim:similarTo oer:6SMLnbN_sbes,
        oer:6YX0YqqWvEh4,
        oer:6qOIcoRi0vtk,
        oer:7FSHwJBd6_EE ;
    dcterms:description "Dieses Lehrmaterial behandelt die Berechnung und Auslegung von Wärmeübertragern, insbesondere Gegenstrom- und Gleichstromwärmeübertrager, und bietet Übungsaufgaben und Lösungen für die Anwendung von Diagrammen und Formeln. Durch das Studium dieses Materials können Lerner die grundlegenden Konzepte des Wärmeübergangs verstehen und praktische Fähigkeiten in der Auslegung von Wärmeübertragern erwerben. Die Übungsaufgaben und Lösungen decken eine Vielzahl von Szenarien ab, darunter den Wärmeübergang in Rohrleitungen, die Berechnung von Wärmestrom und Temperaturdifferenz sowie die Auslegung von Wärmeübertragern für verschiedene Anwendungen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11HctxVZiYAH0" ;
    dcterms:subject <http://example.org/education/concept/Gegenstromw%C3%A4rme%C3%BCbertrager>,
        <http://example.org/education/concept/Heizregister>,
        <http://example.org/education/concept/K%C3%BChlwassersystem>,
        <http://example.org/education/concept/L%C3%BCftungsanlage>,
        <http://example.org/education/concept/Massenstrom>,
        <http://example.org/education/concept/Rohrreibungswiderstand>,
        <http://example.org/education/concept/W%C3%A4rme%C3%BCbertragung>,
        <http://example.org/education/concept/W%C3%A4rmeleistung>,
        <http://example.org/education/concept/W%C3%A4rmewirtschaft>,
        <http://example.org/education/concept/logarithmische_Temperaturdifferenz> ;
    dcterms:title "Übungsbuch Wärmeübertrager"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:11bQ6i48uOtZQ a edu:LearningResource ;
    sim:similarTo oer:123PNvJu5j8hY,
        oer:12DU-JPZQDdlc,
        oer:12eoSXJC8dwtY,
        oer:3V5F_dlMuvnI ;
    dcterms:creator <http://example.org/education/person/Petrahn> ;
    dcterms:description "Die Vorlesung Vermessungslehre behandelt das Strecken-Nivellement und erläutert die Berechnungen der Höhenunterschiede zwischen Zwischenblicken. Durch diese Lektion können Studierende die Grundlagen der Höhenmessung, insbesondere des Nivelllements, verstehen und anwenden. Sie lernen, wie sie Zwischenblicke berechnen und protokollieren können, um ein Längsprofil zu erstellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11bQ6i48uOtZQ" ;
    dcterms:subject <http://example.org/education/concept/Geod%C3%A4sie>,
        <http://example.org/education/concept/H%C3%B6henmessung>,
        <http://example.org/education/concept/Ingenieurvermessung>,
        <http://example.org/education/concept/Kartographie>,
        <http://example.org/education/concept/Landesvermessung>,
        <http://example.org/education/concept/Nivellement>,
        <http://example.org/education/concept/Strecken-Nivellement>,
        <http://example.org/education/concept/Vermessungslehre>,
        <http://example.org/education/concept/Vermessungstechnik>,
        <http://example.org/education/concept/Zwischenblicke> ;
    dcterms:title "5. Vorlesung Vermessungslehre"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:11gTrGspv6R2w a edu:LearningResource ;
    sim:similarTo oer:11uGCYruqbu8g,
        oer:5b7aD1O5bv7I ;
    dcterms:creator <http://example.org/education/person/Mayer>,
        <http://example.org/education/person/Meier>,
        <http://example.org/education/person/Wellnitz> ;
    dcterms:description "Die Erkenntnisprozesse in der Biologie werden durch die Verwendung von Beobachtungen, Messungen und Experimenten unterstützt, um Zusammenhänge zwischen Variablen zu erkennen und Hypothesen zu überprüfen. Durch die Anwendung von Gütekriterien wie Reliabilität, Validität und Objektivität können Forscherinnen sicherstellen, dass ihre Ergebnisse zuverlässig und generalisierbar sind. Die systematische Vorgehensweise bei der Datenerhebung und -auswertung ermöglicht es, komplexe biologische Systeme zu verstehen und Erkenntnisse über die Natur zu gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11gTrGspv6R2w" ;
    dcterms:subject <http://example.org/education/concept/Beobachtung>,
        <http://example.org/education/concept/Biologie>,
        <http://example.org/education/concept/Datenerhebung>,
        <http://example.org/education/concept/Erkenntnisprozess>,
        <http://example.org/education/concept/Fachdidaktik>,
        <http://example.org/education/concept/Forschungsmethoden>,
        <http://example.org/education/concept/G%C3%BCtekriterien>,
        <http://example.org/education/concept/Reliabilit%C3%A4t>,
        <http://example.org/education/concept/Validit%C3%A4t>,
        <http://example.org/education/concept/Wissenschaftliches_Arbeiten> ;
    dcterms:title "Fachdidaktik Biologie: Grundlagen (Ü 3)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:11hggHUOD1WGc a edu:LearningResource ;
    sim:similarTo oer:12Ub1NAhpZt3o,
        oer:4vptIKLr5Zp8 ;
    dcterms:description "Das Lernvideo soll die Plattform Dhoch3-Moodle bekannter machen und eine leichtere Nutzung ermöglichen, indem es die Zielgruppe durch interaktive Elemente wie Klickwege, Struktur und Logo anspricht. Durch das Video sollen die Zuschauer:innen lernen, wie sie die Plattform nutzen können, um ihre eigenen Inhalte zu erstellen und zu teilen. Am Ende des Videos sollen die Lerner in der Lage sein, die Plattform selbstständig zu nutzen und ihre eigenen Inhalte zu erstellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11hggHUOD1WGc" ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Interaktives_Video>,
        <http://example.org/education/concept/Lehrvideo>,
        <http://example.org/education/concept/Lernplattform>,
        <http://example.org/education/concept/Mediendidaktik>,
        <http://example.org/education/concept/Moodle>,
        <http://example.org/education/concept/Plattform>,
        <http://example.org/education/concept/Unterrichtsmedien> ;
    dcterms:title "PRODUKTION  ARBEITSPLAN VERÖFFENTLICHUNG Dhoch3-Moodle: Was bringt es mir?"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:11jz8hZxcw-gw a edu:LearningResource ;
    dcterms:description "Die Diskussion um die Eintrittspreise in Museen und Bibliotheken dreht sich darum, ob die Zugänglichkeit zu Bildung und Information kostenfrei sein sollte oder nicht. Die Frage nach der Finanzierung dieser Einrichtungen steht im Mittelpunkt, insbesondere wenn es um die Rolle von Museen als Gedächtnisinstitutionen und außerschulischen Bildungsstätten geht. Durch die Lektüre dieses Dokuments können Lernende ein tieferes Verständnis dafür gewinnen, wie die Finanzierung von Museen und Bibliotheken funktioniert und welche Auswirkungen dies auf die Zugänglichkeit zu Bildung hat."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "11jz8hZxcw-gw" ;
    dcterms:publisher <http://example.org/education/organization/After_Analyzing_The_Document__I_Found_No_Explicit_Mentions_Of_a_University_Or_Institution_Name._The_Text_Appears_To_Be_a_Discussion_About_Museum_Cataloging_And_Indexing__With_References_To_General_Concepts_And_Ideas_Rather_Than_Specific_Institutions.therefore__I_Will_Return_An_Empty_String_As_There_Is_No_Prominent_Institution_Mentioned_In_The_Document.> ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentliche_Hand>,
        <http://example.org/education/concept/Bibliotheken>,
        <http://example.org/education/concept/Bildungspolitik>,
        <http://example.org/education/concept/Eintrittsgelder>,
        <http://example.org/education/concept/Finanzierung>,
        <http://example.org/education/concept/Informationsfreiheit>,
        <http://example.org/education/concept/Kulturpolitik>,
        <http://example.org/education/concept/Museen>,
        <http://example.org/education/concept/Privatmuseen>,
        <http://example.org/education/concept/Zugang_zu_Informationen> ;
    dcterms:title "Die Rolle der Museen im Bildungssystem eines Landes"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:11oBdgdq4biBk a edu:LearningResource ;
    dcterms:description "Die Taxonomie von Lernzielen im affektiven Bereich umfasst fünf Ebenen, die den Schülern helfen, ihre Gefühle und Emotionen zu erkennen und zu organisieren. Durch diese Ebenen können sie ihre Werte und Einstellungen entwickeln und verteidigen, auch mit Leidenschaft. Dieses Konzept unterstützt Lehrer bei der Planung von Unterrichtsstunden, um Schülern eine handlungsorientierte Didaktik anzubieten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11oBdgdq4biBk" ;
    dcterms:subject <http://example.org/education/concept/Affektives_Lernen>,
        <http://example.org/education/concept/Bildungsziele>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Emotionen>,
        <http://example.org/education/concept/Gef%C3%BChle>,
