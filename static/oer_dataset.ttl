        oer:8mqDmRgDPbLI ;
    dcterms:creator <http://example.org/education/person/Dijkstra>,
        <http://example.org/education/person/Moore-Bellman> ;
    dcterms:description "Der Floyd-Warshall-Algorithmus berechnet die kürzesten Wege zwischen allen Knoten in einem gerichteten Graphen und liefert eine Matrix der kürzesten Weglängen. Der Algorithmus hat eine Laufzeit von O(n³) und ist nur anwendbar, wenn der Graph keine negativen Kreise enthält. Durch die Anwendung des Algorithmus können Learner die kürzesten Wege in einem Graphen bestimmen und die Eigenschaften von Graphen besser verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4JmjCqLZJw3U" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Dijkstra-Algorithmus>,
        <http://example.org/education/concept/Floyd-Warshall-Algorithmus>,
        <http://example.org/education/concept/Graphen>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Kurzeste_Wege>,
        <http://example.org/education/concept/Netzwerke>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Verkehrswesen> ;
    dcterms:title "Kurzeste Wege"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

