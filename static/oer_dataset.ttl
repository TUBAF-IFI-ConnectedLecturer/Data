        <http://example.org/education/concept/Shiny-Dashboard>,
        <http://example.org/education/concept/Sportdatenanalyse>,
        <http://example.org/education/concept/Tracking-Daten>,
        <http://example.org/education/concept/Verkehr> ;
    dcterms:title "Kursorganisation Spezifische Aspekte von Data Analytics Winter Term 2021/2022"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5Mx04kxxLbDQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hertel> ;
    dcterms:description "Die vorliegende Aktenliste enthält Pläne und Dokumente zum Schloss Übigau bei Dresden aus dem 18. Jahrhundert, darunter Grundrisse, Aufrisse und Kostenanschläge für Umbauten und Neubauten. Die Akten stammen aus verschiedenen Archiven, wie dem Hauptstaatsarchiv Dresden und dem Oberbergamt Sachsen. Durch die Analyse dieser Dokumente können Historiker und Restauratoren Einblick in die Baugeschichte des Schlosses Übigau gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Mx04kxxLbDQ" ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cbigau>,
        <http://example.org/education/concept/Architektur>,
        <http://example.org/education/concept/Baugeschichte>,
        <http://example.org/education/concept/Denkmalpflege>,
