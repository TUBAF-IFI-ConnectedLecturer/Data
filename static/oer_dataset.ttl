oer:38uPV4VdYK1s a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Menzel> ;
    dcterms:description "Topologien sind ein Werkzeug, um die Einhaltung von Konsistenzregeln innerhalb von Feature Classes zu überprüfen und herzustellen. Durch die Anwendung von Topologien können Fehler in den Daten erkannt und behoben werden, um eine konsistente Überdeckung des Gebietes zu gewährleisten. Die Verwendung von Topologien in ArcGIS ermöglicht es, Regeln für die Beziehungen zwischen Features festzulegen und diese auf ihre Gültigkeit zu überprüfen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "38uPV4VdYK1s" ;
    dcterms:subject <http://example.org/education/concept/ArcGIS>,
        <http://example.org/education/concept/Datenintegration>,
        <http://example.org/education/concept/Feature_Classes>,
        <http://example.org/education/concept/GIS>,
        <http://example.org/education/concept/Geodatabase>,
        <http://example.org/education/concept/Geoinformatik>,
        <http://example.org/education/concept/Kartographie>,
        <http://example.org/education/concept/Raumbezug>,
        <http://example.org/education/concept/Spatial_Referenz>,
        <http://example.org/education/concept/Topologie> ;
    dcterms:title "Was sind Topologien und wozu benötigt man sie"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:3GFZMDtuiYCY a edu:LearningResource ;
    sim:similarTo oer:4ik3f_fLbWQg,
        oer:7fbJ_JVHp_j0 ;
    dcterms:creator <http://example.org/education/person/Scheffel> ;
    dcterms:description "Die Vorlesung behandelt die Charakterisierung und Diagnose von Angststörungen, einschließlich spezifischer Phobien, sozialer Phobie, generalisierter Angststörung, Panikstörung und Agoraphobie. Es werden verschiedene Erklärungsansätze für die Entstehung und Aufrechterhaltung von Angststörungen vorgestellt, darunter genetische Faktoren, biopsychologische Theorien, Trait-Theorien, interaktionistische Theorien, Lerntheorien und kognitive Theorien. Durch die Vorlesung sollen Studierende in der Lage sein, Angststörungen zu beschreiben, integrative Erklärungsansätze nachzuvollziehen und differentiellpsychologische Aspekte zu verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3GFZMDtuiYCY" ;
    dcterms:subject <http://example.org/education/concept/Agoraphobie>,
        <http://example.org/education/concept/Angstst%C3%B6rungen>,
        <http://example.org/education/concept/Differentielle_Psychologie>,
        <http://example.org/education/concept/Generalisierte_Angstst%C3%B6rung>,
        <http://example.org/education/concept/Klinische_Psychologie>,
        <http://example.org/education/concept/Panikst%C3%B6rung>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitstheorien>,
        <http://example.org/education/concept/Phobien>,
        <http://example.org/education/concept/Posttraumatische_Belastungsst%C3%B6rung>,
        <http://example.org/education/concept/Soziale_Phobie> ;
    dcterms:title "S.PP. 03 Anwendungsbereich Klinische Psychologie: Angststörungen Differentielle und Persönlichkeitspsychologie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

