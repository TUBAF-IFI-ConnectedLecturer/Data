        <http://example.org/education/concept/kategorischer_Imperativ>,
        <http://example.org/education/concept/praktische_Vernunft> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenpool> .

