        <http://example.org/education/concept/Virtuelle_Umgebungen>,
        <http://example.org/education/concept/Virtueller_Klassenraum> ;
    dcterms:title "Baukasten für einen virtuellen Klassenraum"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:3kgf3ZWOsuwY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Zschoche> ;
    dcterms:description "Die europäische Integration steht möglicherweise im Widerspruch zur Demokratie, da eine vertiefte Integration nur möglich sei, wenn sie nicht demokratisch legitimiert sein müsse. Die These wird begründet durch die fehlende Unterstützung einer politischen Integration in den Mitgliedsstaaten und das Fehlen von Mehrheiten bei demokratisch geführten Wahlen. Das mitteleuropäische Paradoxon, das eine europäische Integration unter einer wirklich demokratisch erzielten Legitimität als unmöglich erscheinen lässt, könnte ein EU-weites Phänomen sein."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3kgf3ZWOsuwY" ;
    dcterms:subject <http://example.org/education/concept/Brexit>,
        <http://example.org/education/concept/Demokratie>,
        <http://example.org/education/concept/EU-Politik>,
        <http://example.org/education/concept/Europ%C3%A4ische_Integration>,
        <http://example.org/education/concept/Fl%C3%BCchtlingsfragen>,
        <http://example.org/education/concept/Rechtspopulismus>,
        <http://example.org/education/concept/Sozialpolitik>,
        <http://example.org/education/concept/europ%C3%A4ischer_F%C3%B6deralismus>,
        <http://example.org/education/concept/politische_Legitimit%C3%A4t>,
        <http://example.org/education/concept/politische_Union> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

