oer:9h_vYcI6Oin4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schneider> ;
    dcterms:description "Das Sequenzalignment ist ein wichtiger Aspekt der Bioinformatik, bei dem die Ähnlichkeit zwischen zwei DNA- oder Proteinsträngen bestimmt wird, um evolutionäre Verwandtschaften festzustellen oder bestimmte Proteine zu identifizieren. Der Needleman-Wunsch-Algorithmus ist ein bekannter Ansatz für das globale Alignment, dessen Laufzeit und Speicherverbrauch optimiert werden müssen, um große Datenmengen verarbeiten zu können. Durch die Analyse der Laufzeiten und des Speicherverbrauchs kann man Optimierungen entwickeln, um den Algorithmus effizienter zu machen und größere Datenmengen zu verarbeiten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9h_vYcI6Oin4" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Bioinformatik>,
        <http://example.org/education/concept/DNA-Sequenzierung>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Genomik>,
        <http://example.org/education/concept/JavaScript>,
        <http://example.org/education/concept/Laufzeitmessung>,
        <http://example.org/education/concept/Needleman-Wunsch-Algorithmus>,
        <http://example.org/education/concept/Programmiersprachen>,
        <http://example.org/education/concept/Typescript> ;
    dcterms:title "Stringalignment und Laufzeitmessung eines Needleman-Wunsch-Algorithmus in JavaScript"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:9vNzW1CbK-Q0 a edu:LearningResource ;
    dcterms:description "Die Universität als Ort der Bildung und des Lernens wird durch gesellschaftliche Differenzverhältnisse strukturiert, die pädagogische Reflexionen und Handlungsstrategien beeinflussen. Durch die Anerkennung von Differenz können individuelle Handlungsfähigkeiten gefördert werden, indem spezifische Fähigkeiten, Empfindsamkeiten, Dispositionen und Vermögen von Subjekten angesprochen und zur Geltung gebracht werden. Die Thematisierung von Unterschieden, Differenzen, Vielfalt und Heterogenität in der Erziehungswissenschaft ermöglicht eine kritische Reflexion über egalitaristische Traditionen und die Förderung einer inklusiven Bildung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9vNzW1CbK-Q0" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_a_Hint_About_The_Author%27s_Institutional_Affiliation%3Auniversit%C3%A4t_Hamburgthis_Is_The_Most_Prominent_Mention_Of_An_Institution_In_The_Text.> ;
    dcterms:subject <http://example.org/education/concept/Anerkennung>,
        <http://example.org/education/concept/Bildungsphilosophie>,
        <http://example.org/education/concept/Dekonstruktion>,
        <http://example.org/education/concept/Differenz>,
        <http://example.org/education/concept/Erziehungswissenschaft>,
        <http://example.org/education/concept/Geschlechterforschung>,
        <http://example.org/education/concept/Hochschulbildung>,
        <http://example.org/education/concept/Identit%C3%A4t>,
        <http://example.org/education/concept/P%C3%A4dagogik>,
        <http://example.org/education/concept/Universit%C3%A4t> ;
    dcterms:title "Differenzverhältnisse in der Erziehungswissenschaft"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

