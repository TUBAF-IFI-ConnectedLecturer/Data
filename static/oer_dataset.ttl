    dcterms:creator <http://example.org/education/person/Debus>,
        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übungsaufgaben behandeln komplexe Funktionen und Differenzierbarkeit, harmonische Funktionen und konjugiert harmonische Funktionen sowie die graphische Darstellung von Niveaulinien. Durch das Lösen dieser Aufgaben erwerben die Lernenden Kenntnisse über die Anwendung der Cauchy-Riemannschen Differentialgleichungen auf Differenzierbarkeit und die Bestimmung komplexer Potentiale. Die Übungsaufgaben dienen der Vertiefung des mathematischen Verständnisses im Bereich der Funktionentheorie."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3Ax0dNPV9ANM" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Cauchy-Riemannsche_Differentialgleichungen>,
        <http://example.org/education/concept/Differenzierbarkeit>,
        <http://example.org/education/concept/Harmonische_Funktionen>,
        <http://example.org/education/concept/Komplexe_Funktionen>,
        <http://example.org/education/concept/Komplexes_Potential>,
        <http://example.org/education/concept/Konjugiert_harmonische_Funktionen>,
        <http://example.org/education/concept/Mathematische_Analysis>,
        <http://example.org/education/concept/Niveaulinien>,
        <http://example.org/education/concept/Skalarprodukt>,
        <http://example.org/education/concept/Tangentenvektoren> ;
    dcterms:title "Mathematik IV (für IF, ET, Ph) Sommersemester 2025"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

