    dcterms:creator <http://example.org/education/person/Eschenburg> ;
    dcterms:description "Die affine Geometrie wird durch die Verbindung von Punkten und Vektoren begründet, wobei die Translationen und zentrischen Streckungen als Grundoperationen dienen. Durch diese algebraische Struktur können geometrische Sachverhalte anschaulich dargestellt und analysiert werden. Die Lernenden gewinnen ein Verständnis der Beziehungen zwischen Punkten, Geraden und Ebenen und lernen, diese Beziehungen durch lineare Algebra auszudrücken."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "52NSb-r7L844" ;
    dcterms:subject <http://example.org/education/concept/Af%EF%AC%81ne_Geometrie>,
        <http://example.org/education/concept/Algebraische_Strukturen>,
        <http://example.org/education/concept/Geometrische_Abbildungen>,
        <http://example.org/education/concept/Kollineation>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematische_Anschauung>,
        <http://example.org/education/concept/Parallelit%C3%A4t>,
        <http://example.org/education/concept/Symmetrie>,
        <http://example.org/education/concept/Translation>,
        <http://example.org/education/concept/Vektorraum> ;
    dcterms:title "Affine Geometrie"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:6_3EOj1JLaUs a edu:LearningResource ;
    sim:similarTo oer:6cePXbZSba3A,
        oer:7I5DLtd4cXus,
