        <http://example.org/education/concept/Netzwerke>,
        <http://example.org/education/concept/Platform_as_a_Service>,
        <http://example.org/education/concept/Serverless_Computing> ;
    dcterms:title "Vorlesung SCC  Microservices Prof. Distributed and Networked Systems  Dr. Iris Braun"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

