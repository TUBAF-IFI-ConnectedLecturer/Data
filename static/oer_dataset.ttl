    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung Triebfahrzeugtechnik behandelt die Antriebskonfigurationen von Fahrzeugen, insbesondere die hydrodynamischen Leistungsübertragungen und ihre verschiedenen Typen wie Wandlergetriebe, Strömungsgetriebe und Turbowendegetriebe. Durch das Studium dieser Materialien können Lernende die Funktionsweise und den Einsatz dieser Getriebearten in Lokomotiven und Triebwagen verstehen und ihre Vor- und Nachteile beurteilen. Zudem werden die Berechnungen und Kennzahlen für den Wandlerbetrieb erläutert, um eine fundierte Entscheidung für die Auswahl eines bestimmten Getriebetyps treffen zu können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10jZf8d2v2ZJg" ;
    dcterms:subject <http://example.org/education/concept/Antriebskonfigurationen>,
        <http://example.org/education/concept/Fahrzeugantriebe>,
        <http://example.org/education/concept/Hydrodynamische_Getriebe>,
        <http://example.org/education/concept/Kupplungssysteme>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragungen>,
        <http://example.org/education/concept/Lokomotivbau>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Str%C3%B6mungsgetriebe>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Wandlergetriebe> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

