    dcterms:title "Fahrdynamik für Verkehrsingenieure"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9jfKL3NiIpew a edu:LearningResource ;
    sim:similarTo oer:9m0-cT0DK01s,
        oer:9rvvaBPXMeZo,
