        oer:9P66tpN4ETvM ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Organisation eines Unternehmens wird durch die Aufbauorganisation und Ablauforganisation bestimmt, wobei die Aufgabenverteilung, Informationsflüsse und Weisungsbefugnisse geregelt werden. Die verschiedenen Organisationsformen, wie Einliniensystem, Stabliniensystem und Mehrliniensystem, haben jeweils ihre Vorteile und Nachteile. Durch das Verständnis dieser Konzepte können Studierende die Struktur und Funktion eines Unternehmens besser verstehen und effektiver zusammenarbeiten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "13E_kjXFi9vwY" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen_Institut_F%C3%BCr_Verfahrenstechnik_Und_Umwelttechnik> ;
    dcterms:subject <http://example.org/education/concept/Ablauforganisation>,
        <http://example.org/education/concept/Aufbauorganisation>,
        <http://example.org/education/concept/F%C3%BChrungsstruktur>,
