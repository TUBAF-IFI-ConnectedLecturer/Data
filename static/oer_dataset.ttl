    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung Triebfahrzeugtechnik behandelt die Antriebskonfigurationen von Fahrzeugen, insbesondere die elektrische Leistungsübertragung und die verschiedenen Typen von Generatoren und Fahrmotoren. Durch das Studium dieser Materialien können Lernende ein Verständnis dafür entwickeln, wie verschiedene Antriebstechnologien funktionieren und welche Vorteile sie bieten. Sie erhalten Einblick in die Charakterisierung von Gleichstromreihenschlussmotoren, Drehstrom-Asynchronmaschinen und andere elektrische Maschinen sowie ihre Anwendung in verschiedenen Fahrzeugtypen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4sQODzwn1CoQ" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Drehstrommotoren>,
        <http://example.org/education/concept/Elektroantriebe>,
        <http://example.org/education/concept/Elektromotoren>,
        <http://example.org/education/concept/Fahrmotoren>,
        <http://example.org/education/concept/Generatoren>,
        <http://example.org/education/concept/Gleichstrommotoren>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Triebfahrzeugtechnik> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

