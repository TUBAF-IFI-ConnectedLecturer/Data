        <http://example.org/education/concept/Router>,
        <http://example.org/education/concept/Subnetze>,
        <http://example.org/education/concept/Telekommunikation> ;
    dcterms:title "Aufbau und Routing IP-Adressen Subnetze"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

