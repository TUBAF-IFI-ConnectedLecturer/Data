    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von Schienenfahrzeugen und deckt Grundlagen wie Fahrwiderstandskräfte, Antriebskräfte und Traktionsvermögen ab. Durch die Lektüre dieser Inhalte können Studierende ein Verständnis für die Dynamik von Schienenfahrzeugen entwickeln und Kenntnisse über die Berechnung von Fahrzeiten und Energiebedarf erwerben. Der Fokus liegt auf dem Schienenverkehr, wobei Aspekte wie Längs-, Quer- und Vertikaldynamik behandelt werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10PWqY5I5dHD8" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Energieeffizienz>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Transportwesen>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Fahrdynamik der Schienenfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

