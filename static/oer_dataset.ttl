    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6qHAFBe79WME a edu:LearningResource ;
    sim:similarTo oer:6whr5UV0yVCA,
        oer:7G3jrWbBmHdY,
        oer:7YIsfs57owuM,
        oer:7fvayFCYIpTA,
        oer:88A7JwgP02xU,
