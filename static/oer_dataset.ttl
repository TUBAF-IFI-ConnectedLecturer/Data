oer:6pKEjxgOf5RQ a edu:LearningResource ;
    sim:similarTo oer:6vSEjaZS6tpU,
        oer:6yfd26GSDwTc ;
    dcterms:creator <http://example.org/education/person/Krauth%C3%A4user> ;
    dcterms:description "Die Spiegelungsmethode ist ein wichtiger Ansatz zur Lösung elektrostatischer Probleme, bei dem die Greensche Funktion verwendet wird, um das elektrische Potential in einem bestimmten Bereich zu berechnen. Durch die Anwendung dieser Methode können Studierende komplexe elektrostatische Aufgaben lösen und ein tiefes Verständnis der elektromagnetischen Phänomene entwickeln. Die Vertiefung in die Spiegelungsmethode ermöglicht es den Lernenden, ihre Fähigkeiten in der Elektrotechnik und Elektromagnetischen Verträglichkeit zu erweitern und anwendungsorientierte Probleme zu lösen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6pKEjxgOf5RQ" ;
    dcterms:subject <http://example.org/education/concept/Bildladungsmethode>,
        <http://example.org/education/concept/Dielektrische_Spiegelung>,
        <http://example.org/education/concept/Elektromagnetische_Vertr%C3%A4glichkeit>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Greensche_Funktionen>,
        <http://example.org/education/concept/Potentialtheorie>,
        <http://example.org/education/concept/Spiegelungsmethode>,
        <http://example.org/education/concept/Theoretische_Elektrotechnik>,
        <http://example.org/education/concept/elektromagnetische_Felder>,
        <http://example.org/education/concept/elektrostatische_Ladungen> ;
    dcterms:title "TET Vertiefung: Spiegelungsmethode"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

