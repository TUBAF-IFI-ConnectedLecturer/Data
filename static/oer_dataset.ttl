        <http://example.org/education/concept/Online-Lexikon>,
        <http://example.org/education/concept/Web-Anwendung>,
        <http://example.org/education/concept/Wiki-Software>,
        <http://example.org/education/concept/Wikipedia>,
        <http://example.org/education/concept/freie_Enzyklop%C3%A4die> ;
    dcterms:title "Die Arbeit mit Mediawiki"@de ;
