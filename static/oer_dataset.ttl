        <http://example.org/education/concept/Knoten>,
        <http://example.org/education/concept/Mathematische_Modellierung>,
        <http://example.org/education/concept/Netzwerkanalyse>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Transportgraphen> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:11TW8-LJyZqKw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Ehmcke>,
        <http://example.org/education/person/Horoch> ;
    dcterms:description "Dieses Seminar behandelt die Begriffsarbeit im Mathematikunterricht und erläutert die verschiedenen Arten von Begriffen, wie formale und Eigenschaftsbegriffe, sowie die Prinzipien ihrer Erarbeitung und Festigung. Durch die Lektüre dieses Materials können Lernende die Grundlagen der Begriffsdefinition und -bildung verstehen und erfahren, wie sie Begriffe im Mathematikunterricht erarbeiten und festigen können. Zudem werden Beispiele für die Anwendung dieser Prinzipien in der mathematischen Fachsprache vorgestellt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11TW8-LJyZqKw" ;
    dcterms:publisher <http://example.org/education/organization/EDID> ;
    dcterms:subject <http://example.org/education/concept/Begriffsbildung>,
        <http://example.org/education/concept/Begriffsdefinition>,
        <http://example.org/education/concept/Grundlagen_des_Mathematikunterrichts>,
        <http://example.org/education/concept/Mathematikdidaktik>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Mathematische_Fachsprache>,
        <http://example.org/education/concept/Mathematisches_Probleml%C3%B6sen>,
        <http://example.org/education/concept/P%C3%A4dagogische_Psychologie>,
        <http://example.org/education/concept/Symbolische_Begriffsdefinition>,
        <http://example.org/education/concept/Umgangssprache> ;
    dcterms:title "Standardsituationen im Mathematikunterricht"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:11TsOpJz53ywM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Okine> ;
    dcterms:description "Dieses Portfolio besteht aus drei Teilen, die sich auf Hören, Lesen und Verstehen konzentrieren, um die Fähigkeiten der Lerner zu verbessern. Durch die Bearbeitung von Aufgaben zu Videos, Texten und Dialogen können Lerner ihre Kenntnisse über München, ihre eigenen Lebenserfahrungen und ihre Fähigkeiten im Deutschkurs erweitern. Die Inhalte behandeln Themen wie Familie, Freunde, Hobbys und Arbeit, um die Kommunikationsfähigkeit der Lerner zu fördern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "11TsOpJz53ywM" ;
    dcterms:publisher <http://example.org/education/organization/HTW_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Deutsch_als_Fremdsprache>,
        <http://example.org/education/concept/Dresden>,
