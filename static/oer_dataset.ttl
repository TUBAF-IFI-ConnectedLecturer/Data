        <http://example.org/education/concept/Schaltungsaufbau>,
        <http://example.org/education/concept/Sensoren>,
        <http://example.org/education/concept/Technische_Informatik> ;
    dcterms:title "Zeitgemäße Informatik im Unterricht mit dem Arduino Uno"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

