        oer:8wSG8iHhwxOY ;
    dcterms:creator <http://example.org/education/person/Strobach>,
        <http://example.org/education/person/Wendt> ;
    dcterms:description "Die Allgemeine Psychologie untersucht allgemeingültige Aussagen über psychische Prozesse an gesunden, jungen Erwachsenen, um die Funktionen des menschlichen Gehirns und Verhaltens zu verstehen. Durch das Studium dieser Materialien können Lernende ein Verständnis der Wahrnehmung, Aufmerksamkeit, Lernen, Gedächtnis, Emotionen und anderen psychischen Prozessen entwickeln. Sie erfahren außerdem über die Methoden und Theorien, die in der Psychologie verwendet werden, um diese Phänomene zu erklären und zu untersuchen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10Bfz_Hou3jLc" ;
    dcterms:subject <http://example.org/education/concept/Aufmerksamkeit>,
        <http://example.org/education/concept/Emotion>,
        <http://example.org/education/concept/Ged%C3%A4chtnis>,
        <http://example.org/education/concept/Kognitionswissenschaft>,
        <http://example.org/education/concept/Konditionierung>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Motivation>,
        <http://example.org/education/concept/Psychologie>,
        <http://example.org/education/concept/Verhalten>,
        <http://example.org/education/concept/Wahrnehmung> ;
    dcterms:title "Allgemeine Psychologie"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

