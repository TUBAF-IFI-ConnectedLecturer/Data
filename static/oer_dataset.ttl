    dcterms:title "Prof. Buchmann - Netz-Sicherheit"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5kh6EN78u7Z8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Djebari>,
        <http://example.org/education/person/Neukirchner>,
        <http://example.org/education/person/Sch%C3%B6ne> ;
    dcterms:description "In diesem Kursmaterial werden Grundlagen der Fachdidaktik Biologie vermittelt und Kompetenzen im Umgang mit Problemen in verschiedenen Situationen erlernt. Durch die Auseinandersetzung mit eigenen Kompetenzdefinitionen sollen Lernende ihre Fähigkeiten zur Problemlösung und Reflexion verbessern. Ziel ist es, eigenständig Wissen anzuwenden, zu reflektieren und in verschiedenen Kontexten umzusetzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5kh6EN78u7Z8" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bildung>,
