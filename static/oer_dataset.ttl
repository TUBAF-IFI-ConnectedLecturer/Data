        <http://example.org/education/concept/Entity-Relationship-Modell>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Informationstechnologie> ;
    dcterms:title "Datenspeicherung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3ThmRhmInsfA a edu:LearningResource ;
    sim:similarTo oer:3dSSIKaEs7yc ;
    dcterms:creator <http://example.org/education/person/Besser> ;
    dcterms:description "Das Organisationsseminar PLANSPIEL behandelt das Thema Inklusive Schule und Gemeinschaftsschule im Kontext von SOSE 2021. Durch die Teilnahme am Seminar können Studierende Kenntnisse über inklusive Bildung erwerben und Erfahrungen in der Zusammenarbeit mit anderen Seminarteilnehmern sammeln. Die Veranstaltung richtet sich an Studierende der Erziehungswissenschaften unter der Leitung von Prof."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3ThmRhmInsfA" ;
    dcterms:subject <http://example.org/education/concept/Bildungsreform>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Einwilligung>,
        <http://example.org/education/concept/Erziehungswissenschaften>,
        <http://example.org/education/concept/Gemeinschaftsschule>,
