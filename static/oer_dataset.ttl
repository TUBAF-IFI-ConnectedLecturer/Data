    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von Eisenbahnfahrzeugen wird durch verschiedene Faktoren wie die Masse des Zuges, den Wagenzugwiderstand und die Langsneigung der Strecke beeinflusst. Durch die Berechnung von Schleppmassen und Grenzlasten können Ingenieure die maximal mögliche Transportkapazität auf einer bestimmten Strecke ermitteln und sicherstellen, dass die Züge auch nach außerplanmäßigen Halten wieder anfahren können. Dieses Wissen ermöglicht es, Eisenbahnstrecken optimal zu planen und den sicheren Betrieb von Güterzügen zu gewährleisten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7I6eto_fcIHY" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Elektrische_Bahnen> ;
    dcterms:subject <http://example.org/education/concept/Anhangegrenzlast>,
        <http://example.org/education/concept/Eisenbahnfahrzeuge>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/G%C3%BCterz%C3%BCge>,
        <http://example.org/education/concept/Grenzlastberechnung>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Schleppmasse>,
        <http://example.org/education/concept/Wagenzugwiderstand>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamische Charakteristiken"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

