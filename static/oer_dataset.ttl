oer:1v3cq87o5dD4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Krahl> ;
    dcterms:description "Hashfunktionen sind eine surjektive mathematische Funktionsklasse, die sich für die effiziente Suche in Datenmengen und die Sicherheit in der Kryptographie eignet. Durch ihre Eigenschaften wie Injektivität und Unumkehrbarkeit können Hashfunktionen zur Generierung von Schlüsseln oder einer einweg Verschlüsselung verwendet werden. Lernende gewinnen Einblick in die Anwendungsbereiche von Hashfunktionen, insbesondere im Bereich der Kryptographie, und verstehen die Notwendigkeit bestimmter Eigenschaften für die Sicherheit dieser Funktionen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1v3cq87o5dD4" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Computerwissenschaften>,
        <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datensicherheit>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Hashfunktionen>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Suchalgorithmen>,
        <http://example.org/education/concept/Verschl%C3%BCsselung> ;
    dcterms:title "Grundlagen Wissenschaftlichen Arbeitens"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:3OS1sf6WONPA a edu:LearningResource ;
    sim:similarTo oer:51rk5ZDqVnkc,
        oer:5l6iB0AgYLNM,
        oer:8V12n0GK9sQw,
        oer:9uoS64AUfbAY ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die Vorlesung behandelt die historische Semantik des Christentums im Mittelalter, indem sie die Entwicklung der deutschen Scholastik, Mystik und Predigt nachzeichnet. Durch die Analyse von Texten und Begriffen wie Meister Eckharts Grundideen, Übertragungen lateinischer Lehnsuffixe und der Sprache der Mystik werden die theologischen und philosophischen Konzepte des Mittelalters verständlich gemacht. Die Lernenden gewinnen Einblick in die religiöse und kulturelle Entwicklung Europas im Mittelalter und verstehen die Bedeutung von Begriffen und Texten für die Geschichte der christlichen Theologie."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3OS1sf6WONPA" ;
    dcterms:subject <http://example.org/education/concept/Christentum>,
        <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Historische_Semantik>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Mystik>,
        <http://example.org/education/concept/Philosophie_des_Mittelalters>,
        <http://example.org/education/concept/Predigt>,
        <http://example.org/education/concept/Religionsgeschichte>,
        <http://example.org/education/concept/Scholastik>,
        <http://example.org/education/concept/Theologie> ;
    dcterms:title "Historische Semantik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

