oer:39Co5pq6G2p4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Aurich> ;
    dcterms:description "Die Verwendung von Vektorgrafiken erleichtert die Bearbeitung von Atommodellen in der Chemie und ermöglicht die Untersuchung auch schwerer Elemente. Durch die Analyse von Atommodellen können Schüler Erkenntnisse über den Bau von Atomen gewinnen und verstehen, wie sich diese Modelle im Laufe der Zeit weiterentwickelt haben. Die Aufgabe fördert das Verständnis der chemischen Struktur von Atomen und ihre Entwicklung in der Wissenschaftsgeschichte."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "39Co5pq6G2p4" ;
    dcterms:subject <http://example.org/education/concept/Atombau>,
        <http://example.org/education/concept/Atommodelle>,
        <http://example.org/education/concept/Chemiegeschichte>,
        <http://example.org/education/concept/Chemieunterricht>,
        <http://example.org/education/concept/Elemente_der_Chemie>,
        <http://example.org/education/concept/Grafiksoftware>,
        <http://example.org/education/concept/Naturwissenschaftlicher_Unterricht>,
        <http://example.org/education/concept/Sch%C3%BCleraufgaben>,
        <http://example.org/education/concept/Vektorgrafiken>,
        <http://example.org/education/concept/Wissenschaftliche_Visualisierung> ;
    dcterms:title "Artefakt 5"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:39MLRiLZqqOc a edu:LearningResource ;
    dcterms:description "Die Darstellung des allgemeinbildenden Schulwesens in Deutschland umfasst die Struktur und Organisation der verschiedenen Schularten, einschließlich Grundschule, Realschule, Gesamtschule, Gymnasium und anderen, sowie ihre jeweiligen Bildungsgänge. Durch das Studium dieser Materialien können Lernende ein Verständnis dafür entwickeln, wie die verschiedenen Schularten in Deutschland organisiert sind und welche Möglichkeiten sie für Schülerinnen und Schüler bieten. Zudem werden die curricularen Vorgaben und Lehrpläne für den Informatikunterricht in verschiedenen Bundesländern vorgestellt, um Lernenden einen Einblick in die konkreten Anforderungen und Inhalte des Faches zu geben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "39MLRiLZqqOc" ;
    dcterms:subject <http://example.org/education/concept/Bildungspolitik>,
        <http://example.org/education/concept/Bildungsreform>,
        <http://example.org/education/concept/Bundesl%C3%A4nder>,
        <http://example.org/education/concept/Curriculumdesign>,
        <http://example.org/education/concept/Deutschland>,
        <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Lehrplanentwicklung>,
        <http://example.org/education/concept/Schularten>,
        <http://example.org/education/concept/Schulsystem> ;
    dcterms:title "Informatikunterricht in den Bundesländern Deutschlands"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:39wIEP80wRIM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Seifert> ;
    dcterms:description "Dieses Dokument behandelt die Grundlagen von Funktionen und Prozeduren in der Programmiersprache C, indem es ihre Definition, Implementierung und Verwendung erläutert. Es werden die Vorteile von Funktionen wie Wiederverwendbarkeit, Modularität und Fehlervermeidung dargestellt sowie die verschiedenen Arten der Parameterübergabe wie per Value und per Referenz erklärt. Durch das Studium dieses Dokuments können Lerner ein grundlegendes Verständnis davon erlangen, wie sie effiziente und fehlerfreie Programme in C erstellen können."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "39wIEP80wRIM" ;
    dcterms:subject <http://example.org/education/concept/Arrays>,
        <http://example.org/education/concept/C-Programmiersprache>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Parameter%C3%BCbergabe>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Prozeduren>,
        <http://example.org/education/concept/Referenz%C3%BCbertragung>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Speicherverwaltung>,
        <http://example.org/education/concept/Wert%C3%BCbertragung> ;
    dcterms:title "Funktionen und Prozeduren in C"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:3AE487NWUQfQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Wartke> ;
    dcterms:description "Der Text behandelt den Begriff \"Wochenendende\" und seine Verwendung in verschiedenen Kontexten, wobei die Autorin eine humorvolle und ironische Darstellung der Wortbedeutung bietet. Durch die Lektüre dieses Textes können Leser ihre Kenntnisse über die deutsche Sprache und ihre Nuancen erweitern. Zudem wird die IPA-konforme Transkription von Wörtern thematisiert, was für die Phonetik und Phonologie relevant ist."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3AE487NWUQfQ" ;
    dcterms:publisher <http://example.org/education/organization/UE> ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Hochsprache>,
        <http://example.org/education/concept/Humor>,
        <http://example.org/education/concept/IPA-Alphabet>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Phonetik>,
        <http://example.org/education/concept/Phonologie>,
        <http://example.org/education/concept/Transkription>,
        <http://example.org/education/concept/Wortspiel>,
        <http://example.org/education/concept/Zeitbegriff> ;
    dcterms:title "UE Grundlagen der Linguistik und Sprachgeschichte des Deutschen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3AhPTne0yZQ0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/kheredmand> ;
    dcterms:description "Die Studie \"JIM 2022\" untersucht das Medienverhalten von Jugendlichen im Alter zwischen 12 und 19 Jahren und liefert Einblicke in ihre Nutzung von Online-Angeboten, sozialen Netzwerken, Musik- und Videoplattformen. Die Ergebnisse zeigen, dass die meisten Jugendlichen regelmäßig soziale Medien nutzen, WhatsApp als wichtigste Kommunikationsplattform betrachten und YouTube als bevorzugte Plattform für Musik- und Videokonsum verwenden. Durch diese Studie können Lernende Einblicke in das Medienverhalten von Jugendlichen gewinnen und besser verstehen, wie sie digitale Angebote nutzen und welche Bedeutung diese in ihrem Leben haben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3AhPTne0yZQ0" ;
    dcterms:subject <http://example.org/education/concept/Bildungsgruppen>,
        <http://example.org/education/concept/Computerspiele>,
        <http://example.org/education/concept/Fernsehen>,
        <http://example.org/education/concept/Internet-Sicherheit>,
        <http://example.org/education/concept/Jugend>,
        <http://example.org/education/concept/Medienverhalten>,
        <http://example.org/education/concept/Musikstreaming>,
        <http://example.org/education/concept/Online-Kommunikation>,
        <http://example.org/education/concept/Smartphone-Nutzung>,
        <http://example.org/education/concept/Soziale_Netzwerke> ;
    dcterms:title "JIM 2022: Jugend, Information, (Multi-)Media"@de ;
    dcterms:type <http://example.org/education/type/After_analyzing_the_document_3AhPTne0yZQ0.pdf__I_determined_that_it_is_a_%22Skript%22.> .

oer:3Bnuj3AD5PFg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Limberg> ;
    dcterms:description "Diese Vertiefung bietet konkrete Anregungen zur Formulierung von Feedback und enthält ein Video mit Formulierungshilfen. Durch die Bearbeitung dieser Aufgaben können Lernende ihre Fähigkeit verbessern, strukturiertes Feedback zu geben und erhalten. Am Ende der Vertiefung sollen Lernende in der Lage sein, ein eigenes Feedback zu formulieren und es anderen Kursteilnehmenden bereitzustellen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "3Bnuj3AD5PFg" ;
    dcterms:subject <http://example.org/education/concept/Bildungsmanagement>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Feedback>,
        <http://example.org/education/concept/Kommunikation>,
        <http://example.org/education/concept/Lehren>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/P%C3%A4dagogische_Psychologie>,
        <http://example.org/education/concept/Selbstreflexion>,
        <http://example.org/education/concept/Unterrichtsentwicklung> ;
    dcterms:title "Vertiefung 3: Formulierungshilfen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3EB7ybjX1p6g a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Mahr>,
        <http://example.org/education/person/Richter>,
        <http://example.org/education/person/Ziegler> ;
    dcterms:description "Die Präsentation behandelt die Panikstörung und ihre Beziehung zum MAOA-Gen, insbesondere die Hypomethylierung des Gens als epigenetisches Risikomuster, das durch Psychotherapie reversibel ist. Durch die Lektüre dieser Präsentation können Lernende Kenntnisse über die Charakteristika der Panikstörung, ihre Therapieoptionen und den Einfluss von Genetik auf die Störung erwerben. Darüber hinaus werden ethische Implikationen bei der Anwendung genetischer Biomarker für die Erfolgswahrscheinlichkeit bestimmter Therapien diskutiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3EB7ybjX1p6g" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Angstst%C3%B6rung>,
        <http://example.org/education/concept/Epigenetik>,
        <http://example.org/education/concept/Genetik>,
        <http://example.org/education/concept/Genexpression>,
        <http://example.org/education/concept/Kognitive_Verhaltenstherapie>,
        <http://example.org/education/concept/MAOA-Gen>,
        <http://example.org/education/concept/Methylierung>,
        <http://example.org/education/concept/Panikst%C3%B6rung>,
        <http://example.org/education/concept/Psychopharmakologie>,
        <http://example.org/education/concept/Psychotherapie> ;
    dcterms:title "Titel der Präsentation Struktureinheit der TU Dresden"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

