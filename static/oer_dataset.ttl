    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von Bahnfahrzeugen und konzentriert sich auf den Anfahrwiderstand und die Elastizität des Wagenzuges. Durch die Analyse von Diagrammen und Zahlen werden die Einflüsse von Wagenzugkonfigurationen und Streckenlängsneigungen auf den Anfahrwiderstand verdeutlicht. Die Studierenden erwerben Kenntnisse über die verschiedenen Arten von Fahrwiderständen und ihre Auswirkungen auf die Fahrdynamik von Bahnfahrzeugen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "13X6iyiuAdL5w" ;
    dcterms:subject <http://example.org/education/concept/Anfahrwiderstand>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Fahrwiderstand>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Gleislage>,
        <http://example.org/education/concept/Losbrechwiderstand>,
        <http://example.org/education/concept/Oberbau>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/W%C3%A4lzlager>,
        <http://example.org/education/concept/Zugfahrten> ;
    dcterms:title "Fahrdynamik Bahnfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

