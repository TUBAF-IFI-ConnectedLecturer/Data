        <http://example.org/education/concept/Stochastik>,
        <http://example.org/education/concept/Varianz>,
        <http://example.org/education/concept/Wahrscheinlichkeitsdichte>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie>,
        <http://example.org/education/concept/Zufallsvariable>,
        <http://example.org/education/concept/diskrete_Verteilungen> ;
    dcterms:title "Mathematik IV (für IF, ET, Ph) Sommersemester 2025"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

