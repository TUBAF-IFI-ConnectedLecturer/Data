        <http://example.org/education/concept/Infektionskrankheiten>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Medizinische_Ausbildung>,
        <http://example.org/education/concept/Medizinische_Robotik>,
        <http://example.org/education/concept/Minimal_invasive_Chirurgie>,
        <http://example.org/education/concept/Patientensicherheit>,
        <http://example.org/education/concept/Virtuelle_Realit%C3%A4t> ;
    dcterms:title "Arzt-Computer-Teams"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

