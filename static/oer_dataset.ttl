    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt behandelt verschiedene Aufgaben zur Matrizenrechnung und Linearen Algebra, um die Fähigkeiten der Studierenden in diesem Bereich zu verbessern. Durch das Bearbeiten dieser Aufgaben können die Lerner ihre Kenntnisse über Matrizenoperationen, -produkte und -gleichungen erweitern und ihre Fähigkeit zur Lösung komplexer Probleme stärken. Die Übungsaufgaben decken ein breites Spektrum an Themen ab, von einfachen Matrizenprodukten bis hin zu komplexeren Gleichungen und geometrischen Transformationen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8ZXC3ues4hiI" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
