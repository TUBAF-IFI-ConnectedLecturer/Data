oer:9PFZamimSl-4 a edu:LearningResource ;
    sim:similarTo oer:9dqmS-Q2Bhzc,
        oer:9emfJNG2j0_Q ;
    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Das Übungsblatt behandelt die räumliche Kinematik und bietet Lösungshinweise für fünf Aufgaben, die sich mit Darboux-Bewegungen, Zwangläufen und sphärischen Trochoiden beschäftigen. Durch das Bearbeiten dieser Aufgaben können Lernende ihre Fähigkeiten in der Analyse und Lösung von Problemen der räumlichen Kinematik verbessern. Die Aufgaben umfassen die Berechnung von Trajektorien, Geschwindigkeiten und Drehungen sowie die Ermittlung von Bedingungen für geschlossene Kurven."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9PFZamimSl-4" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Darboux-Bewegung>,
        <http://example.org/education/concept/Drehungen>,
        <http://example.org/education/concept/Gangkreiskegel>,
        <http://example.org/education/concept/Kinematik>,
        <http://example.org/education/concept/Koordinatensysteme>,
        <http://example.org/education/concept/R%C3%A4umliche_Kinematik>,
        <http://example.org/education/concept/Rastkoordinatensystem>,
        <http://example.org/education/concept/Sph%C3%A4rische_Geometrie>,
        <http://example.org/education/concept/Trochoide>,
        <http://example.org/education/concept/Zwanglauf> ;
    dcterms:title "Räumliche Kinematik - Sommer 2025 Übungsblatt 5"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

