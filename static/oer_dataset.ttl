oer:12xbXdylgyAq8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Brunkow> ;
    dcterms:description "Das Tutorium behandelt die Themen Diversität und Intergruppenbeziehungen und vermittelt Wissen über Stereotype, ihre Funktionen und Konsequenzen. Durch die Lektüre dieses Materials können Lernende ein besseres Verständnis davon gewinnen, wie Stereotype unsere Wahrnehmung von sozialen Gruppen beeinflussen und welche Auswirkungen sie auf unser Verhalten haben. Zudem werden die Bias-Map und das Stereotype-Content-Modell vorgestellt, um die Komplexität von Intergruppenbeziehungen zu verdeutlichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12xbXdylgyAq8" ;
    dcterms:subject <http://example.org/education/concept/Bias>,
        <http://example.org/education/concept/Diskriminierung>,
        <http://example.org/education/concept/Diversit%C3%A4t>,
        <http://example.org/education/concept/Gruppenverhalten>,
        <http://example.org/education/concept/Intergruppenbeziehungen>,
        <http://example.org/education/concept/Kognitive_Psychologie>,
        <http://example.org/education/concept/Soziale_Gruppe>,
        <http://example.org/education/concept/Sozialpsychologie>,
        <http://example.org/education/concept/Stereotype>,
        <http://example.org/education/concept/Vorurteile> ;
    dcterms:title "Tutorium Diversität und Intergruppenbeziehungen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:139eWuqTXgyCs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Lernpaket behandelt den Begriff Regelleistung und ihre Bedeutung im Stromnetz, einschließlich negativer und positiver Regelleistung sowie des Verhaltens bei Ausfall einer Fernübertragungsleitung. Es werden zudem die vier verantwortlichen Netzbetreiber in Deutschland genannt und die Bereitstellung von Primärregelleistung, Sekundärregelleistung und Minutenreserve erläutert. Durch das Lernpaket können Studierende ein Verständnis der Begriffe Grundlast, Mittellast und Spitzenlast sowie fluktuierender Einspeiser entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "139eWuqTXgyCs" ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cbertragungsleitungen>,
        <http://example.org/education/concept/Elektrische_Energie>,
        <http://example.org/education/concept/Energieversorgung>,
        <http://example.org/education/concept/Energiewirtschaft>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Lastmanagement>,
        <http://example.org/education/concept/Leistungsbilanzen>,
        <http://example.org/education/concept/Netzbetrieb>,
        <http://example.org/education/concept/Regelleistung>,
        <http://example.org/education/concept/Stromnetz> ;
    dcterms:title "Lernpaket NuB"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

