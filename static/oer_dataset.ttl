    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von spurgeführten Fahrzeugen und konzentriert sich auf die Optimierung der Energieeffizienz durch verschiedene Fahrstrategien und -techniken. Durch die Analyse von Fahrprofilen, Traktionsleistungen und Energiebedarfen können Fahrer und Betreiber Einsparpotentiale erkennen und umsetzen, um den Energieverbrauch zu reduzieren. Die Vorlesung bietet eine umfassende Darstellung der Grundlagen und Methoden zur Energieoptimierung im Eisenbahnverkehr."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "14trekTp__Q9w" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Technik_spurgef%C3%BChrter_Fahrzeuge> ;
    dcterms:subject <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Eisenbahn>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Energieeffizienz>,
        <http://example.org/education/concept/Energiesparen>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Lokomotivf%C3%BChrung>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Zugfahrtsimulation> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

