    dcterms:title "Inventar der Sol y Luna-Lounge in Dresden"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:129eUjRKgiRHY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Husar> ;
    dcterms:description "Die Veränderungen in unserer Gesellschaft werden anhand von Themen wie Klimawandel, Demografischer Wandel und Globalisierung dargestellt. Durch die Auseinandersetzung mit diesen Aspekten können Lernende ein besseres Verständnis der aktuellen Herausforderungen und Probleme entwickeln. Zudem werden die Auswirkungen auf die Gesellschaft, wie zum Beispiel Arbeitsplatzverlust, Datenschutzprobleme und Polarisierung, thematisiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "129eUjRKgiRHY" ;
    dcterms:subject <http://example.org/education/concept/Arbeitsmarkt>,
        <http://example.org/education/concept/Cyberkriminalit%C3%A4t>,
