    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9PAav_dcpkYM a edu:LearningResource ;
    sim:similarTo oer:9ugrJPzIVLKw ;
    dcterms:creator <http://example.org/education/person/Hagedorn> ;
    dcterms:description "Diese Präsentation behandelt die Grundlagen der deutschen Grammatik, insbesondere die Wortarten Verb, Substantiv und Adjektiv, ihre Funktionen und Merkmale. Durch das Studium dieser Inhalte können Lerner ein grundlegendes Verständnis der deutschen Sprache erwerben und ihre Fähigkeiten im Bereich der Grammatik verbessern. Die Präsentation bietet viele Beispiele und Erklärungen, um die komplexen Regeln und Strukturen der deutschen Sprache zu verdeutlichen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
