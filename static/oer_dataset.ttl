oer:8DIYsTEB-vPQ a edu:LearningResource ;
    sim:similarTo oer:8Vy--T0Sbb2I,
        oer:8gBRggtzBxs8,
        oer:8melWvLsp4b0 ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Kolloidchemische Grundlagen der Nanotechnologie behandeln die Eigenschaften und Verhaltensweisen von Nanopartikeln, einschließlich ihrer hohen spezifischen Oberfläche, Adsorptionskapazität und veränderten Materialeigenschaften. Durch das Studium dieser Materialien können Lernende ein tieferes Verständnis der physikalisch-chemischen Prozesse auf Nanoskala erlangen und die Anwendungsmöglichkeiten von Nanomaterialien in verschiedenen Bereichen erkennen. Die Inhalte umfassen unter anderem die Größenabhängigkeit von Materialeigenschaften, osmotischen Druck, Diffusion und Sedimentation, sowie spezielle optische Effekte und Anwendungsprodukte mit Nanomaterialien."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8DIYsTEB-vPQ" ;
    dcterms:subject <http://example.org/education/concept/Brechungsindex>,
        <http://example.org/education/concept/Diffusion>,
        <http://example.org/education/concept/Kolloidchemie>,
        <http://example.org/education/concept/Materialeigenschaften>,
        <http://example.org/education/concept/Nanopartikel>,
        <http://example.org/education/concept/Oberfl%C3%A4cheneigenschaften>,
        <http://example.org/education/concept/Osmotischer_Druck>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Quanteneffekte>,
        <http://example.org/education/concept/Sedimentation> ;
    dcterms:title "Fakultät für Maschinenbau und Schiffstechnik - Institut für Verfahrenstechnik und Dampfkesselwesen - Lehrstuhl für Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8Dw3vf_KNYVo a edu:LearningResource ;
    sim:similarTo oer:8XadPDRAcaBc,
        oer:98-STVtsTqqI,
        oer:9P66tpN4ETvM ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Eigenschaften von Stoffsystemen und Produkten werden im Kontext der Produktentwicklung erläutert, wobei die Charakterisierung von Stoffen und Materialien sowie ihre Anwendungen und Funktionen im Vordergrund stehen. Die Lernenden erfahren, wie die Eigenschaften von Stoffen und Produkten klassifiziert und analysiert werden können, um ihre Qualität und Zuverlässigkeit zu gewährleisten. Durch das Verständnis dieser Konzepte können die Lernenden die Entwicklung von Produkten mit spezifischen Eigenschaften und Funktionen unterstützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8Dw3vf_KNYVo" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen> ;
    dcterms:subject <http://example.org/education/concept/Chemische_Eigenschaften>,
        <http://example.org/education/concept/Grenzfl%C3%A4cheneigenschaften>,
        <http://example.org/education/concept/Materialwissenschaft>,
        <http://example.org/education/concept/Oberfl%C3%A4cheneigenschaften>,
        <http://example.org/education/concept/Physikalische_Eigenschaften>,
        <http://example.org/education/concept/Produktentwicklung>,
        <http://example.org/education/concept/Stoffeigenschaften>,
        <http://example.org/education/concept/Toxikologie>,
        <http://example.org/education/concept/Umweltvertr%C3%A4glichkeit>,
        <http://example.org/education/concept/Verfahrenstechnik> ;
    dcterms:title "Eigenschaften von Stoffsystemen und Produktentwicklung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8MwjsObRjyik a edu:LearningResource ;
    sim:similarTo oer:9BA7fl9aPOqQ ;
    dcterms:creator <http://example.org/education/person/Blanck> ;
    dcterms:description "Die Präsentation behandelt die Grundlagen der Statistik und ihre Anwendung in verschiedenen Bereichen, wie Sozialwissenschaften, Physik und Mathematik, um Learner darin zu unterstützen, Daten zu verstehen, zu analysieren und Schlussfolgerungen zu ziehen. Durch die Bearbeitung von Aufgaben und Beispielen können Learner ihr Verständnis von Skalen, Variablen, Korrelationen und Kausalitäten verbessern und lernen, wie sie Statistik in der Praxis anwenden können. Am Ende des Lernprozesses sollten Learner in der Lage sein, Daten zu interpretieren, statistische Methoden anzuwenden und fundierte Schlussfolgerungen zu ziehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8MwjsObRjyik" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Datentypen>,
        <http://example.org/education/concept/Deskriptive_Statistik>,
        <http://example.org/education/concept/Kausalit%C3%A4t>,
        <http://example.org/education/concept/Korrelation>,
        <http://example.org/education/concept/Nominalskala>,
        <http://example.org/education/concept/Ordinalskala>,
        <http://example.org/education/concept/Scheinkorrelation>,
        <http://example.org/education/concept/Skalenniveau>,
        <http://example.org/education/concept/Statistik> ;
    dcterms:title "Warum Statistik?"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8WD_-XNihgAQ a edu:LearningResource ;
