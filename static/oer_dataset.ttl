        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Interaktivit%C3%A4t>,
        <http://example.org/education/concept/Lernplattform>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Multimediainhalt>,
        <http://example.org/education/concept/Online-Kurs>,
        <http://example.org/education/concept/Selbstlernkurs> ;
    dcterms:title "Selbst-Evaluation eines Online-Kurses zum Thema Differentialrechnung"@de ;
    dcterms:type <http://example.org/education/type/Bachelor-_oder_Masterarbeit> .

