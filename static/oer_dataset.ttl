        <http://example.org/education/concept/Programmiersprachen>,
        <http://example.org/education/concept/Programmoptimierung>,
        <http://example.org/education/concept/Semantikanalyse>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Syntaxanalyse> ;
    dcterms:title "IFG1_HTWK_7_Programmentwicklung_Sprachen_BNF_20200617"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

