        <http://example.org/education/concept/Schutztechnik>,
        <http://example.org/education/concept/Wechselstrom> ;
    dcterms:title "Netzberechnung und Schutztechnik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

