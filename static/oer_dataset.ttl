    dcterms:title "Einführung in die Elektromobilität"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8OYjRhybf718 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Diese Klausuraufgaben behandeln die Sedimentation von Kaffeepartikeln in Wasser und umfassen drei Aufgaben, die das Volumen der Schüttung, die Partikeldichte und die Sinkzeit berechnen lassen. Durch die Lösung dieser Aufgaben können Lernende ihre Kenntnisse in der Verfahrenstechnik und Naturstofftechnik erweitern und ihr Verständnis von physikalischen Prozessen wie der Sedimentation verbessern. Die Aufgaben sind praxisnah und verwenden realistische Werte, um die Anwendung theoretischer Konzepte auf reale Szenarien zu veranschaulichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8OYjRhybf718" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Dichte>,
        <http://example.org/education/concept/Kaffeepulver>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Naturstofftechnik>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Sedimentation>,
        <http://example.org/education/concept/Suspension>,
        <http://example.org/education/concept/Verfahrenstechnik>,
        <http://example.org/education/concept/Volumen> ;
    dcterms:title "Klausuraufgaben Einführung in die Verfahrenstechnik und Naturstofftechnik 1 TU Dresden, AG Mechanische Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8Te34r526VVU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Das Lerntagebuch Fahrdynamik unterstützt Studierende bei der strukturierten Arbeit im Fach Fahrdynamik und ermöglicht es ihnen, Woche für Woche ihren Lernfortschritt zu protokollieren und ihren Lernprozess zu reflektieren. Durch die Verwendung dieses Werkzeugs können sie wichtige Erkenntnisse festhalten, offene Fragen notieren und diese dann mit anderen Studierenden oder im Rahmen von Konsultationen diskutieren und klären. Das Lerntagebuch umfasst 13 Wochen und bietet somit eine umfassende Unterstützung während des Sommersemesters 2020."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8Te34r526VVU" ;
    dcterms:publisher <http://example.org/education/organization/Friedrich_List_Institut_F%C3%BCr_Bahnfahrzeuge_Und_Bahntechnik> ;
