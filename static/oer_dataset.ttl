oer:10s1PjmTfRnoM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Jacobi>,
        <http://example.org/education/person/Kl%C3%A4ffling>,
        <http://example.org/education/person/Kretschmar> ;
    dcterms:description "Das Seminar \"Soziologie der(s) Körper(s)\" behandelt die Entmaterialisierung des Körpers bei Judith Butler und ihre Werke, insbesondere \"Gender trouble\", \"Bodies that Matter\" und \"Excitable Speech\". Durch die Analyse dieser Werke sollen die Teilnehmer ein Verständnis dafür entwickeln, wie der Körper als Text verstanden werden kann. Die Inputgestaltungen von Janine Kläffling, Maria Kretschmar und Clara Jacobi unterstützen die Auseinandersetzung mit Butlers Theorien."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10s1PjmTfRnoM" ;
    dcterms:subject <http://example.org/education/concept/Diskursanalyse>,
        <http://example.org/education/concept/Feminismus>,
        <http://example.org/education/concept/Gender_Studies>,
        <http://example.org/education/concept/Geschlecht>,
        <http://example.org/education/concept/Identit%C3%A4t>,
        <http://example.org/education/concept/K%C3%B6rper>,
        <http://example.org/education/concept/Kulturwissenschaften>,
        <http://example.org/education/concept/Performativit%C3%A4t>,
        <http://example.org/education/concept/Philosophie>,
        <http://example.org/education/concept/Soziologie> ;
    dcterms:title "Die Entmaterialisierung des Körpers bei Judith Butler: Der Körper als Text"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

