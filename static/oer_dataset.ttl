        oer:7j01GgGvMEiE,
        oer:8ZXC3ues4hiI,
        oer:9o2sSv7XEqXQ ;
    dcterms:description "Die Matrixeigenwertaufgabe wird definiert und ihre Lösung beschrieben, um Eigenwerte und -vektoren einer gegebenen Matrix A zu bestimmen. Durch die charakteristische Gleichung können die Eigenwerte λi berechnet werden, die dann in die Matrixeigenwertaufgabe eingesetzt werden, um nach den zugehörigen Eigenvektoren x zu suchen. Durch das Verständnis dieser Methode können Lerner die Eigenwerte und -vektoren einer Matrix bestimmen und ihre Anwendung in verschiedenen mathematischen und physikalischen Kontexten verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "14M2UFFLQmKE" ;
    dcterms:subject <http://example.org/education/concept/Algebraische_Gleichung>,
        <http://example.org/education/concept/Charakteristische_Gleichung>,
        <http://example.org/education/concept/Eigenvektor>,
        <http://example.org/education/concept/Eigenwert>,
        <http://example.org/education/concept/L%C3%B6sungsraum>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematische_Analyse>,
        <http://example.org/education/concept/Matrixgleichung>,
        <http://example.org/education/concept/Numerische_Mathematik>,
        <http://example.org/education/concept/Vektorraum> ;
    dcterms:title "Eigenwerte und -vektoren"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:15UxHWwV0G3GM a edu:LearningResource ;
    sim:similarTo oer:15sR8PfXHEAuI ;
    dcterms:creator <http://example.org/education/person/Vercamer> ;
    dcterms:description "Dieses Dokument behandelt die Geschichte eines Ritters, der einem Löwen half und später von diesem gerettet wurde, um eine Moralisation über die Vergebung und das Bemühen, ein besserer Mensch zu werden, zu vermitteln. Durch diese Geschichte sollen Leser lernen, dass sie ihre Sünden bereuen und ihr Leben ändern sollten, um Erlösung zu erlangen. Die Geschichte dient als Lehrmittel, um Menschen dazu anzuspornen, ihre Taten zu überdenken und ein moralischeres Leben zu führen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "15UxHWwV0G3GM" ;
    dcterms:subject <http://example.org/education/concept/Allegorie>,
        <http://example.org/education/concept/Erz%C3%A4hlung>,
        <http://example.org/education/concept/Kirchengeschichte>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Moralisation>,
        <http://example.org/education/concept/S%C3%BCnde_und_Erl%C3%B6sung>,
        <http://example.org/education/concept/Tugend_und_Laster>,
        <http://example.org/education/concept/christliche_Theologie>,
        <http://example.org/education/concept/mittelalterliche_Gesellschaft>,
        <http://example.org/education/concept/religi%C3%B6se_Symbolik> ;
    dcterms:title "Der Kampf gegen die Kirchenräuber"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:16OxHTdpNVvfc a edu:LearningResource ;
    sim:similarTo oer:16kgdFX_Wtypg,
        oer:16pOukccnOAgk,
        oer:16rLcbAFyNRC8,
        oer:17Agtk_pdd86A,
        oer:17LVFOlY7Yz8w,
        oer:17c-TeiZ-rXRI,
        oer:17zQyupNMpmbU ;
    dcterms:creator <http://example.org/education/person/Carter>,
        <http://example.org/education/person/Johnson>,
        <http://example.org/education/person/Lee> ;
    dcterms:description "Die Geschichte der Computerentwicklung wird von den ersten mechanischen Rechnern bis hin zu modernen Mikrocomputern und Spielkonsolen nachgezeichnet, wobei wichtige Erfindungen und Entwicklungen wie der Transistor, der integrierte Schaltkreis und die grafische Oberfläche vorgestellt werden. Durch das Studium dieser Entwicklungsgeschichte können Lerner ein Verständnis dafür gewinnen, wie Computer funktionieren und wie sie unsere Gesellschaft beeinflusst haben. Zudem wird die Bedeutung von Pionieren wie Bill Shockley, Nolan Bushnell und anderen für die Entwicklung der Computerindustrie hervorgehoben."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "16OxHTdpNVvfc" ;
    dcterms:subject <http://example.org/education/concept/Computerentwicklung>,
        <http://example.org/education/concept/Geschichte_der_Informatik>,
        <http://example.org/education/concept/Grafische_Benutzeroberfl%C3%A4che>,
        <http://example.org/education/concept/IBM-kompatibler_PC>,
        <http://example.org/education/concept/Integrierter_Schaltkreis>,
        <http://example.org/education/concept/Mikrocomputer>,
        <http://example.org/education/concept/Personal_Computer>,
        <http://example.org/education/concept/Silicon_Valley>,
        <http://example.org/education/concept/Spielkonsole>,
        <http://example.org/education/concept/Transistor> ;
    dcterms:title "Zeitgeist Computer"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

