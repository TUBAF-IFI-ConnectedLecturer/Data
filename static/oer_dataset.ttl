        oer:7w0S3QZs0k9U ;
    dcterms:creator <http://example.org/education/person/Hacker> ;
    dcterms:description "Durch die Lektüre dieses Dokuments können Lernende die Aufgaben und Kompetenzen von Archivaren und Fachangestellten für Medien- und Informationsdienste (FAMI) in Archiven kennenlernen und verstehen, wie sie sich auf die Arbeit in Archiven vorbereiten können. Es werden die verschiedenen Ausbildungswege und Studienmöglichkeiten zum Archivar vorgestellt, einschließlich der Archivschulen in Marburg und Potsdam. Zudem werden die Zweigleisigkeit von Archiven als Verwaltungsort und Gedächtnisinstitution sowie die Bedeutung von Geschichtswissen und Kommunikationsfähigkeiten für Archivare hervorgehoben."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "119g8cXlAlWb0" ;
    dcterms:publisher <http://example.org/education/organization/I_Analyzed_The_Provided_Document_And_Did_Not_Find_Any_Email_Addresses_With_University_Domains._Therefore__I_Will_Return_An_Empty_String.> ;
    dcterms:subject <http://example.org/education/concept/Archivierung>,
        <http://example.org/education/concept/Archivschulen>,
        <http://example.org/education/concept/Archivtypen>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Fachangestellte_f%C3%BCr_Medien-und_Informationsdienste>,
        <http://example.org/education/concept/Geschichtsstudium>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Informationswissenschaft>,
        <http://example.org/education/concept/Katalogisierung>,
        <http://example.org/education/concept/Medien-und_Informationsdienste> ;
    dcterms:title "Die Ausbildung zum Archivar"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

