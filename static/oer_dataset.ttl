        <http://example.org/education/concept/Germanistik-Studium>,
        <http://example.org/education/concept/Germanistische_Linguistik>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Linguistische_Einf%C3%BChrung>,
        <http://example.org/education/concept/Sprachtheorie>,
        <http://example.org/education/concept/Sprachwissenschaft>,
        <http://example.org/education/concept/Studienbuch> ;
    dcterms:title "Einführungen in die (Germanistische) Linguistik seit 2000 empfohlen"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

