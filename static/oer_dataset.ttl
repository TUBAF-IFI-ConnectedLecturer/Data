        <http://example.org/education/concept/Triebz%C3%BCge>,
        <http://example.org/education/concept/Zugkraft>,
        <http://example.org/education/concept/kinetische_Energie> ;
    dcterms:title "Fahrdynamik für Verkehrsingenieure (Teil 01)"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

