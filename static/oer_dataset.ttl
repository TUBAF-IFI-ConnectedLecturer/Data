    dcterms:creator <http://example.org/education/person/Reinelt> ;
    dcterms:description "Das Material behandelt den waagerechten Wurf im Physikunterricht und ermöglicht Schülern, physikalische Methoden zum Lösen einer Aufgabe anzuwenden und ihre Kenntnisse über physikalische Grundprinzipien zu vertiefen. Durch die Verwendung von GeoGebra können sie die Abhängigkeiten der Wurfweite von verschiedenen Größen untersuchen und Hypothesen kritisch reflektieren. Dadurch fördert das Material Fachkompetenz, Methodenkompetenz und Selbstkompetenz der Lernenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3al3lE4WIlwQ" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Digitale_Medien>,
        <http://example.org/education/concept/Fachkompetenz>,
        <http://example.org/education/concept/Geogebra>,
        <http://example.org/education/concept/Kompetenzorientierter_Unterricht>,
        <http://example.org/education/concept/Methodenkompetenz>,
        <http://example.org/education/concept/Physikalische_Grundprinzipen>,
        <http://example.org/education/concept/Physikunterricht>,
        <http://example.org/education/concept/Selbstlernkompetenz>,
        <http://example.org/education/concept/Waagerechter_Wurf> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Didaktische_Handreichung> .

