        oer:9wx8MYJu8q3I ;
    dcterms:creator <http://example.org/education/person/Meier> ;
    dcterms:description "Lernende gewinnen Einblicke in die Herkunft und Entwicklung von Alltags-Schülervorstellungen im Biologieunterricht und erkennen die Bedeutung einer didaktischen Aufbereitung dieser Vorstellungen für einen erfolgreichen Lernprozess. Durch die Auseinandersetzung mit allgemeinen Denkweisen, Schülervorstellungen und Interessenkonstrukten können Lehrkräfte ihre Unterrichtsplanung anpassen, um heterogene Lerngruppen zu unterstützen. Die Kenntnisse über potentielle Lernschwierigkeiten und die Vielfalt von Schulervorstellungen helfen Lehrkräften, standard- und kompetenzorientierte Vermittlungsprozesse in ihrem Unterricht umzusetzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11xIw0lBYI3sE" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_a_Hint_About_The_Author%27s_Institution%3Athe_Institution_Is_%22german%22_%28not_Explicitly_Stated__But_Based_On_The_Language_And_Content_Of_The_Document%29.the_Prominent_Institution_Mentioned_Is%3Auniversit%C3%A4t_Sachsen_%28implied_By_The_Mention_Of_%22lehrplan_Gymnasium_Biologie_2004-2022%22_And_%22lehrplan_Oberschule_Biologie_2004-2019%22%29please_Note_That_This_Might_Not_Be_The_Author%27s_Affiliation__But_Rather_a_Reference_To_Educational_Resources_Or_Plans_From_The_University_Of_Sachsen.> ;
    dcterms:subject <http://example.org/education/concept/Biologieunterricht>,
        <http://example.org/education/concept/Biologische_Konzepte>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Evolution>,
        <http://example.org/education/concept/Interessensgenese>,
        <http://example.org/education/concept/Kognitive_Entwicklung>,
        <http://example.org/education/concept/Lehr-Lern-Prozesse>,
        <http://example.org/education/concept/Lernvoraussetzungen>,
        <http://example.org/education/concept/Mikroorganismen>,
        <http://example.org/education/concept/Sch%C3%BClervorstellungen> ;
    dcterms:title "Einführung in die Biologiedidaktik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

