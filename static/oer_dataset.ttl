    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung \"Fahrdynamik Bahnfahrzeuge\" behandelt die Grundlagen der Fahrdynamik und ihre Anwendung auf Schienenfahrzeuge, um die Bewegung von Zügen und die damit verbundenen Kräfte zu verstehen. Durch das Studium dieser Materialien können Lernende die physikalischen Gesetze und Prinzipien der Fahrdynamik erlernen und anwenden, um die Leistung und Sicherheit von Schienenfahrzeugen zu optimieren. Die Vorlesung deckt Themen wie die Kräftebilanz, die Fahrschaubilder und die Massenfaktoren ab, die für die Entwicklung und den Betrieb von Schienenfahrzeugen von entscheidender Bedeutung sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "109gZyHyGmD60" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Bremsen>,
        <http://example.org/education/concept/Eisenbahnbetrieb>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Fahrleistung>,
        <http://example.org/education/concept/Fahrzeugdynamik>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik Bahnfahrzeuge - Sommersemester 2023 Professur für Elektrische Bahnen - Dipl.-Ing. Tobias Bregulla"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

