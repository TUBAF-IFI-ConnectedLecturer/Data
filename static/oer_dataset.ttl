    dcterms:creator <http://example.org/education/person/Gro%C3%9Fmann>,
        <http://example.org/education/person/Kirsten>,
        <http://example.org/education/person/Prediger> ;
    dcterms:description "Das Projekt \"Zucker: Energielieferant oder doch eine Droge?\" soll Schülerinnen und Schülern helfen, ihr Verständnis von Zucker und seiner Rolle in der Ernährung zu verbessern. Durch die Teilnahme an diesem Projekt werden sie sensibilisiert für ihre täglichen Ess- und Trinkgewohnheiten und lernen, gesunde Entscheidungen zu treffen. Am Ende des Projekts können sie ihr Wissen über Zucker und seine Auswirkungen auf den Körper anwenden und eine gesündere Lebensweise entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6qzNh8tndyq0" ;
    dcterms:subject <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Ern%C3%A4hrung>,
        <http://example.org/education/concept/Gesunde_Ern%C3%A4hrung>,
        <http://example.org/education/concept/Gesundheit>,
        <http://example.org/education/concept/Lebensmittel>,
        <http://example.org/education/concept/Nahrungsmittel>,
        <http://example.org/education/concept/Projektarbeit>,
        <http://example.org/education/concept/Schule>,
        <http://example.org/education/concept/Unterricht>,
        <http://example.org/education/concept/Zucker> ;
    dcterms:title "Das Projekt \"Zucker\" - Ein Beitrag zur Gesundheitsförderung"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:8QE9TXJR9ImM a edu:LearningResource ;
    sim:similarTo oer:8hNtsogSOgH0,
        oer:8mqDmRgDPbLI,
