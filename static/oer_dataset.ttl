oer:9bWwFRPrmM2U a edu:LearningResource ;
    sim:similarTo oer:9cBOgCvcOm4I,
        oer:9eWUauM83Xg8,
        oer:9fKACmSQzSc4,
        oer:9jfKL3NiIpew,
