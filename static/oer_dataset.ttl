oer:70yaVCrmyLWM a edu:LearningResource ;
    sim:similarTo oer:8k0dXX9I-hWY,
        oer:8qdecEw1tp7M ;
    dcterms:creator <http://example.org/education/person/Alchaar> ;
    dcterms:description "Open Educational Resources (OER) sind frei zugängliche und offen lizenzierte Bildungsmaterialien, die jedem Zugang zu hochwertigen Inhalten ermöglichen, unabhängig von geografischen, finanziellen oder sozialen Einschränkungen. Durch die Verwendung von OER können Lehrkräfte Inhalte anpassen und kombinieren, um den spezifischen Bedürfnissen ihrer Lernenden gerecht zu werden, was zu einer Demokratisierung des Wissens beiträgt. Die Implementierung von OER erfordert Sensibilisierung und Schulung von Lehrkräften sowie die Verwendung von Symbolen, die den Grad der Offenheit und Nutzungsbedingungen anzeigen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "70yaVCrmyLWM" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bildungsinformatik>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Fernstudium>,
        <http://example.org/education/concept/Lehrmaterial>,
        <http://example.org/education/concept/Lernplattformen>,
        <http://example.org/education/concept/OER>,
        <http://example.org/education/concept/Open_Educational_Resources>,
        <http://example.org/education/concept/digitale_Medien>,
        <http://example.org/education/concept/offene_Bildungsressourcen> ;
    dcterms:title "Open Educational Resources (OER): Was sie bedeuten, warum sie wichtig sind und wie sie umgesetzt werden können"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:78eGGXKQx6mY a edu:LearningResource ;
    sim:similarTo oer:79GxsJxr7AdE,
        oer:7YCB8Xz8FKfc,
