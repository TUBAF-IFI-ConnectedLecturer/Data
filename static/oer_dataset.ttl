    dcterms:title "Klassen in Python"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:12ks6aE8ofk1I a edu:LearningResource ;
    sim:similarTo oer:12l3wkZ5nHCYA,
