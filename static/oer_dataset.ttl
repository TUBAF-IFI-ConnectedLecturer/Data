        <http://example.org/education/concept/Testentwicklung>,
        <http://example.org/education/concept/Usability>,
        <http://example.org/education/concept/Variablenverwaltung> ;
    dcterms:title "Schwerpunkte des Projekts MoVUsO"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

