oer:7Mc0Y3hvRUFs a edu:LearningResource ;
    sim:similarTo oer:8qTdyyZU5U94,
        oer:9ZcJ1MbNt77g ;
    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Henschel> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs behandelt logische Aussagen und ihre Verknüpfungen, indem es die Lösung von Aufgaben zur Implikation, Äquivalenz und Negation von Aussagen unterstützt. Durch das Bearbeiten dieser Aufgaben können Lernende ihr Verständnis logischer Gesetze und ihrer Anwendung in der Mathematik verbessern. Die Übung umfasst insgesamt 10 Aufgaben, die von einfachen Implikationen bis hin zu komplexeren logischen Verknüpfungen reichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7Mc0Y3hvRUFs" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_F%C3%BCr_Technik_Und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%84quivalenz>,
        <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Aussagenlogik>,
        <http://example.org/education/concept/Beweis>,
        <http://example.org/education/concept/Implikation>,
        <http://example.org/education/concept/Logik>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Tautologie>,
        <http://example.org/education/concept/Wahrheitstabellen>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Mathematik 1 - WS202223 Übungsblatt 1"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7ohmtOd8ipAE a edu:LearningResource ;
    dcterms:description "Die Rolle der Hanse und Lübecks in der mittelniederdeutschen Sprachgeschichte wird untersucht, wobei die politischen und ökonomischen Voraussetzungen für die Entstehung des mittelniederdeutschen Sprachraums im Ostseeraum dargestellt werden. Durch die Analyse der Bevölkerungsgeschichte und der Kommunikationsbedürfnisse in der Kaufmannshanse wird die These unterstützt, dass eine mündliche niederdeutsche Verkehrssprache existiert hat. Die Lektüre dieses Textes ermöglicht es den Lernenden, die Entwicklung des mittelniederdeutschen Sprachraums und seine Bedeutung für die Geschichte der Hanse zu verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7ohmtOd8ipAE" ;
    dcterms:publisher <http://example.org/education/organization/Universitaetsbibliothek_Rostock> ;
    dcterms:subject <http://example.org/education/concept/Fernhandel>,
        <http://example.org/education/concept/Hanse>,
        <http://example.org/education/concept/Kaufmannshanse>,
        <http://example.org/education/concept/L%C3%BCbeck>,
        <http://example.org/education/concept/Mittelniederdeutsch>,
        <http://example.org/education/concept/Normierungstendenzen>,
        <http://example.org/education/concept/Ostkolonisation>,
        <http://example.org/education/concept/Schriftlichkeit>,
        <http://example.org/education/concept/Sprachgeschichte>,
        <http://example.org/education/concept/St%C3%A4dtebund> ;
    dcterms:title "Die Rolle der Hanse und Lübecks in der mittelniederdeutschen Sprachgeschichte"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7zPH7AxkHE-A a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Stagg>,
        <http://example.org/education/person/Staggs> ;
    dcterms:description "Dieses Dokument behandelt die Grundlagen der Verschlüsselung und Datensicherheit, einschließlich symmetrischer und asymmetrischer Verschlüsselungsverfahren, sowie die Anwendung von HTTPS und TLS für sichere Datenübertragung. Durch das Studium dieses Materials können Lerner die Funktionsweise von Verschlüsselungsverfahren verstehen, die Stärken und Schwächen von verschiedenen Verfahren beurteilen und die Anforderungen an die Informationssicherheit analysieren. Zudem werden sie in der Lage sein, Maßnahmen zur Stärkung der Datensicherheit zu entwickeln und die Aktualität von Verschlüsselungsverfahren im Kontext moderner Datensicherheit zu beurteilen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7zPH7AxkHE-A" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Authentizit%C3%A4t>,
        <http://example.org/education/concept/Backup>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Datensicherung>,
        <http://example.org/education/concept/HTTPS>,
        <http://example.org/education/concept/Informationssicherheit>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Netzwerksicherheit>,
        <http://example.org/education/concept/TLS>,
        <http://example.org/education/concept/Verschl%C3%BCsselung> ;
    dcterms:title "Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8WLAY458DjS4 a edu:LearningResource ;
    sim:similarTo oer:8q-IeNLEXQ3w,
        oer:9cOjlSsSnjVw ;
    dcterms:creator <http://example.org/education/person/Meier>,
        <http://example.org/education/person/Schluer> ;
    dcterms:description "Das Didaktische Lehrkonzept behandelt die Implementierung digitaler Feedbackmethoden in der Lehramtsausbildung, um fachdidaktische Kompetenzen zu erweitern und eine Feedback-Kultur in Lernkontexten zu fördern. Durch die Einbettung von Feedback-Methoden als Lehr-Werkzeug sollen Studierende ihre Fähigkeiten im Bereich der Selbstreflexion und Kommunikation verbessern. Das Konzept zielt auf die Erweiterung der Lehrkonzepte in den Geistes- und Naturwissenschaften ab, um eine bessere Unterstützung von Lehr- und Lernprozessen zu gewährleisten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8WLAY458DjS4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Didaktik_der_Biologie>,
        <http://example.org/education/concept/Digitale_Medien>,
        <http://example.org/education/concept/Fachdidaktische_Kompetenz>,
        <http://example.org/education/concept/Feedbackmethoden>,
        <http://example.org/education/concept/Hochschuldidaktik>,
        <http://example.org/education/concept/Lehramtsausbildung>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Lehrkonzept>,
        <http://example.org/education/concept/Transferlernen>,
        <http://example.org/education/concept/Wissenschaftliche_Weiterbildung> ;
    dcterms:title "Didaktisches Lehrkonzept"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:8woef_30a4Rw a edu:LearningResource ;
    sim:similarTo oer:96KYDYTG2uu0,
        oer:9qgbTa6gx0ys ;
    dcterms:creator <http://example.org/education/person/Schulze> ;
    dcterms:description "Die vorliegende Prüfungsarbeit behandelt die bibliographische Katalogisierung und Indexierung einer akademischen Datenbank, indem sie die Konzepte von Datenbanken, Datenbanksystemen und Datenbankverwaltungssystemen erläutert und anhand eines Beispiels eine Abfrage durchführt. Durch das Durcharbeiten dieser Aufgaben können Lerner ein Verständnis dafür entwickeln, wie Datenbanken strukturiert sind und wie sie effizient genutzt werden können. Zudem wird die Bedeutung des Datenschutzes in unserer Gesellschaft anhand der Beispiel-Datenbank verdeutlicht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8woef_30a4Rw" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_An_Email_Address_With_a_University_Domain%3Arichard.schulze%40uni-leipzig.dethe_Derived_University_Name_Is%3Auniversit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Datenbanken>,
