oer:9y5ofzl8Ux3s a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Roth> ;
    dcterms:description "Die Interaktive App unterstützt Lernende bei der Vorbereitung auf Bewerbungen und Job-Interviews in englischer Sprache, indem sie Übersetzungsaufgaben, Fill-the-Gap-Aufgaben und Fragen zu Inhalten der Unterrichtsstunden bietet. Durch die Lösung dieser Aufgaben können Lernende neue Vokabeln erwerben und einen Überblick über ihre eigenen Fähigkeiten erhalten. Das Thema \"Working and travelling abroad\" wird durch die Charaktere Jack und Rosie illustriert, die ein Gap Year in Australien machen möchten, um ihre sprachlichen Fähigkeiten zu verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9y5ofzl8Ux3s" ;
    dcterms:subject <http://example.org/education/concept/Digitale_Bildung>,
        <http://example.org/education/concept/Englische_Bewerbungen>,
        <http://example.org/education/concept/Englischunterricht>,
        <http://example.org/education/concept/Fremdsprachenlernen>,
        <http://example.org/education/concept/Gap_Year>,
        <http://example.org/education/concept/Interaktive_Medien>,
        <http://example.org/education/concept/Lebenslauf_erstellen>,
        <http://example.org/education/concept/Lernspiele>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Vokabeltraining> ;
    dcterms:title "Digitale Medien in der Schule Interaktive App Begründung"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:9yK5zsEl6Z2k a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hagedorn> ;
    dcterms:description "Das Kreuzworträtsel \"Tiere und Pflanzen im Wald\" unterstützt den Lernprozess zum Thema Begegnungen mit Pflanzen und Tieren in der 4. Klasse im Bereich Sachunterricht. Durch das Lösungsworträtsel können Schüler:innen ihren Wissenstand spielerisch überprüfen und festigen. Das interaktive Kreuzworträtsel bietet eine unterhaltsame Möglichkeit, Kenntnisse über Tiere und Pflanzen im Wald zu erwerben und zu vertiefen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9yK5zsEl6Z2k" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologie>,
        <http://example.org/education/concept/Biologie>,
        <http://example.org/education/concept/Kreuzwortr%C3%A4tsel>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Naturwissenschaften>,
        <http://example.org/education/concept/Pflanzen>,
        <http://example.org/education/concept/Sachunterricht>,
        <http://example.org/education/concept/Tiere>,
        <http://example.org/education/concept/Unterrichtsmaterial>,
        <http://example.org/education/concept/Wald%C3%B6kologie> ;
    dcterms:title "Tiere und Pflanzen im Wald"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9zrgYh873fJ4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Angabe> ;
    dcterms:description "Die Verwendung von Excel-Funktionen wie Zählenwenn() und Summewenn() ermöglicht es, Daten nach bestimmten Bedingungen zu filtern und zu analysieren. Durch die Anwendung dieser Funktionen können Benutzer komplexe Datenanalysen durchführen und wichtige Erkenntnisse gewinnen. Darüber hinaus werden auch grundlegende Excel-Funktionen wie das Sortieren, Filtern und Diagrammerstellen erläutert, um eine umfassende Datenanalyse zu ermöglichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9zrgYh873fJ4" ;
    dcterms:subject <http://example.org/education/concept/AutoFilter>,
        <http://example.org/education/concept/Datenvisualisierung>,
        <http://example.org/education/concept/Diagramme>,
        <http://example.org/education/concept/Excel>,
        <http://example.org/education/concept/Filtern>,
        <http://example.org/education/concept/Here_is_the_list_of_assigned_keywords%3ADatenanalyse>,
        <http://example.org/education/concept/Pivot-Tabelle>,
        <http://example.org/education/concept/Sortieren>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Tabellenkalkulation> ;
    dcterms:title "Markieren und Indizieren von Bibliografischen Daten"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

