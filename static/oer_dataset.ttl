    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik für Verkehrsingenieure behandelt die Grundlagen der Fahrzeugbewegung und -simulation im Schienenverkehr, einschließlich der Berechnung von Energiebedarf und Leistungsanforderungen. Durch das Studium dieser Materialien können Lernende die physikalischen Gesetze und mathematischen Modelle verstehen, die für die Fahrzeugbewegung und -steuerung notwendig sind. Zudem werden Lösungsansätze für die Fahrzeitermittlung vorgestellt, um die Fahrtzeit und den Energiebedarf von Schienenfahrzeugen zu berechnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "136rsTk1cNdvQ" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Technik_spurgef%C3%BChrter_Fahrzeuge> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Fahrwiderstandskr%C3%A4fte>,
        <http://example.org/education/concept/Fahrzeugsimulation>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Leistungsanalyse>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Traktionsverm%C3%B6gen>,
        <http://example.org/education/concept/Verkehrsingenieurwesen> ;
    dcterms:title "Fahrdynamik für Verkehrsingenieure"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

