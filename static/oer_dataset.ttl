oer:4czDLSbee68E a edu:LearningResource ;
    sim:similarTo oer:5CJDTzxdhCto,
        oer:6kmybINDidAc,
        oer:7rHQilTRqVMI,
        oer:9CUiwaw3vJGU ;
    dcterms:creator <http://example.org/education/person/Askey> ;
    dcterms:description "Die amerikanischen Hochschulbibliotheken stehen unter starkem Druck, ihre Finanzen zu sichern und ihre Dienstleistungen an die Bedürfnisse der Studierenden anzupassen. Durch die Umstellung auf neue Katalogisierungssysteme wie AACR2 und die Implementierung von Customer-Service-Konzepten versuchen sie, ihre Attraktivität zu steigern und die Zufriedenheit ihrer Nutzer zu erhöhen. Durch den Vergleich mit deutschen Bibliotheken können deutsche Bibliothekare von den Erfahrungen amerikanischer Kollegen lernen und ihre eigenen Strategien entwickeln, um in Zeiten knapper Finanzen erfolgreich zu bleiben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4czDLSbee68E" ;
    dcterms:subject <http://example.org/education/concept/Amerikastudien>,
        <http://example.org/education/concept/Benutzerorientierung>,
        <http://example.org/education/concept/Bibliothekskultur>,
        <http://example.org/education/concept/Bibliotheksmanagement>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Deutschamerikanistik>,
        <http://example.org/education/concept/Hochschulbibliotheken>,
        <http://example.org/education/concept/Informationsdienstleistungen>,
        <http://example.org/education/concept/Kundenbindung>,
        <http://example.org/education/concept/Wissenschaftliches_Schreiben> ;
    dcterms:title "Die amerikanische Hochschulbibliothek und ihre deutsche Schwester im Vergleich"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

