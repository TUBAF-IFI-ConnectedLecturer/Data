    dcterms:creator <http://example.org/education/person/Schramm> ;
    dcterms:description "Das Material ermöglicht es Lernenden, das Skizzieren von Ableitungsgraphen zu erlernen, indem sie einen Screencast verwenden, der schrittweise die wichtigsten Punkte und Zusammenhänge zwischen Funktion und Ableitung erklärt. Durch den Einsatz des Screencasts können Lernende ihre Fähigkeit zum selbstregulierten Lernen verbessern und ihr Wissen über mathematische Darstellungen erweitern. Das Material eignet sich für die Einstiegsphase oder selbstständige Erarbeitungsphase in der 11. Klasse im Fach Mathematik, Bereich Differentialrechnung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "110T4177aGYT4" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Ableitungsgraphen>,
        <http://example.org/education/concept/Differentialrechnung>,
        <http://example.org/education/concept/Fachkompetenz>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Informatische_Bildung>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Mathematische_Darstellungen>,
        <http://example.org/education/concept/Methodenkompetenz>,
        <http://example.org/education/concept/Selbstkompetenz>,
        <http://example.org/education/concept/Selbstreguliertes_Lernen> ;
    dcterms:title "Inhaltsverzeichnis"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

