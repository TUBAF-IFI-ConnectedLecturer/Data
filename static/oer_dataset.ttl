oer:12kLaNxQ-JOmQ a edu:LearningResource ;
    sim:similarTo oer:3JO0XkvZhyas,
        oer:3_FzhZ2V5xlI,
        oer:3glsoUXAVw_s,
        oer:4D5Vm4gkTBds,
        oer:78jnmHSMXRxI,
        oer:7oOq7_6IJR3E,
        oer:8VwcsCHDrtQ0,
        oer:9ayicVUSbMyA ;
    dcterms:creator <http://example.org/education/person/Scheffel> ;
    dcterms:description "Die Diskussionsteil eines wissenschaftlichen Artikels dient der Interpretation und Einordnung der Ergebnisse, um die Implikationen für das Forschungsfeld zu erörtern und Limitationen aufzuzeigen. Durch die Anwendung von Struktur- und Überleitungselementen kann eine klare und logische Argumentation entwickelt werden, um die Ergebnisse in einen größeren Kontext einzuordnen. Durch die Beachtung von wissenschaftlichen Schreibregeln und Zitationsrichtlinien können Studierende ihre Forschungsergebnisse effektiv präsentieren und diskutieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12kLaNxQ-JOmQ" ;
    dcterms:subject <http://example.org/education/concept/Diskussionsteil>,
        <http://example.org/education/concept/Entscheidungsverhalten>,
        <http://example.org/education/concept/Experimentalpsychologie>,
        <http://example.org/education/concept/Feedback>,
        <http://example.org/education/concept/Forschungsmethoden>,
        <http://example.org/education/concept/Kognitionswissenschaft>,
        <http://example.org/education/concept/Need_for_Cognition>,
        <http://example.org/education/concept/Psychologische_Studie>,
        <http://example.org/education/concept/Theorieteil>,
        <http://example.org/education/concept/Wissenschaftliches_Schreiben> ;
    dcterms:title "ES Experimentalpsychologisches Arbeiten 5. Diskussion Christoph Scheffel Folie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

