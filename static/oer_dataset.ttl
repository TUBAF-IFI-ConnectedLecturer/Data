    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Henschel>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs WS2022/23 an der Hochschule für Technik und Wirtschaft Dresden bietet acht Aufgaben mit Lösungshinweisen zu verschiedenen Themen wie algebraischen Gleichungen, komplexen Zahlen und Polynomen. Durch die Bearbeitung dieser Aufgaben können Lernende ihre Fähigkeiten in der Lösung von Gleichungen und Ungleichungen, der Arbeit mit komplexen Zahlen und der Zerlegung von Polynomen verbessern. Die Übungsaufgaben sind so gestaltet, dass sie den Lernenden die Möglichkeit geben, alternative Lösungsansätze zu diskutieren und ihre eigenen Lösungen mit anderen zu vergleichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "125IIc-VU4crE" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Betragsgleichung>,
        <http://example.org/education/concept/Dreiecksungleichung>,
        <http://example.org/education/concept/Fundamentalsatz_der_Algebra>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Gleichungen>,
        <http://example.org/education/concept/Komplexe_Zahlen>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Polynome> ;
    dcterms:title "Mathematik 1 - WS202223 Übungsblatt 7"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

