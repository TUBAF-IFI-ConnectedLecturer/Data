oer:5oMdWlsePPig a edu:LearningResource ;
    sim:similarTo oer:6D9aq6HrC3Pg,
        oer:6OkBkofNEscc ;
    dcterms:creator <http://example.org/education/person/Raban>,
        <http://example.org/education/person/Sass>,
        <http://example.org/education/person/Thun> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Grundlagen der Informatik und Computerwissenschaften, indem es die Entwicklung des Computers, seine Bestandteile und Funktionen, sowie die Auswirkungen auf die Gesellschaft thematisiert. Durch die Bearbeitung dieser Aufgaben sollen Schülerinnen und Schüler ein Verständnis für die Strukturen und Prozesse von Computern entwickeln und lernen, diese in verschiedenen Kontexten anzuwenden. Zudem werden sie mit Konzepten wie Cloud-Computing, künstlicher Intelligenz und nachhaltiger Nutzung digitaler Technologien vertraut gemacht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5oMdWlsePPig" ;
    dcterms:subject <http://example.org/education/concept/Cloud-Computing>,
        <http://example.org/education/concept/Computer>,
        <http://example.org/education/concept/Datenstruktur>,
        <http://example.org/education/concept/Digitale_Technologien>,
        <http://example.org/education/concept/Hardware>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Rechentechnik>,
        <http://example.org/education/concept/Verzeichnisstruktur> ;
    dcterms:title "Cloud-Computing als Möglichkeit der lokalen, regionalen und globalen Vernetzung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5r3F_HIysIeA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/M%C3%BCller> ;
    dcterms:description "Krabat, ein junger Mann, wird in die Welt der Schwarzen Magie gezogen und muss sich gegen den Meister der Mühle durchsetzen, um seine Freiheit und die seiner Gefährten zu erlangen. Durch seine Erfahrungen und Lernprozesse entwickelt Krabat sich von einem unwissenden Lehrling zu einem gelehrigen Schüler. Am Ende besiegt Krabat den Meister und befreit sich und die anderen Gesellen von der Mühle, verliert jedoch seine Zauberkraft."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5r3F_HIysIeA" ;
    dcterms:subject <http://example.org/education/concept/Fantasyliteratur>,
        <http://example.org/education/concept/Fluchtversuche>,
        <http://example.org/education/concept/Freiheit>,
        <http://example.org/education/concept/Geselle>,
        <http://example.org/education/concept/Lehre>,
        <http://example.org/education/concept/M%C3%BCller>,
        <http://example.org/education/concept/Neujahr>,
        <http://example.org/education/concept/Schwarze_Magie>,
        <http://example.org/education/concept/Verwandlung>,
        <http://example.org/education/concept/Zauberer> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

oer:5s3lhChS-WzE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Achtziger> ;
    dcterms:description "Die Übersicht beschreibt die Kleinblättrigen Sedum-Arten der Weinberge und enthält Informationen über ihre Wuchsform, Größe, Blüten- und Blattmerkmale sowie Habitat und Ellenberg-Zeigerwerte. Durch das Studium dieser Arten können Lernende Kenntnisse über die Charakteristika und Ökologie von Sedum-Arten erwerben. Die Übersicht bietet eine umfassende Darstellung der Merkmale und Eigenschaften dieser Pflanzenarten, die für die botanische Forschung und Praxis relevant sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5s3lhChS-WzE" ;
    dcterms:subject <http://example.org/education/concept/Biodiversit%C3%A4t.>,
        <http://example.org/education/concept/Bl%C3%BCtenpflanzen>,
        <http://example.org/education/concept/Felsvegetation>,
        <http://example.org/education/concept/Fetthennenbl%C3%A4ttrige>,
        <http://example.org/education/concept/Futterpflanzen>,
        <http://example.org/education/concept/Mauerbiotope>,
        <http://example.org/education/concept/Nektarpflanzen>,
        <http://example.org/education/concept/Pflanzen%C3%B6kologie>,
        <http://example.org/education/concept/Sedum>,
        <http://example.org/education/concept/Trockenrasen> ;
    dcterms:title "BIODIVina 2020 BIODIVina Übersicht Kleinblättrige Sedum-Arten der Weinberge"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:5sMDZAm80Sx0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "In diesem Arbeitsauftrag werden Studierende der germanistischen Sprachwissenschaft aufgefordert, Artikel über das Wort \"Arbeit\" in verschiedenen Wörterbüchern zu vergleichen und Unterschiede hinsichtlich Form, Struktur und Inhalt zu erkennen. Darüber hinaus sollen sie Sinnrelationen zwischen Wortpaaren bestimmen und Beispiele für verschiedene semantische Phänomene wie Homonymie, Synonymie, Komplementarität und Antonymie finden. Durch die Bearbeitung dieser Aufgaben können Studierende ihre Fähigkeiten in der sprachwissenschaftlichen Analyse und Beschreibung von Wortbedeutungen verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5sMDZAm80Sx0" ;
    dcterms:subject <http://example.org/education/concept/Antonymie>,
        <http://example.org/education/concept/Germanistik>,
        <http://example.org/education/concept/Homonymie>,
        <http://example.org/education/concept/Lexikologie>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Sinnrelationen>,
        <http://example.org/education/concept/Sprachwissenschaft>,
        <http://example.org/education/concept/Synonymie>,
        <http://example.org/education/concept/Wortbedeutung> ;
    dcterms:title "UE Einführung in die germanistische Sprachwissenschaft"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5sc2MFIFGM2g a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Platte> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Digitalisierung von Tönen und Schallwellen, einschließlich der Kodierung auf Audio-CDs und AES-3. Die Studierenden lernen, wie Audiodaten kodiert und decodiert werden, sowie die verschiedenen Formate und Techniken der digitalen Übertragung. Durch diese Vorlesung erhalten die Lerner ein Verständnis für die technischen Aspekte der Audiowiedergabe und -verarbeitung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5sc2MFIFGM2g" ;
    dcterms:subject <http://example.org/education/concept/AES-3>,
        <http://example.org/education/concept/Audio-CD>,
        <http://example.org/education/concept/Audiodaten>,
        <http://example.org/education/concept/CD-Technologie>,
        <http://example.org/education/concept/Datenkodierung>,
        <http://example.org/education/concept/Digitale_Signalverarbeitung>,
        <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Diskretisierung>,
        <http://example.org/education/concept/Netzwerktechnik>,
        <http://example.org/education/concept/Schallwellen> ;
    dcterms:title "Einführung, Töne und Digitalisierung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5tjaPRzhkoWA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Goblirsch> ;
    dcterms:description "Das Hamburger Verständlichkeitsmodell hilft bei der Gestaltung von Texten für eine möglichst große Zielgruppe ansprechend und verständlich zu machen. Es umfasst vier Dimensionen: Einfachheit, Gliederung, Prägnanz und Anregung. Durch die Anwendung dieser Kriterien kann die Verständlichkeit journalistischer Beiträge sichergestellt werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5tjaPRzhkoWA" ;
    dcterms:subject <http://example.org/education/concept/Journalismus>,
        <http://example.org/education/concept/Kommunikationswissenschaft>,
        <http://example.org/education/concept/Lesbarkeit>,
        <http://example.org/education/concept/Medienkommunikation>,
        <http://example.org/education/concept/Rezeptionsforschung>,
        <http://example.org/education/concept/Schreiben_f%C3%BCr_die_Zielgruppe>,
        <http://example.org/education/concept/Sprachverwendung.>,
        <http://example.org/education/concept/Textverst%C3%A4ndlichkeit>,
        <http://example.org/education/concept/Verst%C3%A4ndlichkeitsforschung>,
        <http://example.org/education/concept/journalistische_Darstellung> ;
    dcterms:title "Gebrauchstexte schreiben"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

oer:5wJRIfpFMiWY a edu:LearningResource ;
    sim:similarTo oer:77m5cQVpJgYY,
        oer:7y2Vvnr6LpnI ;
    dcterms:description "Die Ableitungsregeln für Linearkombinationen, Produkte, Quotienten und Verkettungen von Funktionen werden dargestellt. Durch Anwendung dieser Regeln können die Ableitungen von kombinierten Funktionen berechnet werden. Die Kenntnis dieser Regeln ermöglicht es, komplexe Funktionen zu differenzieren und ihre Eigenschaften zu analysieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5wJRIfpFMiWY" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
