        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Landschafts%C3%B6kologie>,
        <http://example.org/education/concept/Naturschutz>,
        <http://example.org/education/concept/Pflanzensoziologie>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Vegetationstypen>,
        <http://example.org/education/concept/Weinbau> ;
    dcterms:title "BIODIVina Übersicht Vegetationstypen in Weinbergen (Schwerpunkt Sachsen)"@de ;
