oer:9vqiLU1uqZ6g a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kuhrmann>,
        <http://example.org/education/person/Piatza>,
        <http://example.org/education/person/Schreier> ;
    dcterms:description "Die quantitative Inhaltsanalyse ist eine etablierte Forschungsmethode, die systematisch Medieninhalte analysiert und Erkenntnisse über deren Eigenschaften und Wirkungen gewinnt. Durch diese Methode können Forscherinnen und Forscher valide und zuverlässige Ergebnisse erzielen, um Rückschlüsse auf die Wirkung der Medieninhalte auf die Rezipienten zu ziehen. Die Anwendungsbereiche der quantitativen Inhaltsanalyse erstrecken sich über verschiedene Fachbereiche, wie Kommunikations-, Politik-, Sozial- und Marktforschung, um eine Vielzahl von Forschungsfragen und Fragestellungen zu untersuchen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9vqiLU1uqZ6g" ;
    dcterms:subject <http://example.org/education/concept/Bildungsforschung>,
        <http://example.org/education/concept/Forschungsmethoden>,
        <http://example.org/education/concept/Inhaltsanalyse>,
        <http://example.org/education/concept/Kommunikationswissenschaft>,
        <http://example.org/education/concept/Marktforschung>,
        <http://example.org/education/concept/Medienforschung>,
        <http://example.org/education/concept/Politikwissenschaft>,
        <http://example.org/education/concept/Sozialforschung>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/quantitative_Inhaltsanalyse> ;
    dcterms:title "Die quantitative Inhaltsanalyse"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:9yUI-3q259Bs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Leinkauf>,
        <http://example.org/education/person/Panofsky>,
        <http://example.org/education/person/Schumacher> ;
    dcterms:description "Die Renaissance wird als Epoche eines verstärkten Kulturtransfers zwischen Italien und Europa beschrieben, gekennzeichnet durch die Wiederbelebung antiker Themen, Techniken und Ideen in Kunst, Architektur und Literatur. Durch das Studium dieser Epoche können Lernende ein Verständnis der kulturellen, sozialen und politischen Entwicklungen in Italien und Europa zwischen dem 14. und 17."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "9yUI-3q259Bs" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Architektur>,
        <http://example.org/education/concept/Fr%C3%BChrenaissance>,
        <http://example.org/education/concept/Humanismus>,
        <http://example.org/education/concept/Italienische_Renaissance>,
        <http://example.org/education/concept/Kulturtransfer>,
        <http://example.org/education/concept/Kunstgeschichte>,
        <http://example.org/education/concept/Kunsttheorie>,
        <http://example.org/education/concept/Malerei>,
        <http://example.org/education/concept/Renaissance>,
        <http://example.org/education/concept/Skulptur> ;
    dcterms:title "Renaissance - Wiedererwachen?"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

