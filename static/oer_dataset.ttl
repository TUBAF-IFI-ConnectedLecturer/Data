    dcterms:creator <http://example.org/education/person/Wege> ;
    dcterms:description "Das Material behandelt die Kurvendiskussion mit Ableitungen im Mathematikunterricht der Klassenstufe 11 und 12. Es soll den Schülern ermöglicht werden, Funktionen zu analysieren und Probleme zu lösen, indem sie Kenntnisse über Funktionen und ihre Ableitungen anwenden. Durch die Bearbeitung des Materials sollen die Schüler ihre Fähigkeiten in der Problemlösung und Reflexion verbessern können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4Aa6jyAZPDsM" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
