oer:6rzprfpwzz38 a edu:LearningResource ;
    sim:similarTo oer:7WVcNlOQ6qLg,
        oer:7fsofecU9RvY,
        oer:816GmnNSeXJQ,
        oer:88QMZeu7KrmA,
        oer:8GmElqtWjrOA,
        oer:9fKACmSQzSc4 ;
    dcterms:creator <http://example.org/education/person/Jaenichen> ;
    dcterms:description "Die Vorlesung behandelt die Architektur von Bremsanlagen für Hochgeschwindigkeitszüge und erläutert die verschiedenen Wirkprinzipien, wie das Ruhestrom- und Arbeitsstromprinzip. Die Studierenden lernen die Funktionen und technischen Spezifikationen von Bremsen kennen, einschließlich der Selbsttätigkeit der Bremsen und der Übertragung von Bremsbefehlen. Durch diese Vorlesung erhalten die Studierenden ein Verständnis für die Konstruktion und den Einsatz von Bremsanlagen in Hochgeschwindigkeitszügen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6rzprfpwzz38" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bremsanlagen>,
        <http://example.org/education/concept/Bremssysteme>,
        <http://example.org/education/concept/Eisenbahntechnik>,
        <http://example.org/education/concept/Elektrodynamische_Bremse>,
        <http://example.org/education/concept/Hochgeschwindigkeitsverkehr>,
        <http://example.org/education/concept/Magnetschienenbremse>,
        <http://example.org/education/concept/Scheibenbremse>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Wirbelstrombremse>,
        <http://example.org/education/concept/Zugsteuerung> ;
    dcterms:title "Fakultät Verkehrswissenschaften Professur für Technik spurgeführter Fahrzeuge Dr. Dieter Jaenichen Vorlesung Bremstechnik des Hochgeschwindigkeitsverkehr Pkt 4 Architektur der Bremsanlagen (Kompendium)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:7aka6H2KQHQs a edu:LearningResource ;
    sim:similarTo oer:7y2Vvnr6LpnI,
        oer:8hBx9oZBHQhg,
        oer:8mqDmRgDPbLI,
        oer:9V13RZyFH8i8 ;
    dcterms:creator <http://example.org/education/person/Winkler> ;
    dcterms:description "Die Übung behandelt das Newton-Verfahren zur Nullstellenbestimmung und Minimierung von Funktionen, wobei die Konvergenzverhalten und -raten untersucht werden. Durch die Bearbeitung der Aufgaben sollen die Lernenden das lokale Newton-Verfahren implementieren und testen können, um seine Eigenschaften und Grenzen zu verstehen. Zudem werden affin-lineare Transformationen und ihre Auswirkungen auf das Verfahren thematisiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7aka6H2KQHQs" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Algorithmus>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Konvergenz>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Matlab>,
        <http://example.org/education/concept/Newton-Verfahren>,
        <http://example.org/education/concept/Numerische_Analysis>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Partielle_Ableitung> ;
    dcterms:title "Optimierung für Mathematikerinnen Übung 4"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8J-it6wi52mc a edu:LearningResource ;
    sim:similarTo oer:8SncE0C0F3f4,
        oer:8XruMvGAzQnA,
