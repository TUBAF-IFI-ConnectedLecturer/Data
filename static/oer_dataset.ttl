oer:5jb7SMmbYISA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Brose> ;
    dcterms:description "Die Excel-Übung behandelt Kennzahlen einer Universität, einschließlich Studierendenzahlen, Finanzen und Personalstellen. Durch die Bearbeitung der Aufgaben können Lerner ihre Fähigkeiten im Umgang mit Tabellen und Funktionen wie SUMME verbessern und erfahren, wie man Daten aufbereitet und visualisiert. Die Übung bietet einen Einblick in die Struktur und Entwicklung einer Universität über mehrere Jahre hinweg."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "5jb7SMmbYISA" ;
    dcterms:subject <http://example.org/education/concept/Bildungsmanagement>,
        <http://example.org/education/concept/Drittmittel>,
        <http://example.org/education/concept/Finanzen>,
        <http://example.org/education/concept/Forschung>,
