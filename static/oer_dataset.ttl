    dcterms:creator <http://example.org/education/person/K%C5%99%C3%AD%C5%BEek>,
        <http://example.org/education/person/Sgall>,
        <http://example.org/education/person/Uhl%C3%AD%C5%99ov%C3%A1> ;
    dcterms:description "Die Kontrastive Linguistik und die Sprachtypologie sind zwei Ansätze zum Vergleich von Sprachen, die sich in ihrer Zielsetzung, Granularität und Perspektivierung unterscheiden. Durch den Vergleich von Sprachen können Lernende Einblicke in die Struktur und Variation von Sprachen gewinnen und ihre Fähigkeiten im Fremdsprachunterricht verbessern. Die Kenntnis der Kontrastiven Linguistik und der Sprachtypologie kann zudem bei der Entwicklung von Lehrmaterialien und der Gestaltung von Unterrichtseinheiten hilfreich sein."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10DSMenEC_zLk" ;
