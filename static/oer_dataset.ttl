        <http://example.org/education/concept/Kursmanagement>,
        <http://example.org/education/concept/Lerninhalte>,
        <http://example.org/education/concept/Lernplattformen>,
        <http://example.org/education/concept/Online-Kurse>,
        <http://example.org/education/concept/Plattformadministration>,
        <http://example.org/education/concept/Zugriffsrechte> ;
    dcterms:title "Autorenfunktionen in OPAL"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

