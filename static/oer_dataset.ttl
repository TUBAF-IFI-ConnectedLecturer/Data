        oer:5TePYc-kiYw0,
        oer:5gGsbVT-6Gwk,
        oer:7JC4PIjQU7QQ,
        oer:888OhN5kAiU0 ;
    dcterms:description "Diese Übersicht behandelt verschiedene Verteilungen stetiger und diskreter Zufallsgroßen, einschließlich ihrer Parameter, Dichtefunktionen und typischen Anwendungen. Die Darstellung umfasst Binomial-, Poisson-, Hypergeometrische, Normal-, Exponential-, Gleichmäßige und Weibull-Verteilung, wobei jede Verteilung mit ihren spezifischen Eigenschaften und Beispielen erläutert wird. Durch das Studium dieser Übersicht können Lernende die verschiedenen Verteilungen und ihre Anwendungen in der Statistik und Wahrscheinlichkeitstheorie verstehen und anwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "121AajijhoRTQ" ;
    dcterms:subject <http://example.org/education/concept/Binomialverteilung>,
        <http://example.org/education/concept/Exponentialverteilung>,
        <http://example.org/education/concept/Hypergeometrische_Verteilung>,
        <http://example.org/education/concept/Normalverteilung>,
        <http://example.org/education/concept/Poissonverteilung>,
        <http://example.org/education/concept/Qualit%C3%A4tskontrolle>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Verteilungen>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie>,
        <http://example.org/education/concept/Weibullverteilung> ;
    dcterms:title "Verteilungen stetiger und diskreter Zufallsgroßen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

