    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik der Schienenfahrzeuge wird durch die Grundgleichung des Kräftegleichgewichts in Längsrichtung beschrieben, die die verschiedenen Kräfte wie Zugkraft, Trägheitsterm und Widerstandskräfte berücksichtigt. Durch die Anwendung dieser Gleichung können Fahrzeugeigenschaften wie Geschwindigkeit, Weg und Beschleunigung berechnet werden. Das Verständnis dieser Grundlagen ermöglicht es, die Fahrdynamik von Schienenfahrzeugen zu analysieren und zu optimieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3vTy0okqO8Rk" ;
    dcterms:subject <http://example.org/education/concept/Antriebskr%C3%A4fte>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Bremskraft>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrwiderstandskr%C3%A4fte>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Kr%C3%A4ftegleichgewicht>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Traktionskraft>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik der Schienenfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

