        <http://example.org/education/concept/Webserver> ;
    dcterms:title "Der Netzwerk Simulator Filius"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:11a35at6WIuqs a edu:LearningResource ;
    sim:similarTo oer:12KSlMvZcZ9Hw,
        oer:3kqppOFH8iR0,
