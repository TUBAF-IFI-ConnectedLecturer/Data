        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mathematische_Physik>,
        <http://example.org/education/concept/Signalverarbeitung>,
        <http://example.org/education/concept/Trigonometrie>,
        <http://example.org/education/concept/Vektorr%C3%A4ume>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Mathematik für Fahrzeugtechnik (M04), Sommersemester 2018"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

