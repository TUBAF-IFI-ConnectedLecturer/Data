        <http://example.org/education/concept/Permutationen>,
        <http://example.org/education/concept/Symmetrien>,
        <http://example.org/education/concept/Tetraeder> ;
    dcterms:title "Geometrie - Sommer 2025 Übungsblatt 1"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

