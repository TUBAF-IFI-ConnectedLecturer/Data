        <http://example.org/education/concept/Infektionsschutz>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Praktikum>,
        <http://example.org/education/concept/Schweigepflicht>,
        <http://example.org/education/concept/Vertraulichkeit> ;
    dcterms:title "Rechtliche Hinweise für die Durchführung des Blockpraktikums A"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:9tpUqFQjXq5g a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Weigel> ;
    dcterms:description "Die Medien und Politik-Vorlesung behandelt die Wechselwirkung zwischen Medien und Politik, einschließlich der Funktionen von Medien, der politischen Kommunikation und der Medienpolitik. Durch die Vorlesung sollen Studierende ein Verständnis dafür entwickeln, wie Medien die öffentliche Meinung beeinflussen und wie sie in der politischen Agenda-Setzung eingesetzt werden können. Zudem werden Strategien wie Priming, Framing und ABC-Strategie vorgestellt, um Inhalte zu vermitteln und Themen zu setzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9tpUqFQjXq5g" ;
    dcterms:publisher <http://example.org/education/organization/Philosophische_Fakult%C3%A4t__Institut_F%C3%BCr_Politikwissenschaft> ;
    dcterms:subject <http://example.org/education/concept/Agenda-Setting>,
        <http://example.org/education/concept/Digitale_Medien>,
        <http://example.org/education/concept/Framing>,
        <http://example.org/education/concept/Informationsfreiheit>,
        <http://example.org/education/concept/Medienlandschaft>,
        <http://example.org/education/concept/Medienpolitik>,
        <http://example.org/education/concept/Politische_Bildung>,
        <http://example.org/education/concept/Politische_Kommunikation>,
        <http://example.org/education/concept/Priming>,
        <http://example.org/education/concept/Zivilgesellschaft> ;
    dcterms:title "Medien und Politik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

