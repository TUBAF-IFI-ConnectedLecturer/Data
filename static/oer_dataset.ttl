oer:7ss2in40o0Rs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Wolff> ;
    dcterms:description "Die Isochronenuntersuchung dient der Standortfestlegung eines S-Bahn-Haltepunktes im Wohngebiet, um die Erschließungsqualität für die Einwohner zu verbessern. Durch die Analyse der Verkehrsnetzstruktur können zwei mögliche Standorte HP1 und HP2 verglichen werden, um den geringsten Gesamtgehzeitaufwand zu ermitteln. Die Untersuchung berücksichtigt Faktoren wie Gehgeschwindigkeit, Abminderungsfaktor für S-Bahn-Benutzer und Einwohnerzahl, um die beste Lage des Haltepunktes zu bestimmen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7ss2in40o0Rs" ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentlicher_Nahverkehr>,
        <http://example.org/education/concept/Haltepunkt>,
        <http://example.org/education/concept/Isochronen>,
        <http://example.org/education/concept/Raumplanung>,
        <http://example.org/education/concept/S-Bahn>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Verkehrsentwicklung>,
        <http://example.org/education/concept/Verkehrsnetzstruktur>,
        <http://example.org/education/concept/Verkehrsplanung>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Übungsblatt 3 Analyse der VerkehrsnetzstrukturIsochronen - Isochronenuntersuchung zur Standortfestlegung eines S-Bahn-Haltepunktes"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7tiMczQBWZfM a edu:LearningResource ;
