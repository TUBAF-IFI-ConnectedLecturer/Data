        <http://example.org/education/concept/Lesbarkeit>,
        <http://example.org/education/concept/Vollst%C3%A4ndigkeit>,
        <http://example.org/education/concept/Wahrheit>,
        <http://example.org/education/concept/Wissenschaftssprache>,
        <http://example.org/education/concept/wissenschaftliche_Erkenntnis> ;
    dcterms:title "Kein Titel gefunden."@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:9cZgXivTQ9t8 a edu:LearningResource ;
    sim:similarTo oer:9gzKRPe1QBes,
        oer:9h9OJkMfxWV4 ;
    dcterms:creator <http://example.org/education/person/Rechenberg> ;
    dcterms:description "Die wissenschaftliche Kommunikation erfordert eine klare und präzise Sprache, um Erkenntnisse zu vermitteln und die Wahrheit darzustellen. Durch die Anwendung bestimmter Regeln und Aspekte, wie beispielsweise der Vermeidung von Synonymen und Umgangssprache, kann eine Fachsprache entwickelt werden, die sachliche Erkenntnisse beschreibt. Der wissenschaftliche Erkenntnisprozess wird durch die Verwendung spezieller Begriffe und einer logischen Argumentation unterstützt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9cZgXivTQ9t8" ;
    dcterms:subject <http://example.org/education/concept/Argumentation>,
