        <http://example.org/education/concept/Mobile-Anwendungen>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Spieleentwicklung> ;
    dcterms:title "Spieleprogrammierung als App  FlappyBird"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

