oer:665U3W2Z4BsE a edu:LearningResource ;
    sim:similarTo oer:6SbfdtjSJ9ZQ,
        oer:7MM6EBPWKP1w,
        oer:8HC3JqYpmVJg,
        oer:8J-it6wi52mc,
