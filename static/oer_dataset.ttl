    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Schienenfahrzeugbremstechnik und vermittelt Kenntnisse über die verschiedenen Arten von Eisenbahnbremsen, ihre Funktionen und Anforderungen. Durch die Lektüre dieser Unterlagen können Studierende ein Verständnis dafür entwickeln, wie Bremsysteme in Schienenfahrzeugen funktionieren und wie sie kombiniert werden müssen, um eine sichere und effiziente Bremsung zu gewährleisten. Zudem werden Beispiele und Übungsaufgaben angeboten, um die praktische Anwendung der theoretischen Kenntnisse zu fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3FLeiN6Wcs9o" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bremsauslegung>,
        <http://example.org/education/concept/Bremsmechanik>,
        <http://example.org/education/concept/Eisenbahnbremsen>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Hochgeschwindigkeitsverkehr>,
        <http://example.org/education/concept/Klotzbremse>,
        <http://example.org/education/concept/Magnetschienenbremse>,
        <http://example.org/education/concept/Schienenfahrzeugtechnik>,
        <http://example.org/education/concept/Schienenverkehrstechnik>,
        <http://example.org/education/concept/elektrodynamische_Bremse> ;
    dcterms:title "Bremsen der Schienenfahrzeuge (Grundlagen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

