        <http://example.org/education/concept/Konstruktionstechnik>,
        <http://example.org/education/concept/Tragwerksplanung>,
        <http://example.org/education/concept/Zeitplanung> ;
    dcterms:title "Gebäudehülle Planungsgrundlagen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

