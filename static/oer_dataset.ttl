oer:9wCUGRU88t_U a edu:LearningResource ;
    dcterms:description "Das Experiment untersucht den Zusammenhang zwischen Lichtintensität und Abschirmung sowie Entfernung zur Lichtquelle. Durch die Messungen mit verschiedenen Lagen von Papier als Abschirmung und unterschiedlichen Abständen zur Lichtquelle können die Auswirkungen auf die Lichtintensität ermittelt werden. Die Erkenntnisse aus diesem Experiment helfen bei der Veranschaulichung des Zusammenhangs zwischen Lichtintensität, Abschirmung und Entfernung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9wCUGRU88t_U" ;
    dcterms:subject <http://example.org/education/concept/Abschirmung>,
        <http://example.org/education/concept/Distanz>,
        <http://example.org/education/concept/Ionisierende_Strahlung>,
        <http://example.org/education/concept/Licht>,
        <http://example.org/education/concept/Lichtintensit%C3%A4t>,
        <http://example.org/education/concept/Lichtquelle>,
        <http://example.org/education/concept/Optische_Messung>,
        <http://example.org/education/concept/Phyphox-App>,
        <http://example.org/education/concept/Physikalisches_Experiment>,
        <http://example.org/education/concept/Strahlung> ;
    dcterms:title "Abschirmung von Licht"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9wFnaE-03fOM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hagedorn> ;
    dcterms:description "Der Text beschreibt die Auswirkungen von zwei Variablen m und n auf den Graphen einer Funktion. Durch die Änderung von m ändert sich die Steigung des Graphen, während die Änderung von n den y-Achsenabschnitt verschiebt. Durch das Verständnis dieser Beziehungen können Lernende die Eigenschaften von Funktionen besser analysieren und interpretieren."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9wFnaE-03fOM" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Funktionsterminierte>,
        <http://example.org/education/concept/Graphenanalyse>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Koordinatensysteme>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Parameterabh%C3%A4ngigkeit>,
        <http://example.org/education/concept/mathematische_Modellierung>,
        <http://example.org/education/concept/y-Achsenabschnitt> ;
    dcterms:title "Auswirkung von m und n auf den Graphen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9y7bcapWznMc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Melnikava>,
        <http://example.org/education/person/Neumann> ;
    dcterms:description "Das Fähigkeitsselbstkonzept spielt eine wichtige Rolle bei der Leistungs- und Persönlichkeitsentwicklung von Schülern, insbesondere während der Grundschulzeit. Durch Erfahrungen mit eigenen Leistungen und direkte oder indirekte Fähigkeitsmitteilungen von Bezugspersonen entwickeln Schüler stabile Vorstellungen über ihre kognitiven Fähigkeiten. Das pädagogische Ziel besteht darin, das Fähigkeitsselbstkonzept der Schüler positiv zu entwickeln und somit ihre Leistungen und Selbstwahrnehmung zu fördern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9y7bcapWznMc" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bildungsforschung>,
        <http://example.org/education/concept/F%C3%A4higkeitsselbstkonzept>,
        <http://example.org/education/concept/Grundschulalter>,
        <http://example.org/education/concept/Leistungsbeurteilung>,
        <http://example.org/education/concept/P%C3%A4dagogische_Psychologie>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitsentwicklung>,
        <http://example.org/education/concept/Schulleistung>,
        <http://example.org/education/concept/Selbstkonzept>,
        <http://example.org/education/concept/Selbstwahrnehmung>,
        <http://example.org/education/concept/Soziale_Bezugssysteme> ;
    dcterms:title "Welche Bedeutung hat das Fähigkeitsselbstkonzept für die Leistungs- und Persönlichkeitsentwicklung von SuS?"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

