oer:1271GeorUnGkw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Neugebauer> ;
    dcterms:description "Das Interface Comparable ermöglicht die Vergleichbarkeit von Objekten nach einem natürlichen Kriterium und wird in Java-Klassen implementiert, um eine bestimmte Ordnung herzustellen. Durch die Implementierung des Interfaces können Objekte sortiert werden, wie im Beispiel der Student-Klasse gezeigt, wo die id als natürliches Kriterium dient. Die Verwendung von Comparable ermöglicht es, die natürliche Ordnung von Objekten zu bestimmen und diese in einer bestimmten Reihenfolge anzuordnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1271GeorUnGkw" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen_und_Datenstrukturen>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Interfaces>,
        <http://example.org/education/concept/Java>,
        <http://example.org/education/concept/Objektorientierte_Programmierung>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Sortieralgorithmen>,
        <http://example.org/education/concept/Vergleichsoperatoren> ;
    dcterms:title "Programmierung II"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

