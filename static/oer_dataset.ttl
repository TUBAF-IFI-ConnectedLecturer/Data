        <http://example.org/education/concept/Regionalentwicklung>,
        <http://example.org/education/concept/Skalenertr%C3%A4ge>,
        <http://example.org/education/concept/Wirtschaftsintegration>,
        <http://example.org/education/concept/externe_Effekte> ;
    dcterms:title "Europäische Integration und regionale Entwicklung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

