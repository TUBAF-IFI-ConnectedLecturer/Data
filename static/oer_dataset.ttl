    dcterms:creator <http://example.org/education/person/Urbas> ;
    dcterms:description "Die Vorlesung behandelt die Regressionsanalyse und Optimierung von Modellen, einschließlich der Parameterschätzung, nichtlinearen Regression, Regularisierung und Validierung von Modellen. Durch das Studium dieser Inhalte können Lerner die Grundlagen der Regressionsanalyse verstehen, Methoden zur Optimierung von Modellen anwenden und die Güte von Modellen evaluieren. Zudem werden numerische Verfahren wie Gradient Descent und Grid-Search vorgestellt, um Hyperparameter zu optimieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3-5GC8zLdWQg" ;
    dcterms:publisher <http://example.org/education/organization/The_Document_Is_Not_Provided__But_I_Can_Assist_You_With_The_Text_You_Provided_Earlier._After_Analyzing_The_Text__I_Found_That_The_Author%27s_Institution_Is%3Auniversit%C3%A4t_Stuttgart> ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cberanpassung>,
        <http://example.org/education/concept/Datenbeschaffung>,
