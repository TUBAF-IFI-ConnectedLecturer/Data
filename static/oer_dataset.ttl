        oer:4cSeDq9baFdU ;
    dcterms:creator <http://example.org/education/person/Geisler> ;
    dcterms:description "Diese Aufgabenstellung behandelt die theoretischen Grundlagen der Informatik, insbesondere die Konzepte von Sprachen und Automaten. Durch die Lösung der verschiedenen Teilaufgaben können Studierende ihr Verständnis für formale Grammatiken, die Anwendung von Sprachen in der Informatik und die Funktionsweise von Automaten erweitern. Die Aufgaben sind so gestaltet, dass sie die Fähigkeit zur Analyse und zum Entwurf von Sprachen und Automaten fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1007TOPipUH8Y" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Automaten>,
        <http://example.org/education/concept/Computerwissenschaften>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Formale_Sprachen>,
        <http://example.org/education/concept/Grammatiken>,
        <http://example.org/education/concept/Informatikdidaktik>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Theoretische_Informatik> ;
    dcterms:title "Sprachen und Automaten"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

