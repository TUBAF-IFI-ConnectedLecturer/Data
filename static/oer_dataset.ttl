oer:9_vlQ7Q3vLQE a edu:LearningResource ;
    sim:similarTo oer:9toi8KWmunys ;
    dcterms:creator <http://example.org/education/person/Arndt> ;
    dcterms:description "Der Rassismus ist eine europäische Ideologie, die Menschen nach Hautfarben und anderen körperlichen Merkmalen unterteilt und diskriminiert. Durch die Geschichte von Sklaverei, Kolonialismus und nationalsozialistischer Rassenideologie haben Weiße in Europa diese Ideologie entwickelt, um ihre Macht und Herrschaft zu legitimieren. Dieses Wissen über den Rassismus soll dazu beitragen, dass Menschen verstehen, wie Hautfarben und andere Merkmale verwendet werden, um Diskriminierung und Ungleichheit zu produzieren und aufrechtzuerhalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9_vlQ7Q3vLQE" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_a_Hint_About_The_Author%27s_Institutional_Affiliation%3Athe_Institution_Is_%22springer_Fachmedien_Wiesbaden%22.this_Was_Found_In_The_Footer_Of_The_Document.> ;
    dcterms:subject <http://example.org/education/concept/Antirassismus>,
        <http://example.org/education/concept/Christentum>,
        <http://example.org/education/concept/Diskriminierung>,
        <http://example.org/education/concept/Europ%C3%A4ische_Geschichte>,
        <http://example.org/education/concept/Hautfarbe>,
        <http://example.org/education/concept/Klimatheorien>,
        <http://example.org/education/concept/Kolonialismus>,
        <http://example.org/education/concept/Menschenrechte>,
        <http://example.org/education/concept/Rassismus>,
        <http://example.org/education/concept/Sklaverei> ;
    dcterms:title "Rassismus. Eine viel zu lange Geschichte"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:9jHeGPk0_ry8 a edu:LearningResource ;
    sim:similarTo oer:9wCUGRU88t_U ;
    dcterms:description "Das Experiment untersucht die Abschirmung ionisierender Strahlung durch verschiedene Materialien und misst die Lichtintensität einer Lichtquelle mittels der phyphox-App. Durch die Messungen soll der Zusammenhang zwischen Lichtintensität und Dicke der Abschirmung sowie zwischen Lichtintensität und Distanz zur Lichtquelle ermittelt werden. Die Auswertung der Ergebnisse ermöglicht es, Erkenntnisse über die Wirkung von Abschirmungen auf die Lichtintensität zu gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9jHeGPk0_ry8" ;
    dcterms:subject <http://example.org/education/concept/Abschirmung>,
        <http://example.org/education/concept/Entfernung>,
        <http://example.org/education/concept/Ionisierende_Strahlung>,
        <http://example.org/education/concept/Lichtintensit%C3%A4t>,
        <http://example.org/education/concept/Lichtquelle>,
        <http://example.org/education/concept/Lux>,
        <http://example.org/education/concept/Phyphox-App>,
        <http://example.org/education/concept/Physikalisches_Experiment>,
        <http://example.org/education/concept/Smartphone>,
        <http://example.org/education/concept/Strahlenschutz> ;
    dcterms:title "Abschirmung von Licht"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

