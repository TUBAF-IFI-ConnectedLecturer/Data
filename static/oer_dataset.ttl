    dcterms:creator <http://example.org/education/person/Ellerfeld>,
        <http://example.org/education/person/Held> ;
    dcterms:description "Durch die Verwendung von Inkscape und einem Lasercutter können Schülerinnen und Schüler digitale Designs erstellen und in physische Objekte umwandeln, wodurch sie grundlegende Aspekte der Informatik wie Datenverarbeitung, Konvertierung und Mensch-Maschine-Interaktion erfahren. Sie lernen, wie die Qualität der Benutzeroberfläche die Effizienz und Genauigkeit ihrer Arbeit beeinflusst und wie sie Designs für den Lasercutter erstellen und bearbeiten können. Durch diese praktische Anwendung von Digital Fabrication können sie ihre Fähigkeiten in der Erstellung von Vektorgrafiken, der Verwendung von Software und der Steuerung von Maschinen verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3e49m-bDbBmY" ;
    dcterms:subject <http://example.org/education/concept/CNC-Ger%C3%A4t>,
        <http://example.org/education/concept/Computer-Aided_Design_%28CAD%29>,
        <http://example.org/education/concept/Datenverarbeitung_und_Konvertierung>,
        <http://example.org/education/concept/Digital_Fabrication>,
        <http://example.org/education/concept/Grafikeditor.>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Lasercutting>,
        <http://example.org/education/concept/Mensch-Maschine-Interaktion>,
        <http://example.org/education/concept/Scalable_Vector_Graphics_%28SVG%29>,
        <http://example.org/education/concept/Vektorgrafiken> ;
    dcterms:title "Zusammenfassung: Lasercutting im Informatikunterricht"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

