oer:9qSS1nDcF-wE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Winter> ;
    dcterms:description "Der Text vergleicht die medizinischen Theorien von Galenus und Paracelsus, zwei wichtigen Ärzten der Geschichte. Während Galenus die Heilung durch natürliche Mittel betont, vertritt Paracelsus eine Heilung durch ein Zusammenspiel von natürlichen und chemischen Mitteln. Durch das Studium dieser Theorien können Lernende die Entwicklung der Medizin und die verschiedenen Ansätze zur Krankheitsbehandlung verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9qSS1nDcF-wE" ;
    dcterms:subject <http://example.org/education/concept/Alchemie>,
        <http://example.org/education/concept/Alternativmedizin>,
        <http://example.org/education/concept/Chemotherapie>,
        <http://example.org/education/concept/Geschichte_der_Medizin>,
        <http://example.org/education/concept/Heilmittel>,
        <http://example.org/education/concept/Humoralpathologie>,
        <http://example.org/education/concept/Iatrochemie>,
        <http://example.org/education/concept/Krankheitsursachen>,
        <http://example.org/education/concept/Medizin>,
        <http://example.org/education/concept/Naturheilkunde> ;
    dcterms:title "(Bei Paracelsus und Galenus)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9rLb1qCFufH8 a edu:LearningResource ;
    dcterms:description "Das ER-Diagramm wird für ein Bibliothekssystem erstellt, das Bücher und Leser verwalten soll. Es werden die relevanten Entitäten und Beziehungen zwischen ihnen dargestellt, wie zum Beispiel die Zuordnung von Büchern zu Kategorien und die Ausleihe von Büchern durch Leser. Durch das Studium dieses ER-Diagramms können Lerner die Struktur und Organisation eines Bibliothekssystems verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9rLb1qCFufH8" ;
    dcterms:subject <http://example.org/education/concept/Bibliothekssysteme>,
        <http://example.org/education/concept/Bibliotheksverwaltung>,
        <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Dokumentenverwaltung>,
