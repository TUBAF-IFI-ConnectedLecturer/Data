        <http://example.org/education/concept/Sozialverhalten>,
        <http://example.org/education/concept/Vespula>,
        <http://example.org/education/concept/Wespen> ;
    dcterms:title "Biodiversität in Weinbergen: Tiere - Typische Tierarten"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

