oer:7gumeJOnOtoE a edu:LearningResource ;
    sim:similarTo oer:7zDkZJ_TUuGQ ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Die Komplexaufgabe behandelt die Einschleifung einer Ortsnetzstation am Rande einer Kleinstadt, um ein neues Siedlungsgebiet mit 280 Wohneinheiten zu versorgen. Die Aufgabenstellung umfasst die Wahl des Standorts der Ortsnetzstation, die Bemessungsleistung und die Einhaltung von Parametern wie Belastbarkeit der Leitungen und Spannungsbands im Mittelspannungsnetz. Durch die Lösung dieser Aufgaben können Studierende Kenntnisse über Netzberechnung und Schutztechnik erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7gumeJOnOtoE" ;
    dcterms:subject <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Energieversorgung>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Leitungsplanung>,
        <http://example.org/education/concept/Mittelspannung>,
        <http://example.org/education/concept/Netzberechnung>,
        <http://example.org/education/concept/Ortsnetzstation>,
        <http://example.org/education/concept/Schutztechnik>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Stromverteilung> ;
    dcterms:title "Komplexaufgabe 1"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7lS-_YyB2Q5Y a edu:LearningResource ;
    sim:similarTo oer:93gc9arAKwVo ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Die Übung behandelt die analytische Ermittlung symmetrischer Komponenten für verschiedene natürliche Dreiphasensysteme. Durch graphische Entsymmetrierung werden die Ergebnisse überprüft und Diagonalkomponenten, symmetrische Komponenten sowie natürliche Komponenten berechnet. Die Lösungen dieser Aufgaben dienen der Vertiefung des Verständnisses für Elektroenergieübertragung und -verteilung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7lS-_YyB2Q5Y" ;
    dcterms:subject <http://example.org/education/concept/Dreiphasensysteme>,
        <http://example.org/education/concept/Elektroenergieverteilung>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Energie%C3%BCbertragung>,
        <http://example.org/education/concept/Erdkurzschluss>,
        <http://example.org/education/concept/Erdschluss>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Kurzschluss>,
        <http://example.org/education/concept/Netzwerk.>,
        <http://example.org/education/concept/Symmetrische_Komponenten> ;
    dcterms:title "Übung 2: Symmetrische Komponenten"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7q7NarmzrPVI a edu:LearningResource ;
    sim:similarTo oer:7uXfnZ4SZlLM ;
    dcterms:creator <http://example.org/education/person/Teuscher> ;
    dcterms:description "Das Lernpaket behandelt die Berechnung von Ringnetzen und die Planung von MS-Netzen, einschließlich der Wahl der Spannungsebene, Leitungsart und des Leitungsquerschnitts. Es werden auch weitere Aspekte wie Netzschutz, Fernleittechnik und die Ort- und Bauweise von Schaltanlagen thematisiert. Durch das Lernpaket können Studierende Kenntnisse über die Planung und Berechnung von elektrischen Netzen erwerben."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "7q7NarmzrPVI" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Elektrotechnik>,
