        oer:9tx_ZwEDp02s ;
    dcterms:creator <http://example.org/education/person/Fricke> ;
    dcterms:description "Faserverbundwerkstoffe (FVK) sind Werkstoffe, die aus einer Kombination von Fasern und Matrix bestehen und durch ihre besonderen Eigenschaften wie hohe Festigkeit, Steifigkeit und geringes Gewicht in verschiedenen Anwendungen eingesetzt werden. Durch den Einsatz von FVK können Leichtbaukonstruktionen realisiert werden, die eine Reduzierung von Gewicht und Energieverbrauch ermöglichen. Die Verwendung von FVK erfordert jedoch eine sorgfältige Auswahl der Werkstoffe und eine geeignete Konstruktion, um die erforderlichen Eigenschaften zu erreichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "126nN3xryVQBg" ;
    dcterms:publisher <http://example.org/education/organization/Weimar> ;
    dcterms:subject <http://example.org/education/concept/Brandschutz>,
        <http://example.org/education/concept/Dauerfestigkeit>,
        <http://example.org/education/concept/Faserverbundwerkstoffe>,
        <http://example.org/education/concept/Festigkeit>,
        <http://example.org/education/concept/Leichtbau>,
        <http://example.org/education/concept/Recycling>,
        <http://example.org/education/concept/Steifigkeit>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Verarbeitungstechniken>,
        <http://example.org/education/concept/Werkstoffkennwerte> ;
    dcterms:title "2. Werkstoffe Bauw. 2.3. Faserverbundwerkstoffe"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

