    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8slKUw_s1ayw a edu:LearningResource ;
    dcterms:description "Das Kapitel behandelt den Arbeitsmarkt und die Faktoren, die das Angebot an Arbeitsplätzen beeinflussen, wie Institutionen, Politik und Mindestlohn. Es werden verschiedene Arten von Arbeitslosigkeit, wie zyklische, natürliche und friktionelle Arbeitslosigkeit, erläutert und die Auswirkungen auf den Arbeitsmarkt analysiert. Durch das Studium dieses Kapitels können Lernende ein Verständnis dafür entwickeln, wie der Arbeitsmarkt funktioniert und welche Faktoren die Beschäftigung beeinflussen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8slKUw_s1ayw" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Arbeits%C3%B6konomie>,
        <http://example.org/education/concept/Arbeitslosigkeit>,
        <http://example.org/education/concept/Arbeitsmarkt>,
        <http://example.org/education/concept/Besch%C3%A4ftigungspolitik>,
        <http://example.org/education/concept/Gewerkschaften>,
        <http://example.org/education/concept/Lohnpolitik>,
        <http://example.org/education/concept/Sozialpolitik>,
        <http://example.org/education/concept/Tarifverhandlungen>,
        <http://example.org/education/concept/Volkswirtschaftslehre>,
        <http://example.org/education/concept/Wirtschaftspolitik> ;
    dcterms:title "Kapitel 16. Arbeitsmarkt"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:8tjC_oxJC7NU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Lukas>,
        <http://example.org/education/person/Marcel>,
        <http://example.org/education/person/Mika_H.> ;
    dcterms:description "Die Präsentation behandelt die Oberschulen in Sachsen, insbesondere die Friedensschule Plauen, die Oberschule Georg Weerth und die Oberschule Chemnitz. Die Inhalte umfassen Informationen über die Geschichte, die Lage und die Angebote der einzelnen Schulen. Durch diese Präsentation können Lernende Kenntnisse über die sächsischen Oberschulen erwerben und einen Überblick über ihre Merkmale erhalten."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "8tjC_oxJC7NU" ;
    dcterms:subject <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Chemnitz>,
        <http://example.org/education/concept/Deutschland>,
        <http://example.org/education/concept/Friedensschule>,
        <http://example.org/education/concept/Georg_Weerth>,
        <http://example.org/education/concept/Oberschule>,
        <http://example.org/education/concept/Plauen>,
        <http://example.org/education/concept/Sachsen>,
        <http://example.org/education/concept/Schulen>,
        <http://example.org/education/concept/Sekundarstufe> ;
    dcterms:title "Oberschulen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8unzFStCIo48 a edu:LearningResource ;
    dcterms:description "Die interaktive App unterstützt Schülerinnen und Schüler bei der Zuordnung der Bücher des Alten und Neuen Testaments und festigt ihr Wissen über die Bibel. Durch die Anwendung können sie ihre Fähigkeiten im Umgang mit biblischen Textstellen verbessern und ihre Kenntnisse über die Bedeutung der Bibel für den christlichen Glauben erweitern. Die App eignet sich als spielerischer Einstieg in den Unterricht und kann in der Einstiegs- oder Festigungsphase eingesetzt werden."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "8unzFStCIo48" ;
    dcterms:subject <http://example.org/education/concept/Altes_Testament>,
        <http://example.org/education/concept/Bibel>,
        <http://example.org/education/concept/Biblische_B%C3%BCcher>,
        <http://example.org/education/concept/Christlicher_Glaube>,
        <http://example.org/education/concept/Evangelische_Religion>,
        <http://example.org/education/concept/Interaktive_Lernumgebung>,
        <http://example.org/education/concept/Neues_Testament>,
        <http://example.org/education/concept/Religi%C3%B6se_Bildung>,
        <http://example.org/education/concept/Religionsunterricht>,
        <http://example.org/education/concept/Unterrichtsmaterialien> ;
    dcterms:title "Interaktive App zu den Büchern des Alten und Neuen Testaments"@de ;
    dcterms:type <http://example.org/education/type/Materialhandreichung> .

oer:8v4tKPfoHqH0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Burchhardt>,
        <http://example.org/education/person/D%C3%BCbener> ;
    dcterms:description "Das Jeopardy-Spiel richtet sich an Schüler, die ein Video über Künstliche Intelligenz in der Medizin angesehen haben und soll ihr Wissen über das Thema testen und festigen. Durch das Spiel können sie ihre Kenntnisse zu OP-Robotern, Augmented Reality, DaVinci-Robotern und weiteren Themenbereichen erweitern und vertiefen. Am Ende des Spiels haben die Schüler ihr Wissen über Künstliche Intelligenz in der Medizin konsolidiert und können ihre Fähigkeiten im Bereich der medizinischen Forschung und Entwicklung bewerten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8v4tKPfoHqH0" ;
    dcterms:subject <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Computersimulation>,
        <http://example.org/education/concept/Frage-Antwort-Systeme>,
        <http://example.org/education/concept/Jeopardy-Spiel>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Medizin>,
        <http://example.org/education/concept/Robotik>,
        <http://example.org/education/concept/Spiele>,
        <http://example.org/education/concept/Teamarbeit> ;
    dcterms:title "Jeopardy - Künstliche Intelligenz in der Medizin"@de ;
    dcterms:type <http://example.org/education/type/Anleitung> .

oer:8xiFr7wbQYQs a edu:LearningResource ;
    dcterms:description "Eine Schleife ermöglicht die Wiederholung eines Programmstücks, bis eine bestimmte Bedingung erfüllt ist. Der Schleifenkörper wird solange wiederholt, wie die Schleifenbedingung gilt. Durch das Verständnis von Schleifen können Programmierer effizientere und flexiblere Programme erstellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8xiFr7wbQYQs" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
