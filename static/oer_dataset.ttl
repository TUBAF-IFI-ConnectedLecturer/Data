oer:5THVqZgYUWfc a edu:LearningResource ;
    sim:similarTo oer:5arkQfyeprCQ,
        oer:5fnUGvQXtLAg,
        oer:5tTdTOOQhz-s,
        oer:68Kg5x83fWRE,
        oer:6Mi5V0pSAALM,
        oer:6OIilpL4Y-AU,
        oer:6rNBc-JCeDPE,
        oer:6wEnW_xwgbrU,
        oer:8c-80cDbnMX8,
        oer:97xTegx0gHJk,
        oer:9JlQLxinK5Jc,
        oer:9Jsn9ZqTtCp0,
        oer:9ZbxarbRc8xs,
        oer:9o2uVOV3V5MY ;
    dcterms:creator <http://example.org/education/person/Fischer> ;
    dcterms:description "Dieses Material ermöglicht es Schülerinnen, die Sinusfunktion schrittweise selbst zu erarbeiten und die Einflüsse der Parameter a und b auf die Funktion zu beschreiben. Durch die dynamische Geometriesoftware GeoGebra können sie mittels eines Schiebereglers die Werte von den Parametern a und b verändern und direkt den Einfluss wahrnehmen. Die Schülerinnen können aus ihren Beobachtungen zum Einfluss der Parameter und ihrem Vorwissen eine Funktionsgleichung ableiten und ihre Methodenkompetenz schulen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5THVqZgYUWfc" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Einf%C3%BChrung>,
        <http://example.org/education/concept/Fachkompetenz>,
        <http://example.org/education/concept/Funktionale_Zusammenh%C3%A4nge>,
        <http://example.org/education/concept/GeoGebra>,
        <http://example.org/education/concept/Lernphase>,
        <http://example.org/education/concept/Mathematiksoftware>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Methodenkompetenz>,
        <http://example.org/education/concept/Selbstkompetenz>,
        <http://example.org/education/concept/Sinusfunktion> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5f2120dpWRzA a edu:LearningResource ;
    sim:similarTo oer:6SoThGOL0XtY,
        oer:6Uk3SuF9rzjM,
        oer:6Yln4mrFrqPw,
        oer:82wMUbbUVRKk,
        oer:8jcbbYQ_EqVg,
        oer:91zCnQXHW0H4,
        oer:981sj_8QUGLc,
        oer:9B3PPm3oiRf4,
        oer:9FBJbcDEGkbA,
        oer:9GnNlFIpzfmI,
        oer:9VxTJ5Pz1B-A,
        oer:9zjgA65FSAmg ;
    dcterms:description "Die Grundlagen des GIS umfassen die Triangulierung von Punkten, Linien und Flächen, wobei die Delaunay-Triangulation eine wichtige Rolle spielt, um eine winkelmaximale Triangulation zu erreichen. Durch die Berücksichtigung von Zusatzinformationen wie Constraints können spezielle Anforderungen erfüllt werden, wie beispielsweise die Erhaltung von Höhenlinien oder die Vermeidung von Störungen. Durch das Studium dieser Grundlagen können Lerner ein tiefes Verständnis der räumlichen Datenmodellierung und -analyse im GIS entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5f2120dpWRzA" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Delaunay-Triangulation>,
        <http://example.org/education/concept/GIS>,
        <http://example.org/education/concept/Geoinformatik>,
        <http://example.org/education/concept/Interpolation>,
        <http://example.org/education/concept/Kartographie>,
        <http://example.org/education/concept/Konvexe_H%C3%BClle>,
        <http://example.org/education/concept/Parkettierung>,
        <http://example.org/education/concept/Raumbezug>,
        <http://example.org/education/concept/Triangulierung>,
        <http://example.org/education/concept/Vermaschung> ;
    dcterms:title "Grundlagen GIS"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

