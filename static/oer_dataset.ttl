        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Leseverst%C3%A4ndnis>,
        <http://example.org/education/concept/Literaturdidaktik>,
        <http://example.org/education/concept/Romananalyse>,
        <http://example.org/education/concept/Schulbuch>,
        <http://example.org/education/concept/Unterrichtsmaterial> ;
    dcterms:title "Kurzbeschreibung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7oyHaThJILyk a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Bl%C3%BCthgen>,
        <http://example.org/education/person/K%C3%BChne> ;
    dcterms:description "Es wurden neuartige mehrlagige Schichtwerkstoffe mit dreidimensionalen textilen Verstärkungselementen entwickelt und deren Leistungsfähigkeit untersucht, um die Delamination von Composite in brettförmigen Sportgeräten zu minimieren. Die Ergebnisse zeigen, dass die Anzahl und Anordnung der Verstärkungselemente den größten Einfluss auf die Biegefestigkeit haben und eine gleichmäßige Tränkung der Laminate zu einer Steigerung des Biegeelastizitätsmoduls führt. Durch diese Forschung können Entwickler von Sportgeräten neue Werkstoffkonzepte für ihre Produkte entwickeln, um die Lebensdauer zu erhöhen und die Leistungsfähigkeit zu verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7oyHaThJILyk" ;
    dcterms:subject <http://example.org/education/concept/Armierung>,
        <http://example.org/education/concept/Biegefestigkeit>,
        <http://example.org/education/concept/Elastizit%C3%A4tsmodul>,
        <http://example.org/education/concept/Holzbau>,
        <http://example.org/education/concept/Holzwerkstoffe>,
        <http://example.org/education/concept/Laminierung>,
        <http://example.org/education/concept/Schichtwerkstoffe>,
        <http://example.org/education/concept/Sportger%C3%A4te>,
        <http://example.org/education/concept/Textilverst%C3%A4rkung>,
        <http://example.org/education/concept/Verbundwerkstoffe> ;
    dcterms:title "Mehrlagige holzbasierte Schichtwerkstoffe mit dreidimensionaler Armierung"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

