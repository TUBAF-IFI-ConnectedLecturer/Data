    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Strömungsprobleme der Mechanischen Verfahrenstechnik\" behandelt die Grundlagen des Fließverhaltens von Fluiden und deckt verschiedene Aspekte wie das Ostwald-de-Waele-Fließgesetz, Viskosität, Reynoldszahl und Strukturkinetik ab. Durch diese Vorlesung sollen Studierende ein Verständnis dafür entwickeln, wie Fluide unter verschiedenen Bedingungen fließen und wie ihre Eigenschaften beeinflusst werden können. Zudem werden Beispiele nicht-Newtonscher Fluide vorgestellt, um die Anwendung dieser Konzepte in der Praxis zu veranschaulichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10ZgVI0z2CtFA" ;
    dcterms:publisher <http://example.org/education/organization/Institut_F%C3%BCr_Verfahrenstechnik_Und_Umwelttechnik__Fakult%C3%A4t_Maschinenwesen> ;
    dcterms:subject <http://example.org/education/concept/Flie%C3%9Fverhalten>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Nicht-Newtonsche_Fluide>,
        <http://example.org/education/concept/Partikelstr%C3%B6mung>,
        <http://example.org/education/concept/Prozessindustrie>,
        <http://example.org/education/concept/Rheologie>,
        <http://example.org/education/concept/Str%C3%B6mungsmechanik>,
        <http://example.org/education/concept/Strukturviskosit%C3%A4t>,
        <http://example.org/education/concept/Viskoelastizit%C3%A4t>,
        <http://example.org/education/concept/Viskosit%C3%A4t> ;
    dcterms:title "Strömungsprobleme der Mechanischen Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

