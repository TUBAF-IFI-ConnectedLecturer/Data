oer:10IJVnAyvQLo4 a edu:LearningResource ;
    sim:similarTo oer:11JGsumU6znXU,
        oer:6SHFUua4DiKk,
        oer:6bxWLsVg26_Y,
        oer:8D3UPWaWODp4,
        oer:8fyJGPc55dRw ;
    dcterms:creator <http://example.org/education/person/Pietsch> ;
    dcterms:description "Die Vorlesung zum Sanierungsbergbau behandelt die Sicherung von Innenkippen und Tagebauen nach dem Ende der Bergaufsicht, wobei geotechnische Ereignisse wie Verflüssigungen und Geländeabsenkungen vermieden werden sollen. Durch die Anwendung von Technologien wie Schonender Sprengverdichtung, Fallgewichtsverdichtung und Seismischem, hydraulischen und geotechnischem Monitoringsystem können Instabilitätsbereiche erkannt und Sperrbereiche festgelegt werden. Die Lernenden erhalten Einblick in die notwendigen Maßnahmen zur Sicherung von Innenkippen und Tagebauen nach dem Ende der Bergaufsicht, um geotechnische Ereignisse zu vermeiden und die öffentliche Sicherheit zu gewährleisten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10IJVnAyvQLo4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Bergbau>,
        <http://example.org/education/concept/Gel%C3%A4ndeeinbruch>,
        <http://example.org/education/concept/Geotechnik>,
        <http://example.org/education/concept/Innenkippe>,
        <http://example.org/education/concept/Kippenfl%C3%A4che>,
        <http://example.org/education/concept/R%C3%BCtteldruckverdichtung>,
        <http://example.org/education/concept/Sanierungsbergbau>,
        <http://example.org/education/concept/Schonende_Sprengverdichtung>,
        <http://example.org/education/concept/Tagebau>,
        <http://example.org/education/concept/Verkippung> ;
    dcterms:title "Vorlesung Sanierungsbergbau Sommersemester 2023 TU Bergakademie Freiberg"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10J69XfthJX4s a edu:LearningResource ;
    sim:similarTo oer:10UyAw3rkKyjw,
        oer:4ik3f_fLbWQg,
        oer:7fbJ_JVHp_j0 ;
    dcterms:creator <http://example.org/education/person/Scheffel> ;
    dcterms:description "Die Vorlesung behandelt die Aufmerksamkeitsdefizit-Hyperaktivitätsstörung (ADHS) aus Sicht der differentiellen und Persönlichkeitspsychologie, indem sie biopsychologische Theorien, lerntheoretische und kognitive Erklärungsansätze sowie therapeutische Interventionen darstellt. Durch die Auseinandersetzung mit diesem Material können Lerner ein umfassendes Verständnis der ADHS entwickeln und ihre Kenntnisse über die neurobiologischen Grundlagen, Diagnosekriterien und Therapieoptionen erweitern. Zudem werden sie in die Lage versetzt, die Komplexität der ADHS zu erfassen und ihre Auswirkungen auf das Verhalten und die Entwicklung von Individuen zu verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10J69XfthJX4s" ;
    dcterms:subject <http://example.org/education/concept/Aufmerksamkeitsdefizit-Hyperaktivit%C3%A4tsst%C3%B6rung>,
        <http://example.org/education/concept/Biopsychologische_Theorien>,
        <http://example.org/education/concept/Diagnostik>,
        <http://example.org/education/concept/Differentielle_Psychologie>,
        <http://example.org/education/concept/Klinische_Psychologie>,
        <http://example.org/education/concept/Kognitive_Theorien>,
        <http://example.org/education/concept/Lernprozesse>,
        <http://example.org/education/concept/Neurobiologie>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitspsychologie>,
        <http://example.org/education/concept/Verhaltensauff%C3%A4lligkeiten> ;
    dcterms:title "S.PP 05 Anwendungsbereich Klinische Psychologie: ADHS Differentielle und Persönlichkeitspsychologie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10RfpgVvBbcAs a edu:LearningResource ;
