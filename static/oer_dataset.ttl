        <http://example.org/education/concept/Vertriebsmarkt>,
        <http://example.org/education/concept/Warengruppen>,
        <http://example.org/education/concept/Wochenbericht> ;
    dcterms:title "Elektro Fox Wochenumsatzbericht (in TEUR)"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:52bH6qth9OoA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Zitzelsberger> ;
    dcterms:description "Das Kapitel behandelt die Grundlagen und Betriebsgrößen von Einphasentransformatoren, einschließlich ihrer physikalischen Grundlagen, Bauformen und Ersatzschaltbilder. Durch das Studium dieses Materials können Lernende ein Verständnis dafür entwickeln, wie Einphasentransformatoren funktionieren und wie sie in der elektrischen Energietechnik eingesetzt werden. Die Inhalte umfassen die Ideale Spannungs-, Strom- und Impedanzübersetzung, Leerlaufverhalten und -verluste, Kurzschlussverhalten und -verluste sowie den Wirkungsgrad von Einphasentransformatoren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "52bH6qth9OoA" ;
    dcterms:publisher <http://example.org/education/organization/Lehrbriefe_der_Elektrotechnik_Grundlagen_der_elektr._Energietechnik_Einphasentransformatoren_Prof._Dr.-Ing._Johann_Zitzelsberger_Professorship_for_Electrical_Machines_and_Drives> ;
    dcterms:subject <http://example.org/education/concept/Einphasentransformatoren>,
        <http://example.org/education/concept/Elektroenergiesysteme>,
        <http://example.org/education/concept/Elektromagnetismus>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Energietechnik>,
        <http://example.org/education/concept/Impedanz%C3%BCbersetzung>,
        <http://example.org/education/concept/Induktivit%C3%A4t>,
        <http://example.org/education/concept/Spannungstransformation>,
        <http://example.org/education/concept/Stromtransformation>,
        <http://example.org/education/concept/Transformatoren> ;
    dcterms:title "Lehrbriefe der Elektrotechnik Grundlagen der elektr. Energietechnik Einphasentransformatoren"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:55SgkNbXM1-Y a edu:LearningResource ;
    sim:similarTo oer:5msBEerbleEg,
        oer:5riXRDlI2xGs ;
    dcterms:creator <http://example.org/education/person/Naumann> ;
    dcterms:description "Die vorliegenden Arbeiten befassen sich mit der Geschichte und Architektur von Schloss Übigau bei Dresden, insbesondere seiner Entwicklung als Naherholungsgebiet für die Städte Dresden und Radebeul. Die Studien umfassen Untersuchungen zur sächsischen Architektur der Spätgotik, Analysen und Vorschläge zur sozialistischen Umgestaltung sowie historische Spaziergänge durch die umliegenden Dörfer. Durch diese Arbeiten können Leser Einblicke in die Geschichte und Entwicklung von Schloss Übigau und seiner Umgebung gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "55SgkNbXM1-Y" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Architekturgeschichte>,
        <http://example.org/education/concept/Dresdner_Kultur>,
        <http://example.org/education/concept/Gartenbau>,
        <http://example.org/education/concept/Gartenkunst>,
        <http://example.org/education/concept/Landschaftsarchitektur>,
        <http://example.org/education/concept/Naherholungsgebiet>,
        <http://example.org/education/concept/Schloss_%C3%9Cbigau>,
        <http://example.org/education/concept/Sp%C3%A4tgotik>,
        <http://example.org/education/concept/Umgestaltung>,
        <http://example.org/education/concept/s%C3%A4chsische_Geschichte> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Diplomarbeiten> .

