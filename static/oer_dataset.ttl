        <http://example.org/education/concept/Servomotor>,
        <http://example.org/education/concept/Sonnenblume>,
        <http://example.org/education/concept/Steckbrett> ;
    dcterms:title "MicroPython Station 1 - Sonnenblume"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

