oer:5968XvfaT6A8 a edu:LearningResource ;
    dcterms:description "Das Material behandelt die Themen Bergmannszüge und die Arbeits- und Gefühlswelt von Bergmännern. Durch Interviews mit Exponaten des Bergmannszugs sollen die Lernenden Einblicke in die Geschichte und Tradition der Bergmannszüge sowie die tägliche Arbeit und Emotionen von Bergmännern gewinnen. Die Fragen im Material ermöglichen es den Lernenden, die Perspektive von Bergmännern einzunehmen und ihre Erfahrungen und Gefühle zu verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5968XvfaT6A8" ;
    dcterms:subject <http://example.org/education/concept/Arbeitswelt>,
        <http://example.org/education/concept/Bergbau>,
        <http://example.org/education/concept/Bergmann>,
        <http://example.org/education/concept/Berufsbildung>,
        <http://example.org/education/concept/Berufsorientierung>,
        <http://example.org/education/concept/Gef%C3%BChlswelt>,
        <http://example.org/education/concept/Geschichte_des_Bergbaus>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Tradition>,
        <http://example.org/education/concept/Unterrichtsmaterialien> ;
    dcterms:title "Ebene 1 Station Bergmannszug"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:59Rdehyw3e2E a edu:LearningResource ;
    dcterms:description "Dieses Arbeitsblatt behandelt die geometrischen Figuren Rechtecke und Quadrate, indem es Schülerinnen und Schülern hilft, diese zu erkennen, zu sortieren und zu zeichnen. Durch die Aufgaben werden Fähigkeiten wie das Erkennen von parallelen Seiten und das Verständnis für ebene Figuren gefördert. Am Ende des Arbeitsblattes können die Lernenden ein Beet mit rechtwinkligen Ecken zeichnen und dessen geometrische Eigenschaften beschreiben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "59Rdehyw3e2E" ;
    dcterms:subject <http://example.org/education/concept/Beetanlage>,
        <http://example.org/education/concept/Fl%C3%A4chen>,
        <http://example.org/education/concept/Gartenbau>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/L%C3%A4ngen>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Quadrate>,
        <http://example.org/education/concept/Rechtecke>,
        <http://example.org/education/concept/Seitenl%C3%A4nge>,
        <http://example.org/education/concept/ebene_Figuren> ;
    dcterms:title "Mathematik Klasse 2 Rechtecke und Quadrate"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:59ZerckTZyTc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Besser> ;
    dcterms:description "Die Relationen S und R werden hinsichtlich ihrer Eigenschaften wie Rechtstotalität und Linkseindeutigkeit untersucht. Es wird gezeigt, dass S rechtstotal ist und R linkseindeutig ist, wenn bestimmte Bedingungen erfüllt sind. Durch die Beweise dieser Aussagen können Lernende ein tieferes Verständnis der Relationen und ihrer Eigenschaften entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "59ZerckTZyTc" ;
    dcterms:subject <http://example.org/education/concept/Abstrakte_Algebra>,
        <http://example.org/education/concept/Algebraische_Strukturen>,
        <http://example.org/education/concept/Bin%C3%A4re_Relationen>,
        <http://example.org/education/concept/Komposition_von_Relationen>,
        <http://example.org/education/concept/Linkseindeutigkeit>,
        <http://example.org/education/concept/Logik>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mengelehre>,
        <http://example.org/education/concept/Rechtstotalit%C3%A4t>,
        <http://example.org/education/concept/Relationenalgebra> ;
    dcterms:title "Aufgabe 3.1"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

