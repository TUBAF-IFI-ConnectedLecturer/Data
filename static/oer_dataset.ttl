oer:10OHDZ2V09WqY a edu:LearningResource ;
    sim:similarTo oer:5MI3VZUvXNzE,
        oer:5ZIVOkn4Rdas ;
    dcterms:creator <http://example.org/education/person/D%C3%B6rrbecker> ;
    dcterms:description "Diese Aufgaben unterstützen das Verständnis von gleichmäßig beschleunigten Bewegungen im Physikunterricht. Durch die Lösung der beiden Aufgaben können Schülerinnen und Schüler ihre Fähigkeiten im Bereich der Beschleunigung, Geschwindigkeit und zurückgelegtem Weg verbessern. Die Aufgaben behandeln konkrete Szenarien wie das Beschleunigen eines Autos oder das Zusammentreffen von zwei Zügen auf einer Strecke."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10OHDZ2V09WqY" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Beschleunigung>,
        <http://example.org/education/concept/Bewegung>,
        <http://example.org/education/concept/Eisenbahn>,
        <http://example.org/education/concept/Fahrzeug>,
        <http://example.org/education/concept/Geschwindigkeit>,
        <http://example.org/education/concept/Mechanik>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Schullehrplan>,
        <http://example.org/education/concept/Verkehrsphysik>,
        <http://example.org/education/concept/Zugverkehr> ;
    dcterms:title "Gleichmäßig beschleunigte Bewegung - Aufgaben"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10PDUDt7R-_P4 a edu:LearningResource ;
    sim:similarTo oer:10yBD6mkOYla4,
        oer:4d3H8-fHLNZw ;
    dcterms:creator <http://example.org/education/person/Walter> ;
    dcterms:description "Diese Dokumentation beschreibt verschiedene Arten von Zahnprothesen und -brücken, einschließlich ihrer Konstruktion, Materialien und Kostenplanung. Durch das Studium dieser Informationen können Lernende Kenntnisse über die verschiedenen Möglichkeiten der zahnärztlichen Versorgung erwerben und die geeignete Behandlung für bestimmte Fälle auswählen. Die Dokumentation enthält detaillierte Angaben zu den Kosten und Festzuschüssen für verschiedene Arten von Zahnprothesen und -brücken."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10PDUDt7R-_P4" ;
    dcterms:subject <http://example.org/education/concept/Br%C3%BCcke>,
        <http://example.org/education/concept/Festzusch%C3%BCsse>,
        <http://example.org/education/concept/Interimprothese>,
        <http://example.org/education/concept/Keramikkrone>,
        <http://example.org/education/concept/Metallger%C3%BCst>,
        <http://example.org/education/concept/Prothetik>,
        <http://example.org/education/concept/Teilkrone>,
        <http://example.org/education/concept/Zahnersatz>,
        <http://example.org/education/concept/Zahnheilkunde>,
        <http://example.org/education/concept/Zahnimplantat> ;
    dcterms:title "Kein Titel gefunden."@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:10PLInOvB6fuQ a edu:LearningResource ;
    sim:similarTo oer:10XJM-mVPttC4,
        oer:10bB5TQM4Aqns,
        oer:4YZ_KqWqkjTo,
        oer:5HSyfuQPNum0 ;
    dcterms:description "Dieses Dokument behandelt die Eigenschaften des Hyperwürfels 𝑸𝒏, insbesondere die Anzahl seiner Ecken und Kanten, die Multimenge der Eckengrade sowie die Existenz von Eulerwegen und Hamiltonkreisen. Es werden auch die Bipartitheit und die chromatische Zahl von 𝑸𝒏 untersucht. Durch das Studium dieses Dokuments können Lerner die grundlegenden Konzepte der Graphentheorie und ihre Anwendung auf den Hyperwürfel verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10PLInOvB6fuQ" ;
    dcterms:subject <http://example.org/education/concept/Bin%C3%A4rzahl>,
        <http://example.org/education/concept/Bipartitheit>,
        <http://example.org/education/concept/Chromatische_Zahl>,
        <http://example.org/education/concept/Eulerweg>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Hamiltonkreis>,
        <http://example.org/education/concept/Hyperw%C3%BCrfel>,
        <http://example.org/education/concept/Kombinatorik>,
        <http://example.org/education/concept/Mathematik> ;
    dcterms:title "serie11 Aufg3 Hörrmann"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10U3ESqy2hIGQ a edu:LearningResource ;
    sim:similarTo oer:11oq5y7vG77CU,
        oer:8Vy--T0Sbb2I,
        oer:8g46BPeFY3hA,
        oer:8z88rRCCq6nk ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Emulsionen sind disperse Systeme, die in verschiedenen Industrien eingesetzt werden, wie z.B. in der Kosmetik, Lebensmittel- und Pharmazeutischen Industrie, und ihre Herstellung und Verarbeitung erfordert Kenntnisse über Prozessstufen und -modelle sowie stoffliche und grenzflächeneigenschaften. Durch das Studium dieser Materialien können Lernende die Grundlagen von Emulsionen, ihre Eigenschaften und Anwendungsmöglichkeiten verstehen und erfahren, wie sie hergestellt und verarbeitet werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10U3ESqy2hIGQ" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Dispersionstechnik>,
        <http://example.org/education/concept/Emulgatoren>,
        <http://example.org/education/concept/Emulsionen>,
        <http://example.org/education/concept/Grenzfl%C3%A4cheneigenschaften>,
        <http://example.org/education/concept/Kolloidchemie>,
        <http://example.org/education/concept/Mikrofluidik>,
        <http://example.org/education/concept/Phaseninversion>,
        <http://example.org/education/concept/Prozessmodellierung>,
        <http://example.org/education/concept/Stoffaustausch>,
        <http://example.org/education/concept/Ultraschall> ;
    dcterms:title "Emulsionen - Grundlagen und Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10Z41D83VpRO4 a edu:LearningResource ;
    sim:similarTo oer:3hCOfO0Q71Kk,
        oer:4GrQ0vSdyh6I,
        oer:4Xr1iW1p95Dc,
        oer:4vzD-3BBMOzs ;
    dcterms:creator <http://example.org/education/person/Walter> ;
    dcterms:description "Dieses Dokument behandelt die Abrechnung im Behandlungsfeld Prothetik und vermittelt Kenntnisse über das Festzuschusssystem für Zahnersatzleistungen durch Krankenkassen. Es bietet Beispiele und Einblicke in die Befundklassen 1, 2 und 5 sowie eine Tabelle der KZBV mit Übersicht über alle Festzuschüsse und möglichen Beträge. Durch die Bearbeitung des Ordners 6. Teil Zahnärztliche Abrechnung können Lerner ihre Prüfungsleistung gestalten."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "10Z41D83VpRO4" ;
    dcterms:subject <http://example.org/education/concept/Abrechnung>,
        <http://example.org/education/concept/BEMA>,
        <http://example.org/education/concept/Festzuschusssystem>,
        <http://example.org/education/concept/KZBV>,
        <http://example.org/education/concept/Krankenkassen>,
        <http://example.org/education/concept/Medizinische_Dokumentation>,
        <http://example.org/education/concept/Prothetik>,
        <http://example.org/education/concept/Zahn%C3%A4rztliche_Abrechnung>,
        <http://example.org/education/concept/Zahnersatz>,
        <http://example.org/education/concept/Zahngesundheit> ;
    dcterms:title "Ordner 6. Teil Zahnärztliche Abrechnung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10bB5TQM4Aqns a edu:LearningResource ;
    dcterms:description "Die Lösung der Teilaufgaben für die Kantengraphen von 𝑃4, 𝑃3, 𝐶4 und 𝐾4, 𝐾6 wird vorgestellt, wobei Eigenschaften wie Anzahl von Ecken und Kanten, Grad der Knoten, Existenz von Eulerwegen und Hamiltonkreisen sowie die chromatische Zahl untersucht werden. Durch das Studium dieser Lösungen können Lernende die graphentheoretischen Konzepte anhand von Beispielen vertiefen und ihre Fähigkeiten in der Analyse von Graphen verbessern. Die Aufgaben dienen der Vertiefung des Verständnisses von Kantengraphen und ihrer Eigenschaften."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10bB5TQM4Aqns" ;
    dcterms:subject <http://example.org/education/concept/Bipartite_Graphen>,
        <http://example.org/education/concept/Chromatische_Zahl>,
        <http://example.org/education/concept/Eulerweg>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Graphzeichnung>,
        <http://example.org/education/concept/Hamiltonkreis>,
        <http://example.org/education/concept/Kantengraphen>,
        <http://example.org/education/concept/Knotengrad>,
        <http://example.org/education/concept/Mathematische_Optimierung>,
        <http://example.org/education/concept/Vollst%C3%A4ndige_Graphen> ;
    dcterms:title "Serie 11 aufg6 Hörrmann b)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

