        <http://example.org/education/concept/Interdisziplin%C3%A4res_Lernen>,
        <http://example.org/education/concept/Lehr-Lern-Prozesse>,
        <http://example.org/education/concept/Lehren>,
        <http://example.org/education/concept/Lehrveranstaltungsplanung>,
        <http://example.org/education/concept/Unterrichtsplanung> ;
    dcterms:title "Lehrveranstaltungsplanung - Feinplanung"@de ;
    dcterms:type <http://example.org/education/type/Lehrveranstaltungsplanung> .

