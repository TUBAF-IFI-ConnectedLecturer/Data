    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von Schienenfahrzeugen und deckt Grundlagen wie Fahrwiderstandskräfte, Antriebskräfte und Leistungs- und Energiebedarf ab. Durch die Lektüre dieser Vorlesung können Studierende ein Verständnis der verschiedenen Aspekte der Fahrdynamik entwickeln, einschließlich der Vertikaldynamik, Querdynamik und Längsdynamik. Die Inhalte sind für das Verständnis des Traktionsvermögens und der Fahrzeugausscheidung von Bedeutung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3WWvHetWUj60" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Energieeffizienz>,
        <http://example.org/education/concept/Fahrzeugdynamik>,
        <http://example.org/education/concept/Fahrzeugsimulation>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Fahrdynamik der Schienenfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

