    dcterms:creator <http://example.org/education/person/H%C3%B6hne>,
        <http://example.org/education/person/Kempf>,
        <http://example.org/education/person/Mutschler> ;
    dcterms:description "Die Diskussion über den Bestandsaufbau im digitalen Zeitalter behandelt die Veränderungen in der Rolle von Bibliotheken und dem Handel bei der Bereitstellung wissenschaftlicher Informationen. Durch die digitale Transformation müssen Bibliotheken ihre Strategien anpassen, um weiterhin relevante Partner für die Wissenschaft zu bleiben. Die Experten diskutieren Möglichkeiten, wie Bibliotheken sich auf die neuen Herausforderungen einstellen und ihre Stärken nutzen können, um den Bestandsaufbau erfolgreich fortzuführen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7aEk02uM_2YM" ;
    dcterms:subject <http://example.org/education/concept/Bibliotheksbestand>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Digitalisierung>,
