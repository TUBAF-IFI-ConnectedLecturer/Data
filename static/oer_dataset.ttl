        <http://example.org/education/concept/Joint_Venture>,
        <http://example.org/education/concept/Konfliktmanagement>,
        <http://example.org/education/concept/Kulturunterschiede>,
        <http://example.org/education/concept/Verhandlungstechnik> ;
    dcterms:title "Situationsbeschreibung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

