    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung \"Fahrdynamik für Verkehrsingenieure\" behandelt die Grundlagen der Fahrdynamik von Schienen- und Straßenfahrzeugen, einschließlich Fahrwiderstandskräften, Antriebskräften und Traktionsvermögen. Durch diese Vorlesung erwerben Studierende Kenntnisse über die physikalischen Grundlagen des Fahrverhaltens von Fahrzeugen und können diese auf verschiedene Verkehrssysteme anwenden. Die Inhalte umfassen auch die Berechnung von Fahrzeiten, Energiebedarf und Leistungsanforderungen für unterschiedliche Fahrzeugtypen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5gQyopFTbD8I" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Eisenbahntechnik>,
        <http://example.org/education/concept/Fahrodynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/G%C3%BCterwagen>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Reisezugwagen>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Stra%C3%9Fenverkehr>,
        <http://example.org/education/concept/Verkehrsingenieurwesen> ;
    dcterms:title "Fahrdynamik für Verkehrsingenieure"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

