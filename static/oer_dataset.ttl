        <http://example.org/education/concept/Photolumineszenz>,
        <http://example.org/education/concept/Photonenergie>,
        <http://example.org/education/concept/Quantenpunkt>,
        <http://example.org/education/concept/Rekombination>,
        <http://example.org/education/concept/Solarzelle>,
        <http://example.org/education/concept/W%C3%A4rmeverluste> ;
    dcterms:title "Größenquantisierung Efros and Efros Sov. Phys. Semicond. 16 (1982) 772 Brus J. Chem. Phys. 79 (1983) 5566"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

