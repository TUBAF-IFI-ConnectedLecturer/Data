        <http://example.org/education/concept/Siedlungsstruktur>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Verkehr>,
        <http://example.org/education/concept/Verkehrsplanung>,
        <http://example.org/education/concept/Verkehrssysteme> ;
    dcterms:title "Erreichbarkeitsindikatoren und Verkehrsmittelwahl"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

