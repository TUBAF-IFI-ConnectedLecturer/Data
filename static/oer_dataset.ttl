    dcterms:description "Das Übungsblatt behandelt geometrische Konzepte und algebraische Methoden für die Lösung von Aufgaben in der Geometrie. Durch die Bearbeitung dieser Aufgaben erwerben Lerner Kenntnisse über Bézier-Darstellungen, Bernstein-Polynome und lineare Funktionen. Sie entwickeln Fähigkeiten im Umgang mit vektorwertigen Funktionen, Polynomfunktionen und kartesischen Koordinatensystemen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11FoToxzy7Zmw" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/B%C3%A9zier-Darstellung>,
        <http://example.org/education/concept/Bernstein-Polynome>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Kartesische_Koordinaten>,
        <http://example.org/education/concept/Linearkombination>,
        <http://example.org/education/concept/Linearunabh%C3%A4ngigkeit>,
        <http://example.org/education/concept/Mathematische_Analysis>,
        <http://example.org/education/concept/Polynomfunktionen>,
        <http://example.org/education/concept/Vektorrechnung> ;
    dcterms:title "Geometrie - Sommer 2025 Übungsblatt 5"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

