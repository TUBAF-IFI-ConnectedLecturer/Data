        <http://example.org/education/concept/Netzwerke>,
        <http://example.org/education/concept/Netzwerkprotokolle>,
        <http://example.org/education/concept/Paketvermittlung>,
        <http://example.org/education/concept/Routing>,
        <http://example.org/education/concept/TCPIP-Modell> ;
    dcterms:title "Praktikumsbericht Informatik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

