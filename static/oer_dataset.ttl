        <http://example.org/education/concept/HTTPS>,
        <http://example.org/education/concept/Netzwerksicherheit>,
        <http://example.org/education/concept/Passw%C3%B6rter>,
        <http://example.org/education/concept/Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Zertifikate>,
        <http://example.org/education/concept/Zweifaktor-Authentisierung> ;
    dcterms:title "Annahmen und Konzeptionelle Verbesserung einer Chat-Anwendung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

