    dcterms:creator <http://example.org/education/person/Brandt> ;
    dcterms:description "Die Vorlesung Didaktik der Geometrie behandelt die Grundlagen der geometrischen Formen und ihre Eigenschaften, wie zum Beispiel das Quadrat als besonderes Viereck mit rechten Winkeln und gleichlangen Seiten. Durch die Lektüre dieser Materialien können Lernende verschiedene Definitionen für spezielle Vierecke finden und Begriffe wie Symmetrie, Kongruenz und Ähnlichkeit verstehen. Zudem werden Übungsaktivitäten und Aufgaben angeboten, um das Verständnis der geometrischen Konzepte zu vertiefen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4YgX_8tAwhEQ" ;
    dcterms:subject <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Geometrische_Figuren>,
        <http://example.org/education/concept/Grundschuldidaktik>,
        <http://example.org/education/concept/Mathematikdidaktik>,
        <http://example.org/education/concept/Parallelogramm>,
        <http://example.org/education/concept/Quadrat>,
        <http://example.org/education/concept/Raute>,
        <http://example.org/education/concept/Rechteck>,
        <http://example.org/education/concept/Symmetrie>,
        <http://example.org/education/concept/Vierecke> ;
    dcterms:title "Didaktik der Geometrie - Vorlesung Basismodul LAGS-GSD-MA-VM2 Grundschuldidaktik Mathematik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:4_w6ZmsTcSmI a edu:LearningResource ;
    sim:similarTo oer:4eOIxJqW-QFA,
