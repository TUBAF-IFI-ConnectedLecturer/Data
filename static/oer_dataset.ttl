oer:1228ulWAVZSwA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Zech> ;
    dcterms:description "Die Menschheitsgeschichte wird von klimatischen Veränderungen und der Ausbreitung des Ackerbaus geprägt, was zu Umweltproblemen wie Bodenerosion und -degradation führt. Durch die Agrarindustrialisierung werden Ökosystem-Dienstleistungen beeinträchtigt und planetare Grenzen überschritten. Die Erkennung dieser Zusammenhänge ist entscheidend für den Umweltschutz und die nachhaltige Nutzung natürlicher Ressourcen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1228ulWAVZSwA" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kosystem>,
        <http://example.org/education/concept/Bev%C3%B6lkerungswachstum>,
        <http://example.org/education/concept/Bodenerosion>,
        <http://example.org/education/concept/Geoarch%C3%A4ologie.>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Landwirtschaft>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Naturschutz>,
        <http://example.org/education/concept/Pal%C3%A4oumweltforschung>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Physische Geographie mit SP Paläoumweltforschung Michael Zech 31. Mai 2021 Umweltringvorlesung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:122UUFCQIJCyo a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kowollik> ;
    dcterms:description "Dieses Lehrmaterial behandelt das Thema Masse und Einheiten im Bereich der Physik, wobei die Grundlagen von Kilogramm und Gramm erklärt werden. Durch Übungen und Aufgaben sollen die Lernenden die Umrechnung zwischen diesen Einheiten erlernen und verstehen, was Masse eigentlich ist. Am Ende des Moduls sollten die Lernenden in der Lage sein, Massenangaben in verschiedenen Einheiten zu lesen und umzurechnen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "122UUFCQIJCyo" ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Einheiten>,
        <http://example.org/education/concept/Lehr-Lern-Szenarien>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Masse>,
        <http://example.org/education/concept/Naturwissenschaften>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Umrechnung>,
        <http://example.org/education/concept/Unterrichtsmaterialien>,
        <http://example.org/education/concept/digitale_Medien> ;
    dcterms:title "Übersicht"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:123IRPnilc11o a edu:LearningResource ;
    dcterms:description "Die Studie untersucht individuelle Unterschiede im Entscheidungsverhalten bei der Iowa Gambling Task und wie sich kognitive Denkstile auf Entscheidungen unter Unsicherheit auswirken. Die Teilnehmenden bearbeiten einen Fragebogen zum kognitiven Denkstil und eine Entscheidungsaufgabe am Computer, um ihre Entscheidungen in Situationen mit Gewinnen und Verlusten zu analysieren. Durch die Studie können Einblicke in die Gestaltung von Entscheidungsumgebungen für verschiedene Persönlichkeitstypen gewonnen werden."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "123IRPnilc11o" ;
    dcterms:subject <http://example.org/education/concept/Belohnungssystem>,
        <http://example.org/education/concept/Entscheidungstheorie>,
        <http://example.org/education/concept/Entscheidungsverhalten>,
        <http://example.org/education/concept/Experimentelle_Forschung>,
        <http://example.org/education/concept/Impulskontrolle>,
        <http://example.org/education/concept/Iowa_Gambling_Task>,
        <http://example.org/education/concept/Kognitive_Psychologie>,
        <http://example.org/education/concept/Risikobewertung>,
        <http://example.org/education/concept/Verhaltensforschung>,
        <http://example.org/education/concept/Wissenschaftliche_Studie> ;
    dcterms:title "Datenschutz und Anonymität"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

