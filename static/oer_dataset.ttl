        <http://example.org/education/concept/Stressbew%C3%A4ltigung>,
        <http://example.org/education/concept/Studienberatung>,
        <http://example.org/education/concept/Studienstress>,
        <http://example.org/education/concept/Zeitmanagement> ;
    dcterms:title "Entspannter studieren"@de ;
