oer:60vFoK6T1sUI a edu:LearningResource ;
    dcterms:description "Die Zahlenfolgen Xn und Yn werden hinsichtlich ihrer Monotonie untersucht und es wird gezeigt, dass Xn ab n=2 eine monoton fallende und Yn ab n=2 eine monoton steigende Folge ist. Durch die Analyse der Zahlenfolgen können Lernende die Eigenschaften von monotonen Funktionen verstehen und anwenden. Die Untersuchung der Monotonie ermöglicht es, die Werte von Xn und Yn zu beschränken und ihre Verhaltensweise bei verschiedenen n-Werten zu erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "60vFoK6T1sUI" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Exponentialfunktionen>,
        <http://example.org/education/concept/Folgen>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Monotonie>,
        <http://example.org/education/concept/Reihen>,
        <http://example.org/education/concept/Zahlenfolgen>,
        <http://example.org/education/concept/Zahlentheorie>,
        <http://example.org/education/concept/mathematische_Analysis> ;
    dcterms:title "Nachbereitung 1 Zahlenfolgen (Xn) und (Yn)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:63IjcgMz85HY a edu:LearningResource ;
    dcterms:description "Dieses Lehrmaterial behandelt die Grundlagen von Medientypen und Multimedia, einschließlich der Kenntnis von Farbmodellen, Medienformaten und der Notwendigkeit von Konvertierung und Kompression. Durch das Studium dieses Materials erwerben Lernende Sach- und Methodenkompetenz im Umgang mit digitalen Bildaten und entwickeln ein Verständnis für die gesellschaftliche Bedeutung digitaler Medien. Zudem lernen sie, informatische Modelle auf Daten und Datenbanken anzuwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "63IjcgMz85HY" ;
    dcterms:subject <http://example.org/education/concept/Bildverarbeitung>,
        <http://example.org/education/concept/Datenbanken>,
