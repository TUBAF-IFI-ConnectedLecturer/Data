oer:5Swbx9IMbCqs a edu:LearningResource ;
    sim:similarTo oer:5TNx_EZfaTK4,
        oer:5riXRDlI2xGs ;
    dcterms:creator <http://example.org/education/person/Epple> ;
    dcterms:description "Die Schiffswerft Übigau in Dresden ist ein Kulturdenkmal von geschichtlicher Bedeutung, das aus zwei Fabrikgebäuden, einem Kesselhaus und Maschinenhaus sowie einem eisernen Drehkran besteht. Die Anlage war Teil eines bedeutenden Industrieunternehmens, das Schiffe, Dampfmaschinen und Schiffsmaschinen produzierte und im Zweiten Weltkrieg auch Segmente für U-Boote herstellte. Durch die Lektüre dieses Dokuments können Leser Einblick in die Baugeschichte, Ortsgeschichte und Technikgeschichte der Schiffswerft Übigau gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Swbx9IMbCqs" ;
    dcterms:subject <http://example.org/education/concept/Dampfmaschine>,
        <http://example.org/education/concept/Eisenbahn>,
        <http://example.org/education/concept/Industriebau>,
        <http://example.org/education/concept/Industriekultur>,
        <http://example.org/education/concept/Kessel>,
        <http://example.org/education/concept/Lokomotive>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Schiffswerft>,
        <http://example.org/education/concept/Technisches_Denkmal>,
        <http://example.org/education/concept/U-Boot> ;
    dcterms:title "Kulturdenkmale im Freistaat Sachsen"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:5TCdiMbiTTKs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Adolphi> ;
    dcterms:description "Durch die Teilnahme an den verschiedenen Workshops und Mitmachstationen können Lernende das Kunststoffrecycling praktisch erleben und verstehen, wie Kunststoffe produziert, recycelt und verarbeitet werden. Sie lernen, Kunststoffe zu erkennen und zu bestimmen, sowie die Voraussetzungen für ein Recycling zu verstehen. Durch die Selbstermächtigung und das Verständnis der chemischen Zusammenhänge können Lernende bewusstere Entscheidungen im Konsum treffen und sich für eine nachhaltigere Zukunft engagieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5TCdiMbiTTKs" ;
    dcterms:subject <http://example.org/education/concept/Abfallentsorgung>,
        <http://example.org/education/concept/Bildungsprogramme>,
        <http://example.org/education/concept/Chemische_Verbindungen>,
        <http://example.org/education/concept/Kunststoffeigenschaften>,
        <http://example.org/education/concept/Kunststoffrecycling>,
        <http://example.org/education/concept/Kunststoffverarbeitung>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Recyclingtechnik>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Werkstoffkunde> ;
    dcterms:title "Nachhaltige Kunststoffverarbeitung und Recycling"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:5TWnwwVMKdiM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Buchmann> ;
    dcterms:description "Die Kryptographie ist ein wichtiger Bestandteil der modernen Kommunikation, um die Vertraulichkeit und Integrität von Daten zu gewährleisten. Durch das Studium dieser Materialien können Lernende die Grundlagen der Kryptographie, wie symmetrische und asymmetrische Verschlüsselung, Hash-Funktionen und digitale Signaturen, verstehen und anwenden. Zudem werden sie mit verschiedenen Angriffsmethoden und Sicherheitskonzepten vertraut, um effektive Schutzmaßnahmen für die Datenübertragung zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5TWnwwVMKdiM" ;
    dcterms:subject <http://example.org/education/concept/Auditierbarkeit>,
        <http://example.org/education/concept/Authentisierung>,
        <http://example.org/education/concept/Datenverschl%C3%BCsselung>,
