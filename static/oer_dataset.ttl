        <http://example.org/education/concept/Piepsignal>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Ton-Erzeugung> ;
    dcterms:title "MicroPython Station 2 Einparkhilfe"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

