oer:12qVeXefBqlSc a edu:LearningResource ;
    sim:similarTo oer:3L5Jrqt7LRsg,
        oer:3LI8eknyWJv8,
        oer:3V4nUxzaOjAM,
        oer:3aHapSZ2DC7g,
        oer:3bUz5VjcE7Zw,
        oer:3dVanmUXfVac,
        oer:3i_LT0lozlPk,
        oer:3wnkfl7XzxUk,
        oer:57NQVGURiSVM,
        oer:5J7xTLHG-ql8,
        oer:5f2120dpWRzA ;
    dcterms:description "Die Triangulation einer Punktmenge ist nicht eindeutig und kann verschiedene Lösungen haben, die bestimmte Eigenschaften aufweisen. Durch die Verwendung von Delaunay-Triangulationen können winkel-maximale Triangulationen erzeugt werden, die in der GIS-Analyse eingesetzt werden können. Die Berücksichtigung von Zusatzinformationen wie bekannten Höhenlinien oder Störungen ermöglicht es, Constrained Delaunay-Triangulationen zu erstellen, die bestimmte Anforderungen erfüllen müssen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12qVeXefBqlSc" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Computational_Geometry>,
        <http://example.org/education/concept/GIS>,
        <http://example.org/education/concept/Geoinformatik>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Kartographie>,
        <http://example.org/education/concept/Netzwerkanalyse>,
        <http://example.org/education/concept/Raumbezug>,
        <http://example.org/education/concept/Triangulation>,
        <http://example.org/education/concept/Vermessung> ;
    dcterms:title "Grundlagen GIS"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:1752HEUNTyin8 a edu:LearningResource ;
    sim:similarTo oer:17QF-x71cskhM,
        oer:17w61p6P4HsTs,
        oer:17yOCO6tYUsww,
