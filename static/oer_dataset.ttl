oer:11AfJUlHxfnEU a edu:LearningResource ;
    sim:similarTo oer:11NXi8cVohdUE,
        oer:3c9rbHGQqYAo,
        oer:7IgSUHMVkjJI,
        oer:9wx8MYJu8q3I,
        oer:9y7bcapWznMc ;
    dcterms:creator <http://example.org/education/person/thun> ;
    dcterms:description "Die Leistungsbewertung im Unterricht wird als ein prozessorientierter Ansatz verstanden, der die Selbstständigkeit und Eigenverantwortung von Lernenden fördert. Durch verschiedene Formen der Leistungskontrolle, wie Kurzkontrollen, Klassenarbeiten und Lerntagebücher, sollen Lernende ihre Lernprozesse reflektieren und ihre Lernergebnisse einschätzen können. Ziel ist es, eine angstfreie Gesprächskultur zu etablieren, in der Lernende ihre Stärken und Schwächen erkennen und individuelle Lernstrategien entwickeln können."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "11AfJUlHxfnEU" ;
    dcterms:subject <http://example.org/education/concept/Bildungsziele>,
        <http://example.org/education/concept/Fremdbewertung>,
        <http://example.org/education/concept/Lehrer-Sch%C3%BCler-Beziehung>,
        <http://example.org/education/concept/Leistungsbewertung>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Lernprozess>,
        <http://example.org/education/concept/P%C3%A4dagogik>,
        <http://example.org/education/concept/Sch%C3%BClerleistung>,
        <http://example.org/education/concept/Selbstbewertung>,
        <http://example.org/education/concept/Unterricht> ;
    dcterms:title "Teilergebnisse auf dem Weg zum Erreichen der Lernziele bewerten"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:11KAm90ULj_Wg a edu:LearningResource ;
    sim:similarTo oer:11uDma6MAFSA0,
        oer:11zzK50tU8vcU,
        oer:12M5rJfBeeOIo,
        oer:12_ksUbny3I3o,
        oer:12ctt46ZJCG2g ;
    dcterms:creator <http://example.org/education/person/Hacker> ;
    dcterms:description "Die Entwicklung der Laufbahnhierarchie im Bibliothekswesen seit Anfang des 20. Jahrhunderts hat zu einer geschlechtspezifischen Personalstruktur geführt, bei der Frauen zunehmend in mittleren Dienstpositionen eingesetzt wurden. Durch die Einführung neuer Ausbildungswege und -ordnungen haben Frauen Zugang zu diesen Berufen erhalten, was das Image des Bibliothekarberufs als Frauenberuf geprägt hat. Die Auseinandersetzung mit dieser Entwicklung kann Einsichten in die Veränderungen der Arbeitsverteilung und die Zuweisung von Aufgabenbereichen an verschiedene Qualifikationsebenen bringen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11KAm90ULj_Wg" ;
    dcterms:subject <http://example.org/education/concept/Arbeitsorganisation>,
        <http://example.org/education/concept/Berufsstruktur>,
        <http://example.org/education/concept/Bibliothekare>,
        <http://example.org/education/concept/Bibliotheksmanagement>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Frauenberuf>,
        <http://example.org/education/concept/Geschlechterrolle>,
        <http://example.org/education/concept/Hierarchie>,
        <http://example.org/education/concept/Laufbahnentwicklung>,
        <http://example.org/education/concept/Personalwirtschaft> ;
    dcterms:title "Sitzung zur bibliographischen Katalogisierung und Indexierung"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

