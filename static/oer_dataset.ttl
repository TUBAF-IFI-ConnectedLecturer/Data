    dcterms:type <http://example.org/education/type/Skript> .

oer:3SStMVx5zlhg a edu:LearningResource ;
    sim:similarTo oer:9qgbTa6gx0ys ;
    dcterms:creator <http://example.org/education/person/Baumgarten> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Grundlagen von Datenbanken und Datenspeicherung, einschließlich der ACID-Eigenschaften, Entity-Relationship-Modellen und SQL-Anfragen. Durch das Studium dieses Materials können Lernende ein Verständnis dafür entwickeln, wie Daten in Datenbanken strukturiert und abgerufen werden können. Außerdem erfahren sie, wie sie eigene Datenbanken entwerfen und anlegen können, um bestimmte Anforderungen zu erfüllen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3SStMVx5zlhg" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/ACID-Eigenschaften>,
