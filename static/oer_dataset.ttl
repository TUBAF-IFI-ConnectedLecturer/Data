oer:9rqOI0eNsUoI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Lorenz> ;
    dcterms:description "Diese Hausaufgaben behandeln verschiedene mathematische Beweise und Aussagen zu linearen Algebra und Geometrie, insbesondere für Dreiecke und konvexe Vierecke. Durch die Lösung dieser Aufgaben können Lerner ihre Fähigkeiten im Bereich der mathematischen Beweisführung und Argumentation verbessern. Die Inhalte umfassen unter anderem die Zerlegung von Polygonen in Dreiecke, die Anzahl der entstehenden Dreiecke und die Summe der Innenwinkel in konvexen Vierecken."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9rqOI0eNsUoI" ;
    dcterms:subject <http://example.org/education/concept/Beweise>,
        <http://example.org/education/concept/Diagonalen>,
        <http://example.org/education/concept/Dreiecke>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Innenwinkel>,
        <http://example.org/education/concept/Konvexe_Polygone>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Polygonzahlen>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Hausaufgabe Lineare Algebra I"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9yzob-Y6vyGA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Altmann> ;
    dcterms:description "Die Hinweise zur Prüfung im Fach SVT beschreiben die zugelassenen und nicht zugelassenen Hilfsmittel, um eine faire und ordnungsgemäße Durchführung der Prüfung zu gewährleisten. Die Teilnehmer müssen sich an bestimmte Regeln halten, wie zum Beispiel das Verbot von elektronischen Geräten und das Schließen von Taschenrucksäcken. Durch die Beachtung dieser Hinweise können Studierende sicherstellen, dass sie ordnungsgemäß an der Prüfung teilnehmen und keine Regelverstöße begehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9yzob-Y6vyGA" ;
    dcterms:subject <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Elektronische_Ger%C3%A4te>,
        <http://example.org/education/concept/Hilfsmittel>,
        <http://example.org/education/concept/Hochschulpr%C3%BCfung>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Kommunikationstechnologie>,
        <http://example.org/education/concept/Pr%C3%BCfungsregeln>,
        <http://example.org/education/concept/Pr%C3%BCfungsverfahren>,
        <http://example.org/education/concept/Pr%C3%BCfungsvorbereitung>,
        <http://example.org/education/concept/akademische_Integrit%C3%A4t> ;
    dcterms:title "Hinweise zur Prüfung SVT"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

