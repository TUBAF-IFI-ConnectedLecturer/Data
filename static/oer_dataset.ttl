        <http://example.org/education/concept/Hydrogeologie>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Nachbergbauliche_Aufgaben>,
        <http://example.org/education/concept/Sanierung>,
        <http://example.org/education/concept/Seen>,
        <http://example.org/education/concept/Tagebau>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Wasserwirtschaft> ;
    dcterms:title "Vorlesung Sanierungsbergbau Sommersemester 2023 TU Bergakademie Freiberg"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

