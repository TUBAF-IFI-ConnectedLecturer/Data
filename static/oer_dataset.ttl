    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die Vorlesung behandelt die Fertigungstechnik im Wintersemester 2020/21 an der TU Bergakademie Freiberg und konzentriert sich auf das Trennen von Werkstücken durch Drehen, wobei die verschiedenen Schneidstoffe, ihre Eigenschaften und Anwendungen erläutert werden. Die Studierenden erfahren, wie die Auswahl der Werkzeugmaschinen nach wirtschaftlichen Gesichtspunkten erfolgt und welche Faktoren bei der Verschleißursache von Drehwerkzeugen eine Rolle spielen. Durch diese Vorlesung erhalten die Lernenden ein umfassendes Verständnis der Fertigungstechnik im Bereich des Drehens und können ihre Kenntnisse in der Praxis anwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12NP5xNQzEFLQ" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Diffusionsverschlei%C3%9F>,
        <http://example.org/education/concept/Drehen>,
        <http://example.org/education/concept/Fertigungstechnik>,
        <http://example.org/education/concept/Oxidationsverschlei%C3%9F>,
        <http://example.org/education/concept/Reibung>,
        <http://example.org/education/concept/Schneidstoffe>,
        <http://example.org/education/concept/Universaldrehmaschine>,
        <http://example.org/education/concept/Verschlei%C3%9Fursachen>,
        <http://example.org/education/concept/Werkzeugmaschinen>,
        <http://example.org/education/concept/Zerspanung> ;
    dcterms:title "FERTIGUNGSTECHNIK Wintersemester 2020/21"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

