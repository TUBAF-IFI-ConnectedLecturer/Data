        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Klassifikation>,
        <http://example.org/education/concept/Machine_Learning_Algorithmen>,
        <http://example.org/education/concept/Maschinelles_Lernen>,
        <http://example.org/education/concept/Mathematische_Optimierung>,
        <http://example.org/education/concept/Numerische_Verfahren>,
        <http://example.org/education/concept/Regression>,
        <http://example.org/education/concept/Statistik> ;
    dcterms:title "Experimentelle Prozessanalyse"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:43uNehP_uZec a edu:LearningResource ;
    sim:similarTo oer:466PISKEwDng,
        oer:6-OuQNqvr40E,
        oer:9LnXOs6zIBSA ;
    dcterms:creator <http://example.org/education/person/Hirsch> ;
    dcterms:description "Dieses Dokument behandelt die Berechnung und Nachweis von Trägern im Holzbau unter Berücksichtigung der Bruchmechanik und enthält Beispiele für die Überprüfung von Schubspannungen, Biegespannungen und Querzugspannungen. Durch das Studium dieses Dokuments können Lerner die notwendigen Berechnungen und Nachweise für den Holzbau erlernen und anwenden. Die Inhalte umfassen unter anderem die Anwendung von EC5-Regeln, die Verwendung von Bautabellen und die Überprüfung von Dübeln und Diagonalen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "43uNehP_uZec" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Bauingenieurwesen> ;
    dcterms:subject <http://example.org/education/concept/Biegespannungen>,
        <http://example.org/education/concept/Brettschichtholz>,
        <http://example.org/education/concept/Bruchmechanik>,
        <http://example.org/education/concept/Holzbau>,
        <http://example.org/education/concept/Ingenieurholzbau>,
        <http://example.org/education/concept/Querzugspannungen>,
        <http://example.org/education/concept/Satteldachtr%C3%A4ger>,
        <http://example.org/education/concept/Stahl-_und_Holzbau>,
        <http://example.org/education/concept/Tr%C3%A4gerkonstruktionen>,
        <http://example.org/education/concept/Zugspannungen> ;
    dcterms:title "Beleg im Fach Holzbau und Anwendung der Bruchmechanik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:47iFnpWswSsM a edu:LearningResource ;
    sim:similarTo oer:9JlQLxinK5Jc,
        oer:9bo-jic3k6pY,
        oer:9o2uVOV3V5MY ;
    dcterms:creator <http://example.org/education/person/K%C3%B6hler> ;
    dcterms:description "Das Denklehrzimmer als Idealtyp einer Lernwelt wird vorgestellt, das auf der Tradition Rousseaus basiert und eine systematische wie vergnügliche Bearbeitung von Lernzielen ermöglichen soll. Durch die Entwicklung eines medialen Zugangs zum Denklehrzimmer sollen Lerner zu selbstgesteuertem Lernen angeregt werden. Die Vorlesung behandelt die historischen Hintergründe, Zielstellungen und mediendidaktischen Ansätze des Denklehrzimmers als virtuelle Lernumgebung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "47iFnpWswSsM" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
