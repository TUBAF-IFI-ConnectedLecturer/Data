oer:102uQw2mtfpeE a edu:LearningResource ;
    sim:similarTo oer:10jBQl3FGhNRI,
        oer:10v2XNLy7MxWc ;
    dcterms:description "Das Praktikum LT2-2020-Online behandelt die Optimierung von Beleuchtungsanordnungen für Innenräume und Werkhallen unter Berücksichtigung der Norm EN 12464-1. Die Aufgaben umfassen die Berechnung von lichttechnischen Kenngrößen, wie Beleuchtungsstärke und harmonische Helligkeitsverteilung, sowie die Erstellung von Isoluxdiagrammen für verschiedene Leuchtentypen. Durch das Praktikum sollen die Lernenden Kenntnisse über die Planung und Optimierung von Beleuchtungsanlagen erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "102uQw2mtfpeE" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/B%C3%BCrobeleuchtung>,
        <http://example.org/education/concept/Beleuchtungsanordnung>,
        <http://example.org/education/concept/Beleuchtungsst%C3%A4rke>,
        <http://example.org/education/concept/Helligkeitsverteilung>,
        <http://example.org/education/concept/Innenbeleuchtung>,
        <http://example.org/education/concept/Lichtplanung>,
        <http://example.org/education/concept/Lichttechnik>,
        <http://example.org/education/concept/Normen_f%C3%BCr_die_Beleuchtung>,
        <http://example.org/education/concept/Raumbeleuchtung>,
        <http://example.org/education/concept/Werkhallenbeleuchtung> ;
    dcterms:title "Optimierung von Innenraumbeleuchtungsanlagen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:104Oiv1cMIoas a edu:LearningResource ;
    sim:similarTo oer:10mKrdrOcaU7g,
        oer:11YvoGi7P-eOg ;
    dcterms:description "Die Relation 𝑅 beschreibt eine Beziehung zwischen Teilmengen einer Menge 𝑀, bei der die beiden Teilmengen keine gemeinsamen Elemente haben. Die Komplementärrelation !𝑅 beinhaltet jedes Paar von Teilmengen von 𝑀, die mindestens ein Element gemeinsam haben. Durch das Studium dieser Relationen können Lernende Eigenschaften wie Irreflexivität, Transitivität und Symmetrie in Bezug auf Mengenbeziehungen verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "104Oiv1cMIoas" ;
    dcterms:subject <http://example.org/education/concept/Abstrakte_Algebra>,
        <http://example.org/education/concept/Irreflexivit%C3%A4t>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mengenbeziehungen>,
        <http://example.org/education/concept/Mengenlehre>,
        <http://example.org/education/concept/Reflexivit%C3%A4t>,
        <http://example.org/education/concept/Relationenalgebra>,
        <http://example.org/education/concept/Symmetrie>,
        <http://example.org/education/concept/Teilmengen>,
        <http://example.org/education/concept/Transitivit%C3%A4t> ;
    dcterms:title "Serie 8 Aufgabe 9 Hörrmann"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:106k0dGwb65WY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Brose> ;
    dcterms:description "Die Tabelle vergleicht die Wartungskosten von verschiedenen Reifenmarken pro 1000 Kilometer. Die Daten zeigen die Kosten je 1000 Kilometer, die Platzierung und den Gesamtwert für jeden Reifen. Durch das Studium dieser Tabelle können Lerner die kosteneffizientesten Reifen für ihre Bedürfnisse identifizieren."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "106k0dGwb65WY" ;
    dcterms:subject <http://example.org/education/concept/Fahrzeugausstattung>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Kostenanalyse>,
        <http://example.org/education/concept/Kraftfahrzeuge>,
        <http://example.org/education/concept/Laufleistung>,
        <http://example.org/education/concept/Reifen>,
        <http://example.org/education/concept/Reifentests>,
        <http://example.org/education/concept/Stra%C3%9Fenverkehr>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Wartungskosten> ;
    dcterms:title "Wartungskostenverteilung"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:107DYLum9ETR8 a edu:LearningResource ;
    sim:similarTo oer:12BJ3tzaW0hrQ,
        oer:12JCrID-wWlK4 ;
    dcterms:creator <http://example.org/education/person/Brose> ;
    dcterms:description "Dieses Dokument enthält eine Zusammenstellung von Daten und Berechnungen für verschiedene Feiertage und Ereignisse im Jahr 2019. Es bietet eine Übersicht über die Dauer zwischen bestimmten Terminen und ermöglicht die Berechnung von Zeitdifferenzen und Auslastungen. Durch das Studium dieses Dokuments können Lernende Kenntnisse über die Organisation von Arbeitszeiten und Feiertagen erwerben."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "107DYLum9ETR8" ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cberstunden>,
        <http://example.org/education/concept/Arbeitszeit>,
        <http://example.org/education/concept/Auslastung>,
        <http://example.org/education/concept/Betriebsstunden>,
        <http://example.org/education/concept/Datenformat>,
        <http://example.org/education/concept/Fehlstunden>,
        <http://example.org/education/concept/Feiertage>,
        <http://example.org/education/concept/Kalender>,
        <http://example.org/education/concept/Uhrzeit>,
        <http://example.org/education/concept/Zeitrechnung> ;
    dcterms:title "Einheit"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:109Ad1I4e2VuA a edu:LearningResource ;
    sim:similarTo oer:10LqSafzTkTYc,
        oer:10M9SXXj3GkDA ;
    dcterms:creator <http://example.org/education/person/Hirte> ;
    dcterms:description "Die endogene Wachstumstheorie untersucht die Rolle von wichtigen Treibern des Wachstums wie Wissen, Bildung, Forschung und Entwicklung, Innovation und Produktvielfalt, um zu verstehen, warum einige Regionen oder Länder wirtschaftlich erfolgreicher sind als andere. Durch das Verständnis dieser Faktoren können politische Maßnahmen entwickelt werden, um die wirtschaftliche Entwicklung von Regionen zu fördern und Konvergenz herzustellen. Die Kenntnis der endogenen Wachstumstheorie ermöglicht es, die Auswirkungen von Politik auf das Wachstum einer Ökonomie besser zu verstehen und geeignete Strategien für eine nachhaltige Entwicklung zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "109Ad1I4e2VuA" ;
    dcterms:publisher <http://example.org/education/organization/TUD> ;
    dcterms:subject <http://example.org/education/concept/Arbeitsproduktivit%C3%A4t>,
        <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Endogene_Wachstumstheorie>,
        <http://example.org/education/concept/Europ%C3%A4ische_Integration>,
        <http://example.org/education/concept/Forschung_und_Entwicklung>,
        <http://example.org/education/concept/Humankapital>,
        <http://example.org/education/concept/Innovation>,
        <http://example.org/education/concept/Regionale_Entwicklung>,
        <http://example.org/education/concept/Technologischer_Fortschritt>,
        <http://example.org/education/concept/Wirtschaftswachstum> ;
    dcterms:title "Technologie, Innovation und Humankapital (endogenes Wachstum)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

