        <http://example.org/education/concept/Zuverl%C3%A4ssigkeit>,
        <http://example.org/education/concept/Zuverl%C3%A4ssigkeitsanalyse> ;
    dcterms:title "Mathematik IV (für IF, ET, Ph) Sommersemester 2025"@de ;
