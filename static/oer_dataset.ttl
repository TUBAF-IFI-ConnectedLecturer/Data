        <http://example.org/education/concept/Zahnbehandlung>,
        <http://example.org/education/concept/Zahnersatz>,
        <http://example.org/education/concept/Zahnmedizin> ;
    dcterms:title "LEISTUNGEN AUßERHALB DER BEHANDLUNGEN"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:4VGq9soG9DgQ a edu:LearningResource ;
    sim:similarTo oer:4YgX_8tAwhEQ,
