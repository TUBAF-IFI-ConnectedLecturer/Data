oer:8KxD4v_QJXjY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Martin> ;
    dcterms:description "Die Vorlesung Wirtschaftsmathematik BIM 1 Finanzmathematik behandelt die Grundlagen der Finanzmathematik, einschließlich Prozentrechnung, einfacher und geometrischer Verzinsung sowie Wertpapieren. Durch das Studium dieser Materialien können Lernende den quantitativen Zusammenhang zwischen Kapitalbeträgen oder Zahlungsströmen zu verschiedenen Zeitpunkten verstehen und anwenden. Sie erwerben Kenntnisse über die Berechnung von Zinsen, Renten und Tilgungen sowie die Bewertung von Wertpapieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8KxD4v_QJXjY" ;
    dcterms:subject <http://example.org/education/concept/Finanzen>,
        <http://example.org/education/concept/Finanzmathematik>,
        <http://example.org/education/concept/Geldanlage>,
        <http://example.org/education/concept/Kapital>,
        <http://example.org/education/concept/Prozentrechnung>,
        <http://example.org/education/concept/Verzinsung>,
        <http://example.org/education/concept/Wertpapier>,
        <http://example.org/education/concept/Wirtschaftsmathematik>,
        <http://example.org/education/concept/Zinsrechnung>,
        <http://example.org/education/concept/Zinssatz> ;
    dcterms:title "Vorlesung Wirtschaftsmathematik BIM 1 Finanzmathematik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8M4qqa0rlXoA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Braun>,
        <http://example.org/education/person/Schulzrinne>,
        <http://example.org/education/person/W%C3%A4hlisch> ;
    dcterms:description "Das RFC et Protocol beschreibt das grundlegende Design und die Funktionen des et Protokolls (IP), das Computern ermöglicht, miteinander zu kommunizieren und Daten über Netzwerke zu übertragen. Es bietet eine zuverlässige Übertragung von Datenpaketen über das et, indem es jedem Paket eine Adresse zuweist und sicherstellt, dass es an den richtigen Ort gelangt. Durch die Lektüre dieses Dokuments können Lernende die Funktionsweise von Netzwerkprotokollen und die Bedeutung von IP-Adressierung, Fragmentierung und Routing-Tabellen verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8M4qqa0rlXoA" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Adressierung>,
        <http://example.org/education/concept/Daten%C3%BCbertragung>,
        <http://example.org/education/concept/Datenkommunikation>,
        <http://example.org/education/concept/Fragmentierung>,
        <http://example.org/education/concept/Internet_Protocol>,
        <http://example.org/education/concept/Netzwerkarchitektur>,
        <http://example.org/education/concept/Netzwerkkommunikation>,
        <http://example.org/education/concept/Netzwerkprotokolle>,
        <http://example.org/education/concept/Paketvermittlung>,
        <http://example.org/education/concept/Routing> ;
    dcterms:title "RFC ET PROTOCOL"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

