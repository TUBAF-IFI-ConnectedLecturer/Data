        <http://example.org/education/concept/Kunst>,
        <http://example.org/education/concept/Malerei>,
        <http://example.org/education/concept/Raumgestaltung> ;
    dcterms:title "ENTWURFSTAGEBUCH Gestaltungslehre I A - AD 170 A - LB 150 Wintersemester 202223"@de ;
