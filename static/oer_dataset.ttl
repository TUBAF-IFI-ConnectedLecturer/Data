        <http://example.org/education/concept/Sprachunterricht>,
        <http://example.org/education/concept/Wortarten> ;
    dcterms:title "Selbstlernpräsentation zu Wortarten"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

