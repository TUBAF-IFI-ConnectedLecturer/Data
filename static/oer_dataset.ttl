    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung Triebfahrzeugtechnik behandelt die Antriebskonfigurationen von Fahrzeugen, insbesondere die hydrostatische Leistungsübertragung und ihre Grundgleichungen. Durch das Studium dieser Materialien können Lernende die Funktionsweise und den Aufbau von hydrostatischen Antrieben verstehen und die relevanten Formeln und Kennwerte anwenden. Die Inhalte umfassen auch die Leistungsauslegung von Triebfahrzeugen, Dieselmotoren und andere Verbrennungskraftmaschinen sowie Hilfs- und Nebenbetriebe."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4TmyO_nDxht8" ;
    dcterms:subject <http://example.org/education/concept/Antriebskonfigurationen>,
        <http://example.org/education/concept/Dieselmotor>,
        <http://example.org/education/concept/Fahrzeuge>,
        <http://example.org/education/concept/Getriebe>,
        <http://example.org/education/concept/Hydraulik>,
        <http://example.org/education/concept/Hydrostatik>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Schr%C3%A4gachsenmaschine>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Triebwagen> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

