        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Volksparks> ;
    dcterms:title "Volksparks als Volkspark"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:3NXLrxMUPodM a edu:LearningResource ;
    dcterms:description "Diese Norm beschreibt die Anforderungen und Ausführungen von Höhenbolzen für die Festlegung von Höhenfestpunkten an Bauwerken, gewachsenem Stein oder besonders gegründeten Vermessungspfeilern. Die Höhenbolzen müssen bestimmte Maße und Eigenschaften aufweisen, wie zum Beispiel eine senkrechte Bohrung von 1,5 mm Durchmesser zur Aufnahme eines Markierungsstiftes. Die Norm behandelt auch die verschiedenen Werkstoffe, die für die Herstellung von Höhenbolzen verwendet werden können, einschließlich Stahl, Aluminiumlegierung und Temperguß."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3NXLrxMUPodM" ;
    dcterms:publisher <http://example.org/education/organization/Berufsakademie_Sachsen_Staatliche_Studienakademie_Glauchau> ;
    dcterms:subject <http://example.org/education/concept/Bauwerke>,
        <http://example.org/education/concept/Feinmechanik>,
        <http://example.org/education/concept/Festpunkte>,
        <http://example.org/education/concept/Geod%C3%A4sie>,
        <http://example.org/education/concept/H%C3%B6henmessung>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Korrosionsschutz>,
        <http://example.org/education/concept/Metallwerkstoffe>,
        <http://example.org/education/concept/Normen_und_Standards>,
        <http://example.org/education/concept/Vermessungstechnik> ;
    dcterms:title "Höhenbolzen DIN 18708"@de ;
    dcterms:type <http://example.org/education/type/Norm> .

