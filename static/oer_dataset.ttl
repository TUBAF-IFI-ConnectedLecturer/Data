        <http://example.org/education/concept/Signal%C3%BCbertragung>,
        <http://example.org/education/concept/Simulation_von_Netzwerken> ;
    dcterms:title "Das et als Netzwerk entdecken"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

