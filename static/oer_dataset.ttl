    dcterms:creator <http://example.org/education/person/Carter>,
        <http://example.org/education/person/Johnson>,
        <http://example.org/education/person/Lee> ;
    dcterms:description "Die Geschichte der Computerentwicklung wird von den Anfängen des Transistors bis hin zu ersten Personal Computern und Spielkonsolen nachgezeichnet. Der Text behandelt die wichtigen Meilensteine, wie die Erfindung des Transistors, die Entwicklung des ersten Computers ENIAC und die Gründung von Unternehmen wie Fairchild, Intel und Atari. Durch das Lesen dieses Dokuments können Lerner einen Überblick über die Geschichte der Computerentwicklung und die wichtigsten Akteure in diesem Bereich gewinnen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "13CvVdCAZFjpg" ;
    dcterms:subject <http://example.org/education/concept/Atari>,
        <http://example.org/education/concept/Computerentwicklung>,
