        <http://example.org/education/concept/Statik>,
        <http://example.org/education/concept/Torsion>,
        <http://example.org/education/concept/Tragwerke> ;
    dcterms:title "AG Betriebsfestigkeit Technische Universitat Dresden Technische Mechanik I - Vorlesung WiSe 201920"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

