        oer:9J4jFKGi5NT8,
        oer:9_uF1SOzsZso ;
    dcterms:description "Die Fourier-Reihe kann für gerade und ungerade Funktionen berechnet werden, wobei die Koeffizienten bk und ak jeweils bestimmte Werte annehmen. Durch Abbruch der Reihe nach endlich vielen Gliedern erhält man eine n-te Naherung der Funktion. Diese Methode ermöglicht es, periodische Funktionen in ihre einzelnen Frequenzkomponenten zu zerlegen und somit ihre Eigenschaften besser zu verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10cie_Ca8iu-8" ;
    dcterms:subject <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Fourier-Reihe>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Integralrechnung>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Naherungsverfahren>,
        <http://example.org/education/concept/Periodische_Funktionen>,
        <http://example.org/education/concept/Signalverarbeitung>,
        <http://example.org/education/concept/mathematische_Analyse>,
        <http://example.org/education/concept/trigonometrische_Reihen> ;
    dcterms:title "Fourier-Reihen – Praktische Berechnung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:10lmDIqgrz-6E a edu:LearningResource ;
    sim:similarTo oer:118C0X_M41s9w,
        oer:12WdIrHT7lPxc,
        oer:16D8qje6LR1QM,
        oer:16apl5AgKohaA,
        oer:1gnG44_FmP1E,
