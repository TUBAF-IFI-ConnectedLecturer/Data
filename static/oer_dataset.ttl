    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Hilfs- und Nebenbetriebe von Triebfahrzeugen, einschließlich der Kühlanlage, Heizungsanlage, Drucklufterzeugung, Stromversorgung und Energiebereitstellung. Durch das Studium dieser Inhalte können Lernende die Funktionen und Anforderungen dieser Systeme verstehen und wissen, wie sie bei der Auslegung von Triebfahrzeugen berücksichtigt werden müssen. Die Vorlesung bietet eine umfassende Übersicht über die verschiedenen Komponenten und Parameter, die bei der Entwicklung und dem Betrieb von Triebfahrzeugen zu beachten sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "46zKmzpp5m44" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Energiewirtschaft>,
        <http://example.org/education/concept/Fahrzeugbau.>,
        <http://example.org/education/concept/K%C3%BChlanlagen>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Str%C3%B6mungsmechanik>,
        <http://example.org/education/concept/Thermodynamik>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/W%C3%A4rme%C3%BCbertragung> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen) Professur für Technik spurgeführter Fahrzeuge Dr.-Ing. Martin Kache Sommersemester 2021"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

