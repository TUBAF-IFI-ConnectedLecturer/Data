        <http://example.org/education/concept/Prozesseinheiten>,
        <http://example.org/education/concept/Prozessleittechnik>,
        <http://example.org/education/concept/Separationstechnik>,
        <http://example.org/education/concept/Stoffumwandlung>,
        <http://example.org/education/concept/Thermodynamik>,
        <http://example.org/education/concept/W%C3%A4rme%C3%BCbertragung> ;
    dcterms:title "ÜBUNG 1 AUFGABE - GLEICHUNGSORIENTIERTES LÖSUNGSVERFAHREN"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3M3Qcj1aAozs a edu:LearningResource ;
    sim:similarTo oer:3RvVWy58U5N8,
