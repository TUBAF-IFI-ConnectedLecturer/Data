        <http://example.org/education/concept/Korrosionsschutz>,
        <http://example.org/education/concept/Metallbau>,
        <http://example.org/education/concept/Metalle> ;
    dcterms:title "Gebäudehülle Fassaden aus Metall"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

