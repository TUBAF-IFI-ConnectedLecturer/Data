    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Berechnung von Zugkräften und Fahrwiderständen bei der Beförderung von Zügen mit verschiedenen Geschwindigkeiten und Lasten. Durch das Studium dieser Inhalte können Lernende die notwendigen Kenntnisse erwerben, um die Leistungsfähigkeit von Zügen zu berechnen und die erforderlichen Antriebsleistungen für eine sichere und effiziente Beförderung zu bestimmen. Die Beispiele und Aufgaben im Lehrmaterial helfen den Lernenden, ihre Fähigkeiten in der Anwendung von Formeln und Berechnungen zu verbessern und ihre Kenntnisse über die Physik der Zugbewegung zu vertiefen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3fa7-eC-DbZU" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Elektrische_Bahnen> ;
    dcterms:subject <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Eisenbahnverkehr>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Elektrotraktion>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Fahrwiderstand>,
        <http://example.org/education/concept/Lokomotiventechnik>,
        <http://example.org/education/concept/Schienenfahrzeugtechnik>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Übungskomplex Eisenbahnfahren"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

