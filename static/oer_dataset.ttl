oer:5CeTpXXFggN0 a edu:LearningResource ;
    sim:similarTo oer:5GQQc2PRcTJM,
        oer:5XiK31gzxdjs,
        oer:5hf1K0JVwXBk ;
    dcterms:creator <http://example.org/education/person/Buchmann> ;
    dcterms:description "Die Sicherheit von Kommunikation und Authentifizierung im Internet wird durch verschiedene Angriffe und Schwachstellen bedroht, wie zum Beispiel Man-in-the-Middle-Angriffe, Page-in-the-Middle-Angriffe und Schadcode auf Webseiten. Um diese Bedrohungen zu bekämpfen, werden Verfahren wie asymmetrische Verschlüsselung, digitale Zertifikate und Authentifizierungsprotokolle wie Kerberos eingesetzt. Durch das Verständnis dieser Konzepte können Lerner die Sicherheit ihrer Online-Kommunikation verbessern und sich vor Angriffen schützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5CeTpXXFggN0" ;
    dcterms:subject <http://example.org/education/concept/Authentifizierung>,
        <http://example.org/education/concept/Browser-Angriffe>,
        <http://example.org/education/concept/IT-Sicherheit>,
        <http://example.org/education/concept/Kommunikationssicherheit>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Man-in-the-Middle-Angriffe>,
        <http://example.org/education/concept/Netzwerksicherheit>,
