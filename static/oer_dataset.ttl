    dcterms:creator <http://example.org/education/person/D%C3%B6ring>,
        <http://example.org/education/person/G%C3%B6ring> ;
    dcterms:description "Das Lehrmaterial behandelt die Bedeutung digitaler Medien im Bildungskontext und vermittelt Lehrenden und Lernenden Kompetenzen für den sinnvollen Einsatz von Digitaltechnologien im Unterricht. Durch die Auseinandersetzung mit diesem Material können Teilnehmer ein umfassendes Verständnis der digitalen Welt entwickeln, reflektierte Praxis anwenden und ihre berufliche Kommunikation und Zusammenarbeit verbessern. Zudem werden sie in die Lage versetzt, Medien kritisch zu analysieren und bewerten, sowie ihre eigenen Fähigkeiten im Umgang mit Digitalmedien zu erweitern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "11CO5ixl_15HI" ;
    dcterms:subject <http://example.org/education/concept/Berufliche_Kommunikation>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Blended_Learning>,
