        <http://example.org/education/concept/Netzwerkarchitektur>,
        <http://example.org/education/concept/Netzwerke>,
        <http://example.org/education/concept/Netzwerkverwaltung>,
        <http://example.org/education/concept/Rechnernetze> ;
    dcterms:title "Kurzvorstellung Filius"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

