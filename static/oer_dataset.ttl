    dcterms:title "Lernbereichsplanung für 9. Klasse Lernbereich 2: Künstliche Intelligenz"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10QoFaZMknz6o a edu:LearningResource ;
