        <http://example.org/education/concept/Raum>,
        <http://example.org/education/concept/Vektoren>,
        <http://example.org/education/concept/affine_Abbildungen>,
        <http://example.org/education/concept/lineare_Algebra> ;
    dcterms:title "Geometrie - Sommer 2021"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

