    dcterms:title "Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7GZA6M9GLliU a edu:LearningResource ;
    sim:similarTo oer:7Hdwm6j0_UBs,
        oer:8394JVb2Sy_E,
        oer:8D_aAB-c5ok0,
        oer:8c-80cDbnMX8 ;
    dcterms:description "Die Rasterkonvertierung ist ein Verfahren zur Überführung von Vektorgrafiken in Pixelgrafiken, bei dem Bildpunkte berechnet und eingefärbt werden, um geometrische Objekte auf einem Monitor darzustellen. Durch die Anwendung des Antialiasing-Verfahrens können unerwünschte Aliasing-Effekte minimiert werden, indem die Farbintensität von Pixeln in Abhängigkeit von der Überdeckung durch eine Ideallinie berechnet wird. Durch das Verständnis dieser Konzepte können Lerner die Grundlagen der digitalen Bildverarbeitung und -darstellung erlernen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7GZA6M9GLliU" ;
    dcterms:subject <http://example.org/education/concept/Algorithmus>,
        <http://example.org/education/concept/Antialiasing>,
        <http://example.org/education/concept/Bildverarbeitung>,
        <http://example.org/education/concept/Computergrafik>,
        <http://example.org/education/concept/Digitale_Medien>,
        <http://example.org/education/concept/Grafikdesign>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Pixelgrafik>,
        <http://example.org/education/concept/Rasterkonvertierung>,
        <http://example.org/education/concept/Vektorgrafik> ;
    dcterms:title "Universität Leipzig Fakultät für Mathematik und Informatik Professur für Didaktik der Informatik Praktikumsbericht zum Fachpraktikum Informatik"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%BCfungsarbeit> .

