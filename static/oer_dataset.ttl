        <http://example.org/education/concept/Polymerisation>,
        <http://example.org/education/concept/Reaktionskinetik> ;
    dcterms:title "Physikalische Chemie"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:5rWGcggNHt30 a edu:LearningResource ;
    sim:similarTo oer:6pyf44GCfAf8 ;
    dcterms:creator <http://example.org/education/person/Achtziger>,
        <http://example.org/education/person/K%C3%B6stner>,
        <http://example.org/education/person/Richert> ;
    dcterms:description "Die BIODIVina-Bildungsmodule behandeln die Bedeutung der Biodiversität bei der Anpassung des Weinbaus an den Klimawandel und bieten Einblicke in die verschiedenen Ebenen der Biodiversität, von Genen über Ökosysteme bis hin zu Landschaften. Durch das Studium dieser Module können Lernende die Komplexität der Biodiversität in Weinbergslandschaften verstehen und die Bedeutung von Ökosystemdienstleistungen für den Menschen erkennen. Zudem werden sie über die Agrobiodiversität und ihre Einflüsse auf die Vielfalt in Agrarökosystemen informiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5rWGcggNHt30" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologie>,
        <http://example.org/education/concept/%C3%96kosystemdienstleistungen>,
        <http://example.org/education/concept/Agrobiodiversit%C3%A4t>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
