oer:5Bnw8SjTp_Ag a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/H%C3%A4nicke>,
        <http://example.org/education/person/Hadamzick> ;
    dcterms:description "Das Wainwright Building in St. Louis, Missouri, ist ein Beispiel für die Anwendung von Tragwerkskonstruktionen nach den Ideen von William Le Baron Jenney und dem Architekturstil der Chicagoer Schule. Die Tragstruktur besteht aus einem Eisenskelett mit Stützenraster, Unterzügen und einer vorgehängten Fassade ohne tragende Eigenschaften. Durch die Analyse dieses Gebäudes können Studierende das Prinzip der Lastverteilung auf die Unterzüge und Stützen verstehen und die Bedeutung von Tragwerksplanung in der Architektur erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Bnw8SjTp_Ag" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Architektur>,
        <http://example.org/education/concept/Chicagoer_Schule>,
        <http://example.org/education/concept/Fassadengestaltung>,
        <http://example.org/education/concept/Geb%C3%A4udeentwurf>,
        <http://example.org/education/concept/Hochhaus>,
        <http://example.org/education/concept/Ingenieurbau>,
        <http://example.org/education/concept/St%C3%BCtzenraster>,
        <http://example.org/education/concept/Stahlbau>,
        <http://example.org/education/concept/Tragstruktur>,
        <http://example.org/education/concept/Tragwerksplanung> ;
    dcterms:title "Teilbeleg zum zweiten Hauptentwurf"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

