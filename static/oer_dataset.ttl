        <http://example.org/education/concept/Medienkultur.>,
        <http://example.org/education/concept/Musiksoziologie>,
        <http://example.org/education/concept/Narrationsstrukturanalyse>,
        <http://example.org/education/concept/Wandlungsprozesse>,
        <http://example.org/education/concept/dokumentarische_Interpretation>,
        <http://example.org/education/concept/qualitative_Sozialforschung> ;
    dcterms:title "Die dokumentarische Methode in der Bildungsforschung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

