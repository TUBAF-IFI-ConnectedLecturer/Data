        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Programmierkonzepte>,
        <http://example.org/education/concept/Programmiersprache_Java>,
        <http://example.org/education/concept/Schulische_Bildung>,
        <http://example.org/education/concept/Spielebasiertes_Lernen> ;
    dcterms:title "Lehramt Informatik (Gy, MS, BS, FS) Modul Didaktik der Informatik - E-Learning und Tools Nutzungsanleitung ---- Java-Kara ----"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

