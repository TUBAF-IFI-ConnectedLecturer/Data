oer:9rvvaBPXMeZo a edu:LearningResource ;
    sim:similarTo oer:9t9FXA2mA6Js,
        oer:9vFHc0VyLaC4,
        oer:9wGaieWzAOd0,
        oer:9xEOKMBLiQXI ;
    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von Schienenfahrzeugen wird durch die Wechselwirkung zwischen Rad und Schiene bestimmt, wobei der Kraftschluss eine entscheidende Rolle spielt. Durch die Auslegung des Fahrzeugs und die Wahl des Antriebskonfigurations kann die Kraftschlussausnutzung optimiert werden, um eine effiziente und sichere Fahrt zu gewährleisten. Die Kenntnis der Einflussfaktoren auf den Kraftschluss und die Auswirkungen auf die Fahrzeugdynamik sind für die Entwicklung und den Einsatz von Schienenfahrzeugen von großer Bedeutung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9rvvaBPXMeZo" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Elektrische_Bahnen> ;
