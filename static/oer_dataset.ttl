        <http://example.org/education/concept/Elementare_Algebra>,
        <http://example.org/education/concept/Grundschulmathematik>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mathematische_%C3%9Cbungsaufgaben>,
        <http://example.org/education/concept/Rest>,
        <http://example.org/education/concept/Teilung>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Schülerpräsentation Teilen mit Rest Start!"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

oer:12_sAOoLqadMA a edu:LearningResource ;
    dcterms:description "Das interaktive Tafelbild thematisiert die Organe der Europäischen Union und ihre Zusammensetzung, um Schülerinnen und Schülern die Wiederholung und Festigung dieses Themas zu ermöglichen und es auf das Problem des Demokratiedefizits in der EU anzuwenden. Durch die Bearbeitung können SuS den Aufbau und die Zusammensetzung der Organe der EU sicher wiedergeben und mit aktuellen Themen in Verbindung bringen. Am Ende des Tafelbildes sollen SuS in einer Anwendungsaufgabe das Problem eines möglichen Demokratiedefizits in den Organen der EU bewerten."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "12_sAOoLqadMA" ;
    dcterms:subject <http://example.org/education/concept/Demokratiedefizit>,
        <http://example.org/education/concept/Entscheidungsprozesse>,
        <http://example.org/education/concept/Europ%C3%A4ische_Union>,
        <http://example.org/education/concept/Herausforderungen_f%C3%BCr_Europa>,
        <http://example.org/education/concept/Intransparenz>,
        <http://example.org/education/concept/Lobbyismus>,
        <http://example.org/education/concept/digitale_Medien>,
        <http://example.org/education/concept/globale_Welt>,
        <http://example.org/education/concept/politische_Bildung>,
        <http://example.org/education/concept/politische_Institutionen> ;
    dcterms:title "Interaktives Tafelbild zum Thema Organe der Europäischen Union"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

