    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik für Verkehrsingenieure behandelt die Grundlagen der Fahrzeugbewegung und -leistung im Schienenverkehr, einschließlich der Berechnung von Energiebedarf und Fahrzeiten. Durch das Studium dieser Inhalte können Lernende die physikalischen Gesetzmäßigkeiten und mathematischen Modelle verstehen, die den Betrieb von Eisenbahnfahrzeugen beschreiben. Die Anwendung dieser Kenntnisse ermöglicht es, effiziente und energiesparende Fahrpläne zu erstellen und die Leistungsfähigkeit von Schienenfahrzeugen zu optimieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7-41qmOQrfqQ" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
