    dcterms:subject <http://example.org/education/concept/Authentizit%C3%A4t>,
        <http://example.org/education/concept/Datensicherheit>,
        <http://example.org/education/concept/Informationssicherheit>,
        <http://example.org/education/concept/Integrit%C3%A4t>,
        <http://example.org/education/concept/Kryptoanalyse>,
        <http://example.org/education/concept/Kryptologie>,
        <http://example.org/education/concept/Schl%C3%BCsselaustausch>,
        <http://example.org/education/concept/Steganografie>,
        <http://example.org/education/concept/Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Vertraulichkeit> ;
    dcterms:title "Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:16kgdFX_Wtypg a edu:LearningResource ;
    sim:similarTo oer:16pOukccnOAgk,
        oer:16rLcbAFyNRC8,
