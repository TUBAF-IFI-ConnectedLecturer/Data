    dcterms:creator <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Stephan> ;
    dcterms:description "Die Vorlesung Triebfahrzeugtechnik behandelt die Antriebskonfigurationen von Fahrzeugen und ihre Auswirkungen auf den Energiebedarf von Zugfahrten. Durch das Studium dieser Materialien können Lernende die verschiedenen Betriebsregime, Wirkungsgrade und Einflussfaktoren auf den Energiebedarf verstehen und Antriebskonfigurationen für verschiedene Fahrzeugtypen entwickeln. Die Inhalte umfassen Leistungsübertragungsanlagen, Energiebedarf von Zugfahrten, Betriebsregime und Wirkungsgrade von Antriebsträngen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3DPsjuAVo8aA" ;
    dcterms:publisher <http://example.org/education/organization/FRIEDRICH_LIST> ;
    dcterms:subject <http://example.org/education/concept/Antriebskonfigurationen>,
        <http://example.org/education/concept/Betriebsregime>,
        <http://example.org/education/concept/Elektrische_Bahnen>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Fahrstil>,
        <http://example.org/education/concept/Hilfsenergiebedarf>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Wirkungsgrade>,
        <http://example.org/education/concept/Zugfahrten> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

