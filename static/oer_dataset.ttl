oer:5EGUN-GHMg-w a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/D%C3%B6rffel>,
        <http://example.org/education/person/Dietrich>,
        <http://example.org/education/person/Fritzsche> ;
    dcterms:description "Das Lernspiel \"Emil Eichhörnchen auf Rettungsmission\" führt Spieler ab elf Jahren durch die Schichten eines naturnahen Mischwaldes und vermittelt spielerisch Wissen über die Beziehungen zwischen Pflanzen, Tieren und Pilzen. Durch das Spiel sollen Kinder ein Verständnis dafür entwickeln, wie sie in ihrer Umwelt leben und welche Bedeutung der Wald als Lebensgemeinschaft hat. Das Lernspiel basiert auf den Lerninhalten des Lehrplans für Gymnasien im Fach Biologie und deckt die Lernbereiche 4, 5 und 6 ab."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5EGUN-GHMg-w" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Biologieunterricht>,
        <http://example.org/education/concept/Informatikdidaktik>,
        <http://example.org/education/concept/Lernen_mit_Computerspielen>,
        <http://example.org/education/concept/Lernspiel>,
        <http://example.org/education/concept/Mediendidaktik>,
        <http://example.org/education/concept/Psychologie>,
        <http://example.org/education/concept/Spieleentwicklung>,
        <http://example.org/education/concept/Unity-Engine>,
        <http://example.org/education/concept/Wald%C3%B6kologie> ;
    dcterms:title "Erklärung Im Rahmen der Lehrveranstaltung Medienpsychologie und Mediendidaktik haben wir im Sommersemester 2019 das folgende Lernspiel erstellt:"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:5ERthNBAKg0Y a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Meschede> ;
    dcterms:description "Der Hallwachs-Versuch wird beschrieben, bei dem eine geladene Zinkplatte mit UV-Licht bestrahlt wird und die Auswirkungen auf ein Elektroskop untersucht werden. Durch die Durchführung des Versuchs können Lernende die Wirkung von UV-Licht auf elektrisch geladene Oberflächen erkennen und Hypothesen über die Beobachtungen aufstellen. Der Versuch soll das Verständnis der Elektrizität und der Lichtwirkung fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5ERthNBAKg0Y" ;
    dcterms:subject <http://example.org/education/concept/Elektrizit%C3%A4t>,
        <http://example.org/education/concept/Elektromagnetismus>,
        <http://example.org/education/concept/Experimente>,
        <http://example.org/education/concept/Metallplatten>,
        <http://example.org/education/concept/Optische_Eigenschaften>,
        <http://example.org/education/concept/Photoeffekt>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Physikalische_Ph%C3%A4nomene>,
        <http://example.org/education/concept/Reibungselektrizit%C3%A4t>,
        <http://example.org/education/concept/Ultraviolettstrahlung> ;
    dcterms:title "Hallwachs-Versuch 1888"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

