        <http://example.org/education/concept/Interpolation>,
        <http://example.org/education/concept/Konditionierung>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/MATLAB>,
        <http://example.org/education/concept/Numerische_Mathematik>,
        <http://example.org/education/concept/Softwareentwicklung> ;
    dcterms:title "Einführung in Numerische Mathematik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

