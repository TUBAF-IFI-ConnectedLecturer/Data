oer:4SamE3lDHy7U a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Delakowitz>,
        <http://example.org/education/person/Sch%C3%B6n> ;
    dcterms:description "Das Energierecht regelt die Energieversorgung mit Strom und Gas und umfasst Gesetze wie das Energiewirtschaftsgesetz und das Erneuerbare-Energien-Gesetz (EEG), die den Ausbau erneuerbarer Energien fördern. Durch die Lektüre dieses Dokuments können Lerner die wichtigsten Regelungsgegenstände des EEG-2017, wie Eigennutzer, Kleiner PV-Anlagen und Härtefallregelungen für stromintensive Unternehmen, verstehen und ihre Kenntnisse über das Energierecht erweitern. Zudem erhalten sie Einblick in die Entwicklung der EEG-Umlage, die Besondere Ausgleichsregelung und die EU-Emissionshandelssysteme."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4SamE3lDHy7U" ;
    dcterms:subject <http://example.org/education/concept/EEG-Umlage.>,
        <http://example.org/education/concept/EU-Emissionsrechte>,
        <http://example.org/education/concept/Emissionshandel>,
        <http://example.org/education/concept/Energieeffizienz>,
        <http://example.org/education/concept/Energierecht>,
        <http://example.org/education/concept/Energiewirtschaft>,
        <http://example.org/education/concept/Erneuerbare_Energien>,
        <http://example.org/education/concept/Klimaschutz>,
        <http://example.org/education/concept/Stromerzeugung>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Handlungspflichten Energierecht"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:4WDkP79dlKBc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Ke%C3%9Fler> ;
    dcterms:description "Das Informationsmanagement wird in drei Teile untergliedert: Strategisches Planung, Taktisches und Systemplanung sowie Operatives Betrieb, Nutzung und Wartung des IMS. Durch die Zusammenarbeit dieser Abteilungen werden Probleme wie langsames Verhalten eines Informationssystems identifiziert und gelöst. Der Rahmenplan spielt eine zentrale Rolle bei der Planung und Umsetzung von Projekten im Informationsmanagement."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "4WDkP79dlKBc" ;
    dcterms:subject <http://example.org/education/concept/Betrieb_und_Wartung>,
        <http://example.org/education/concept/Fehlerbehebung>,
        <http://example.org/education/concept/Helpdesk>,
        <http://example.org/education/concept/Informationsmanagement>,
        <http://example.org/education/concept/Informationssysteme>,
        <http://example.org/education/concept/Projektplanung>,
        <http://example.org/education/concept/Strategische_Planung>,
        <http://example.org/education/concept/Systemplanung>,
        <http://example.org/education/concept/Taktische_Planung>,
        <http://example.org/education/concept/Unternehmens-Management> ;
    dcterms:title "Hausaufgabe 1"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:4WVUeHw7jBZI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/F%C3%B6lling>,
        <http://example.org/education/person/Schwichteh%C3%B6vel> ;
    dcterms:description "Die Lernaufgabe \"Der Klarspüler in der Spülmaschine\" ermöglicht es Schülerinnen und Schülern, die Neutralisation am Beispiel des Spülvorgangs an einer Spülmaschine zu beschreiben und zu erklären, wie Säuren und Laugen sich verhalten, wenn sie gemischt werden. Durch die Bearbeitung dieser Aufgabe lernen sie, ein Experiment zu planen, durchzuführen und zu reflektieren, um die Funktion des Klarspülers und des Geschirrreinigers zu verstehen. Am Ende können sie ein Hinweiszettel erstellen, der die Funktionen beider Substanzen beschreibt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4WVUeHw7jBZI" ;
    dcterms:subject <http://example.org/education/concept/Basismodelle_des_Lernens>,
        <http://example.org/education/concept/Chemieunterricht>,
        <http://example.org/education/concept/Eigenerfahrung>,
        <http://example.org/education/concept/Experimentelle_Chemie>,
        <http://example.org/education/concept/Geschirrreinigung>,
        <http://example.org/education/concept/Klarsp%C3%BCler>,
        <http://example.org/education/concept/Lernprozesse>,
        <http://example.org/education/concept/Neutralisation>,
        <http://example.org/education/concept/S%C3%A4uren_und_Laugen>,
        <http://example.org/education/concept/Sp%C3%BClmaschinen> ;
    dcterms:title "Der Klarspüler in der Spülmaschine  Lernen durch Eigenerfahrung Chemie SI"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:4WahUdSaHpKI a edu:LearningResource ;
    dcterms:description "Die Sprache und weitere Einstellungen wie Privatsphäre, Energiesparmodus und Mitteilungen beeinflussen das Verhalten von Chat, Gruppen, System und Konto. Durch die Anpassung dieser Einstellungen können Benutzer ihr Nutzungserlebnis anpassen und die Funktionen der App optimieren. Die Kenntnis dieser Einstellungen ermöglicht es den Nutzern, ihre App-Erfahrung zu personalisieren und sicherer zu machen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4WahUdSaHpKI" ;
    dcterms:subject <http://example.org/education/concept/Anwendungssoftware>,
        <http://example.org/education/concept/Benachrichtigungssysteme>,
        <http://example.org/education/concept/Benutzeroberfl%C3%A4che>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Energiesparen>,
        <http://example.org/education/concept/Kommunikationstechnologie>,
        <http://example.org/education/concept/Kontaktverwaltung>,
        <http://example.org/education/concept/Mensch-Computer-Interaktion>,
        <http://example.org/education/concept/Mobilfunknetzwerke>,
        <http://example.org/education/concept/Systemkonfiguration> ;
    dcterms:title "Sprache und Einstellungen"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

