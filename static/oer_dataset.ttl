    dcterms:type <http://example.org/education/type/Skript> .

oer:7F9KVXMxpMXk a edu:LearningResource ;
    sim:similarTo oer:9BDND88Y2yQA ;
    dcterms:description "Quaternionen werden als mathematische Objekte vorgestellt, die sich durch Addition und Multiplikation verarbeiten lassen. Die Rechenoperationen werden explizit definiert, um Quaternionen zu addieren und zu multiplizieren. Durch das Verständnis dieser Operationen können Lernende Quaternionen effektiv in verschiedenen Anwendungen einsetzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7F9KVXMxpMXk" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
