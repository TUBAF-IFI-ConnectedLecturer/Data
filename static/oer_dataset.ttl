    dcterms:creator <http://example.org/education/person/Dorenburg> ;
    dcterms:description "Das Material führt Lernende durch ein fiktives Szenario zu den Verfahren des überwachten, unüberwachten und verstärkenden Lernens und ermöglicht es ihnen, ausgewählte Verfahren des maschinellen Lernens kennenzulernen. Durch die Arbeit mit dem Material können Lernende ihre Fähigkeiten in der Problemlösung und Bewertung verbessern. Das Material eignet sich für den Einsatz in Gruppen- oder Stationsarbeiten im Informatikunterricht an Gymnasien ab Klasse 9."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10Jq5ugZNVZaE" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
