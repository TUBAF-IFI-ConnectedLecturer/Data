oer:4XqF74yv38yA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Moritz> ;
    dcterms:description "Die Theorie des Systems der zentralen Orte beschreibt die Ordnung von Siedlungen im Raum und die Kräfte, die diese Ordnung bewirken. Durch die Anwendung dieser Theorie können Standorte in eine Hierarchie eingeordnet werden, wobei Ober-, Mittel-, Unter- und Kleinzentren unterschieden werden. Die Kenntnis dieser Theorie ermöglicht ein besseres Verständnis der räumlichen Wirtschaftsstruktur und die Entwicklung umfassenderer Theorien zur Standortstruktur."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4XqF74yv38yA" ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomische_Geographie>,
        <http://example.org/education/concept/Bev%C3%B6lkerungsgeographie>,
        <http://example.org/education/concept/Raumordnung>,
        <http://example.org/education/concept/Regionalplanung>,
        <http://example.org/education/concept/Siedlungsstruktur>,
        <http://example.org/education/concept/Stadtentwicklung>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Verkehrsinfrastruktur>,
        <http://example.org/education/concept/Verkehrssystem>,
        <http://example.org/education/concept/Zentralit%C3%A4t> ;
    dcterms:title "Theorie des System der zentralen Orte"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

