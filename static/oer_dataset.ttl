        oer:6xB6V0b_FnqU ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung behandelt die Grenzflächenphänomene und vermittelt grundlegende Kenntnisse über die Oberflächenspannung und Grenzflächenspannung zwischen Flüssigkeiten. Es werden verschiedene Messmethoden vorgestellt, wie zum Beispiel die Tropfenvolumenmethode, die Blasendruckmethode und die Kapillardruckmethode, um die Grenzflächenspannung zu bestimmen. Durch das Studium dieser Vorlesung können Lernende ein Verständnis der physikalischen Grundlagen von Grenzflächenphänomenen und ihrer Messmethoden erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10447sy9tAYvE" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen_Institut_f%C3%BCr_Verfahrenstechnik_und_Umwelttechnik> ;
    dcterms:subject <http://example.org/education/concept/Dispersionseigenschaften>,
        <http://example.org/education/concept/Fl%C3%BCssigkeiten>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenph%C3%A4nomene>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenspannung>,
        <http://example.org/education/concept/Kolloidchemie>,
        <http://example.org/education/concept/Oberfl%C3%A4chenspannung>,
        <http://example.org/education/concept/Phasengrenzen>,
        <http://example.org/education/concept/Physikalische_Chemie>,
        <http://example.org/education/concept/Rheologie>,
        <http://example.org/education/concept/Tensiometrie> ;
    dcterms:title "Grenzflächenphänomene"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

