oer:111bxY3ItDwbM a edu:LearningResource ;
    sim:similarTo oer:11CP5JR2hmwvg ;
    dcterms:creator <http://example.org/education/person/schramm97> ;
    dcterms:description "Das Kahoot-Quiz behandelt die Themen Stoffmenge, molare Masse und molares Volumen und besteht aus 10 Fragen mit zunehmendem Schwierigkeitsgrad. Durch das Quiz sollen Schüler Zusammenhänge zwischen den Begriffen herstellen und Anwendungen des gelernten Stoffes ermöglichen. Am Ende des Quizzes können Schüler ihre Kenntnisse über die drei Begriffe überprüfen und ihre Fähigkeit zum selbstständigen Denken verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "111bxY3ItDwbM" ;
    dcterms:subject <http://example.org/education/concept/Anforderungsbereich>,
        <http://example.org/education/concept/Chemieunterricht>,
        <http://example.org/education/concept/Chemische_Reaktionen>,
        <http://example.org/education/concept/Lehrmittel>,
        <http://example.org/education/concept/Lernzielkontrolle>,
        <http://example.org/education/concept/Molare_Masse>,
        <http://example.org/education/concept/Molares_Volumen>,
        <http://example.org/education/concept/Online-Quiz>,
        <http://example.org/education/concept/Selbstst%C3%A4ndiges_Denken>,
        <http://example.org/education/concept/Stoffmenge> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:111guI-Geqxm4 a edu:LearningResource ;
    sim:similarTo oer:12vt3qHjbyhpo ;
    dcterms:creator <http://example.org/education/person/Spallek> ;
    dcterms:description "Die Nutzung von Parallelität innerhalb der CPU wird erläutert, um die Leistungsfähigkeit der Verarbeitung zu erhöhen. Es werden verschiedene Ebenen der Parallelität vorgestellt, wie Bit-, Wort- und Befehlsebene, sowie Techniken wie Pipelining, Superskalar-Pipelining und Multithreading. Durch das Verständnis dieser Konzepte können Lernende die Leistung von Prozessoren optimieren und die Ausführung von Anwendungen beschleunigen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "111guI-Geqxm4" ;
    dcterms:subject <http://example.org/education/concept/Befehlspipelining>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Multithreading>,
        <http://example.org/education/concept/Parallelverarbeitung>,
        <http://example.org/education/concept/Prozessor-Hardware>,
        <http://example.org/education/concept/Rechnerarchitektur>,
        <http://example.org/education/concept/Rechnerstrukturen>,
        <http://example.org/education/concept/Simultaneous_Multithreading>,
        <http://example.org/education/concept/Superskalar-Pipelining>,
        <http://example.org/education/concept/Technische_Informatik> ;
    dcterms:title "Nutzung von Parallelität"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:112CtAK4fXWHo a edu:LearningResource ;
    sim:similarTo oer:4NxvWMWEW--w ;
    dcterms:creator <http://example.org/education/person/Hoffmann> ;
    dcterms:description "Die Studierenden lernen, Quellen auf Wissenschaftlichkeit zu prüfen und zwischen Primär- und Sekundärliteratur zu unterscheiden. Sie erfahren, wie sie die Kriterien zur Quellenprüfung anwenden und welche Funktionen die Quellenverwaltungssoftware Zotero bietet. Durch die Aufgaben und Übungen können die Studierenden ihre Fähigkeiten im wissenschaftlichen Arbeiten und Recherchieren verbessern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "112CtAK4fXWHo" ;
    dcterms:subject <http://example.org/education/concept/Bibliothekskatalog>,
        <http://example.org/education/concept/Geowissenschaften>,
        <http://example.org/education/concept/Informationskompetenz>,
        <http://example.org/education/concept/Literaturtypen>,
        <http://example.org/education/concept/Prim%C3%A4rliteratur>,
        <http://example.org/education/concept/Quellenverwaltung>,
        <http://example.org/education/concept/Sekund%C3%A4rliteratur>,
        <http://example.org/education/concept/Wissenschaftliche_Recherche>,
        <http://example.org/education/concept/Wissenschaftliches_Arbeiten>,
        <http://example.org/education/concept/Zotero> ;
    dcterms:title "Tutorium Wissenschaftliches Arbeiten in den Geowissenschaften"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

