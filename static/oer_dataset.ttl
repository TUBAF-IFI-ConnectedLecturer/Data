        <http://example.org/education/concept/Planeten>,
        <http://example.org/education/concept/Raumfahrt>,
        <http://example.org/education/concept/Schwerkraft>,
        <http://example.org/education/concept/Wissenschaftliche_Bildung> ;
    dcterms:title "Keine Titelangabe gefunden."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9LmUMEMfreMg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Th%C3%BCmmler> ;
    dcterms:description "Die Übung behandelt die Kartographie und historische Karten, insbesondere das Kartenforum und das Virtuelle Kartenforum 2.0. Durch die Bearbeitung der Aufgaben können Studierende Kenntnisse über die Geschichte und Entwicklung von Karten erwerben sowie Erfahrungen im Umgang mit digitalen Kartensammlungen sammeln. Die Übung bietet eine Einführung in die kartographische Forschung und die Nutzung von Karten für wissenschaftliche Zwecke."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9LmUMEMfreMg" ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Fotothek>,
