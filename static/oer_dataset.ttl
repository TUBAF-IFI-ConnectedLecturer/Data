        <http://example.org/education/concept/Mikrocontroller>,
        <http://example.org/education/concept/Robotik>,
        <http://example.org/education/concept/Schaltungstechnik>,
        <http://example.org/education/concept/Sensorik>,
        <http://example.org/education/concept/Steuerungstechnik> ;
    dcterms:title "Modul: Didaktik der INF - Fachseminar Lehramt Informatik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7i-BH81wIS0M a edu:LearningResource ;
