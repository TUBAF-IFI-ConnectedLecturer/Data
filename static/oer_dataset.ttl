        <http://example.org/education/concept/Sozialwesen>,
        <http://example.org/education/concept/Studieng%C3%A4nge>,
        <http://example.org/education/concept/Studienwahl> ;
    dcterms:title "Warum sollte sich jemand für Ihren Studiengang und Abschluss an der HS Mittweida entscheiden?"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

