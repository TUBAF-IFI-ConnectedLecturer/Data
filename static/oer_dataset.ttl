        <http://example.org/education/concept/Kommunikationsmodell>,
        <http://example.org/education/concept/Konstruktives_Feedback>,
        <http://example.org/education/concept/M%C3%BCndliche_Kommunikation>,
        <http://example.org/education/concept/Schriftliche_Kommunikation>,
        <http://example.org/education/concept/Studienbezogene_Kommunikation>,
        <http://example.org/education/concept/Wissenschaftliche_Kommunikation> ;
