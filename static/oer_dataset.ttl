    dcterms:creator <http://example.org/education/person/Benabdellah>,
        <http://example.org/education/person/Kache>,
        <http://example.org/education/person/L%C3%B6ffler> ;
    dcterms:description "Die Vorlesung \"Triebfahrzeugtechnik - Antriebskonfigurationen\" behandelt die Charakterisierung von Dieselmotoren im Eisenbahnbereich, ihre Funktionsweise und Aufbau sowie ihre Vorteile und Nachteile im Vergleich zu anderen Verbrennungskraftmaschinen. Durch das Studium dieser Vorlesung können Lernende ein umfassendes Verständnis der Anforderungen an Dieselmotoren im Bahneinsatz erwerben und die verschiedenen Typen von Lokomotivmotoren und Triebwagenmotoren kennenlernen. Zudem werden sie in die Lage versetzt, die Auswirkungen von Abgasgesetzgebung und Aufladung auf den Einsatz von Dieselmotoren zu verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4CYl9L3PaHwA" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Verkehrswissenschaften_FRIEDRICH_LIST> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Dieselmotoren>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Motorentechnik>,
        <http://example.org/education/concept/Schienenfahrzeugtechnik>,
        <http://example.org/education/concept/Triebwagen>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Verbrennungskraftmaschinen> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik Antriebskonfigurationen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

