        <http://example.org/education/concept/Vegetationsgruppen>,
        <http://example.org/education/concept/Verkehrskonzept> ;
    dcterms:title "Masterplan Campusgestaltung"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:93N5g5iqS_-E a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Roth> ;
    dcterms:description "Das GIF-Artefakt zeigt den einfachen Übersteiger im Fußball und unterstützt das Erlernen von Bewegungen durch die Darstellung einzelner Schritte mit besonderen Eigenschaften. Durch die Analyse des GIFs können Fehlerbilder erkannt und positive Entwicklungen herausgearbeitet werden. Das Material eignet sich für den Unterricht, insbesondere im Fach Sport, um eigenständiges Erlernen von Finten zu fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "93N5g5iqS_-E" ;
    dcterms:subject <http://example.org/education/concept/Animationssoftware>,
