    dcterms:title "Twitter 1x1 FÜR EINEN SCHNELLEN EINSTIEG"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:8AG3-QaCiqLk a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schneider>,
        <http://example.org/education/person/Steiner> ;
    dcterms:description "Die Rechtsform eines Unternehmens ist eine konstitutive Entscheidung, die langfristige Auswirkungen auf die Geschäftstätigkeit hat und von verschiedenen Faktoren wie Haftung, Kapitalstruktur und Publizität abhängt. Die Wahl des Standorts ist eine weitere konstitutive Entscheidung, die von Kriterien wie Transportkosten, Infrastruktur und Ausbildungsniveau der Mitarbeiter abhängt. Durch das Verständnis dieser Entscheidungen können Unternehmen ihre Strategie entwickeln und langfristigen Erfolg sichern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8AG3-QaCiqLk" ;
    dcterms:subject <http://example.org/education/concept/Betriebswirtschaft>,
        <http://example.org/education/concept/Gesellschaftsrecht>,
        <http://example.org/education/concept/Kartellrecht>,
        <http://example.org/education/concept/Konzentration>,
        <http://example.org/education/concept/Kooperation>,
        <http://example.org/education/concept/Rechtsform>,
        <http://example.org/education/concept/Standortwahl>,
        <http://example.org/education/concept/Unternehmensf%C3%BChrung>,
        <http://example.org/education/concept/Unternehmenszusammenschluss>,
        <http://example.org/education/concept/Wettbewerb> ;
    dcterms:title "Die Rechtsform als konstitutive betriebliche Entscheidung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:8APHzLF5ubpM a edu:LearningResource ;
    dcterms:description "Die automatische Spracherkennung ermöglicht es, gesprochene Wörter in elektronische Schriftform umzuwandeln, wobei künstliche neuronale Netze und Hidden-Markov-Modelle eingesetzt werden, um die Wahrscheinlichkeit von Lautenfolgen zu berechnen. Durch das Studium dieser Techniken können Lernende ein tiefes Verständnis der digitalen Signalverarbeitung und des Einsatzes von neuronalen Netzen in der Spracherkennung erlangen. Der Deep-Speech-Ansatz bietet eine effektive Methode zur automatischen Spracherkennung, die auf einer relativ überschaubaren Architektur basiert und hohe Genauigkeiten bei der Erkennung von gesprochener Sprache erreicht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8APHzLF5ubpM" ;
    dcterms:subject <http://example.org/education/concept/Akustische_Signalverarbeitung>,
        <http://example.org/education/concept/Analog-Digital-Wandler>,
        <http://example.org/education/concept/Automatische_Spracherkennung>,
        <http://example.org/education/concept/Computerlinguistik>,
        <http://example.org/education/concept/Deep_Learning>,
        <http://example.org/education/concept/Frequenzspektrogramm>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Nat%C3%BCrliche_Sprachverarbeitung>,
        <http://example.org/education/concept/Neuronale_Netze>,
        <http://example.org/education/concept/Schallwechseldruck-Schwingung> ;
    dcterms:title "Automatische Spracherkennung am Beispiel Deep Speech"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

