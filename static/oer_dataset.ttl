    dcterms:creator <http://example.org/education/person/Schuchmann>,
        <http://example.org/education/person/Wiesenfeldt> ;
    dcterms:description "Die Übungsaufgaben behandeln die bibliographische Katalogisierung und Indexierung akademischer Werke, insbesondere die Gram-Schmidt-Verfahren zur Projektion von Vektoren auf einen Unterraum und die Berechnung der Darstellungsmatrix der Orthogonalprojektion. Durch das Lösen dieser Aufgaben erwerben die Lernenden Kenntnisse über die Anzahl der erforderlichen Rechenschritte in groß-O-Notation, um einen Vektor auf einen Unterraum zu projizieren, und vergleichen verschiedene Verfahren hinsichtlich ihrer Effizienz. Die Lösungen dieser Aufgaben helfen den Lernenden, ihre Fähigkeiten im Bereich der linearen Algebra und numerischen Mathematik zu verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3qWyERaBaaCc" ;
    dcterms:subject <http://example.org/education/concept/Algorithmus>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Gram-Schmidt-Verfahren>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Matrixoperationen>,
        <http://example.org/education/concept/Orthogonalprojektion>,
        <http://example.org/education/concept/Rechenkomplexit%C3%A4t>,
        <http://example.org/education/concept/Vektoren>,
        <http://example.org/education/concept/lineare_Algebra>,
        <http://example.org/education/concept/numerische_Mathematik> ;
    dcterms:title "Übungsaufgaben zur Bibliographischen Katalogisierung und Indexierung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

