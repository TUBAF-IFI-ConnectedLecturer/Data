    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von Triebfahrzeugen wird anhand von Zugkraftdiagrammen und Charakterisierungen von Altbau- und Neubau-Fahrzeugen erläutert. Die verschiedenen Antriebstechniken, wie konventionelle und zweikraftfahrzeugtechnische Lösungen, werden vorgestellt und ihre Leistungsmerkmale verglichen. Durch das Studium dieser Materialien können Lernende die Fahrdynamik von Triebfahrzeugen verstehen und die verschiedenen Antriebstechniken beurteilen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3ljdsxwDgYuc" ;
    dcterms:subject <http://example.org/education/concept/Drehstrommotoren>,
        <http://example.org/education/concept/Elektrische_Antriebstechnik>,
        <http://example.org/education/concept/Elektromotoren>,
        <http://example.org/education/concept/Fahrzeugantriebe>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Mehrsystemtriebfahrzeuge>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Triebfahrzeuge>,
        <http://example.org/education/concept/Zugkraftdiagramme>,
        <http://example.org/education/concept/Zweikraftfahrzeuge> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

