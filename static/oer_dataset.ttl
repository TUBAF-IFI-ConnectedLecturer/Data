        <http://example.org/education/concept/Sensoren> ;
    dcterms:title "Modul Didaktik der INF - Fachseminar Lehramt Informatik (Gy, MS, BS, FS)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

