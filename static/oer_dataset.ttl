        <http://example.org/education/concept/Kanten>,
        <http://example.org/education/concept/Knoten>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Planarit%C3%A4t> ;
    dcterms:title "I382 Mathematik - Winter 2024-25 Übungsblatt 10"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9-5x0ORImi7s a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hofmann> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Kommunikation und Kooperation im Kontext von E-Learning und Didaktik der Informatik. Durch die Verwendung von Webbasierten Kooperationswerkzeugen wie BSCW, Groupware-Werkzeugen und Synchrone Kommunikationswerkzeugen können Lehrende und Lernende effektiv zusammenarbeiten und ihre Aufgaben koordinieren. Die Kenntnis dieser Werkzeuge und Konzepte ermöglicht es den Lernenden, erfolgreich Lehr-Lern-Szenarien umzusetzen und ihre Fähigkeiten in der Kommunikation und Kooperation zu verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9-5x0ORImi7s" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
