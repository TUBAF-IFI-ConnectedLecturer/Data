        oer:8DuvFWcNIFww,
        oer:9tx_ZwEDp02s ;
    dcterms:creator <http://example.org/education/person/Fricke> ;
    dcterms:description "Faserverbundwerkstoffe (FVK) sind Werkstoffe, die aus einer Kombination von Fasern und Matrix bestehen und durch ihre besonderen Eigenschaften wie hohe Festigkeit, Steifigkeit und geringes Gewicht in verschiedenen Anwendungen eingesetzt werden. Durch das Studium dieser Materialien können Lerner die grundlegenden Konzepte und Eigenschaften von FVK verstehen, einschließlich ihrer Herstellung, Verarbeitung und Anwendung in der Praxis. Darüber hinaus erhalten sie Einblick in die verschiedenen Arten von Fasern und Matrizes, ihre Eigenschaften und Anwendungen, sowie in die Bedeutung von FVK in der modernen Ingenieurwissenschaft und Technologie."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11O6toNBMgZY0" ;
    dcterms:publisher <http://example.org/education/organization/DLR> ;
    dcterms:subject <http://example.org/education/concept/Bauweise>,
        <http://example.org/education/concept/Dauerfestigkeit>,
        <http://example.org/education/concept/Faserverbundwerkstoffe>,
        <http://example.org/education/concept/Festigkeit>,
        <http://example.org/education/concept/Leichtbau>,
        <http://example.org/education/concept/Leichtbaukonstruktion>,
        <http://example.org/education/concept/Schienenfahrzeug>,
        <http://example.org/education/concept/Steifigkeit>,
        <http://example.org/education/concept/Verbundwerkstoff>,
        <http://example.org/education/concept/Werkstoffkennwerte> ;
    dcterms:title "2. Werkstoffe Bauw. 2.3. Faserverbundwerkstoffe"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

