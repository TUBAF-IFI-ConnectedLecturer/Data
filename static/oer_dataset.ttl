        <http://example.org/education/concept/Landvermessung>,
        <http://example.org/education/concept/Tachymetrie>,
        <http://example.org/education/concept/Vermessungstechnik> ;
    dcterms:title "7. Vorlesung Vermessungslehre"@de ;
