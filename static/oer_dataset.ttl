oer:10ojxzpx3qecM a edu:LearningResource ;
    sim:similarTo oer:10uPtUe-NfF2o ;
    dcterms:description "Der Satz des Thales wird durch einen Beweis erläutert, bei dem die Winkelsumme eines Dreiecks berechnet und die Basiswinkel der Teildreiecke bestimmt werden. Durch den Beweis kann gezeigt werden, dass der Winkel über dem Durchmesser eines Kreises immer 90 Grad beträgt. Die Aufgabe unterstützt das Verständnis geometrischer Konzepte und fördert die Fähigkeit, mathematische Beweise zu erstellen und zu verstehen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "10ojxzpx3qecM" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Beweis>,
        <http://example.org/education/concept/Dreieck>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Geometrische_Figuren>,
        <http://example.org/education/concept/Kreis>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Raumgeometrie>,
        <http://example.org/education/concept/Satz_des_Thales>,
        <http://example.org/education/concept/Sekundarstufe>,
        <http://example.org/education/concept/Winkel> ;
    dcterms:title "Der Satz des Thales"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

