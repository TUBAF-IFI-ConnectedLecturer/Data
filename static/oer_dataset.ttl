        <http://example.org/education/concept/Rangierlokomotive>,
        <http://example.org/education/concept/Schienenfahrzeugtechnik>,
        <http://example.org/education/concept/Triebfahrzeug> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

