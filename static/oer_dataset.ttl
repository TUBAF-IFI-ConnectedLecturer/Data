        <http://example.org/education/concept/Kulturgut>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitsrecht>,
        <http://example.org/education/concept/Quellenkritik> ;
    dcterms:title "Die bibliographische Katalogisierung und Indexierung von Archiven"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

