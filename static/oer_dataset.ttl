        <http://example.org/education/concept/Rollwiderstand>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Zugfahrtsimulation> ;
    dcterms:title "Fahrdynamik Bahnfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

