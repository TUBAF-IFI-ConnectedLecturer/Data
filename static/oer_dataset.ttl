oer:11d9xFNiwzg6Y a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Appelrath>,
        <http://example.org/education/person/Ludewig> ;
    dcterms:description "Das Oldenburger Milchkannenproblem ist ein Beispiel für eine alltägliche Aufgabe, bei der es darum geht, mit zwei Gefäßen unterschiedlicher Größe eine bestimmte Menge an Milch abzufüllen. Die Lösung des Problems erfordert die Anwendung von Algorithmen und Programmierkonzepten, wie sie in der Informatik verwendet werden. Durch die Bearbeitung dieses Problems können Lernende ihre Fähigkeiten im Bereich der Algorithmik, Programmierung und Fehleranalyse verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11d9xFNiwzg6Y" ;
    dcterms:publisher <http://example.org/education/organization/Verlag_der_Fachvereine_und_Stuttgart%3A_B.G.Teubner> ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Algorithmus>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Debugging>,
        <http://example.org/education/concept/Fehlerbehebung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Milchkannenproblem>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Qualit%C3%A4tssicherung>,
        <http://example.org/education/concept/Softwareentwicklung> ;
    dcterms:title "Das Oldenburger Milchkannenproblem"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:11dN1z-S0vV34 a edu:LearningResource ;
    dcterms:description "In diesem Arbeitsblatt werden Aufgaben zum Thema Einheiten und Umrechnungen gestellt, um die Fähigkeit zu entwickeln, zwischen verschiedenen Maßeinheiten umzurechnen und Preise zu berechnen. Die Aufgaben sind in verschiedenen Szenarien wie Einkauf im Supermarkt, Gemüsegeschäft und Drogeriemarkt angesiedelt. Durch das Lösen dieser Aufgaben können die Lernenden ihre Fähigkeiten im Umgang mit Einheiten und Preisen verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11dN1z-S0vV34" ;
    dcterms:subject <http://example.org/education/concept/Einzelhandel>,
        <http://example.org/education/concept/Haushaltswaren>,
        <http://example.org/education/concept/K%C3%B6rperpflege>,
