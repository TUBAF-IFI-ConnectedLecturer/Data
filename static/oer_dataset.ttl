    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8SR1_AGCGPAs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Dieses Dokument bietet Übungen und Aufgaben zur Vertiefung der Grundlagen der Linguistik und Sprachgeschichte des Deutschen. Durch die Bearbeitung dieser Aufgaben können Lernende ihre Fähigkeiten im Bereich der Morphologie, Kasusbestimmung und Wortartenanalyse verbessern. Zudem werden sie dazu angeleitet, den Zusammenhang zwischen Verb-Präposition und Kasus zu erkennen und die richtigen Flexionsformen anzuwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8SR1_AGCGPAs" ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Flexionsform>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Kasus>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Morphologie>,
        <http://example.org/education/concept/Pragmatik>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Syntax>,
        <http://example.org/education/concept/Wortart> ;
    dcterms:title "UE Grundlagen der Linguistik und Sprachgeschichte des Deutschen Dr. Sabina Tsapaeva"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

