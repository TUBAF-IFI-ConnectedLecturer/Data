oer:7X9-ja7HPq2I a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Meretz>,
        <http://example.org/education/person/Sutterl%C3%BCtti> ;
    dcterms:description "Dieses Werk behandelt die Theorie und Praxis des Commonismus, einer Gesellschaftsform, die auf herrschaftsfreier Vermittlung von Bedürfnissen basiert. Durch die Lektüre dieses Textes können Leser ein tieferes Verständnis der sozialen und politischen Prozesse entwickeln, die eine freie Gesellschaft ermöglichen, sowie die Grundlagen des Kapitalismus und seine Auswirkungen auf die Gesellschaft kritisch reflektieren. Darüber hinaus werden Konzepte wie die politisch-staatliche Transformationstheorie, die Kritische Psychologie und die Keimformtheorie vorgestellt, um ein umfassendes Bild der Möglichkeiten einer freien Gesellschaft zu zeichnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7X9-ja7HPq2I" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_a_Hint_About_The_Author%27s_Institutional_Affiliation%3A%22freie_Universit%C3%A4t_Berlin%22this_Is_Mentioned_In_The_Text_As_Part_Of_An_Email_Address._Therefore__The_Answer_Is%3Afreie_Universit%C3%A4t_Berlin> ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologiebewegung>,
        <http://example.org/education/concept/Commons>,
        <http://example.org/education/concept/Gesellschaftstheorie>,
        <http://example.org/education/concept/Kapitalismus>,
        <http://example.org/education/concept/Politische_Theorie>,
        <http://example.org/education/concept/Reform>,
        <http://example.org/education/concept/Revolution>,
        <http://example.org/education/concept/Soziologie>,
        <http://example.org/education/concept/Staatstheorie>,
        <http://example.org/education/concept/Transformationstheorien> ;
    dcterms:title "Commonismus"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

