        <http://example.org/education/concept/Standardisierung>,
        <http://example.org/education/concept/Technische_Universit%C3%A4t_Bergakademie_Freiberg> ;
    dcterms:title "Additive Fertigung - 1 Einführung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

