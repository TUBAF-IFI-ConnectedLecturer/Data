        <http://example.org/education/concept/Geschichte_der_Bibliothek>,
        <http://example.org/education/concept/Geschichte_der_Schrift>,
        <http://example.org/education/concept/Geschichte_des_Lesens>,
        <http://example.org/education/concept/Lesen>,
        <http://example.org/education/concept/Schrift> ;
    dcterms:title "Bibliotheksgeschichte"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

oer:11QoO4vE_FJNY a edu:LearningResource ;
    sim:similarTo oer:11qdwraJKZEuo ;
    dcterms:creator <http://example.org/education/person/Moritz> ;
    dcterms:description "Der Zweirichtungsradweg bietet eine sichere und umweltfreundliche Möglichkeit, Wohngebiete zu erschließen, indem er Radfahrern ermöglicht, abseits von Hauptverkehrsstraßen zu fahren. Durch die Implementierung von Dialog-Displays an Knotenpunkten kann die Verkehrssicherheit erhöht werden. Der nationale Radverkehrsplan 3.0 fördert die Nutzung des Fahrrads als Teil der Multimodalität und unterstützt die Nahverkehrsförderung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11QoO4vE_FJNY" ;
    dcterms:subject <http://example.org/education/concept/Fahrradparken>,
        <http://example.org/education/concept/Infrastruktur>,
        <http://example.org/education/concept/Multimodalit%C3%A4t>,
