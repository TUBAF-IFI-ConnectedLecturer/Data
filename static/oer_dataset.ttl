oer:6lIpYXL0Z8yc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Jassmann> ;
    dcterms:description "Die Schülerinnen und Schüler lernen die Grundlagen von Algorithmen und Blockprogrammierung kennen, indem sie den Calliope als Informatiksystem nutzen und MakeCode anwenden, um Programme zu erstellen. Sie entwickeln eine positive Einstellung zur Programmierung und erkennen, dass das Programmieren für sie machbar ist. Durch die verschiedenen Aufgaben und Übungen können die Schülerinnen und Schüler ihr Wissen zu Algorithmen und dem EVA-Prinzip festigen und erste eigene Programme schreiben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6lIpYXL0Z8yc" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Blockprogrammierung>,
        <http://example.org/education/concept/Calliope>,
        <http://example.org/education/concept/Einzelarbeit>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Interaktive_Tafel>,
        <http://example.org/education/concept/Lehrervortrag>,
        <http://example.org/education/concept/MakeCode>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Unterrichtsgespr%C3%A4ch> ;
    dcterms:title "Stundenablaufplan Klassenstufe 7 (GYM) 3 Algorithmen"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:6tvEmcC9ag7w a edu:LearningResource ;
    sim:similarTo oer:6ulectec39SA,
        oer:6yydLqK1GMGk,
        oer:8NmRAO8MWzGs,
        oer:8w7Gd3W6PXHI,
        oer:9h5DzkjuA7nQ,
        oer:9t_nKAZbzrxs ;
    dcterms:creator <http://example.org/education/person/Knospe> ;
    dcterms:description "Das Lernwerkzeug Kara ermöglicht es Schülern, die Grundlagen des Programmierens spielerisch und anschaulich zu erlernen, indem sie einen programmierbaren Marienkäfer durch eine 2-dimensionale Welt bewegen. Durch die Arbeit mit Kara können SuS Algorithmen und Programme verstehen, das Modell endlicher Automaten kennenlernen und Probleme lösen. Das Werkzeug bietet eine Vielzahl von Beispielaufgaben und Funktionen, um den Lernprozess zu unterstützen und zu erleichtern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6tvEmcC9ag7w" ;
    dcterms:subject <http://example.org/education/concept/Algorithmus>,
        <http://example.org/education/concept/Automatentheorie>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Informatische_Bildung>,
        <http://example.org/education/concept/Lehrplanentwicklung>,
        <http://example.org/education/concept/Lernwerkzeug>,
        <http://example.org/education/concept/Modellierung>,
        <http://example.org/education/concept/Probleml%C3%B6sen>,
        <http://example.org/education/concept/Programmieren> ;
    dcterms:title "Werkzeuge für den Informatikunterricht Kara 1. Kurzvorstellung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:6uP1PCSDo-Ts a edu:LearningResource ;
    sim:similarTo oer:70yaVCrmyLWM,
        oer:78FjwaMKZMHo,
