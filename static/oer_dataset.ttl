        <http://example.org/education/concept/Integrit%C3%A4t>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Nichtabstreitbarkeit>,
        <http://example.org/education/concept/Quantenkryptographie>,
        <http://example.org/education/concept/Verf%C3%BCgbarkeit>,
        <http://example.org/education/concept/Vertraulichkeit> ;
    dcterms:title "Prof. Buchmann - Kryptographie 12 one-TIme pad"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5Uf3JzKtDbR8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Epple> ;
    dcterms:description "Der Städtische Schlacht- und Viehhof in Dresden ist ein Ensemble von Gebäuden, die zwischen 1906 und 1910 errichtet wurden und heute als Messe Dresden genutzt werden. Die Anlage umfasst verschiedene Funktionsbereiche wie Stallungen, Verwaltungsgebäude, Werkstätten und Wohnhäuser, die mit Kunstwerken wie Bauplastik, Bildwerk und Malerei ausgestattet sind. Durch die Erfassung als Kulturdenkmal wird der Erhalt des Ensembles sichergestellt, um die Geschichte und Architektur des Ortes zu bewahren."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "5Uf3JzKtDbR8" ;
    dcterms:subject <http://example.org/education/concept/Abwasseranlage>,
        <http://example.org/education/concept/Architektur>,
        <http://example.org/education/concept/Baukunst>,
        <http://example.org/education/concept/Denkmalpflege>,
        <http://example.org/education/concept/Eisenbahnbr%C3%BCcke>,
        <http://example.org/education/concept/Kulturdenkmal>,
        <http://example.org/education/concept/Schlachthof>,
        <http://example.org/education/concept/Technisches_Denkmal>,
        <http://example.org/education/concept/Viehhof>,
        <http://example.org/education/concept/Wasserversorgung> ;
    dcterms:title "Städtischer Schlacht- und Viehhof (Sachgesamtheit); heute Messe Dresden"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:5UupdvikZKuA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Achtziger>,
        <http://example.org/education/person/Leucht>,
        <http://example.org/education/person/Opitz> ;
    dcterms:description "Weinbergsmauern bieten einen wichtigen Lebensraum für verschiedene Tierarten, wie Eidechsen, Schlangen, Spinnen und Insekten. Durch die Erkundung von Weinbergsmauern können Lernende die Bedeutung der Biodiversität im Weinbau verstehen und Maßnahmen zur Anpassung an den Klimawandel kennenlernen. Das Bildungsmaterial bietet Einblicke in die verschiedenen Bereiche von Weinbergsmauern, wie Aufbau, Lebensraum und Nahrungsketten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5UupdvikZKuA" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kosystem>,
        <http://example.org/education/concept/Amphibien>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
        <http://example.org/education/concept/Habitatanalyse>,
        <http://example.org/education/concept/Insekten>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Lebensraum>,
        <http://example.org/education/concept/Reptilien>,
        <http://example.org/education/concept/Tiere>,
        <http://example.org/education/concept/Weinbau> ;
    dcterms:title "Biotoptypen in Weinbergen: Weinbergsmauern als Lebensraum für Tiere"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:5WokEgkNeUjQ a edu:LearningResource ;
    dcterms:description "Die Tabelle enthält Berechnungen für die Ratentilgung und Annuitätentilgung mit verschiedenen Zinssätzen und Zeitperioden. Durch das Studium dieser Tabellen können Lerner die Grundlagen der Finanzmathematik verstehen und anwenden, insbesondere bei der Berechnung von Tilgungsplänen. Die Beispiele und Ergebnisse dienen als Anleitung für die praktische Umsetzung von Finanzkonzepten in verschiedenen Szenarien."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "5WokEgkNeUjQ" ;
    dcterms:subject <http://example.org/education/concept/Annuit%C3%A4t>,
        <http://example.org/education/concept/Finanzen>,
        <http://example.org/education/concept/Finanzmathematik>,
        <http://example.org/education/concept/Geldanlage>,
        <http://example.org/education/concept/Kapitalwertrechnung>,
