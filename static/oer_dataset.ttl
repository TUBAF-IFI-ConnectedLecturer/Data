    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Diese Übungssammlung behandelt die mathematische Analyse periodischer Funktionen und Signale, wobei die Aufgaben die Periodizität, Fourier-Reihen und Kreisfrequenzen von verschiedenen Funktionen untersuchen lassen. Durch das Bearbeiten dieser Aufgaben können Lernende ihre Fähigkeiten in der mathematischen Modellierung und Analyse periodischer Phänomene verbessern und ein tieferes Verständnis für die zugrundeliegenden Konzepte entwickeln. Die Übungssammlung richtet sich an Studierende der Mathematik und Ingenieurwissenschaften, die ihre Kenntnisse in diesem Bereich erweitern möchten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4JhCVd7hJe98" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Fourier-Reihe>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Ingenieursmathematik>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mathematische_Analyse>,
        <http://example.org/education/concept/Periodizit%C3%A4t>,
        <http://example.org/education/concept/Reelle_Funktionen>,
        <http://example.org/education/concept/Signalverarbeitung> ;
    dcterms:title "Mathematik für Ingenieure - WS2023/24 Übungsblatt 4"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

