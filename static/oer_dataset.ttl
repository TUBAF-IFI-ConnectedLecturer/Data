        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Operationenfolgen>,
        <http://example.org/education/concept/Relationen> ;
    dcterms:title "Abifahrtauswertung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:127050rpTGXD0 a edu:LearningResource ;
    sim:similarTo oer:12j9XasrePLsc ;
    dcterms:creator <http://example.org/education/person/F%C3%B6rster> ;
    dcterms:description "Die vorliegende Seminararbeit vergleicht den mikroskopischen Aufbau von Laub- und Nadelhölzern, indem sie die Zellarten, Zellformen und Zellfunktionen darstellt und anschließend vergleichend gegenüberstellt. Durch diese Arbeit können Leser Gemeinsamkeiten und Unterschiede zwischen Laub- und Nadelbäumen erkennen und die mikroskopischen Merkmale des Holzes als Grundlage für seine weitere Verwendung nutzen. Die Erkenntnisse über den Zellaufbau von Hölzern sind für die Holz- und Holzwerkstoffindustrie sowie für die Entwicklung neuer Werkstoffe von großer Bedeutung."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "127050rpTGXD0" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Botanik>,
        <http://example.org/education/concept/Forstwissenschaft>,
        <http://example.org/education/concept/Gewebebiologie>,
        <http://example.org/education/concept/Holz>,
        <http://example.org/education/concept/Holzanatomie>,
        <http://example.org/education/concept/Holztechnologie>,
        <http://example.org/education/concept/Mikroskopie>,
        <http://example.org/education/concept/Pflanzenanatomie>,
        <http://example.org/education/concept/Zellbiologie>,
        <http://example.org/education/concept/Zelltypen> ;
    dcterms:title "Vergleichende Gegenüberstellung des Zellaufbaus bei Laubbäumen und bei Nadelbäumen einschließlich Erläuterung der Funktion von spezifischen Zellarten"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:12BoIuL8Z33qc a edu:LearningResource ;
    sim:similarTo oer:12TxFC7yCnkSU ;
    dcterms:creator <http://example.org/education/person/Kauk>,
        <http://example.org/education/person/Lorius> ;
    dcterms:description "Dieses Dokument bietet eine Zusammenstellung von Ressourcen und Werkzeugen zum Erkennen und Enttarnen von Fake News und Desinformation. Es verweist auf verschiedene Plattformen und Initiativen, die Faktenchecks und Medienkompetenz fördern, sowie auf Tools für die Recherche und Überprüfung von Informationen. Durch die Nutzung dieser Ressourcen können Lerner ihre Fähigkeiten zur kritischen Bewertung von Informationen verbessern und sich vor Falschinformationen schützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12BoIuL8Z33qc" ;
    dcterms:subject <http://example.org/education/concept/Bildforensik>,
        <http://example.org/education/concept/Desinformation>,
        <http://example.org/education/concept/Fake_News>,
        <http://example.org/education/concept/Faktencheck>,
        <http://example.org/education/concept/Falschinformationen>,
        <http://example.org/education/concept/Journalismus>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Phishing>,
        <http://example.org/education/concept/Reverse_Image_Search>,
        <http://example.org/education/concept/Spam> ;
    dcterms:title "Linksammlung zum Thema Fake News"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:12C6NQNajGttM a edu:LearningResource ;
    sim:similarTo oer:96C9KHZzzwpE ;
    dcterms:creator <http://example.org/education/person/Neumann>,
        <http://example.org/education/person/Stieler> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Quantenphysik und ihre Anwendungen, indem es Schülern ermöglicht, grundlegende Aspekte wie stochastische Vorhersehbarkeit, Interferenz, Superposition und Zusammenhang zwischen Größen zu verstehen. Durch die Simulation von Experimenten, wie dem Stern-Gerlach-Experiment, und der Darstellung von Quantenphänomenen in verschiedenen Kontexten, sollen Schüler ein quantenphysikalisches Weltbild entwickeln und die Bedeutung aktueller Entwicklungen in der Allgemeinbildung erkennen. Das Material richtet sich an Lehrer und Schüler, die Quantenphysik unterrichten oder lernen möchten, und bietet eine umfassende Einführung in das Thema."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12C6NQNajGttM" ;
    dcterms:publisher <http://example.org/education/organization/Leerer_String_Zur%C3%BCck__Da_Keine_Hinweise_Auf_Die_Herkunftsinstitution_Des_Autors_Gefunden_Wurden.> ;
    dcterms:subject <http://example.org/education/concept/Lehrplan>,
        <http://example.org/education/concept/Physikunterricht>,
        <http://example.org/education/concept/Quantenkryptographie>,
        <http://example.org/education/concept/Quantenmechanik>,
        <http://example.org/education/concept/Quantenphysik>,
        <http://example.org/education/concept/Quantisierung>,
        <http://example.org/education/concept/Sch%C3%BClerorientierung>,
        <http://example.org/education/concept/Superposition>,
        <http://example.org/education/concept/Unbestimmtheit>,
        <http://example.org/education/concept/Verschr%C3%A4nkung> ;
    dcterms:title "PSE IV  Quantenphysik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:12CGqwlwNOvPs a edu:LearningResource ;
    sim:similarTo oer:12bbELvU3SlM4 ;
    dcterms:description "Die Eigenschaften von Relationen wie Reflexivität, Transitivität und Symmetrie werden anhand der Teilmenge-Relation erklärt und ihre Gültigkeit für verschiedene Arten von Ordnungen überprüft. Die Quasiordnung und die Halbordnung erfüllen bestimmte Kriterien, während die Äquivalenzrelation und die Lineare Ordnung nicht alle erforderlichen Eigenschaften aufweisen. Durch das Verständnis dieser Relationseigenschaften können Lernende die Struktur von Mengenbeziehungen besser analysieren und ihre Anwendung in verschiedenen Kontexten verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12CGqwlwNOvPs" ;
    dcterms:subject <http://example.org/education/concept/%C3%84quivalenzrelation>,
        <http://example.org/education/concept/Halbordnung>,
        <http://example.org/education/concept/Lineare_Ordnung>,
        <http://example.org/education/concept/Mathematische_Logik>,
        <http://example.org/education/concept/Mengenlehre>,
        <http://example.org/education/concept/Ordnungsrelationen>,
        <http://example.org/education/concept/Partielle_Ordnung>,
        <http://example.org/education/concept/Quasiordnung>,
        <http://example.org/education/concept/Relationenalgebra>,
        <http://example.org/education/concept/Totale_Ordnung> ;
    dcterms:title "Serie 9 Aufgabe 3 Hörrmann"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:12CpPiapoDjI8 a edu:LearningResource ;
    sim:similarTo oer:9tMbvWColBsM ;
    dcterms:description "Das Sächsische Datenschutzgesetz regelt die Verarbeitung personenbezogener Daten und schützt die Privatsphäre von Personen. Durch die Verpflichtung auf das Datengeheimnis werden Mitarbeiter auf ihre Pflichten hingewiesen, personenbezogene Daten nur im Rahmen ihrer Befugnisse zu verarbeiten und sonstige Geheimhaltungspflichten einzuhalten. Die Verletzung des Datengeheimnisses kann zu disziplinarischen Maßnahmen und Strafen führen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12CpPiapoDjI8" ;
    dcterms:subject <http://example.org/education/concept/Bildungsagentur>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Datenschutzgesetz>,
        <http://example.org/education/concept/Forschungsethik>,
        <http://example.org/education/concept/Geheimhaltung>,
        <http://example.org/education/concept/Recht_auf_informationelle_Selbstbestimmung>,
        <http://example.org/education/concept/S%C3%A4chsisches_Datenschutzgesetz>,
        <http://example.org/education/concept/Schweigepflicht>,
        <http://example.org/education/concept/Vertraulichkeit>,
        <http://example.org/education/concept/personenbezogene_Daten> ;
    dcterms:title "Anlage zur Verpflichtung auf das Datengeheimnis nach § 6 Sächsisches Datenschutzgesetz"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:12G-166NhMcB4 a edu:LearningResource ;
    sim:similarTo oer:12xzooG4WfLuE ;
    dcterms:description "Die SuS lernen, wie sie zwischen sicheren und unsicheren Passwörtern unterscheiden und erfahren, warum Kryptografie für Passwörter wichtig ist. Sie erwerben Fähigkeiten, um eigene sichere Passwörter zu erstellen und erfahren, wie Hashfunktionen funktionieren. Durch die Teilnahme am Unterricht können die SuS ihre Kenntnisse über sichere Passwörter erweitern und praktische Erfahrungen sammeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12G-166NhMcB4" ;
    dcterms:subject <http://example.org/education/concept/Authentifizierung>,
        <http://example.org/education/concept/Benutzerzugang>,
        <http://example.org/education/concept/Computersicherheit>,
        <http://example.org/education/concept/Datenverschl%C3%BCsselung>,
        <http://example.org/education/concept/Einwegfunktion>,
        <http://example.org/education/concept/Hashfunktion>,
        <http://example.org/education/concept/Informationssicherheit>,
        <http://example.org/education/concept/Kryptografie>,
        <http://example.org/education/concept/Passwort>,
        <http://example.org/education/concept/Sicherheit> ;
    dcterms:title "Wie sicher ist mein Passwort?"@de ;
