    dcterms:creator <http://example.org/education/person/Askedal> ;
    dcterms:description "Das Deutsche zeichnet sich durch eine komplexe Morphosyntax aus, die durch Klammerbildungen und Serialisierungsinkonsistenzen gekennzeichnet ist. Durch die Analyse dieser Strukturen können Lerner ein tieferes Verständnis der deutschen Grammatik und ihrer Funktionen erlangen. Insbesondere werden sie erkennen, wie die deutsche Sprache durch eine Konvergenz von Serialisierungsrichtungen und -inkonsistenzen eine Isomorphie zwischen syntaktischen Konstruktions- und semantischen Interpretationsdomänen herstellt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10XFxRPBCfHtg" ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Kasus>,
        <http://example.org/education/concept/Klammerkonstruktionen>,
        <http://example.org/education/concept/Konjugation>,
        <http://example.org/education/concept/Morphologie>,
        <http://example.org/education/concept/Serialisierung>,
        <http://example.org/education/concept/Sprachtypologie>,
        <http://example.org/education/concept/Syntax>,
        <http://example.org/education/concept/Universelle_Grammatik> ;
    dcterms:title "Deutsch als germanische Sprache im Lichte der Sprachtypologie"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

