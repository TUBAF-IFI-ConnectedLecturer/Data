        <http://example.org/education/concept/Stressreduktion>,
        <http://example.org/education/concept/Terminkalender>,
        <http://example.org/education/concept/Zeitmanagement>,
        <http://example.org/education/concept/Zielsetzung> ;
    dcterms:title "Mein Weg zum Bullet Journal: Im eigenen Stil effizient und übersichtlich planen"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

