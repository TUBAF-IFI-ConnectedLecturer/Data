oer:9cHQPA444lHk a edu:LearningResource ;
    sim:similarTo oer:9fXhxbAr8iOM,
        oer:9p7AVgmjaBuA ;
    dcterms:creator <http://example.org/education/person/Debus>,
        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übungsaufgaben zum Sommersemester 2025 behandeln Themen der Numerik partieller Differentialgleichungen und bieten eine Vielzahl von Aufgaben zur Berechnung von Kurvenintegralen, Flächeninhalten und Vektorfeldern. Durch die Lösung dieser Aufgaben können Studierende ihre Fähigkeiten in der Anwendung von Integralsätzen, dem Satz von Green und anderen mathematischen Konzepten verbessern. Die Übungsaufgaben decken eine breite Palette an Themen ab, darunter auch die Berechnung von Doppelpunkten, Kurvenintegralen und Oberflächenintegralen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9cHQPA444lHk" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Fl%C3%A4cheninhaltsformel>,
