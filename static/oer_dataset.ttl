        <http://example.org/education/concept/K%C3%BChlanlagen>,
        <http://example.org/education/concept/Klimaanlagen>,
        <http://example.org/education/concept/Str%C3%B6mungsgetriebe%C3%B6l>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/W%C3%A4rme%C3%BCbertragung> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9dah6eIbrOm0 a edu:LearningResource ;
    sim:similarTo oer:9o2uVOV3V5MY ;
    dcterms:creator <http://example.org/education/person/Hagedorn> ;
    dcterms:description "Das Material ermöglicht Schülerinnen, selbstständig das Thema Wortarten zu erarbeiten und dabei ihre eigene Lerntempo zu finden. Durch die Verwendung von Powerpointpräsentationen mit Tonaufnahmen können sie die Eigenschaften und Merkmale von Substantiven, Verben, Adjektiven und Artikeln kennenlernen und anwenden. Dadurch fördert das Material Fachkompetenz, Methodenkompetenz und Selbstkompetenz der Lernenden."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9dah6eIbrOm0" ;
