oer:8tp6cQ3lyHWg a edu:LearningResource ;
    sim:similarTo oer:8zKeSPiSTWGE ;
    dcterms:creator <http://example.org/education/person/Hirte>,
        <http://example.org/education/person/Obermeyer> ;
    dcterms:description "Die Einführung in die Verkehrswirtschaft behandelt grundlegende Konzepte und Klassifizierungen im Bereich der Verkehrsökonomie, einschließlich der Charakterisierung von Verkehrsträgern, Transportentfernungen und -objekten sowie der Gestaltung von Reiseplänen. Durch das Studium dieser Inhalte können Lerner ein grundlegendes Verständnis der Verkehrswirtschaft entwickeln und die Fähigkeit erwerben, komplexe Verkehrsprozesse zu analysieren und zu bewerten. Die präsentierten Informationen dienen als Basis für weiterführende Studien im Bereich der Verkehrsplanung und -politik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8tp6cQ3lyHWg" ;
    dcterms:subject <http://example.org/education/concept/Fernverkehr>,
        <http://example.org/education/concept/G%C3%BCterverkehr>,
        <http://example.org/education/concept/Logistik>,
        <http://example.org/education/concept/Mobilit%C3%A4t>,
        <http://example.org/education/concept/Nahverkehr>,
