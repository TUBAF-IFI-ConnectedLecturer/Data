oer:103-E2FpWe7GU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Feder> ;
    dcterms:description "Das Lehrmaterial ermöglicht es Lehrkräften, Schülerinnen und Schülern (SuS) die Wurzel- und Potenzfunktionen zu vermitteln, indem sie ein Kahoot erstellen und durchführen. Die SuS lernen, diese Funktionen sicher zu erkennen und zu verstehen. Durch die Teilnahme am Kahoot können die SuS ihre Kenntnisse über Wurzel- und Potenzfunktionen festigen und erweitern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "103-E2FpWe7GU" ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Interaktive_Medien>,
        <http://example.org/education/concept/Lehrerfortbildung>,
        <http://example.org/education/concept/Lehrmethoden>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Mathematische_Funktionen>,
        <http://example.org/education/concept/Potenzfunktionen>,
        <http://example.org/education/concept/Unterrichtsvorbereitung>,
        <http://example.org/education/concept/Wurzelfunktionen> ;
    dcterms:title "Kurzbeschreibung"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:103uXAouHOAE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kasper> ;
    dcterms:description "Die Analyse der Jeans von Jacob Davis und Levi Strauss als Innovation zeigt, dass es sich um eine Produktinnovation, Designinnovation und teilweise Prozess- und soziale Innovation handelt. Die Jeans hat sich auf dem Markt durchgesetzt und ist nach 145 Jahren immer noch produziert worden. Durch die Analyse dieser Innovation können Lernende die Kriterien für eine Innovation erkennen und verstehen, wie sie identifiziert und bewertet werden kann."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "103uXAouHOAE" ;
    dcterms:subject <http://example.org/education/concept/Bekleidung>,
        <http://example.org/education/concept/Designinnovation>,
        <http://example.org/education/concept/Fertigungstechnologie>,
        <http://example.org/education/concept/Innovation>,
        <http://example.org/education/concept/Jeans>,
        <http://example.org/education/concept/Mode>,
        <http://example.org/education/concept/Produktinnovation>,
        <http://example.org/education/concept/Prozessinnovation>,
        <http://example.org/education/concept/Soziale_Innovation>,
        <http://example.org/education/concept/Textilindustrie> ;
    dcterms:title "Testat 2 Analyse von Innovationen"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:104ZQokF_btVw a edu:LearningResource ;
    dcterms:description "Dieses Dokument behandelt grundlegende Konzepte der Algebra, insbesondere die Assoziativität und das neutrale Element in einer Gruppe. Es werden Beispiele und Übungsaufgaben bereitgestellt, um die Anwendung dieser Konzepte zu veranschaulichen. Durch das Studium dieses Dokuments können Lernende ein Verständnis der algebraischen Strukturen und ihrer Eigenschaften entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "104ZQokF_btVw" ;
    dcterms:subject <http://example.org/education/concept/Abstrakte_Algebra>,
        <http://example.org/education/concept/Algebraische_Strukturen>,
        <http://example.org/education/concept/Assoziativit%C3%A4t>,
        <http://example.org/education/concept/Diskrete_Strukturen>,
        <http://example.org/education/concept/Gruppen>,
        <http://example.org/education/concept/Inverse>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Modulare_Arithmetik>,
        <http://example.org/education/concept/Neutrale_Elemente>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Nachbereitung Übung 6 Diskrete Strukturen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

