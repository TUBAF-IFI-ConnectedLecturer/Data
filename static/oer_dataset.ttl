        <http://example.org/education/concept/Tierverhalten>,
        <http://example.org/education/concept/Wald%C3%B6kologie>,
        <http://example.org/education/concept/Wintermonate> ;
    dcterms:title "Sachaufgaben zu dem Eichhörnchen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

