oer:7AkY3YU2dfbc a edu:LearningResource ;
    sim:similarTo oer:7GJbUAre7_4g ;
    dcterms:creator <http://example.org/education/person/Tosch> ;
    dcterms:description "Der Bericht beschreibt die Ergebnisse von Schlagzähigkeitsprüfungen an Kunststoffen nach DIN EN ISO 179-1:2010. Die Prüfungen wurden bei verschiedenen Temperaturen und mit einer Kerbe durchgeführt, um das Versagensverhalten der Werkstoffe PP und PS zu untersuchen. Durch die Auswertung der Ergebnisse können Rückschlüsse auf die Bedeutung von Temperatur und Kerbwirkung für das Bruchverhalten gezogen werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7AkY3YU2dfbc" ;
    dcterms:publisher <http://example.org/education/organization/Leichtbau> ;
    dcterms:subject <http://example.org/education/concept/Bruchmechanik>,
        <http://example.org/education/concept/Kerbschlagbiegeversuch>,
        <http://example.org/education/concept/Kunststoffpr%C3%BCfung>,
        <http://example.org/education/concept/Kunststofftechnologie>,
        <http://example.org/education/concept/Materialwissenschaft>,
        <http://example.org/education/concept/Mechanische_Eigenschaften>,
        <http://example.org/education/concept/Polypropylen>,
        <http://example.org/education/concept/Polystyrol>,
        <http://example.org/education/concept/Schlagz%C3%A4higkeit>,
        <http://example.org/education/concept/Werkstoffeigenschaften> ;
    dcterms:title "Kerbschlagbiegeversuch von Kunststoffen nach (DIN EN ISO 179-1:2010)"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:7Ao2uA-AAZz4 a edu:LearningResource ;
    sim:similarTo oer:9hz9f6wzzUk8 ;
    dcterms:creator <http://example.org/education/person/Rogalla> ;
    dcterms:description "Die pädagogischen Fachkräfte fördern ein positives Klima für Vielfalt, indem sie Unterschiede ebenso wie Gemeinsamkeiten mit Wertschätzung wahrnehmen und sichtbar machen. Durch die Anwendung von Prinzipien wie Gleichwürdigkeit, Respekt und Teilhabe können frühkindliche Bildungseinrichtungen zu einem lebendigen und zentralen Teil der Netzwerke im Gemeinwesen werden. Die Fachkräfte schaffen eine Atmosphäre, die alle Beteiligten zum Austausch und Aushandeln von Ideen und Vorschlägen einlädt und anregt, um ein gemeinsames Verständnis von hoher Betreuungs- und Bildungsqualität zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7Ao2uA-AAZz4" ;
    dcterms:subject <http://example.org/education/concept/Bildungsprozesse>,
        <http://example.org/education/concept/Diversity>,
        <http://example.org/education/concept/Eltern-Kind-Beziehung>,
        <http://example.org/education/concept/Fr%C3%BChkindliche_Bildung>,
        <http://example.org/education/concept/Fr%C3%BChp%C3%A4dagogik>,
        <http://example.org/education/concept/Gleichw%C3%BCrdigkeit>,
        <http://example.org/education/concept/Inklusion>,
        <http://example.org/education/concept/Interkulturalit%C3%A4t>,
        <http://example.org/education/concept/Kindertageseinrichtung>,
        <http://example.org/education/concept/soziale_Ungleichheit> ;
    dcterms:title "Diversity in Early Childhood Education and Training"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:7JVDQtYkuQZ4 a edu:LearningResource ;
    sim:similarTo oer:9m7itwCnb3l4 ;
    dcterms:creator <http://example.org/education/person/Baltrusaitis>,
        <http://example.org/education/person/Belting>,
        <http://example.org/education/person/de_Padova> ;
    dcterms:description "Die Renaissance brachte eine Neuorientierung der Mathematik und Kunst durch den Einfluss arabischer Wissenschaftler und die Entdeckung neuer Zahlen- und Schreibsysteme. Durch die Verbindung von Ost und West entstanden neue Kunstformen, wie die Perspektive, und exotische Luxusgüter wurden zu begehrten Objekten für europäische Fürstenhöfe. Dieses Material bietet Einblicke in die Geschichte der Mathematik, Kunst und Kultur während der Renaissance und ihre Verbindungen zu anderen Regionen und Zivilisationen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7JVDQtYkuQZ4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Afrika-Kunst>,
        <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Arithmetik>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Kunstgeschichte>,
        <http://example.org/education/concept/Mathematikgeschichte>,
        <http://example.org/education/concept/Osmanisches_Reich>,
        <http://example.org/education/concept/Perspektive>,
        <http://example.org/education/concept/Portugiesische_Entdeckungsreisen>,
        <http://example.org/education/concept/Renaissance> ;
    dcterms:title "Geometrie und Arithmetik."@de ;
    dcterms:type <http://example.org/education/type/Skript> .

