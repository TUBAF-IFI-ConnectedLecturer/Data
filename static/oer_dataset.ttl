    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung Triebfahrzeugtechnik behandelt die Antriebskonfigurationen von Fahrzeugen und ihre Leistungsübertragungsanlagen, um den Energiebedarf von Zugfahrten zu analysieren und zu optimieren. Durch das Studium dieser Materialien können Lernende die verschiedenen Betriebsregime und Wirkungsgrade von Antriebsträngen verstehen und erfahren, wie sie diese für eine effiziente und umweltfreundliche Fahrzeugtechnik nutzen können. Die Inhalte der Vorlesung umfassen Leistungsauslegung, Dieselmotor und andere Verbrennungskraftmaschinen, Hilfs- und Nebenbetriebe sowie Fallstudien unkonventioneller Triebfahrzeuge."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4bD2b8h2jqII" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Technik_spurgef%C3%BChrter_Fahrzeuge> ;
    dcterms:subject <http://example.org/education/concept/Antriebskonfigurationen>,
        <http://example.org/education/concept/Betriebsregime>,
        <http://example.org/education/concept/Energiebedarf_von_Zugfahrten>,
        <http://example.org/education/concept/Fahrstil>,
        <http://example.org/education/concept/Fahrweise>,
        <http://example.org/education/concept/Hilfsenergiebedarf>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragungsanlagen>,
        <http://example.org/education/concept/Schienenverkehrstechnik>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Wirkungsgrade> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

