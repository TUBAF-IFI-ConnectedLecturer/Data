        <http://example.org/education/concept/Produktionswirtschaft>,
        <http://example.org/education/concept/Serienfertigung>,
        <http://example.org/education/concept/Werkstattfertigung> ;
    dcterms:title "IL Produktionswirtschaft"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

