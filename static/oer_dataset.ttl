oer:3dLJ_98seTf0 a edu:LearningResource ;
    sim:similarTo oer:45iIERNE1aKM,
        oer:5AQgxJ4p2mNE,
        oer:6e-ebPshaJmA,
        oer:89Ki-acgAGxc,
        oer:8pD15DW0SNsc,
        oer:9EIGKdQppLZU ;
    dcterms:creator <http://example.org/education/person/G%C3%B6hler>,
        <http://example.org/education/person/Jasper> ;
    dcterms:description "Das Masterseminar \"Trends in Deep Learning\" an der TU Bergakademie Freiberg behandelt aktuelle Themen im Bereich des Deep Learning, wie Dataset Poisoning und Gegenmassnahmen, Text to 3D und Text to Speech Synthesizer. Die Teilnehmerinnen und Teilnehmer präsentieren ihre Forschungsarbeiten und erhalten Feedback von den Dozenten Volker G. Göhler und Heinrich Jasper. Durch die Auseinandersetzung mit aktuellen Forschungspapern und der Diskussion von Schwierigkeiten und Lösungen sollen die Studierenden ihr Wissen im Bereich des Deep Learning erweitern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3dLJ_98seTf0" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Modellierung>,
        <http://example.org/education/concept/Datenextraktion>,
        <http://example.org/education/concept/Datensicherheit>,
