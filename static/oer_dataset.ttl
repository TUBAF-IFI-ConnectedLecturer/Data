    dcterms:title "Softwaretechnik, WS2122"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:95oVHOylr-tw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Richter> ;
    dcterms:description "Die Hochschule Mittweida bietet umfassende Unterstützung für Studierende mit Familie, insbesondere durch Beratung und Informationen zu Mutterschutz, Elternzeit und Kinderbetreuung. Durch die Zertifizierung als familiengerechte Hochschule seit 2009 werden Maßnahmen zur Förderung von Studenten mit Familienaufgaben umgesetzt. Studierende können sich auf eine Vielzahl an Hilfestellungen verlassen, um ihr Studium erfolgreich mit Beruf und Familie zu vereinen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "95oVHOylr-tw" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_Mittweida> ;
    dcterms:subject <http://example.org/education/concept/Beruf_und_Familie>,
