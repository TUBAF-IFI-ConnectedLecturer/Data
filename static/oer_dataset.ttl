oer:6p5ptbsn-2Gs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schopenhauer> ;
    dcterms:description "Das Bildungsmaterial behandelt die Grundlagen der Datensicherheit und Kryptographie mit Hilfe des Open-Source-Projekts CrypTool 2. Durch die Verwendung von CrypTool 2 können Lernende logisches, abstraktes und kreatives Denken fördern und erste Schritte in der Verschlüsselung und Kryptoanalyse unternehmen. Ziel ist es, dass Lernende Risiken bei der Nutzung von Informatiksystemen erkennen und einfache Verschlüsselungsverfahren anwenden können."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "6p5ptbsn-2Gs" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Bildungsstandards>,
        <http://example.org/education/concept/Datenverschl%C3%BCsselung>,
        <http://example.org/education/concept/Informatiksysteme>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Informationssicherheit>,
        <http://example.org/education/concept/Kryptoanalyse>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Open-Source-Software>,
        <http://example.org/education/concept/Verschl%C3%BCsselungsverfahren> ;
    dcterms:title "Das ist CrypTool 2"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6sCEWh43OumY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hofmann> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Mediengestaltung und konzentriert sich auf die Erstellung und Gestaltung von Webpräsentationen mittels HTML, CSS und verschiedenen Autoren-Werkzeugen. Durch das Studium dieser Materialien werden Lernende in der Lage sein, eigene Webseiten zu erstellen und zu gestalten, sowie die Grundlagen von Hypertext und Hypermedia zu verstehen. Zudem werden sie mit verschiedenen Browsern und Autoren-Werkzeugen vertraut gemacht, um Inhalte effektiv zu präsentieren und zu verwalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6sCEWh43OumY" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Browser>,
        <http://example.org/education/concept/CSS-Stile>,
        <http://example.org/education/concept/Computergrafik>,
        <http://example.org/education/concept/E-Learning>,
