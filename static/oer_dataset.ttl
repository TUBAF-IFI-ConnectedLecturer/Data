        <http://example.org/education/concept/Leistungsauslegung>,
        <http://example.org/education/concept/Radsatzantriebe>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Verkehrswissenschaften>,
        <http://example.org/education/concept/Wirkungsgrade>,
        <http://example.org/education/concept/Zugf%C3%B6rderprogramme> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik Professur für Technik spurgeführter Fahrzeuge Dr.-Ing. Martin Kache Sommersemester 2021"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

