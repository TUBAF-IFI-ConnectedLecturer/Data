    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik behandelt die Bewegung von Fahrzeugen auf Schienen und umfasst die Analyse der Kräfte, die auf das Fahrzeug wirken, wie Antriebs-, Brems- und Massenträgheitskräfte. Durch das Verständnis dieser Kräfte können Ingenieure die Fahrdynamik von Fahrzeugen berechnen und optimieren, um eine sichere und effiziente Beförderung von Personen und Gütern zu gewährleisten. Der fahrdynamische Massenfaktor spielt dabei eine wichtige Rolle, da er die translatorische Masse eines Fahrzeugs beschreibt und somit Einfluss auf die Fahrdynamik hat."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "100-SFLXsJf9U" ;
    dcterms:publisher <http://example.org/education/organization/Nach_Durchsuchen_Des_Dokuments_Habe_Ich_Keine_Hinweise_Auf_Die_Herkunftsinstitution_Des_Autors_Gefunden._Daher_Gebe_Ich_Einen_Leeren_String_Zur%C3%BCck.> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Bremsentechnik>,
        <http://example.org/education/concept/Fahrzeugdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Widerstandskraft>,
        <http://example.org/education/concept/Zugkraft>,
        <http://example.org/education/concept/kinetische_Energie>,
        <http://example.org/education/concept/translatorische_Tragheit> ;
    dcterms:title "Fahrdynamik für Verkehrsingenieure (Teil 01)"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

