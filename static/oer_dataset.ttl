    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von spurgeführten Fahrzeugen wird anhand von Beispielen und Diagrammen erläutert, um die verschiedenen Arten der Leistungsübertragung bei Dieseltriebfahrzeugen zu veranschaulichen. Durch das Studium dieser Materialien können Lernende die Funktionsweise von Strömungsgetrieben und die Charakterisierung der hydrodynamischen Leistungsübertragung verstehen. Zudem werden die Voraussetzungen für eine verschleißfreie Anfahrmöglichkeit, hohe Zugkräfte und dauerhafte Ausnutzung der Dieselmotorleistung erläutert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "13BhdxB1JG7Jo" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Dieselmotoren>,
        <http://example.org/education/concept/Fahrzeugdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Getriebe>,
        <http://example.org/education/concept/Hydrodynamik>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Str%C3%B6mungsgetriebe>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

