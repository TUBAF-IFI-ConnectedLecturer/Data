oer:6VPE2ibB07gs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Brandt> ;
    dcterms:description "Die vorliegende Vorlesung behandelt die Didaktik der Arithmetik und bietet eine umfassende Einführung in Rechengesetze und Strategien für die Grundschuldidaktik Mathematik. Durch das Studium dieser Materialien können Lernende ein tiefes Verständnis der arithmetischen Operationen wie Addition, Subtraktion, Multiplikation und Division entwickeln und effektive Lösungsstrategien erlernen. Darüber hinaus werden Beispiele und Anwendungen aus dem Schulalltag vorgestellt, um die Umsetzung dieser Konzepte in der Praxis zu erleichtern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6VPE2ibB07gs" ;
    dcterms:subject <http://example.org/education/concept/Arithmetik>,
        <http://example.org/education/concept/Didaktische_Grundlagen>,
        <http://example.org/education/concept/Grundschuldidaktik>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Mathematiklernen>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Mathematische_Operationen>,
        <http://example.org/education/concept/Rechengesetze>,
        <http://example.org/education/concept/Strategien>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Didaktik der Arithmetik - Vorlesung Vertiefungsmodul LAGS-GSD-MA-VM1 Grundschuldidaktik Mathematik Prof. Dr. phil. Birgit Brandt Wintersemester 202425 8. Rechengesetze und Strategien"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

