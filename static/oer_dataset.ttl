        <http://example.org/education/concept/Rotations-Laser>,
        <http://example.org/education/concept/Teleskop-Messlatte>,
        <http://example.org/education/concept/Vermessungstechnik> ;
    dcterms:title "5. Vorlesung Vermessungslehre"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

