        <http://example.org/education/concept/Webshop>,
        <http://example.org/education/concept/Zahlungsoptionen> ;
    dcterms:title "Anforderungen für den Web-Shop BACK-UP die Bäckerei 2.0"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

