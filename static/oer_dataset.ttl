oer:7JrDusl_bEAU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Wilder> ;
    dcterms:description "Die Vorwärtstilgung ist ein Prozess, der elliptische Sätze und Wortketten erzeugt, indem gemeinsames Material zwischen Konjunkten entfernt wird, wobei die syntaktischen Beziehungen zwischen den Konstituenten erhalten bleiben. Durch das Verständnis dieser Prozesse können Lerner die Strukturen von Satzverknüpfungen und Wortfolgen in verschiedenen Sprachen besser analysieren und beschreiben. Insbesondere werden sie die Bedeutung von Parametern wie V2 und VOOV für die Wortstellungsunterschiede zwischen Deutsch und Englisch erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7JrDusl_bEAU" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Groningen> ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Ellipse>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Konjunktion>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Phrasenstruktur>,
        <http://example.org/education/concept/Satzstruktur>,
        <http://example.org/education/concept/Syntax>,
        <http://example.org/education/concept/Tilgung>,
        <http://example.org/education/concept/Wortstellung> ;
    dcterms:title "V2-Stellung und Ellipsen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7KuDn5PlIM_E a edu:LearningResource ;
    dcterms:description "Die Temperaturindizes von verschiedenen Isolierstoffen werden aufgeführt, einschließlich organischer und anorganischer Materialien. Durch das Studium dieser Liste können Lernende die thermischen Eigenschaften verschiedener Werkstoffe kennenlernen und ihre Anwendungsbereiche verstehen. Die Kenntnis dieser Werte ist für die Auswahl geeigneter Isolierstoffe in verschiedenen Anwendungen von Bedeutung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7KuDn5PlIM_E" ;
    dcterms:subject <http://example.org/education/concept/D%C3%A4mmstoffe>,
        <http://example.org/education/concept/Fasermaterialien>,
        <http://example.org/education/concept/Harze>,
        <http://example.org/education/concept/Isolierstoffe>,
        <http://example.org/education/concept/Kunststoffe>,
        <http://example.org/education/concept/Lacke>,
        <http://example.org/education/concept/Polymere>,
        <http://example.org/education/concept/Werkstoffeigenschaften>,
        <http://example.org/education/concept/anorganische_Verbindungen>,
        <http://example.org/education/concept/organische_Verbindungen> ;
    dcterms:title "Temperaturindizes von Isolierstoffen"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:7L8pWAFxWtec a edu:LearningResource ;
    dcterms:description "Das Arbeitsblatt behandelt das Verständnis von Demokratie und Herrschaft bei Max Weber und Aristoteles, indem es die Unterscheidung zwischen Macht und Herrschaft sowie verschiedene Typen legitimer Herrschaft erläutert. Durch die Analyse der politischen Theorien beider Denker können Lernende ein tieferes Verständnis davon gewinnen, was Demokratie bedeutet und wie sie als Staatsform legitimiert werden kann. Die Aufgaben und Fragen im Arbeitsblatt fördern das kritische Denken und die Fähigkeit, komplexe politische Konzepte zu vergleichen und zu analysieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7L8pWAFxWtec" ;
    dcterms:subject <http://example.org/education/concept/Demokratie>,
        <http://example.org/education/concept/Herrschaft>,
        <http://example.org/education/concept/Legitimation>,
        <http://example.org/education/concept/Politikwissenschaft>,
        <http://example.org/education/concept/Politische_Theorie>,
        <http://example.org/education/concept/Regierungslehre>,
        <http://example.org/education/concept/Soziologie>,
        <http://example.org/education/concept/Staatsformen>,
        <http://example.org/education/concept/Verfassungstypen>,
        <http://example.org/education/concept/politische_Philosophie> ;
    dcterms:title "Arbeitsblatt PBMB 23.02.2025 Klasse: 11. Klasse Leistungskurs"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

