    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik-Vorlesung behandelt die Grundlagen und Konzepte der Leistungsübertragung bei spurgeführten Fahrzeugen, insbesondere Dieselmotoren und ihre Charakteristik. Durch diese Vorlesung erwerben die Lernenden Kenntnisse über die verschiedenen Arten der Leistungsübertragung, die Notwendigkeit einer solchen Übertragung und die ideale Leistungsübertragung bei Dieselmotoren. Die Inhalte dieser Vorlesung dienen als Grundlage für die Bewertung des Traktionsvermögens und die Fahrzeugaufgaben in der Fahrdynamik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3HJ_cFtkpxJw" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Dieselmotoren>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrzeugelektrifizierung>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Traktionsverm%C3%B6gen>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9xEOKMBLiQXI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/L%C3%B6ffler> ;
    dcterms:description "Die Vorlesung behandelt die Baugruppen von Dieseltriebfahrzeugen und ihre Gliederungsprinzipien, um eine systematische Struktur für die Konstruktion und den Bau von Triebfahrzeugen zu schaffen. Durch das Studium dieser Inhalte können Lernende ein Verständnis der Hauptbaugruppen, Plattform- und Baukastenkonzepte sowie der Gliederungsprinzipien entwickeln, um die Konstruktion und den Bau von Triebfahrzeugen zu optimieren. Die Vorlesung bietet eine umfassende Übersicht über die Baugruppen von Dieseltriebfahrzeugen und ihre Anwendung in der Praxis."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9xEOKMBLiQXI" ;
    dcterms:subject <http://example.org/education/concept/Antriebssystem>,
        <http://example.org/education/concept/Baukastenkonzept>,
        <http://example.org/education/concept/Dieseltriebfahrzeug>,
        <http://example.org/education/concept/Energieanlage>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Gliederungsprinzip>,
        <http://example.org/education/concept/Lokomotive>,
        <http://example.org/education/concept/Plattformkonzept>,
        <http://example.org/education/concept/Schienenfahrzeug>,
        <http://example.org/education/concept/Triebfahrzeug> ;
    dcterms:title "Vorlesung Dieseltriebfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

