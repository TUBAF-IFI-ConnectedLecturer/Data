    dcterms:title "Workshop Bibliotheksmanagement mit Excel"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:136ksfrfwdsrw a edu:LearningResource ;
    sim:similarTo oer:13nDrYX69G20s ;
    dcterms:creator <http://example.org/education/person/Jan_Peprny> ;
    dcterms:description "Das Modul bietet Einblicke in das Leben und die Menschen der DDR, verdeutlicht die systematische Dopingpraxis und die gesundheitlichen Folgen für Leistungssportler. Durch authentische Erzählungen von Zeitzeugen wird die Manipulation und Ungerechtigkeit der DDR-Regierung aufgezeigt. Die Lernenden erhalten einen umfassenden Überblick über das Leben in der DDR und die Erfahrungen von Ostdeutschen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "136ksfrfwdsrw" ;
    dcterms:publisher <http://example.org/education/organization/SBB> ;
    dcterms:subject <http://example.org/education/concept/Alltag_in_der_DDR>,
        <http://example.org/education/concept/DDR>,
        <http://example.org/education/concept/Deutsche_Teilung>,
        <http://example.org/education/concept/Doping_im_Sport>,
        <http://example.org/education/concept/Geschichte_der_DDR>,
        <http://example.org/education/concept/Gesundheitliche_Folgen>,
        <http://example.org/education/concept/Integration_von_Ostdeutschen>,
        <http://example.org/education/concept/Lebensbedingungen_in_der_DDR>,
        <http://example.org/education/concept/Ostdeutsche_Bev%C3%B6lkerung>,
        <http://example.org/education/concept/Systematische_Doping> ;
    dcterms:title "Gesamtreflexion 125 Jahre DDR"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:13BemiKA6AyLk a edu:LearningResource ;
    sim:similarTo oer:13qBGiaX2iJBc ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Lernpaket behandelt die Definition und Minderung des Isoliervermögens in verschiedenen Isolationstypen wie Luft-, Flüssigkeits- und Feststoffisolierungen. Es werden Größen vorgestellt, die den Zufallsprozess Durchschlag beschreiben, sowie Methoden zur Ermittlung der Minderung des Isoliervermögens über die Lebensdauer. Durch das Lernpaket können Studierende Kenntnisse über die Statistik und Isolationskoordination erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "13BemiKA6AyLk" ;
    dcterms:subject <http://example.org/education/concept/Alterung_von_Materialien>,
        <http://example.org/education/concept/Durchschlag>,
        <http://example.org/education/concept/Elektroisolatoren>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Isolationskoordination>,
        <http://example.org/education/concept/Isolierung>,
        <http://example.org/education/concept/Isolierverm%C3%B6gen>,
        <http://example.org/education/concept/Spannungsfestigkeit>,
        <http://example.org/education/concept/Statistik> ;
    dcterms:title "SI Lernpaket 3 Beschreibung und Minderung des Isoliervermögens"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:13DZ334L7JCGQ a edu:LearningResource ;
    sim:similarTo oer:13Elbx0IjIyFM ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Lernpaket behandelt die Rechnungsgrundlagen der Elektroenergieübertragung und -verteilung, insbesondere den Unterschied zwischen Wirk- und Blindstrom sowie dem Real- und Imaginärteil des Stromes. Es erklärt den Begriff des konjugiert komplexen Stromes und seine Anwendung bei der Berechnung der komplexen Scheinleistung. Durch das Lernpaket können Studierende die Grundlagen der Elektroenergieübertragung und -verteilung verstehen und anwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "13DZ334L7JCGQ" ;
    dcterms:subject <http://example.org/education/concept/Blindleistung>,
        <http://example.org/education/concept/Elektroenergie%C3%BCbertragung>,
        <http://example.org/education/concept/Elektroenergieverteilung>,
        <http://example.org/education/concept/Energie%C3%BCbertragung>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Komplexe_Scheinleistung>,
        <http://example.org/education/concept/Rechnungsgrundlagen>,
        <http://example.org/education/concept/Stromarten>,
        <http://example.org/education/concept/Wechselstrom>,
        <http://example.org/education/concept/Wirkleistung> ;
    dcterms:title "Rechnungsgrundlagen Teil 2"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:13WqtTDPIb6fg a edu:LearningResource ;
    sim:similarTo oer:7iXbVrgKEqtA ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Lernpaket NuB 2 behandelt grundlegende Konzepte der Elektroenergie, einschließlich Funktionstüchtigkeit, Zuverlässigkeit und Sicherheit. Es erläutert die Kenngrößen des Produktes Elektroenergie und beschreibt die Auswirkungen von Über- und Unterangebot auf die Wirkleistung im Netz. Durch das Lernpaket können Studierende ein Verständnis der elektrotechnischen Grundlagen und ihrer Anwendung in Netzen und Betriebsmitteln erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "13WqtTDPIb6fg" ;
    dcterms:subject <http://example.org/education/concept/Betriebsmittel>,
        <http://example.org/education/concept/Elektroenergie>,
        <http://example.org/education/concept/Energieversorgung>,
