        <http://example.org/education/concept/Stahlbetonbau>,
        <http://example.org/education/concept/Tragwerksbemessung> ;
    dcterms:title "HEISSBEMESSUNG VON STAHLBETONBAUTEILEN"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

