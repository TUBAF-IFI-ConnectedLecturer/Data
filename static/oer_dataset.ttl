    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Diese Übungssammlung behandelt verschiedene Aspekte der Mathematik für Ingenieure, insbesondere die Entwicklung von Taylor-Polynomen und ihre Anwendung auf Funktionen, Integrale und Potenzreihen. Durch das Bearbeiten dieser Aufgaben können Lernende ihr Verständnis für die Approximation von Funktionen und die Lösung von Integralen verbessern und ihre Fähigkeiten in der mathematischen Modellierung und Analyse ausbauen. Die Übungssammlung umfasst sieben Aufgaben, die sich auf verschiedene Themenbereiche konzentrieren, darunter Taylor-Reihen, Potenzreihen, Integrale und Funktionen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4s5EobLvPAyc" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
