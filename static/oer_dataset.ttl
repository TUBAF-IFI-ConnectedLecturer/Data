        oer:7d-lFY-WAlqQ,
        oer:9oymdMlIaP4g ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Dieses Arbeitspapier behandelt grundlegende Konzepte der Linguistik und Sprachgeschichte des Deutschen, indem es syntaktische Kategorien, Strukturen und Funktionen von Wortgruppen und Sätzen analysiert. Durch die Bearbeitung von Aufgaben zu Themen wie Konstituentenanalyse, Ambiguität und Präpositionalphrasen sollen Studierende ihre Fähigkeiten in der Analyse und Beschreibung von sprachlichen Strukturen verbessern. Am Ende des Arbeitspapiers sollten die Lerner in der Lage sein, komplexe Nominalphrasen zu zerlegen, syntaktische Funktionen zu identifizieren und die Bedeutung von Sätzen zu analysieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12Ys9KuHvCH5U" ;
    dcterms:subject <http://example.org/education/concept/Ambiguit%C3%A4t>,
        <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Grammatiktheorie>,
        <http://example.org/education/concept/Konstituentenanalyse>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Nominalphrasen>,
        <http://example.org/education/concept/Pr%C3%A4positionalphrasen>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Syntaktische_Struktur>,
        <http://example.org/education/concept/Syntax> ;
    dcterms:title "UE Grundlagen der Linguistik und Sprachgeschichte des Deutschen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

