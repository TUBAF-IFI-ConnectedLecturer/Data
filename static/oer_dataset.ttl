        <http://example.org/education/concept/Reibung>,
        <http://example.org/education/concept/Schienenfahrzeugtechnik>,
        <http://example.org/education/concept/Schienenverkehrstechnik> ;
    dcterms:title "Bremsen der Schienenfahrzeuge (Grundlagen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

