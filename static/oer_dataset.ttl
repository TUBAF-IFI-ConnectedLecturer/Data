oer:8yTi_zfDDnfs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die Morphologische Sprachtypologie behandelt die Klassifizierung von Sprachen nach ihren morphologischen Eigenschaften, wie zum Beispiel der Bildung von Wortformen und der Verwendung von Affixen. Durch das Studium dieser Disziplin können Lernende die Struktur und Entwicklung von Sprachen besser verstehen und ihre Fähigkeiten in der kontrastiven Linguistik verbessern. Die vorgestellten Beispiele und Parameter dienen als Grundlage für die Analyse und Vergleich von Sprachen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8yTi_zfDDnfs" ;
    dcterms:subject <http://example.org/education/concept/Flexionsmorphologie>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Kontrastive_Analyse>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Morphologie>,
        <http://example.org/education/concept/Sprachbau>,
        <http://example.org/education/concept/Sprachtypologie>,
        <http://example.org/education/concept/Sprachvergleich>,
        <http://example.org/education/concept/Typologische_Klassifizierung>,
        <http://example.org/education/concept/Wortbildung> ;
    dcterms:title "Arbeitsauftrag 22.04.2025 26 Sr Sprachtypologie trifft kontrastive Linguistik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9hGH8PfBnKLQ a edu:LearningResource ;
    sim:similarTo oer:9wx8MYJu8q3I,
