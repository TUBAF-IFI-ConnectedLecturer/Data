        <http://example.org/education/concept/Selbststudium> ;
    dcterms:title "Was ist OPAL?"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:9qJhtPIwzkMI a edu:LearningResource ;
    dcterms:description "Dieses Lehrmaterial behandelt die Reaktionskinetik und bietet eine Einführung in die Grundlagen der chemischen Reaktionen, einschließlich der Boltzmann-Verteilung, Geschwindigkeitsgesetze und Reaktionsmechanismen. Durch das Studium dieses Materials können Lernende die Fähigkeit erwerben, komplexe chemische Prozesse zu analysieren und die Geschwindigkeit von Reaktionen zu berechnen. Darüber hinaus werden wichtige Konzepte wie die Aktivierungsenergie, Quasistationarität und enzymatische Katalyse behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9qJhtPIwzkMI" ;
    dcterms:subject <http://example.org/education/concept/Boltzmann-Verteilung>,
        <http://example.org/education/concept/Chemische_Kinetik>,
        <http://example.org/education/concept/Elementarreaktionen>,
        <http://example.org/education/concept/Enzymkatalyse>,
        <http://example.org/education/concept/Geschwindigkeitskonstante>,
        <http://example.org/education/concept/Kinetik>,
        <http://example.org/education/concept/Reaktionskinetik>,
        <http://example.org/education/concept/Reaktionsordnung>,
        <http://example.org/education/concept/Statistische_Mechanik>,
        <http://example.org/education/concept/Thermodynamik> ;
    dcterms:title "Reaktionskinetik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

