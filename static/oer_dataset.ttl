        <http://example.org/education/concept/Verteilungsma%C3%9Fe>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie> ;
    dcterms:title "Statistik und Quantitative Methoden BA Riesa Maria Neubauer 07.05.2021 Creative Commons: Attribution-NonComercial CC BY-NC"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

