        <http://example.org/education/concept/Schleifen>,
        <http://example.org/education/concept/Scratch>,
        <http://example.org/education/concept/Unterrichtsplanung> ;
    dcterms:title "Landesgymnasium für Sport"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:8LIqHTVgosnc a edu:LearningResource ;
    sim:similarTo oer:9NUSW9eh1Jc0 ;
    dcterms:description "Die Synchronmaschine kann als Generator und Motor arbeiten, aber auch als Phasenschieber, um die Qualität des Netzes zu verbessern, indem sie Blindleistung aufnimmt oder abgibt. Der Polradwinkel δp bestimmt den Arbeitszustand der Maschine, wobei ein größerer Winkel eine höhere Wirkleistungsabgabe bedeutet. Durch das Verständnis des vereinfachten Ersatzschaltbildes und des Leistungszeigerbildes können Lernende die Funktionsweise einer Synchronmaschine analysieren und ihre Anwendung in verschiedenen Bereichen erkennen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "8LIqHTVgosnc" ;
    dcterms:subject <http://example.org/education/concept/Blindleistung>,
        <http://example.org/education/concept/Drehfeld>,
        <http://example.org/education/concept/Drehstromgenerator>,
        <http://example.org/education/concept/Ersatzschaltbild>,
        <http://example.org/education/concept/Leistungsverlauf>,
        <http://example.org/education/concept/Phasenschieberbetrieb>,
        <http://example.org/education/concept/Polradwinkel>,
        <http://example.org/education/concept/Stromaufnahme>,
        <http://example.org/education/concept/Synchronmaschine>,
        <http://example.org/education/concept/Wirkleistung> ;
    dcterms:title "Die Drehstrom-Synchronmaschine"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

