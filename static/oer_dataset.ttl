    dcterms:title "serie2 aufg1 Hörrmann"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7osAefAvQOZU a edu:LearningResource ;
    sim:similarTo oer:9yDGII9Hh4gw ;
    dcterms:creator <http://example.org/education/person/Zitzelsberger> ;
    dcterms:description "Das Lehrmaterial behandelt die Grundlagen der Elektrotechnik und Aktorik, insbesondere die Drehfeldentstehung in elektrischen Maschinen und Antrieben. Durch das Studium dieses Materials können Lernende die Prinzipien der Drehfelderzeugung und -entwicklung verstehen und die verschiedenen Typen von Drehstrommaschinen und ihre Charakteristika kennenlernen. Zudem werden wichtige Konzepte wie Synchrondrehzahl, mechanische Drehzahl und Lorentzkraft erläutert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7osAefAvQOZU" ;
    dcterms:subject <http://example.org/education/concept/Asynchrone_Maschinen>,
        <http://example.org/education/concept/Drehstrommaschinen>,
        <http://example.org/education/concept/Dreiphasen-Wechselstrom>,
        <http://example.org/education/concept/Elektrische_Antriebe>,
        <http://example.org/education/concept/Elektromotoren>,
        <http://example.org/education/concept/Elektronisch_kommutierte_Maschinen>,
        <http://example.org/education/concept/Grundlagen_der_Aktorik>,
        <http://example.org/education/concept/Mechanische_Bewegungswandler>,
        <http://example.org/education/concept/Rotierende_Magnetfelder>,
        <http://example.org/education/concept/Synchrondrehzahl> ;
    dcterms:title "Lehrbriefe der Elektrotechnik Grundlagen der Aktorik Drehfeldentstehung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:84uCBSqtFirA a edu:LearningResource ;
    sim:similarTo oer:8dwfrj5jonVw,
