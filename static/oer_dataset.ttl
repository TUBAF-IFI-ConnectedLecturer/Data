        <http://example.org/education/concept/REST-API>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Systemintegration> ;
    dcterms:title "Vorlesung SCC, Microservices"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:12RfFRmtHZFA8 a edu:LearningResource ;
    sim:similarTo oer:12TLL4TPx8NDc,
        oer:3kcnKgnSAtpk,
