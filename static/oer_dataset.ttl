oer:155KKuNbsMW8Y a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Vercamer> ;
    dcterms:description "Die Geschichte der \"Vergifteten Schönen\" lehrt, dass ein Mensch durch seine Tugenden und sein Verhalten gegenüber den Versuchungen des Teufels, der Welt und des Fleisches stark und kraftvoll sein kann. Durch die Erzählung wird verdeutlicht, wie wichtig es ist, sich von Luxus und Gier zu lösen und ein reines Leben zu führen. Der Text bietet eine moralische Lehre, die den Leser dazu anregt, sein Verhalten zu überdenken und sich auf das ewige Leben vorzubereiten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "155KKuNbsMW8Y" ;
    dcterms:subject <http://example.org/education/concept/Aristoteles>,
        <http://example.org/education/concept/Christentum>,
        <http://example.org/education/concept/Gier>,
        <http://example.org/education/concept/Gift>,
        <http://example.org/education/concept/Luxus>,
        <http://example.org/education/concept/Moral>,
        <http://example.org/education/concept/Philosophie>,
        <http://example.org/education/concept/S%C3%BCnde>,
        <http://example.org/education/concept/Sch%C3%B6nheit>,
        <http://example.org/education/concept/Tugenden> ;
    dcterms:title "Die vergiftete Schöne"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:1574FDAzWnTWM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Orff> ;
    dcterms:description "Das Gedicht \"Fortuna\" beschreibt die Unbeständigkeit des Schicksals und die Macht der Fortuna, die das Leben eines Menschen bestimmt. Es thematisiert den Wechsel zwischen Armut und Reichtum, Erfolg und Misserfolg und die Unzuverlässigkeit des Glücks. Durch die Lektüre dieses Gedichts können Leser Einsichten in die antike Philosophie und die Rolle der Fortuna im Leben gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1574FDAzWnTWM" ;
    dcterms:subject <http://example.org/education/concept/Carmina_Burana>,
        <http://example.org/education/concept/Fortuna>,
        <http://example.org/education/concept/Gl%C3%BCck>,
        <http://example.org/education/concept/Lebensphilosophie>,
        <http://example.org/education/concept/Lyrik>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Moralit%C3%A4t>,
