        <http://example.org/education/concept/Phonologie>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Soziolinguistik>,
        <http://example.org/education/concept/Sprachgeschichte>,
        <http://example.org/education/concept/Sprachwissenschaft> ;
    dcterms:title "Grundlagen der Bibliographischen Katalogisierung und Indexierung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:12xcrCWQqopAU a edu:LearningResource ;
    sim:similarTo oer:14AVGAS2wSSVY,
