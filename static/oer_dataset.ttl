        <http://example.org/education/concept/Unterrichtshilfen>,
        <http://example.org/education/concept/Verbformen> ;
    dcterms:title "Interaktive App Link"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:4_ZRZyptzPsg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Teuscher> ;
    dcterms:description "Die Kurzschlussstromberechnung ermöglicht die Berechnung von Impedanzen in ruhenden Betriebsmitteln wie Leitungen und Transformatoren. Durch die Verwendung symmetrischer Impedanzen können unsymmetrische Netzzustände berechnet werden, wobei die Mit-, Gegen- und Nullimpedanz bestimmt werden können. Dieses Lernpaket vermittelt das notwendige Wissen zur Anwendung der Kurzschlussstromberechnung nach DIN VDE 0102 in der Elektrotechnik."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "4_ZRZyptzPsg" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Betriebsmittel>,
        <http://example.org/education/concept/Elektromagnetische_Vertr%C3%A4glichkeit>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Impedanz>,
        <http://example.org/education/concept/Kurzschlussstrom>,
        <http://example.org/education/concept/Leitungen>,
        <http://example.org/education/concept/Netzanalyse>,
        <http://example.org/education/concept/Stromberechnung>,
        <http://example.org/education/concept/Transformatoren> ;
    dcterms:title "Kurzschlussstromberechnung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

