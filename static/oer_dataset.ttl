        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Jugendbibliothek>,
        <http://example.org/education/concept/Kinderbibliothek>,
        <http://example.org/education/concept/Lese_F%C3%B6rderung>,
        <http://example.org/education/concept/Raumakustik> ;
    dcterms:title "Leseförderung in der Kita und Grundschule durch Bibliotheken"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

oer:5ld7qvUw7dK8 a edu:LearningResource ;
    sim:similarTo oer:5ywxA1v0Ste4 ;
    dcterms:creator <http://example.org/education/person/Bosse> ;
    dcterms:description "Das Workshop-Material behandelt die wissenschaftliche Schreibweise und gibt Einblick in die Geschichte der Wissenschaftssprache, um die Herausforderungen bei der Verwendung einer neutralen Sprache zu verstehen. Durch die Auseinandersetzung mit den drei Verboten - Ich-Verbot, Metaphernverbot und Erzählverbot - sollen Studierende lernen, ihre Texte objektiv und sachlich zu gestalten. Am Ende des Workshops können Teilnehmer ihre Fähigkeiten im wissenschaftlichen Schreiben verbessert haben und wissen, wie sie ihre Argumente klar und überzeugend präsentieren können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5ld7qvUw7dK8" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Akademische_Kommunikation>,
        <http://example.org/education/concept/Germanistische_Linguistik>,
        <http://example.org/education/concept/Hochschuldidaktik>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Rhetorik>,
        <http://example.org/education/concept/Schreibwerkstatt>,
        <http://example.org/education/concept/Textanalyse>,
        <http://example.org/education/concept/Wissenschaftliche_Fachsprache>,
        <http://example.org/education/concept/Wissenschaftliches_Schreiben>,
        <http://example.org/education/concept/Wissenschaftssprache> ;
    dcterms:title "Wie schreibe ich wissenschaftlich?"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5vkMIAg_irkY a edu:LearningResource ;
