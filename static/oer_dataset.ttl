oer:6gpGqBpmi7d8 a edu:LearningResource ;
    sim:similarTo oer:7Gflv_c218zc ;
    dcterms:creator <http://example.org/education/person/Fischer>,
        <http://example.org/education/person/Vo%C3%9F-B%C3%B6hme> ;
    dcterms:description "Diese Hausaufgabe zum Thema Wirtschaftsmathematik II behandelt die Kostenfunktion einer Cocktailbar und ihre Auswirkungen auf die Produktion und den Gewinn. Durch die Lösung der verschiedenen Aufgaben können Studierende ihre Kenntnisse in der Anwendung von mathematischen Konzepten wie Elastizität, Grenzkostenfunktion und Newton-Verfahren verbessern. Am Ende können sie die optimale Produktionsmenge und den maximalen Gewinn für die Cocktailbar bestimmen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6gpGqBpmi7d8" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Cocktailindustrie>,
        <http://example.org/education/concept/Elastizit%C3%A4t>,
        <http://example.org/education/concept/Gewinnfunktion>,
        <http://example.org/education/concept/Grenzkosten>,
        <http://example.org/education/concept/Kostenfunktion>,
        <http://example.org/education/concept/Mathematische_%C3%96konomie>,
        <http://example.org/education/concept/Newton-Verfahren>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/St%C3%BCckkosten>,
        <http://example.org/education/concept/Wirtschaftsmathematik> ;
    dcterms:title "Wirtschaftsmathematik II Hausaufgabe 3"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6i66IliLZt8A a edu:LearningResource ;
    sim:similarTo oer:8hNtsogSOgH0 ;
    dcterms:creator <http://example.org/education/person/Urbas> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen von Datenstrukturen und ihre Implementierung in Mikrorechnern, einschließlich Feldern, Strukturen, Bitfeldern und dynamischen Datenstrukturen. Durch das Studium dieser Materialien können Lerner die Konzepte und Techniken erlernen, um effiziente und zuverlässige Programme für Mikrorechner zu entwickeln. Insbesondere werden die Aspekte der Adressierung, des Speichermanagements und der Zugriffstechniken auf Peripheriegeräte wie GPIOs behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6i66IliLZt8A" ;
    dcterms:subject <http://example.org/education/concept/Arrays>,
