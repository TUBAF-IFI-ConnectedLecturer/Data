oer:9aggXCl1eGzc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Scheffel> ;
    dcterms:description "Das Seminar \"Differentielle und Persönlichkeitspsychologie\" behandelt die Anwendungsfelder der Differentiellen Psychologie, einschließlich Klinischer Psychologie, Potenzialdiagnostik und Forschung, und vermittelt Kenntnisse über Intelligenztheorien, -tests und -bereiche. Durch das Seminar sollen Studierende in die Lage versetzt werden, Vorlesungsinhalte aufzuarbeiten, praktische Fragen zu beantworten und sich auf die Prüfung vorzubereiten. Neben der Vermittlung von Fachwissen bietet das Seminar auch Möglichkeiten zum Austausch, zur Diskussion und zur Entwicklung eigener Ideen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9aggXCl1eGzc" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Biopsychologie>,
        <http://example.org/education/concept/Differentielle_Psychologie>,
        <http://example.org/education/concept/Emotionsregulation>,
        <http://example.org/education/concept/Experimentalpsychologie>,
        <http://example.org/education/concept/Intelligenztest>,
        <http://example.org/education/concept/Klinische_Psychologie>,
        <http://example.org/education/concept/Lehrmaterialien>,
        <http://example.org/education/concept/Offene_Wissenschaft>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitspsychologie>,
        <http://example.org/education/concept/Reproduzierbare_Forschung> ;
    dcterms:title "S.PP 01 Einführung und Überblick Differentielle und Persönlichkeitspsychologie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9eaZL3SsAYMY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Spallek> ;
    dcterms:description "Die Speicherhierarchie im Computer besteht aus verschiedenen Ebenen, von Registern über Cache und Pufferspeicher bis hin zu Haupt- und Sekundärspeichern, die sich durch ihre Kapazität, Zugriffszeit und Bandbreite unterscheiden. Durch die Verwendung von Caches kann die Geschwindigkeit des Speicherzugriffs erhöht werden, indem häufig benötigte Daten in einem schnellen Zwischenspeicher vorgehalten werden. Die Verwaltung des Stapelspeichers erfolgt durch den Stack Pointer, der die aktuelle Position im Stapel markiert und es ermöglicht, Daten auf den Stapel zu pushen oder von ihm zu poppen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9eaZL3SsAYMY" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Cache-Speicher>,
        <http://example.org/education/concept/Computer-Hardware>,
        <http://example.org/education/concept/Datenspeicherung>,
        <http://example.org/education/concept/Hauptspeicher>,
        <http://example.org/education/concept/Prozessor-_Architektur>,
        <http://example.org/education/concept/Rechnerstrukturen>,
        <http://example.org/education/concept/Registersatz>,
        <http://example.org/education/concept/Speicherarchitektur>,
        <http://example.org/education/concept/Speicherhierarchie>,
        <http://example.org/education/concept/Stack> ;
    dcterms:title "Speicherarchitektur und -organisation"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9hWZpjyhQa-o a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Gatzka>,
        <http://example.org/education/person/Koch>,
        <http://example.org/education/person/Probst> ;
    dcterms:description "Die Technische Universität Dresden versteht sich als ein Ort der Begegnungen, an dem vielfältige Möglichkeiten für Lernen, Lehren und Forschen gegeben sind sowie wissenschaftlicher und sozialer Austausch gelebt wird. Durch die Gestaltung des Campus mit seinen Gebäuden, Wegen und Grünflächen bietet die Universität individuelle und interaktionsfördernde Lerngelegenheiten, um Studierende auf ein Leben und Arbeiten im globalen Kontext vorzubereiten. Die TU Dresden fördert eine diversitäts sensible Lehre, die flexible und personalisierte Lehr- und Lernangebote bietet, um die Vielfalt der Studierenden zu adressieren und ihre Persönlichkeitsentwicklung zu fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9hWZpjyhQa-o" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bildungsort>,
        <http://example.org/education/concept/Diversit%C3%A4tssensible_Lehre>,
        <http://example.org/education/concept/Hochschulbildung>,
        <http://example.org/education/concept/Professionalisierung_der_Lehre>,
        <http://example.org/education/concept/Qualit%C3%A4tsentwicklung>,
        <http://example.org/education/concept/Studiengangsentwicklung>,
        <http://example.org/education/concept/akademische_Freiheit>,
        <http://example.org/education/concept/ationalit%C3%A4t_der_Lehre>,
        <http://example.org/education/concept/gesellschaftlich_verantwortungsvolle_Lehre>,
        <http://example.org/education/concept/lebensbegleitendes_Studieren> ;
    dcterms:title "Vision für die Lehre an der TU Dresden"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:9k53HCsrC_aw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Cramer> ;
    dcterms:description "Diese Übung behandelt das Denken als Berechnung und umfasst vier Aufgaben, die die Analogie zwischen dem boojum-Beispiel und der PROCX-Prozedur, die Definition von Prozessen sowie die Fähigkeit, bestimmte Probleme eigenständig zu lösen, abprüfen. Durch das Bearbeiten dieser Aufgaben können Lernende ihr Verständnis für die Umsetzung von Algorithmen und die Lösung komplexer Probleme verbessern. Die Übung eignet sich insbesondere für Informatik-Studierende, um ihre Fähigkeiten in der Programmierung und Algorithmik zu trainieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9k53HCsrC_aw" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Automaten>,
        <http://example.org/education/concept/Berechnung>,
        <http://example.org/education/concept/Bildverarbeitung>,
        <http://example.org/education/concept/Computerprogrammierung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Primzahlen>,
        <http://example.org/education/concept/Python>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Denken als Berechnung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9pSrGXmMyg5o a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Felsmann>,
        <http://example.org/education/person/Wirth> ;
    dcterms:description "Die Photovoltaik spielt eine zentrale Rolle bei der Energiewende und dem Übergang zu erneuerbaren Energien, wobei Deutschland bereits einen bedeutenden Anteil an erneuerbarer Energie produziert. Durch den Einsatz von PV-Anlagen können private Haushalte und gewerbliche Verbraucher ihren Eigenverbrauch decken und sogar Überschüsse in das Stromnetz einspeisen. Die Lektüre bietet Einblicke in die technischen Aspekte der Photovoltaik, den Energiemarkt und die Möglichkeiten zur Energiespeicherung, um die Umstellung auf erneuerbare Energien zu fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9pSrGXmMyg5o" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_a_Reference_To_The_Author%27s_Institution%3A%22leipziger_Institut_F%C3%BCr_Energie_Und_Umwelt_Ggmbh%22so__The_Institution_Is_%22leipziger_Institut_F%C3%BCr_Energie_Und_Umwelt_Ggmbh%22.> ;
    dcterms:subject <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Energiemarkt>,
        <http://example.org/education/concept/Energiespeicher>,
        <http://example.org/education/concept/Erneuerbare_Energien>,
        <http://example.org/education/concept/Nachhaltige_Energie>,
        <http://example.org/education/concept/Photovoltaik>,
        <http://example.org/education/concept/Prim%C3%A4renergie>,
        <http://example.org/education/concept/Solarenergie>,
        <http://example.org/education/concept/Stromerzeugung>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Anwendungen der Physik Photovoltaik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:9sDb5Y_aRCJs a edu:LearningResource ;
    dcterms:description "Die Entstehung von Bibliotheken und Büchereien in Europa während der Renaissance wird beschrieben, insbesondere die Entwicklung von Hofbibliotheken und ihre Bedeutung für die Bildung und das Lesepublikum. Die Reformation förderte die Bildung und ermöglichte mehr Menschen, selbst die Bibel zu lesen, was zu einer Zunahme des Lesepublikums führte. Durch die Lektüre dieses Textes können Lernende die Geschichte der Bibliotheken und ihre Bedeutung für die Gesellschaft verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9sDb5Y_aRCJs" ;
    dcterms:subject <http://example.org/education/concept/Bibliotheksentwicklung>,
        <http://example.org/education/concept/Bibliotheksgeschichte>,
        <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Buchdruck>,
        <http://example.org/education/concept/Fr%C3%BChe_Neuzeit>,
        <http://example.org/education/concept/Geschichte_des_Lesens>,
        <http://example.org/education/concept/Hofbibliotheken>,
        <http://example.org/education/concept/Lesen>,
        <http://example.org/education/concept/Reformation>,
        <http://example.org/education/concept/Renaissance> ;
    dcterms:title "Lesen in der Renaissance"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:9uoS64AUfbAY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die historische Semantik des Deutschen behandelt die Entlehnungen von Fremdwörtern und ihre Bedeutungsentwicklungen im Laufe der Zeit. Durch die Analyse von Lehnwörtern, Lehnbildungen und Lehnbedeutungen wird die Entwicklung des deutschen Wortschatzes im Kontext von Missionierungswellen und Bildungsreformen aufgezeigt. Die Lernenden gewinnen Einblick in die historische Schichtung des deutschen Wortschatzes und verstehen, wie christliche Vorstellungen die Bedeutung germanischer Ausdrücke beeinflusst haben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9uoS64AUfbAY" ;
    dcterms:publisher <http://example.org/education/organization/Sr_Historische_Semantik> ;
    dcterms:subject <http://example.org/education/concept/Althochdeutsch>,
        <http://example.org/education/concept/Christentum>,
        <http://example.org/education/concept/Fr%C3%BChmittelalter>,
        <http://example.org/education/concept/Germanische_Mythologie>,
        <http://example.org/education/concept/Historische_Semantik>,
        <http://example.org/education/concept/Karolingische_Renaissance>,
        <http://example.org/education/concept/Lehnw%C3%B6rter>,
        <http://example.org/education/concept/Mittelalterliche_Literatur>,
        <http://example.org/education/concept/Religionsgeschichte>,
        <http://example.org/education/concept/Sprachentwicklung> ;
    dcterms:title "Entlehnungen in ahd. und asächs. Zeit"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

