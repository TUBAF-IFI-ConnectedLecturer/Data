        <http://example.org/education/concept/Pflanzenverwendung>,
        <http://example.org/education/concept/Stauden>,
        <http://example.org/education/concept/Zierpflanzen> ;
    dcterms:title "LB 120 Pflanzenkunde- und Pflanzenverwendung Lehrgebiet Pflanzenverwendung in der Landschaftsarchitektur Prüfungsliste für das Wintersemester 202021"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6Z4w4nrMk_dA a edu:LearningResource ;
    sim:similarTo oer:6ie9p_PgoZKs,
        oer:6uLDAc9ylARY,
