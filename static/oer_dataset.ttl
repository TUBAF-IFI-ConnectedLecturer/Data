        <http://example.org/education/concept/Matrizen>,
        <http://example.org/education/concept/Vollst%C3%A4ndige_Induktion> ;
    dcterms:title "Hochschule für Technik und Wirtschaft Dresden"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

