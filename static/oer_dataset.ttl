oer:8gBRggtzBxs8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Kolloidchemischen Grundlagen der Nanotechnologie II behandeln die Wechselwirkungen zwischen Partikeln und die Stabilität von Suspensionen, wobei elektrostatische, sterische und elektrosterische Effekte eine Rolle spielen. Durch das Verständnis dieser Phänomene können Learner die Eigenschaften von Nanopartikeln und ihre Anwendungen in verschiedenen Industrien besser verstehen. Die Vorlesung bietet einen Überblick über die wichtigsten Konzepte und Mechanismen der Kolloidchemie, um die Stabilität von Suspensionen zu beeinflussen und zu steuern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8gBRggtzBxs8" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Elektrochemische_Doppelschicht>,
        <http://example.org/education/concept/Flockung>,
        <http://example.org/education/concept/Koagulation>,
        <http://example.org/education/concept/Kolloidchemie>,
        <http://example.org/education/concept/Nanotechnologie>,
        <http://example.org/education/concept/Partikel-Partikel-Wechselwirkungen>,
        <http://example.org/education/concept/Sedimentation>,
        <http://example.org/education/concept/Sterische_Wechselwirkung>,
        <http://example.org/education/concept/Suspensionsstabilit%C3%A4t>,
        <http://example.org/education/concept/Verfahrenstechnik> ;
    dcterms:title "Kolloidchemische Grundlagen der Nanotechnologie II"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

