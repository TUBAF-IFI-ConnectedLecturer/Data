oer:4kv_qpC94mdY a edu:LearningResource ;
    sim:similarTo oer:5ySw59JFdyX4,
        oer:6CRJOBIRXuzc ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Grenzflächenphänomene\" behandelt elektrokinetische Phänomene und Messmethoden an Grenzflächen, einschließlich des Zetapotenzials, Elektrophorese und Elektroakustik. Durch das Studium dieser Materialien erwerben die Lernenden Kenntnisse über die Prinzipien elektrokinetischer Phänomene und Messmethoden sowie ihre Anwendungen in der Verfahrenstechnik und Umwelttechnik. Die Inhalte umfassen auch die theoretischen Grundlagen, experimentelle Methoden und Anwendungsbereiche elektrokinetischer Phänomene in verschiedenen Systemen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4kv_qpC94mdY" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen_Institut_f%C3%BCr_Verfahrenstechnik_und_Umwelttechnik> ;
    dcterms:subject <http://example.org/education/concept/Doppelschichttheorie>,
        <http://example.org/education/concept/Elektrokinetik>,
        <http://example.org/education/concept/Elektroosmose>,
        <http://example.org/education/concept/Elektrophorese>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenph%C3%A4nomene>,
        <http://example.org/education/concept/Kolloidchemie>,
        <http://example.org/education/concept/Oberfl%C3%A4cheneigenschaften>,
        <http://example.org/education/concept/Partikelcharakterisierung>,
        <http://example.org/education/concept/Zetapotenzial>,
        <http://example.org/education/concept/elektroakustische_Effekte> ;
    dcterms:title "Grenzflächenphänomene"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5Bn358vc02qk a edu:LearningResource ;
    sim:similarTo oer:5R2Md8YTmf5U,
        oer:5qfqH8dzOnSo,
        oer:5yyvjwjCtsFY,
        oer:7ctOcMa3POzY ;
    dcterms:creator <http://example.org/education/person/Munke> ;
    dcterms:description "Die Zusammenarbeit zwischen wissenschaftlichen Bibliotheken und Wiki-Communitys kann zu einer umfassenden digitalen Landeskunde beitragen, indem sie die Vernetzung von Quellen und die Bereitstellung von Wissen fördert. Durch die gemeinsame Arbeit an Projekten wie dem Personen.Wiki oder der Plattform Saxorum können Bibliothekare und Wiki-Aktivisten ihre Kompetenzen bündeln und ein umfassendes Bild der regionalen Geschichte und Kultur erstellen. Durch die Nutzung dieser Ressourcen können Lernende einen tiefgreifenden Einblick in die sächsische Landeskunde gewinnen und ihre Kenntnisse über die Region erweitern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Bn358vc02qk" ;
    dcterms:subject <http://example.org/education/concept/Bibliotheksarbeit>,
        <http://example.org/education/concept/Deutsche_Geschichte>,
        <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Kulturgeschichte>,
        <http://example.org/education/concept/Landesbibliothek>,
        <http://example.org/education/concept/Online-Publikationen>,
        <http://example.org/education/concept/Regionalbibliographie>,
        <http://example.org/education/concept/Sachsen>,
        <http://example.org/education/concept/Wiki>,
        <http://example.org/education/concept/Wissenschaftliche_Zeitschriften> ;
    dcterms:title "Gemeinsame Wege bei der Erschließung von Wissen: Bibliotheken und Wikimedia im Dialog"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:5H9zSes8VAZc a edu:LearningResource ;
    sim:similarTo oer:5Nu8OPQbwO84,
