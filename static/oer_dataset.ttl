oer:8argUd-e6xbc a edu:LearningResource ;
    sim:similarTo oer:9eUm73rJk1II,
        oer:9ysxFnUUqULY ;
    dcterms:creator <http://example.org/education/person/Kl%C3%A4ffling>,
        <http://example.org/education/person/Riedel> ;
    dcterms:description "Der Workshop \"Lernen leicht gemacht!\" bietet Studierenden einen Überblick über verschiedene Lerntechniken und Strategien, um sie bei der Auswahl geeigneter Methoden für ihr individuelles Lernen zu unterstützen. Durch die Teilnahme am Workshop können die Lernenden ihre eigenen Stärken und Schwächen erkennen, konkrete Methoden kennenlernen und reflektieren, sowie eine individuelle Sammlung an Lerntechniken erstellen. Ziel ist es, die Studierenden zu motivieren, sich selbstständig mit geeigneten Lerntechniken auseinanderzusetzen und ihre Lernprozesse erfolgreich zu meistern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8argUd-e6xbc" ;
    dcterms:publisher <http://example.org/education/organization/TUD> ;
    dcterms:subject <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Lernprozess>,
        <http://example.org/education/concept/Lernstrategien>,
        <http://example.org/education/concept/Lerntechniken>,
        <http://example.org/education/concept/Methodenlernen>,
        <http://example.org/education/concept/Selbstreflexion>,
        <http://example.org/education/concept/Studienberatung>,
        <http://example.org/education/concept/Studierende>,
        <http://example.org/education/concept/Workshop> ;
    dcterms:title "Lernen leicht gemacht!"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9aG6x_KvBAzw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Einführung in die Verfahrenstechnik und Naturstofftechnik\" behandelt die Grundlagen der Mechanischen Verfahrenstechnik und bietet einen Überblick über die verschiedenen Aspekte des Fachgebiets, einschließlich disperter Stoffsysteme, mechanischer Grundoperationen und Prozessmesstechnik. Durch diese Lehrveranstaltung sollen Studierende ein grundlegendes Verständnis der Mechanischen Verfahrenstechnik erwerben und in die Lage versetzt werden, komplexe Probleme interdisziplinär zu lösen. Die Vorlesung bereitet die Studierenden auf ihre weitere akademische und berufliche Laufbahn vor."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9aG6x_KvBAzw" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Chemieingenieurwesen>,
        <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Filtration>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Naturstofftechnik>,
        <http://example.org/education/concept/Partikeltechnologie>,
        <http://example.org/education/concept/Porosit%C3%A4t>,
        <http://example.org/education/concept/Prozessmesstechnik>,
        <http://example.org/education/concept/Sedimentation>,
        <http://example.org/education/concept/Verfahrenstechnik> ;
    dcterms:title "Einführung in die Verfahrenstechnik und Naturstofftechnik 1-1 Mechanische Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

