    dcterms:creator <http://example.org/education/person/Kurschner>,
        <http://example.org/education/person/Muller> ;
    dcterms:description "Diese Mathematik-Aufgaben für Bauingenieure umfassen drei Teile mit insgesamt 30 erreichbaren Punkten und behandeln Themen wie Gleichungen, Trigonometrie und Vektoren. Durch die Lösung dieser Aufgaben können Studierende ihre Fähigkeiten in der mathematischen Problemlösung verbessern und ihr Verständnis von algebraischen und geometrischen Konzepten erweitern. Die Aufgaben sind so gestaltet, dass sie logische Denkweise und Nachvollziehbarkeit des Lösungsweges fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8OC-fJCC9kvU" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Bauingenieurwesen>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Gleichungen>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Linearkombinationen>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Trigonometrie>,
        <http://example.org/education/concept/Vektoren> ;
    dcterms:title "Mathematik I für Bauingenieure WS 2023/2024"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

