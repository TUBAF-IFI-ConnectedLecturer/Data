        <http://example.org/education/concept/Reliquienverehrung>,
        <http://example.org/education/concept/Sterbekultur>,
        <http://example.org/education/concept/Totenmesse>,
        <http://example.org/education/concept/Trauerarbeit> ;
    dcterms:title "Tod und Begräbnis"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

