oer:5FxWUI4Mz_5w a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Griebenow> ;
    dcterms:description "Das Bode-Diagramm ist ein graphisches Werkzeug, das den Frequenzgang eines Systems als Amplituden- und Phasengang in zwei getrennten Diagrammen darstellt. Durch die Anwendung des Bode-Diagramms können Frequenzgänge von Systemen analysiert und verständlich gemacht werden. Das Diagramm ermöglicht es, die Amplitude und Phase eines Signals in Abhängigkeit von der Frequenz zu untersuchen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5FxWUI4Mz_5w" ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cbertragungsfunktion>,
        <http://example.org/education/concept/Amplituden-Phasen-Diagramm>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Frequenzanalyse>,
        <http://example.org/education/concept/Frequenzgang>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Regelungstechnik>,
        <http://example.org/education/concept/Signalverarbeitung>,
        <http://example.org/education/concept/Systemanalyse>,
        <http://example.org/education/concept/Technische_Mechanik> ;
    dcterms:title "Das Bode-Diagramm"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:5GFAilvIjXo8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Das Verbalsystem von Mittelniederdeutsch wird beschrieben, insbesondere die Präteritopräsentien, die präteritale Formen mit präsentischer Bedeutung haben. Die Bildung dieser Verben wird erläutert, einschließlich Beispielen wie \"witan\" und \"weid-\". Durch das Studium dieses Materials können Lerner die grammatischen Strukturen von Mittelniederdeutsch besser verstehen und ihre Fähigkeiten in der Sprache verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5GFAilvIjXo8" ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Fr%C3%BChneuhochdeutsch>,
        <http://example.org/education/concept/Germanische_Sprachen>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Historische_Sprachforschung>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Mittelniederdeutsch>,
        <http://example.org/education/concept/Philologie>,
        <http://example.org/education/concept/Pr%C3%A4teritopr%C3%A4sentien>,
        <http://example.org/education/concept/Verbalsystem> ;
    dcterms:title "Verbalsystem 4 Mittelniederdeutsche Präteritopräsentien"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:5H1ubkTR2Uis a edu:LearningResource ;
    dcterms:description "Cyber-Mobbing wird als absichtliches Beleidigen, Bedrohen, Bloßstellen oder Belästigen anderer mittels elektronischer und mobiler Dienste definiert, wodurch Opfer oft verschlossen und zurückgezogen werden. Die Langzeit-Folgen können gravierend sein und zu psychischen Krankheiten wie Angststörungen führen. Durch diese App erhalten Jugendliche konkrete Verhaltenstipps und Unterstützung, um gegen Cyber-Mobbing vorzugehen und sich dagegen zu wehren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5H1ubkTR2Uis" ;
    dcterms:subject <http://example.org/education/concept/Bedrohung>,
        <http://example.org/education/concept/Bel%C3%A4stigung>,
        <http://example.org/education/concept/Beleidigung>,
        <http://example.org/education/concept/Cyber-Mobbing>,
        <http://example.org/education/concept/Jugendliche>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Mobbing>,
        <http://example.org/education/concept/Online-Sicherheit>,
        <http://example.org/education/concept/Psychische_Gesundheit>,
        <http://example.org/education/concept/Strafrecht> ;
    dcterms:title "CYBER-MOBBING"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:5HnBiJhnznGY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Khoi> ;
    dcterms:description "In dieser Simulation übernehmen die Teilnehmer Rollen von Lobbyisten und Vertretern von Bundesministerien, um ihre Interessen zu vertreten und über die Verteilung eines Sonderfonds von 50 Milliarden Euro für nachhaltige Transportinfrastrukturen zu verhandeln. Durch diese Übung erlernen die Teilnehmer kommunikative Techniken wie Zuhören, Widerspiegeln und minimalistische Ermutigungen, die für ihre Zukunft nützlich sind. Am Ende der Simulation wird eine faire Budgetverteilung erreicht, bei der alle Interessengruppen ihre Forderungen durchsetzen können."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "5HnBiJhnznGY" ;
    dcterms:subject <http://example.org/education/concept/G%C3%BCterverkehr>,
        <http://example.org/education/concept/Gruppenarbeit>,
        <http://example.org/education/concept/Kommunikation>,
        <http://example.org/education/concept/Lobbyismus>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Transportinfrastruktur>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Verhandlungstechniken>,
        <http://example.org/education/concept/Verkehrspolitik> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:5Hng9X2zQyGM a edu:LearningResource ;
    dcterms:description "Skinner vertritt die Auffassung, dass Texte nur mit Methoden analysiert werden sollten, die zur Zeit ihrer Entstehung verfügbar waren, um eine historisch genaue Sichtweise zu gewährleisten. Die Cambridge School wird kritisiert, weil sie Leser auffordert, Texte ohne subjektive Ansichten zu interpretieren, was unmöglich ist. Durch das Studium der Novemberrevolution können Lernende wichtige Erkenntnisse über die deutsche Geschichte und die Bedeutung von Demokratie und Menschenrechten gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Hng9X2zQyGM" ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Geschichte>,
        <http://example.org/education/concept/Frauenwahlrecht>,
        <http://example.org/education/concept/Historische_Forschung>,
        <http://example.org/education/concept/Ideengeschichte>,
        <http://example.org/education/concept/Meinungsfreiheit>,
        <http://example.org/education/concept/Nationalsozialismus>,
        <http://example.org/education/concept/Politikwissenschaft>,
        <http://example.org/education/concept/Politische_Philosophie>,
        <http://example.org/education/concept/Revolutionen>,
        <http://example.org/education/concept/Textanalyse> ;
    dcterms:title "Skinner und die Cambridge School"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:5ItC1fdu9ZbA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/G%C3%B6hler>,
        <http://example.org/education/person/Jasper> ;
    dcterms:description "Das Übungsblatt zum Modul Datenbanksysteme behandelt drei Themengebiete: Konsistenz, Integrität und Verteilung. Durch die Bearbeitung der Aufgaben sollen Studierende ihr Verständnis des relationalen Datenmodells und seiner Anwendung in Datenbanken verbessern. Insbesondere werden sie Kenntnisse über Konsistenzbedingungen, Transaktionen und Fragmentierung erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5ItC1fdu9ZbA" ;
    dcterms:subject <http://example.org/education/concept/Commit-Protokolle>,
        <http://example.org/education/concept/Datenbanksysteme>,
        <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Fragmentierung>,
        <http://example.org/education/concept/Integrit%C3%A4t>,
        <http://example.org/education/concept/Konsistenzbedingungen>,
        <http://example.org/education/concept/Sperrkonzepte>,
        <http://example.org/education/concept/Transaktionen>,
        <http://example.org/education/concept/Verteilte_Datenbanken>,
        <http://example.org/education/concept/relationale_Datenmodelle> ;
    dcterms:title "6. Übungsblatt zum Modul Datenbanksysteme WS 2024/2025"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

