oer:4g-7-mGWQiXo a edu:LearningResource ;
    dcterms:description "Dieses Selbst-Coaching-Handbuch unterstützt die persönliche Entwicklung und das Selbstvertrauen durch Übungen zur Selbsteinschätzung und Angstbewältigung. Durch die Auswertung von Selbst- und Fremdbildern können Lerner ihre Stärken und Schwächen erkennen und anhand von Fragebögen ihre Ängste identifizieren und überwinden. Dadurch können sie positive Erkenntnisse über sich selbst gewinnen und persönliche Entwicklungsschritte ableiten, um ihr Selbstvertrauen zu stärken."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4g-7-mGWQiXo" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Angstbew%C3%A4ltigung>,
        <http://example.org/education/concept/Coachingtechniken>,
        <http://example.org/education/concept/Fremdbild>,
        <http://example.org/education/concept/Pers%C3%B6nliche_Entwicklung>,
        <http://example.org/education/concept/Psychologische_%C3%9Cbungen>,
        <http://example.org/education/concept/Selbstcoaching>,
        <http://example.org/education/concept/Selbsteinsch%C3%A4tzung>,
        <http://example.org/education/concept/Selbstentwicklung>,
        <http://example.org/education/concept/Selbstreflexion>,
        <http://example.org/education/concept/Selbstvertrauen> ;
    dcterms:title "Übungen: Selbst-Coaching-Techniken für Selbstvertrauen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:4gv69xVj0exQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Goldstein>,
        <http://example.org/education/person/Kohl>,
        <http://example.org/education/person/Simons> ;
    dcterms:description "Die Geschichte der Baugewerkschaften wird dargestellt, von den Anfängen bis hin zu aktuellen tarifpolitischen Errungenschaften und Herausforderungen, um die Bedeutung kollektiver Lösungsansätze für Beschäftigte in der Bauwirtschaft zu verdeutlichen. Durch Tarifverträge werden Visionen und gesellschaftliche Entwicklungen an die Realität der Branche angepasst und umgekehrt, wodurch tarifpolitische Forderungen als Ausdruck von gesellschaftlichen Entwicklungen verstanden werden können. Die IG BAU wird als Gestalterin der Transformationsprozesse in der Bauwirtschaft vorgestellt, mit dem Ziel, Arbeit am Bau sicher, familienfreundlich und lohnenswert zu machen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "4gv69xVj0exQ" ;
    dcterms:subject <http://example.org/education/concept/Altersvorsorge>,
        <http://example.org/education/concept/Arbeitsbedingungen>,
        <http://example.org/education/concept/Baugewerbe>,
        <http://example.org/education/concept/Berufsausbildung>,
        <http://example.org/education/concept/Frauen_in_der_Wirtschaft>,
        <http://example.org/education/concept/Gewerkschaften>,
        <http://example.org/education/concept/Industriegewerkschaften>,
        <http://example.org/education/concept/L%C3%B6hne_und_Geh%C3%A4lter>,
        <http://example.org/education/concept/Sozialpolitik>,
        <http://example.org/education/concept/Tarifvertr%C3%A4ge> ;
    dcterms:title "Gesellschaft in der Transformation im Baugewerbe"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

