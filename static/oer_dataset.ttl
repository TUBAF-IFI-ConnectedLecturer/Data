    sim:similarTo oer:14HypWWDaEmGg,
        oer:88pj197JX-Yg ;
    dcterms:description "Dieses Dokument behandelt die Grundlagen von Datenbanken und enthält Übungsaufgaben und Beispiele zum Thema Entity-Relationship-Diagramme, Datenbanksysteme und Datenbasis. Durch das Studium dieses Materials können Lerner die Konzepte und Begriffe der Datenbankentwicklung verstehen und anwenden lernen. Insbesondere werden sie in der Lage sein, Entity-Relationship-Diagramme zu erstellen, die Beziehung zwischen Datenbanksystemen und Datenbasen zu erklären und die Vorteile von Datenbanksystemen im Vergleich zu Dateisystemen zu beschreiben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "14GpbMCiGyjuY" ;
    dcterms:publisher <http://example.org/education/organization/MULOE> ;
    dcterms:subject <http://example.org/education/concept/Beziehungstypen>,
        <http://example.org/education/concept/Datenbankmanagementsystem>,
        <http://example.org/education/concept/Datenbanksysteme>,
        <http://example.org/education/concept/Datenbasis>,
        <http://example.org/education/concept/Datenintegrit%C3%A4t>,
        <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Entity-Relationship-Diagramm>,
        <http://example.org/education/concept/Fremdschl%C3%BCssel>,
        <http://example.org/education/concept/Informationsmanagement>,
        <http://example.org/education/concept/Prim%C3%A4rschl%C3%BCssel> ;
