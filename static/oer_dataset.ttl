oer:10V19QElD159w a edu:LearningResource ;
    sim:similarTo oer:10ysRcyv4ZQCs,
        oer:11oOv0l65WiOc,
        oer:7BgY0PcpGsBI,
        oer:9ysxFnUUqULY ;
    dcterms:creator <http://example.org/education/person/Kluge>,
        <http://example.org/education/person/L%C3%B6big> ;
    dcterms:description "Die Kinder entwickeln ihre koordinativen Fähigkeiten im Bereich Orientierung und Reaktion durch die Kombination von kognitiven Aufgaben zum Erwerb von Kompetenzen aus dem Bereich des Problemlösens mit aktiven motorischen Bewegungen aus der Themenwelt der Roboter. Durch die Arbeit an den Stationen lernen sie, Probleme eigenständig zu lösen, Strategien zur Lösung eines Problems zu planen und zu verwenden, sowie ihre eigenen Vorgehensweisen verständlich zu beschreiben. Die Lehrkraft unterstützt die Kinder bei der Entwicklung ihrer Fähigkeiten durch die Einführung von Begriffen wie Programmieren und Befehl und die Reflexion über Erkenntnisse bei der Arbeit mit Robotern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "10V19QElD159w" ;
    dcterms:subject <http://example.org/education/concept/Bildung_in_der_digitalen_Welt>,
        <http://example.org/education/concept/Digitale_Medien>,
        <http://example.org/education/concept/Fachkompetenz>,
        <http://example.org/education/concept/Grundschule>,
        <http://example.org/education/concept/Motorische_F%C3%A4higkeiten>,
        <http://example.org/education/concept/Probleml%C3%B6sen>,
        <http://example.org/education/concept/Programmieren>,
        <http://example.org/education/concept/Roboter>,
        <http://example.org/education/concept/Sozialkompetenz>,
        <http://example.org/education/concept/Sportunterricht> ;
    dcterms:title "Unterrichtsstunde Roboter und Ingenieur"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10dd4N8J0myOo a edu:LearningResource ;
    sim:similarTo oer:11j7kfA40QFQ4,
        oer:12zvHJ_VdH4Fg,
        oer:150pjr0Xbpgtg,
        oer:5AJNtBA0Atek,
        oer:5gGsbVT-6Gwk,
        oer:8mqDmRgDPbLI ;
    dcterms:creator <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übung enthält sechs Aufgaben aus dem Bereich der Optimierung, die Lösungen für verschiedene Probleme wie lineare und nichtlineare Optimierungsprobleme, ganzzahlige Optimierungsprobleme und Zuordnungsprobleme verlangen. Durch das Lösen dieser Aufgaben sollen die Lernenden ihre Fähigkeiten im Bereich der Modellierung und Lösung von Optimierungsproblemen verbessern und ein tieferes Verständnis für die Anwendung mathematischer Konzepte in verschiedenen Kontexten entwickeln. Die Übung deckt eine Vielzahl von Themen ab, darunter lineare Algebra, Analysis und Operations Research."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10dd4N8J0myOo" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Differentialgleichungen>,
        <http://example.org/education/concept/Eigenwerte>,
        <http://example.org/education/concept/Frachtproblem>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Matrizen>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Zuordnungsproblem>,
        <http://example.org/education/concept/ganzzahlige_Optimierungsprobleme>,
        <http://example.org/education/concept/lineare_Optimierungsprobleme>,
        <http://example.org/education/concept/nichtlineare_Optimierungsprobleme> ;
    dcterms:title "Optimierung für Mathematikerinnen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10gJWncYHldeE a edu:LearningResource ;
    sim:similarTo oer:10qTO5W7UD0SA,
        oer:10r48hRkbqxsU ;
    dcterms:creator <http://example.org/education/person/Daugaard>,
        <http://example.org/education/person/Emons>,
        <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die Vorlesung behandelt die Sprachtypologie und kontrastive Linguistik, indem sie die Beziehung zwischen Ausdruck und Inhalt untersucht und die Mikro- und Makroebene der sprachlichen Analyse betrachtet. Durch diese Vorlesung können Lernende ein Verständnis dafür entwickeln, wie Sprache funktioniert und wie sie in verschiedenen Kontexten verwendet wird. Sie lernen außerdem, wie man eine kontrastive Analyse von Sprachen durchführt und wie man die Ergebnisse interpretiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10gJWncYHldeE" ;
    dcterms:subject <http://example.org/education/concept/Inhaltsanalyse>,
        <http://example.org/education/concept/Kontrastive_Linguistik>,
        <http://example.org/education/concept/Linguistik>,
