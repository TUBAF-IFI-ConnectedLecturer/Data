oer:10iztEXLPXh4U a edu:LearningResource ;
    sim:similarTo oer:13qH5TONqJVHc,
        oer:5l6iB0AgYLNM,
        oer:7YIsfs57owuM,
        oer:88A7JwgP02xU ;
    dcterms:creator <http://example.org/education/person/Fritz> ;
    dcterms:description "Die historische Semantik erforscht die Entwicklung von Wortbedeutungen im Kontext von Kommunikationsformen und Textsorten, wobei der Gebrauchstheoretiker die Geschichte des Wortgebrauchs als Teil der Geschichte von Kommunikationsformen betrachtet. Durch die Analyse von Kontroversen wie der Pietisten-Kontroverse um 1700 oder der Astrologie-Debatte um 1600 können Lernende Einsichten in die Entwicklung von Begriffen und ihre Verwendung in verschiedenen Diskursen gewinnen. Dieses Wissen ermöglicht es, komplexe Formen der Intertextualität zu verstehen und die Bedeutung von Worten im Kontext ihrer Verwendung zu erfassen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10iztEXLPXh4U" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_T%C3%BCbingen> ;
    dcterms:subject <http://example.org/education/concept/Fr%C3%BChneuhochdeutsch>,
        <http://example.org/education/concept/Geschichte_der_Wissenschaft>,
        <http://example.org/education/concept/Historische_Semantik>,
        <http://example.org/education/concept/Kontroversenforschung>,
        <http://example.org/education/concept/Lexikalische_Semantik>,
        <http://example.org/education/concept/Onomasiologie>,
        <http://example.org/education/concept/Pietismus>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Sprachgebrauch>,
        <http://example.org/education/concept/W%C3%B6rterbuchforschung> ;
    dcterms:title "Historische Semantik des Deutschen"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

