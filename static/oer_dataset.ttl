        <http://example.org/education/concept/Wahlergebnis>,
        <http://example.org/education/concept/Wahlverhalten> ;
    dcterms:title "Aufgabenstellung: Auswertung Bundestagswahl 2017"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

