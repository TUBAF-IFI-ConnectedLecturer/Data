oer:6pPV6VU3126c a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Lettau>,
        <http://example.org/education/person/Weigel> ;
    dcterms:description "Das Seminar behandelt die Einführung in Politische Theorie- und Ideengeschichte anhand von John Rawls' Werk \"Eine Theorie der Gerechtigkeit\" aus dem Jahr 1971. Durch die Lektüre dieses Textes erwerben die Lernenden Kenntnisse über die Grundlagen einer gerechten Gesellschaft, insbesondere über den hypothetischen Gesellschaftsvertrag und die zwei Prinzipien der Gerechtigkeit. Sie lernen, wie Rawls' Theorie die Fairness und Chancengleichheit in einer Gesellschaft sicherstellen soll."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6pPV6VU3126c" ;
    dcterms:publisher <http://example.org/education/organization/Philosophische_Fakult%C3%A4t> ;
    dcterms:subject <http://example.org/education/concept/Chancengleichheit>,
        <http://example.org/education/concept/Fairness>,
        <http://example.org/education/concept/Gerechtigkeitstheorie>,
        <http://example.org/education/concept/Gesellschaftsvertrag>,
        <http://example.org/education/concept/Ideengeschichte>,
        <http://example.org/education/concept/Moralische_F%C3%A4higkeiten>,
        <http://example.org/education/concept/Politische_Philosophie>,
        <http://example.org/education/concept/Politische_Theorie>,
        <http://example.org/education/concept/Rechtsphilosophie>,
        <http://example.org/education/concept/Soziale_Ungleichheit> ;
    dcterms:title "Einführung in Politische Theorie-und Ideengeschichte"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:6pp38dvnCxoU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Iatrou>,
        <http://example.org/education/person/Urbas> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Prozessleittechnik und vermittelt Kenntnisse über Funktionsbausteine, Einzelsteuerfunktionen, Analog-Digital-Wandlung und Reglerstrukturen. Durch das Studium dieser Inhalte können Lernende die Konzepte und Methoden der Prozessleittechnik verstehen und anwenden, um industrielle Systeme zu steuern und zu überwachen. Insbesondere werden sie in der Lage sein, Messsignale zu verarbeiten, Steuersignale zu generieren und Reglerstrukturen zu implementieren, um Prozesse effizient und sicher zu steuern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6pp38dvnCxoU" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Analog-Digital-Wandlung>,
        <http://example.org/education/concept/Automatisierungssysteme>,
        <http://example.org/education/concept/Einzelsteuerfunktionen>,
        <http://example.org/education/concept/Hierarchische_Komposition>,
        <http://example.org/education/concept/Industrielle_Kommunikation>,
        <http://example.org/education/concept/Modularisierung>,
        <http://example.org/education/concept/Prozessleittechnik>,
        <http://example.org/education/concept/Regler>,
        <http://example.org/education/concept/Signalverarbeitung>,
        <http://example.org/education/concept/Wiederverwendung> ;
    dcterms:title "VL PLT1 - Prozessleittechnik 1"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6qJBKUaFasJA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Ishchenko>,
        <http://example.org/education/person/Lehmann>,
        <http://example.org/education/person/R%C3%B6%C3%9Fler> ;
    dcterms:description "Diese Bachelorarbeit untersucht die Optimierungspotenziale von Lernumgebungen in Universitätsgebäuden anhand eines fiktiven Modells, um durch die Integration digitaler Technologien, nachhaltiger Architektur und flexibler Raumkonzepte die Effektivität des Lernens zu steigern. Die Arbeit leistet einen Beitrag zur Verbesserung der Lernumgebungen und zeigt Wege auf, wie Universitätsgebäude an die Anforderungen moderner Bildung angepasst werden können. Durch diese Forschung können Studierende Erkenntnisse über die Integration digitaler Technologien, nachhaltiger Architektur und flexibler Raumkonzepte in Lernumgebungen gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6qJBKUaFasJA" ;
    dcterms:publisher <http://example.org/education/organization/Berufsakademie_Sachsen_Staatliche_Studienakademie_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Architektur>,
        <http://example.org/education/concept/Bildungsinfrastruktur>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Hochschulbau>,
        <http://example.org/education/concept/Lernerfolg>,
        <http://example.org/education/concept/Lernumgebung>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Raumkonzept>,
        <http://example.org/education/concept/Studienplatz>,
        <http://example.org/education/concept/Universit%C3%A4tsgeb%C3%A4ude> ;
    dcterms:title "Exposé zur Bachelorarbeit"@de ;
    dcterms:type <http://example.org/education/type/Bachelor-_oder_Masterarbeit> .

oer:6r_e5zO511yA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Holschemacher> ;
    dcterms:description "Die Heißbemessung von Stahlbetonbauteilen behandelt die Tragfähigkeit von Bauteilen unter Brandbeanspruchung und bietet Methoden zur Ermittlung der Feuerwiderstandsfähigkeit. Durch die Anwendung dieser Methoden können Ingenieure und Architekten sicherstellen, dass ihre Entwürfe den Anforderungen an die Brandsicherheit genügen. Die Verwendung von Eurocode 2 und nationalen Anhängen ermöglicht eine praxisnahe und normengerechte Bemessung von Stahlbeton- und Spannbetontragwerken für den Brandfall."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6r_e5zO511yA" ;
    dcterms:subject <http://example.org/education/concept/Balkenquerschnitt>,
        <http://example.org/education/concept/Bauordnungsrecht>,
        <http://example.org/education/concept/Bauteilklassifizierung>,
