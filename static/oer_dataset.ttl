oer:5uXuLiL5bMjw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kossatz> ;
    dcterms:description "Die Vorlesung behandelt die Konzepte und Theorien der Neuesten Geschichte, insbesondere die Invektivitätsgeschichte und ihre Funktion als Mechanismus zur Aushandlung sozialer Positionen. Durch die Lektüre erfahren die Studierenden, wie Scham und Invektivität in der Gesellschaft wirken und wie sie historisch bedeutsame Ereignisse wie die Judenverfolgung im Dritten Reich beeinflusst haben. Die Studierenden gewinnen Einblick in die Bedeutung von sozialen Praktiken, Normen und Gefühlen für das Verständnis gesellschaftlicher Prozesse."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5uXuLiL5bMjw" ;
    dcterms:subject <http://example.org/education/concept/Diskriminierung>,
        <http://example.org/education/concept/Geschichte>,
        <http://example.org/education/concept/Gesellschaft>,
        <http://example.org/education/concept/Historische_Ereignisse>,
        <http://example.org/education/concept/Invektivit%C3%A4t>,
        <http://example.org/education/concept/Machtmechanismen>,
        <http://example.org/education/concept/Scham>,
        <http://example.org/education/concept/Soziale_Normen>,
        <http://example.org/education/concept/Sozialpsychologie>,
        <http://example.org/education/concept/Vorurteile> ;
    dcterms:title "Konzepte und Theorien der Neuesten Geschichte"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

