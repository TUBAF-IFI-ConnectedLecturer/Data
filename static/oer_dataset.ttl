    dcterms:creator <http://example.org/education/person/Etling>,
        <http://example.org/education/person/Hamann> ;
    dcterms:description "Diese Übung zum Thema Mengenlehre umfasst insgesamt acht Aufgaben, die den Lernenden helfen, ihre Fähigkeiten im Umgang mit Mengenbeziehungen und -operationen zu verbessern. Durch das Bearbeiten dieser Aufgaben können die Lernenden ihre Kenntnisse über Mengen, Teilmengen und Mengenbeziehungen erweitern und ihre Fähigkeit entwickeln, komplexe mengentheoretische Aussagen zu beweisen. Die Übung eignet sich für Studierende der Medieninformatik im ersten Semester."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9AKlxKdT0z54" ;
    dcterms:publisher <http://example.org/education/organization/Prof._Dr._M._Hamann__Dipl.-math._Techn._T._Etling_%E2%86%92_Hochschule_F%C3%BCr_Technik_Und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cbung>,
        <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Hochschule>,
        <http://example.org/education/concept/Intervallschreibweise>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Medieninformatik>,
        <http://example.org/education/concept/Mengenlehre>,
        <http://example.org/education/concept/Mengentheorie>,
        <http://example.org/education/concept/Teilmengenbeziehungen>,
        <http://example.org/education/concept/Zahlengeraden> ;
    dcterms:title "Algebra und höhere Mathematik 1 für Medieninformatik - WS202223 Übung 2: Mengenlehre"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

