oer:9goni4UsDj0E a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kliem> ;
    dcterms:description "Die Hausaufgabe behandelt die Themen komplexe Nullstellen von Polynomen und Vektorräume über komplexen Zahlen. Es wird gezeigt, dass die Annahme, alle komplexen Nullstellen eines Polynoms seien konjugiert komplex, falsch ist. Durch die Aufgaben werden algebraische Strukturen und Operationen mit komplexen Zahlen veranschaulicht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9goni4UsDj0E" ;
    dcterms:subject <http://example.org/education/concept/Algebraische_Strukturen>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Komplexe_Zahlen>,
        <http://example.org/education/concept/Korper>,
        <http://example.org/education/concept/Mathematische_Analysis>,
        <http://example.org/education/concept/Nullstellen>,
        <http://example.org/education/concept/Polynome>,
        <http://example.org/education/concept/Skalarmultiplikation>,
        <http://example.org/education/concept/Vektoraddition>,
        <http://example.org/education/concept/Vektorr%C3%A4ume> ;
    dcterms:title "Hausaufgabe Nr. 15"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

