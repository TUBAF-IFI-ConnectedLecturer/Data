    dcterms:description "Der Übergang vom Niederdeutschen zum Hochdeutschen als Schriftsprache in Norddeutschland im 15. und 16. Jahrhundert wird beschrieben, wobei die Hanse und ihre Mitgliederstädte ihre Macht verloren und neue politische und wirtschaftliche Strukturen entstanden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5saLiHxSXyEY" ;
    dcterms:subject <http://example.org/education/concept/Fr%C3%BChe_Neuzeit>,
        <http://example.org/education/concept/Hanse>,
        <http://example.org/education/concept/Hochdeutsch>,
        <http://example.org/education/concept/Kulturgeschichte>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Niederdeutsch>,
        <http://example.org/education/concept/Norddeutschland>,
        <http://example.org/education/concept/Reformation>,
        <http://example.org/education/concept/Sprachgeschichte>,
        <http://example.org/education/concept/Sprachwandel> ;
    dcterms:title "Der Übergang vom Mittelniederdeutschen zum Hochdeutschen in der schriftlichen Kommunikation Norddeutschlands zwischen 1500 und 1800."@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:650m6AFexVjg a edu:LearningResource ;
    sim:similarTo oer:66cF2fICCMM0,
