        <http://example.org/education/concept/Kommunikationstechnologien>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Online-Marketing>,
        <http://example.org/education/concept/Soziale_Netzwerke> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:5BkhjvWdmi_s a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Siegers> ;
    dcterms:description "Lernende erfahren, wie eine Internetadresse aufgebaut ist und wie Computer miteinander kommunizieren. Sie lernen, die verschiedenen Teile einer Adresse zu identifizieren, wie zum Beispiel das Protokoll, den Namen des Rechners und den Ordner mit der Datei. Durch dieses Material können Lernende die grundlegenden Konzepte des Internets verstehen und erfahren, wie sie eine Webseite aufrufen und Dateien auf einem Server finden können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5BkhjvWdmi_s" ;
    dcterms:publisher <http://example.org/education/organization/RWTH_Aachen> ;
    dcterms:subject <http://example.org/education/concept/Computerkommunikation>,
        <http://example.org/education/concept/Deutschland>,
        <http://example.org/education/concept/HTTP>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Informatikausbildung>,
