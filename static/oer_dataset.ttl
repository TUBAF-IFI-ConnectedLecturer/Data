oer:11ZpJSHsfFfOo a edu:LearningResource ;
    sim:similarTo oer:11aUHDqjeSp8U,
        oer:11bCpXyMk1Mzg,
        oer:11bezyYtSIbkY ;
    dcterms:description "Die Diskussion behandelt die Rolle von Videos bei der Präsentation und Werbung für Bibliotheken, insbesondere im akademischen Kontext. Durch die Analyse von Beispielen wird gezeigt, wie Videos genutzt werden können, um die Einzigartigkeit einer Bibliothek zu präsentieren, neue Nutzer anzuziehen und bestehende zu binden. Die Lektüre ermöglicht es den Lernenden, Strategien für die Erstellung effektiver Werbevideos für Bibliotheken zu entwickeln und die Bedeutung von digitalen Medien in der Bibliotheksarbeit zu verstehen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "11ZpJSHsfFfOo" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_Hints_Pointing_To_The_Author%27s_Institution_Of_Origin%3A%2A%2Auniversit%C3%A4t%2A%2Aspecifically__The_Text_Mentions_%22bibliothek%22_And_%22%C3%B6bs%22_%28which_Likely_Stands_For_%22%C3%B6ffentliche_Bibliotheken%22__Or_Public_Libraries%29__Which_Suggests_a_German-speaking_Academic_Environment._Additionally__The_Writing_Style_And_Language_Used_In_The_Document_Are_Consistent_With_Those_Commonly_Found_In_German_Academic_Settings.if_More_Information_Is_Needed__Please_Let_Me_Know%21> ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentliche_Bibliotheken>,
        <http://example.org/education/concept/Bibliothek>,
        <http://example.org/education/concept/Bibliotheksbenutzung>,
        <http://example.org/education/concept/Bibliotheksf%C3%BChrungen>,
        <http://example.org/education/concept/Bibliotheksimage>,
        <http://example.org/education/concept/Bibliotheksmarketing>,
        <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Informationskompetenz>,
        <http://example.org/education/concept/Medieninformatik>,
        <http://example.org/education/concept/Wissenschaftliche_Bibliotheken> ;
    dcterms:title "Die Rolle von Videos in der Bibliothekspräsentation"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:11gRfab-KklmU a edu:LearningResource ;
