oer:8Oj9WlFLC8LU a edu:LearningResource ;
    dcterms:description "Das Kapitel 13 behandelt die Themen Handel und Globalisierung, indem es die Prinzipien des komparativen Vorteils und des absoluten Vorteils erklärt und anhand von Beispielen die Vorteile des Handels zwischen Ländern aufzeigt. Durch das Studium dieses Kapitels können Lernende verstehen, wie sich Länder durch Spezialisierung und Handel besserstellen können und wie die Verteilung der Handelsgewinne bestimmt wird. Zudem werden die Auswirkungen von Globalisierung auf den Güterhandel und die Integration von Märkten erläutert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8Oj9WlFLC8LU" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Au%C3%9Fenhandel>,
        <http://example.org/education/concept/Au%C3%9Fenwirtschaft>,
        <http://example.org/education/concept/Freihandel>,
        <http://example.org/education/concept/G%C3%BCterhandel>,
        <http://example.org/education/concept/Globalisierung>,
        <http://example.org/education/concept/Handelsbilanz>,
        <http://example.org/education/concept/Internationale_Wirtschaft>,
        <http://example.org/education/concept/Mikro%C3%B6konomie>,
        <http://example.org/education/concept/Protektionismus>,
        <http://example.org/education/concept/Volkswirtschaftslehre> ;
    dcterms:title "Kapitel 13: Handel und Globalisierung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:8Pf6lSaPZwhY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kurschner> ;
    dcterms:description "Die Hauptkomponentenanalyse (PCA) ist ein Werkzeug zur explorativen Datenanalyse, das die Dimensionsreduktion von hochdimensionalen Datensätzen ermöglicht und die wichtigsten Feature einer Beobachtung hervorhebt. Durch die Anwendung von PCA können Daten auf ihre wesentlichen Komponenten reduziert werden, was zu einer besseren Interpretierbarkeit und Visualisierung der Daten führt. Die Verwendung von SVD und Kovarianzmatrizen wird erläutert, um die Hauptkomponenten einer Datenmatrix zu bestimmen und die Dimensionsreduktion durchzuführen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8Pf6lSaPZwhY" ;
    dcterms:publisher <http://example.org/education/organization/Mathematisch-Naturwissenschaftliches_Zentrum> ;
    dcterms:subject <http://example.org/education/concept/Data_Science>,
        <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Dimensionsreduktion>,
        <http://example.org/education/concept/Hauptkomponentenanalyse>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Kovarianzmatrix>,
        <http://example.org/education/concept/Machine_Learning>,
        <http://example.org/education/concept/Singularwertzerlegung>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/numerische_Methoden> ;
    dcterms:title "Hauptkomponentenanalyse"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

