oer:7ellJ85Ybu4I a edu:LearningResource ;
    sim:similarTo oer:7ppLzmg8HDJw ;
    dcterms:creator <http://example.org/education/person/H%C3%B6hnke> ;
    dcterms:description "Das Konzept von Structure-from-Motion (SfM) ermöglicht die Erstellung von 3D-Modellen und -Punktwolken aus Bildern und wird vor allem in der Nahbereichsphotogrammmetrie verwendet. Durch SfM können einfache Fotos genutzt werden, um solide Ergebnisse zu erzielen, was die Einstiegsbarrieren für die Anwendung senkt. Die Methode bietet großes Potenzial für die Digitalisierung von Kunst- und Kulturschätzen sowie für die Erstellung genauer Aufnahmen von Oberflächen vieler Gegenstände."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7ellJ85Ybu4I" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/3D-Modellierung>,
        <http://example.org/education/concept/Bildverarbeitung>,
        <http://example.org/education/concept/Digitale_Fotografie>,
        <http://example.org/education/concept/Geodatenakquisition>,
        <http://example.org/education/concept/Kamerakalibrierung>,
        <http://example.org/education/concept/Nahbereichsphotogrammetrie>,
