        oer:8aUGmsWi2Duk ;
    dcterms:creator <http://example.org/education/person/Lauber-R%C3%B6nsberg> ;
    dcterms:description "Das Urheberrecht als Geistiges Eigentum behandelt die philosophischen, technischen und ökonomischen Hintergründe des Urheberrechts, einschließlich seiner Geschichte, Rechtsquellen und Funktionen im digitalen Zeitalter. Durch das Studium dieses Materials können Lernende ein Verständnis dafür entwickeln, warum Urheberrecht notwendig ist, wie es funktioniert und welche Auswirkungen es auf die Gesellschaft hat. Sie werden auch Kenntnisse über die verschiedenen Rechtsquellen, einschließlich deutsches Recht, Unionsrecht und Völkerrecht, erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "451PeKx69zFQ" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_M%C3%BCnchen> ;
    dcterms:subject <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Europ%C3%A4isches_Unionsrecht>,
        <http://example.org/education/concept/Geistiges_Eigentum>,
        <http://example.org/education/concept/Immaterialg%C3%BCterrecht>,
        <http://example.org/education/concept/Kulturg%C3%BCterschutz>,
        <http://example.org/education/concept/Medienrecht>,
        <http://example.org/education/concept/Rechtspolitik>,
        <http://example.org/education/concept/Urheberrecht>,
        <http://example.org/education/concept/V%C3%B6lkerrecht>,
        <http://example.org/education/concept/Wettbewerbsrecht> ;
    dcterms:title "Warum Urheberrecht?"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:4BpiTy7nYRC8 a edu:LearningResource ;
    sim:similarTo oer:4Datx0aTqkh4,
