        oer:66pIeQLkVmhQ,
        oer:9vNzW1CbK-Q0 ;
    dcterms:creator <http://example.org/education/person/Riegler> ;
    dcterms:description "Die rekonstruktive Sozialforschung bietet eine methodologische Alternative zum standardisierten Mainstream, die Spielräume für einen gesellschaftskritischen Anspruch lässt und Stereotypisierungen sowie Vorabkategorisierungen auf methodischer Ebene vermeidet. Durch die Fokussierung auf die Eigenstrukturiertheit der Handlungspraxis der Forschungssubjekte können Machtverhältnisse und ihre Bedeutung für die Positionierung einzelner Subjekte erkennbar gemacht werden. Die Auseinandersetzung mit dieser Forschungsrichtung ermöglicht es, gesellschaftskritische Fragestellungen zu bearbeiten und ein tieferes Verständnis von komplexen sozialen Gefügen zu erlangen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3JEXb2-i-ASE" ;
    dcterms:subject <http://example.org/education/concept/Diskursanalyse>,
        <http://example.org/education/concept/Gesellschaftskritik>,
        <http://example.org/education/concept/Kritische_Psychologie>,
        <http://example.org/education/concept/Machtverh%C3%A4ltnisse>,
        <http://example.org/education/concept/Migrationsforschung>,
        <http://example.org/education/concept/Rassismusforschung>,
        <http://example.org/education/concept/Sozialforschung>,
        <http://example.org/education/concept/Subjektposition>,
        <http://example.org/education/concept/qualitative_Forschung>,
        <http://example.org/education/concept/rekonstruktive_Sozialforschung> ;
    dcterms:title "Wie kritisch ist die rekonstruktive Sozialforschung?"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

