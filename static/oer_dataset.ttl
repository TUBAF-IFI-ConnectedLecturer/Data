        oer:9ZbxarbRc8xs,
        oer:9bMh3whjq7Pc,
        oer:9dah6eIbrOm0,
        oer:9o2uVOV3V5MY ;
    dcterms:creator <http://example.org/education/person/Despang> ;
    dcterms:description "Das Material behandelt den Dramenaufbau nach Aristoteles für die Klassenstufe 9 und 11 im Fach Deutsch und ermöglicht Lernenden, wesentliche Gestaltungs- und Strukturprinzipien von dramatischen Texten zu beherrschen. Durch die Anwendung des Materials können Lernende ihre Fachkompetenz, Methodenkompetenz, Selbstkompetenz und Sozialkompetenz auf den Niveaus 1 bis 4 nach DQR verbessern. Das Material eignet sich insbesondere für die Einstiegs- und Erarbeitungsphase im Unterricht."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "8yQtLcr9pCRU" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Aristoteles>,
        <http://example.org/education/concept/Deutsch_als_Zweitsprache>,
        <http://example.org/education/concept/Deutschunterricht>,
        <http://example.org/education/concept/Dramenaufbau>,
        <http://example.org/education/concept/Gestaltungsprinzipien>,
        <http://example.org/education/concept/Lesen_und_Verstehen>,
        <http://example.org/education/concept/Medien_in_der_Schule>,
        <http://example.org/education/concept/Strukturprinzipien>,
        <http://example.org/education/concept/Theaterkonzepte>,
        <http://example.org/education/concept/dramatische_Texte> ;
    dcterms:title "Übersicht zum Material"@de ;
    dcterms:type <http://example.org/education/type/Materialhandreichung> .

oer:9_uF1SOzsZso a edu:LearningResource ;
    sim:similarTo oer:9dqmS-Q2Bhzc,
        oer:9o2sSv7XEqXQ ;
    dcterms:creator <http://example.org/education/person/Bertrand>,
        <http://example.org/education/person/Bombach>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übungsaufgaben behandeln die Themen Potenz- und Fourierreihen in der Mathematik, wobei die Lösungen von Potenzreihenentwicklungen, Konvergenzradien und -intervallen sowie die Bestimmung von Summenfunktionen und Fourierreihen erwartet werden. Durch das Bearbeiten dieser Aufgaben können Studierende ihre Fähigkeiten im Bereich der numerischen Mathematik verbessern und ein tieferes Verständnis für die Anwendung von Potenz- und Fourierreihen entwickeln. Die Übungsaufgaben decken verschiedene Aspekte der Theorie ab, darunter auch die Entwicklung reeller Funktionen in Potenzreihen und die Berechnung von Koeffizienten in trigonometrischen Fourierreihen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9_uF1SOzsZso" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Fourierreihe>,
        <http://example.org/education/concept/Funktionentwicklung>,
        <http://example.org/education/concept/Konvergenzintervall>,
        <http://example.org/education/concept/Konvergenzradius>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Numerische_Mathematik>,
        <http://example.org/education/concept/Periodische_Funktionen>,
        <http://example.org/education/concept/Potenzreihen>,
        <http://example.org/education/concept/Trigonometrie> ;
    dcterms:title "Mathematik III (für IF, ET, Ph) Wintersemester 2023/24"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9tCsH9JHkET0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Klimova> ;
    dcterms:description "Diese Klausur zum Mathematik-Kurs [I382 I380] an der Hochschule für Technik und Wirtschaft Dresden umfasst sechs Aufgaben zu verschiedenen Themen wie Wahr oder Falsch, vollständiger Induktion, linearen Algebra und Kombinatorik. Durch das Bearbeiten dieser Aufgaben können Studierende ihre mathematischen Fähigkeiten verbessern und ihr Verständnis von wichtigen Konzepten in der Mathematik vertiefen. Die Klausur bietet insgesamt 73 Punkte, davon 7 Zusatzpunkte, und erfordert eine Bearbeitungszeit von 90 Minuten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9tCsH9JHkET0" ;
    dcterms:subject <http://example.org/education/concept/Binomischer_Lehrsatz>,
