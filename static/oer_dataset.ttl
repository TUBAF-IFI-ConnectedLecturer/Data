        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Nat%C3%BCrliche_Umwelt>,
        <http://example.org/education/concept/Wetter> ;
    dcterms:title "Natürliche Umwelt und Siedlungsraum"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

