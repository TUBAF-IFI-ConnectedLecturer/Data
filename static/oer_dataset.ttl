        <http://example.org/education/concept/Raumverhalten>,
        <http://example.org/education/concept/Selbstbewusstsein>,
        <http://example.org/education/concept/Selbstsicherheit> ;
    dcterms:title "CAREERSERVICE CC BY SA 4.0"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

