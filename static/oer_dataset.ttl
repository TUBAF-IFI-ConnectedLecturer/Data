    dcterms:creator <http://example.org/education/person/Fricke>,
        <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Stephan> ;
    dcterms:description "Die Vorlesung Triebfahrzeugtechnik behandelt die Antriebskonfigurationen von Schienenfahrzeugen, insbesondere die Charakteristik von Bahn-Dieselmotoren und ihre Emissionsreduzierung durch Abgasnachbehandlung. Es werden alternative Kraftstoffe wie Biodiesel und E-Diesel vorgestellt, sowie Beispiele für ihren Einsatz im Eisenbahnbetrieb gezeigt. Durch das Studium dieser Materialien können Lernende ein Verständnis der Funktionsweise von Dieselmotoren und ihrer Umweltauswirkungen entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9AZlUq8YPohI" ;
    dcterms:subject <http://example.org/education/concept/Abgasemissionen>,
        <http://example.org/education/concept/Alternativkraftstoffe>,
        <http://example.org/education/concept/Biodiesel>,
        <http://example.org/education/concept/Dieselmotoren>,
        <http://example.org/education/concept/Eisenbahnverkehr>,
        <http://example.org/education/concept/Elektrolyse>,
        <http://example.org/education/concept/Kraftstoffe>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9nJGa8UNfPR8 a edu:LearningResource ;
    sim:similarTo oer:9sH_uM8xdACs,
        oer:9zh012Kp4s_c ;
    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die additive Fertigungstechnik ermöglicht die Herstellung komplexer Bauteile mit individuellen Eigenschaften durch schichtweise Aufbau von Materialien. Durch das Verständnis der Klassifizierung und Anwendungsbereiche additiver Fertigungsverfahren können Lernende die Vorteile dieser Technologie für die Produktentwicklung nutzen und innovative Lösungen entwickeln. Die additive Fertigung bietet Möglichkeiten zur Realisierung von Leichtbau, Funktionselementen und individuellen Produkten mit verbesserten Eigenschaften."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9nJGa8UNfPR8" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Drucken>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Digital_Light_Processing>,
        <http://example.org/education/concept/Elektronenstrahlschmelzen>,
        <http://example.org/education/concept/Fused_Filament_Fabrication>,
        <http://example.org/education/concept/Layer_Laminated_Manufacturing>,
        <http://example.org/education/concept/Produktentstehungsprozess>,
        <http://example.org/education/concept/Rapid_Prototyping>,
        <http://example.org/education/concept/Selektives_Laserschmelzen> ;
    dcterms:title "ADDITIVE FERTIGUNG KLASSIFIZIERUNG"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

