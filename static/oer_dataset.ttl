    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Folien behandeln den Leistungsbedarf von Fahrwiderständen bei verschiedenen Geschwindigkeiten und Besetzungsgraden. Durch die Analyse der absoluten und relativen Leistungsbedarfe können Studierende die Einflüsse auf die Fahrdynamik von spurgeführten Fahrzeugen verstehen. Die Beispiele zu Reise- und Güterzügen veranschaulichen die Anwendung dieser Konzepte in der Praxis."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "17h4tOrKMoRJw" ;
    dcterms:subject <http://example.org/education/concept/Eisenbahn>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrwiderstand>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/G%C3%BCterverkehr>,
        <http://example.org/education/concept/Leistungsbedarf>,
        <http://example.org/education/concept/Reisezug>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Zugmaschine> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

