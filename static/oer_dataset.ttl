oer:11f_xEr8sCxw0 a edu:LearningResource ;
    sim:similarTo oer:4eA93iFcfXGE,
        oer:4kv_qpC94mdY,
        oer:5ySw59JFdyX4,
        oer:66BFD588LBO4,
        oer:6CRJOBIRXuzc ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen von Grenzflächenaktiven Substanzen und ihren Anwendungen in Emulsionen und Mizellen. Durch das Studium dieser Materialien erwerben Lernende Kenntnisse über die physikalischen Eigenschaften, Struktur und Klassifizierung von Tensiden, sowie ihre Rolle bei der Stabilisierung von Emulsionen und der Bildung von Mizellen. Darüber hinaus werden auch kinetische Effekte, lyotrope Flüssigkristallphasen und die Relevanz von Mizellen in verschiedenen Anwendungen behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11f_xEr8sCxw0" ;
    dcterms:subject <http://example.org/education/concept/Adsorption>,
        <http://example.org/education/concept/Emulsionen>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenph%C3%A4nomene>,
        <http://example.org/education/concept/Kolloidchemie>,
        <http://example.org/education/concept/Lyotrope_Fl%C3%BCssigkristallphasen>,
        <http://example.org/education/concept/Mizellen>,
        <http://example.org/education/concept/Oberfl%C3%A4chenspannung>,
        <http://example.org/education/concept/Phaseninversionstemperatur>,
        <http://example.org/education/concept/Tenside>,
        <http://example.org/education/concept/physikalische_Eigenschaften_von_L%C3%B6sungen> ;
    dcterms:title "Fakultät Maschinenwesen Institut für Verfahrenstechnik und Umwelttechnik, AG Mechanische Verfahrenstechnik Lehrveranstaltung Grenzflächenphänomene"@de ;
