        <http://example.org/education/concept/Regressionsanalyse>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie> ;
    dcterms:title "Kurz-Lösungen (nur finale Resultate)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

