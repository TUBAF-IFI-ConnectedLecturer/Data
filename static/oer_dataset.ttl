        <http://example.org/education/concept/Pr%C3%BCfungsangst>,
        <http://example.org/education/concept/Redeangst>,
        <http://example.org/education/concept/Selbstreflexion> ;
    dcterms:title "Lampenfieber"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:16QKLAgUp254A a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Aurich> ;
    dcterms:description "Das GIF kann im Chemieunterricht der Klassenstufe 8 eingesetzt werden, um Schülern die Eigenschaften von Metallen und Salzen zu vermitteln. Es visualisiert die Sprödigkeit von Salzen und ermöglicht einen Vergleich mit Metallen. Durch das GIF können Schüler ein besseres Verständnis der chemischen Reaktionen erlangen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "16QKLAgUp254A" ;
