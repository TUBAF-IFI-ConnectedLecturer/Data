    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von spurgeführten Fahrzeugen wird anhand von Diagrammen und Schemata erläutert, um die verschiedenen Arten der Leistungsübertragung bei Dieseltriebfahrzeugen zu verstehen. Durch das Studium dieser Materialien können Lernende die Vorteile und Nachteile hydromechanischer, mechanischer und elektrischer Leistungsübertragung erkennen und die Anforderungen an eine effiziente Zugkraftentwicklung erfüllen. Zudem werden Beispiele von Fahrzeugen wie dem BR 642 (Desiro) herangezogen, um die Umsetzung dieser Konzepte in der Praxis zu veranschaulichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3M2C2edTGKjw" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Dieselmotoren>,
        <http://example.org/education/concept/Fahrodynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Geschwindigkeit>,
        <http://example.org/education/concept/Getriebe>,
        <http://example.org/education/concept/Hydromechanik>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

