        <http://example.org/education/concept/Schulbibliotheken> ;
    dcterms:title "Bibliothekssysteme im Überblick: Japan und Mexiko"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:12xtLc1iJ2Px0 a edu:LearningResource ;
    sim:similarTo oer:14AVGAS2wSSVY,
        oer:14PAighDgH-go,
        oer:14XWHZ65hceSk,
        oer:14ptJRkstYQTk,
