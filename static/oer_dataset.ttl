    dcterms:creator <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Stephan> ;
    dcterms:description "Die Vorlesung Triebfahrzeugtechnik behandelt die elektrische Leistungsübertragung in Schienenfahrzeugen, insbesondere die verschiedenen Topologien und Komponenten wie Dieselmotoren, Generatoren und Fahrmotoren. Durch das Studium dieser Inhalte können Lernende ein Verständnis dafür entwickeln, wie die Leistung in Triebfahrzeugen übertragen wird und welche Anforderungen an die verwendeten Komponenten gestellt werden müssen. Zudem werden historische Beispiele und moderne Ausführungen von Fahrzeugen mit elektrischer Leistungsübertragung vorgestellt, um die Entwicklung und den Einsatz dieser Technologie zu veranschaulichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3SPTxfGr9s0M" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Elektrische_Bahnen> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Drehstromgeneratoren>,
        <http://example.org/education/concept/Elektroantriebe>,
        <http://example.org/education/concept/Elektromotoren>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Gleichstrom-Reihenschluss-Maschinen>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Traktionsantriebe>,
        <http://example.org/education/concept/Wechselstrom-Reihenschluss-Maschinen> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

