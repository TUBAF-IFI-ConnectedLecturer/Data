    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die Photopolymerisation ist ein additivem Fertigungsverfahren, bei dem flüssiges Monomer durch Licht-aktiviertes Polymerisationsreaktionen zu festem Polymer umgesetzt wird. Durch die Verwendung von Fotoinitiatoren kann die Polymerisation auf einen bestimmten Bereich begrenzt werden, wodurch eine gezielte Fertigung ermöglicht wird. Dieses Verfahren findet Anwendung in der additiven Fertigung und bietet Möglichkeiten für die Herstellung komplexer Bauteile mit hoher Präzision."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6YBGTmNwib2I" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Chemische_Reaktionen>,
        <http://example.org/education/concept/Fertigungsverfahren>,
        <http://example.org/education/concept/Kunststoffe>,
        <http://example.org/education/concept/Laserstrahlung>,
        <http://example.org/education/concept/Photopolymerisation>,
        <http://example.org/education/concept/Polymerisation>,
        <http://example.org/education/concept/Rapid_Technologien>,
        <http://example.org/education/concept/Ultraviolette_Strahlung> ;
    dcterms:title "Additive Fertigungsverfahren"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8yQtLcr9pCRU a edu:LearningResource ;
    sim:similarTo oer:93fwyXNu08us,
