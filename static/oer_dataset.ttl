oer:9oZsB-R6gzgc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Lindner>,
        <http://example.org/education/person/Pedchenko> ;
    dcterms:description "Die Vorlesung behandelt die Themen Invasive Arten und Waldbrände im Kontext des Klimawandels und der Biodiversität. Durch die Lektüre erfahren die Lernenden, dass invasive Arten eine große Bedrohung für die Ökologie darstellen und dass Menschen Verantwortung für den Schutz der Umwelt übernehmen müssen. Zudem werden Lösungsansätze wie die Anwendung des Overview-Effekts und die Verbesserung der internationalen Zusammenarbeit diskutiert, um die negativen Auswirkungen auf die Umwelt zu minimieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9oZsB-R6gzgc" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kosysteme>,
        <http://example.org/education/concept/%C3%9Cberblickseffekt>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
        <http://example.org/education/concept/Klimaschutz>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Raumfahrt>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Waldbr%C3%A4nde>,
        <http://example.org/education/concept/invasive_Arten> ;
    dcterms:title "Invasive Arten - wie können Menschen die Verantwortung nehmen"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:9pa4nkNbOMjQ a edu:LearningResource ;
    dcterms:description "Der Bestellprozess umfasst die Prüfung von Kundendaten, Bonität und Zahlungsinformationen, bevor die Bestellung an die Produktion weitergeleitet wird. Im Falle von Fehlern oder Ungereimtheiten wird der Prozess abgebrochen und eine Eskalation an den Sachbearbeiter ausgelöst. Durch das Verfolgen dieses Prozesses können Kunden sicherstellen, dass ihre Bestellungen erfolgreich bearbeitet werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9pa4nkNbOMjQ" ;
    dcterms:subject <http://example.org/education/concept/Auftragsbearbeitung>,
        <http://example.org/education/concept/Bestellabwicklung>,
        <http://example.org/education/concept/CRM-Systeme>,
