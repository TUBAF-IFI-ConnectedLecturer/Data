oer:5Nlw6yNwWUxc a edu:LearningResource ;
    sim:similarTo oer:5l6iB0AgYLNM,
        oer:5lK28-tYfrIs,
        oer:5saLiHxSXyEY,
        oer:78ljL3Dl4R3w,
        oer:7F-jfGR5OLU4,
        oer:7FgmeknBoW_I,
        oer:7cGCJiKkCvcw,
        oer:7ohmtOd8ipAE,
        oer:7v8U2x8tGrOU ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Das Dreiphasenmodell nach Gabrielsson (1983) beschreibt den Schreibsprachenwechsel vom Mittelniederdeutschen zum Neuhochdeutschen in Norddeutschland, der sich in drei Phasen vollzog und zu einem Funktionsverlust des Niederdeutschen als Schreib-Literatursprache führte. Der Wechsel wurde durch den Niedergang des norddeutschen Handels- und Kulturraumes, die Erstarkung der Territorialherrschaften und die Konsolidierung der neuhochdeutschen Schriftsprache verursacht. Durch das Studium dieses Prozesses können Lernende die Entwicklung der deutschen Sprache und ihre regionalen Varianten besser verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Nlw6yNwWUxc" ;
    dcterms:subject <http://example.org/education/concept/Hanse>,
        <http://example.org/education/concept/Hochdeutsche_Sprache>,
        <http://example.org/education/concept/Kulturraum>,
        <http://example.org/education/concept/Literatursprache>,
        <http://example.org/education/concept/Mittelniederdeutsch>,
        <http://example.org/education/concept/Niederdeutsche_Sprache>,
        <http://example.org/education/concept/Norddeutschland>,
        <http://example.org/education/concept/Schreibsprachenwechsel>,
        <http://example.org/education/concept/Sprachgeschichte>,
        <http://example.org/education/concept/Verkehrssprache> ;
    dcterms:title "Sr Hansesprache, oder Mittelniederdeutsch als Fremdsprache, Dr. Sabina Tsapaeva"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5pahFvxuA2NA a edu:LearningResource ;
    sim:similarTo oer:8EVYFC-BIuww,
        oer:8FPLZdES6U3I,
        oer:9aG6x_KvBAzw ;
    dcterms:creator <http://example.org/education/person/Babick>,
        <http://example.org/education/person/Wessely> ;
    dcterms:description "Die Grundlagen der Mechanischen Verfahrenstechnik werden dargestellt, einschließlich der Zerkleinerung von Feststoffen, der Einteilung von Zerteilprozessen und der Kenngrößen von Zerkleinerungsprozessen. Die Lernziele umfassen das Wissen über die Zerkleinerungsgesetze, die Grundsätzlichen Beanspruchungsarten zur Zerkleinerung von Partikeln und die Berechnung der zur Zerkleinerung von Feststoffen benötigten Arbeit. Durch das Studium dieser Materialien können Lernende die notwendigen Fähigkeiten und Kenntnisse erwerben, um geeignete Maschinen für gegebene Zerkleinerungsaufgaben auszuwählen und die erforderliche Energie zu berechnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5pahFvxuA2NA" ;
    dcterms:subject <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Feststoffzerkleinerung>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Materialwissenschaft>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Mechanisches_Materialverhalten>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Verfahrenstechnik>,
        <http://example.org/education/concept/Zerkleinerung>,
        <http://example.org/education/concept/Zerkleinerungsarbeit> ;
    dcterms:title "Grundlagen der Mechanischen Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6HeWcwESzCv4 a edu:LearningResource ;
    sim:similarTo oer:6whr5UV0yVCA,
        oer:78ljL3Dl4R3w,
        oer:7mo9F1qEFIg4,
        oer:7v8U2x8tGrOU,
