oer:105rsyTrINkVw a edu:LearningResource ;
    sim:similarTo oer:10C5pdYePSoq8,
        oer:11317Id_pG4R4,
        oer:11CP5JR2hmwvg,
        oer:4Aa6jyAZPDsM,
        oer:5arkQfyeprCQ,
        oer:5tTdTOOQhz-s,
        oer:6Mi5V0pSAALM,
        oer:6rNBc-JCeDPE,
        oer:8QT4t3MzP5pQ ;
    dcterms:creator <http://example.org/education/person/Aurich> ;
    dcterms:description "Das Fragenset dient als Vorbereitung auf einen Test oder als Wiederholung der Stoffeinheit chemische Reaktionen in der Klassenstufe 7 im Lernbereich Umwandlung von Stoffen an sächsischen Gymnasien. Es umfasst allgemeine Begriffe und Anwendungsorientierte Fragen, die mit Bildern visualisiert sind, um den Lernstand der Schüler zu überprüfen. Durch das Bearbeiten des Fragensets können Schüler ihr Wissen über chemische Reaktionen auffrischen und ihre Fähigkeiten im Bereich Umwandlung von Stoffen verbessern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "105rsyTrINkVw" ;
    dcterms:subject <http://example.org/education/concept/Anforderungsbereiche>,
        <http://example.org/education/concept/Bildungsressourcen>,
        <http://example.org/education/concept/Chemieunterricht>,
        <http://example.org/education/concept/Chemische_Reaktionen>,
        <http://example.org/education/concept/Lehrplanverortung>,
        <http://example.org/education/concept/Lernbereich>,
        <http://example.org/education/concept/Online-Fragen>,
        <http://example.org/education/concept/Sch%C3%BClerfeedbacksystem>,
        <http://example.org/education/concept/Schulbildung>,
        <http://example.org/education/concept/Umwandlung_von_Stoffen> ;
    dcterms:title "Lehrplanverortung und Einteilung in Anforderungsbereiche"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:107p_Zaa8NXjU a edu:LearningResource ;
    sim:similarTo oer:10LslmnDXCFg4,
        oer:10Q_vYFYsCzJA,
        oer:10XcXW-htiNK8,
        oer:10m3P_kbmtPaM,
        oer:86LXMnwmscLE,
        oer:8tp6cQ3lyHWg,
        oer:8zKeSPiSTWGE ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Verkehrswirtschaft und erläutert die Besonderheiten von Verkehrsleistungen, einschließlich des Angebots im öffentlichen und privaten Verkehrsbereich. Die Studierenden lernen, wie die Kosten und Preise von Transportleistungen bestimmt werden und wie sich Änderungen am Markt auf das Angebot auswirken. Durch diese Vorlesung erhalten die Lernenden einen Überblick über die wichtigsten Konzepte der Verkehrswirtschaft und ihre Anwendung in verschiedenen Bereichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "107p_Zaa8NXjU" ;
    dcterms:subject <http://example.org/education/concept/Angebotskurve>,
        <http://example.org/education/concept/G%C3%BCterverkehr>,
        <http://example.org/education/concept/Infrastrukturkapazit%C3%A4t>,
        <http://example.org/education/concept/Kosten-Nutzen-Analyse>,
        <http://example.org/education/concept/Luftverkehr>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Stra%C3%9Fenverkehr>,
        <http://example.org/education/concept/Transport%C3%B6konomie>,
        <http://example.org/education/concept/Verkehrsleistung>,
        <http://example.org/education/concept/Verkehrswirtschaft> ;
    dcterms:title "Einführung in die Verkehrswirtschaft"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

