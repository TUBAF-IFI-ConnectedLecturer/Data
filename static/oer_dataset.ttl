    dcterms:creator <http://example.org/education/person/Benabdellah> ;
    dcterms:description "Das Arbeitsheft zur Vorlesung Triebfahrzeugtechnik unterstützt Studierende bei der Analyse von Fahrzeugen hinsichtlich ihres konstruktiven und funktionalen Aufbaus. Durch die Bearbeitung von Fragestellungen zu verschiedenen Aspekten wie Antriebsstrang, Bremse, Mechanischem Aufbau und Fahrwerken erlangen sie ein tiefes Verständnis der Triebfahrzeugtechnik. Die Ergebnisse werden in zwei Webinar-Vorlesungen im Juni präsentiert, wobei die Studierenden ihre Erkenntnisse anderen Teilnehmern der Lehrveranstaltung vorstellen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "114BxxWvnCFcI" ;
    dcterms:subject <http://example.org/education/concept/Antriebssysteme>,
        <http://example.org/education/concept/Bremsen>,
        <http://example.org/education/concept/Energieversorgung>,
        <http://example.org/education/concept/Fahrwerkstechnik>,
        <http://example.org/education/concept/Fahrzeugelektrik>,
        <http://example.org/education/concept/Fahrzeugkonstruktion>,
        <http://example.org/education/concept/Hilfsbetriebe>,
        <http://example.org/education/concept/Mechanischer_Aufbau>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Triebfahrzeugtypen> ;
    dcterms:title "Arbeitsheft zur Vorlesung Triebfahrzeugtechnik  Fallstudien"@de ;
    dcterms:type <http://example.org/education/type/Arbeitsheft> .

