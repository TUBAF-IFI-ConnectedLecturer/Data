    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von Bahnfahrzeugen und deckt Aspekte wie Traktionsleistung, Wagenzugwiderstand und Komfortleistungsbedarf ab. Durch das Studium dieser Materialien können Lernende ein Verständnis dafür entwickeln, wie sich verschiedene Faktoren auf die Leistung von Bahnfahrzeugen auswirken und wie sie bei der Planung und Auslegung von Fahrzeugen berücksichtigt werden müssen. Insbesondere werden Beispiele für die Berechnung des Leistungsbedarfs von Lokomotiven und Wagenzügen sowie die Berücksichtigung von Steigungen und Geschwindigkeiten vorgestellt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5D10ADBwQNtM" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Technik> ;
    dcterms:subject <http://example.org/education/concept/Bahnbetrieb>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Elektrolokomotiven>,
        <http://example.org/education/concept/Fahrleistung>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Traktion>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik Bahnfahrzeuge Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

