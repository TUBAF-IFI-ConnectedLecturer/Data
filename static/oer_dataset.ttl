        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Medizinethik>,
        <http://example.org/education/concept/Medizinische_Versorgung>,
        <http://example.org/education/concept/Operationstechniken>,
        <http://example.org/education/concept/Patientenentscheidung>,
        <http://example.org/education/concept/Robotik_in_der_Medizin> ;
    dcterms:title "Diskussion eines Fallbeispiels"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

