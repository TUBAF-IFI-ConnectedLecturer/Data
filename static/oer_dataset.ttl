    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8vWlYeo97jFM a edu:LearningResource ;
    sim:similarTo oer:9ZJKoyUnW92o ;
    dcterms:description "Dieses Dokument behandelt die Grundlagen der Quantentheorie und Quantenmechanik, einschließlich der Einführung in Operatoren, Eigenwerte und Eigenfunktionen, sowie die Beschreibung von Phänomenen wie der Quantelung der Energie und dem photoelektrischen Effekt. Durch das Studium dieses Materials können Lernende ein Verständnis dafür entwickeln, wie physikalische Größen in der Quantenmechanik beschrieben werden und wie diese Theorie zur Erklärung von Phänomenen beiträgt, die mit klassischer Mechanik nicht erklärbar sind. Insbesondere werden die Arbeiten von Wissenschaftlern wie Einstein, Planck, Wien und anderen vorgestellt, die zu unserem Verständnis der Quantentheorie beigetragen haben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8vWlYeo97jFM" ;
    dcterms:subject <http://example.org/education/concept/Eigenwerte>,
        <http://example.org/education/concept/Energie>,
        <http://example.org/education/concept/Operatoren>,
        <http://example.org/education/concept/Photonen>,
        <http://example.org/education/concept/Physikalische_Gr%C3%B6%C3%9Fen>,
        <http://example.org/education/concept/Quantelung>,
        <http://example.org/education/concept/Quantenmechanik>,
        <http://example.org/education/concept/Schr%C3%B6dingergleichung>,
        <http://example.org/education/concept/Schwarzer_K%C3%B6rper>,
        <http://example.org/education/concept/Strahlung> ;
    dcterms:title "Quantentheorie"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:9-PhHY0psf3s a edu:LearningResource ;
    sim:similarTo oer:9RzBzzKc2c7g ;
    dcterms:description "Das Bierschaumexperiment simuliert einen radioaktiven Zerfallsprozess und dokumentiert die exponentielle Abnahme der Höhe der Schaumkrone eines Bierglases in einem Diagramm. Durch das Experiment können Lernende die zeitabhängige Änderung der Schaumkrone beobachten und messen. Die Aufgabenstellung umfasst die Benötigung von Materialien wie einem hohen Glas, einer Flasche Bier, einem Lineal und einer Stoppuhr."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9-PhHY0psf3s" ;
    dcterms:subject <http://example.org/education/concept/Bierglas>,
        <http://example.org/education/concept/Experiment>,
        <http://example.org/education/concept/Exponentielle_Abnahme>,
        <http://example.org/education/concept/Glasphysik>,
        <http://example.org/education/concept/Messung>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Radioaktivit%C3%A4t>,
        <http://example.org/education/concept/Schaumkrone>,
        <http://example.org/education/concept/Zeitabh%C3%A4ngigkeit>,
        <http://example.org/education/concept/Zerfallsprozesse> ;
    dcterms:title "Bierschaumexperiment"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

