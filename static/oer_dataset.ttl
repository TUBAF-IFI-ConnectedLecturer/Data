    dcterms:creator <http://example.org/education/person/Gerhards> ;
    dcterms:description "Die Grundlagen von GIS umfassen die Ähnlichkeitssegmentierung über kMeans-Klassifikation und Thresholding, wobei die Klassenzentren und Schwellwerte bestimmt werden, um Datenpunkte in Klassen zu ordnen. Weiterhin werden Kantendetektion und Filtermethoden wie Median-Filterung und nicht-lineare Diffusion behandelt, um Rasterbilder zu verarbeiten und zu analysieren. Durch das Studium dieser Grundlagen können Lerner die Fähigkeit erwerben, GIS-Anwendungen zu entwickeln und zu nutzen, um komplexe Probleme in der Geoinformatik zu lösen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3_bj4gkSXHJ4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/%C3%84hnlichkeitssegmentierung>,
        <http://example.org/education/concept/Bildverarbeitung>,
        <http://example.org/education/concept/Diffusionsfilterung>,
        <http://example.org/education/concept/Filtermethoden>,
        <http://example.org/education/concept/Geoinformatik>,
        <http://example.org/education/concept/Grauwert-Bilder>,
        <http://example.org/education/concept/Image-Segmentation>,
        <http://example.org/education/concept/Kantendetektion>,
        <http://example.org/education/concept/Klassifikation>,
        <http://example.org/education/concept/Rasterdaten> ;
    dcterms:title "Grundlagen GIS"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:3wnkfl7XzxUk a edu:LearningResource ;
    sim:similarTo oer:3zez7VC5ots8,
        oer:4YZ_KqWqkjTo,
        oer:4frrVuDkllpw,
        oer:57NQVGURiSVM,
        oer:5J7xTLHG-ql8,
