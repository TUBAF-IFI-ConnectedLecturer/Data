oer:5mBo7yiY2ux8 a edu:LearningResource ;
    sim:similarTo oer:7L8EI5xvFxgM,
        oer:7PjjiAU1F7EQ,
        oer:85Qff396_deE,
        oer:8hNtsogSOgH0 ;
    dcterms:creator <http://example.org/education/person/Hetze> ;
    dcterms:description "Das Programmierbeispiel behandelt die Bearbeitung einer Matrix mit 4 Zeilen und 3 Spalten, um das Element mit dem größten Wert zu finden und anschließend die zugehörige Zeile und Spalte zu tauschen. Der Lösungsansatz verwendet zweidimensionale Felder in C++ und demonstriert die Verwendung von Schleifen und Bedingungen zur Matrixbearbeitung. Durch das Durcharbeiten dieses Beispiels können Lerner die Grundlagen der Programmierung mit Matrizen erlernen und ihre Fähigkeiten im Umgang mit zweidimensionalen Feldern verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5mBo7yiY2ux8" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Algorithmische_L%C3%B6sungen>,
        <http://example.org/education/concept/C%2B%2B>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Matrixoperationen>,
        <http://example.org/education/concept/Programmiersprachen>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Zweidimensionale_Felder> ;
    dcterms:title "Einführung in das Programmieren"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

