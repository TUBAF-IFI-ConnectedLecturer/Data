oer:9m7itwCnb3l4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Fischel>,
        <http://example.org/education/person/Horn>,
        <http://example.org/education/person/M%C3%BCller> ;
    dcterms:description "Die Vorlesung behandelt die Geschichte der Kunst und Architektur von der Renaissance bis zum 16. Jahrhundert, mit Schwerpunkt auf den Werken von Künstlern wie Leonardo da Vinci, Michelangelo und Albrecht Dürer. Durch das Studium dieser Materialien können Lerner ein Verständnis für die Entwicklung der Kunst und Architektur in dieser Zeit entwickeln und die Bedeutung von Künstlern und ihren Werken erkennen. Darüber hinaus werden kunsttheoretische Konzepte und die Rolle von Akademien und Werkstätten bei der Förderung künstlerischer Entwicklung erläutert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9m7itwCnb3l4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Architektur>,
        <http://example.org/education/concept/Italienische_Renaissance>,
        <http://example.org/education/concept/K%C3%BCnstlerbiographie>,
        <http://example.org/education/concept/Kunstgeschichte>,
        <http://example.org/education/concept/Kunstliteratur>,
        <http://example.org/education/concept/Kunsttheorie>,
        <http://example.org/education/concept/Malerei>,
        <http://example.org/education/concept/Renaissance>,
        <http://example.org/education/concept/Skulptur> ;
    dcterms:title "Das Leben und die Werke der berühmten Architekten, Maler und Bildhauer."@de ;
    dcterms:type <http://example.org/education/type/Skript> .

