        oer:89T0mlw33VfE,
        oer:8EVQufcxbKck,
        oer:8Iq1XDtZbkZo,
        oer:8RCwGTxWabDo,
        oer:9LnXOs6zIBSA ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Übungsaufgaben behandeln Strömungsprobleme der Mechanischen Verfahrenstechnik und konzentrieren sich auf die Abtrennung von Schleifpartikeln mittels eines Hydrozyklons. Durch die Lösung der Aufgaben können Lernende den kleinstmöglichen Gesamtabscheidegrad, die effektive Sinkgeschwindigkeit und den Trenngrad für bestimmte Partikelgrößen berechnen und verstehen, wie diese Parameter bei der Suspensionsteilung beeinflusst werden. Die Aufgaben dienen dazu, das Verständnis von Strömungsproblemen und der Anwendung von Modellen zur Berechnung von Trenngraden zu fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "32AdYV6jW83Y" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Fluidmechanik>,
        <http://example.org/education/concept/Hydrozyklon>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Partikelabscheidung>,
        <http://example.org/education/concept/Sinkgeschwindigkeit>,
        <http://example.org/education/concept/Str%C3%B6mungskanal>,
        <http://example.org/education/concept/Str%C3%B6mungsmechanik>,
        <http://example.org/education/concept/Suspensionsteilung>,
        <http://example.org/education/concept/Trenngrad>,
        <http://example.org/education/concept/Turbulenz> ;
    dcterms:title "Übungsaufgaben Strömungsprobleme der MVT"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:52NSb-r7L844 a edu:LearningResource ;
    sim:similarTo oer:5bBor74tCxSU,
