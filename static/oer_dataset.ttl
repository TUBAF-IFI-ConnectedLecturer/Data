    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Henschel> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs WS2022/23 an der Hochschule für Technik und Wirtschaft Dresden bietet eine Sammlung von Aufgaben und Lösungen zu verschiedenen mathematischen Themen wie Summen, Induktion, Binomialkoeffizienten und komplexen Zahlen. Durch die Bearbeitung dieser Aufgaben können Lernende ihre Fähigkeiten in der Anwendung mathematischer Konzepte und Techniken verbessern und ihr Verständnis für algebraische und analytische Methoden erweitern. Die Lösungen dienen als Hilfestellung, um die eigenen Ergebnisse zu überprüfen und alternative Lösungsansätze zu diskutieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9BDND88Y2yQA" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Betragsungleichungen>,
        <http://example.org/education/concept/Binomialkoeffizienten>,
        <http://example.org/education/concept/Gau%C3%9Fsche_Summenformel>,
        <http://example.org/education/concept/Komplexe_Zahlen>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Rekursionsformeln>,
        <http://example.org/education/concept/Vollst%C3%A4ndige_Induktion>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Mathematik 1 - WS2022/23 Übungsblatt 4"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

