    dcterms:description "Die Standardsprache wird definiert und ihre Merkmale erläutert, um die Variation der deutschen Standardsprache zu verstehen. Der Begriff Sprachverfall wird diskutiert, indem seine Geschichte, Irrtümer und heutige Sichtweise dargestellt werden, um die dynamische Flexibilität von Sprache aufzuzeigen. Durch das Verständnis dieser Konzepte können Lernende die komplexe Natur der Sprache erkennen und ihre Rolle in der Kommunikation besser verstehen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "12ndjv2dIsBj8" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Jugendsprache>,
        <http://example.org/education/concept/Kiezdeutsch>,
        <http://example.org/education/concept/Kommunikationstheorie>,
        <http://example.org/education/concept/Soziolinguistik>,
        <http://example.org/education/concept/Sprachnorm>,
        <http://example.org/education/concept/Sprachvariet%C3%A4t>,
        <http://example.org/education/concept/Sprachverfall>,
        <http://example.org/education/concept/Sprachwissenschaft>,
        <http://example.org/education/concept/Standardsprache> ;
    dcterms:title "Das Kräftefeld der Sprache und die Diskussion um den Sprachverfall"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:12qnAq4EAya7A a edu:LearningResource ;
