oer:66BFD588LBO4 a edu:LearningResource ;
    sim:similarTo oer:8EVQufcxbKck ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die physikalische Gasadsorption an Feststoffen nach der BET-Theorie wird erläutert, einschließlich der Berechnungsgrundlagen und der verschiedenen Typen von Adsorptionsisothermen. Die Fakultät Maschinenwesen des Instituts für Verfahrenstechnik und Umwelttechnik bietet eine Lehrveranstaltung zu Grenzflächenphänomenen an, die sich mit der Charakterisierung poröser Feststoffe und der Messung der spezifischen Oberfläche befasst. Durch diese Materialien können Lernende das Verständnis von Adsorptionsprozessen und ihre Anwendung in verschiedenen Bereichen erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "66BFD588LBO4" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen_Institut_f%C3%BCr_Verfahrenstechnik_und_Umwelttechnik> ;
    dcterms:subject <http://example.org/education/concept/Adsorptionsisothermen>,
        <http://example.org/education/concept/BET-Theorie>,
        <http://example.org/education/concept/Festk%C3%B6rper>,
        <http://example.org/education/concept/Gasadsorption>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenph%C3%A4nomene>,
        <http://example.org/education/concept/Mesopor%C3%B6se_Materialien>,
        <http://example.org/education/concept/Oberfl%C3%A4cheneigenschaften>,
        <http://example.org/education/concept/Physikalische_Chemie>,
        <http://example.org/education/concept/Porosit%C3%A4t>,
        <http://example.org/education/concept/Verfahrenstechnik> ;
    dcterms:title "Grenzflächenphänomene"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:66pIeQLkVmhQ a edu:LearningResource ;
    sim:similarTo oer:6SeAIQbBciKs,
        oer:6nFM7ALYiJL4,
        oer:6seY40ce3q_E,
        oer:6yWhr2AmZLhQ,
