        <http://example.org/education/concept/Kniegelenk>,
        <http://example.org/education/concept/Muskelfunktion>,
        <http://example.org/education/concept/Orthop%C3%A4die>,
        <http://example.org/education/concept/Rumpf>,
        <http://example.org/education/concept/Sprunggelenk> ;
    dcterms:title "Protokoll Ganganalyse"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:12zrrsjkW23Rc a edu:LearningResource ;
    sim:similarTo oer:15V_ZQmepfR0,
