oer:105Ydhg9mA4s8 a edu:LearningResource ;
    sim:similarTo oer:122vBtqrTbVfk,
        oer:12jjhwXs5PN_w,
        oer:5ju6DUf2wqG0,
        oer:5rNgIPOp086A,
        oer:7-p5vgbhqc7w ;
    dcterms:creator <http://example.org/education/person/Navarro> ;
    dcterms:description "Die Studie untersucht den Einfluss der Need for Cognition (NFC) auf die Entscheidungsfindung im Iowa Gambling Task (IGT), einem Entscheidungsspiel mit fiktivem Geld. Die Ergebnisse zeigen, dass sich die Gruppen NFC high und NFC low in ihren Werten signifikant voneinander unterscheiden, jedoch keinen Einfluss auf die vorteilhaften Entscheidungen während des IGTs haben. Durch diese Studie können Lernende Einsichten in die Beziehung zwischen NFC und Entscheidungsfindung gewinnen und verstehen, wie individuelle Unterschiede in der NFC die Entscheidungsprozesse beeinflussen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "105Ydhg9mA4s8" ;
    dcterms:subject <http://example.org/education/concept/Entscheidungsspiel>,
        <http://example.org/education/concept/Entscheidungstheorie>,
        <http://example.org/education/concept/Experimentelle_Psychologie>,
        <http://example.org/education/concept/Fragebogen>,
        <http://example.org/education/concept/Geldgewinn>,
        <http://example.org/education/concept/Kognition>,
        <http://example.org/education/concept/Need_for_Cognition>,
        <http://example.org/education/concept/Online-Experiment>,
        <http://example.org/education/concept/Risikoverhalten>,
        <http://example.org/education/concept/Verhaltens%C3%B6konomie> ;
    dcterms:title "Replikation der Studie von Bless et al. (2001) zum Zusammenhang zwischen Need for Cognition und Entscheidungsverhalten im Iowa Gambling Task"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:109aOzI2QhDTo a edu:LearningResource ;
    sim:similarTo oer:10npINWAxgVmQ,
        oer:10oQSo2mexrDk,
        oer:10rJQY58ku9MQ,
        oer:10yLo231CnA9k,
        oer:4XqF74yv38yA ;
    dcterms:creator <http://example.org/education/person/Hirte> ;
    dcterms:description "Die Stadtökonomie behandelt die Analyse von Städten als Wirtschaftsräume, in denen Menschen und Unternehmen zusammenarbeiten und sich gegenseitig beeinflussen. Durch das Studium dieser Disziplin können Lernende verstehen, wie städtische Systeme funktionieren, wie sie durch politische Maßnahmen und Investitionen beeinflusst werden können und wie sie nachhaltiger und lebenswerter gestaltet werden können. Insbesondere werden Themen wie Agglomerationseffekte, Stadtplanung, Verkehrspolitik und Umweltschutz behandelt, um Lernenden ein umfassendes Verständnis der städtischen Ökonomie zu vermitteln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "109aOzI2QhDTo" ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomische_Geographie>,
        <http://example.org/education/concept/Agglomerationseffekte>,
        <http://example.org/education/concept/Bodenrente>,
        <http://example.org/education/concept/Mobilit%C3%A4t>,
        <http://example.org/education/concept/Raumplanung>,
        <http://example.org/education/concept/Siedlungsstruktur>,
        <http://example.org/education/concept/Stadt%C3%B6konomie>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Urbanisierung>,
        <http://example.org/education/concept/Verkehrspolitik> ;
    dcterms:title "Regional- und Stadtökonomie"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:10ELTnwlG8PVc a edu:LearningResource ;
    sim:similarTo oer:10EfPpzcdj6WM,
        oer:10tsAmGwAwGsI,
        oer:10xw09Htu2BAo,
        oer:118KiYNq86mYE,
        oer:4QV3zUKoIYt0 ;
    dcterms:description "Die Wahrnehmung von Farben, Geschmacksrichtungen und Gerüchen wird durch spezifische Rezeptoren im Auge, auf der Zunge und in der Nase ermöglicht, die bestimmte Signale an das Gehirn senden. Durch die Verarbeitung dieser Signale können wir unsere Umwelt wahrnehmen und unterschiedliche Geschmacksrichtungen, Farben und Gerüche unterscheiden. Das Verständnis dieser Prozesse ist wichtig für die Erforschung von Wahrnehmungsstörungen und die Entwicklung neuer Therapien."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10ELTnwlG8PVc" ;
    dcterms:publisher <http://example.org/education/organization/USEB_HS_Zittau> ;
    dcterms:subject <http://example.org/education/concept/Farbwahrnehmung>,
        <http://example.org/education/concept/Gehirnareale>,
        <http://example.org/education/concept/Geschmackssinn>,
        <http://example.org/education/concept/H%C3%B6rschwelle>,
        <http://example.org/education/concept/Neurophysiologie>,
        <http://example.org/education/concept/Schallumwandlung>,
        <http://example.org/education/concept/Sehsystem>,
        <http://example.org/education/concept/Tonotopie>,
        <http://example.org/education/concept/Transduktion>,
        <http://example.org/education/concept/Wahrnehmung> ;
    dcterms:title "Wahrnehmung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:10PGI-0CuHBSQ a edu:LearningResource ;
    sim:similarTo oer:10PxK7ZuRUMZY,
        oer:12RfFRmtHZFA8,
        oer:5bSSPaSadvpw ;
    dcterms:creator <http://example.org/education/person/Huesser>,
        <http://example.org/education/person/Schuessler> ;
    dcterms:description "Die SchülerInnen lernen, wie sie Algorithmen im gesellschaftlichen Leben anwenden und problemlösende Verhaltensweisen zum Lösen von einfachen Problemstellungen entwickeln können. Durch die Arbeit mit micro:bits und der Implementierung einer Ampelschaltung an einer Kreuzung erwerben sie praktische Erfahrungen im Bereich der Programmierung und des Einsatzes von Schaltnetzen. Am Ende dieses Prozesses sind die SchülerInnen in der Lage, komplexe Systeme zu verstehen und selbstständig Probleme zu lösen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "10PGI-0CuHBSQ" ;
    dcterms:subject <http://example.org/education/concept/Ampelsteuerung>,
        <http://example.org/education/concept/Bibliothekskatalogisierung>,
        <http://example.org/education/concept/Funkkommunikation>,
        <http://example.org/education/concept/Here_is_the_list_of_10_keywords_assigned_to_the_document%3ASchaltungstechnik>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Mikrocontroller>,
        <http://example.org/education/concept/Python-Programmierung>,
        <http://example.org/education/concept/Verkehrssignalisation>,
        <http://example.org/education/concept/akademische_Literatur> ;
    dcterms:title "Modell einer Ampelschaltung mit micro:bit"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:10VUhX8M_u0gc a edu:LearningResource ;
    sim:similarTo oer:118G1D-Th_uZE,
        oer:11Lr8n3qpc7PE,
        oer:12yN_rXxxa_P0,
        oer:3hRxvgno4Xyc,
        oer:4OegHrfyndIA,
        oer:4uLW3eVRAL6I,
        oer:6QpCdiHB4H04 ;
    dcterms:description "Die Lernziele im Unterricht konzentrieren sich auf die Vermittlung von Algorithmen und Programmierkonzepten, um Schülerinnen und Schülern die Fähigkeit zu vermitteln, eigene Programme zu entwickeln und Algorithmen anhand ihrer Anwendungsgebiete zu beurteilen. Durch das Erreichen dieser Ziele sollen die Lernerinnen und Lerner in der Lage sein, komplexe Probleme zu lösen und Programme selbstreflexiv zu bewerten. Die Inhalte des Lernbereichs umfassen die Gestaltung eigener Algorithmusentwürfe, die Implementierung von Programmen und die Übertragung von Kenntnissen auf maschinelle Entscheidungen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10VUhX8M_u0gc" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Algorithmusentwurf>,
        <http://example.org/education/concept/Anwendungsgebiete>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Modularisierung>,
        <http://example.org/education/concept/Probleml%C3%B6sung>,
        <http://example.org/education/concept/Programmierkonzepte>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Selbstreflexion>,
        <http://example.org/education/concept/Softwareentwicklung> ;
    dcterms:title "Std. Lernziele (LB1 Kl.10)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10Y8Q365m1caA a edu:LearningResource ;
    sim:similarTo oer:10iBne6I8rdSg,
        oer:10wurVWhr4748,
        oer:129BYvICquq2c,
        oer:8EJDjWBD2ik8,
        oer:8YAjhIAhjiYk ;
    dcterms:creator <http://example.org/education/person/Schlag> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Themen Rechnernetze und Sicherheit von Informationen für Schüler der Klasse 11 im Gymnasium. Durch den Stoffverteilungsplan sollen die Lernenden Grundlagen über Rechnernetze, Modellierung von Rechnernetzen, Informationssicherheit und Datenschutz erwerben. Am Ende des Lehrplans können die Schüler selbstständig ein 3D-Modell erstellen und asymmetrische Verschlüsselung anwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10Y8Q365m1caA" ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/3D-Modellierung>,
        <http://example.org/education/concept/Computersicherheit>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Informationssicherheit>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Netzwerksicherheit>,
        <http://example.org/education/concept/Rechnernetze>,
        <http://example.org/education/concept/Verschl%C3%BCsselung> ;
    dcterms:title "Stoffverteilungsplan Klasse 11/2"@de ;
    dcterms:type <http://example.org/education/type/Stoffverteilungsplan> .

oer:10izawD5Y_PtE a edu:LearningResource ;
    sim:similarTo oer:11NaaxBTH71uw,
        oer:11W1pTQL9PH-E,
        oer:3CjglHSmUuiY ;
    dcterms:creator <http://example.org/education/person/Braun> ;
    dcterms:description "Die Plattform-as-a-Service-(PaaS)-Anbieter stellen eine Umgebung bereit, in der Entwickler Anwendungen entwickeln, deployen und ausführen können, ohne sich um die zugrunde liegende Infrastruktur kümmern zu müssen. PaaS bietet Vorteile wie Load Balancing, Autoscaling, Monitoring und Multi-Tenant-Unterstützung, wodurch Entwickler sich auf die Logik und den Inhalt der Anwendung konzentrieren können. Durch die Verwendung von PaaS können Kosten für Bereitstellung und Betrieb von Anwendungen reduziert werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10izawD5Y_PtE" ;
    dcterms:subject <http://example.org/education/concept/Bereitstellung_von_Anwendungen>,
        <http://example.org/education/concept/Cloud-Infrastruktur>,
        <http://example.org/education/concept/Cloud_Computing>,
        <http://example.org/education/concept/Datenbank_as_a_Service_%28DBaaS%29>,
        <http://example.org/education/concept/Funktion_as_a_Service_%28FaaS%29>,
        <http://example.org/education/concept/Lastenausgleich>,
        <http://example.org/education/concept/Platform_as_a_Service_%28PaaS%29>,
        <http://example.org/education/concept/Serverless_Computing>,
        <http://example.org/education/concept/Skalierbarkeit>,
        <http://example.org/education/concept/Web-Anwendungsentwicklung> ;
    dcterms:title "Vorlesung Service and Cloud Computing"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

