        <http://example.org/education/concept/Mensch-Maschine-Interaktion>,
        <http://example.org/education/concept/Mensch-Maschine-Systemtechnik>,
        <http://example.org/education/concept/Prozessleittechnik>,
        <http://example.org/education/concept/Systemverfahrenstechnik> ;
    dcterms:title "Übung MMST Human Factors 2"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3_hL4XOx0D0U a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Rex> ;
    dcterms:description "Die TU Dresden entwickelt eine Super-App, die alle Kommunikationsseiten und Funktionen für Studenten vereint, um den Unialltag zu erleichtern und die Digitalisierung voranzutreiben. Die App soll Studierenden ermöglichen, leichter miteinander in Kontakt zu treten, Gruppen zu organisieren und Angebote der Stadt Dresden zu nutzen. Durch die Implementierung dieser App können Studenten ihre Zufriedenheit erhöhen, während die Universität ihre Nachhaltigkeit fördert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3_hL4XOx0D0U" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Hochschule>,
        <http://example.org/education/concept/Informationstechnologie>,
        <http://example.org/education/concept/Kommunikation>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Ressourcenverbrauch>,
        <http://example.org/education/concept/Studenten>,
        <http://example.org/education/concept/Umwelt>,
        <http://example.org/education/concept/Universit%C3%A4t>,
        <http://example.org/education/concept/Vernetzung> ;
    dcterms:title "Eine Super-App für die Universität"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:3aF4qMYy9XwQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Behl>,
        <http://example.org/education/person/Sun>,
        <http://example.org/education/person/Zylla> ;
    dcterms:description "Das Praktikum behandelt die Kraftmessung mit Dehnmessstreifen an einem Biegebalken und untersucht die Empfindlichkeit von verschiedenen Brückenschaltungen. Durch den Einsatz von Halb- und Vollbrücken können größere Lasten gemessen werden, während die Positionierung der DMS nahe an der Einspannstelle für eine höhere Empfindlichkeit sorgt. Die Ergebnisse zeigen, dass die Wahl der richtigen Brückenschaltung und die Positionierung der DMS entscheidend für die Genauigkeit der Kraftmessung sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3aF4qMYy9XwQ" ;
    dcterms:subject <http://example.org/education/concept/Belastung>,
        <http://example.org/education/concept/Biegebalken>,
        <http://example.org/education/concept/Dehnmessstreifen>,
        <http://example.org/education/concept/Dehnmesstechnik>,
        <http://example.org/education/concept/Empfindlichkeit>,
        <http://example.org/education/concept/Frequenz>,
        <http://example.org/education/concept/Kraftmessung>,
        <http://example.org/education/concept/Messbr%C3%BCcken>,
        <http://example.org/education/concept/Schwingungen>,
        <http://example.org/education/concept/Spannung> ;
    dcterms:title "Praktikum Sensor- und Sensorsignalauswertung"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:3bPjlPP-7G40 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Burchhardt> ;
    dcterms:description "Das Projekt \"Physical Computing\" ermöglicht es Schülern, einen Zimmergärtner zu erstellen, der die Feuchtigkeit im Boden misst und bei Bedarf eine Pflanze gießt. Durch das Projekt lernen die Schüler, Algorithmen und Programmierkonzepte anzuwenden, um ein technisches System aufzubauen und zu steuern. Am Ende des Projekts können die Schüler einen funktionsfähigen Zimmergärtner präsentieren, der die Bodenfeuchtigkeit überwacht und automatisch gießt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3bPjlPP-7G40" ;
    dcterms:subject <http://example.org/education/concept/Algorithmus>,
        <http://example.org/education/concept/Automatisierung>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Feuchtigkeitssensor>,
