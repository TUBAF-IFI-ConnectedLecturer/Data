oer:8rcdiwFnJVYc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Neugebauer> ;
    dcterms:description "Die Verwendung des Schlüsselworts \"static\" in Java ermöglicht die Deklaration von Klassen und Methoden, die unabhängig von Objekten aufgerufen werden können. Durch die Anwendung von \"static\" können Algorithmen auf Collections angewendet und mathematische Funktionen implementiert werden, die nur von übergebenen Werten abhängen. Die Beispiele im Dokument veranschaulichen die Möglichkeiten und Einschränkungen des \"static\"-Schlüsselworts in verschiedenen Kontexten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8rcdiwFnJVYc" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Java>,
        <http://example.org/education/concept/Klassen>,
        <http://example.org/education/concept/Objektorientierte_Programmierung>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Singleton-Muster>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Statische_Methoden>,
        <http://example.org/education/concept/Statische_Variablen> ;
    dcterms:title "Programmierung II"@de ;
