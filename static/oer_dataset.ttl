        <http://example.org/education/concept/RFID>,
        <http://example.org/education/concept/Satellitennavigation>,
        <http://example.org/education/concept/Tracking> ;
    dcterms:title "Grundlagen Wissenschaftlichen Arbeitens"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:1JokrK82KSYY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Dempe>,
        <http://example.org/education/person/Schreier>,
        <http://example.org/education/person/Zimmermann> ;
    dcterms:description "Das Modul \"Operations Research\" behandelt die Grundlagen und Methoden des Operations Research, einschließlich linearen Optimierung, ganzzahliger linearen Optimierung und diskreter Optimierung. Durch das Studium dieses Moduls erwerben die Lernenden Kenntnisse über die Anwendung von Operations-Research-Methoden in verschiedenen Anwendungsgebieten. Das Modul umfasst eine Vorlesung, ein Seminar und eine Klausur und wird mit 1 ECTS-Punkt bewertet."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1JokrK82KSYY" ;
    dcterms:subject <http://example.org/education/concept/Betriebsforschung>,
        <http://example.org/education/concept/Entscheidungstheorie>,
        <http://example.org/education/concept/Managementwissenschaft>,
