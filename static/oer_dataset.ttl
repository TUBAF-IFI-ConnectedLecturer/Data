    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von Bahnfahrzeugen und deckt Themen wie Antriebskräfte, Zugkraft-Geschwindigkeits-Diagramme und Fahrwiderstandskräfte ab. Durch das Studium dieser Inhalte können Lernende das Traktionsvermögen von Bahnfahrzeugen beurteilen und den Energie- und Leistungsbedarf berechnen. Die Vorlesung bietet eine umfassende Einführung in die Grundlagen der Fahrzeitberechnung und Zugfahrtsimulation."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Z1zzp-Hosf8" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Fahrzeitberechnung>,
        <http://example.org/education/concept/Fahrzeugsimulation>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Geschwindigkeit>,
        <http://example.org/education/concept/Schienenfahrzeug>,
        <http://example.org/education/concept/Traktion>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik Bahnfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

