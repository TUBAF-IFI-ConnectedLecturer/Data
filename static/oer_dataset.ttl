        <http://example.org/education/concept/Wasser>,
        <http://example.org/education/concept/physikalische_Chemie> ;
    dcterms:title "ALösemittel Wasser"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3PQWTLdGbkf4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schreiner>,
        <http://example.org/education/person/Wagner>,
        <http://example.org/education/person/Wiedemann> ;
    dcterms:description "Die SMART-Methode ist ein effektives Werkzeug für Zielmanagement, das fünf Kriterien umfasst: Spezifisch, Messbar, Attraktiv, Realistisch und Terminiert. Durch die Anwendung dieser Methode können Ziele klar definiert und strukturiert werden, was zu einer verbesserten Motivation und Zielerreichung führt. Diese Methode kann in verschiedenen Bereichen wie Studium, Beruf und persönlichem Leben eingesetzt werden, um langfristigen Erfolg zu erzielen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3PQWTLdGbkf4" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Erfolg>,
        <http://example.org/education/concept/F%C3%BChrungstechniken>,
        <http://example.org/education/concept/Leistungsmessung>,
        <http://example.org/education/concept/Motivation>,
        <http://example.org/education/concept/Projektmanagement>,
        <http://example.org/education/concept/SMART-Methode>,
        <http://example.org/education/concept/Selbstmanagement>,
        <http://example.org/education/concept/Zieldefinition>,
        <http://example.org/education/concept/Zielplanung>,
        <http://example.org/education/concept/Zielsetzung> ;
    dcterms:title "Ziele erreichen - Die SMART-Methode als Schlüssel zum Erfolg"@de ;
    dcterms:type <http://example.org/education/type/Poster> .

oer:3PuKXCpQL46Q a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Dieses Arbeitspapier behandelt die diachrone Variation der deutschen Sprache und ihre Entwicklung von der germanischen bis zur neuhochdeutschen Phase. Es erläutert phonologische Veränderungen wie Konsonantenverschiebungen, Umlaute und lautliche Anpassungen anhand von Beispielen aus dem Mittelhochdeutschen und Frühneuhochdeutschen. Durch die Bearbeitung dieser Aufgaben können Lernende die historische Entwicklung der deutschen Sprache besser verstehen und ihre Kenntnisse über die Linguistik und Sprachgeschichte des Deutschen erweitern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3PuKXCpQL46Q" ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Diachrone_Variation>,
        <http://example.org/education/concept/Etymologie>,
        <http://example.org/education/concept/Grammatischer_Wechsel>,
        <http://example.org/education/concept/Historische_Grammatik>,
        <http://example.org/education/concept/Konsonantenverschiebung>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Phonologie>,
        <http://example.org/education/concept/Umlaut>,
        <http://example.org/education/concept/Vokalwandlung> ;
    dcterms:title "Grundlagen der Linguistik und Sprachgeschichte des Deutschen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

