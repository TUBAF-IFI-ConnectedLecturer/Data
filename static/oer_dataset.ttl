oer:16dIbUwvPfJ90 a edu:LearningResource ;
    sim:similarTo oer:16iXq9_i0CMiI ;
    dcterms:creator <http://example.org/education/person/Funk>,
        <http://example.org/education/person/Hartmann>,
        <http://example.org/education/person/Nietmann> ;
    dcterms:description "Die Präsentation wird strukturiert durch Einleitung, Hauptteil und Schluss, wobei das Ziel der Präsentation im Vordergrund steht und die Gliederung darauf abzielt, dieses Ziel zu erreichen. Durch die Orientierung an dem Ziel und die Beachtung des Wissensstands der Zuhörerschaft kann eine effektive Kommunikation sichergestellt werden. Die Präsentation soll die Kernpunkte hervorheben und ein eigenes Fazit ziehen, um die Zuhörer und Zuhörerinnen zu überzeugen und ihnen einen Mehrwert zu bieten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "16dIbUwvPfJ90" ;
    dcterms:subject <http://example.org/education/concept/Diskussionsleitung>,
        <http://example.org/education/concept/Fragestellungen>,
        <http://example.org/education/concept/Inhaltsstrukturierung>,
