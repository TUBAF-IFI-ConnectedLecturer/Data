        <http://example.org/education/concept/Rechnerarchitektur>,
        <http://example.org/education/concept/Schaltnetz>,
        <http://example.org/education/concept/Signalverarbeitung> ;
    dcterms:title "Rechnerstrukturen und -organisation (RSO)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

