        <http://example.org/education/concept/Sicherheitspolitik>,
        <http://example.org/education/concept/Supermacht>,
        <http://example.org/education/concept/USA>,
        <http://example.org/education/concept/Wirtschaftliche_Zusammenarbeit> ;
    dcterms:title "Textanalyse BM: Einführung in das Studium der internationalen Beziehungen SS 2023"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

