        <http://example.org/education/person/M.>,
        <http://example.org/education/person/Sauer> ;
    dcterms:description "Die Konstitutive Entscheidungen im Unternehmen umfassen grundlegende und langfristig wirksame Entscheidungen, die den weiteren Gestaltungs- und Handlungsrahmen des Unternehmens bestimmen. Durch die Lektüre dieses Dokuments können Lernende ein Verständnis dafür entwickeln, wie solche Entscheidungen getroffen werden, insbesondere im Hinblick auf die Standortwahl, Rechtsform und Organisationsstruktur eines Unternehmens. Darüber hinaus werden auch Entscheidungsmodelle bei Risiko und Unsicherheit erläutert, um Lernenden zu helfen, komplexe Entscheidungssituationen zu bewältigen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7i00Q-WpSkLg" ;
    dcterms:subject <http://example.org/education/concept/Betriebswirtschaftslehre>,
        <http://example.org/education/concept/Controlling>,
        <http://example.org/education/concept/Entscheidungsfindung>,
        <http://example.org/education/concept/Finanzierung>,
        <http://example.org/education/concept/Leistungserstellung>,
        <http://example.org/education/concept/Organisation>,
        <http://example.org/education/concept/Personalwesen>,
        <http://example.org/education/concept/Rechnungswesen>,
        <http://example.org/education/concept/Risikomanagement>,
        <http://example.org/education/concept/Unternehmensf%C3%BChrung> ;
    dcterms:title "Grundlagen der Entscheidungstheorie und des bibliographischen Katalogisierens und Indexierens"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:84kozYvYTLU4 a edu:LearningResource ;
    sim:similarTo oer:9hWZpjyhQa-o ;
    dcterms:creator <http://example.org/education/person/B%C3%B6hme>,
        <http://example.org/education/person/Hoffmann>,
        <http://example.org/education/person/Janke> ;
    dcterms:description "Das Tutorium \"Wissenschaftliches Arbeiten in den Geowissenschaften\" richtet sich an Lehramtsstudierende der Fächer Geographie und Geodäsie und soll ihnen Kompetenzen wissenschaftlichen Arbeitens nahebringen. Durch die Teilnahme am Modul können Studierende ihre Fähigkeiten im Umgang mit Literatur, wissenschaftlichem Schreiben und Planung von Unterrichtsstunden verbessern. Das Tutorium umfasst Vorlesungen, Übungen und Tutorien, die auf die Vorbereitung der Staatsexamensarbeit und die eigene Weiterbildung abzielen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "84kozYvYTLU4" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bildungsforschung>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Forschungspraxis>,
        <http://example.org/education/concept/Geographie>,
        <http://example.org/education/concept/Geowissenschaften>,
        <http://example.org/education/concept/Hochschulpolitik>,
        <http://example.org/education/concept/Lehramtsstudium>,
        <http://example.org/education/concept/Studienorganisation>,
        <http://example.org/education/concept/Wissenschaftliche_Literatur>,
        <http://example.org/education/concept/Wissenschaftliches_Arbeiten> ;
    dcterms:title "Tutorium Wissenschaftliches Arbeiten in den Geowissenschaften"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

