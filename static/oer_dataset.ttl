        <http://example.org/education/concept/Schleifen>,
        <http://example.org/education/concept/Scratch>,
        <http://example.org/education/concept/bedingte_Schleifen>,
        <http://example.org/education/concept/visuelle_Programmierumgebung> ;
    dcterms:title "Aufgaben im IU Klasse 8, LB1 Algorithmen Stunde"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:11q98H-FHIn_M a edu:LearningResource ;
    sim:similarTo oer:12ZNQ8Ui-rBkE ;
    dcterms:creator <http://example.org/education/person/Pattoka> ;
    dcterms:description "Der Selbstlernkurs Differentialrechnung richtet sich an Studienanfänger der Informatik und Mathematik und vermittelt die Grundlagen der Differentialrechnung durch multimediale Inhalte und interaktive Aufgaben. Durch den Kurs können Lerner die verschiedenen Ableitungsregeln kennenlernen, mathematische Funktionen differenzieren und Graphen analysieren. Ziel ist es, dass Lerner am Ende des Kurses in der Lage sind, eine vollständige Kurvendiskussion selbstständig durchzuführen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11q98H-FHIn_M" ;
    dcterms:subject <http://example.org/education/concept/Ableitungsregeln>,
        <http://example.org/education/concept/Didaktik_der_Informatik>,
        <http://example.org/education/concept/Differentialrechnung>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Interaktivit%C3%A4t>,
        <http://example.org/education/concept/Lernziele>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mathematische_Funktionen>,
        <http://example.org/education/concept/Multimedialit%C3%A4t>,
        <http://example.org/education/concept/Selbstlernkurs> ;
    dcterms:title "Selbstlernkurs: Differentialrechnung"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

