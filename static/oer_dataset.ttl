        <http://example.org/education/concept/R%C3%A4tsel>,
        <http://example.org/education/concept/Reise>,
        <http://example.org/education/concept/Schatzsuche>,
        <http://example.org/education/concept/Schiff>,
        <http://example.org/education/concept/Wikinger> ;
    dcterms:title "Der Schatz der Wikinger"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5ri544CChSpA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Brose> ;
    dcterms:description "Die Übung behandelt die Konsolidierung von Daten zu Kartenverkäufen für drei Veranstaltungsorte (Chemnitz, Dresden und Leipzig) nach Anzahl und Summe. Durch die Ausführung der Aufgaben können Lerner die Fähigkeit erwerben, komplexe Daten zu konsolidieren und bestimmte Werte zu berechnen. Die Übung bietet eine praktische Anwendung von Konsolidierungsarten und -methoden im Kontext von Veranstaltungsorten und Kartenverkäufen."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "5ri544CChSpA" ;
    dcterms:subject <http://example.org/education/concept/Abendkasse>,
        <http://example.org/education/concept/Eventmanagement>,
