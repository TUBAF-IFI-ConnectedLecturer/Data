        <http://example.org/education/concept/OPAL-Kurs>,
        <http://example.org/education/concept/Programmcode>,
        <http://example.org/education/concept/Pseudo-Code>,
        <http://example.org/education/concept/Selbstst%C3%A4ndiges_Lernen>,
        <http://example.org/education/concept/Zeitkomplexit%C3%A4t> ;
    dcterms:title "Fachseminar Didaktik der Informatik Universität Leipzig Charlotte Gerlitz Aufgabenpool"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

