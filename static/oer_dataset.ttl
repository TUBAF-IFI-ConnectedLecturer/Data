oer:10jBQl3FGhNRI a edu:LearningResource ;
    sim:similarTo oer:10v2XNLy7MxWc ;
    dcterms:creator <http://example.org/education/person/Thiem> ;
    dcterms:description "Das Praktikum behandelt die Projektierung und messtechnische Überprüfung einer Innenbeleuchtungsanlage im Laborraum Haus 11-313 mittels des Softwaresystems Dialux evo 9.0. Die Aufgaben umfassen die Berechnung der Beleuchtungsstärkeverteilung, die Erstellung von Isoluxdiagrammen und Wert-rastern sowie die messtechnische Überprüfung der Ergebnisse. Durch das Praktikum erwerben die Lerner Kenntnisse über die Anwendung von Dialux evo 9.0 und die Bewertung von Innenbeleuchtungsanlagen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10jBQl3FGhNRI" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Beleuchtungsst%C3%A4rkeverteilung>,
        <http://example.org/education/concept/Dialux>,
        <http://example.org/education/concept/Innenbeleuchtung>,
        <http://example.org/education/concept/Laboratorium>,
        <http://example.org/education/concept/Leuchtenhersteller>,
        <http://example.org/education/concept/Lichtmessger%C3%A4t>,
        <http://example.org/education/concept/Lichttechnik>,
        <http://example.org/education/concept/Messtechnik>,
        <http://example.org/education/concept/Raumbeleuchtung>,
        <http://example.org/education/concept/Trilux> ;
    dcterms:title "Projektierung und meßtechnische Überprüfung einer Innenbeleuchtungsanlage"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10jUvrdlptrKM a edu:LearningResource ;
    sim:similarTo oer:10npINWAxgVmQ,
        oer:10oT1hbimnGDU,
        oer:10rJQY58ku9MQ ;
    dcterms:creator <http://example.org/education/person/Hirte> ;
    dcterms:description "Der räumliche Preiswettbewerb zwischen Unternehmen wird unter Berücksichtigung von Transportkosten analysiert, um die Auswirkungen auf die Preissetzung und Marktmacht zu verstehen. Durch das Studium dieses Themas können Lernende graphisch das Problem des räumlichen Preiswettbewerbs zweier Firmen darstellen und erklären, den Einfluss der Transportkosten auf die Ergebnisse im mikroökonomischen Ansatz herleiten und erklären sowie den Unterschied in der Preissetzung zwischen räumlichem und nicht-räumlichem Wettbewerb erkennen. Dieses Verständnis hilft bei der Analyse von Märkten, insbesondere im Kontext des Tankstellenmarktes."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10jUvrdlptrKM" ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomie>,
        <http://example.org/education/concept/Duopol>,
        <http://example.org/education/concept/Gewinnmaximierung>,
        <http://example.org/education/concept/Marktstruktur>,
        <http://example.org/education/concept/Mikro%C3%B6konomie>,
        <http://example.org/education/concept/Nachfrage>,
        <http://example.org/education/concept/Oligopol>,
        <http://example.org/education/concept/Preiswettbewerb>,
        <http://example.org/education/concept/R%C3%A4umlicher_Wettbewerb>,
        <http://example.org/education/concept/Transportkosten> ;
    dcterms:title "Räumlicher Preiswettbewerb"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10mKrdrOcaU7g a edu:LearningResource ;
    sim:similarTo oer:12ixojwyYa9ps ;
    dcterms:description "Die Relation 𝑅( ) wird als Äquivalenzrelation bewiesen, indem die drei notwendigen Eigenschaften Reflexivität, Symmetrie und Transitivität nachgewiesen werden. Es gibt insgesamt 9 Äquivalenzklassen für 𝑅( ), eine für jede mögliche Mächtigkeit von 0 bis 8. Durch das Verständnis dieser Relation und ihrer Eigenschaften können Lernende die Konzepte der Äquivalenzrelation und der Mächtigkeiten in der Mengenlehre besser verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10mKrdrOcaU7g" ;
    dcterms:subject <http://example.org/education/concept/%C3%84quivalenzrelation>,
        <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Kombinatorik>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Menge>,
        <http://example.org/education/concept/Mengenlehre>,
        <http://example.org/education/concept/Reflexivit%C3%A4t>,
        <http://example.org/education/concept/Relationentheorie>,
        <http://example.org/education/concept/Symmetrie>,
        <http://example.org/education/concept/Transitivit%C3%A4t> ;
    dcterms:title "Serie 8 Aufgabe 6 Hörrmann"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

