        <http://example.org/education/concept/Wirkleistung>,
        <http://example.org/education/concept/Wirtschaftlichkeit>,
        <http://example.org/education/concept/Zuverl%C3%A4ssigkeit> ;
    dcterms:title "Lernpaket NuB 2 Netze und Betriebsmittel"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:13_l81m9RJSc a edu:LearningResource ;
    sim:similarTo oer:9_jXdv3Jgh_Q ;
    dcterms:description "Die Lokale Extrema Funktionen zweier reeller Veränderlicher werden untersucht, um die Bedingungen für lokale Extrempunkte zu bestimmen. Dazu wird die Hesse-Matrix verwendet, um die Determinante an der stationären Stelle zu berechnen und daraus Rückschlüsse auf das Vorliegen von lokalen Minima oder Maxima zu ziehen. Durch diese Methode können Lernende lokale Extrema in Funktionen zweier Veränderlicher erkennen und analysieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "13_l81m9RJSc" ;
    dcterms:subject <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Determinante>,
        <http://example.org/education/concept/Extrema>,
        <http://example.org/education/concept/Funktionen_zweier_Ver%C3%A4nderlicher>,
        <http://example.org/education/concept/Hesse-Matrix>,
        <http://example.org/education/concept/Lokale_Extrema>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Partielle_Ableitungen>,
        <http://example.org/education/concept/Station%C3%A4re_Punkte> ;
    dcterms:title "Lokale Extrema Funktionen zweier reeller Veränderlicher"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:14EtI6BsvpwcY a edu:LearningResource ;
    sim:similarTo oer:7CJIrl2jtK9M ;
    dcterms:creator <http://example.org/education/person/Giesecke> ;
    dcterms:description "Die Medienrevolutionen haben die Art und Weise, wie Menschen Informationen verarbeiten und kommunizieren, grundlegend verändert. Durch die Einführung neuer Technologien wie Schrift, Buchdruck und elektronische Datenverarbeitung haben sich neue Kommunikationsformen und -netze entwickelt, die menschliche Fähigkeiten und soziale Institutionen ersetzen. Diese Veränderungen haben zu neuen Formen der Wissensproduktion, -verbreitung und -aneignung geführt, die unsere moderne Gesellschaft prägen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "14EtI6BsvpwcY" ;
    dcterms:subject <http://example.org/education/concept/Buchdruck>,
        <http://example.org/education/concept/Computerkultur>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Geschichte_der_Medien>,
        <http://example.org/education/concept/Informationsverarbeitung>,
        <http://example.org/education/concept/Kommunikationstechnologie>,
        <http://example.org/education/concept/Kulturelle_Evolution>,
        <http://example.org/education/concept/Medienrevolution>,
        <http://example.org/education/concept/Schriftkultur>,
        <http://example.org/education/concept/Sozialgeschichte> ;
    dcterms:title "Als die alten Medien neu waren - Medienrevolution in der Geschichte"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:14Y_yDhFOkhuk a edu:LearningResource ;
    sim:similarTo oer:14wZSDnEgU5cQ ;
    dcterms:creator <http://example.org/education/person/Richter> ;
    dcterms:description "Das Medium wird in verschiedenen wissenschaftlichen Disziplinen wie Sprachwissenschaft, Parapsychologie, Physik, Chemie, Biowissenschaften, Informatik und Kommunikationstechnik verwendet und bezeichnet je nach Kontext ein vermittelndes Element, eine Person mit bestimmten Fähigkeiten oder einen Träger von Eigenschaften. Durch die Lektüre dieses Dokuments können Leser ein umfassendes Verständnis des Begriffs \"Medium\" in verschiedenen wissenschaftlichen Zusammenhängen erlangen und seine Bedeutung in verschiedenen Kontexten erkennen. Die Darstellung der verschiedenen Aspekte des Mediums ermöglicht es den Lesern, die Vielfältigkeit und Komplexität dieses Konzepts zu erfassen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "14Y_yDhFOkhuk" ;
    dcterms:subject <http://example.org/education/concept/Biowissenschaften>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Kommunikationstechnik>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Medium>,
        <http://example.org/education/concept/Parapsychologie>,
        <http://example.org/education/concept/Semiotik>,
        <http://example.org/education/concept/Sprachwissenschaft>,
        <http://example.org/education/concept/Verb> ;
    dcterms:title "Das Medium in der Sprachwissenschaft"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:156E6mt183lfY a edu:LearningResource ;
    sim:similarTo oer:15UxHWwV0G3GM ;
    dcterms:creator <http://example.org/education/person/Vercamer> ;
    dcterms:description "Der Text erzählt die Geschichte eines Ritters, der einem hinkenden Löwen hilft und später von diesem gerettet wird, als er in einer Grube landet. Durch diese Geschichte soll gezeigt werden, dass Gott dem Menschen vergeben kann, wenn dieser bereit ist, sein Leben zu ändern. Die Moralisation verdeutlicht, dass der Mensch täglich darum bemüht sein sollte, seine Tugenden zu stärken und die Güter der Welt zu gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "156E6mt183lfY" ;
    dcterms:subject <http://example.org/education/concept/Bu%C3%9Fe>,
        <http://example.org/education/concept/Erbs%C3%BCnde>,
        <http://example.org/education/concept/Gott>,
        <http://example.org/education/concept/Jagd>,
        <http://example.org/education/concept/K%C3%B6nig>,
        <http://example.org/education/concept/Mensch>,
        <http://example.org/education/concept/Moralisation>,
        <http://example.org/education/concept/S%C3%BCnde>,
        <http://example.org/education/concept/Taufe>,
        <http://example.org/education/concept/Tugenden> ;
    dcterms:title "Der dankbare Löwe"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

