        <http://example.org/education/concept/Numerische_Optimierungsverfahren>,
        <http://example.org/education/concept/Parametersch%C3%A4tzung>,
        <http://example.org/education/concept/Regressionsanalyse> ;
    dcterms:title "Lehrveranstaltung Simulation und Optimierung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:3HDKWnzJbc4U a edu:LearningResource ;
    sim:similarTo oer:7SS2QkPqRG-o,
        oer:7mo9F1qEFIg4,
        oer:7tD2gWqFhFeo ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "In diesem Lehrmaterial werden die Grundlagen der kontrastiven Linguistik und Sprachtypologie vermittelt, um Deutsch im europäischen Vergleich zu untersuchen und die Ähnlichkeiten und Unterschiede zwischen den germanischen Sprachen wie Deutsch, Niederländisch, Friesisch und Englisch aufzuzeigen. Durch das Studium dieser Materialien können Lernende ihre Kenntnisse über die deutsche Grammatik und Lexik erweitern und ihre Fähigkeiten im Vergleich von Sprachen verbessern. Zudem werden sie in die Lage versetzt, die Besonderheiten der deutschen Sprache im europäischen Kontext zu verstehen und ihre Kommunikationsfähigkeit in anderen germanischen Sprachen zu erhöhen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3HDKWnzJbc4U" ;
    dcterms:publisher <http://example.org/education/organization/SLUB> ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Englische_Sprache>,
        <http://example.org/education/concept/Friesische_Sprache>,
        <http://example.org/education/concept/Germanische_Sprachen>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Kontrastive_Linguistik>,
        <http://example.org/education/concept/Morphologie>,
        <http://example.org/education/concept/Niederl%C3%A4ndische_Sprache>,
        <http://example.org/education/concept/Sprachvergleich>,
        <http://example.org/education/concept/Westgermanische_Sprachen> ;
    dcterms:title "Deutsch im europäischen Vergleich"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

