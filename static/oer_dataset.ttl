        <http://example.org/education/concept/Wikipedia>,
        <http://example.org/education/concept/Wissenschaftliches_Schreiben>,
        <http://example.org/education/concept/Zitierpraxis> ;
    dcterms:title "Wikipedia in Forschung und Lehre eine Übersicht"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:5riXRDlI2xGs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/G%C3%A4bler> ;
    dcterms:description "Die Geschichte von Mickten und Übigau wird detailliert beschrieben, einschließlich der Entwicklung der beiden Orte, ihrer Industrie und Infrastruktur sowie wichtiger Ereignisse und Persönlichkeiten. Durch das Studium dieser Dokumentation können Lernende Einblick in die lokale Geschichte und Kultur gewinnen und verstehen, wie sich die beiden Orte im Laufe der Zeit entwickelt haben. Die Dokumentation bietet eine umfassende Darstellung der Geschichte von Mickten und Übigau, einschließlich ihrer wirtschaftlichen, sozialen und kulturellen Aspekte."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5riXRDlI2xGs" ;
    dcterms:subject <http://example.org/education/concept/Architektur>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Deutschland>,
        <http://example.org/education/concept/Dresden>,
        <http://example.org/education/concept/Eisenbahn>,
        <http://example.org/education/concept/Geschichte>,
        <http://example.org/education/concept/Industriegeschichte>,
        <http://example.org/education/concept/Lokomotive>,
        <http://example.org/education/concept/Sachsen>,
        <http://example.org/education/concept/Schloss_%C3%9Cbigau> ;
    dcterms:title "Geschichte des Dorfes und Stadtteils Übigau"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

oer:5stRggG3WqL4 a edu:LearningResource ;
    sim:similarTo oer:6pyf44GCfAf8,
        oer:74Nq4fv-LTNU ;
    dcterms:creator <http://example.org/education/person/Nehring> ;
    dcterms:description "Die vorliegende Übersicht beschreibt die Bedeutung von Pflanzenarten für die Anpassung an den Klimawandel in Weinbergen und gibt Empfehlungen für die Etablierung einer dauerhaften Vegetationsdecke. Durch die Auswahl geeigneter Arten kann der Boden vor Erosion geschützt, Wasser infiltriert und gespeichert werden, was langfristig den Ertrag von Weinbergen sichert. Die Übersicht bietet eine umfassende Darstellung von Pflanzenarten, ihre Eigenschaften, Bedeutung für die Biodiversität und Anpassung an den Klimawandel, um Landwirten und Weinbauern bei der Auswahl geeigneter Arten zu unterstützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5stRggG3WqL4" ;
    dcterms:publisher <http://example.org/education/organization/I%27ve_Analyzed_The_Document__But_I_Didn%27t_Find_Any_Email_Addresses._The_Document_Appears_To_Be_a_List_Of_Plant_Species_With_Their_Characteristics_And_Properties._There_Are_No_Email_Addresses_Or_University_Domains_Mentioned_In_The_Text._Therefore__I_Will_Return_An_Empty_String.> ;
    dcterms:subject <http://example.org/education/concept/%C3%96kosystemdienstleistungen>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
        <http://example.org/education/concept/Bodenschutz>,
        <http://example.org/education/concept/Erosionsschutz>,
        <http://example.org/education/concept/Klimawandelanpassung>,
        <http://example.org/education/concept/Landschaftsplanung>,
        <http://example.org/education/concept/Pflanzensoziologie>,
        <http://example.org/education/concept/Stickstoff-Fixierung>,
        <http://example.org/education/concept/Vegetations%C3%B6kologie>,
        <http://example.org/education/concept/Wasserinfiltration> ;
    dcterms:title "BIODIVERSITÄT UND KLIMAWANDEL IN WEINBERGEN"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

