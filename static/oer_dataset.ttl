        <http://example.org/education/concept/Verschl%C3%BCsselung>,
        <http://example.org/education/concept/digitale_Zertifikate> ;
    dcterms:title "Prof. Buchmann - Web-Sicherheit"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5CqfixnzAb1k a edu:LearningResource ;
