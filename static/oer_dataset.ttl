        oer:3si5Mp_Bv6ds,
        oer:6BcDTDwzq8-o,
        oer:8MwjsObRjyik ;
    dcterms:description "Dieses Lehrmaterial behandelt die Grundlagen der Wahrscheinlichkeitstheorie und Statistik, einschließlich der Berechnung von Erwartungswerten und Varianzen bei verschiedenen Verteilungen, wie der Gleichverteilung, Binomialverteilung und Hypergeometrischen Verteilung. Durch das Studium dieses Materials können Lernende die Fähigkeit erwerben, Wahrscheinlichkeiten zu berechnen und zu interpretieren, sowie die Anwendung statistischer Konzepte in verschiedenen Kontexten zu verstehen. Die Inhalte umfassen auch die Mengentheorie, Kombinatorik und Bayes'sche Verfahren, um Lernenden eine solide Grundlage für weiterführende Studien in Mathematik und Statistik zu bieten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10DzYJSEd-CAM" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bayesianisches_Denken>,
        <http://example.org/education/concept/Binominalverteilung>,
        <http://example.org/education/concept/Erwartungswert>,
        <http://example.org/education/concept/Hypergeometrische_Verteilung>,
        <http://example.org/education/concept/Kombinatorik>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mengentheorie>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Varianz>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie> ;
    dcterms:title "Struktureinheit der TU Dresden"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

