        oer:9SX181GMEJNM,
        oer:9o2uVOV3V5MY ;
    dcterms:creator <http://example.org/education/person/Schlegel> ;
    dcterms:description "Das Material \"Josef Kopfkino\" ermöglicht Schülern der 5. Klasse eines Gymnasiums, sich mittels einer imaginierten Erzählung mit auditiven Eindrücken in die Gefühls- und Erlebniswelt biblischer Figuren hineinzudenken und diese Erfahrungen im Plenum zu teilen. Durch dieses Audioprodukt können SuS ihre Vorstellungskraft nutzen, um sich in die Situation des Josef zu versetzen und so Neugierde und Motivation für die folgenden Unterrichtseinheiten zu wecken. Das Material unterstützt die Entwicklung von Fach-, Methoden-, Selbst- und Sozialkompetenz im Bereich Evangelische Religion."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "10lS462UJROPI" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Audioprodukt>,
        <http://example.org/education/concept/Biblische_Figuren>,
        <http://example.org/education/concept/Digitale_Medien>,
        <http://example.org/education/concept/Evangelische_Religion>,
        <http://example.org/education/concept/Imaginationsreise>,
        <http://example.org/education/concept/Josefsgeschichte>,
        <http://example.org/education/concept/Religionsunterricht>,
        <http://example.org/education/concept/Schule_und_Bildung>,
        <http://example.org/education/concept/Traumreise>,
        <http://example.org/education/concept/Unterrichtsmaterial> ;
    dcterms:title "Materialhandreichung: Josef Kopfkino"@de ;
    dcterms:type <http://example.org/education/type/Materialhandreichung> .

oer:10qTO5W7UD0SA a edu:LearningResource ;
    sim:similarTo oer:10r48hRkbqxsU,
        oer:11DbrkwywMj-Q,
        oer:56EO2w2PQ-q0,
        oer:78vxe9p9Xbi0,
        oer:7TAM_tnvuzew,
        oer:8yTi_zfDDnfs ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die kontrastive Linguistik wird als vergleichende sprachwissenschaftliche Beschreibungs- und Analysemethode vorgestellt, die sich auf den Vergleich von Sprachsystemen oder -Subsystemen konzentriert. Durch diese Methode können Sprachen unabhängig von ihrer genetischen oder geographischen Verwandtschaft miteinander verglichen werden. Die Anwendung dieser Methode ermöglicht es, Abweichungen und Kontraste zwischen den Sprachsystemen zu identifizieren und zu analysieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10qTO5W7UD0SA" ;
    dcterms:subject <http://example.org/education/concept/Kontrastive_Linguistik>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Linguistische_Methoden>,
        <http://example.org/education/concept/Sprachanalyse>,
        <http://example.org/education/concept/Sprachen>,
        <http://example.org/education/concept/Sprachsysteme>,
