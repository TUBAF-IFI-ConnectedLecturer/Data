    dcterms:creator <http://example.org/education/person/Benabdellah>,
        <http://example.org/education/person/L%C3%B6ffler> ;
    dcterms:description "Die Vorlesung Triebfahrzeugtechnik behandelt den mechanischen Teil von Triebfahrzeugen, insbesondere die Triebdrehgestelle und ihre Komponenten wie Drehzapfen und Lenkhebelsysteme. Durch diese Vorlesung erwerben die Lernenden Kenntnisse über die Aufgaben und Hauptkomponenten von Triebdrehgestellen sowie ihre verschiedenen Ausführungen und Anwendungen in der Praxis. Die Inhalte dieser Vorlesung dienen als Grundlage für das Verständnis der Funktion und des Einsatzes von Triebfahrzeugen in der Eisenbahn- und Fahrzeugtechnik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11G-sxtZzjwQU" ;
    dcterms:subject <http://example.org/education/concept/Antriebe>,
        <http://example.org/education/concept/Drehgestelle>,
        <http://example.org/education/concept/Fahrzeugkasten>,
        <http://example.org/education/concept/Gleisunebenheit>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Mechanischer_Teil>,
        <http://example.org/education/concept/Radsatzbaugruppen>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Triebdrehgestellanlenkung>,
        <http://example.org/education/concept/Triebfahrzeugtechnik> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

