oer:5Jlr9I6vZMrU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Bork>,
        <http://example.org/education/person/Liebmann> ;
    dcterms:description "Die Aufgabe bestand darin, eine Papierbrücke in Leichtbauweise zu konstruieren, die möglichst viel Belastung aushält. Durch die Anwendung von Falt- und Rolltechniken konnte die Druckfestigkeit des Papiers verbessert werden, um eine stabile Fahrbahn zu erstellen. Die Arbeit demonstriert die Anwendung von Leichtbauprinzipien auf ein einfaches Material wie Papier, um eine belastbare Konstruktion zu schaffen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "5Jlr9I6vZMrU" ;
    dcterms:subject <http://example.org/education/concept/Baumechanik>,
        <http://example.org/education/concept/Br%C3%BCckenbau>,
        <http://example.org/education/concept/Druckfestigkeit>,
        <http://example.org/education/concept/Falttechnik>,
        <http://example.org/education/concept/Ingenieurwesen>,
        <http://example.org/education/concept/Leichtbau>,
        <http://example.org/education/concept/Papierkonstruktion>,
        <http://example.org/education/concept/Strukturdesign>,
        <http://example.org/education/concept/Tragwerke>,
        <http://example.org/education/concept/Zugfestigkeit> ;
    dcterms:title "Grundzüge des Leichtbaus"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:5KQ_qMkUztWQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Nambinina_Awagana> ;
    dcterms:description "Diese Arbeit behandelt die Passungsanalyse einer Baugruppe bestehend aus Welle, Wellenhalterung, Buchse, Sechskantschraube, Unterlegscheibe und Sicherungring. Die Analyse umfasst die Ermittlung von Toleranzen und Passungen für die einzelnen Teile der Baugruppe. Durch diese Arbeit können Studierende Kenntnisse über die Konstruktion und CAD-Anwendung im Kontext von Passungsanalysen erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5KQ_qMkUztWQ" ;
    dcterms:subject <http://example.org/education/concept/Baugruppe>,
        <http://example.org/education/concept/CAD>,
        <http://example.org/education/concept/Fertigungstechnik>,
        <http://example.org/education/concept/Konstruktionstechnik>,
        <http://example.org/education/concept/Maschinenelemente>,
        <http://example.org/education/concept/Passungsanalyse>,
        <http://example.org/education/concept/Schrauben>,
        <http://example.org/education/concept/Sicherungselemente>,
        <http://example.org/education/concept/Toleranzen>,
        <http://example.org/education/concept/Zeichnungssatz> ;
    dcterms:title "Prüfungsbeleg Grundlagen der Konstruktion und CAD Wintersemester 2023/2024 Zeichnungssatz und Passungsanalyse einer Baugruppe"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5KalokQ6nndo a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Dalemann> ;
    dcterms:description "Michel Dalemann, ein Wundarzt und Barbier aus Schwerin, bittet Fürst Ulrich von Mecklenburg um Unterstützung für eine seiner Patientinnen, die einen großen Schaden an ihrem Knie erlitten hat. Er beschreibt den Zustand der Frau und ihre Notlage, um Mitleid und Hilfe zu erlangen. Durch diese Supplik kann man Einblick in die medizinische Versorgung und die soziale Lage von Patientinnen im 16. Jahrhundert gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5KalokQ6nndo" ;
    dcterms:subject <http://example.org/education/concept/16._Jahrhundert>,
        <http://example.org/education/concept/Adel>,
        <http://example.org/education/concept/Alte_Menschen>,
        <http://example.org/education/concept/Armenf%C3%BCrsorge>,
        <http://example.org/education/concept/F%C3%BCrsten>,
        <http://example.org/education/concept/Krankenpflege>,
        <http://example.org/education/concept/Mecklenburg>,
        <http://example.org/education/concept/Medizin>,
        <http://example.org/education/concept/Soziale_Unterst%C3%BCtzung>,
        <http://example.org/education/concept/Wundheilkunst> ;
    dcterms:title "Supplik des Wundarztes und Barbiers Michel Dalemann"@de ;
    dcterms:type <http://example.org/education/type/Supplik> .

oer:5KxEIEiHY2tc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Scheiling> ;
    dcterms:description "Die Lernenden werden aufgefordert, eine Figur zu suchen und ihre Eindrücke von einer Ausstellung in der Manufaktur der Träume zu sammeln. Durch die Aufgaben wird die Tradition der Weihnachtsmusik in Annaberg-Buchholz thematisiert und die Lernenden sollen ihre eigenen Erfahrungen und Eindrücke reflektieren. Die Materialien sind Teil des Maßnahmenpakets TUD-Sylber², das die Lehrerbildung im Rahmen der gemeinsamen Qualitätsoffensive von Bund und Ländern unterstützt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5KxEIEiHY2tc" ;
    dcterms:subject <http://example.org/education/concept/Atmosph%C3%A4re>,
        <http://example.org/education/concept/Erlebnisp%C3%A4dagogik>,
        <http://example.org/education/concept/Figuren>,
        <http://example.org/education/concept/Holzbildhauerei>,
        <http://example.org/education/concept/Kunstausstellungen>,
        <http://example.org/education/concept/Lernstationen>,
        <http://example.org/education/concept/Museen>,
        <http://example.org/education/concept/Musik>,
        <http://example.org/education/concept/Traditionen>,
        <http://example.org/education/concept/Weihnachtsbr%C3%A4uche> ;
    dcterms:title "HINWEIS"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5LF9pqb7AaxI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kossatz> ;
    dcterms:description "Die Vorlesung behandelt Konzepte und Theorien der Neuesten Geschichte, insbesondere die Invektivitätsgeschichte und soziale Praktiken. Durch die Analyse von Beispielen wie Zähne putzen oder Fahrrad fahren werden die Elemente sozialer Praktiken wie Materialität, Routinisiertheit und Sozial geteiltes Wissen verdeutlicht. Die Studierenden erwerben ein Verständnis für die Konzepte sozialer Praktiken und Invektivitätsgeschichte in der Neuesten Geschichte."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5LF9pqb7AaxI" ;
    dcterms:subject <http://example.org/education/concept/Beleidigung>,
        <http://example.org/education/concept/Dolchsto%C3%9Flegende>,
        <http://example.org/education/concept/Emotionen>,
