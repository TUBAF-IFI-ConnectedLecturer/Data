        <http://example.org/education/concept/Partielle_Ableitung>,
        <http://example.org/education/concept/Stetigkeit>,
        <http://example.org/education/concept/Widerstand> ;
    dcterms:title "Mathematik für Fahrzeugtechnik (M04), Sommersemester 2018"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

