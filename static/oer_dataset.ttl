oer:10yHenKwaCudA a edu:LearningResource ;
    sim:similarTo oer:3kqppOFH8iR0,
        oer:4PM4B1ALSrmA,
        oer:5Rf43XDBhops,
        oer:5mZY0lcLQjHA,
        oer:6AgaxM3bkONk,
        oer:6WMD7f5NuKWc,
        oer:6wd_U07ps9c8,
        oer:79fMSwFhbI1U,
        oer:7FSHwJBd6_EE,
        oer:7HAMS2OvGsQ0,
        oer:7_uTTDF4X3PM,
        oer:9ZJKoyUnW92o ;
    dcterms:creator <http://example.org/education/person/Atkins>,
        <http://example.org/education/person/Keeler>,
        <http://example.org/education/person/de_Paula> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Grundlagen der Physikalischen Chemie, insbesondere die Zustandsgleichungen idealer und realer Gase, sowie die Eigenschaften von Gasen und ihre Beschreibung durch mathematische Formeln. Durch das Studium dieses Materials können Lernende die physikalischen Größen und ihre Einheiten kennenlernen, die wichtigsten Gasgesetze wie das Boyle-Mariotte-Gesetz und das van-der-Waals-Gesetz verstehen und anwenden, sowie die Abweichungen vom idealen Verhalten von Gasen erkennen. Die Inhalte sind für Studierende der Chemie und Physik relevant, um die Eigenschaften von Stoffen und ihre Umwandlungen zu beschreiben und mathematisch zu erfassen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10yHenKwaCudA" ;
    dcterms:subject <http://example.org/education/concept/Druck>,
        <http://example.org/education/concept/Gaseigenschaften>,
        <http://example.org/education/concept/Ideales_Gas>,
