    dcterms:creator <http://example.org/education/person/Fricke>,
        <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Stephan> ;
    dcterms:description "Die Vorlesung \"Triebfahrzeugtechnik\" behandelt die Leistungsübertragungsanlagen von Zugfahrten und deckt Aspekte wie Energiebedarf, Antriebskonfigurationen, Betriebsregime und Wirkungsgrade ab. Durch das Studium dieser Materialien können Lernende ein umfassendes Verständnis der technischen und betrieblichen Aspekte von Zugfahrten entwickeln und ihre Kenntnisse in der Fahrzeugtechnik erweitern. Die Inhalte sind für die Ausbildung von Fachkräften im Bereich der Eisenbahnindustrie von besonderer Bedeutung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6Icqh08NkXAc" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_Hints_Pointing_To_The_Institution_Of_The_Author%3Athe_Institution_Is%3A_Friedrich-alexander-universit%C3%A4t_Erlangen-n%C3%BCrnberg_%28fau%29this_Was_Found_In_The_Header_Of_The_Document__Which_Mentions_%22friedrich-alexander-universit%C3%A4t_Erlangen-n%C3%BCrnberg%22_And_%22prof._Dr.-ing._Arnd_Stephan%22.> ;
    dcterms:subject <http://example.org/education/concept/Antriebskonfigurationen>,
        <http://example.org/education/concept/Betriebsregime>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Fahrstil>,
        <http://example.org/education/concept/Fahrweise>,
