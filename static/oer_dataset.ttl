        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Mathematikdidaktik>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Polygon>,
        <http://example.org/education/concept/Raumgeometrie>,
        <http://example.org/education/concept/Unterrichtsmaterial>,
        <http://example.org/education/concept/Viereck> ;
    dcterms:title "Didaktik der Geometrie - Vorlesung Basismodul LAGS-GSD-MA-VM2 Grundschuldidaktik Mathematik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

