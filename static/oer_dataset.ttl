        <http://example.org/education/concept/Risikomanagement>,
        <http://example.org/education/concept/Schutzma%C3%9Fnahmen> ;
    dcterms:title "Lehrbriefe der Elektrotechnik Grundlagen der Aktorik Schutzmaßnahmen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

