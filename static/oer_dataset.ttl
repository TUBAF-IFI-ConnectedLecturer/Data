    dcterms:creator <http://example.org/education/person/D%C3%BCrscheid>,
        <http://example.org/education/person/Eckert>,
        <http://example.org/education/person/Eisenbart> ;
    dcterms:description "Die Graphematik beschäftigt sich mit der Struktur und Organisation von Schriftsystemen, wobei die Beziehung zwischen Laut und Buchstabe im Mittelpunkt steht. Durch das Studium der Graphematik können Leser und Schreiber die Regeln und Prinzipien der Schreibung besser verstehen und anwenden, um eine effektive Kommunikation zu gewährleisten. Insbesondere werden die Konzepte von Phonographemen, Allographen, Morphemen und Silben sowie die Prinzipien der Schreibung wie das phonologische und morphologische Prinzip erläutert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6HeWcwESzCv4" ;
    dcterms:publisher <http://example.org/education/organization/SUB_Hamburg> ;
    dcterms:subject <http://example.org/education/concept/Alphabetschrift>,
        <http://example.org/education/concept/Graphematik>,
        <http://example.org/education/concept/Kommunikation>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Morphologie>,
        <http://example.org/education/concept/Orthographie>,
        <http://example.org/education/concept/Phonologie>,
        <http://example.org/education/concept/Schriftsystem>,
        <http://example.org/education/concept/Semiotik>,
        <http://example.org/education/concept/Silbenschrift> ;
    dcterms:title "Graphematik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:6Z9UxChJKzZE a edu:LearningResource ;
    sim:similarTo oer:6xew75LNkmWA,
        oer:8argUd-e6xbc,
        oer:9ysxFnUUqULY ;
    dcterms:creator <http://example.org/education/person/Hoffmann>,
        <http://example.org/education/person/Kl%C3%A4ffling> ;
    dcterms:description "Der Workshop \"Paukst du noch oder lernst du schon?!\" unterstützt Studierende bei der Bewältigung von Lernherausforderungen durch die Vermittlung von Lerntechniken und -methoden. Durch die Teilnahme am Workshop erhalten die Teilnehmenden Anregungen, sich selbstständig weiter mit Lerntechniken zu beschäftigen, und lernen, wie sie effizient mit Prüfungsstoff umgehen und ihre Selbstmotivation stärken können. Die Veranstaltung bietet einen strukturierten Ablauf, der die Teilnehmenden durch verschiedene Übungen und Inputs führt, um ihr Lernverhalten zu verbessern und ihre Studienziele zu erreichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6Z9UxChJKzZE" ;
    dcterms:subject <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Lernstrategien>,
        <http://example.org/education/concept/Lerntechniken>,
        <http://example.org/education/concept/Motivation>,
        <http://example.org/education/concept/Pr%C3%BCfungs-vorbereitung>,
        <http://example.org/education/concept/Selbstorganisation>,
        <http://example.org/education/concept/Studienmanagement>,
        <http://example.org/education/concept/Studienzielsetzung>,
        <http://example.org/education/concept/Wissensmanagement>,
        <http://example.org/education/concept/Zeitmanagement> ;
    dcterms:title "Paukst du noch oder lernst du schon?! [Lern- und Arbeitsmethoden]"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6iB0i5lbHYLk a edu:LearningResource ;
    sim:similarTo oer:6kAvSjCKl9s8,
        oer:6rWOJ3riygiM,
