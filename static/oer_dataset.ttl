oer:4YLibLvdEWEU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/M%C3%BCller> ;
    dcterms:description "Das Seminar \"Artefakt 5 - 2D-3D-Software\" behandelt die Verwendung von GeoGebra-Applets im Unterricht, um Schülerinnen und Schülern das Entdecken von Gesetzmäßigkeiten und Beziehungen zwischen Kreis und Kugel zu ermöglichen. Durch die Bearbeitung von Aufgabenstellungen können die Lernenden die Interaktivitätsstufen nach Schulmeister erkennen und Erfahrungen im Umgang mit digitalen Medien sammeln. Die Materialien unterstützen den Erwerb von Kompetenzen in der mathematischen Modellierung und Analyse von geometrischen Objekten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4YLibLvdEWEU" ;
    dcterms:subject <http://example.org/education/concept/2D-3D-Software>,
        <http://example.org/education/concept/GeoGebra>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Interaktive_Medien>,
        <http://example.org/education/concept/Interaktivit%C3%A4tsstufen>,
        <http://example.org/education/concept/Kreis>,
        <http://example.org/education/concept/Kugel>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Schulmeister-Modell>,
        <http://example.org/education/concept/Unterrichtsmaterial> ;
    dcterms:title "23. Mai 2021 Seminar: Artefakt 5 - 2D-3D-Software"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:4aNsjT9LPffs a edu:LearningResource ;
    dcterms:description "Die quadratische Gleichung wird in allgemeiner Form mit reellen Koeffizienten a, b, c und der Variablen x dargestellt. Die Lösungsformel für diese Gleichung wird mittels quadratischer Ergänzung hergeleitet und die Bedingungen für die Lösungen x1 und x2 werden aufgezeigt. Durch das Studium dieses Materials können Lernende die Lösung quadratischer Gleichungen erlernen und die Diskriminante berechnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4aNsjT9LPffs" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Diskriminante>,
        <http://example.org/education/concept/Gleichungen>,
        <http://example.org/education/concept/Koeffizienten>,
        <http://example.org/education/concept/L%C3%B6sungsformeln>,
        <http://example.org/education/concept/Mathematik.>,
        <http://example.org/education/concept/Variable>,
        <http://example.org/education/concept/algebraische_Gleichungen>,
        <http://example.org/education/concept/mathematische_Analyse>,
        <http://example.org/education/concept/quadratische_Gleichungen> ;
    dcterms:title "Quadratische Gleichungen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:4baCOMpdnIis a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Lange> ;
    dcterms:description "Das Bullet Journal ist eine flexible und anpassbare Methode zur Zeitplanung und Organisation, die es ermöglicht, Aufgaben, Gedanken und Notizen zu strukturieren und zu priorisieren. Durch die Verwendung von Index, Daily-Log, Weekly-Log, Monthly-Log und Future-Log können Nutzer ihre Ziele und Aufgaben besser planen und erreichen. Das Bullet Journal hilft dabei, die Motivation zu steigern, den Überblick zu behalten und eine bessere Zeitmanagement-Methode zu entwickeln."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "4baCOMpdnIis" ;
    dcterms:subject <http://example.org/education/concept/Aufgabenmanagement>,
        <http://example.org/education/concept/Bullet_Journal>,
        <http://example.org/education/concept/Lebensziele>,
        <http://example.org/education/concept/Notizen>,
        <http://example.org/education/concept/Organisationstechniken>,
        <http://example.org/education/concept/Selbstorganisation>,
        <http://example.org/education/concept/Tagebuchf%C3%BChrung>,
        <http://example.org/education/concept/Terminplanung>,
        <http://example.org/education/concept/Zeitmanagement>,
        <http://example.org/education/concept/Zielplanung> ;
    dcterms:title "Mein Weg zum Bullet Journal: Im eigenen Stil effizient und übersichtlich planen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:4clkJ5Vby39s a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Familienname> ;
    dcterms:description "Das Szenario beschäftigt sich mit der Entwicklung einer kreislauffähigen Wirtschaft in der Smartphone-Branche bis zum Jahr 2050, um die aktuellen Probleme wie umweltschädliches Verschrotten und Knappheit endlicher Ressourcen zu lösen. Die Ziele bestehen darin, den gesamten Herstellungs-, Reparatur- und Recyclingprozess sozialverträglich, umweltfreundlich und ressourcenschonend zu gestalten. Durch die Lektüre dieses Dokuments können Lernende Kenntnisse über die Herausforderungen und Ziele der kreislauffähigen Wirtschaft in der Smartphone-Branche erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4clkJ5Vby39s" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologische_Nachhaltigkeit>,
        <http://example.org/education/concept/Elektroaltger%C3%A4te>,
        <http://example.org/education/concept/Fair_Trade>,
        <http://example.org/education/concept/Kreislaufwirtschaft>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Recycling>,
        <http://example.org/education/concept/Ressourcenschonung>,
        <http://example.org/education/concept/Smartphone-Industrie>,
        <http://example.org/education/concept/Soziale_Verantwortung>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Vision für eine kreislauffähige Wirtschaft im Jahr 2050 - Entwicklung der Smartphone-Branche - Ausgangslage und Zielsetzung"@de ;
    dcterms:type <http://example.org/education/type/Poster> .

oer:4dTFrfLZTstk a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schmidt> ;
    dcterms:description "Das Gerät soll automatisch Messungen von Luftfeuchtigkeit und Temperatur in Nähe von Wänden durchführen, sobald es sich auf mindestens 10 Zentimeter der Wand genähert hat. Die Messwerte werden auf einem Display angezeigt und können zur Überprüfung von Schimmelbildung an Wänden verwendet werden. Durch die Implementierung dieser Anforderungen mit einem Arduino UNO soll ein funktionsfähiges Gerät entwickelt werden, das in der Praxis eingesetzt werden kann."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4dTFrfLZTstk" ;
    dcterms:subject <http://example.org/education/concept/Arduino>,
        <http://example.org/education/concept/Bau%C3%BCberwachung>,
        <http://example.org/education/concept/Feuchte>,
        <http://example.org/education/concept/H%C3%A4user>,
        <http://example.org/education/concept/Luftfeuchtigkeit>,
        <http://example.org/education/concept/Messger%C3%A4t>,
        <http://example.org/education/concept/Sanierung>,
        <http://example.org/education/concept/Schimmel>,
        <http://example.org/education/concept/Temperatur>,
        <http://example.org/education/concept/Wand> ;
    dcterms:title "Aufgabenstellung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

