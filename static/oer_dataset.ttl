oer:80T7TVMBvgtA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Behl>,
        <http://example.org/education/person/Sun>,
        <http://example.org/education/person/Zylla> ;
    dcterms:description "Das Praktikum behandelt die induktive Wegmessung und untersucht den Einfluss verschiedener Faktoren auf die Auflösung und den Messbereich. Durch die Auswertung von Messwerten und Diagrammen können die Learner die Funktionsweise des Triangulationsmessverfahrens verstehen und die Bedeutung von Faktoren wie der Lichtfleckgröße, der Verkippung und der Oberflächeneigenschaften für die Genauigkeit der Messungen erkennen. Zudem werden mögliche Fehlerquellen und Abweichungen bei der Messung an lichtdurchlässigen Materialien aufgezeigt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "80T7TVMBvgtA" ;
    dcterms:subject <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Informationstechnik>,
        <http://example.org/education/concept/Kalibrierung>,
        <http://example.org/education/concept/Laser-Messung>,
        <http://example.org/education/concept/Lichtdurchl%C3%A4ssigkeit>,
        <http://example.org/education/concept/Mess-_und_Sensortechnik>,
        <http://example.org/education/concept/Optische_Messtechnik>,
        <http://example.org/education/concept/Reflexion>,
        <http://example.org/education/concept/Sensor-Signalauswertung>,
        <http://example.org/education/concept/Triangulation> ;
    dcterms:title "Praktikum Sensor- und Sensorsignalauswertung Versuch IND  Induktive Wegmessung"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:86y8hXhJdMk4 a edu:LearningResource ;
    dcterms:description "Dieser Unterrichtsplan behandelt das Lernbereich 3 der Mathematik für die 6. Klasse und konzentriert sich auf die Beziehungen zwischen Winkeln und Dreiecken. Durch die verschiedenen Aufgaben und Aktivitäten sollen die Schülerinnen und Schüler ihre Fähigkeiten im Bereich des Innenwinkelsatzes, der Nebenwinkel- und Scheitelwinkelsätze sowie der Stufenwinkel- und Wechselwinkelsätze an geschnittenen Parallelen erwerben. Am Ende des Unterrichts sollen die Lernenden in der Lage sein, den Innenwinkelsatz anhand eines Dreieckes zu erklären und anzuwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "86y8hXhJdMk4" ;
    dcterms:subject <http://example.org/education/concept/Dreiecke>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Innenwinkelsatz>,
        <http://example.org/education/concept/Lernziele>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Nebenwinkel-_und_Scheitelwinkelsatz>,
        <http://example.org/education/concept/Parallele>,
        <http://example.org/education/concept/Stufenwinkel-_und_Wechselwinkelsatz>,
        <http://example.org/education/concept/Unterrichtsplanung>,
        <http://example.org/education/concept/Winkel> ;
    dcterms:title "Mathematik 6 Unterrichtsplanung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8CzCU6R2yIFM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Seifert> ;
    dcterms:description "Die Präsentation behandelt die Sicherheitsaspekte von Cloud-Computing und OpenStack, insbesondere die Schlüsselverwaltung, Kommunikationsabsicherung und Nutzerdatenabsicherung. Durch die Lektüre dieser Materialien können Lernende die verschiedenen Angriffsvektoren in IaaS-Clouds erkennen und Maßnahmen zur Absicherung durch Hardware-, Konfigurations- und Codeanpassungen verstehen. Zudem werden die Bedeutung von detektiven und reaktiven Maßnahmen hervorgehoben, um eine umfassende Sicherheitsstrategie zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8CzCU6R2yIFM" ;
    dcterms:subject <http://example.org/education/concept/Cloud-Computing>,
        <http://example.org/education/concept/Cloud-Key-Manager>,
