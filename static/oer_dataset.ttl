        oer:9T-qFy0rnpPE,
        oer:9aG6x_KvBAzw ;
    dcterms:creator <http://example.org/education/person/Babick>,
        <http://example.org/education/person/Wessely> ;
    dcterms:description "Die Sedimentation ist ein wichtiger Prozess in der Mechanischen Verfahrenstechnik, bei dem Feststoffpartikel in einer Flüssigkeit sinken und sich am Boden absetzen. Durch die Kenntnis der Sinkgeschwindigkeit von Partikeln können Ingenieure Sedimentationsapparate und -maschinen entwerfen, um Fest-Flüssig-Trennungen durchzuführen. Die Berechnung der Sinkgeschwindigkeit einzelner Kugeln oder komplexer Partikelsysteme ermöglicht die Optimierung von Trennprozessen in verschiedenen Industrien."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4lfeiBfqAgqw" ;
    dcterms:subject <http://example.org/education/concept/Fest-Fl%C3%BCssig-Trennung>,
        <http://example.org/education/concept/Hydrozyklon>,
        <http://example.org/education/concept/Kugeln>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Partikel-Reynoldszahl>,
        <http://example.org/education/concept/Prozessparameter>,
        <http://example.org/education/concept/Sedimentation>,
        <http://example.org/education/concept/Trenntechnik>,
        <http://example.org/education/concept/Widerstandsbeiwert>,
        <http://example.org/education/concept/Zentrifuge> ;
    dcterms:title "Grundlagen der Mechanischen Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:7G3jrWbBmHdY a edu:LearningResource ;
    sim:similarTo oer:7d-lFY-WAlqQ,
        oer:7mo9F1qEFIg4,
