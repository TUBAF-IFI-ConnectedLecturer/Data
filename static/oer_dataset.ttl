        oer:9RG4fLavla58 ;
    dcterms:description "Dieses Dokument enthält eine umfassende Liste von Befunden und Leistungen für die zahntechnische Versorgung von Patienten, einschließlich der Bewertung von Zahnlücken, Prothesenkonstruktionen und implantatgetragenen Lösungen. Durch die Anwendung dieser Befunde können Zahnärzte und Zahntechniker genau berechnen, welche Leistungen erforderlich sind, um den Bedürfnissen ihrer Patienten gerecht zu werden. Die genauen Preisangaben und Bewertungskriterien in diesem Dokument ermöglichen es den Anwendern, eine wirtschaftliche und effiziente Versorgung ihrer Patienten sicherzustellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10AVg1dYv9MVk" ;
    dcterms:subject <http://example.org/education/concept/Dentalrestaurierung>,
        <http://example.org/education/concept/Implantologie>,
        <http://example.org/education/concept/Kieferorthop%C3%A4die>,
        <http://example.org/education/concept/Mund-Kiefer-Gesichtschirurgie>,
        <http://example.org/education/concept/Prothetik>,
        <http://example.org/education/concept/Zahnersatz>,
        <http://example.org/education/concept/Zahnheilkunde>,
        <http://example.org/education/concept/Zahnmedizin>,
        <http://example.org/education/concept/Zahnprothese>,
        <http://example.org/education/concept/Zahntechnik> ;
    dcterms:title "Befundkatalog Zahnärztliche Leistungen"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:10DzYJSEd-CAM a edu:LearningResource ;
    sim:similarTo oer:10izKhQzXNFLo,
        oer:113ERzmJqlbOY,
