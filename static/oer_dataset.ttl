        <http://example.org/education/concept/Universit%C3%A4t>,
        <http://example.org/education/concept/Wissenschaft>,
        <http://example.org/education/concept/Zeitplanung> ;
    dcterms:title "WS 2024/25 3100 Projektmanagement Prüfungen"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:82Olyul3AoEQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Lernpaket behandelt die Zuverlässigkeitstechnik und erklärt grundlegende Begriffe wie geforderte Funktion, Missionsdauer, Betrachtungseinheit und Arbeitsbedingungen. Es erläutert außerdem die Punktverfügbarkeit, Ausfallrate, MTTF, MTTR und MTBF sowie die Zuverlässigkeitfunktion und die Badewannenkurve. Durch das Studium dieses Materials können Lernende ein grundlegendes Verständnis der Zuverlässigkeitsanalyse und -bewertung in der Elektrotechnik erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "82Olyul3AoEQ" ;
    dcterms:subject <http://example.org/education/concept/Ausfallrate>,
        <http://example.org/education/concept/Betriebssicherheit>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Instandhaltbarkeit>,
        <http://example.org/education/concept/Instandhaltung>,
        <http://example.org/education/concept/Sicherheit>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Zuverl%C3%A4ssigkeit>,
        <http://example.org/education/concept/Zuverl%C3%A4ssigkeitsfunktion> ;
    dcterms:title "SI Lernpaket 11 Zuverlässigkeit"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:83kZEOAtmmoA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kromlinger>,
        <http://example.org/education/person/Schwarz> ;
    dcterms:description "Die Lösung zur 11. Übung Aufgabe 5 behandelt das Postsche Korrespondenzproblem (PCP) und untersucht, ob sich die Menge aller lösbaren und nicht lösbaren Instanzen des PCP in der Menge aller rekursiv aufzählbaren Instanzen befindet. Es wird gezeigt, dass PCP nicht entscheidbar ist und somit auch nicht rekursiv aufzählbar. Durch diese Erkenntnisse können Studierende die Berechenbarkeit und Komplexität von Algorithmen besser verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "83kZEOAtmmoA" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Automatentheorie>,
        <http://example.org/education/concept/Berechenbarkeit>,
        <http://example.org/education/concept/Entscheidbarkeit>,
        <http://example.org/education/concept/Formale_Sprache>,
        <http://example.org/education/concept/Komplexit%C3%A4t>,
        <http://example.org/education/concept/Postsches_Korrespondenzproblem>,
        <http://example.org/education/concept/Rekursion>,
        <http://example.org/education/concept/Theoretische_Informatik>,
        <http://example.org/education/concept/Turingmaschine> ;
    dcterms:title "Theoretische Informatik: Berechenbarkeit und Komplexität 11. Übung Aufgabe 5"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:84jEz4PuMTbI a edu:LearningResource ;
    dcterms:description "Das Kapitel behandelt die Wirkung von Steuern auf Märkte und erläutert, wie die Steuerlast zwischen Käufern und Verkäufern verteilt wird. Es werden die Determinanten des Wohlfahrtsverlustes durch Steuern beschrieben, insbesondere die Rolle der Preiselastizitäten von Angebot und Nachfrage. Durch das Studium dieses Kapitels können Lerner verstehen, wie Steuern das wirtschaftliche Wohlergehen der Marktteilnehmer beeinflussen und wie sie die Steuerlast tragen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "84jEz4PuMTbI" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentliche_Finanzen>,
        <http://example.org/education/concept/Angebots-_und_Nachfragenelastizit%C3%A4t>,
        <http://example.org/education/concept/Besteuerung>,
        <http://example.org/education/concept/Elastizit%C3%A4t>,
        <http://example.org/education/concept/Marktversagen>,
        <http://example.org/education/concept/Mikro%C3%B6konomie>,
        <http://example.org/education/concept/Regulierung>,
        <http://example.org/education/concept/Steuern>,
        <http://example.org/education/concept/Wirtschaftspolitik>,
        <http://example.org/education/concept/Wohlfahrtsverlust> ;
    dcterms:title "Kosten der Besteuerung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:85O5X6St59x4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kunz>,
        <http://example.org/education/person/Schmidt>,
        <http://example.org/education/person/Wronska> ;
    dcterms:description "Die Präsentation behandelt die Vielfalt von Beziehungen und Familienformen, um eine offene und akzeptierende Haltung gegenüber sexueller und geschlechtlicher Vielfalt zu fördern. Durch die Auseinandersetzung mit verschiedenen Beziehungskonstellationen und -formen sollen Lernende ein umfassendes Verständnis entwickeln, um Diskriminierung zu vermeiden und eine inklusive Bildung zu ermöglichen. Die Präsentation bietet einen Überblick über verschiedene Familienmodelle, Beziehungsformen und die Bedeutung einer liberalen Haltung in der Bildung."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "85O5X6St59x4" ;
    dcterms:subject <http://example.org/education/concept/Beziehungsformen>,
        <http://example.org/education/concept/Bildungseinrichtungen>,
        <http://example.org/education/concept/Diskriminierungspr%C3%A4vention.>,
        <http://example.org/education/concept/Familienformen>,
        <http://example.org/education/concept/Geschlechtervielfalt>,
        <http://example.org/education/concept/Interkulturalit%C3%A4t>,
        <http://example.org/education/concept/Liberaler_Humanismus>,
        <http://example.org/education/concept/Menschenrechte>,
        <http://example.org/education/concept/Sexualp%C3%A4dagogik>,
        <http://example.org/education/concept/sexuelle_Orientierung> ;
    dcterms:title "Liberaler Humanismus Menschliche Gefühle als neue religionsartige Glaubensrichtung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:85QgKMXtGhCk a edu:LearningResource ;
    dcterms:description "Dieses Kapitel behandelt die Auswirkungen von Preiskontrollen auf Märkte und erklärt, wie Höchst- und Mindestpreise die Marktergebnisse verändern können. Durch die Lektüre dieses Kapitels werden Leser verstehen, wie politische Maßnahmen wie Preisbindungen den Markt beeinflussen und welche Konsequenzen sie haben können. Insbesondere werden sie lernen, wie Angebots- und Nachfrageüberschüsse entstehen und wie diese durch Regulierungen aufgehoben werden können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "85QgKMXtGhCk" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomische_Theorie>,
        <http://example.org/education/concept/Angebots-_und_Nachfragemodelle>,
        <http://example.org/education/concept/Marktregulierung>,
        <http://example.org/education/concept/Mikro%C3%B6konomie>,
        <http://example.org/education/concept/Preiskontrollen>,
        <http://example.org/education/concept/Preispolitik>,
        <http://example.org/education/concept/Regulierungs%C3%B6konomie>,
        <http://example.org/education/concept/Staatsintervention>,
        <http://example.org/education/concept/Wirtschaftliches_Gleichgewicht>,
        <http://example.org/education/concept/Wirtschaftspolitik> ;
    dcterms:title "Kapitel 9. Wirtschaftspolitische Maßnahmen: Preiskontrollen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:86A-iWsV1zQI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schmiedel> ;
    dcterms:description "Durch die Umweltbildung können Menschen ein Verantwortungsgefühl gegenüber der Natur entwickeln und lernen, sie zu schützen und zu erhalten. Der Schulgarten kann als Ort des Lernens dienen, an dem Kinder und Erwachsene gemeinsam Natur- und Artenschutz erfahren und Zusammenhänge zwischen Ernährung und Produktion erkennen können. Durch die Teilnahme an Umweltbildungsprojekten können Menschen ein gesundes, förderliches Bewusstsein schaffen und sich für den Schutz der Umwelt einsetzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "86A-iWsV1zQI" ;
    dcterms:publisher <http://example.org/education/organization/Berufsschullehramt> ;
    dcterms:subject <http://example.org/education/concept/Bildung_f%C3%BCr_nachhaltige_Entwicklung>,
        <http://example.org/education/concept/Ern%C3%A4hrungsbildung>,
        <http://example.org/education/concept/Generationengerechtigkeit>,
        <http://example.org/education/concept/Gesundheitserziehung>,
        <http://example.org/education/concept/Klimaschutz>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Natur-_und_Artenschutz>,
        <http://example.org/education/concept/Schulgarten>,
        <http://example.org/education/concept/Umweltbildung>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Portfolio Block 3 Umweltbildung"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:86G6I4dp3neg a edu:LearningResource ;
    dcterms:description "Dieses Kapitel behandelt die Grundlagen von Entscheidungen unter Knappheit und Restriktionen, indem es die Opportunitätskosten und Grenzkosten als zentrale Konzepte einführt. Durch die Analyse von Beispielen wie dem Ultimatum-Spiel und der Produktionsmöglichkeitenkurve werden die Auswirkungen von Einkommens- und Substitutionseffekten auf individuelle Entscheidungen verdeutlicht. Die Lernenden gewinnen ein Verständnis dafür, wie Menschen Entscheidungen treffen und wie Anreize und Präferenzen ihre Wahl beeinflussen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "86G6I4dp3neg" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomische_Entscheidungen>,
        <http://example.org/education/concept/Anreize>,
        <http://example.org/education/concept/Experimentelle_%C3%96konomik>,
        <http://example.org/education/concept/Fairness>,
        <http://example.org/education/concept/Homo_oeconomicus>,
        <http://example.org/education/concept/Knappheit>,
        <http://example.org/education/concept/Mikro%C3%B6konomie>,
        <http://example.org/education/concept/Opportunit%C3%A4tskosten>,
        <http://example.org/education/concept/Rationalit%C3%A4t>,
        <http://example.org/education/concept/Wirtschaftstheorie> ;
    dcterms:title "Entscheidungen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:86nQ0Z8-2zNM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/H%C3%B6rrmann>,
        <http://example.org/education/person/Tarrab> ;
    dcterms:description "Das Laborprotokoll behandelt grundlegende Konzepte und Techniken der Digitaltechnik, indem es die Durchführung von Experimenten beschreibt, die die Funktionsweise von digitalen Schaltungen und die Verwendung von Oszilloskopen und Logikgattern veranschaulichen. Durch das Protokoll können Lernende praktische Erfahrungen im Umgang mit BF15-Boards sammeln und ein umfassendes Verständnis für die Funktionsweise digitaler Schaltungen entwickeln. Die Ergebnisse der Experimente werden dokumentiert, um Abweichungen zu analysieren und Hypothesen zu formulieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "86nQ0Z8-2zNM" ;
    dcterms:subject <http://example.org/education/concept/Bachelorarbeit>,
        <http://example.org/education/concept/Digitaltechnik>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Logikgatter>,
        <http://example.org/education/concept/Multimeter>,
        <http://example.org/education/concept/Netzteil>,
        <http://example.org/education/concept/Oszilloskop>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Schaltungstechnik>,
        <http://example.org/education/concept/Widerstandsmessung> ;
    dcterms:title "1. Versuchsabnahme Digitech Laborprotokoll HörrmannTarrab"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

