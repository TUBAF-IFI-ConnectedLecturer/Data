oer:52-DruZpIZTY a edu:LearningResource ;
    sim:similarTo oer:5LwP9N2fwl1s,
        oer:5fGq783LJRFY,
        oer:5rGVxJhbXqtY ;
    dcterms:creator <http://example.org/education/person/Achtziger>,
        <http://example.org/education/person/Leucht>,
        <http://example.org/education/person/Opitz> ;
    dcterms:description "Die Bedeutung von Regenwürmern und anderen Bodenorganismen für die Biodiversität in Weinbergen wird dargestellt, einschließlich ihrer Rolle bei der Humusbildung, als Bioindikatoren für Bodenqualität und als natürliche Gegenspieler von Schadorganismen. Die Lebensweise und Eigenschaften dieser Organismen werden beschrieben, wie zum Beispiel ihre Fähigkeit, bis zu 7 Meter tief zu graben und tote organische Substanz zu zersetzen. Durch das Verständnis dieser Prozesse können Weinbauern die Anpassung an den Klimawandel verbessern und eine nachhaltigere Bewirtschaftung ihrer Flächen erreichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "52-DruZpIZTY" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/%C3%96kosystem>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
        <http://example.org/education/concept/Boden%C3%B6kologie>,
        <http://example.org/education/concept/Bodenfauna>,
        <http://example.org/education/concept/Laufk%C3%A4fer>,
        <http://example.org/education/concept/Regenw%C3%BCrmer>,
        <http://example.org/education/concept/Sandlaufk%C3%A4fer>,
        <http://example.org/education/concept/Springschw%C3%A4nze>,
        <http://example.org/education/concept/Weinberg>,
        <http://example.org/education/concept/terrestrische_%C3%96kologie> ;
    dcterms:title "BIODIVina 2021 BIODIVina"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

