        <http://example.org/education/concept/Exkursionsdidaktik>,
        <http://example.org/education/concept/Fachdidaktik>,
        <http://example.org/education/concept/Naturwissenschaftlicher_Unterricht>,
        <http://example.org/education/concept/Verfahrenstechnik>,
        <http://example.org/education/concept/Wissenschaftliche_Weiterbildung> ;
    dcterms:title "Behandlung (verfahrens-)technischer Aspekte BFR Chemietechnik TU Dresden  SoSe 2024"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

