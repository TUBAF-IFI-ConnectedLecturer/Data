    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von Bahnfahrzeugen wird durch die Kraftschlussausnutzung bestimmt, die von verschiedenen Faktoren wie der Zugkraft, der Geschwindigkeit und den Umweltbedingungen abhängt. Durch das Verständnis dieser Faktoren können Ingenieure optimale Fahrzeugkonfigurationen entwickeln, um die Leistung und Sicherheit von Bahnfahrzeugen zu verbessern. Die Ausnutzung des Kraftschlusses ist ein wichtiger Aspekt der Fahrdynamik, da sie die Traktion und Bremsleistung von Schienenfahrzeugen beeinflusst."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "31KdW2JIVxsA" ;
    dcterms:subject <http://example.org/education/concept/Bahndynamik>,
        <http://example.org/education/concept/Eisenbahntechnik>,
        <http://example.org/education/concept/Elektrotraktion>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Gleitreibung>,
        <http://example.org/education/concept/Kraftschluss>,
        <http://example.org/education/concept/Lokomotivtechnik>,
        <http://example.org/education/concept/Rad-Schiene-Kontakt>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Schleudern> ;
    dcterms:title "Fahrdynamik Bahnfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

