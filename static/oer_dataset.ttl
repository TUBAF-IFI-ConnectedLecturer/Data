oer:3wBjbirg7BbA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Wessely> ;
    dcterms:description "Die Aufgabe behandelt die Abschätzung des Durchsatzes einer Schlagmühle anhand der Zerkleinerungsgesetze von Bond und Rittinger. Dabei werden die spezifischen Energiebedarfe im Bond-Bereich und Rittinger-Bereich berechnet, um den Gesamtenergiebedarf zu bestimmen. Durch die Lösung dieser Aufgabe können Lernende das Verständnis für die Anwendung von Zerkleinerungsgesetzen in der Mechanischen Verfahrenstechnik erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3wBjbirg7BbA" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bond-Koeffizient>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Kalisalz>,
        <http://example.org/education/concept/Mahlgut>,
        <http://example.org/education/concept/Massenstrom.>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Rittinger-Koeffizient>,
        <http://example.org/education/concept/Schlagm%C3%BChle>,
        <http://example.org/education/concept/Zerkleinerung> ;
    dcterms:title "Aufgabe 4-2: Abschätzung des Durchsatzes einer Schlagmühle anhand der Zerkleinerungsgesetze"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3zU--nSTvN4w a edu:LearningResource ;
    sim:similarTo oer:9-hEmKK_kTZA,
        oer:9MG0scNtvTqo ;
    dcterms:creator <http://example.org/education/person/Landau>,
        <http://example.org/education/person/Lifschitz> ;
    dcterms:description "Dieses Dokument enthält eine Zusammenstellung von Formeln und Operatoren der Vektoranalysis, einschließlich Gradient, Divergenz und Laplace-Operator in kartesischen und Kugelkoordinaten. Es bietet eine umfassende Übersicht über die wichtigsten mathematischen Konzepte für die Beschreibung von physikalischen Phänomenen, insbesondere in der Hydrodynamik. Durch das Studium dieser Formeln können Lernende ihre Fähigkeiten im Bereich der Vektoranalysis und ihrer Anwendung in der Physik verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3zU--nSTvN4w" ;
    dcterms:subject <http://example.org/education/concept/Differentialoperatoren>,
        <http://example.org/education/concept/Fluidmechanik>,
        <http://example.org/education/concept/Hydrodynamik>,
        <http://example.org/education/concept/Kartesische_Koordinaten>,
        <http://example.org/education/concept/Koordinatensysteme>,
        <http://example.org/education/concept/Kugelkoordinaten>,
        <http://example.org/education/concept/Mathematische_Physik>,
        <http://example.org/education/concept/Partielle_Differentialgleichungen>,
        <http://example.org/education/concept/Theoretische_Physik>,
        <http://example.org/education/concept/Vektoranalysis> ;
    dcterms:title "Formeln_NStGlen_2020.mcd"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

