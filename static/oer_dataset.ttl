        <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Erfolgskontrolle>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Spieltheorie>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Versuchsplanung>,
        <http://example.org/education/concept/Wiederholung> ;
    dcterms:title "Keine Angabe"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:18lhVkn5_HgE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Riedel> ;
    dcterms:description "Das vertiefende Modul des E-Teaching-Zertifikates behandelt typische Szenarien und Aufgaben der Hochschullehre und zeigt, wie diese mit digitalen Medien unterstützt werden können. Die Teilnehmenden erfahren, wie sie Medien zur Lösung hochschuldidaktischer Herausforderungen einsetzen können und entwickeln ein Konzept für eine mediengestützte Lehreinheit. Durch das Modul erwerben die Lernenden Kompetenzen im Einsatz digitaler Medien in der Hochschullehre."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "18lhVkn5_HgE" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Blended_Learning>,
        <http://example.org/education/concept/Digitale_Medien>,
