    dcterms:title "MEDIENSPEICHER ODER INFORMATIONSZENTREN?"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:17c-TeiZ-rXRI a edu:LearningResource ;
    sim:similarTo oer:17zQyupNMpmbU ;
    dcterms:creator <http://example.org/education/person/Carter>,
        <http://example.org/education/person/Johnson>,
        <http://example.org/education/person/Lee> ;
    dcterms:description "Der Computer hat eine lange Geschichte, die von einfachen Rechenmaschinen wie dem Abakus bis hin zu komplexen Geräten wie dem Apple Macintosh reicht. Durch die Entwicklung von Transistoren und Mikroprozessoren konnten Computer immer schneller und kleiner werden, was sie für den Einsatz im Alltag geeignet machte. Heute sind Computer allgegenwärtig und dienen als Rechenmaschine, Spielzeug, Kommunikationsmittel, Waffe oder Informationsspeicher, wobei sie fast jeden Aspekt des Lebens beeinflussen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "17c-TeiZ-rXRI" ;
    dcterms:subject <http://example.org/education/concept/Computerentwicklung>,
        <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Geschichte_des_Computers>,
        <http://example.org/education/concept/Informationstechnologie>,
        <http://example.org/education/concept/Integrierter_Schaltkreis>,
        <http://example.org/education/concept/Mikrocomputer>,
        <http://example.org/education/concept/Personal_Computer>,
        <http://example.org/education/concept/Silicon_Valley>,
        <http://example.org/education/concept/Spielkonsole>,
        <http://example.org/education/concept/Transistor> ;
    dcterms:title "Die Geschichte des Computers"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

oer:3RSYaa47Ovh8 a edu:LearningResource ;
    sim:similarTo oer:3edHBaHPt2G0,
