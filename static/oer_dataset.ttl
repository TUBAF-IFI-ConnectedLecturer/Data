    dcterms:creator <http://example.org/education/person/Klose> ;
    dcterms:description "Das Material umfasst zwei Anwendungsaufgaben zur geradlinig gleichmäßig beschleunigten Bewegung im Physikunterricht, die Lernenden dabei unterstützen, ihre Fähigkeiten beim Messen von unbekannten Größen und bei der Planung komplexer Aufgaben zu erweitern. Durch die Bearbeitung dieser Aufgaben können Lernende ihre Fachkompetenz, Methodenkompetenz und Sozialkompetenz fördern. Die Aufgaben sind für die 9. Klasse konzipiert und beinhalten einen Umweltbezug zur Motivation der Lernenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10C934zTKP-2Y" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Arbeitsbl%C3%A4tter>,
        <http://example.org/education/concept/Bewegungsgesetze>,
        <http://example.org/education/concept/DQR>,
        <http://example.org/education/concept/Fachkompetenz>,
        <http://example.org/education/concept/Kompetenzorientierung>,
        <http://example.org/education/concept/Lernbereich_3>,
        <http://example.org/education/concept/Physikdidaktik>,
        <http://example.org/education/concept/Physikunterricht>,
        <http://example.org/education/concept/Unterrichtsmaterialien>,
        <http://example.org/education/concept/geradlinig_gleichm%C3%A4%C3%9Fig_beschleunigte_Bewegung> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

