        <http://example.org/education/concept/Netzanalyse>,
        <http://example.org/education/concept/Stromversorgung>,
        <http://example.org/education/concept/Zweipoltheorie> ;
    dcterms:title "Übung 1: Berechnungsgrundlagen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6GJnpfjamXno a edu:LearningResource ;
