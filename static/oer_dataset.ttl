    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5rNgIPOp086A a edu:LearningResource ;
    sim:similarTo oer:6kXhp-LEXyPc,
        oer:7-p5vgbhqc7w ;
    dcterms:creator <http://example.org/education/person/Martin> ;
    dcterms:description "Die Studie untersucht den Zusammenhang zwischen Need for Cognition (NFC) und Entscheidungsverhalten anhand der Iowa Gambling Task, um die individuellen Unterschiede im kognitiven Bedürfnis zu erfassen. Die Ergebnisse zeigen, dass die Gruppen mit hohem und niedrigem NFC-Wert sich signifikant voneinander unterscheiden, jedoch kein Einfluss auf das Treffen vorteilhafter Entscheidungen festgestellt werden konnte. Durch diese Studie können Lernende Einsichten in die komplexen Prozesse des Entscheidungsverhaltens gewinnen und die Bedeutung von NFC für die Varianzaufklärung bei Informationsverarbeitungsprozessen erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5rNgIPOp086A" ;
    dcterms:subject <http://example.org/education/concept/Entscheidungsverhalten>,
        <http://example.org/education/concept/Informationsverarbeitung>,
        <http://example.org/education/concept/Iowa-Gambling-Task>,
        <http://example.org/education/concept/Kognition>,
        <http://example.org/education/concept/Moderatorvariable>,
        <http://example.org/education/concept/Need-for-Cognition>,
        <http://example.org/education/concept/Probleml%C3%B6sen>,
        <http://example.org/education/concept/Risikobereitschaft>,
        <http://example.org/education/concept/Stereotype>,
        <http://example.org/education/concept/kognitive_Pr%C3%A4ferenzen> ;
    dcterms:title "Replikation der Studie \"Individual differences in need for cognition and decision making in the Iowa Gambling Task\" von Harman (2011)"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

