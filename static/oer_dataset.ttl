        <http://example.org/education/concept/Gleisbau>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Verkehrswissenschaften>,
        <http://example.org/education/concept/Zugfahrtsimulation> ;
    dcterms:title "Fahrzeitermittlung und Indexierung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7pkKTSuRE2RE a edu:LearningResource ;
    sim:similarTo oer:7y2Vvnr6LpnI,
