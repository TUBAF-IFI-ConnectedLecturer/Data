        <http://example.org/education/concept/Gartengestaltung>,
        <http://example.org/education/concept/Gartenkunst>,
        <http://example.org/education/concept/Landschaftsarchitektur>,
        <http://example.org/education/concept/Ornamentale_Beetpflanzen>,
        <http://example.org/education/concept/Pflanzenkenntnisse>,
        <http://example.org/education/concept/Pflanzentaxonomie> ;
    dcterms:title "Pflanzenkenntnisse II Sommersemester 2019"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

