oer:9gzKRPe1QBes a edu:LearningResource ;
    sim:similarTo oer:9oymdMlIaP4g ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Pragmatik, einem Teilgebiet der Linguistik, das sich mit der Bedeutung von Äußerungen in Abhängigkeit vom Kommunikationskontext beschäftigt. Durch das Studium dieser Materialien können Lernende ein Verständnis dafür entwickeln, wie Sprechakte funktionieren, wie Propositionen aufgebaut sind und welche Rolle die Konversationsmaximen bei der Verständigung spielen. Zudem werden Beispiele für performative Äußerungen, konstative Äußerungen und implizite Mitteilungen vorgestellt, um die Anwendung dieser Konzepte in der Kommunikation zu veranschaulichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9gzKRPe1QBes" ;
    dcterms:subject <http://example.org/education/concept/Germanistik>,
        <http://example.org/education/concept/Kommunikationstheorie>,
        <http://example.org/education/concept/Konversationsanalyse>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Phonologie>,
        <http://example.org/education/concept/Pragmatik>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Sprachwissenschaft>,
        <http://example.org/education/concept/Sprechakttheorie>,
        <http://example.org/education/concept/Syntax> ;
    dcterms:title "Einführung in die germanistische Sprachwissenschaft"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

