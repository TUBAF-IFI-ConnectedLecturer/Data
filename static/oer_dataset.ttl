        <http://example.org/education/concept/Viskose_Fl%C3%BCssigkeit> ;
    dcterms:title "Strömungsprobleme der Mechanischen Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

