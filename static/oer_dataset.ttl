        <http://example.org/education/concept/Bibliothekskatalogisierung>,
        <http://example.org/education/concept/Floating-Point-Arithmetik>,
        <http://example.org/education/concept/Hochleistungsrechnen>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Integralrechnung>,
        <http://example.org/education/concept/Numerische_Mathematik>,
        <http://example.org/education/concept/Parallelverarbeitung>,
        <http://example.org/education/concept/Rechnerarithmetik>,
        <http://example.org/education/concept/Riemann-Summe> ;
    dcterms:title "Komplexes Rechnen mit MPI und numerische Integration"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3wNP4W-Py5K4 a edu:LearningResource ;
