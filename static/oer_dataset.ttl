        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Zugf%C3%BChrerabteil> ;
    dcterms:title "Einschränkungsberechnung eines Packwagens"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

