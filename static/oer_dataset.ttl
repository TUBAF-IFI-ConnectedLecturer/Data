oer:12vaKEZhvdAGY a edu:LearningResource ;
    sim:similarTo oer:9J6otDLGSfWg ;
    dcterms:description "Diese Zusammenstellung präsentiert wichtige Persönlichkeiten der Informatik und Mathematik, darunter Alonzo Church, Edsger Dijkstra, Tony Hoare, Grace Hopper, Kurt Gödel, Claude Shannon, Konrad Zuse, John von Neumann, Andrei Kolmogorow und Niklaus Wirth. Durch die Lektüre dieser Biografien können Leser grundlegende Konzepte und Entwicklungen in der Informatik und Mathematik kennenlernen, wie zum Beispiel den Lambda-Kalkül, Dijkstras Algorithmus oder die Von-Neumann-Architektur. Die Zusammenstellung bietet einen Überblick über die Beiträge dieser Persönlichkeiten zur Entwicklung von Programmiersprachen, Algorithmen und Theorien in der Informatik und Mathematik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12vaKEZhvdAGY" ;
    dcterms:subject <http://example.org/education/concept/Algorithmik>,
        <http://example.org/education/concept/Berechenbarkeit>,
        <http://example.org/education/concept/Computerarchitektur>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Informationstheorie>,
        <http://example.org/education/concept/Mathematische_Logik>,
        <http://example.org/education/concept/Programmiersprachen>,
        <http://example.org/education/concept/Spieltheorie>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie> ;
    dcterms:title "Serie 9 Aufg2 Hörrmann"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:12vb3tao3ZmiI a edu:LearningResource ;
