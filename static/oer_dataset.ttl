    dcterms:creator <http://example.org/education/person/F.>,
        <http://example.org/education/person/Gehrke>,
        <http://example.org/education/person/Reames-Zimmermann> ;
    dcterms:description "Die Alte Geschichte als Teildisziplin der Geschichtswissenschaft behandelt den Mittelmeerraum im Zeitraum der Antike aus allen Perspektiven, wie zum Beispiel Geschlechtergeschichte, Ernährungsgeschichte und Kindheitsgeschichte. Grundlage sind griechische und lateinische Quellen, wie philologische, archäologische, numismatische und epigraphische Quellen. Durch das Studium der Alten Geschichte können Lernende ein umfassendes Verständnis der antiken Kulturen und Gesellschaften erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3KT6YGm1p4fU" ;
    dcterms:subject <http://example.org/education/concept/Alexander_der_Gro%C3%9Fe>,
        <http://example.org/education/concept/Alte_Geschichte>,
        <http://example.org/education/concept/Antike>,
        <http://example.org/education/concept/Arch%C3%A4ologische_Quellen>,
        <http://example.org/education/concept/Frauen_in_der_Antike>,
        <http://example.org/education/concept/Geschlechtergeschichte>,
        <http://example.org/education/concept/Julius_Caesar>,
        <http://example.org/education/concept/Numismatische_Quellen>,
        <http://example.org/education/concept/Quellenkritik>,
        <http://example.org/education/concept/R%C3%B6mische_Republik> ;
    dcterms:title "Alte Geschichte"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3NVWL4u5VMw4 a edu:LearningResource ;
    sim:similarTo oer:5_-xpVg-ejkU ;
    dcterms:creator <http://example.org/education/person/M%C3%BCller>,
        <http://example.org/education/person/Th%C3%B6rner> ;
    dcterms:description "Lernende können mit diesem Material die Programmierumgebung von LEGO: Boost kennenlernen und erfahren, wie sie den humanoiden Roboter Vernie mittels symbolbasierter Befehle steuern und Aktionen ausführen lassen können. Durch die Bearbeitung von Arbeitsaufträgen und Stationen erwerben sie Kenntnisse über Algorithmen, Verzweigungen und Schleifen, um eigene Programme zu erstellen. Zudem lernen sie, wie sie Vernie dazu bringen, Emotionen auszudrücken, indem sie Sound, Bewegung, Kopfneigung und Licht nutzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3NVWL4u5VMw4" ;
    dcterms:subject <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Emotionen>,
        <http://example.org/education/concept/Here_is_the_list_of_assigned_keywords%3AProgrammierung>,
        <http://example.org/education/concept/Humanoider_Roboter>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Lernmaterialien>,
        <http://example.org/education/concept/Mensch-Maschine-Interaktion>,
        <http://example.org/education/concept/Motorsteuerung>,
        <http://example.org/education/concept/Robotik>,
        <http://example.org/education/concept/Sensortechnologie> ;
    dcterms:title "HUMANOIDE ROBOTER UND KÜNSTLICHE INTELLIGENZEN"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3TY9HFY1692w a edu:LearningResource ;
    sim:similarTo oer:3XzkRkF9NU2c ;
    dcterms:description "In diesem Tutorial wird Schülern gezeigt, wie sie eine App namens Flappy Bird mit dem App Inventor erstellen können. Durch die Bearbeitung der Aufgaben lernen sie, wie sie Grafiken und Hintergründe einbinden, Bewegungen programmieren und Interaktionen zwischen Objekten realisieren können. Am Ende des Tutorials haben die Schüler eine funktionierende App entwickelt, die sie auf ihrem Smartphone oder Tablet ausführen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3TY9HFY1692w" ;
    dcterms:publisher <http://example.org/education/organization/RWTH_Aachen> ;
    dcterms:subject <http://example.org/education/concept/App-Entwicklung>,
        <http://example.org/education/concept/Benutzeroberfl%C3%A4che>,
