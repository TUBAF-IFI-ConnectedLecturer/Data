    dcterms:title "Aufgabe"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7HxsS6p6EM-8 a edu:LearningResource ;
    sim:similarTo oer:7YtJTeNiidyc,
        oer:8hBx9oZBHQhg ;
    dcterms:creator <http://example.org/education/person/Kurschner> ;
    dcterms:description "Das Seminar behandelt numerische Methoden im Data Science und Machine Learning, insbesondere die Anwendung orthogonaler Matrizen und die lineare Regression mit QR-Zerlegung. Die Übungen umfassen das Nachweis von Eigenschaften orthogonaler Matrizen, die Berechnung einer Regressiongeraden und die Analyse des kleinste-Quadrate-Fehlers bei der linearen Regression. Durch das Durcharbeiten dieser Übungen erwerben die Lernenden Kenntnisse über numerische Methoden und ihre Anwendung in der Datenanalyse."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7HxsS6p6EM-8" ;
    dcterms:subject <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Kleinste-Quadrate-Methode>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Lineare_Regression>,
        <http://example.org/education/concept/Machine_Learning>,
        <http://example.org/education/concept/Numerische_Analysis>,
        <http://example.org/education/concept/Orthogonale_Matrizen>,
        <http://example.org/education/concept/QR-Zerlegung>,
        <http://example.org/education/concept/Testdaten>,
        <http://example.org/education/concept/Trainingsdaten> ;
    dcterms:title "Numerische Methoden im Data Science Machine Learning"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

