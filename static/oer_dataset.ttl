        <http://example.org/education/concept/Kunststoffe>,
        <http://example.org/education/concept/Polymer>,
        <http://example.org/education/concept/Raumfahrt>,
        <http://example.org/education/concept/Werkstoffeigenschaften>,
        <http://example.org/education/concept/elektrische_Maschinen> ;
    dcterms:title "Eigenschaften und Anwendung organischer Isolierstoffe"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:7k2DUiYvzMmQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Sachse> ;
    dcterms:description "Die Datensammlung im Sekretariat eines Finanzdienstleisters soll den Postversand und die damit verbundenen Kosten überwachen. Durch die Einführung einer Datenbankanwendung sollen Fragen zu Mitarbeiter, Briefsendungen, Versandwegen und Kosten beantwortet werden können. Die Entitäten, Beziehungen und Attribute werden im ER-Diagramm festgelegt, um eine Übersicht über den Postausgang je Mitarbeiter zu erhalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7k2DUiYvzMmQ" ;
    dcterms:subject <http://example.org/education/concept/Briefpost>,
        <http://example.org/education/concept/Datenbankanwendung>,
        <http://example.org/education/concept/Datensammlung>,
        <http://example.org/education/concept/Finanzdienstleister>,
        <http://example.org/education/concept/Kostenrechnung>,
        <http://example.org/education/concept/Mitarbeiter>,
        <http://example.org/education/concept/Postversand>,
        <http://example.org/education/concept/Sekretariat>,
        <http://example.org/education/concept/Versandweg>,
        <http://example.org/education/concept/Zeitraum> ;
    dcterms:title "Aufgabe 2"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7k3hwD1wrzG4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Bartsch>,
        <http://example.org/education/person/Kopitzsch>,
        <http://example.org/education/person/Vogel> ;
    dcterms:description "Die Urbanisierung ist ein Prozess der Ausbreitung und Diffusion städtischer Lebens- und Verhaltensweisen, der sich in der Veränderung der Siedlungsform und -struktur sowie der Verteilung der Bevölkerung im Raum ausprägt. Durch das Studium dieser Thematik können Lernende die langfristigen Auswirkungen der sozialen Segregation auf die Integration von Slumbewohnern in der städtischen Gesellschaft und Wirtschaft verstehen und Lösungsansätze für die Probleme Jakartas und Dharavis entwickeln. Zudem werden sie mit den Konzepten Global Cities und Urbanisierung vertraut, um die Herausforderungen des globalen Wandels zu bewältigen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7k3hwD1wrzG4" ;
    dcterms:publisher <http://example.org/education/organization/Dr._A.P.J._Abdul_Kalam_Technical_University> ;
    dcterms:subject <http://example.org/education/concept/Bev%C3%B6lkerungsentwicklung>,
        <http://example.org/education/concept/Global_City>,
        <http://example.org/education/concept/Megaurbanisierung>,
        <http://example.org/education/concept/Raumforschung>,
        <http://example.org/education/concept/Slumbewohner>,
        <http://example.org/education/concept/Stadtentwicklung>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Stadtr%C3%A4umliche_Reorganisation>,
        <http://example.org/education/concept/Umweltverschmutzung>,
        <http://example.org/education/concept/Urbanisierung> ;
    dcterms:title "WACHSTUM OHNE GRENZEN? Urbanisierung SEMINAR REGIONALE HUMAN GEOGRAPHIE"@de ;
