    dcterms:creator <http://example.org/education/person/Fricke>,
        <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Stephan> ;
    dcterms:description "Die Vorlesung behandelt die Hilfs- und Nebenbetriebe von Triebfahrzeugen, einschließlich der Kühlanlage, Heizungsanlage, Klimaanlage und Energiebereitstellung. Durch das Studium dieser Inhalte können Lernende die Funktionen und Anforderungen dieser Systeme verstehen und ihre Bedeutung für den sicheren und effizienten Betrieb von Triebfahrzeugen erkennen. Insbesondere werden die physikalischen Grundlagen der Wärmeübertragung, die Auslegung von Kühlsystemen und die Überwachung von Temperaturen und Drücken behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8Kp3RNGGjpwQ" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Antriebskonfigurationen>,
        <http://example.org/education/concept/Dieselmotor>,
        <http://example.org/education/concept/Energieeffizienz>,
