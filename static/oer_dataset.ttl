oer:6jZ4CrcOmqgM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hellbach> ;
    dcterms:description "Die Konsultationsplan-Übersicht für das Modul LM 332 \"Vegetationsbetonte Freiraumgestaltung\" im Wintersemester 2020/21 an der Technischen Universität Dresden bietet eine Übersicht über die Gruppenarbeiten und -präsentationen von Studierenden. Durch die Teilnahme an diesem Modul können Lernende Erfahrungen im Bereich der vegetationsbetonten Freiraumgestaltung sammeln und Kenntnisse über verschiedene Aspekte wie essbare Städte, Gemeinschaftsgärten und Pflegemanagement erwerben. Die Präsentationen von insgesamt acht Gruppen bieten einen Überblick über die verschiedenen Ansätze und Konzepte in diesem Bereich."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6jZ4CrcOmqgM" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Esskultur>,
        <http://example.org/education/concept/Freiraumplanung>,
        <http://example.org/education/concept/Gartenbau>,
        <http://example.org/education/concept/Gr%C3%BCnfl%C3%A4chen>,
        <http://example.org/education/concept/Kreislaufwirtschaft>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Urban_Gardening>,
        <http://example.org/education/concept/Vegetationsgestaltung> ;
    dcterms:title "LM 332 Vegetationsbetonte Freiraumgestaltung WiSe 2020/21"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:6k3pRX7olQ4w a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hilgers>,
        <http://example.org/education/person/Landmann>,
        <http://example.org/education/person/Pilny> ;
    dcterms:description "Der Verwertungsplan ist ein Instrument, das Unternehmen und Organisationen dabei hilft, ihre Projekte und Forschungsergebnisse erfolgreich umzusetzen und zu vermarkten. Durch die Anwendung eines Verwertungsplans können Unternehmen ihre Ziele besser erreichen, indem sie ihre Stärken und Schwächen analysieren, Marktchancen erkennen und Strategien entwickeln, um ihre Produkte oder Dienstleistungen erfolgreich anzubieten. Der Verwertungsplan im Kontext des VR-Ergonomieassistenz-Projekts bietet eine umfassende Übersicht über die Ziele, Schutzrechte, wirtschaftlichen Erfolgsaussichten und Wissenstransfer im digitalen Zeitalter."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6k3pRX7olQ4w" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Betriebswirtschaftslehre>,
        <http://example.org/education/concept/F%C3%B6rderprogramme>,
        <http://example.org/education/concept/Innovationsmanagement>,
        <http://example.org/education/concept/Marketingstrategie>,
        <http://example.org/education/concept/Marktforschung>,
        <http://example.org/education/concept/Produktlebenszyklus>,
        <http://example.org/education/concept/Technologieentwicklung>,
        <http://example.org/education/concept/Universit%C3%A4tskooperation>,
        <http://example.org/education/concept/Verwertungsplan>,
        <http://example.org/education/concept/Wissenstransfer> ;
    dcterms:title "WPA-Projekt Marketing Verwertungsplan im Marketing und in der Praxis"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6kRj6sfCZKKE a edu:LearningResource ;
    dcterms:description "Der Nebenwinkelsatz beschreibt die Beziehung zwischen zwei Geraden in der Ebene und den daraus resultierenden Winkelfeldern. Durch Anwendung des Satzes können verschiedene Winkelarten bestimmt werden, wie spitzer, rechter, stumpfer oder gestreckter Winkel. Die Aufgaben im Dokument helfen Lernenden, die Winkelarten zu erkennen und ihre Eigenschaften zu verstehen."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "6kRj6sfCZKKE" ;
    dcterms:subject <http://example.org/education/concept/Ebene_Geometrie>,
        <http://example.org/education/concept/Ebenengleichungen>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Geometrische_Figuren>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Nebenwinkel>,
        <http://example.org/education/concept/Sekundarstufe>,
        <http://example.org/education/concept/Winkel>,
        <http://example.org/education/concept/Winkelarten>,
        <http://example.org/education/concept/Winkelmessung> ;
    dcterms:title "Nebenwinkelsatz"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6lbCmnZmtlmg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Herzler> ;
    dcterms:description "Diese Präsentation behandelt die Berechnung von Streuungsmaßen in der Statistik, wie zum Beispiel Spannweite, durchschnittliche Abweichung und Standardabweichung. Durch die Verwendung von Beispielen mit zwei Lostöpfen werden die verschiedenen Streuungsmaße erläutert und berechnet. Die Lernenden können nach dem Durcharbeiten dieser Präsentation die verschiedenen Streuungsmaße berechnen und anwenden, um Entscheidungen in der Statistik zu treffen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "6lbCmnZmtlmg" ;
    dcterms:subject <http://example.org/education/concept/Arithmetisches_Mittel>,
        <http://example.org/education/concept/Durchschnittliche_Abweichung>,
        <http://example.org/education/concept/Gewinnwahrscheinlichkeit>,
        <http://example.org/education/concept/Risikoanalyse>,
        <http://example.org/education/concept/Spannweite>,
        <http://example.org/education/concept/Standardabweichung>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Streuungsma%C3%9Fe>,
        <http://example.org/education/concept/Varianz>,
        <http://example.org/education/concept/Wahrscheinlichkeit> ;
    dcterms:title "Funktionsweise dieser Präsentation"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

