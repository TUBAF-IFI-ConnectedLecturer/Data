    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von spurgeführten Fahrzeugen und vermittelt den Studierenden das Verständnis der Fahrwiderstandskräfte und Antriebskräfte. Durch die Berechnung des Fahrzeugwiderstands anhand empirischer Gleichungen werden die Einflüsse auf die Fahrzeit und Energiebedarf erläutert. Die Studierenden lernen, die Fahrleistung von verschiedenen Fahrzeugen und Zügen zu berechnen und zu bewerten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3Wi_K1jzRVeI" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Fahrzeugdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Widerstandskr%C3%A4fte> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

