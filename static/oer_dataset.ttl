oer:12AXfUcaoQf_M a edu:LearningResource ;
    sim:similarTo oer:12TsEj1OiKMac,
        oer:4YxC8HC_JIuo,
        oer:91-79BGg_8bo ;
    dcterms:description "Die Bundesgartenschau (BUGA) 2033 in Dresden bietet eine einzigartige Chance, die Stadtentwicklung und -gestaltung nachhaltig zu fördern und die grüne Infrastruktur zu stärken. Durch die BUGA werden neue Grün- und Wasserstrukturen geschaffen, die den Biotopverbund verbessern und das lokale Klima positiv beeinflussen. Die Veranstaltung wird zudem ein umfangreiches Programm an gärtnerischen und nicht-gärtnerischen Aktivitäten und Ausstellungen bieten, das Besucher und Bewohner gleichermaßen anspricht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12AXfUcaoQf_M" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentlicher_Nahverkehr>,
        <http://example.org/education/concept/Gartenbau>,
        <http://example.org/education/concept/Gr%C3%BCnfl%C3%A4chen>,
        <http://example.org/education/concept/Kulturveranstaltung>,
        <http://example.org/education/concept/Landschaftsarchitektur>,
        <http://example.org/education/concept/Stadterneuerung>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Tourismus>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Verkehrsanbindung> ;
    dcterms:title "Bundesgartenschau 2033 Dresden - Konzept und Rahmenplanung"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

