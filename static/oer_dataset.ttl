        <http://example.org/education/concept/Gelenke>,
        <http://example.org/education/concept/Mediendidaktik>,
        <http://example.org/education/concept/Medizinische_Ausbildung>,
        <http://example.org/education/concept/Pflegeunterricht> ;
    dcterms:title "Seminar Angewandte Mediendidaktik 3D-Druck"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:10Ii_NKW2mayM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Dorenburg> ;
    dcterms:description "Dieses Lernmaterial behandelt die Grundlagen von Datenbankbefehlen und zeigt, wie man einfache Anfragen erstellt, um bestimmte Informationen aus einer Datenbank abzurufen. Durch die Arbeit mit diesem Material können Lerner die ersten Schritte in der Datenbankprogrammierung erlernen und erfahren, wie sie Filteranweisungen und Selektionsbefehle verwenden, um bestimmte Daten zu finden. Am Ende des Lernprozesses können Lerner einfache Datenbankbefehle selbstständig erstellen und anwenden."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "10Ii_NKW2mayM" ;
    dcterms:subject <http://example.org/education/concept/Datenabfrage>,
