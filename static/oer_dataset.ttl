oer:3udeaC5IR08A a edu:LearningResource ;
    sim:similarTo oer:4PSJbuIud3oM,
        oer:5Q0kdAEb2iqY,
        oer:6HImeEcR-rN0,
        oer:93gc9arAKwVo ;
    dcterms:creator <http://example.org/education/person/H%C3%B6lzel> ;
    dcterms:description "Das Protokoll behandelt die elektrischen Stromkreise und Felder, indem es die Grundlagen der Elektrizität, wie den elektrischen Widerstand, die Spannung und die Stromstärke, erklärt und experimentelle Versuche zum Nachweis des elektrischen Feldes eines Plattenkondensators und von U-I-Kennlinien beschreibt. Durch diese Materialien sollen Lernende die Fähigkeit erwerben, elektrische Bauelemente zu analysieren und die Auswirkungen von Elektrischen Feldern auf verschiedene Materialien zu verstehen. Zudem werden didaktische Basisinformationen zum Versuchskomplex bereitgestellt, um die Anwendung der elektrischen Energie im Alltag zu verdeutlichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3udeaC5IR08A" ;
    dcterms:subject <http://example.org/education/concept/Elektrizit%C3%A4t>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Kondensator>,
        <http://example.org/education/concept/Magnetfeld>,
        <http://example.org/education/concept/Naturwissenschaften>,
        <http://example.org/education/concept/Physikunterricht>,
        <http://example.org/education/concept/Spannung>,
        <http://example.org/education/concept/Stromkreis>,
        <http://example.org/education/concept/Stromst%C3%A4rke>,
        <http://example.org/education/concept/elektrischer_Widerstand> ;
    dcterms:title "Protokoll zu Elektrische Stromkreise und elektrische sowie magnetische Felder"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

