    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von spurgeführten Fahrzeugen und Zügen, wobei empirische Gleichungen zur Berechnung des Fahrzeugwiderstandes hergeleitet werden. Durch die Anwendung dieser Gleichungen auf verschiedene Fahrzeuge und Züge können die Widerstandskräfte und die erforderliche Leistung berechnet werden. Die Studierenden erwerben Kenntnisse über die Grundlagen der Fahrdynamik, die Bewertung des Traktionsvermögens und die Berechnung von Fahrzeiten und Energiebedarf."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "16YSWIhW_X6UM" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Fahrwiderstand>,
        <http://example.org/education/concept/Fahrzeugelektrik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Leistungsanalyse>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Zugfahrtsimulation> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

