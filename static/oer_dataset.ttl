        <http://example.org/education/concept/Gesundheitsf%C3%B6rderung>,
        <http://example.org/education/concept/L%C3%A4rmschutz>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Verpackungsanlagen>,
        <http://example.org/education/concept/Vibrationsschutz> ;
    dcterms:title "Zentrales Produktbeispiel: Verpackungsanlage Risikobeurteilung (Verpackungsanlage_Risikobeurteilung)"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

