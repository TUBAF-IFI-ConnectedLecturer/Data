    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik für Verkehrsingenieure behandelt die Grundlagen der Antriebskräfte und Fahrwiderstandskräfte im Schienenverkehr, um das Traktionsvermögen von Fahrzeugen zu verstehen und die Leistungs- und Energiebedarfe zu berechnen. Durch diese Vorlesung erhalten die Lernenden Einblick in die Zugkrafterzeugung, Kraftschlussmechanismen und Fahrzeugauslegungen, um die Fahrdynamik von Schienenfahrzeugen zu optimieren. Die Inhalte dieser Vorlesung dienen der Vorbereitung auf die Fahrzeitberechnung und die Bewertung der Leistungsfähigkeit von Schienenfahrzeugen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Lz2gki08rL8" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrwiderstand>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Leistungsbedarf>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Traktion>,
        <http://example.org/education/concept/Verkehrsingenieurwesen> ;
    dcterms:title "Fahrdynamik für Verkehrsingenieure"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

