    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik-Vorlesung behandelt den Leistungsbedarf von Fahrzeugen bei verschiedenen Geschwindigkeiten und Steigungen. Die Folien präsentieren Berechnungen und Vergleiche des absoluten und relativen Leistungsbedarfs für verschiedene Zugtypen, wie Sattelzug und Güterzug. Durch das Studium dieser Materialien können Lernende die grundlegenden Konzepte der Fahrdynamik und die Anforderungen an Fahrzeuge in verschiedenen Betriebszuständen verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3jNiT6Lg7DrU" ;
    dcterms:subject <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Fahrwiderstand>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Leistungsbedarf>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Fahrdynamik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8sTG35VRIK7Q a edu:LearningResource ;
    sim:similarTo oer:96KYDYTG2uu0,
        oer:9ysxFnUUqULY ;
    dcterms:creator <http://example.org/education/person/Kie%C3%9Fling> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Didaktik der Informatik und bietet eine umfassende Einführung in die Erstellung von interaktiven Präsentationen, Lernszenarien und digitalen Medien. Durch das Studium dieses Materials können Lerner Werkzeuge für die Erstellung von über 15 verschiedenen Lernszenarien kennenlernen und ihre Fähigkeiten im Bereich der Mediengestaltung und des E-Learning verbessern. Zudem werden didaktische Handreichungen und organisatorische Hinweise für die Erstellung von Prüfungsleistungen und Artefakten bereitgestellt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8sTG35VRIK7Q" ;
    dcterms:subject <http://example.org/education/concept/Computergrafik>,
        <http://example.org/education/concept/Didaktik_der_Informatik>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Interaktive_Medien>,
        <http://example.org/education/concept/Lernspielentwicklung>,
        <http://example.org/education/concept/Mediengestaltung>,
        <http://example.org/education/concept/Pr%C3%A4sentationstechniken>,
        <http://example.org/education/concept/Unterrichtsmaterialien>,
        <http://example.org/education/concept/Webseitengestaltung> ;
    dcterms:title "Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

