        <http://example.org/education/concept/Schule_der_Zukunft>,
        <http://example.org/education/concept/Unterrichtsmedien> ;
    dcterms:title "Lehrende und Lernende im digitalen Wandel"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

