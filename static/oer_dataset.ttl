        <http://example.org/education/concept/Schleifen>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Wiederholung> ;
    dcterms:title "Schleifen - Definition"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8z_C6ZBfuCjc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Teuscher> ;
    dcterms:description "Das Lernpaket behandelt die Ermittlung empirischer Verteilungsfunktionen und bietet eine umfassende Anleitung zur Durchführung dieser Aufgabe. Durch das Studium dieses Materials können Lerner die notwendigen Kenntnisse und Fähigkeiten erwerben, um empirische Verteilungsfunktionen zu bestimmen und anzuwenden. Die Inhalte sind insbesondere für Studierende der Elektrotechnik und Informationstechnik an der Technischen Universität Chemnitz von Bedeutung."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "8z_C6ZBfuCjc" ;
