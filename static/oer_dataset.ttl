        <http://example.org/education/concept/Naturschutz>,
        <http://example.org/education/concept/Reptilien>,
        <http://example.org/education/concept/S%C3%A4ugetiere>,
        <http://example.org/education/concept/V%C3%B6gel>,
        <http://example.org/education/concept/Weinbau> ;
    dcterms:title "Biodiversität in Weinbergen: Tiere - SonsHge WirbelHere"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:5I8n_ku7_bcE a edu:LearningResource ;
    sim:similarTo oer:657d57g6IfTE ;
    dcterms:creator <http://example.org/education/person/Neugebauer> ;
    dcterms:description "Die Programmierung I von Mario Neugebauer behandelt die Grundlagen der objektorientierten Programmierung in Java, indem sie Klassen, Objekte und Methoden erklärt und anhand von Beispielen wie Arbeitskraftverwaltung und Lagerbestand demonstriert. Durch das Studium dieser Materialien können Lernende die Konzepte der objektorientierten Programmierung verstehen und anwenden, um eigene Programme zu entwickeln. Die Beispiele und Übungen helfen dabei, die Theorie in die Praxis umzusetzen und die Fähigkeiten im Umgang mit Java zu verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5I8n_ku7_bcE" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Attribute>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Java>,
        <http://example.org/education/concept/Klassen>,
        <http://example.org/education/concept/Methoden>,
        <http://example.org/education/concept/Objekte>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/objektorientierte_Programmierung> ;
    dcterms:title "Programmierung I"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5LrgHdOLRikw a edu:LearningResource ;
    sim:similarTo oer:7L8EI5xvFxgM,
        oer:7PjjiAU1F7EQ,
        oer:7ooLs2M4PBUY ;
    dcterms:description "Das Unterprogramm berechnet die Funktion arctan(x) näherungsweise unter Verwendung der Taylor-Entwicklung für x-Werte zwischen -1 und 1. Der relative Fehler eps wird als Abbruchbedingung verwendet, um die Genauigkeit des Ergebnisses anzupassen. Durch den Vergleich mit der C-Funktion atan(x) aus cmath können Lerner die Güte ihrer Implementierung überprüfen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5LrgHdOLRikw" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Approximation>,
        <http://example.org/education/concept/Arkustangens>,
        <http://example.org/education/concept/C%2B%2B>,
        <http://example.org/education/concept/Fehleranalyse>,
        <http://example.org/education/concept/Numerische_Mathematik>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Rechnerarithmetik>,
        <http://example.org/education/concept/Taylor-Reihe>,
        <http://example.org/education/concept/mathematische_Funktionen> ;
    dcterms:title "Näherungsweise Berechnung der Funktion arctan(x)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5N6eG7Jo0Sx0 a edu:LearningResource ;
    sim:similarTo oer:5V7CCHMewp9w,
        oer:5j-BdZMxkJ18,
        oer:8yR7wddrg5mE,
        oer:9U9Lpna1Bxwo,
        oer:9c6kNiCyL4iY ;
    dcterms:creator <http://example.org/education/person/Kindermann> ;
    dcterms:description "Das Arbeitsblatt behandelt die Erstellung einfacher Netzwerke mit Filius und ermöglicht den Lernenden, ein Heimnetzwerk aufzubauen und es mit einem Büronetzwerk zu verbinden. Durch die Bearbeitung der Aufgaben können die Lernenden die Funktionsweise von Netzwerken verstehen und erfahren, wie sie eine Kommunikation zwischen verschiedenen Netzwerken ermöglichen. Am Ende des Arbeitsblatts können die Lernenden ein funktionierendes Netzwerk erstellt haben, das es ermöglicht, Nachrichten zwischen den Computern auszutauschen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "5N6eG7Jo0Sx0" ;
    dcterms:subject <http://example.org/education/concept/B%C3%BCronetzwerk>,
        <http://example.org/education/concept/Computerkommunikation>,
        <http://example.org/education/concept/Datenaustausch>,
        <http://example.org/education/concept/Heimnetzwerk>,
        <http://example.org/education/concept/Kommunikationsnetzwerk>,
        <http://example.org/education/concept/Netzwerke>,
        <http://example.org/education/concept/Netzwerkprobleme>,
        <http://example.org/education/concept/Netzwerkverwaltung>,
        <http://example.org/education/concept/Rechnerverbindung>,
        <http://example.org/education/concept/Switches> ;
    dcterms:title "Ausgewählte Aspekte der Fachdidaktik Informatik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5OMtmMkQVRAg a edu:LearningResource ;
    sim:similarTo oer:5Q9DbrTcVyDA,
        oer:5fJeNBrvMQTc,
        oer:5r3F_HIysIeA ;
    dcterms:description "Durch die Erkundung des Erlebnishofs und der Stationen erfahren Lernende über die Welt von Krabat, einem Jungen, der in einer Mühle lebt und sich gegen den bösen Meister auflehnt. Sie lernen, wie Krabat seine Zauberkraft entdeckt und nutzt, um den Fluch zu brechen und seine Freunde zu retten. Durch die interaktiven Aufgaben und Rätsel werden Lernende dazu angeregt, ihre eigenen Fähigkeiten und Stärken zu erkennen und sich auf ihre eigene Reise der Selbstentdeckung zu begeben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5OMtmMkQVRAg" ;
    dcterms:subject <http://example.org/education/concept/17._Jahrhundert>,
        <http://example.org/education/concept/Deutsche_Literatur>,
        <http://example.org/education/concept/Fantasy-Literatur>,
        <http://example.org/education/concept/Jugendbuch>,
        <http://example.org/education/concept/M%C3%A4rchen>,
        <http://example.org/education/concept/M%C3%BChle>,
        <http://example.org/education/concept/Sagen>,
        <http://example.org/education/concept/Schwarze_Kunst>,
        <http://example.org/education/concept/Sorben>,
        <http://example.org/education/concept/Zauberei> ;
    dcterms:title "Das Konzept und alle dazugehörigen Materialien sind im Rahmen von TUD-Sylber² entstanden."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5Pg9dpDE7BHo a edu:LearningResource ;
    sim:similarTo oer:5yLqxjSR7-NA,
        oer:7alLlsoIrNso,
        oer:9ZMXaS-orpvQ ;
    dcterms:creator <http://example.org/education/person/Giese-Hinz> ;
    dcterms:description "Die Vorlesung behandelt die Reinigung von Fassaden und Gebäudehüllen, wobei die Ziele der Erschließung von Gebäuden, wie Bauüberwachung, Qualitätskontrolle und Instandhaltungsmaßnahmen, erreicht werden sollen. Es werden verschiedene Möglichkeiten der Reinigung vorgestellt, darunter Befahranlagen, Mobile Systeme, Berufskletterer und automatisierte Reinigungssysteme. Durch die Vorlesung erhalten die Lernenden Einblick in die verschiedenen Aspekte der Fassadenreinigung und -wartung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Pg9dpDE7BHo" ;
    dcterms:subject <http://example.org/education/concept/Arbeitsb%C3%BChnen>,
        <http://example.org/education/concept/Baukonstruktion>,
        <http://example.org/education/concept/Bauphysik>,
        <http://example.org/education/concept/Fassadenreinigung>,
        <http://example.org/education/concept/Fassadentechnik>,
        <http://example.org/education/concept/Geb%C3%A4udeh%C3%BClle>,
        <http://example.org/education/concept/Geb%C3%A4udeinstandhaltung>,
        <http://example.org/education/concept/Geb%C3%A4udetechnik>,
        <http://example.org/education/concept/Hochbau>,
        <http://example.org/education/concept/Reinigungsverfahren> ;
    dcterms:title "Gebäudehülle Reinigung von Fassaden"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5QCtlYBjmwXM a edu:LearningResource ;
    sim:similarTo oer:5e7O7g02eF1I ;
    dcterms:creator <http://example.org/education/person/Bock> ;
    dcterms:description "Dieses Material bietet eine interaktive Reise durch die Geschichte von Dippoldiswalde und das Erzgebirge, bei der Schülerinnen und Schüler Sagenstücke sammeln und Zusammenhänge zwischen den Stationen herstellen müssen. Durch diese Erkundung lernen sie über den Bergbau, die Stadtgeschichte und die Sage vom Bergmann, während sie ihre Fähigkeiten im Bereich von Problemlösung, Teamarbeit und kritischem Denken verbessern. Am Ende können sie die gesammelten Sagenstücke zu einer vollständigen Geschichte zusammenfügen und einen Hinweis darauf finden, wie sie den Geist von Daniel Knappe besänftigen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5QCtlYBjmwXM" ;
    dcterms:subject <http://example.org/education/concept/Arch%C3%A4ologie>,
        <http://example.org/education/concept/Bergbau>,
        <http://example.org/education/concept/Deutschland>,
        <http://example.org/education/concept/Erzgebirge>,
        <http://example.org/education/concept/Geschichte>,
        <http://example.org/education/concept/Lehrpfad>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Museum>,
        <http://example.org/education/concept/Sachsen>,
        <http://example.org/education/concept/Schule> ;
    dcterms:title "17 Lehrpfad Station 5: Museum"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5Ta4vchk16tQ a edu:LearningResource ;
    sim:similarTo oer:5stRggG3WqL4,
        oer:6pyf44GCfAf8,
        oer:74Nq4fv-LTNU ;
    dcterms:creator <http://example.org/education/person/Nehring>,
        <http://example.org/education/person/et_al.> ;
    dcterms:description "Die vorliegende Arbeit behandelt die Bedeutung von Pflanzenarten für die Anpassung an den Klimawandel im Weinbau und bietet eine Übersicht über die Eigenschaften und Verwendbarkeit von 30 verschiedenen Arten. Durch das Studium dieser Informationen können Lernende erkennen, welche Pflanzenarten am besten geeignet sind, um Erosionsschutz, Wasserinfiltration und -speicherung zu fördern und somit den Weinbau an die Auswirkungen des Klimawandels anzupassen. Die Arbeit bietet einen Leitfaden für die Auswahl von Pflanzenarten, die den Anforderungen des Weinbaus gerecht werden und gleichzeitig die Biodiversität fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Ta4vchk16tQ" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kosystemdienstleistungen>,
        <http://example.org/education/concept/Anpassung_an_den_Klimawandel>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
        <http://example.org/education/concept/Bodenschutz>,
        <http://example.org/education/concept/Erosionsschutz>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Landschafts%C3%B6kologie>,
        <http://example.org/education/concept/Naturschutz>,
        <http://example.org/education/concept/Pflanzen%C3%B6kologie>,
        <http://example.org/education/concept/Vegetationskunde> ;
    dcterms:title "BIOTOP- und ARTENLISTE"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

