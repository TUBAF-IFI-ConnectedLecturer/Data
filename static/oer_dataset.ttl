oer:6qXfwHk95ZwI a edu:LearningResource ;
    dcterms:description "Die Analyse der ersten Folge der TV-Serie Breaking Bad bietet Einblicke in die technischen Aspekte der Erzählweise und die Struktur einer erfolgreichen Pilotfolge. Durch die Verwendung von Szenen aus der Serie und behind-the-scenes-Videoausschnitten werden die Gründe für den Erfolg der Serie aufgezeigt. Die Arbeit ermöglicht es, die Entwicklung eines Charakters zu verstehen und die emotionalen Konflikte in einer TV-Serie zu analysieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6qXfwHk95ZwI" ;
    dcterms:subject <http://example.org/education/concept/Charakterentwicklung>,
        <http://example.org/education/concept/Dramaturgie.>,
        <http://example.org/education/concept/Drehbuchanalyse>,
        <http://example.org/education/concept/Emotionaler_Konflikt>,
        <http://example.org/education/concept/Erz%C3%A4hlstruktur>,
        <http://example.org/education/concept/Fernsehserie>,
        <http://example.org/education/concept/Film-_und_Fernsehwissenschaft>,
        <http://example.org/education/concept/Medienanalyse>,
        <http://example.org/education/concept/Serielle_Erz%C3%A4hlung>,
        <http://example.org/education/concept/TV-Pilot> ;
    dcterms:title "Lessons from the Screenplay: Breaking Bad"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:6qhEvbaV1YeA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Burchhardt>,
        <http://example.org/education/person/D%C3%BCbener> ;
    dcterms:description "Diese Handreichung für Lehrkräfte behandelt das Thema Arzt-Computer-Teams und bietet Fallbeispiele, Anregungsfragen und Diskussionsfragen, um Schülerinnen und Schülern die Möglichkeiten und Herausforderungen von Robot-Assisted Surgery zu vermitteln. Durch die Bearbeitung dieser Materialien können Lernende ihre Meinung zu Fragen der Autonomie in der Medizin bilden und ethische Aspekte bei der Entscheidungsfindung berücksichtigen. Zudem werden sie angeregt, sich mit den Chancen und Risiken von Robot-Assisted Surgery auseinanderzusetzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6qhEvbaV1YeA" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Augmented_Reality>,
        <http://example.org/education/concept/Autonomes_System>,
        <http://example.org/education/concept/Gesundheitswesen>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/KI-gest%C3%BCtzte_Diagnostik>,
        <http://example.org/education/concept/Medizinische_Robotik>,
        <http://example.org/education/concept/Medizintechnologie>,
        <http://example.org/education/concept/Operationstechniken>,
        <http://example.org/education/concept/Patientenentscheidung>,
        <http://example.org/education/concept/Robot-assistierte_Chirurgie> ;
    dcterms:title "Handreichung für Lehrkräfte"@de ;
    dcterms:type <http://example.org/education/type/Handreichung_f%C3%BCr_Lehrkr%C3%A4fte> .

oer:6yHn54Vwxpm8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/G%C3%B6ring> ;
    dcterms:description "Die Mündliche Abiturprüfung im Fach Informatik - Grundkurs für die Klasse 10 umfasst eine theoretische und praktische Aufgabe, bei der Schülerinnen und Schüler ihre Fähigkeiten in der Anwendung von Microsoft Office Word unter Beweis stellen müssen. Durch die Bearbeitung dieser Aufgaben erwerben sie Kenntnisse über die Verwendung von Dokumentvorlagen, die Erstellung von Serienbriefen und die Gestaltung von Flyern. Zudem lernen sie, wie sie Inhalte in Word-Dokumenten strukturieren und formatieren können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6yHn54Vwxpm8" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Abiturpr%C3%BCfung>,
        <http://example.org/education/concept/Bildbearbeitung>,
        <http://example.org/education/concept/Dateiformate>,
        <http://example.org/education/concept/Dokumentvorlagen>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Lehrplanentwicklung>,
        <http://example.org/education/concept/Microsoft_Office_Word>,
        <http://example.org/education/concept/Pr%C3%A4sentationstechniken>,
        <http://example.org/education/concept/Schablone>,
        <http://example.org/education/concept/Textverarbeitung> ;
    dcterms:title "Mündliche Abiturprüfung Mündliche Abschlussprüfung Fach Informatik - Grundkurs Klasse 10"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

