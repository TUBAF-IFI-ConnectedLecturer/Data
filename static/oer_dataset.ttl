        oer:6nlDHDOOEfjc,
        oer:6p3ayXVRvjj0 ;
    dcterms:creator <http://example.org/education/person/Kie%C3%9Fling> ;
    dcterms:description "Die Didaktik der Informatik behandelt die Grundlagen von Webanwendungen und -gestaltung, einschließlich HTML, CSS, Backend- und Frontend-Konzepte sowie Content-Management-Systemen wie Typo3. Durch das Studium dieser Materialien können Lernende eigene Webseiten erstellen, Vor- und Nachteile klassischer Webgestaltungen benennen und die Seitenansicht in Typo3 für verschiedene Ansichten zielführend verwenden. Zudem werden sie mit den Grundlagen von Client-Server-Systemen, Cache-Konzepten und der Struktur von Webanwendungen vertraut gemacht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "650m6AFexVjg" ;
    dcterms:subject <http://example.org/education/concept/Backend>,
        <http://example.org/education/concept/CSS>,
        <http://example.org/education/concept/Client-Server-Systeme>,
        <http://example.org/education/concept/Content-Management-Systeme>,
        <http://example.org/education/concept/Frontend>,
        <http://example.org/education/concept/HTML>,
        <http://example.org/education/concept/Informatik>,
