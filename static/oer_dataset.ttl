    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von spurgeführten Fahrzeugen und geht auf die verschiedenen Einflussfaktoren des Luftwiderstands ein, wie Formgebung, Zuglänge und Tunnelquerschnitt. Die Studierenden lernen, wie der Luftwiderstand bei verschiedenen Fahrzeugarten berechnet wird und welche Faktoren den Widerstand beeinflussen. Durch die Vorlesung erhalten sie Einblick in die aerodynamische Optimierung von Nutzfahrzeugen und die Bedeutung des Tunnelfaktors für den Luftwiderstand."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "177hqqSaz_7jc" ;
    dcterms:subject <http://example.org/education/concept/Aerodynamik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Fahrzeugdesign>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/G%C3%BCterz%C3%BCge>,
        <http://example.org/education/concept/Luftwiderstand>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Str%C3%B6mungsmechanik>,
        <http://example.org/education/concept/Tunnelbau>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

