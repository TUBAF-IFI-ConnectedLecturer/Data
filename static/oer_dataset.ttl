        <http://example.org/education/concept/SQL>,
        <http://example.org/education/concept/Soziale_Netzwerke> ;
    dcterms:title "Kurzvorstellung InstaHub"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:8PO7X_Dq2RGM a edu:LearningResource ;
    sim:similarTo oer:8Ryh12h4rfg4,
        oer:8hzW3Vene_n4,
        oer:8m6jqOsjIJgg,
        oer:8zGGrgCCUEjY ;
    dcterms:creator <http://example.org/education/person/Cassack> ;
    dcterms:description "Diese Lehrmaterialien behandeln verschiedene Aspekte der Betriebswirtschaftslehre, insbesondere Marketing und Marktforschung, und bieten Beispiele und Erklärungen zu Konzepten wie Marktreaktionsfunktionen, Produktlebenszyklus und Imageförderung. Durch das Studium dieser Materialien können Lernende ein umfassendes Verständnis der betriebswirtschaftlichen Grundlagen und ihrer Anwendung in der Praxis erwerben. Die Quellenangaben verweisen auf die 26. Auflage des Lehrbuchs \"Einführung in die Allgemeine Betriebswirtschaftslehre\" von Wöhe, Döring und Brösel."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8PO7X_Dq2RGM" ;
    dcterms:subject <http://example.org/education/concept/Betriebliche_Entscheidungen>,
        <http://example.org/education/concept/Betriebswirtschaftslehre>,
        <http://example.org/education/concept/Experiment>,
        <http://example.org/education/concept/Fragebogen>,
        <http://example.org/education/concept/Imagef%C3%B6rderung>,
        <http://example.org/education/concept/Marketing>,
        <http://example.org/education/concept/Marktforschung>,
        <http://example.org/education/concept/Marktreaktionsfunktionen>,
        <http://example.org/education/concept/Produktlebenszyklus> ;
    dcterms:title "Betriebswirtschaftslehre"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:8fZSePkV7CKk a edu:LearningResource ;
    sim:similarTo oer:8fyPV1vyBU8M,
        oer:9wGQwH-t-3K8 ;
