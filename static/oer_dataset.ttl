oer:8FPLZdES6U3I a edu:LearningResource ;
    sim:similarTo oer:8Vy--T0Sbb2I,
        oer:9aG6x_KvBAzw ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Einführung in die Mechanische Verfahrenstechnik\" behandelt die Grundlagen der Stoffwandlung und -umformung, indem sie die wichtigsten Prozesse und Methoden der Verfahrenstechnik darstellt. Durch das Studium dieser Materialien können Lernende die grundlegenden Konzepte und Werkzeuge der Verfahrenstechnik erlernen, um komplexe Stoffwandlungsprozesse zu verstehen und zu optimieren. Insbesondere werden die Themen Sedimentation, Filtration, Maßstabsübertragung und dimensionslose Kennzahlen behandelt, die für die Konzeptionierung und Auslegung von Anlagen in der Verfahrenstechnik von zentraler Bedeutung sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8FPLZdES6U3I" ;
    dcterms:subject <http://example.org/education/concept/Bioverfahrenstechnik>,
        <http://example.org/education/concept/Chemische_Verfahrenstechnik>,
        <http://example.org/education/concept/Dimensionslose_Kennzahlen>,
        <http://example.org/education/concept/Disperse_Systeme>,
        <http://example.org/education/concept/Filtration>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/R%C3%BChrreaktoren>,
        <http://example.org/education/concept/Sedimentation>,
        <http://example.org/education/concept/Stoffwandlung>,
        <http://example.org/education/concept/Verfahrenstechnik> ;
    dcterms:title "Mechanische Verfahrenstechnik LV: Einführung in die Verfahrenstechnik und Naturstofftechnik 1-1"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8lRUmC4DaToE a edu:LearningResource ;
