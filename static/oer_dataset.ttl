    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Lernerfolgskontrolle im Fach Fahrdynamik umfasst eine Vielzahl von Fragen und Aufgaben, die das Verständnis der physikalischen Grundlagen des Fahrverhaltens von Schienenfahrzeugen überprüfen. Durch das Bearbeiten dieser Aufgaben können Lernende ihr Wissen über die Fahrdynamik von Zügen und Lokomotiven erweitern und ihre Fähigkeit zur Anwendung mathematischer Modelle auf reale Probleme verbessern. Die Lösung der Aufgaben erfordert ein tiefes Verständnis der Konzepte wie Fahrwiderstand, Zugkraft, Bremskraft und Energiebilanz."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7eOqfMJtbOs8" ;
    dcterms:subject <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Bremskraft>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Energieeffizienz.>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Wagenzugwiderstand>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fragen und Aufgaben zur Lernerfolgskontrolle im Fach Fahrdynamik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

