oer:10VgRPf5UdO4 a edu:LearningResource ;
    sim:similarTo oer:11bugp9M1qxLM,
        oer:12Co5y9YRuoM,
        oer:1JaeTrzsipmg ;
    dcterms:creator <http://example.org/education/person/Kie%C3%9Fling> ;
    dcterms:description "Diese Aufgabenpool für Theoretische Informatik behandelt die Themen formale Sprachen und Automaten, indem es die Beschreibung von Grammatiken, die Einordnung in die Chomsky-Hierarchie und die Konstruktion von Automaten zum Erkennen gültiger Sätze verlangt. Durch das Bearbeiten dieser Aufgaben können Lerner ihr Verständnis für die Theoretische Informatik vertiefen und ihre Fähigkeiten im Bereich der formalen Sprachtheorie und der Automatentheorie verbessern. Die Lösung der Aufgaben hilft dabei, die Bildungsvorschriften von Grammatiken zu verstehen und die Erkennung von Sätzen durch Automaten zu implementieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10VgRPf5UdO4" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Automaten>,
        <http://example.org/education/concept/Chomsky-Hierarchie>,
        <http://example.org/education/concept/Computerverarbeitung>,
        <http://example.org/education/concept/Formale_Sprachen>,
        <http://example.org/education/concept/Formalsemantik>,
        <http://example.org/education/concept/Grammatiken>,
        <http://example.org/education/concept/K%C3%BCnstliche_Sprachen>,
        <http://example.org/education/concept/Nat%C3%BCrliche_Sprachen>,
        <http://example.org/education/concept/Sprachtheorie>,
        <http://example.org/education/concept/Theoretische_Informatik> ;
    dcterms:title "Theoretische Informatik: Automaten und Sprachen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10_Xsa_7O9hqk a edu:LearningResource ;
    sim:similarTo oer:5--oS03LGhC4,
        oer:52N97oabbYMM,
        oer:5UgabDzet3sM,
        oer:5ld7qvUw7dK8,
        oer:5ywxA1v0Ste4 ;
    dcterms:creator <http://example.org/education/person/Samuelsson> ;
    dcterms:description "Das Schreibzentrum der TU Dresden bietet eine umfassende Einführung in das wissenschaftliche Schreiben, indem es die Grundlagen des Schreibprozesses, verschiedene Schreibmodelle und -strategien sowie Übungen und Anleitungen für Studierende bereitstellt. Durch die Auseinandersetzung mit diesem Material können Lernende ihre Schreibkompetenz verbessern, komplexe Aufgaben bewältigen und ihr wissenschaftliches Denken und Arbeiten vertiefen. Darüber hinaus erhalten sie Einblick in die Bedeutung des Schreibens als Lern- und Denkinstrument im akademischen Kontext."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10_Xsa_7O9hqk" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Akademische_Schreibkompetenz>,
        <http://example.org/education/concept/Hochschuldidaktik>,
        <http://example.org/education/concept/Lehrveranstaltungsplanung>,
        <http://example.org/education/concept/Lernziele>,
        <http://example.org/education/concept/Schreib%C3%BCbung>,
        <http://example.org/education/concept/Schreiben_in_der_Lehre>,
        <http://example.org/education/concept/Schreibkompetenz>,
        <http://example.org/education/concept/Schreibprozessforschung>,
        <http://example.org/education/concept/Studienaktivit%C3%A4ten>,
        <http://example.org/education/concept/Wissenschaftliches_Schreiben> ;
    dcterms:title "GSW-Schlaglichttag Federführend  Schreiben in der Lehre"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10kiTEPZPZjg4 a edu:LearningResource ;
    sim:similarTo oer:10wurVWhr4748,
        oer:6ubeCFGNE9EU,
        oer:8EJDjWBD2ik8 ;
    dcterms:description "Dieses Lehrmaterial behandelt die Themen Algorithmik und Netzwerke in der 8. Klasse und umfasst 38 Stunden. Durch die Bearbeitung dieser Inhalte sollen Schülerinnen und Schüler grundlegende Kenntnisse über Algorithmen, Programmierung und Datensicherheit erwerben. Am Ende des Lehrplans können sie einfache Programme erstellen, Algorithmen entwickeln und grundlegende Sicherheitsmaßnahmen im Umgang mit Daten und Netzwerken anwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10kiTEPZPZjg4" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Datensicherheit>,
        <http://example.org/education/concept/Gruppenarbeit>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Informationssuche>,
        <http://example.org/education/concept/Kommunikation>,
        <http://example.org/education/concept/Netzwerke>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Wikis> ;
    dcterms:title "Stoffverteilungsplan Klasse 8 Schuljahr 22/23"@de ;
    dcterms:type <http://example.org/education/type/Stoffverteilungsplan> .

oer:10nBe1zdb2NNM a edu:LearningResource ;
    sim:similarTo oer:12pHudk4KYim8,
        oer:51rk5ZDqVnkc,
        oer:5l6iB0AgYLNM ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die Veranstaltung \"Wortgeschichten\" behandelt die historische Semantik und ihre Anwendung auf die deutsche Sprache, indem sie den Wandel von Wortbedeutungen und die Einflüsse mittelalterlicher Fach- und Sondersprachen auf das moderne Deutsch untersucht. Durch die Analyse von Fallbeispielen und linguistischen Beschreibungsstrategien sollen Teilnehmer Einblick in die historische Schichtung des deutschen Wortschatzes erhalten. Die Veranstaltung umfasst 12 Sitzungen, die sich mit verschiedenen Aspekten der historischen Semantik auseinandersetzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10nBe1zdb2NNM" ;
