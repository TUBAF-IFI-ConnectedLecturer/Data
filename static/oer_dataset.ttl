    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Energiebilanzierung von Triebfahrzeugen wird detailliert erläutert, um die erforderliche Traktionsenergie zu bestimmen und den Energieumsatz an den Treibradern zu analysieren. Durch die Anwendung von Kennlinienfeldern und TLV-Tafeln können Fahrzeugwirkungsgrade und Energiebezüge ermittelt werden, um energiesparende Fahrweisen zu entwickeln. Die Lektionen vermitteln ein tiefes Verständnis der energetischen Eigenschaften von Triebfahrzeugen und ermöglichen es den Lernenden, optimierte Antriebskonzepte für verschiedene Fahrzeugtypen zu entwerfen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "14Vqtpi-UtSNg" ;
    dcterms:subject <http://example.org/education/concept/Bremsen>,
        <http://example.org/education/concept/Eisenbahnverkehr>,
        <http://example.org/education/concept/Energiesparende_Fahrweise>,
        <http://example.org/education/concept/Fahrzeugwiderstand>,
        <http://example.org/education/concept/Hochgeschwindigkeitszug>,
        <http://example.org/education/concept/Leistungsfluss>,
        <http://example.org/education/concept/Stra%C3%9Fenbahn>,
        <http://example.org/education/concept/Traktionsenergie>,
        <http://example.org/education/concept/Triebfahrzeugwirkungsgrad>,
        <http://example.org/education/concept/kinetische_Energie> ;
    dcterms:title "Fahrdynamik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

