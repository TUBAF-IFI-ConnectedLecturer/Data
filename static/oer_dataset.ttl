        <http://example.org/education/concept/Wurftechnik> ;
    dcterms:title "Materialhandreichung: Dynamische Geometriesoftware zu Abwurfwinkel"@de ;
    dcterms:type <http://example.org/education/type/Materialhandreichung> .

