oer:32sUAm8FXr0c a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Brus>,
        <http://example.org/education/person/Efros> ;
    dcterms:description "Die Emission von Nanokristallen wird untersucht und die resultierenden Photonenenergien werden in Abhängigkeit von der Wellenlänge dargestellt. Verluste bei der Energieumwandlung in einer pn-Si-Solarzelle werden quantifiziert und die verschiedenen Verlustarten wie Reflexion, nicht absorbierte Photonen und Wärmeabgabe aufgeführt. Durch das Studium dieser Prozesse können Leser ein besseres Verständnis der physikalischen Vorgänge bei der Energieumwandlung in Solarzellen erlangen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "32sUAm8FXr0c" ;
    dcterms:subject <http://example.org/education/concept/Emissions-spektroskopie>,
        <http://example.org/education/concept/Halbleiter>,
        <http://example.org/education/concept/Nanokristalle>,
