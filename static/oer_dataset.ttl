        oer:9yDtAm7JR2W8 ;
    dcterms:creator <http://example.org/education/person/Schramm> ;
    dcterms:description "Die vorliegende Aufgabenstellung behandelt Themen der mathematischen Statistik und Wahrscheinlichkeitstheorie, insbesondere die Berechnung von Erwartungswerten und Varianzen, die Untersuchung stochastischer Unabhängigkeit und Korrelation zwischen Zufallsgrößen sowie die Konstruktion von Konfidenzintervallen. Durch das Lösen dieser Aufgaben können Lernende ihre Fähigkeiten in der Anwendung statistischer Methoden und der Interpretation von Ergebnissen verbessern. Die Lösungen der Aufgaben bieten eine umfassende Übung für Studierende, die sich mit der mathematischen Statistik und Wahrscheinlichkeitstheorie auseinandersetzen müssen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10VzMO49LENA8" ;
    dcterms:publisher <http://example.org/education/organization/HTWK_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Bibliographische_Katalogisierung>,
        <http://example.org/education/concept/Erwartungswert>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Konfidenzintervall>,
        <http://example.org/education/concept/Maximum-Likelihood-Sch%C3%A4tzung>,
        <http://example.org/education/concept/Normalverteilung>,
        <http://example.org/education/concept/Statistische_Analyse>,
        <http://example.org/education/concept/Varianz>,
        <http://example.org/education/concept/Zufallsgr%C3%B6%C3%9Fen>,
        <http://example.org/education/concept/stochastische_Unabh%C3%A4ngigkeit> ;
    dcterms:title "Beleg 3"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:118-kl8Rkeg7Y a edu:LearningResource ;
    sim:similarTo oer:11ylCCfDo3m6w,
        oer:12RfFRmtHZFA8,
