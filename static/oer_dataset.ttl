    dcterms:creator <http://example.org/education/person/Fricke> ;
    dcterms:description "Die Einschränkungsberechnung von Vollbahnfahrzeugen berücksichtigt die Breiteneinschränkung durch Querverschiebung und Unsymmetrie, wobei fünf Eingabewerte wie Radius, Spurweite und Federhöhe Einfluss auf den Einschränkungswert haben. Der Neigungskoeffizient wird bei der Berechnung von Neigetechnikfahrzeugen berücksichtigt, um die statische äußere Einschränkung zu bestimmen. Durch das Verständnis dieser Konzepte können Lernende die notwendigen Schritte für die korrekte Einschränkungsberechnung von Fahrzeugen in verschiedenen Situationen durchführen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "31bYsm1xbX_M" ;
    dcterms:subject <http://example.org/education/concept/Breiteneinschr%C3%A4nkung>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Fahrzeugbegrenzungslinie>,
        <http://example.org/education/concept/Gleistechnik>,
        <http://example.org/education/concept/H%C3%B6heneinschr%C3%A4nkung>,
        <http://example.org/education/concept/Lichtraumumgrenzung>,
        <http://example.org/education/concept/Neigungskoeffizient>,
        <http://example.org/education/concept/Querverschiebung>,
        <http://example.org/education/concept/Schienenfahrzeug>,
        <http://example.org/education/concept/Unsymmetrie> ;
    dcterms:title "Grundlagen Sft: 5. Einschränkungsberechnung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:4oMRgvgozwC8 a edu:LearningResource ;
