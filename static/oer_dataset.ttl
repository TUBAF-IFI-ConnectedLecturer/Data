oer:9_WbRNxrUW6U a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Daw>,
        <http://example.org/education/person/Niv> ;
    dcterms:description "Das Konzept der Opportunitätskosten wird verwendet, um zu erklären, wie Tiere und Menschen Entscheidungen treffen, wie viel Mühe und Zeit sie in eine Handlung investieren sollen. Durch die Anwendung von Reinforcement Learning und Computational Modelling können Prozesse der Entscheidungsfindung und Verhaltensweisen besser verstanden werden. Die Rolle des tonischen Dopamins bei der Steuerung von Verhaltensvigor und die Bedeutung von Dopaminpfaden im Gehirn werden erläutert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9_WbRNxrUW6U" ;
    dcterms:subject <http://example.org/education/concept/Belohnungslernen>,
        <http://example.org/education/concept/Dopamin>,
        <http://example.org/education/concept/Entscheidungsfindung>,
        <http://example.org/education/concept/Hirnforschung>,
        <http://example.org/education/concept/Motivation>,
        <http://example.org/education/concept/Neurobiologie>,
        <http://example.org/education/concept/Opportunit%C3%A4tskosten>,
        <http://example.org/education/concept/Reinforcement_Learning>,
        <http://example.org/education/concept/Verhaltens%C3%B6konomie>,
        <http://example.org/education/concept/Vigor> ;
    dcterms:title "Tonisches Dopamin S CAN4"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9bDasLRDrp9c a edu:LearningResource ;
    dcterms:description "Die Aufgaben behandeln die Analyse von Graphen mit Hilfe der Geometriesoftware GeoGebra. Durch die Lösung der Aufgaben können Lernende die Auswirkungen von Veränderungen an den Parametern m und n auf die Position des Graphen verstehen. Sie erwerben Fähigkeiten im Umgang mit der Software und im Analysieren von Graphen in Bezug auf ihre Schnittpunkte mit den Achsen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9bDasLRDrp9c" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
