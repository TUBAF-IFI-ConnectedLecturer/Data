        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Optimierungsproblem>,
        <http://example.org/education/concept/Zielfunktion>,
        <http://example.org/education/concept/mathematische_Programmierung> ;
    dcterms:title "Quizfrage"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

