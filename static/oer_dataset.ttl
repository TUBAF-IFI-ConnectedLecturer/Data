    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs für Ingenieure bietet Lösungshinweise und Aufgaben zu linearen Differentialgleichungen zweiter und höherer Ordnung, einschließlich der Bestimmung von Lösungen, Koeffizienten und Wronski-Determinanten. Durch die Bearbeitung dieser Aufgaben können Lernende ihre Fähigkeiten im Bereich der Differentialgleichungen verbessern und ein tieferes Verständnis der mathematischen Konzepte entwickeln. Die Übungsaufgaben decken verschiedene Aspekte von linearen Differentialgleichungen ab, darunter die Lösung von homogenen und inhomogenen Gleichungen sowie die Anwendung von Wronski-Determinanten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11BSiWKCJy9ds" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Differentialgleichungen>,
        <http://example.org/education/concept/Differentialrechnung>,
        <http://example.org/education/concept/Funktionentheorie>,
