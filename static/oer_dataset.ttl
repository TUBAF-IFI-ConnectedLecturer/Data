    dcterms:title "EÜV Lernpaket 7 Ohmsch-Induktives Systemelement"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:17gaESuBk_WHI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Heck> ;
    dcterms:description "Die SuS erkennen und begründen, warum der Flächeninhalt bei Verschiebung der Punkte in einem Parallelogramm gleich bleibt. Anschließend konstruieren sie selbst ein Parallelogramm mit vorgegebenem Flächeninhalt. Durch diese Aufgabenstellung erwerben die SuS das Verständnis für den Zusammenhang verschiedener Größen in speziellen Vierecken."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "17gaESuBk_WHI" ;
    dcterms:subject <http://example.org/education/concept/Fl%C3%A4cheninhalt>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Geometrische_Figuren>,
        <http://example.org/education/concept/Interaktivit%C3%A4t>,
        <http://example.org/education/concept/Lernen_mit_Medien>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Parallelogramm>,
        <http://example.org/education/concept/Raumgeometrie>,
        <http://example.org/education/concept/Vierecke>,
        <http://example.org/education/concept/mathematische_Konstruktion> ;
    dcterms:title "Ergänzungen zu Artefakt 4"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:17rx6Dx-HD1k a edu:LearningResource ;
    dcterms:description "Dieses Dokument behandelt die Verwendung von SQL und LINQ in C-Programmierung, um Datenbanken zu verwalten und abzufragen. Es werden verschiedene Beispiele und Ansätze vorgestellt, wie z.B. die Verwendung von prepared statements, Joins und LINQ-2-SQL-Abfragen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "17rx6Dx-HD1k" ;
