        oer:9xEOKMBLiQXI ;
    dcterms:creator <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Stephan> ;
    dcterms:description "Die Vorlesung behandelt die Triebfahrzeugtechnik und konzentriert sich auf die Antriebskonfigurationen von Schienenfahrzeugen, insbesondere auf Dieselmotoren und ihre Charakteristika, Leistungsregelung und Abgasprobleme. Durch das Studium dieser Materialien können Lernende ein Verständnis der Funktionsweise und der Anforderungen an Dieselmotoren in Schienenfahrzeugen entwickeln und Lösungen für die Reduzierung von Emissionen und den Einsatz alternativer Kraftstoffe kennenlernen. Zudem werden Beispiele für den Einsatz von Gasturbinen und alternativen Dieselkraftstoffen wie Biodiesel und HVO vorgestellt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9F3jXKexZZMg" ;
    dcterms:subject <http://example.org/education/concept/Abgasemissionen>,
