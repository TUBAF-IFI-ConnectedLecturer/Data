    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs für Ingenieure enthält sieben Aufgaben zur Lösung von Differentialgleichungen ersten und zweiten Grades, die mittels geeigneter Verfahren wie Trennung der Variablen oder Substitutionen gelöst werden müssen. Durch das Bearbeiten dieser Aufgaben können Studierende ihre Fähigkeiten im Bereich der Differentialgleichungen verbessern und Erfahrungen mit verschiedenen Lösungsansätzen sammeln. Die Aufgaben umfassen auch Anfangswertprobleme, die gelöst werden müssen, um die allgemeine Lösung einer Differentialgleichung zu bestimmen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "31m5S6UPOdio" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Anfangswertprobleme>,
        <http://example.org/education/concept/Differentialgleichungen>,
        <http://example.org/education/concept/Differentialrechnung>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Ingenieurmathematik>,
        <http://example.org/education/concept/L%C3%B6sungsverfahren>,
        <http://example.org/education/concept/Mathematik_f%C3%BCr_Ingenieure>,
        <http://example.org/education/concept/gew%C3%B6hnliche_Differentialgleichungen>,
        <http://example.org/education/concept/lineare_Differentialgleichungen> ;
    dcterms:title "Mathematik für Ingenieure - WS202324 Übungsblatt 6"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

