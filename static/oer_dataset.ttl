oer:100ltNQ_cFN1U a edu:LearningResource ;
    sim:similarTo oer:10iipbU6qhjoo,
        oer:4ZTdAU0NzfGs,
        oer:7S5YzmZlRO2U,
        oer:8-4gxAyhuEsI,
        oer:9y5ofzl8Ux3s ;
    dcterms:creator <http://example.org/education/person/Fach> ;
    dcterms:description "Die Interaktive App unterstützt Deutschlerner bei der Bestimmung des passenden Artikels für Substantive im Kontext Deutsch als Zweitsprache oder Deutsch als Fremdsprache. Durch die Auswahl des richtigen Artikels für ein angezeigtes Substantiv können Lerner ihren Wortschatz und ihre Grammatikkenntnisse verbessern. Die App bietet Hilfestellungen wie Hinweise auf Plural- oder Geschlechtsformen, um den Lernprozess zu erleichtern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "100ltNQ_cFN1U" ;
    dcterms:subject <http://example.org/education/concept/Artikelbestimmung>,
        <http://example.org/education/concept/Bildungsportal>,
        <http://example.org/education/concept/Deutsch_als_Fremdsprache>,
        <http://example.org/education/concept/Deutsch_als_Zweitsprache>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Interaktive_Medien>,
        <http://example.org/education/concept/Lernen_mit_Spielen>,
        <http://example.org/education/concept/Sprachlernen>,
        <http://example.org/education/concept/Vokabeln>,
        <http://example.org/education/concept/Wortschatz> ;
    dcterms:title "Artefakt: Interaktive App"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:101SdNNlMhSO4 a edu:LearningResource ;
    sim:similarTo oer:10lmDIqgrz-6E,
        oer:12WdIrHT7lPxc,
        oer:1gnG44_FmP1E,
        oer:3POA6uYgOrMo,
        oer:7zPH7AxkHE-A ;
    dcterms:creator <http://example.org/education/person/Heckmann> ;
    dcterms:description "Diese mündliche Abiturprüfung im Grundkurs Informatik behandelt das Thema Kryptographie und umfasst vier Aufgaben, die die Funktionsweise von symmetrischen und asymmetrischen Verschlüsselungsverfahren, hybride Verschlüsselungen bei Messenger-Anwendungen und das Kerckhoffs-Prinzip abdecken. Durch die Bearbeitung dieser Aufgaben können Lerner ihr Wissen über kryptographische Verfahren erweitern und ihre Fähigkeit entwickeln, komplexe Sicherheitskonzepte zu verstehen und anzuwenden. Die Prüfung ermöglicht es den Lernern, ihre Kenntnisse in der Kryptographie unter Beweis zu stellen und ihre Fähigkeit zur Analyse und Bewertung von Sicherheitsmechanismen zu demonstrieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "101SdNNlMhSO4" ;
    dcterms:subject <http://example.org/education/concept/Asymmetrische_Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Datenverschl%C3%BCsselung>,
        <http://example.org/education/concept/Hybride_Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Informationssicherheit>,
        <http://example.org/education/concept/Kerckhoffs-Prinzip>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Kryptographische_Sicherheit>,
        <http://example.org/education/concept/Messenger-Anwendungen>,
        <http://example.org/education/concept/Symmetrische_Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Verschl%C3%BCsselungsverfahren> ;
    dcterms:title "Mündliche Abiturprüfung Grundkurs Informatik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:102o3h9ma-FK8 a edu:LearningResource ;
    sim:similarTo oer:11yk4i_sFpw-0,
        oer:12ha44bprSOWc,
        oer:4cSeDq9baFdU,
        oer:5Nu8OPQbwO84,
        oer:9qgbTa6gx0ys ;
    dcterms:creator <http://example.org/education/person/Dorenburg> ;
    dcterms:description "Diese Klassenarbeit zum Thema Datenbanken vermittelt grundlegende Konzepte und Funktionen von Datenbanken, wie die Speicherung und Verwaltung von Daten, das Suchen und Abrufen von Informationen sowie die Sicherheit und Integrität von Daten. Durch die Bearbeitung der Aufgaben können Lernende ein ER-Modell erstellen, relationale Datenbankmodelle entwickeln und die Sinnhaftigkeit von Datenbanken in verschiedenen Anwendungsbereichen beurteilen. Die Arbeit unterstützt das Verständnis von Datenbanken als unverzichtbarem Werkzeug in der Datenverwaltung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "102o3h9ma-FK8" ;
    dcterms:subject <http://example.org/education/concept/Datenaktualisierung>,
        <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datenintegrit%C3%A4t>,
        <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Datenverwaltung>,
        <http://example.org/education/concept/Informationsmanagement>,
        <http://example.org/education/concept/Informationssysteme>,
        <http://example.org/education/concept/Schuldatenbank>,
        <http://example.org/education/concept/Zugriffskontrolle>,
        <http://example.org/education/concept/relationale_Datenbanken> ;
    dcterms:title "Klassenarbeit Datenbanken Klasse 9"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:103-JdESPB2jc a edu:LearningResource ;
    sim:similarTo oer:10tiTjkykj8W4,
        oer:4vReX2KVzTCU,
        oer:6_0WR553dfLA,
        oer:79GxsJxr7AdE,
        oer:7GZA6M9GLliU ;
    dcterms:description "Diese Übung im Fach Kartographie behandelt die Gestaltung von Flächen und die Verwendung graphischer Grundelemente, um bestimmte Stimmungen oder Gefühle auszudrücken. Durch verschiedene Aufgaben sollen die Studierenden lernen, wie sie Spannung und Dynamik in ihrer Komposition erzeugen können und wie sie graphische Elemente einsetzen, um eine Bildaussage zu unterstützen. Am Ende dieser Übung sollten die Studierenden in der Lage sein, ihre eigenen Fotos oder Bilder zu erstellen, die bestimmte Stimmungen oder Gefühle vermitteln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "103-JdESPB2jc" ;
    dcterms:subject <http://example.org/education/concept/Bildgestaltung>,
        <http://example.org/education/concept/Farbgebung>,
        <http://example.org/education/concept/Fl%C3%A4chenwirkung>,
        <http://example.org/education/concept/Formenlehre>,
        <http://example.org/education/concept/Grafikdesign>,
        <http://example.org/education/concept/Graphische_Elemente>,
        <http://example.org/education/concept/Kartographie>,
        <http://example.org/education/concept/Komposition>,
        <http://example.org/education/concept/Kunstphotographie>,
        <http://example.org/education/concept/Wahrnehmungspsychologie> ;
    dcterms:title "Übung 3 Lehrveranstaltung Kartographie im WS 202324 Folie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:104M5TNcDZ-2A a edu:LearningResource ;
    sim:similarTo oer:10W1b-VVEqJHc,
        oer:5L6v-TI1xNzU,
        oer:7L8EI5xvFxgM,
        oer:7PjjiAU1F7EQ,
        oer:85Qff396_deE ;
    dcterms:description "Das Programm berechnet die Summe aller Quadratzahlen von 1 bis n, wobei der Benutzer die Zahl n eingibt. Durch den Einsatz eines Nichtabweiszyklus werden alle Quadratzahlen kleiner oder gleich n addiert. Am Ende wird das Ergebnis ausgegeben und kann durch den Benutzer überprüft werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "104M5TNcDZ-2A" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Ausgabesteuerung>,
        <http://example.org/education/concept/C%2B%2B>,
        <http://example.org/education/concept/Eingabeverarbeitung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Quadratzahlen>,
        <http://example.org/education/concept/Schleifen>,
        <http://example.org/education/concept/Summation>,
        <http://example.org/education/concept/Zahlenfolgen> ;
    dcterms:title "Aufgabenstellung: Schreiben Sie ein Programm, welches eine natürliche Zahl n0 einliest und anschließend alle Quadratzahlen die kleiner oder gleich n sind addiert."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:104X7uOcl8FNc a edu:LearningResource ;
    sim:similarTo oer:10wPvGnXVCeTU,
        oer:12pHudk4KYim8,
        oer:3OS1sf6WONPA,
        oer:51rk5ZDqVnkc,
        oer:9uoS64AUfbAY ;
    dcterms:creator <http://example.org/education/person/Holznagel> ;
    dcterms:description "Die karolingische Bildungsreform unter Karl dem Großen förderte die Verschriftung der deutschen Sprache und die Etablierung einer althochdeutschen und alt­sächsischen Literatur, indem sie die Ausbildung von Mönchen und die Übersetzung lateinischer Texte unterstützte. Durch diese Reform konnten religiöse Inhalte in der Volkssprache vermittelt werden, was zu einer Änderung des Wortschatzes führte, insbesondere durch die Einführung von Lehnwörtern und Neubildungen. Die Klöster spielten eine zentrale Rolle bei der Produktion dieser Literatur, wobei Fulda als wichtiger Ort für die Entstehung von Texten wie der Fuldaer Tatian-Bilingue und Otfrids Evangelienharmonie hervorzuheben ist."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "104X7uOcl8FNc" ;
    dcterms:subject <http://example.org/education/concept/Alkuin>,
        <http://example.org/education/concept/Althochdeutsche_Literatur>,
        <http://example.org/education/concept/Christianisierung>,
        <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Fr%C3%BChmittelalter>,
        <http://example.org/education/concept/Karl_der_Gro%C3%9Fe>,
        <http://example.org/education/concept/Karolingische_Renaissance>,
        <http://example.org/education/concept/Kloster_Fulda>,
        <http://example.org/education/concept/Lateinische_Literatur>,
        <http://example.org/education/concept/Missionierung> ;
    dcterms:title "Materialien zur Christianisierung des Wortschatzes in ahd. und vorahd. Zeit"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:10Ef_gAQisQI4 a edu:LearningResource ;
