        oer:7ohmtOd8ipAE,
        oer:7v8U2x8tGrOU ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Das Seminar \"Hansesprache oder Mittelniederdeutsch als Fremdsprache\" bietet eine Einführung in die historische Sprachstufe des Mittelniederdeutschen, einschließlich Graphemik, Phonemik, Morphologie, Wortschatz und Syntax. Durch die Lektüre relevanter Texte und die Erarbeitung diverser Textsorten sollen die Studierenden befähigt werden, mittelniederdeutsche Texte zu lesen, zu übersetzen und sprachlich zu analysieren. Zudem wird der sozial-, wirtschafts- und kulturhistorische Kontext des Mittelniederdeutschen anhand relevanter Textlektüre erschlossen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "109qEPikhJYmI" ;
    dcterms:subject <http://example.org/education/concept/Deutsch_als_Fremdsprache>,
        <http://example.org/education/concept/Deutsche_Sprachgeschichte>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Hansische_Sprache>,
        <http://example.org/education/concept/Historische_Linguistik>,
        <http://example.org/education/concept/Lexikographie>,
        <http://example.org/education/concept/Mittelniederdeutsch>,
        <http://example.org/education/concept/Niederdeutsche_Sprache>,
        <http://example.org/education/concept/Plattdeutsch>,
        <http://example.org/education/concept/Soziolinguistik> ;
    dcterms:title "Hansesprache, oder Mittelniederdeutsch als Fremdsprache"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:10Bfz_Hou3jLc a edu:LearningResource ;
    sim:similarTo oer:10EfPpzcdj6WM,
