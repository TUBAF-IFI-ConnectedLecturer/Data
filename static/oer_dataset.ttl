    dcterms:title "Lernbereiche Alte Geschichte und Geschlechtergeschichte"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:57D3J9D2YMcw a edu:LearningResource ;
    sim:similarTo oer:5T9BfmE3c3xU ;
