        <http://example.org/education/concept/Kreislauff%C3%A4higkeit>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Umweltauswirkungen> ;
    dcterms:title "Gebäudehülle Ökobilanz und Nachhaltigkeit"@de ;
