        <http://example.org/education/concept/Schule_in_der_Mediengesellschaft>,
        <http://example.org/education/concept/Synchrone_Kommunikation>,
        <http://example.org/education/concept/Webbasierte_Kommunikation> ;
    dcterms:title "Webbasierte Kommunikation und Kooperation in der Bildung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

