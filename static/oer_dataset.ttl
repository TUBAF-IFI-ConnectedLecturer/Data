oer:12sYOlCjC-qDc a edu:LearningResource ;
    sim:similarTo oer:4b0tP-j2v0vQ ;
    dcterms:creator <http://example.org/education/person/Herzog> ;
    dcterms:description "Dieses Dokument enthält eine Serie von Quizfragen und Antworten zum Thema Sequential Quadratic Programming (SQP), die für Studierende der Mathematik und Informatik konzipiert wurden. Durch das Durcharbeiten dieser Fragen können Lernende ihr Verständnis von SQP-Verfahren, Globalisierungstechniken und Nebenbedingungen verbessern. Die Quizfragen decken verschiedene Aspekte des Themas ab, darunter die Behandlung unzulässiger Quadratischer Programme, die Verwendung von Penalty-Ansätzen und die Beobachtung des Maratos-Effekts."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12sYOlCjC-qDc" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Globalisierungstechniken>,
        <http://example.org/education/concept/Lineare_Suche>,
        <http://example.org/education/concept/Maratos-Effekt>,
        <http://example.org/education/concept/Mathematische_Optimierung>,
        <http://example.org/education/concept/Nebenbedingungen>,
        <http://example.org/education/concept/Nichtlineare_Programmierung>,
        <http://example.org/education/concept/Quadratisches_Programm>,
        <http://example.org/education/concept/SQP-Verfahren>,
        <http://example.org/education/concept/Trust-Region>,
        <http://example.org/education/concept/Zielfunktion> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:13jQFuTNG_DLs a edu:LearningResource ;
    sim:similarTo oer:13lAzw9YsH5Io ;
    dcterms:creator <http://example.org/education/person/Gl%C3%BCck> ;
    dcterms:description "Dieses Material behandelt die grammatische Regelung des Kommasatzes und seine Anwendung in verschiedenen Sätzen. Durch das Studium dieser Regeln können Lernende ihr Verständnis der deutschen Grammatik verbessern und lernen, Kommas richtig zu setzen. Die Übungen und Beispiele helfen dabei, die Anwendung der Regeln in der Praxis zu veranschaulichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "13jQFuTNG_DLs" ;
