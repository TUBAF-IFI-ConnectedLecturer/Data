oer:44F-9ZemFTIY a edu:LearningResource ;
    sim:similarTo oer:4DPqH05YVs_w,
        oer:4IHazZ2OAgt0,
        oer:9nDWKL8herDI ;
    dcterms:creator <http://example.org/education/person/Delakowitz> ;
    dcterms:description "Das Umweltrecht umfasst eine Vielzahl von Gesetzen und Regelungen, die den Schutz der Umwelt und die Vermeidung von Umweltschäden zum Ziel haben. Durch das Studium dieser Materialien können Lernende ein grundlegendes Verständnis des Umweltrechts und seiner Instrumente erwerben, um wirksamere Umweltschutzmaßnahmen zu entwickeln und durchzusetzen. Insbesondere werden die Prinzipien des Verursacherprinzips, der direkten und indirekten Verhaltenssteuerung sowie die Bedeutung von Umweltinformationen und -planung behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "44F-9ZemFTIY" ;
    dcterms:subject <http://example.org/education/concept/Atomgesetz>,
        <http://example.org/education/concept/Bundesverfassungsgericht>,
        <http://example.org/education/concept/Energiepolitik>,
        <http://example.org/education/concept/Internationales_Umweltrecht>,
        <http://example.org/education/concept/Kreislaufwirtschaftsgesetz>,
        <http://example.org/education/concept/Supranationales_Umweltrecht>,
        <http://example.org/education/concept/Umwelthaftungsgesetz>,
        <http://example.org/education/concept/Umweltrecht>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/V%C3%B6lkerrecht> ;
    dcterms:title "Umweltrecht"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:44GAlFm3Xqq8 a edu:LearningResource ;
    sim:similarTo oer:4XvimtshZPvI,
        oer:57D3J9D2YMcw,
        oer:5T9BfmE3c3xU ;
    dcterms:creator <http://example.org/education/person/G%C3%B6hler> ;
    dcterms:description "Das Übungsblatt zur Vorlesung Datenbanksysteme an der Technischen Universität Freiberg enthält vier Aufgaben, die zum Ziel haben, die Konzepte von Entitäten und Beziehungen in einer Forschungsdatenbank zu vermitteln. Die Aufgaben umfassen die Beschreibung von Entitäten und Entitätsmengen, die Entwicklung eines EER-Diagramms für eine Forschungsdatenbank und die Verwendung von SQL-Anfragen. Durch das Bearbeiten dieser Aufgaben sollen die Lernenden ein Verständnis dafür entwickeln, wie Daten in einer Forschungsumgebung strukturiert und abgefragt werden können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "44GAlFm3Xqq8" ;
    dcterms:subject <http://example.org/education/concept/Datenbanksysteme>,
        <http://example.org/education/concept/Datenhaltung>,
        <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Entity-Relationship-Modell>,
        <http://example.org/education/concept/Forschungsdatenbank>,
        <http://example.org/education/concept/Hochschulforschung>,
        <http://example.org/education/concept/Informationsmanagement>,
        <http://example.org/education/concept/SQL>,
        <http://example.org/education/concept/Universit%C3%A4tsforschung>,
        <http://example.org/education/concept/Wissenschaftliches_Rechnen> ;
    dcterms:title "TECHNISCHE UNIVERSITÄT FREIBERG INSTITUT FÜR INFORMATIK"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:46sIT5FAKADE a edu:LearningResource ;
    sim:similarTo oer:4N7YRUOzk8oA ;
    dcterms:creator <http://example.org/education/person/Spekking> ;
    dcterms:description "Verteilte Systeme vermitteln dem Benutzer den Eindruck eines einzigen Computers, bestehen jedoch aus einer Sammlung voneinander unabhängiger Computer, die gemeinsam Ressourcen nutzen und kommunizieren können. Durch das Studium dieser Materialien erwerben Lernende Kenntnisse über die Definition, Klassifikation, Eigenschaften und Vorteile von verteilten Systemen sowie ihre Anwendung in der Praxis. Darüber hinaus werden Konzepte wie Zeitsynchronisation, Transparenz, ACID-Eigenschaften und Netzwerk-Betriebssysteme behandelt, um ein umfassendes Verständnis von verteilten Systemen zu vermitteln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "46sIT5FAKADE" ;
    dcterms:subject <http://example.org/education/concept/Computerarchitektur>,
        <http://example.org/education/concept/Datensynchronisation>,
        <http://example.org/education/concept/Netzwerktopologie>,
        <http://example.org/education/concept/Parallele_Datenverarbeitung>,
        <http://example.org/education/concept/Rechnerverbund>,
        <http://example.org/education/concept/Transaktionsverarbeitung>,
        <http://example.org/education/concept/Uhrzeitsysteme>,
        <http://example.org/education/concept/Verteilte_Datenbanken>,
        <http://example.org/education/concept/Verteilte_Systeme>,
        <http://example.org/education/concept/Zeit_synchronisation> ;
    dcterms:title "VERTEILTE ANWENDUNGEN - VERTEILTE SYSTEME"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

