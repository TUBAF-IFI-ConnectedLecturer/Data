oer:5nNBfPvziY5k a edu:LearningResource ;
    sim:similarTo oer:7OYT3mj5XbkU ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Diese Einführung in die germanistische Sprachwissenschaft behandelt Wortarten und Flexion am Beispiel eines literarischen Textes von Wolfram von Eschenbach. Durch die Analyse der Deklination von Artikel, Adjektiven, Substantiven und Pronomen können Lernende ihre Kenntnisse über die deutsche Grammatik erweitern. Das Tutorium bietet Übungsaufgaben zur Bestimmung von Wortarten und Flexionsformen, um die Fähigkeit zur sprachwissenschaftlichen Analyse zu verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5nNBfPvziY5k" ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Erz%C3%A4hlung>,
        <http://example.org/education/concept/Germanistische_Sprachwissenschaft>,
