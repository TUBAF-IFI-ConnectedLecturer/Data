        <http://example.org/education/concept/Metriken>,
        <http://example.org/education/concept/Software-Entwicklung>,
        <http://example.org/education/concept/Software-Qualit%C3%A4t>,
        <http://example.org/education/concept/Telemetrie>,
        <http://example.org/education/concept/Testen> ;
    dcterms:title "Kein Titel gefunden."@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

