oer:5ySw59JFdyX4 a edu:LearningResource ;
    sim:similarTo oer:6-TtE0KDtg50,
        oer:66BFD588LBO4,
        oer:6CRJOBIRXuzc,
        oer:8DIYsTEB-vPQ,
        oer:8EVQufcxbKck,
        oer:8OzHVRGQE5Q8,
        oer:8Vy--T0Sbb2I ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Grenzflächenphänomene\" behandelt die Stabilität von kolloidalen Dispersionen und ihre Beeinflussung durch verschiedene Faktoren wie pH-Wert, Salzgehalt und Oberflächeneigenschaften. Durch das Verständnis dieser Phänomene können Learner Methoden zur Stabilisierung oder Destabilisierung von Dispersionen entwickeln und anwenden. Die Vorlesung bietet eine umfassende Einführung in die Theorie und Praxis der kolloidalen Chemie und vermittelt Kenntnisse über die Charakterisierung und Steuerung von Dispersionseigenschaften."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5ySw59JFdyX4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Dispersionen>,
        <http://example.org/education/concept/Flockung>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenph%C3%A4nomene>,
        <http://example.org/education/concept/Koagulation>,
        <http://example.org/education/concept/Kolloide>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Stabilit%C3%A4t>,
        <http://example.org/education/concept/Suspensionsstabilit%C3%A4t>,
        <http://example.org/education/concept/Verfahrenstechnik>,
        <http://example.org/education/concept/Zetapotenzial> ;
    dcterms:title "Fakultät Maschinenwesen Institut für Verfahrenstechnik und Umwelttechnik, AG Mechanische Verfahrenstechnik Lehrveranstaltung Grenzflächenphänomene Folien zur Vorlesung PD Dr.-Ing. habil. Frank Babick, 1. April 2025"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:7JC4PIjQU7QQ a edu:LearningResource ;
    sim:similarTo oer:8OzHVRGQE5Q8 ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Diese Formelsammlung bietet eine umfassende Übersicht über die Darstellung von Partikelgrößenverteilungen und ihre Anwendung in der Verfahrenstechnik und Naturstofftechnik. Durch das Studium dieser Materialien können Lernende wichtige Verteilungsparameter wie Medianwert, Mittelwert und Streuung berechnen und verschiedene Verteilungsfunktionen wie die RRSB-Verteilung, Potenzverteilung und Logarithmische Normalverteilung anwenden. Zudem werden effektive Partikelmerkmale und Sauterdurchmesser erläutert, um die Charakterisierung von Partikeln zu ermöglichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7JC4PIjQU7QQ" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Korngr%C3%B6%C3%9Fenverteilung>,
        <http://example.org/education/concept/Mathematische_Modellierung>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Naturstofftechnik>,
        <http://example.org/education/concept/Oberfl%C3%A4cheneigenschaften>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fenverteilung>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Teilchengr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Verfahrenstechnik>,
        <http://example.org/education/concept/Verteilungsfunktion> ;
    dcterms:title "Formelsammlung Einführung in die Verfahrenstechnik und Naturstofftechnik 11 - MVT TU Dresden, AG Mechanische Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

