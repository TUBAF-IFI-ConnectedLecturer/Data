        <http://example.org/education/concept/Rechner>,
        <http://example.org/education/concept/Switches> ;
    dcterms:title "Ausgewählte Aspekte Arbeitsblatt Filius von 2"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5ksS4AR5cvJ4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Dressen> ;
    dcterms:description "Dieses Dokument behandelt die Geschichte der französischen Könige vom Haus Valois-Orléans, insbesondere Louis XI., Charles VIII., Louis XII., Francois I., Henri II., Francois II., Charles IX und Henri III. Es beschreibt ihre Regierungszeiten, politischen Ereignisse und künstlerischen Errungenschaften, wie die Entwicklung der Architektur, Malerei und Skulptur in Frankreich während dieser Zeit. Durch das Studium dieses Dokuments können Lernende Einblick in die Geschichte Frankreichs und die Kunst des 15."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5ksS4AR5cvJ4" ;
    dcterms:subject <http://example.org/education/concept/Fontainebleau>,
        <http://example.org/education/concept/Frankreich>,
        <http://example.org/education/concept/Franz%C3%B6sische_K%C3%B6nige>,
        <http://example.org/education/concept/Geschichte>,
        <http://example.org/education/concept/Haus_Valois-Orl%C3%A9ans>,
        <http://example.org/education/concept/Italienischer_Manierismus>,
        <http://example.org/education/concept/Kunst_des_16._Jahrhunderts>,
        <http://example.org/education/concept/Portr%C3%A4tmalerei>,
        <http://example.org/education/concept/Renaissance-Architektur>,
        <http://example.org/education/concept/Schlossbau> ;
    dcterms:title "Frankreich - Geschichte Französische Könige, Haus Valois-Orléans"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:5msBEerbleEg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schwarzl%C3%A4nder>,
        <http://example.org/education/person/van_der_Burgt> ;
    dcterms:description "Die vorliegenden Arbeiten befassen sich mit dem Schloss Übigau und seiner Umgebung, insbesondere hinsichtlich seiner historischen Entwicklung, Architektur und möglichen Nutzung als Naherholungsgebiet. Die Studien umfassen Untersuchungen zur sächsischen Architektur der Spätgotik, Analysen und Vorschläge zur sozialistischen Umgestaltung sowie Dokumentationen und Nutzungskonzepte für das UNESCO-Weltkulturerbe Dresdner Elbtal. Durch die Lektüre dieser Arbeiten können Leser Einblicke in die Geschichte und Bedeutung des Schlosses Übigau gewinnen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "5msBEerbleEg" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Architektur_der_Sp%C3%A4tgotik>,
        <http://example.org/education/concept/Denkmalschutz>,
        <http://example.org/education/concept/Gartenbau>,
        <http://example.org/education/concept/Kulturdenkmal>,
        <http://example.org/education/concept/Landschaftsarchitektur>,
        <http://example.org/education/concept/Naherholungsgebiet>,
        <http://example.org/education/concept/Schloss_%C3%9Cbigau>,
        <http://example.org/education/concept/Stadtbau>,
        <http://example.org/education/concept/UNESCO-Weltkulturerbe>,
        <http://example.org/education/concept/s%C3%A4chsische_Geschichte> ;
    dcterms:title "Schloss Übigau"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

