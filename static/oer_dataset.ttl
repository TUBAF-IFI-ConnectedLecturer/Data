        <http://example.org/education/concept/Pr%C3%A4positionalphrasen>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Sprachwissenschaft>,
        <http://example.org/education/concept/Syntaktische_Struktur>,
        <http://example.org/education/concept/Syntax> ;
    dcterms:title "UE Einführung in die germanistische Sprachwissenschaft WiSe 2024/25"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

