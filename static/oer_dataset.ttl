        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Verteilungsfunktionen>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie> ;
    dcterms:title "Lernpaket SI Statistik und Isolationskoordination 2"@de ;
