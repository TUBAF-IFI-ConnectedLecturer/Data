oer:6H84CgJqr25g a edu:LearningResource ;
    sim:similarTo oer:6qMxqVCkdyG0,
        oer:6xB6V0b_FnqU ;
    dcterms:creator <http://example.org/education/person/Rudolph> ;
    dcterms:description "Die Lehrveranstaltung behandelt die Messung an Partikelsystemen und umfasst Themen wie Filmflotation, Flüssigkeitspenetration in Partikelbett und Benetzung. Die Studierenden erwerben Kenntnisse über verschiedene Methoden zur Analyse von Partikelsystemen und lernen, diese auf praktische Fragestellungen anzuwenden. Durch die Vorlesung werden sie in die Lage versetzt, komplexe Phänomene in der Grenzflächenverfahrenstechnik zu verstehen und zu interpretieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6H84CgJqr25g" ;
    dcterms:subject <http://example.org/education/concept/Adh%C3%A4sion>,
        <http://example.org/education/concept/Benetzung>,
        <http://example.org/education/concept/Filmflotation>,
        <http://example.org/education/concept/Fl%C3%BCssigkeitspenetration>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenverfahrenstechnik>,
        <http://example.org/education/concept/Koh%C3%A4sion>,
        <http://example.org/education/concept/Kohle>,
        <http://example.org/education/concept/Oberfl%C3%A4chenoxidation>,
        <http://example.org/education/concept/Partikelbett>,
        <http://example.org/education/concept/Partikelmesstechnik> ;
    dcterms:title "Inhalt der Lehrveranstaltung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6PCMIu7vmYfQ a edu:LearningResource ;
    sim:similarTo oer:6SbfdtjSJ9ZQ,
        oer:6vvlXqU34VnQ,
        oer:85M8FjBUVuFM,
        oer:8WYgyHtinpLI,
        oer:8rybEwm-LPLk,
        oer:9-5x0ORImi7s ;
    dcterms:creator <http://example.org/education/person/Hofmann> ;
    dcterms:description "Die Vorlesung behandelt die Themen e-Learning, Webbasierte Kooperation und Kommunikation, sowie didaktische Einordnung von Kollaboration und Kooperation. Durch die Lektüre dieser Materialien können Lernende ein Verständnis dafür entwickeln, wie sie webbasierte Werkzeuge für die Zusammenarbeit und Kommunikation in Bildungsszenarien nutzen können. Sie lernen außerdem, verschiedene Arten von Webbasierten Kooperationswerkzeugen wie Wikis, Foren, Blogs und Chat-Systemen zu klassifizieren und einzusetzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6PCMIu7vmYfQ" ;
