    dcterms:creator <http://example.org/education/person/Engel>,
        <http://example.org/education/person/Konrad>,
        <http://example.org/education/person/Weber> ;
    dcterms:description "Die Zugänglichkeit von Grafiken für Menschen mit Blindheit und Sehbehinderung ist ein wichtiger Aspekt der Barrierefreiheit, um eine gleichberechtigte Teilhabe an Bildung, sozialen Bereichen und Kultur zu ermöglichen. Durch die Verwendung von alternativen Darstellungsformen wie taktiler Grafiken oder Bildbeschreibungen können Menschen mit Seheinschränkungen auf Inhalte zugreifen, die sonst für sie unzugänglich wären. Die Anwendung von Richtlinien und Best Practices für die Erstellung barrierefreier Grafiken kann dazu beitragen, dass Menschen mit Behinderung besser integriert werden können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6vYb3ruFj4y0" ;
    dcterms:subject <http://example.org/education/concept/Alternativtexte>,
        <http://example.org/education/concept/Barrierefreiheit>,
        <http://example.org/education/concept/Bildbeschreibungen>,
        <http://example.org/education/concept/Braille-Druck>,
        <http://example.org/education/concept/Grafiken>,
        <http://example.org/education/concept/Pr%C3%A4gedruck>,
        <http://example.org/education/concept/Schwellpapier>,
        <http://example.org/education/concept/Taktile_Grafiken>,
        <http://example.org/education/concept/Web-Accessibility>,
        <http://example.org/education/concept/Zug%C3%A4nglichkeit> ;
    dcterms:title "Zugängliche Grafiken und Bildbeschreibungen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6xB6V0b_FnqU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Rudolph> ;
    dcterms:description "Die Vorlesung Grenzflächenverfahrenstechnik I behandelt Struktur-Eigenschaftsbeziehungen von fest-flüssig und fluiden Grenzflächen sowie deren Modifizierung und Charakterisierung, um die Effektivität und Selektivität von Trennverfahren zu erhöhen. Durch die Vorlesung sollen Studierende Kenntnisse über die wissenschaftlichen Grundlagen von Benetzung und kapillarem Flüssigkeitstransport in Porensystemen erwerben. Die Lehrveranstaltung umfasst 150 Stunden, davon 45 Stunden Präsenzzeit und 105 Stunden Selbststudium."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6xB6V0b_FnqU" ;
    dcterms:subject <http://example.org/education/concept/Benetzung>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenverfahrenstechnik>,
        <http://example.org/education/concept/Interface_Science>,
        <http://example.org/education/concept/Kapillarit%C3%A4t>,
        <http://example.org/education/concept/Kolloidchemie>,
        <http://example.org/education/concept/Oberfl%C3%A4chenspannung>,
        <http://example.org/education/concept/Partikel-Fluid-Grenzfl%C3%A4chen>,
        <http://example.org/education/concept/Physikalisch-chemische_Grundlagen>,
        <http://example.org/education/concept/Ressourcentechnologie>,
        <http://example.org/education/concept/Trennverfahren> ;
    dcterms:title "Einführung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:7-p5vgbhqc7w a edu:LearningResource ;
    dcterms:description "Die Studie untersucht den Einfluss von Need for Cognition (NFC) auf das Entscheidungsverhalten im Iowa Gambling Task und zeigt, dass Personen mit hoher NFC besser performen als jene mit niedriger NFC. Die Ergebnisse haben Implikationen für die Forschung zu individuellen Unterschieden in der Entscheidungsfindung und können dazu beitragen, die zugrunde liegenden Prozesse bei der IGT-Leistung zu erklären. Durch diese Studie können Lernende Einblicke in die Zusammenhänge zwischen NFC und Entscheidungsverhalten gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7-p5vgbhqc7w" ;
    dcterms:subject <http://example.org/education/concept/Entscheidungsfindung>,
        <http://example.org/education/concept/Entscheidungstheorie>,
        <http://example.org/education/concept/Experimentalpsychologie>,
        <http://example.org/education/concept/Iowa-Gambling-Task>,
        <http://example.org/education/concept/Kognition>,
        <http://example.org/education/concept/Kognitive_Psychologie>,
        <http://example.org/education/concept/Need-for-Cognition-Pers%C3%B6nlichkeitseigenschaft>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitspsychologie>,
        <http://example.org/education/concept/Sozialpsychologie>,
        <http://example.org/education/concept/Verhaltensforschung> ;
    dcterms:title "ES Experimentalpsychologisches Arbeiten 2. FS 28.04.2025 Folie 7 Messung und Ablauf -Need for Cognition"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:7alLlsoIrNso a edu:LearningResource ;
