    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik für Verkehrsingenieure mit Schwerpunkt auf den Schienenverkehr und deckt Grundlagen wie Fahrwiderstandskräfte, Antriebskräfte und Traktionsvermögen ab. Durch die Lektüre dieser Materialien können Studierende die grundlegenden Konzepte der Fahrzeitberechnung und die verschiedenen Lösungsansätze für die Fahrzeitermittlung verstehen. Darüber hinaus werden praxisnahe Beispiele und Kennlinienfelder vorgestellt, um die Anwendung dieser Konzepte in der Praxis zu veranschaulichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4KpvS0vlvVnI" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Antriebskr%C3%A4fte>,
        <http://example.org/education/concept/Fahrwiderstandskr%C3%A4fte>,
        <http://example.org/education/concept/Fahrzeitberechnung>,
        <http://example.org/education/concept/Fahrzeugausschreibung>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Leistungs-_und_Energiebedarf>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Traktionsverm%C3%B6gen>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Fahrdynamik für Verkehrsingenieure Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

