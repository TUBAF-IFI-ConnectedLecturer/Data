oer:10AjHvTE_LUsE a edu:LearningResource ;
    sim:similarTo oer:8Te34r526VVU ;
    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Das Lerntagebuch Fahrdynamik unterstützt Studierende bei der strukturierten Arbeit im Fach Fahrdynamik und ermöglicht es ihnen, Woche für Woche ihren Lernfortschritt zu protokollieren und ihren Lernprozess zu reflektieren. Durch die Nutzung dieses Werkzeugs können sie wichtige Erkenntnisse festhalten, offene Fragen notieren und diese dann mit anderen Studierenden oder im Rahmen von Konsultationen diskutieren. Das Lerntagebuch umfasst sieben Wochen und bietet Raum für die Dokumentation von thematischen Schwerpunkten, Erkenntnissen, Fragen und Übungen im Fach Fahrdynamik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10AjHvTE_LUsE" ;
    dcterms:publisher <http://example.org/education/organization/Friedrich_List_Institut_F%C3%BCr_Bahnfahrzeuge_Und_Bahntechnik> ;
    dcterms:subject <http://example.org/education/concept/Bahnfahrzeuge>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrzeugkonstruktion>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Schienenverkehr>,
