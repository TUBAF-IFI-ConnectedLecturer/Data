    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Partikelmesstechnik\" behandelt die Struktur und Eigenschaften von Partikeln und Aggregaten, einschließlich ihrer Größe, Form, Porosität und Dispersion. Durch das Studium dieser Materialien können Lernende die grundlegenden Konzepte der Partikelmesstechnik verstehen und anwenden, um die Eigenschaften von Partikeln zu beschreiben und ihre Verhaltensweise in verschiedenen Systemen vorherzusagen. Die Vorlesung deckt auch die wichtigsten Methoden zur Charakterisierung von Partikeln ab, einschließlich der Lichtstreuung, Siebmaschenanalyse und Röntgenstreumethoden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "561qmu8RWCmg" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen> ;
    dcterms:subject <http://example.org/education/concept/%C3%84quivalentdurchmesser>,
        <http://example.org/education/concept/Aggregat>,
        <http://example.org/education/concept/Dispersit%C3%A4t>,
        <http://example.org/education/concept/Feinheitsmerkmal>,
        <http://example.org/education/concept/Fraktale_Geometrie>,
        <http://example.org/education/concept/Korrelation_von_%C3%84quivalentdurchmessern>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Partikelmesstechnik>,
        <http://example.org/education/concept/Struktur_von_Partikelagglomeraten> ;
    dcterms:title "Folie 43 LV: Partikelmesstechnik Frank Babick, AG Mechanische Verfahrenstechnik, 2024"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

