oer:10lLxuKEhCXy4 a edu:LearningResource ;
    dcterms:description "Sexualität ist ein zentraler Aspekt des menschlichen Lebens und hat direkte und indirekte Auswirkungen auf viele Bereiche des Zusammenlebens. Durch die Lektüre dieses Dokuments können Lernende Einblicke in die Entwicklung von Sexualität, Aggression und Gewalt gewinnen, sowie Risikofaktoren für sexuellen Missbrauch erkennen und Strategien zur Prävention und Intervention kennenlernen. Darüber hinaus werden sie über die Akzeptanz von gleichgeschlechtlichen sexuellen Orientierungen und die Veränderungen im Sexualverhalten in verschiedenen Altersgruppen informiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10lLxuKEhCXy4" ;
    dcterms:publisher <http://example.org/education/organization/USEB_HS_Zittau> ;
    dcterms:subject <http://example.org/education/concept/Aggression>,
        <http://example.org/education/concept/Jugendsexualit%C3%A4t>,
        <http://example.org/education/concept/Menschliche_Sexualit%C3%A4t>,
        <http://example.org/education/concept/Sexualaufkl%C3%A4rung>,
        <http://example.org/education/concept/Sexualit%C3%A4t>,
        <http://example.org/education/concept/Sexualverhalten>,
        <http://example.org/education/concept/Sexuelle_Gesundheit>,
        <http://example.org/education/concept/Sexuelle_Gewalt>,
        <http://example.org/education/concept/Sexuelle_Orientierung>,
        <http://example.org/education/concept/Sexuelle_Zufriedenheit> ;
    dcterms:title "Sexualität und Aggression"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:10mVhqarTc4tI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/G%C3%B6hler> ;
    dcterms:description "Die Gärtnerei von Frau Romina Vigora bietet eine Vielzahl an Pflanzen und Dienstleistungen an, darunter Blumen, Obst- und Zierbäume, Heckenpflanzen sowie Gestecke und Blumenensemble. Die Angestellten sind gelernte Gärtner, wobei nur einige berechtigt sind, Verkäufe durchzuführen und das Computersystem zu bedienen. Durch die Lektüre dieses Dokuments können Leser Einblick in die Organisation und Angebote einer kleinen Gärtnerei gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10mVhqarTc4tI" ;
    dcterms:subject <http://example.org/education/concept/Blumen>,
        <http://example.org/education/concept/G%C3%A4rtnerei>,
        <http://example.org/education/concept/Gartenbau>,
        <http://example.org/education/concept/Gestecke>,
        <http://example.org/education/concept/Heckenpflanzen>,
        <http://example.org/education/concept/Kostenvoranschlag>,
        <http://example.org/education/concept/Lieferservice>,
        <http://example.org/education/concept/Obstb%C3%A4ume>,
        <http://example.org/education/concept/Pflanzenhandel>,
        <http://example.org/education/concept/Zierpflanzen> ;
    dcterms:title "Eine kleine Gärtnerei"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10mb7zSZPYMCA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Ertl-Schmuck> ;
    dcterms:description "Das erkenntnistheoretische Wissenschaftsmodell nach Schurz beschreibt die Ziele und Kriterien wissenschaftlichen Arbeitens, um möglichst wahre und gehaltvolle Aussagen über einen bestimmten Gegenstandsbereich zu treffen. Durch die Anwendung dieses Modells auf ein Beispiel wie die Existenz von Herrn Müllers Schmerzen werden die grundlegenden Prinzipien wissenschaftlicher Forschung verdeutlicht. Lernende gewinnen Einblick in die erkenntnistheoretischen Grundannahmen und Kriterien, die für eine sachliche und wahrheitsgemäße wissenschaftliche Arbeit erforderlich sind."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "10mb7zSZPYMCA" ;
    dcterms:publisher <http://example.org/education/organization/UTB> ;
    dcterms:subject <http://example.org/education/concept/Empirie>,
        <http://example.org/education/concept/Erkenntnistheorie>,
        <http://example.org/education/concept/Forschungsmethoden>,
        <http://example.org/education/concept/Gesundheitswissenschaften>,
        <http://example.org/education/concept/Objektivit%C3%A4t>,
        <http://example.org/education/concept/Pflegewissenschaften>,
        <http://example.org/education/concept/Schmerzforschung>,
        <http://example.org/education/concept/Wahrheit>,
        <http://example.org/education/concept/Wissenschaftliches_Arbeiten>,
        <http://example.org/education/concept/Wissenschaftstheorie> ;
    dcterms:title "Wissenschaftliches Arbeiten in Gesundheit und Pflege."@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

