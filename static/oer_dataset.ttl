oer:32AdYV6jW83Y a edu:LearningResource ;
    sim:similarTo oer:3AzaXlIVpLUw,
        oer:466PISKEwDng,
        oer:4ZjFF_hT8QvU,
        oer:4lfeiBfqAgqw,
        oer:4pjErgOWPj5Q,
