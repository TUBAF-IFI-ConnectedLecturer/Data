        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Lernplattformen>,
        <http://example.org/education/concept/Online-Lernen>,
        <http://example.org/education/concept/Virtuelle_Lernumgebung> ;
    dcterms:title "Didaktische Einordnung Komponenten einer VLU Lernplattform Moodle Lernplattform OPAL"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:4jfYewQwSQmM a edu:LearningResource ;
    sim:similarTo oer:4ko3QE49jYdg,
        oer:4lvgNyiQru0A,
        oer:4s5rjx7TwmsM,
        oer:4xLlXpAKVJEg,
        oer:4z6_uKTz7bCQ,
        oer:6VPE2ibB07gs ;
    dcterms:creator <http://example.org/education/person/Brandt> ;
    dcterms:description "Die Entwicklung des Zahlbegriffs wird von der Archaischen Arithmetik bis hin zur modernen Mathematik dargestellt, wobei die verschiedenen Stufen der Zahlenrepräsentation und -verarbeitung erläutert werden. Durch das Studium dieser Materialien können Lernende ein tieferes Verständnis davon gewinnen, wie Menschen und Tiere Zahlen wahrnehmen und verarbeiten, sowie wie sich der Zahlbegriff im Laufe der Geschichte entwickelt hat. Darüber hinaus werden die Grundlagen für eine erfolgreiche mathematische Bildung gelegt, indem die Lernenden die verschiedenen Aspekte der Zahlenrepräsentation und -verarbeitung verstehen lernen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4jfYewQwSQmM" ;
    dcterms:subject <http://example.org/education/concept/Arithmetik>,
        <http://example.org/education/concept/Didaktik_der_Mathematik>,
        <http://example.org/education/concept/Entwicklungspsychologie>,
        <http://example.org/education/concept/Grundschuldidaktik>,
        <http://example.org/education/concept/Kulturhistorische_%C3%9Cberlegungen>,
        <http://example.org/education/concept/Mathematikgeschichte>,
        <http://example.org/education/concept/Mathematische_F%C3%A4higkeiten>,
        <http://example.org/education/concept/Mengenverh%C3%A4ltnis>,
        <http://example.org/education/concept/Zahlbegriff>,
        <http://example.org/education/concept/Zahlenwahrnehmung> ;
    dcterms:title "Didaktik der Arithmetik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:4kg0nCX4Z3qY a edu:LearningResource ;
    sim:similarTo oer:4s5EobLvPAyc,
        oer:5hPDLklptp3Y,
        oer:73V_zpnDsjpQ,
        oer:8koB23KAn9TA,
        oer:9Uj0o7iBlhng,
