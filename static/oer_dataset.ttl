oer:7NLZZwOUrmF4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Scheffel> ;
    dcterms:description "Die Potenzialdiagnostik umfasst die Erfassung interindividueller Unterschiede im Verhalten und Erleben sowie intraindividuelle Merkmale und Veränderungen, um hinlänglich präzise Vorhersagen künftigen Verhaltens und Erlebens zu ermöglichen. Durch das Studium dieser Materialien können Lernende Kenntnisse über Strukturtheorien der Intelligenz verfestigen und anforderungsbezogen Intelligenztheorien auswählen und hinsichtlich Tauglichkeit bewerten können. Zudem werden sie in die Lage versetzt, berufsrelevante Persönlichkeitsaspekte zu erfassen und Vorhersagen von Schul- und Berufserfolg zu treffen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7NLZZwOUrmF4" ;
    dcterms:subject <http://example.org/education/concept/Akademische_Intelligenz>,
        <http://example.org/education/concept/Berufserfolg>,
        <http://example.org/education/concept/Differentielle_Psychologie>,
        <http://example.org/education/concept/Intelligenzkonstrukte>,
        <http://example.org/education/concept/Intelligenztheorien>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitspsychologie>,
        <http://example.org/education/concept/Potenzialdiagnostik>,
        <http://example.org/education/concept/Schulischer_Erfolg>,
        <http://example.org/education/concept/Strukturtheorien>,
        <http://example.org/education/concept/Vorhersageverfahren> ;
    dcterms:title "S.PP. 08 Anwendungsbereich Potenzialdiagnostik: Intelligenztheorien Differentielle und Persönlichkeitspsychologie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:7UMr_ri12lj8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Denecke>,
        <http://example.org/education/person/Volkland> ;
    dcterms:description "Das Kooperationsprojekt Career Service und Zentrum für Weiterbildung bietet eine Anleitung zum Zeitmanagement, um Studierenden zu helfen, ihre Aufgaben effektiv zu priorisieren und zu organisieren. Durch die Verwendung von Methoden wie der Eisenhower-Methode und der ABC-Analyse können sie ihre Zeit besser planen und nutzen. Dadurch sollen sie in der Lage sein, ihre Ziele zu erreichen und ihre Produktivität zu steigern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7UMr_ri12lj8" ;
    dcterms:subject <http://example.org/education/concept/ABC-Analyse>,
        <http://example.org/education/concept/ALPEN-Methode>,
        <http://example.org/education/concept/Aufgabenpriorisierung>,
        <http://example.org/education/concept/Effizienzsteigerung>,
        <http://example.org/education/concept/Eisenhower-Methode>,
        <http://example.org/education/concept/Selbstorganisation>,
        <http://example.org/education/concept/Selbstreflexion>,
        <http://example.org/education/concept/Zeitmanagement>,
        <http://example.org/education/concept/Zeitplanung>,
        <http://example.org/education/concept/Zielsetzung> ;
    dcterms:title "Kooperationsprojekt Career Service und Zentrum für Weiterbildung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7Ws7c0QKh57E a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Dietze>,
        <http://example.org/education/person/Dropp>,
        <http://example.org/education/person/Luther> ;
    dcterms:description "Schülerinnen und Schüler lernen die Grundlagen der Sicherheit von Informationen, indem sie Schutzziele wie Vertraulichkeit, Integrität, Authentizität und Verbindlichkeit kennenlernen und anwenden. Sie erfahren, wie sie alltägliche Situationen zuordnen und kreative Lösungen finden können, um die Sicherheit ihrer Informationen zu gewährleisten. Durch die Arbeit mit verschiedenen Verschlüsselungsverfahren und -methoden entwickeln sie ein Verständnis für die Notwendigkeit von Sicherheitsmaßnahmen im Umgang mit Informationen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7Ws7c0QKh57E" ;
    dcterms:subject <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Datensicherheit>,
        <http://example.org/education/concept/IT-Sicherheit>,
