oer:10oo-6nMvzJOs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Strischakowa> ;
    dcterms:description "Die Klausur behandelt zwei Fälle zum Jugendmedienschutz und Völkermord, in denen die richtigen Entscheidungen getroffen werden müssen. Durch die Bearbeitung dieser Fälle können Studierende ihr Wissen über den Jugendmedienschutz-Staatsvertrag und das deutsche Völkerstrafgesetzbuch erweitern und lernen, wie sie komplexe juristische Fragestellungen analysieren und lösen. Die Fälle bieten eine Gelegenheit, die Anwendung von Gesetzen und Verträgen in verschiedenen Kontexten zu üben und zu vertiefen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10oo-6nMvzJOs" ;
    dcterms:subject <http://example.org/education/concept/Ethnische_Minderheiten>,
        <http://example.org/education/concept/Fernsehen>,
        <http://example.org/education/concept/Gewaltverbrechen>,
        <http://example.org/education/concept/Jugendmedienschutz>,
        <http://example.org/education/concept/Kinder-_und_Jugendschutz>,
        <http://example.org/education/concept/Medienaufsicht>,
        <http://example.org/education/concept/Menschenrechte>,
        <http://example.org/education/concept/Rundfunkrecht>,
        <http://example.org/education/concept/Strafgesetzbuch>,
        <http://example.org/education/concept/V%C3%B6lkermord> ;
    dcterms:title "Klausur Methodenlehre"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10pfJWI9s0yRU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Fritsche>,
        <http://example.org/education/person/Kaden>,
        <http://example.org/education/person/Mehlhorn> ;
    dcterms:description "Das Materialpaket \"Lernumgebung zum Erstellen eines Stop-Motion-Films\" behandelt das Thema \"Kleidungsproblem\" und unterstützt Schüler bei der Entwicklung kombinatorischer Fähigkeiten durch die Lösung von Aufgaben und dem Erstellen eines Stop-Motion-Films. Durch die Bearbeitung des Materials können Lernende ihre Fähigkeiten in der Kombinatorik verbessern und erfahren, wie sie komplexe Probleme strukturiert lösen können. Das Paket enthält Arbeitsblätter, Tipp-Karten, Legematerialien und eine Storyboard-Vorlage, um die Erstellung eines Stop-Motion-Films zu unterstützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10pfJWI9s0yRU" ;
    dcterms:subject <http://example.org/education/concept/Filmproduktion>,
        <http://example.org/education/concept/Kleidung>,
        <http://example.org/education/concept/Kombinatorik>,
        <http://example.org/education/concept/Kreativit%C3%A4t>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Medienp%C3%A4dagogik>,
        <http://example.org/education/concept/Mode>,
        <http://example.org/education/concept/Probleml%C3%B6sen>,
        <http://example.org/education/concept/Stop-Motion-Technik>,
        <http://example.org/education/concept/Unterrichtsmaterialien> ;
    dcterms:title "Materialpaket LERNUMGEBUNG ZUR ERSTELLUNG EINES STOP-MOTION-FILMS"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10qdalirNFuRA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Dugge> ;
    dcterms:description "Die Frametraxx UG bietet den Titel \"Moves\" kostenlos für gewerbliche und private Nutzung an, ohne zeitliche Begrenzung. Die Nutzung ist jedoch an bestimmte Bedingungen geknüpft, wie das Verbot des Wiederverkaufs und Remasterings zum Wiederverkauf. Durch die Einhaltung dieser Regeln unterstützen Nutzer das Angebot an kostenlose Musik und schützen sich vor Nachfragen der GEMA."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10qdalirNFuRA" ;
    dcterms:subject <http://example.org/education/concept/GEMA>,
        <http://example.org/education/concept/Lizenzbedingungen>,
        <http://example.org/education/concept/Musik>,
        <http://example.org/education/concept/Musikdownload>,
        <http://example.org/education/concept/Musiklizenz>,
        <http://example.org/education/concept/Musiknutzung>,
        <http://example.org/education/concept/Musikverwertung>,
        <http://example.org/education/concept/Online-Musik>,
        <http://example.org/education/concept/Urheberrecht>,
        <http://example.org/education/concept/kostenlose_Musik> ;
    dcterms:title "Moves"@de ;
    dcterms:type <http://example.org/education/type/Sonstiges> .

oer:10r84WGCXLFiA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Stieler> ;
    dcterms:description "Das Lehrmaterial behandelt die Funktionsweise von Teilchendetektoren an Beschleunigern, insbesondere den ATLAS-Detektor am CERN. Es vermittelt grundlegende Konzepte der Teilchenphysik und Kernphysik, wie die Identifizierung von Teilchen, ihre Wechselwirkung mit Materie und die Messung ihrer Eigenschaften. Durch das Studium dieses Materials können Lernende ein Verständnis dafür entwickeln, wie moderne Teilchendetektoren funktionieren und welche physikalischen Prinzipien dahinter stehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10r84WGCXLFiA" ;
    dcterms:subject <http://example.org/education/concept/Detektoren>,
        <http://example.org/education/concept/Elementarteilchen>,
        <http://example.org/education/concept/Hadronen>,
        <http://example.org/education/concept/Hochenergiephysik>,
        <http://example.org/education/concept/Kalorimeter>,
        <http://example.org/education/concept/Kernphysik>,
        <http://example.org/education/concept/Magnetfelder>,
        <http://example.org/education/concept/Strahlungsdetektion>,
        <http://example.org/education/concept/Teilchenbeschleuniger>,
        <http://example.org/education/concept/Teilchenphysik> ;
    dcterms:title "Detektoren an Teilchenbeschleunigern VL Teilchen- u. Kernphsik für Lehramt (WiSe 2223)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

