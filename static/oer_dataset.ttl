oer:6hJFFtycDBTk a edu:LearningResource ;
    sim:similarTo oer:6iB0i5lbHYLk,
        oer:6rWOJ3riygiM,
        oer:8H-WE8siCMVI,
        oer:8T6UxODlwsgk,
        oer:8_9_0PKw9m88 ;
    dcterms:creator <http://example.org/education/person/Hofmann> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Computergrafik, insbesondere Pixel- und Vektorgrafiken, sowie Farbmodelle und Dateiformate. Durch das Studium dieser Inhalte können Lernende die Unterschiede zwischen verschiedenen Grafikarten verstehen, die Eigenschaften von Vektor- und Pixelgrafiken erkennen und wissen, wann welche Art von Grafik verwendet werden sollte. Zudem erfahren sie über die verschiedenen Farbmodelle und ihre Anwendungsbereiche in der Computergrafik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6hJFFtycDBTk" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
