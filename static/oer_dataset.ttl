oer:6DLbEMoLDmBk a edu:LearningResource ;
    sim:similarTo oer:9lrPcoBDQBNs ;
    dcterms:creator <http://example.org/education/person/Fricke> ;
    dcterms:description "Diese historische Entwicklung der Eisenbahn beschreibt wichtige Meilensteine und Ereignisse von 1804 bis 2007, einschließlich der Entwicklung von Lokomotiven, Wagen und Bremsen. Durch das Studium dieser Geschichte können Lernende die Entstehung und Verbesserung von Eisenbahntechnologien verstehen und die Bedeutung von Pionieren wie George Stephenson und Richard Trevithick erkennen. Die Darstellung der historischen Entwicklung unterstützt das Verständnis der Grundlagen der Eisenbahn und ihrer technischen Evolution."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6DLbEMoLDmBk" ;
    dcterms:subject <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Eisenbahn>,
        <http://example.org/education/concept/Eisenbahngeschichte>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Geschichte_der_Technik>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Verkehrswesen> ;
    dcterms:title "Grundlagen Sft: 3. Historische Entwicklung Folie Historischer Abriss"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6EJ07SxHM1iM a edu:LearningResource ;
    sim:similarTo oer:6d5aKAHoUDzI,
        oer:7-azt_sjmU6M,
        oer:76_jpFfzixG4 ;
    dcterms:creator <http://example.org/education/person/Jarosch>,
        <http://example.org/education/person/Remtisch> ;
    dcterms:description "Das Arbeitsblatt bietet Hilfestellungen und Aufgaben für die Erstbenutzung von Snap und Scratch. Durch die Bearbeitung der beiden Programme, einem Kantenläufer und einem Autorennen, erwerben die Lernenden Fähigkeiten in der Programmierung mit Snap und Scratch. Die Aufgaben umfassen die Implementierung von Hintergrundbildern, Kostümen, Größenänderungen und Zeitabständen, sowie die Reaktion auf Tasteneingaben und das Vermeiden des Streckenverlassens."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6EJ07SxHM1iM" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Autorennen>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Blockorientierte_Programmierung>,
        <http://example.org/education/concept/Informatikdidaktik>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Scratch>,
        <http://example.org/education/concept/Snap>,
        <http://example.org/education/concept/Spieleentwicklung>,
        <http://example.org/education/concept/visuelle_Programmierung> ;
    dcterms:title "Aspekte von Snap und Scratch"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6KTSiOM0F9CM a edu:LearningResource ;
    sim:similarTo oer:9oZsB-R6gzgc ;
    dcterms:creator <http://example.org/education/person/Schmiedel>,
        <http://example.org/education/person/Wayne> ;
    dcterms:description "Das Portfolio Block 2 Umwelt und Klimaschutz behandelt die Themen Klimawandel, Energiekrise und Gesundheitseinschränkungen als Folge des Klimawandels. Durch die Lektüre erfahren die Lernenden über das Projekt Desertec, welches Strom aus der Sahara nach Europa transportieren soll, und wie dies zum Kampf gegen die Klimakrise beitragen kann. Zudem werden die negativen Auswirkungen des Klimawandels auf die Gesundheit, wie Hitzeperioden, Überschwemmungen und Dürreperioden, thematisiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6KTSiOM0F9CM" ;
    dcterms:publisher <http://example.org/education/organization/Berufsschullehramt_Gesundheit_und_Pflege> ;
    dcterms:subject <http://example.org/education/concept/%C3%96kosystem>,
        <http://example.org/education/concept/%C3%9Cberbev%C3%B6lkerung>,
        <http://example.org/education/concept/Energieerzeugung>,
        <http://example.org/education/concept/Erneuerbare_Energien>,
        <http://example.org/education/concept/Gesundheitseinschr%C3%A4nkungen>,
        <http://example.org/education/concept/Klimapolitik>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Solarenergie>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Portfolio Block 2 Umwelt und Klimaschutz"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:6LPF2T8XAmbI a edu:LearningResource ;
    sim:similarTo oer:9goni4UsDj0E ;
    dcterms:creator <http://example.org/education/person/Kliem> ;
    dcterms:description "Diese Hausaufgabe behandelt grundlegende Konzepte des Vektorraums, insbesondere die Dimension und Basis eines Vektorraumes sowie die Koordinatendarstellung von Vektoren bezüglich einer Basis. Durch das Studium dieser Aufgaben können Lernende ein Verständnis dafür entwickeln, wie Vektoren in einem Vektorraum definiert und operiert werden können. Die Aufgaben bieten eine systematische Einführung in die Theorie der Vektorräume und bereiten auf weitere Konzepte der linearen Algebra vor."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6LPF2T8XAmbI" ;
    dcterms:subject <http://example.org/education/concept/Algebraischer_Struktur>,
        <http://example.org/education/concept/Basisvektor>,
        <http://example.org/education/concept/Koordinatendarstellung>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mathematische_Strukturen>,
        <http://example.org/education/concept/Skalare>,
        <http://example.org/education/concept/Vektoren>,
        <http://example.org/education/concept/Vektorraum>,
        <http://example.org/education/concept/lineare_Algebra>,
        <http://example.org/education/concept/multilineare_Abbildung> ;
    dcterms:title "Hausaufgabe Nr. 17"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6SvyAz6iGesU a edu:LearningResource ;
