    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die Grundlagen der Linguistik und Sprachgeschichte des Deutschen behandeln die wissenschaftliche Untersuchung der menschlichen Sprache in all ihren Manifestationen und Verwendungen. Durch das Studium dieser Materialien können Lernende die verschiedenen Arten von Zeichen, ihre Beziehungen zueinander und zum Bezeichnetem verstehen sowie die Konventionen und Regeln der sprachlichen Kommunikation erkennen. Zudem werden sie in die Lage versetzt, die Struktur und Funktion von Sprache zu analysieren und ihre Bedeutung für die menschliche Kommunikation und Gesellschaft zu erfassen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10X9pi9ubHimc" ;
    dcterms:subject <http://example.org/education/concept/Kommunikationstheorie>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Semiotik>,
        <http://example.org/education/concept/Sprache_als_Zeichensystem>,
        <http://example.org/education/concept/Sprachgeschichte>,
        <http://example.org/education/concept/Sprachphilosophie>,
        <http://example.org/education/concept/Sprachtheorie>,
        <http://example.org/education/concept/Sprachwissenschaft>,
        <http://example.org/education/concept/Zeichen>,
        <http://example.org/education/concept/Zeichentypen> ;
    dcterms:title "Grundlagen der Linguistik und Sprachgeschichte des Deutschen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

