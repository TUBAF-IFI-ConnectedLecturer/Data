        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Netzsymmetrie>,
        <http://example.org/education/concept/Spannungsanalyse>,
        <http://example.org/education/concept/Sternpunktverlagerung>,
        <http://example.org/education/concept/Stromversorgung> ;
    dcterms:title "Drehstrom mit Sternpunktverlagerung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:17Agtk_pdd86A a edu:LearningResource ;
    sim:similarTo oer:17LVFOlY7Yz8w,
        oer:17c-TeiZ-rXRI,
