    dcterms:creator <http://example.org/education/person/Klose> ;
    dcterms:description "Diese Aufgaben unterstützen das Verständnis von gleichmäßig beschleunigten Bewegungen und ermöglichen die Berechnung von zurückgelegten Wegen und Fahrtzeiten bei verschiedenen Geschwindigkeiten und Beschleunigungen. Durch die Lösung der Aufgaben können Lernende ihre Fähigkeiten in der Physik und Mathematik verbessern und komplexere Probleme lösen. Die Aufgaben behandeln realistische Szenarien, wie das Fahren eines Autos oder den Betrieb von Zügen, um die physikalischen Konzepte zu veranschaulichen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "10MsDlzBDt-j4" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Beschleunigung>,
        <http://example.org/education/concept/Bewegung>,
        <http://example.org/education/concept/Eisenbahnverkehr>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Geschwindigkeit>,
        <http://example.org/education/concept/Mechanik>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Streckenberechnung>,
        <http://example.org/education/concept/Verkehrsplanung>,
        <http://example.org/education/concept/Zugfahrten> ;
    dcterms:title "Gleichmäßig beschleunigte Bewegung - Aufgaben"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10W1b-VVEqJHc a edu:LearningResource ;
    sim:similarTo oer:7PjjiAU1F7EQ ;
    dcterms:description "Das Programm berechnet die Summe aller Quadratzahlen von 1 bis n, wobei der Benutzer die Zahl n eingibt. Durch den Einsatz eines Abweiszyklus werden alle Quadratzahlen kleiner oder gleich n addiert. Am Ende wird das Ergebnis ausgegeben, womit der Lerner die Funktionsweise des Programms und die Anwendung von Schleifen in der Programmierung versteht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10W1b-VVEqJHc" ;
    dcterms:subject <http://example.org/education/concept/Abweiszyklus>,
        <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/C%2B%2B>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Eingabe%2FAusgabe>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Quadratzahlen>,
        <http://example.org/education/concept/Schleifen>,
        <http://example.org/education/concept/Summation>,
        <http://example.org/education/concept/Zahlenreihen> ;
    dcterms:title "Aufgabenstellung: Schreiben Sie ein Programm, welches eine natürliche Zahl n einliest und anschließend alle Quadratzahlen die kleiner oder gleich n sind addiert."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

