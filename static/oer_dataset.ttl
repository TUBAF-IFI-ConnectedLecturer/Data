oer:100aEPhhagd6o a edu:LearningResource ;
    sim:similarTo oer:109aOzI2QhDTo,
        oer:10LqSafzTkTYc,
        oer:10fyKuGENQ8fc,
        oer:10npINWAxgVmQ,
        oer:10oQSo2mexrDk,
        oer:10yLo231CnA9k ;
    dcterms:creator <http://example.org/education/person/Hirte> ;
    dcterms:description "Die Agglomerationseffekte spielen eine wichtige Rolle bei der Standortwahl von Unternehmen und können zu positiven Externalitäten wie Skalenerträgen, Lokalisierungsvorteilen und Urbanisationseffekten führen. Durch die Kenntnis dieser Effekte können regionale Entwicklungsstrategien entwickelt werden, um die Attraktivität eines Standorts zu erhöhen und die lokale Wirtschaft anzukurbeln. Die Clusterpolitik als Teil dieser Strategien zielt darauf ab, den lokalen Wettbewerb zu fördern und die Ansiedlung neuer Unternehmen zu unterstützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "100aEPhhagd6o" ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomische_Geographie>,
        <http://example.org/education/concept/Agglomerationseffekte>,
        <http://example.org/education/concept/Clusterpolitik>,
        <http://example.org/education/concept/Externe_Effekte>,
        <http://example.org/education/concept/Raumplanung>,
        <http://example.org/education/concept/Regional%C3%B6konomie>,
        <http://example.org/education/concept/Skalenertr%C3%A4ge>,
        <http://example.org/education/concept/Stadt%C3%B6konomie>,
        <http://example.org/education/concept/Standortwahl>,
        <http://example.org/education/concept/Wirtschaftsgeographie> ;
    dcterms:title "Regional- und Stadtökonomie"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:10276MQ3ZE7dY a edu:LearningResource ;
    sim:similarTo oer:128RxoyVtvlsU,
        oer:12D2srCrqwcyg,
        oer:5606wxf41sSs,
        oer:8Cegw8Tt-FMY,
        oer:8iZLpIllhaYQ,
        oer:8q05HoPUMR1I ;
    dcterms:creator <http://example.org/education/person/Grossmann> ;
    dcterms:description "Der Masterstudiengang PM-M Medienmärkte an der HTWK Leipzig behandelt die Analyse von Medienmärkten und -strukturen, einschließlich des Buchmarktes, Zeitungsmarktes und Musikmarktes. Durch die Auseinandersetzung mit den Marktanalysen und -strategien sollen Studierende ein Verständnis dafür entwickeln, wie Medienunternehmen funktionieren und wie sie sich in einem dynamischen Marktumfeld positionieren können. Die Inhalte umfassen auch die Darstellung von Megatrends, der Five Forces nach Porter und der Ansoff-Matrix, um die Komplexität der Medienmärkte aufzuzeigen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10276MQ3ZE7dY" ;
    dcterms:publisher <http://example.org/education/organization/HTWK_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Buchhandel>,
        <http://example.org/education/concept/Buchmarkt>,
        <http://example.org/education/concept/Marktanalyse>,
        <http://example.org/education/concept/Marktstruktur>,
        <http://example.org/education/concept/Medien%C3%B6konomie>,
        <http://example.org/education/concept/Medienmarkt>,
        <http://example.org/education/concept/Medientrends>,
        <http://example.org/education/concept/Medienunternehmen>,
        <http://example.org/education/concept/Verlagswesen>,
        <http://example.org/education/concept/Wirtschaftszahlen> ;
    dcterms:title "Masterstudiengang PM-M Medienmärkte WS 2425"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:103OmEoUi7d9w a edu:LearningResource ;
    sim:similarTo oer:105Ydhg9mA4s8,
        oer:122vBtqrTbVfk,
        oer:12jjhwXs5PN_w,
        oer:5ju6DUf2wqG0,
        oer:5rNgIPOp086A,
        oer:7-p5vgbhqc7w ;
    dcterms:description "Die Studie untersucht den Zusammenhang zwischen dem Need for Cognition (NFC) und dem Entscheidungsverhalten in der Iowa Gambling Task (IGT). Es wird festgestellt, dass die Teilnehmenden unabhängig von ihrem NFC-Wert keine Unterschiede in ihrer Leistung im IGT zeigen, jedoch eine Veränderung im Entscheidungsverhalten auftritt. Die Ergebnisse haben Implikationen für das Verständnis der Informationsverarbeitung und risikobehafteten Entscheidungen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "103OmEoUi7d9w" ;
    dcterms:subject <http://example.org/education/concept/Entscheidungsforschung>,
        <http://example.org/education/concept/Entscheidungsverhalten>,
        <http://example.org/education/concept/Informationsverarbeitung>,
        <http://example.org/education/concept/Iowa-Gambling-Task>,
        <http://example.org/education/concept/Kognitionsbed%C3%BCrfnis>,
        <http://example.org/education/concept/Kognitive_Psychologie>,
        <http://example.org/education/concept/Psychologische_Diagnostik>,
        <http://example.org/education/concept/Risikobewertung>,
        <http://example.org/education/concept/Varianzanalyse>,
        <http://example.org/education/concept/Verhaltensforschung> ;
    dcterms:title "Untersucht, inwiefern sich das Entscheidungsverhalten in der Iowa Gambling Task (IGT), einem Paradigma zur Untersuchung komplexer Entscheidungen auf Basis von Gewinn- und Verlustwahrscheinlichkeiten, anhand der Ausprägung des Kognitionsbedürfnisses verändert."@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:103UbuT-MziBE a edu:LearningResource ;
    sim:similarTo oer:107p_Zaa8NXjU,
        oer:10LslmnDXCFg4,
        oer:10Q_vYFYsCzJA,
        oer:10XcXW-htiNK8,
        oer:86LXMnwmscLE,
        oer:8tp6cQ3lyHWg ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Verkehrswirtschaft und konzentriert sich auf die Themen Marktstruktur, Wettbewerb und Regulierung im Verkehrssektor, insbesondere in den Bereichen Schienenpersonennahverkehr, Luftverkehr und Seeschifffahrtskonferenzen. Durch das Studium dieser Inhalte können Lernende ein Verständnis dafür entwickeln, wie Märkte funktionieren und wie Regulierungen den Wettbewerb beeinflussen. Zudem werden sie mit wichtigen Konzepten und Begriffen der Verkehrswirtschaft vertraut gemacht, um komplexe Probleme in diesem Bereich zu analysieren und Lösungen zu finden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "103UbuT-MziBE" ;
    dcterms:subject <http://example.org/education/concept/Airport_Economics>,
        <http://example.org/education/concept/Fernbuslinien>,
        <http://example.org/education/concept/Luftverkehr>,
        <http://example.org/education/concept/Marktliberalisierung>,
        <http://example.org/education/concept/Personenverkehrsleistung>,
        <http://example.org/education/concept/Regulierung>,
        <http://example.org/education/concept/Schienenpersonennahverkehr>,
        <http://example.org/education/concept/Seeschifffahrtskonferenzen>,
        <http://example.org/education/concept/Verkehrswirtschaft>,
        <http://example.org/education/concept/Wettbewerb> ;
    dcterms:title "Einführung in die Verkehrswirtschaft"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:107ThviF1x2M4 a edu:LearningResource ;
    sim:similarTo oer:10J69XfthJX4s,
        oer:10UyAw3rkKyjw,
        oer:3GFZMDtuiYCY,
        oer:4ik3f_fLbWQg,
        oer:7fbJ_JVHp_j0,
        oer:9aggXCl1eGzc ;
    dcterms:creator <http://example.org/education/person/Scheffel> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Klinischen Psychologie und Diagnostik, insbesondere den Begriff psychischer Störungen, ihre Klassifikation und Diagnose sowie differentiellpsychologische Aspekte wie Beschreibung, Vorhersage, Erklärung und Modifikation. Durch das Verständnis dieser Konzepte können Lernende die Komplexität psychischer Störungen erfassen und Ansätze für ihre Therapie entwickeln. Zudem werden sie in die Lage versetzt, die Bedeutung von Klassifikationen für die psychologische Forschung zu erkennen und ihre Auswirkungen auf die Praxis zu diskutieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "107ThviF1x2M4" ;
    dcterms:subject <http://example.org/education/concept/Biopsychologie>,
        <http://example.org/education/concept/Diagnostik>,
        <http://example.org/education/concept/Differentielle_Psychologie>,
        <http://example.org/education/concept/Humanistische_Theorien>,
        <http://example.org/education/concept/Klassifikation>,
        <http://example.org/education/concept/Klinische_Psychologie>,
        <http://example.org/education/concept/Lerntheorien>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitspsychologie>,
        <http://example.org/education/concept/Psychische_St%C3%B6rungen>,
        <http://example.org/education/concept/Psychotherapie.> ;
    dcterms:title "S.PP 02 Einführung Anwendungsbereich Klinische Psychologie und Diagnostik Differentielle und Persönlichkeitspsychologie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

