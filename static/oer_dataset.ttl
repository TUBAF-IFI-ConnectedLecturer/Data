        oer:17zQyupNMpmbU ;
    dcterms:creator <http://example.org/education/person/J%C3%BCttner> ;
    dcterms:description "Die Geschichte des Computers reicht zurück bis ins 19. Jahrhundert, als Charles Babbage die erste mechanische Rechenmaschine entwarf, und führt über die Entwicklung von Transistoren und Integrierten Schaltkreisen hin zu den ersten Personal Computern wie dem Altair 8800. Durch diese Entwicklung konnten Computer immer kleiner, schneller und günstiger werden, was letztendlich zum Einsatz in fast jedem Haushalt führte. Dieser Überblick über die Geschichte des Computers vermittelt ein Verständnis für die technischen Grundlagen und die Entwicklungsprozesse, die zu den heutigen Computern geführt haben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "16kgdFX_Wtypg" ;
    dcterms:subject <http://example.org/education/concept/Computerentwicklung>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Elektronische_Rechner>,
        <http://example.org/education/concept/Geschichte_des_Computers>,
        <http://example.org/education/concept/Informationstechnologie>,
        <http://example.org/education/concept/Integrierter_Schaltkreis>,
        <http://example.org/education/concept/Lochkarten>,
        <http://example.org/education/concept/Personal_Computer>,
        <http://example.org/education/concept/Taschenrechner>,
        <http://example.org/education/concept/Transistor> ;
    dcterms:title "Vom Rechenungetüm zum Personal Computer"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

