        <http://example.org/education/concept/digitale_Medien> ;
    dcterms:title "Hybrides Bestandsmanagement"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

oer:126nN3xryVQBg a edu:LearningResource ;
    sim:similarTo oer:47nczCPwbvpI,
