oer:59JQWjCG6VHk a edu:LearningResource ;
    sim:similarTo oer:5qfqH8dzOnSo,
        oer:7nRIGGi8bNGo ;
    dcterms:creator <http://example.org/education/person/Gemkow> ;
    dcterms:description "Die Mediatisierung des Wissens wird als ein Prozess verstanden, der die Art und Weise, wie Wissen generiert, prozessiert und verbreitet wird, grundlegend ändert. Durch die Analyse der Wikipedia als Beispiel für eine Plattform, auf der kollektives Wissen erzeugt wird, können Lernende Einsichten in die Rolle von Medienkompetenz bei der Gestaltung von Wissensbeständen gewinnen. Die Dispositivanalyse bietet einen Ansatz, um die komplexen Beziehungen zwischen Subjekten, Medien und Technologien zu verstehen und die Bedeutung von Medienkompetenz für die Zukunft des Wissens zu erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "59JQWjCG6VHk" ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Kommunikationswissenschaft>,
        <http://example.org/education/concept/Mediatisierung>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Online-Enzyklop%C3%A4dien>,
        <http://example.org/education/concept/P%C3%A4dagogik>,
        <http://example.org/education/concept/Wikitechnologie>,
        <http://example.org/education/concept/Wissenrepr%C3%A4sentation>,
        <http://example.org/education/concept/Wissensgesellschaft> ;
    dcterms:title "Wikipedia und die Transformation der Wissensaushandlung"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:5BgnAOiSiDlk a edu:LearningResource ;
    dcterms:description "Das Programm sortiert ein Feld von 10 Elementen in aufsteigender Reihenfolge durch Tauschen. Die Eingabe der Elemente erfolgt über die Tastatur und die Ausgabe des unsortierten und sortierten Feldes wird auf dem Bildschirm angezeigt. Durch das Studium dieses Programms können Lernende den Algorithmus des Sortierens durch Tauschen verstehen und anwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5BgnAOiSiDlk" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Ausgabe>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Eingabe>,
        <http://example.org/education/concept/Elemente>,
        <http://example.org/education/concept/Felder>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Sortierverfahren>,
        <http://example.org/education/concept/Tauschsortierung>,
        <http://example.org/education/concept/Vektoren> ;
    dcterms:title "Aufgabenstellung: Schreiben Sie ein Programm, welches die Elemente eines Feldes der Länge 10 beginnend mit dem kleinsten Wert sortiert."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5C1Qbk4kCazo a edu:LearningResource ;
    sim:similarTo oer:5rWGcggNHt30,
        oer:6pyf44GCfAf8 ;
    dcterms:creator <http://example.org/education/person/Achtziger>,
        <http://example.org/education/person/Richert> ;
    dcterms:description "Das Bildungsmaterial behandelt die Bedeutung von Biodiversität im Weinberg und Möglichkeiten der Anpassung an den Klimawandel. Es präsentiert Merkmale ausgewählter Arten, ihre Bedeutung für die Infiltration, Rückhaltevermögen und Wasserverfügbarkeit sowie Strategien zur Erosionsschutz und Verbesserung der Oberflächenrauhigkeit. Durch das Material können Lernende Kenntnisse über die Beziehungen zwischen Arten, Vegetationstypen und Standortparametern erwerben und Anpassungsstrategien für den Weinberg entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5C1Qbk4kCazo" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologische_Landwirtschaft>,
        <http://example.org/education/concept/Anpassung_an_den_Klimawandel>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
        <http://example.org/education/concept/Bodenschutz>,
        <http://example.org/education/concept/Erosionsschutz>,
        <http://example.org/education/concept/Pflanzen%C3%B6kologie>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Vegetations%C3%B6kologie>,
        <http://example.org/education/concept/Wasserhaushalt>,
        <http://example.org/education/concept/Weinbau> ;
    dcterms:title "Merkmale, Traits, Wurzeln"@de ;
    dcterms:type <http://example.org/education/type/Poster> .

oer:5CqdnX6njIkU a edu:LearningResource ;
    sim:similarTo oer:6QftNFaVS1zM,
        oer:6o8N4YxBX6_Q ;
    dcterms:creator <http://example.org/education/person/M%C3%BCller> ;
    dcterms:description "Das Seminar behandelt die Anwendung von Soft Skills, insbesondere Körpersprache und Feedback, um effektive Kommunikation zu fördern. Durch die Auseinandersetzung mit kommunikativen Fallen, wie Catch-22-Situationen oder paradoxen Aufforderungen, lernen Studierende, ihre Kommunikation anzupassen und Konflikte zu lösen. Zudem werden Strategien für das Geben und Nehmen von Feedback vermittelt, um eine konstruktive und ressourcenorientierte Kommunikation zu ermöglichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5CqdnX6njIkU" ;
    dcterms:subject <http://example.org/education/concept/Feedback>,
