        <http://example.org/education/concept/Sortieralgorithmus>,
        <http://example.org/education/concept/Verzweigung> ;
    dcterms:title "Klassenarbeit Algorithmen 21.01.2025"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

