oer:16n3T2JEmf_dk a edu:LearningResource ;
    dcterms:description "Dieses Workshop-Material behandelt das wissenschaftliche Präsentieren und bietet Hinweise und Tipps für einen soliden Einstieg in die Präsentationswelt. Es umfasst vier Hauptthemen, darunter den Aufbau einer Präsentation, Adressatenorientierung, Argumentationstechniken und Kritische Fragen, sowie vier Exkurse zu unterstützenden Aspekten wie Körpersprache und Lampenfieber. Durch die Bearbeitung dieser Inhalte können Teilnehmer ihre Fähigkeiten im wissenschaftlichen Präsentieren verbessern und ihren eigenen Präsentationsstil entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "16n3T2JEmf_dk" ;
    dcterms:subject <http://example.org/education/concept/Hochschuldidaktik>,
        <http://example.org/education/concept/K%C3%B6rpersprache>,
        <http://example.org/education/concept/Karriereentwicklung>,
        <http://example.org/education/concept/Kommunikationswissenschaft>,
        <http://example.org/education/concept/Pr%C3%A4sentationstechniken>,
        <http://example.org/education/concept/Rhetorik>,
        <http://example.org/education/concept/Selbstpr%C3%A4sentation>,
        <http://example.org/education/concept/Sprechtechnik>,
        <http://example.org/education/concept/Wissenschaftliche_Weiterbildung>,
        <http://example.org/education/concept/Wissenschaftliches_Arbeiten> ;
    dcterms:title "Wissenschaftliches Präsentieren"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

