    dcterms:creator <http://example.org/education/person/AUSTIN>,
        <http://example.org/education/person/Gl%C3%BCck>,
        <http://example.org/education/person/SEARLE> ;
    dcterms:description "Die Sprache wird als ein komplexes System von Zeichen und Regeln verstanden, das die Kommunikation zwischen Menschen ermöglicht und ihre soziale Identität prägt. Durch die Analyse der Sprachstruktur und -funktionen können Learner die Mechanismen der sprachlichen Kommunikation verstehen und ihre Fähigkeiten in der Verwendung von Sprache verbessern. Die Kenntnis der Sprachwissenschaft ermöglicht es zudem, die Vielfalt der Sprachen und ihre Entwicklung zu verstehen, sowie die Bedeutung von Sprache für die Gesellschaft und Kultur zu erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6qHAFBe79WME" ;
    dcterms:subject <http://example.org/education/concept/Grammatik>,
