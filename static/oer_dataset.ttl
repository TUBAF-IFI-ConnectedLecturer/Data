        <http://example.org/education/concept/Mikroebene>,
        <http://example.org/education/concept/Sprachmittel>,
        <http://example.org/education/concept/Sprachtheorie>,
        <http://example.org/education/concept/Sprachtypologie>,
        <http://example.org/education/concept/Sprachzwecke>,
        <http://example.org/education/concept/sprachliche_Ausdrucksseite> ;
    dcterms:title "Sr Sprachtypologie trifft kontrastive Linguistik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10nnD7eJsZFzA a edu:LearningResource ;
