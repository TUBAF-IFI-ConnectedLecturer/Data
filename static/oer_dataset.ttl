    dcterms:creator <http://example.org/education/person/Hacker> ;
    dcterms:description "Die Anforderungen an künftige Bibliothekare müssen auf allen drei Qualifikationsebenen berücksichtigt werden, um sicherzustellen, dass sie auf die sich ändernden Bedürfnisse der Bibliotheken vorbereitet sind. Durch den Austausch zwischen Berufspraxis und Hochschulen können Curricula entwickelt werden, die den aktuellen Anforderungen gerecht werden und Studierenden eine breite Palette an Fähigkeiten und Kenntnissen vermitteln. Durch die Integration von Tätigkeitsfeldern und Verantwortlichkeiten in die Studiengänge können Absolventen auf ihre zukünftigen Aufgaben vorbereitet werden und erfolgreich in verschiedenen Bibliothekstypen und -sparten arbeiten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11zzK50tU8vcU" ;
    dcterms:publisher <http://example.org/education/organization/HTWK_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Ausbildung>,
        <http://example.org/education/concept/Berufsbild>,
        <http://example.org/education/concept/Bibliothekar>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/F%C3%A4higkeit>,
        <http://example.org/education/concept/Hochschuldidaktik>,
        <http://example.org/education/concept/Informationswissenschaft>,
        <http://example.org/education/concept/Kenntnis>,
        <http://example.org/education/concept/Kompetenz>,
        <http://example.org/education/concept/Studienreform> ;
    dcterms:title "Die Zukunft der Bibliothekare: Anforderungen an künftige Bibliothekare und ihre Ausbildung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

