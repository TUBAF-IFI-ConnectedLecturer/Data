oer:5s_lr-PhiiGQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Stahl>,
        <http://example.org/education/person/Zhang> ;
    dcterms:description "Das Info-Plakat behandelt das Thema Cyber-Mobbing und zielt darauf ab, Jugendlichen die Gefahren und Auswirkungen von Cyber-Mobbing aufzuzeigen. Durch die visuell ansprechende Darstellung soll Unwissenheit und Ignoranz bekämpft werden. Die Diskussionsform ermöglicht es, emotionale Aspekte des Themas zu besprechen und eine gesunde Diskussion über unterschiedliche Meinungen zu führen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5s_lr-PhiiGQ" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Cyber-Mobbing>,
        <http://example.org/education/concept/Gewaltpr%C3%A4vention>,
        <http://example.org/education/concept/Informationsdesign>,
        <http://example.org/education/concept/Jugendliche>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Online-Kommunikation>,
        <http://example.org/education/concept/P%C3%A4dagogische_Kommunikation>,
        <http://example.org/education/concept/Plakatgestaltung>,
        <http://example.org/education/concept/Soziale_Netzwerke> ;
    dcterms:title "(Wissen in der modernen Welt)"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:5tG0b0gUEDBM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schenk-Danziger> ;
    dcterms:description "Die Arbeit untersucht den Einsatz von psychischer Bestrafung durch Lehrpersonen und ihre Auswirkungen auf Lernende, um zu klären, ob dies langfristig zur Verbesserung der Disziplin im Unterricht beiträgt. Durch die Analyse von Theorien und Beobachtungen wird gezeigt, dass psychische Bestrafung nicht nur unwirksam ist, sondern auch langfristig Schäden bei Lernenden verursachen kann. Die Arbeit bietet Einblicke in die negativen Folgen von Strafen im Unterricht und betont die Notwendigkeit einer gewaltfreien Erziehung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5tG0b0gUEDBM" ;
    dcterms:subject <http://example.org/education/concept/Disziplinierung>,
        <http://example.org/education/concept/Erziehungswissenschaften>,
        <http://example.org/education/concept/Klassenraummanagement>,
        <http://example.org/education/concept/Lehrer-Sch%C3%BCler-Beziehung>,
        <http://example.org/education/concept/Lernverhalten>,
        <http://example.org/education/concept/P%C3%A4dagogische_Psychologie>,
        <http://example.org/education/concept/Schulangst>,
        <http://example.org/education/concept/Schulklima>,
        <http://example.org/education/concept/Unterrichtsqualit%C3%A4t>,
        <http://example.org/education/concept/psychische_Gewalt> ;
    dcterms:title "Praktikumsbericht: Beobachtung und Analyse von psychischer Bestrafung im Schulunterricht"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

