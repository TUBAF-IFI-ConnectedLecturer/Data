oer:9fXhxbAr8iOM a edu:LearningResource ;
    sim:similarTo oer:9fZ2aiBlvsr8 ;
    dcterms:creator <http://example.org/education/person/Bertrand>,
        <http://example.org/education/person/Bombach>,
        <http://example.org/education/person/Riemer> ;
    dcterms:description "Diese Übung behandelt die Berechnung von totalen Differentialen und Ableitungen für verschiedene Funktionen, einschließlich vektorwertiger Funktionen und Cobb-Douglas-Produktionsfunktionen. Durch die Lösung der Aufgaben können Lernende ihre Fähigkeiten im Bereich der Differentialrechnung verbessern und ein tieferes Verständnis für die Anwendung von totalen Differentialen in verschiedenen mathematischen und physikalischen Kontexten entwickeln. Die Übung umfasst insgesamt acht Aufgaben, die sich auf verschiedene Aspekte der Differentialrechnung konzentrieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9fXhxbAr8iOM" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Fehlerrechnung>,
        <http://example.org/education/concept/Jacobi-Matrix>,
        <http://example.org/education/concept/Mathematik>,
