    dcterms:creator <http://example.org/education/person/Riesa_Neubauer> ;
    dcterms:description "Statistische Tests werden verwendet, um Hypothesen zu überprüfen und Unterschiede zwischen Gruppen oder Beziehungen zwischen Variablen zu identifizieren. Durch die Anwendung von t-Tests, Korrelation und Regression können Lerner feststellen, ob es signifikante Unterschiede zwischen Gruppen gibt oder wie sich Variablen zueinander verhalten. Dieses Wissen hilft bei der Interpretation von Daten und dem Erkennen von Mustern in verschiedenen Kontexten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10OZTBPHOLsCg" ;
    dcterms:subject <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Hypothesentest>,
        <http://example.org/education/concept/Korrelation>,
        <http://example.org/education/concept/Normalverteilung>,
        <http://example.org/education/concept/Regression>,
        <http://example.org/education/concept/Signifikanzniveau>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Varianzanalyse>,
        <http://example.org/education/concept/quantitative_Methoden>,
        <http://example.org/education/concept/t-Test> ;
    dcterms:title "Statistik und Quantitative Methoden BA Riesa Maria Neubauer 07.05.2021 Creative Commons: Attribution-NonComercial CC BY-NC"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

