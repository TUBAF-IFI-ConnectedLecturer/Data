oer:7vtlD3N0QfCM a edu:LearningResource ;
    sim:similarTo oer:8Nzf3_jmBwfQ,
        oer:8cqyAWZJkXMs,
        oer:8g2Okf1Bq7tM,
        oer:9KoYDCX_G-98,
        oer:9LJZYpo36fvs,
        oer:9NQzyiBVDiIk,
        oer:9eovj4dFAMdQ ;
    dcterms:creator <http://example.org/education/person/Delvendahl> ;
    dcterms:description "Die Einschränkungsberechnung von Schienenfahrzeugen behandelt die Bestimmung der zulässigen Fahrzeughöhe und -breite unter Berücksichtigung von statischen und kinematischen Einflüssen. Durch die Anwendung von Normen und Vorschriften, wie zum Beispiel der UIC 505-1 oder der EN 15273-2, können Ingenieure und Fachleute die sicherheitsrelevanten Abmessungen von Fahrzeugen berechnen und garantieren, dass sie den Anforderungen von Bahnbetrieb und -infrastruktur entsprechen. Durch das Verständnis dieser Berechnungsmethoden können Learner die notwendigen Kenntnisse erwerben, um sicherheitsrelevante Entscheidungen im Eisenbahnsektor zu treffen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7vtlD3N0QfCM" ;
    dcterms:subject <http://example.org/education/concept/Bahnanwendungen>,
        <http://example.org/education/concept/Begrenzungslinie>,
