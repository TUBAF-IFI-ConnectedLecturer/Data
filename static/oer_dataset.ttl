        <http://example.org/education/concept/Stromerzeugung>,
        <http://example.org/education/concept/W%C3%A4rmeerzeugung> ;
    dcterms:title "Energiegewinnung und -umwandlung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:45e_8Am9HUUI a edu:LearningResource ;
    sim:similarTo oer:8iOCPQH2YZT4 ;
    dcterms:creator <http://example.org/education/person/Merkel>,
