        <http://example.org/education/concept/Filmmarkt>,
        <http://example.org/education/concept/Medienmarkt>,
        <http://example.org/education/concept/Medienwirtschaft>,
        <http://example.org/education/concept/Musikmarkt>,
        <http://example.org/education/concept/Projektmanagement>,
        <http://example.org/education/concept/Rundfunkmarkt>,
        <http://example.org/education/concept/Verlagsmanagement>,
        <http://example.org/education/concept/Zeitschriftenmarkt> ;
    dcterms:title "Medienmärkte"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:12DU-JPZQDdlc a edu:LearningResource ;
    sim:similarTo oer:12eoSXJC8dwtY,
        oer:12mCJiPYZPpzY,
        oer:3lx0wXHMH7tI,
        oer:4o1njxtNgsT0 ;
    dcterms:creator <http://example.org/education/person/Uhlmann> ;
    dcterms:description "Die Vermessungslehre behandelt die Höhenmessung als ein wichtiger Aspekt der Geodäsie und Ingenieurvermessung, wobei verschiedene Methoden und Geräte wie Nivellier, Messlatten und Rotations-Laser vorgestellt werden. Durch das Studium dieser Materialien können Lernende die Grundlagen der Höhenmessung verstehen und erfahren, wie sie in verschiedenen Anwendungsbereichen eingesetzt werden kann. Insbesondere werden die Arten von Nivellier-Geräten, ihre Funktionsweise und Anwendungen in der Praxis erläutert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12DU-JPZQDdlc" ;
    dcterms:subject <http://example.org/education/concept/Bauvermessung>,
