        <http://example.org/education/concept/Oberfl%C3%A4chenintegrale>,
        <http://example.org/education/concept/Potentialfelder>,
        <http://example.org/education/concept/Vektorfelder> ;
    dcterms:title "Mathematik III (für IF, ET, Ph) Wintersemester 2023/24"@de ;
