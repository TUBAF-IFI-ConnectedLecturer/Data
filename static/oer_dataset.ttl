    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

oer:8Vy--T0Sbb2I a edu:LearningResource ;
    sim:similarTo oer:8dwfrj5jonVw,
        oer:8dzGidlZSGTA,
        oer:8g46BPeFY3hA,
        oer:8melWvLsp4b0,
        oer:8z88rRCCq6nk,
        oer:9T-qFy0rnpPE,
        oer:9X60e9UzJ1cs ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der bibliographischen Katalogisierung und Indexierung akademischer Werke, insbesondere die Charakterisierung von Partikeln und Suspensionen in verschiedenen Prozessen. Durch das Studium dieser Materialien erwerben Lernende Kenntnisse über die Eigenschaften von Partikeln, ihre Wechselwirkungen mit der Umgebung und die Anwendung von Messverfahren in der Prozessüberwachung. Die Inhalte umfassen auch die Photokatalyse, die Filtration und die Überwachung von Umweltaerosolen, wodurch Lernende ein umfassendes Verständnis der Prozesse und Techniken in diesem Bereich erlangen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8Vy--T0Sbb2I" ;
    dcterms:subject <http://example.org/education/concept/Dispersit%C3%A4tszustand>,
        <http://example.org/education/concept/Filtrationsprozesse>,
        <http://example.org/education/concept/Grenzfl%C3%A4cheneigenschaften>,
        <http://example.org/education/concept/Kolloidale_Systeme>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Partikeltechnologie>,
        <http://example.org/education/concept/Photokatalyse>,
        <http://example.org/education/concept/Prozesssensoren>,
        <http://example.org/education/concept/Stofftransport>,
        <http://example.org/education/concept/Umweltaerosole> ;
    dcterms:title "PVT-Seminar, 27.10.2023 Babick: Forschung der AG Mechanische Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

