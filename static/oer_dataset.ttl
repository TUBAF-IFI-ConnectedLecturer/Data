        <http://example.org/education/concept/Messtechnik>,
        <http://example.org/education/concept/Spannungsmessung>,
        <http://example.org/education/concept/Strommessung>,
        <http://example.org/education/concept/Transistor>,
        <http://example.org/education/concept/Widerstandsmessung> ;
    dcterms:title "Praktikum Diode und Transistor"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:62JkBgZJHdxA a edu:LearningResource ;
    sim:similarTo oer:65X8rni1fcws,
