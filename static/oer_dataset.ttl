oer:5rZW6hWh02dE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Neuroth>,
        <http://example.org/education/person/Voigt>,
        <http://example.org/education/person/Wolters> ;
    dcterms:description "Die Wikinger müssen einen Schatz finden und dafür ein Schiff beladen, das genug Platz für die Tagesrationen der Mitfahrer bietet. Durch Lösung von Rätseln und Berechnungen können sie den Weg zum Schatz finden und die notwendigen Vorbereitungen treffen. Am Ende des Abenteuers werden die Wikinger in der Lage sein, den Schatz zu teilen und ihre Fähigkeiten im Bereich Mathematik und Problemlösung unter Beweis zu stellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5rZW6hWh02dE" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Abenteuer>,
        <http://example.org/education/concept/Goldm%C3%BCnzen>,
