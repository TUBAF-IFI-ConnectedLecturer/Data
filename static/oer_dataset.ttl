    dcterms:creator <http://example.org/education/person/Hacker> ;
    dcterms:description "Die Diskussion behandelt die Aufgabenteilung und erforderlichen Kompetenzen für die einzelnen Aufgaben in Bibliotheken auf den drei Qualifikationsebenen entsprechend des mittleren, gehobenen und höheren Dienstes. Durch das Verständnis dieser Struktur können Lernende die Anforderungen an Bibliothekare besser verstehen und ihre eigenen Fähigkeiten und Kenntnisse entwickeln, um erfolgreich in diesem Berufsfeld zu arbeiten. Die Auseinandersetzung mit der Geschichte und Entwicklung des Bibliothekarsberufs in Deutschland bietet zudem einen Überblick über die Veränderungen und Herausforderungen in diesem Bereich."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "12M5rJfBeeOIo" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentliche_Bibliotheken>,
        <http://example.org/education/concept/Ausbildung>,
        <http://example.org/education/concept/Berufsbildung>,
        <http://example.org/education/concept/Bibliothekar>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Hochschulstudium>,
        <http://example.org/education/concept/Informationswissenschaft>,
        <http://example.org/education/concept/Karriereplanung>,
        <http://example.org/education/concept/Personalentwicklung>,
        <http://example.org/education/concept/Wissenschaftliche_Bibliotheken> ;
    dcterms:title "Die Geschichte der bibliographischen Katalogisierung und Indexierung in Deutschland"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

