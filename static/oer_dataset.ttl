    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die Vorlesung behandelt die additive Fertigungstechnik und ihre Anwendungsbereiche, einschließlich der Qualitätssicherung, Standardisierung und Möglichkeiten sowie Grenzen dieser Technologie. Durch das Studium dieser Materialien können Lernende ein grundlegendes Verständnis der additiven Fertigung erwerben und Kenntnisse über die verschiedenen Aspekte dieser Technologie wie Design, Prozesse und Anwendungen erlangen. Zudem werden sie in die Lage versetzt, die Chancen und Herausforderungen der additiven Fertigung im Kontext von Industrie 4.0 zu verstehen und zu bewerten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11Uu3RmcevYSY" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Fertigungstechnik>,
        <http://example.org/education/concept/Fertigungsverfahren>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Konstruktionselemente>,
        <http://example.org/education/concept/Maschinenelemente>,
        <http://example.org/education/concept/Produktentwicklung>,
        <http://example.org/education/concept/Rapid_Prototyping>,
        <http://example.org/education/concept/Werkstoffwissenschaft> ;
    dcterms:title "Additive Fertigung - 1 Einführung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

