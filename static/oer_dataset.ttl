oer:8bptTYZu-htg a edu:LearningResource ;
    sim:similarTo oer:8sTG35VRIK7Q ;
    dcterms:creator <http://example.org/education/person/Kie%C3%9Fling> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Didaktik der Informatik und vermittelt Kenntnisse über die Audioproduktion am Computer, einschließlich Vorbereitungen, Grundwissen, Einbindung in Präsentationen und Übungen. Durch das Durcharbeiten dieses Materials können Lernende Audioaufnahmen vorbereiten, erstellen, bearbeiten und in Präsentationen einbinden, um die Interaktivität zu steigern. Zudem lernen sie, wichtige Eigenschaften wie Stimmlage, Synkopen und Bindungen zu berücksichtigen und Audioelemente sinnvoll zu gestalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8bptTYZu-htg" ;
    dcterms:subject <http://example.org/education/concept/Audioaufnahme>,
        <http://example.org/education/concept/Audioproduktion>,
        <http://example.org/education/concept/Computerunterst%C3%BCtztes_Lernen>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Medienbildung>,
        <http://example.org/education/concept/Pr%C3%A4sentationstechniken>,
        <http://example.org/education/concept/Schulischer_Kontext>,
        <http://example.org/education/concept/Tonbearbeitung> ;
    dcterms:title "Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:98yvem2uWEuI a edu:LearningResource ;
    sim:similarTo oer:9y9ooc8x1mY8 ;
    dcterms:creator <http://example.org/education/person/Herzog> ;
    dcterms:description "Dieses Dokument enthält eine Sammlung von Quizfragen und Antworten zu verschiedenen Themen der mathematischen Optimierung, insbesondere zur Lösung von Kleinste-Quadrate-Aufgaben und Parameteridentifizierungsproblemen. Durch das Durcharbeiten dieser Fragen können Lernende ihr Verständnis für die Anwendung von Optimierungsmethoden in der Praxis verbessern und ihre Fähigkeiten im Umgang mit Matlab-Routinen wie lsqcurvefit und fminunc erweitern. Die Beantwortung der Quizfragen hilft dabei, wichtige Konzepte wie Residuen, Zielfunktionen und lokale Minima zu verstehen und anzuwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "98yvem2uWEuI" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Datenanpassung>,
        <http://example.org/education/concept/Fehleranalyse>,
        <http://example.org/education/concept/Kleinste-Quadrate-Methode>,
        <http://example.org/education/concept/Matlab>,
        <http://example.org/education/concept/Modellvalidierung>,
        <http://example.org/education/concept/Nichtlineare_Optimierung>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Parameteridentifizierung>,
        <http://example.org/education/concept/mathematische_Modellierung>,
        <http://example.org/education/concept/statistische_Analyse> ;
    dcterms:title "(Frage und Antworten)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9RGpjWJIHuYY a edu:LearningResource ;
    sim:similarTo oer:9cOjlSsSnjVw,
        oer:9dalNQWWSQlU,
        oer:9dvnwma2JoXg ;
    dcterms:creator <http://example.org/education/person/Riedel> ;
    dcterms:description "Die Kompetenzorientierung im Studium zielt darauf ab, dass Studierende ihre Fähigkeiten und Kenntnisse auch in Handlungen umsetzen können. Durch die Definition von Lernergebnissen und die Gestaltung von Lehrinhalten und -methoden soll sichergestellt werden, dass das Wissen der Studierenden nicht träg bleibt, sondern vielmehr in konkreten Anwendungen eingesetzt wird. Die Umsetzung dieser Ansätze soll die Beschäftigungsfähigkeit und Eigenständigkeit der Studierenden fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9RGpjWJIHuYY" ;
    dcterms:subject <http://example.org/education/concept/Bildungsinnovationen>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Employability>,
