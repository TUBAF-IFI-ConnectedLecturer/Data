    dcterms:title "Fallvignette Frau Freiburg"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:5e9boKxP19Xg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Stieler> ;
    dcterms:description "Das Doppelschattenexperiment ermöglicht es, das Prinzip der linearen Lichtausbreitung und des Schattenwurfes zu veranschaulichen und die Spiegelwelt als Symmetrieachse zu erklären. Durch die Durchführung des Experiments können Schüler:innen zwei Schatten auf dem Schirm vorhersagen und die unterschiedlichen Schattenformen bei Verdrehung des Körpers erkennen. Das Experiment eignet sich für den Anfangsunterricht über Optik und bietet eine Überraschung für die Schüler:innen, da nur wenige tatsächlich zwei Schatten auf dem Schirm vorhersagen werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5e9boKxP19Xg" ;
    dcterms:publisher <http://example.org/education/organization/LA_BBS_MMT> ;
    dcterms:subject <http://example.org/education/concept/Beleuchtung>,
        <http://example.org/education/concept/Experiment>,
        <http://example.org/education/concept/Licht>,
        <http://example.org/education/concept/Optik>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Physikunterricht>,
        <http://example.org/education/concept/Reflexion>,
        <http://example.org/education/concept/Schatten>,
        <http://example.org/education/concept/Spiegel>,
        <http://example.org/education/concept/Unterrichtsmaterial> ;
    dcterms:title "Vorschläge zum Anfangsunterricht über Optik."@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

