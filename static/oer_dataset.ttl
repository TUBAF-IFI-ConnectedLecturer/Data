        <http://example.org/education/concept/Kapitalverzehr>,
        <http://example.org/education/concept/Kredit>,
        <http://example.org/education/concept/Rente>,
        <http://example.org/education/concept/Sparkassenformel>,
        <http://example.org/education/concept/Tilgung>,
        <http://example.org/education/concept/Verzinsung>,
        <http://example.org/education/concept/Zinseszins> ;
    dcterms:title "Renten- und Tilgungsrechnung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:5m0h_cdcZ1vY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Butzke> ;
    dcterms:description "Das Arbeitsblatt unterstützt die Erstellung einer Personenbeschreibung anhand eines Porträts im Museumsraum 1 im MIBERZ. Durch die Beschreibung von äußeren Merkmalen wie Gesamterscheinung, Geschlecht, Alter und Kleidung sollen die Fähigkeiten zur Beobachtung und Beschreibung von Personen gefördert werden. Die Aufgabe soll dabei die Entwicklung einer detaillierten Personenbeschreibung ermöglichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5m0h_cdcZ1vY" ;
    dcterms:subject <http://example.org/education/concept/Anthropometrie>,
        <http://example.org/education/concept/Bildungsforschung>,
