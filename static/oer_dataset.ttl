        <http://example.org/education/concept/Kommunikation>,
        <http://example.org/education/concept/Konfliktbew%C3%A4ltigung>,
        <http://example.org/education/concept/Nonverbale_Kommunikation>,
        <http://example.org/education/concept/Selbstwahrnehmung>,
        <http://example.org/education/concept/Soziale_Interaktion>,
        <http://example.org/education/concept/Verhaltensmodellierung> ;
    dcterms:title "Seminar Soft Skills - Körpersprache und Feedback"@de ;
    dcterms:type <http://example.org/education/type/Seminar> .

