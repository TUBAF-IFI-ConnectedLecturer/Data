oer:1-ao_p66adjQ a edu:LearningResource ;
    sim:similarTo oer:1I16j7TUzFw4,
        oer:1LNNKZpVIsrI,
        oer:1T6VOpurTkGE ;
    dcterms:creator <http://example.org/education/person/Riedel> ;
    dcterms:description "Mit dieser Anleitung lernen Sie die wichtigsten Funktionen zur Durchführung einer interaktiven Online-Veranstaltung im Virtuellen Klassenzimmer von Adobe Connect kennen. Sie können Ton und Videobild verbinden und freigeben, den Grundaufbau eines Virtuellen Klassenzimmers kennenlernen und die wichtigsten Funktionen und Pods nutzen, wie das Anzeigen von Präsentationen, die Nutzung eines Whiteboards und die Durchführung von Abstimmungen. Durch diese Lernziele können Sie Inhalte vermitteln, erarbeiten oder diskutieren und Ihre Teilnehmenden aktivieren und motivieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1-ao_p66adjQ" ;
    dcterms:subject <http://example.org/education/concept/Adobe_Connect>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Computerunterst%C3%BCtztes_Lernen>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Fernlehre>,
        <http://example.org/education/concept/Interaktive_Medien>,
        <http://example.org/education/concept/Online-Konferenz>,
        <http://example.org/education/concept/Online-Lehre>,
        <http://example.org/education/concept/Virtuelles_Klassenzimmer>,
        <http://example.org/education/concept/Webinar> ;
    dcterms:title "INHALT"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:101YKMebjgapc a edu:LearningResource ;
    sim:similarTo oer:12-cvcBTTdcsc,
        oer:12Wupodes26wc,
        oer:6nNODbTdcGaw ;
    dcterms:description "Die Forschungsdatenbank der TU Bergakademie Freiberg ermöglicht es Wissenschaftlern, ihre Forschungsaktivitäten und -ergebnisse zu dokumentieren und sichtbar zu machen. Durch die zentrale Verwaltung aller Daten können Listen nach unterschiedlichen Kriterien erstellt werden und in standardisierten Webseiten dargestellt werden. Die Datenbank verwaltet Objekte wie Literatur, Projekte, Promotionen, Habilitationen, Preise, Patente und wissenschaftliche Kompetenz."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "101YKMebjgapc" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Bibliographische_Daten>,
        <http://example.org/education/concept/Forschungsdatenbank>,
        <http://example.org/education/concept/Forschungsinformationssystem>,
        <http://example.org/education/concept/Forschungsprojekte>,
        <http://example.org/education/concept/Habilitation>,
        <http://example.org/education/concept/Hochschulforschung>,
        <http://example.org/education/concept/Patentmanagement>,
        <http://example.org/education/concept/Preisverleihung>,
        <http://example.org/education/concept/Wissenschaftliche_Kompetenz>,
        <http://example.org/education/concept/Wissenschaftliches_Publizieren> ;
    dcterms:title "Forschungsdatenbank Prorektorat Forschung Stand: 30.06.2015"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:10CWFRDh3Oad4 a edu:LearningResource ;
    sim:similarTo oer:10lJ_kZd7RS6w,
        oer:10ojxzpx3qecM,
        oer:10uPtUe-NfF2o ;
    dcterms:description "Der Satz des Thales wird bewiesen, indem die Winkelsumme eines Dreiecks berechnet und die Basiswinkel der Teildreiecke bestimmt werden. Durch den Beweis kann gezeigt werden, dass der Winkel über dem Durchmesser eines Kreises immer 90 Grad beträgt. Die Aufgabe hilft Lernenden, ihre Fähigkeiten im Bereich der Geometrie zu verbessern und mathematische Beweise zu erstellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10CWFRDh3Oad4" ;
    dcterms:subject <http://example.org/education/concept/Beweis>,
        <http://example.org/education/concept/Dreieck>,
        <http://example.org/education/concept/Durchmesser>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Innenwinkelsumme>,
        <http://example.org/education/concept/Kreis>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Satz_des_Thales>,
        <http://example.org/education/concept/Seitenhalbierende>,
        <http://example.org/education/concept/Winkel> ;
    dcterms:title "Der Satz des Thales"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10FxaP3vJ4SKY a edu:LearningResource ;
    sim:similarTo oer:12FhBqfps3nOk,
        oer:5iVp-gNbRLW0,
        oer:78UOjHBWVrCo ;
    dcterms:creator <http://example.org/education/person/Karger>,
        <http://example.org/education/person/Kluge>,
        <http://example.org/education/person/Scholtz> ;
    dcterms:description "Das Projektziel besteht darin, ein Mensch-Maschine-Interface auf Basis von EID zu entwickeln, das die Phänomene in einer Ofenanlage darstellt und Fehleinschätzungen sowie Unfälle verhindert. Durch die Visualisierung der Anlage sollen Bediener ein besseres Verständnis für die Prozesse erhalten und sicherer mit der Maschine interagieren können. Die Arbeit behandelt Aspekte wie Benutzeranalyse, Prototyping, Evaluation und Testing, um ein geeignetes Interface-Design zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10FxaP3vJ4SKY" ;
    dcterms:subject <http://example.org/education/concept/Anzeigengestaltung>,
        <http://example.org/education/concept/Benutzeranalyse>,
        <http://example.org/education/concept/Ergonomie>,
        <http://example.org/education/concept/Fehlerf%C3%A4lle>,
        <http://example.org/education/concept/Mensch-Maschine-Interface>,
        <http://example.org/education/concept/Menschliche_Leistungsf%C3%A4higkeit>,
        <http://example.org/education/concept/Ph%C3%A4nomene>,
        <http://example.org/education/concept/Sicherheit_von_Maschinen>,
        <http://example.org/education/concept/Stellteile>,
        <http://example.org/education/concept/Visualisierung> ;
    dcterms:title "Phenomena Visusalisation Professur PLTSVT  Gruppe 9 Projektverteidigung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

