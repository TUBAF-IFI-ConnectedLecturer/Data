        <http://example.org/education/concept/Psychomotorik>,
        <http://example.org/education/concept/Schulischer_Unterricht>,
        <http://example.org/education/concept/Unterrichtsplanung> ;
    dcterms:title "TAXONOMIE VON LERNZIELEN - PSYCHOMOTORISCHER BEREICH"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:11g3tVdd9wxGc a edu:LearningResource ;
    sim:similarTo oer:14XWHZ65hceSk,
        oer:14hYhS6DD3EMY,
