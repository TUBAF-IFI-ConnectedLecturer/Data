        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Mediendidaktik>,
        <http://example.org/education/concept/Mediengestaltung>,
        <http://example.org/education/concept/R%C3%A4umlichkeit>,
        <http://example.org/education/concept/Schriftarten>,
        <http://example.org/education/concept/Visuelle_Pr%C3%A4sentation> ;
    dcterms:title "Medien begriff Gestaltungs- regeln visuelle Medien Präsentation auditive Medien Moderation"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

