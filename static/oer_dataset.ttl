        <http://example.org/education/concept/Mikrochips>,
        <http://example.org/education/concept/Rechnerarchitektur>,
        <http://example.org/education/concept/Technische_Informatik>,
        <http://example.org/education/concept/Wahrheitstabellen>,
        <http://example.org/education/concept/Zweierkomplement> ;
    dcterms:title "Mündliche Abiturprüfung Fach Informatik - Grundkurs"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

