oer:5xptOynX2oc0 a edu:LearningResource ;
    sim:similarTo oer:7BcIE5VX2h6U,
        oer:7FgmeknBoW_I ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Dieses Dokument behandelt die Grammatik der mittelniederdeutschen Sprache, insbesondere die verschiedenen Arten von Pronomen wie Indefinitpronomina, Interrogativpronomina, Demonstrativpronomina, Possessivpronomina und Reflexivpronomen. Durch das Studium dieser Materialien können Lerner die Struktur und Verwendung dieser Pronomen in mittelniederdeutschen Texten verstehen und ihre Fähigkeiten im Bereich der Grammatik und Syntax verbessern. Die detaillierten Beispiele und Erklärungen ermöglichen es den Lernenden, die Feinheiten der mittelniederdeutschen Sprache zu erfassen und ihre Kenntnisse in diesem Bereich zu erweitern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5xptOynX2oc0" ;
    dcterms:subject <http://example.org/education/concept/Demonstrativpronomen>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Historische_Linguistik>,
        <http://example.org/education/concept/Interrogativpronomina>,
        <http://example.org/education/concept/Mittelniederdeutsch>,
        <http://example.org/education/concept/Personalpronomina>,
        <http://example.org/education/concept/Possessivpronomen>,
        <http://example.org/education/concept/Pronomina>,
        <http://example.org/education/concept/Reflexivpronomen>,
        <http://example.org/education/concept/Sprachgeschichte> ;
    dcterms:title "Hansesprache, oder Mittelniederdeutsch als Fremdsprache"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:5zfEdfnMZ5HU a edu:LearningResource ;
    sim:similarTo oer:7NLZZwOUrmF4,
        oer:9aggXCl1eGzc ;
    dcterms:creator <http://example.org/education/person/M%C3%BCft%C3%BCo%C4%9Fullar%C4%B1>,
        <http://example.org/education/person/Sartain>,
        <http://example.org/education/person/Scheffel> ;
    dcterms:description "Die Vorlesung behandelt die Einführung in die Potenzialdiagnostik und Persönlichkeitspsychologie, wobei die Grundlagen der Diagnostik von menschlichen Verhaltens- und Erlebensmustern erläutert werden. Durch das Studium dieser Materialien können Lerner ein Verständnis dafür entwickeln, wie sich Persönlichkeitseigenschaften auf das Verhalten auswirken und wie diese Eigenschaften in verschiedenen Anwendungsbereichen eingesetzt werden können. Zudem werden die Gütekriterien diagnostischer Testverfahren und die Prozesse der Potenzialdiagnostik erläutert, um Lerner zu befähigen, solche Verfahren selbstständig anzuwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5zfEdfnMZ5HU" ;
    dcterms:subject <http://example.org/education/concept/Angstst%C3%B6rungen>,
        <http://example.org/education/concept/Berufsberatung>,
        <http://example.org/education/concept/Depression>,
        <http://example.org/education/concept/Differentielle_Psychologie>,
        <http://example.org/education/concept/Eignungsdiagnostik>,
        <http://example.org/education/concept/Klinische_Psychologie>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitspsychologie>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitstests>,
        <http://example.org/education/concept/Personalentwicklung>,
        <http://example.org/education/concept/Potenzialdiagnostik> ;
    dcterms:title "S.PP 07 Anwendungsbereich Potenzialdiagnostik: Einführung Differentielle und Persönlichkeitspsychologie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:62tq-gX7-lrA a edu:LearningResource ;
    sim:similarTo oer:77m5cQVpJgYY,
        oer:7y2Vvnr6LpnI ;
    dcterms:creator <http://example.org/education/person/Kliem> ;
    dcterms:description "Die Hausaufgabe behandelt zwei wichtige Konzepte der Mathematik: die Verknüpfung von Funktionen und die Gleichmachtigkeit von Mengen. Durch die Bearbeitung dieser Aufgaben können Lerner das Prinzip der Funktionsverknüpfung verstehen und erkennen, dass die Reihenfolge der Funktionen wichtig ist. Darüber hinaus werden sie die Machtigkeit von Mengen kennenlernen und wie diese durch verschiedene Symbole dargestellt wird."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "62tq-gX7-lrA" ;
    dcterms:subject <http://example.org/education/concept/Abbildungen>,
        <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Kardinalit%C3%A4t>,
