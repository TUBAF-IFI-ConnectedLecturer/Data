        <http://example.org/education/concept/Silicon_Valley>,
        <http://example.org/education/concept/Spielkonsole>,
        <http://example.org/education/concept/Transistor> ;
    dcterms:title "Bücher über die Geschichte der Computer"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:15rJvFbUzlBR0 a edu:LearningResource ;
