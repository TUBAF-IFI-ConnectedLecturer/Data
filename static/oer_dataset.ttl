    dcterms:creator <http://example.org/education/person/Bertrand>,
        <http://example.org/education/person/Bombach>,
        <http://example.org/education/person/Riemer> ;
    dcterms:description "Diese Übung behandelt die Lösung von Aufgaben zur Kurven- und Oberflächenintegration, wobei die Studierenden ihre Fähigkeiten im Umgang mit Potentialfeldern, Integrabilitätsbedingungen und Stammfunktionen verbessern können. Die Aufgaben umfassen die Berechnung von Arbeitsintegralen, Bogenlängen und Oberflächeninhalten sowie die Untersuchung von Vektorfeldern auf ihre Eigenschaft als Potentialfelder. Durch das Lösen dieser Aufgaben erwerben die Studierenden ein tieferes Verständnis der mathematischen Konzepte und können ihre Fähigkeiten in der Anwendung dieser Konzepte verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9-hEmKK_kTZA" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Astrophysik>,
        <http://example.org/education/concept/Differentialgeometrie>,
        <http://example.org/education/concept/Integrabilit%C3%A4tsbedingungen>,
        <http://example.org/education/concept/Kurvenintegrale>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Oberfl%C3%A4chenintegrale>,
        <http://example.org/education/concept/Parametrisierung>,
        <http://example.org/education/concept/Potentialfelder>,
        <http://example.org/education/concept/Stammfunktionen>,
        <http://example.org/education/concept/Vektoranalysis> ;
    dcterms:title "Mathematik III (für IF, ET, Ph) Wintersemester 2023/24 7. Übung: Kurven- und Oberflächenintegrale (Lösungen)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9Z3Pf-hj8U3A a edu:LearningResource ;
    sim:similarTo oer:9bWwFRPrmM2U,
        oer:9jfKL3NiIpew,
        oer:9rvvaBPXMeZo ;
    dcterms:creator <http://example.org/education/person/Kretzschmar> ;
    dcterms:description "Die Fahrdynamik von Eisenbahnfahrzeugen wird durch verschiedene Faktoren wie Steigungen, Kurven und Wagenzugmassen beeinflusst, wodurch die Geschwindigkeit und Beschleunigung eines Zuges bestimmt werden. Durch die Berechnung von Schleppmassen, Anfahrgrenzlasten und Anhangegrenzlasten können Ingenieure die maximal mögliche Wagenzugmasse für einen bestimmten Streckenabschnitt ermitteln und sicherstellen, dass der Zug auch nach außerplanmäßigen Halten wieder anfahren kann. Durch das Verständnis dieser Konzepte können Learner die Fahrdynamik von Eisenbahnfahrzeugen besser verstehen und optimale Lösungen für den Eisenbahnbetrieb entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9Z3Pf-hj8U3A" ;
    dcterms:subject <http://example.org/education/concept/Anfahrgrenzlast>,
        <http://example.org/education/concept/Eisenbahnverkehr>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/G%C3%BCterz%C3%BCge>,
        <http://example.org/education/concept/Grenzlastberechnung>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Schleppverm%C3%B6gen>,
        <http://example.org/education/concept/Traktionskonzept>,
        <http://example.org/education/concept/Wagenzugmasse>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrzeugtechnik und Fahrdynamik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

