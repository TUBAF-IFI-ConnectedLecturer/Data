oer:10940K0WUPIio a edu:LearningResource ;
    sim:similarTo oer:10B6d60xs9Cys,
        oer:10wDgPnmOTDLQ,
        oer:11f_xEr8sCxw0,
        oer:4eA93iFcfXGE,
        oer:4kv_qpC94mdY,
        oer:5ySw59JFdyX4,
        oer:6-TtE0KDtg50,
        oer:66BFD588LBO4,
        oer:6CRJOBIRXuzc ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Grenzflächenphänomene\" behandelt die grundlegenden Konzepte und Phänomene an Grenzflächen, einschließlich Adsorption, Benetzung, Kontaktwinkel und Kapillarität. Durch das Studium dieser Materialien werden die Lernenden in die Lage versetzt, die physikalisch-chemischen Grundlagen von Grenzflächenphänomenen zu verstehen und anzuwenden. Die Vorlesung umfasst eine Vielzahl von Beispielen und Anwendungen aus der Verfahrenstechnik und anderen Bereichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10940K0WUPIio" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen_Institut_f%C3%BCr_Verfahrenstechnik_und_Umwelttechnik> ;
    dcterms:subject <http://example.org/education/concept/Adsorption>,
        <http://example.org/education/concept/Elektrochemie>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenph%C3%A4nomene>,
        <http://example.org/education/concept/Kapillarit%C3%A4t>,
        <http://example.org/education/concept/Kolloidchemie>,
        <http://example.org/education/concept/Kontaktwinkel>,
        <http://example.org/education/concept/Kr%C3%BCmmungsdruck>,
        <http://example.org/education/concept/Oberfl%C3%A4chenspannung>,
        <http://example.org/education/concept/Thermodynamik>,
        <http://example.org/education/concept/Verfahrenstechnik> ;
    dcterms:title "Fakultät Maschinenwesen Institut für Verfahrenstechnik und Umwelttechnik, AG Mechanische Verfahrenstechnik Lehrveranstaltung Grenzflächenphänomene"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10Q_vYFYsCzJA a edu:LearningResource ;
    sim:similarTo oer:10XcXW-htiNK8,
        oer:10m3P_kbmtPaM,
        oer:86LXMnwmscLE,
        oer:8tp6cQ3lyHWg,
        oer:8zKeSPiSTWGE ;
    dcterms:description "Die Einführung in die Verkehrswirtschaft behandelt die Grundlagen der Verkehrsnachfrage und -angebot, einschließlich der Determinanten der Nachfrage, der Preiselastizität und der Zeitwert des Reisens. Durch das Studium dieser Inhalte können Lernende ein Verständnis dafür entwickeln, wie die Verkehrswirtschaft funktioniert und welche Faktoren die Nachfrage nach Verkehrsdienstleistungen beeinflussen. Zudem werden sie in der Lage sein, komplexe Zusammenhänge zwischen Verkehrsinfrastruktur, -kosten und -nachfrage zu analysieren und zu verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10Q_vYFYsCzJA" ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentlicher_Personenverkehr>,
        <http://example.org/education/concept/G%C3%BCterverkehr>,
        <http://example.org/education/concept/Individualverkehr>,
        <http://example.org/education/concept/Mobilit%C3%A4t>,
        <http://example.org/education/concept/Nachfrageelastizit%C3%A4t>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Transport%C3%B6konomie>,
        <http://example.org/education/concept/Verkehrsinfrastruktur>,
        <http://example.org/education/concept/Verkehrspolitik>,
        <http://example.org/education/concept/Verkehrswirtschaft> ;
    dcterms:title "Einführung in die Verkehrswirtschaft"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10WLJMwIX2yhI a edu:LearningResource ;
    sim:similarTo oer:10fE9T_BrWOH8,
        oer:10i3d5lfIuccQ,
        oer:3ZI6EEHc4jsA,
        oer:4BP4tOj8Ac8o,
        oer:4FN-kXzKfdhs,
        oer:4J20iGKDyYXM,
        oer:4RWDgADFJM0s,
        oer:94ZYPxfRvo7A,
        oer:9RG4fLavla58 ;
    dcterms:creator <http://example.org/education/person/Walter> ;
    dcterms:description "Dieses Dokument beschreibt die Gebührenordnung für zahnärztliche Leistungen (GOZ) und enthält eine umfassende Auflistung von funktionsanalytischen und funktionstherapeutischen Leistungen, Implantatinsertionen und anderen zahnmedizinischen Verfahren. Durch das Studium dieses Dokuments können Lernende die verschiedenen Gebührenpositionen und Leistungsbeschreibungen der GOZ kennenlernen und ihre Kenntnisse über die zahnärztliche Versorgung erweitern. Die detaillierten Beschreibungen der einzelnen Leistungen ermöglichen es den Lernenden, sich auf die Anforderungen der täglichen Praxis vorzubereiten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10WLJMwIX2yhI" ;
    dcterms:subject <http://example.org/education/concept/Alveolarfortsatz>,
        <http://example.org/education/concept/Implantologie>,
        <http://example.org/education/concept/Kieferorthop%C3%A4die>,
        <http://example.org/education/concept/Knochengewebe>,
        <http://example.org/education/concept/Mund-Kiefer-Gesichtschirurgie>,
        <http://example.org/education/concept/Prothetik>,
        <http://example.org/education/concept/Sinuslift>,
        <http://example.org/education/concept/Zahnersatz>,
        <http://example.org/education/concept/Zahnheilkunde>,
        <http://example.org/education/concept/Zahnimplantat> ;
    dcterms:title "GEBÜHRENTEIL J GOZ Funktionsanalytische und Funktionstherapeutische Leistungen"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

