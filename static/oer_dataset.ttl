        oer:7SS2QkPqRG-o,
        oer:7ohmtOd8ipAE,
        oer:7v8U2x8tGrOU ;
    dcterms:creator <http://example.org/education/person/%C3%96hmann> ;
    dcterms:description "Der französische Einfluss auf die deutsche Sprache im Mittelalter wird untersucht, insbesondere die Verbreitung von Lehnwörtern aus dem Französischen in der höfischen Dichtung und Literatur. Durch die Analyse von Texten und Wörtern können Leser die Entwicklung der deutschen Sprache und ihre Beziehungen zu anderen europäischen Sprachen besser verstehen. Die Kenntnis dieser historischen Einflüsse kann zudem das Verständnis moderner Deutsch helfen, indem sie die Herkunft bestimmter Wörter und Ausdrücke aufzeigt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "129t2qHvuQH-s" ;
    dcterms:publisher <http://example.org/education/organization/Helsinki> ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprachegeschichte>,
        <http://example.org/education/concept/Deutschsprachige_Literatur>,
        <http://example.org/education/concept/Franz%C3%B6sische_Sprache>,
        <http://example.org/education/concept/H%C3%B6fische_Kultur>,
        <http://example.org/education/concept/Lehnw%C3%B6rter>,
        <http://example.org/education/concept/Literarischer_Einfluss>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Ritterepen>,
        <http://example.org/education/concept/Sprachkontakt>,
        <http://example.org/education/concept/Volksb%C3%BCcher> ;
    dcterms:title "Der französische Einfluss auf die deutsche Sprache im Mittelalter"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

