        <http://example.org/education/concept/Kollaboration>,
        <http://example.org/education/concept/Kommunikation>,
        <http://example.org/education/concept/Kooperation>,
        <http://example.org/education/concept/Synchrone_und_Asynchrone_Kommunikation>,
        <http://example.org/education/concept/Webbasierte_Kommunikation> ;
    dcterms:title "Didaktische Einordnung Kollaboration Kooperation Kommunikation"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6PMCY2RlcE_U a edu:LearningResource ;
    sim:similarTo oer:6q9SL6pOd1vg,
        oer:9I85MhM-HLRQ ;
    dcterms:creator <http://example.org/education/person/Hellbach> ;
    dcterms:description "Das Lehrmaterial behandelt die Konzeption und Bepflanzung von Außenräumen im Kontext der Landschaftsarchitektur, wobei Schwerpunkt auf der Auswahl und Kombination von Pflanzenarten liegt, um bestimmte Atmosphären und Funktionen zu erzielen. Durch das Studium dieses Materials können Lernende Kenntnisse über verschiedene Bepflanzungstypen, Farbkonzepte und räumliche Anordnungen erwerben, um eigene Entwürfe für Außenräume zu entwickeln. Zudem werden wichtige Aspekte wie Schattenanalyse, Vegetationsprofil und Moodboard-Entwicklung behandelt, die für eine erfolgreiche Umsetzung von Bepflanzungskonzepten erforderlich sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6PMCY2RlcE_U" ;
    dcterms:subject <http://example.org/education/concept/Bepflanzungsplan>,
        <http://example.org/education/concept/Ereigniskalender>,
        <http://example.org/education/concept/Farbkonzept>,
        <http://example.org/education/concept/Gartenbau>,
        <http://example.org/education/concept/Landschaftsplanung>,
        <http://example.org/education/concept/Moodboard>,
        <http://example.org/education/concept/Pflanzenverwendung>,
        <http://example.org/education/concept/Raumgestaltung>,
        <http://example.org/education/concept/Schattenanalyse>,
        <http://example.org/education/concept/Vegetationsprofil> ;
    dcterms:title "Lehr- und Forschungsgebiet Pflanzenverwendung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6bxWLsVg26_Y a edu:LearningResource ;
    sim:similarTo oer:8D3UPWaWODp4,
        oer:8fyJGPc55dRw ;
    dcterms:creator <http://example.org/education/person/Pietsch> ;
    dcterms:description "Die Vorlesung Sanierungsbergbau behandelt die Sanierung von Altlasten und Bergschäden, insbesondere am Standort Deuben und Schwarze Pumpe, und präsentiert verschiedene Maßnahmen zur Boden- und Grundwassersanierung. Durch die Lektüre dieser Vorlesung können Studierende Kenntnisse über Sanierungsverfahren, -konzepte und -maßnahmen erwerben, um Bergschäden zu beseitigen und die Umwelt zu schützen. Die Vorlesung bietet einen Überblick über die Historie, Ziele und Methoden der Sanierungsbemühungen in den genannten Standorten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6bxWLsVg26_Y" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Altlasten>,
        <http://example.org/education/concept/Bergschaden>,
        <http://example.org/education/concept/Bodenaustausch>,
        <http://example.org/education/concept/Bodenreinigung>,
        <http://example.org/education/concept/Geotechnik>,
        <http://example.org/education/concept/Grundwasserreinigung>,
        <http://example.org/education/concept/Rekultivierung>,
        <http://example.org/education/concept/Sanierungsbergbau>,
        <http://example.org/education/concept/Umweltsanierung>,
        <http://example.org/education/concept/Wasserrecht> ;
    dcterms:title "Vorlesung Sanierungsbergbau Sommersemester 2023 TU Bergakademie Freiberg"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6cmqecRTYKxE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Herzog> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Lösung von Optimierungsaufgaben mit Nebenbedingungen durch Straftermverfahren und Augmentierte Lagrange-Verfahren. Es werden die Formen der Penalty-Funktionen und die Vorgehensweise bei der Lösung dieser Aufgaben erläutert. Durch das Studium dieses Materials können Lernende die Grundlagen von Straftermverfahren und Augmentierten Lagrange-Verfahren verstehen und anwenden, um Optimierungsprobleme zu lösen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6cmqecRTYKxE" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Lagrange-Verfahren>,
        <http://example.org/education/concept/Nebenbedingungen>,
        <http://example.org/education/concept/Operationsforschung>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Penalty-Funktion>,
        <http://example.org/education/concept/Straftermverfahren>,
        <http://example.org/education/concept/lineare_Optimierung>,
        <http://example.org/education/concept/mathematische_Programmierung>,
        <http://example.org/education/concept/nichtlineare_Optimierung>,
        <http://example.org/education/concept/numerische_Mathematik> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6lwC9vNEdM84 a edu:LearningResource ;
    sim:similarTo oer:80wAKcqR3A6Y,
        oer:8OS6hijxen1w,
        oer:8nQgLPwKyxec,
        oer:8wntomkrcr6g ;
    dcterms:creator <http://example.org/education/person/Wurst> ;
    dcterms:description "InstaHub.org ist eine Plattform, die Schülerinnen und Schülern ermöglicht, ein soziales Netzwerk zu gestalten und Datenbanken zu verwalten, um Kompetenzen im Bereich von Datenbanken, sozialen Netzwerken und Werbung zu erwerben. Durch die Arbeit mit InstaHub können Lerner das Entity-Relationship-Modell kennenlernen, einfache Datenbasen modellieren und eine Datenbanksprache anwenden, um eine Datenbank zu verwalten. Darüber hinaus können sie den Umgang mit ihren Daten in sozialen Netzwerken diskutieren und die Macht und Möglichkeiten eines Datenbankadministrators einschätzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6lwC9vNEdM84" ;
    dcterms:subject <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Entity-Relationship-Modell>,
