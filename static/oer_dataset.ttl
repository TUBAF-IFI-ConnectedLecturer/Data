    dcterms:creator <http://example.org/education/person/Klose> ;
    dcterms:description "Das Material behandelt den Beweis des Satzes des Thales im Mathematikunterricht der 7. Klasse und fördert die Fachkompetenz, Methodenkompetenz und Selbstkompetenz der Lernenden. Durch das Screencast und das Arbeitsblatt können die Schülerinnen und Schüler den Beweis nachvollziehen, ihre Strategie des direkten Beweises entwickeln und mathematisch argumentieren. Das Material unterstützt die Lernenden bei der Erarbeitung ihrer Kompetenzen im Bereich Geometrie in der Ebene."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10C5pdYePSoq8" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Beweis>,
        <http://example.org/education/concept/Fachkompetenz>,
        <http://example.org/education/concept/GeoGebra>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Lernen_mit_digitalen_Medien>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Mathematische_Kompetenz>,
        <http://example.org/education/concept/Methodenkompetenz>,
        <http://example.org/education/concept/Satz_des_Thales>,
        <http://example.org/education/concept/Selbstkompetenz> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

