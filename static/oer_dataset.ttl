oer:7MWboFHzyRN4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Covila>,
        <http://example.org/education/person/H%C3%A4nicke>,
        <http://example.org/education/person/Hadamzick> ;
    dcterms:description "Der Stadtteil Löbtau in Dresden entwickelte sich von einem Bauerndorf zu einer Wohn- und Industriegemeinde, geprägt durch die Industrialisierung im 19. Jahrhundert und die Eingemeindung nach Dresden 1903. Durch die Geschichte und Entwicklung des Stadtteils werden die verschiedenen Aspekte der Stadtplanung und -entwicklung verdeutlicht, wie zum Beispiel die Bedeutung von Grünflächen, öffentlichen Bauten und Infrastruktur für die Wohnqualität. Die Lektüre bietet Einblick in die Geschichte und Entwicklung eines Stadtteils und vermittelt Kenntnisse über die Faktoren, die die Stadtplanung beeinflussen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7MWboFHzyRN4" ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentlicher_Nahverkehr>,
        <http://example.org/education/concept/DDR-Architektur>,
        <http://example.org/education/concept/Denkmalschutz>,
        <http://example.org/education/concept/Gr%C3%BCnderzeitarchitektur>,
        <http://example.org/education/concept/Gr%C3%BCnfl%C3%A4chenplanung>,
        <http://example.org/education/concept/St%C3%A4dtebau>,
        <http://example.org/education/concept/Stadterneuerung>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Verkehrspolitik>,
        <http://example.org/education/concept/Wohnungsbaupolitik> ;
    dcterms:title "GSEducationalVersion Seite Professur für Städtebau I Städtebau II Übung 1 Dresden Löbtau"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7OwZtCo2VbVg a edu:LearningResource ;
    dcterms:description "Das Bild beschreibt den physikalischen Prozess des Einschaltens eines Lichtbogens und erläutert die Vorgänge während der Entladung. Der Text behandelt die Instabilität von Lawinenentladungen und ihre Auswirkungen auf die Umgebung. Durch das Studium dieses Bildes können Lernende physikalische Prozesse besser verstehen und die Gefahren von Lawinenentladungen erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7OwZtCo2VbVg" ;
    dcterms:subject <http://example.org/education/concept/Elektrotechnik>,
