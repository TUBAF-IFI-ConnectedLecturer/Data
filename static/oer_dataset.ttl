oer:9wGaieWzAOd0 a edu:LearningResource ;
    sim:similarTo oer:9xEOKMBLiQXI ;
    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von Bahnfahrzeugen wird durch die Leistungsübertragung bestimmt, die wiederum von der Art des Antriebs und der Übertragungstechnologie abhängt. Durch das Verständnis dieser Zusammenhänge können Studierende die Fahrdynamischen Charakteristiken von Bahnfahrzeugen analysieren und optimieren. Die Vorlesung behandelt verschiedene Arten von Leistungsübertragungen, einschließlich mechanischer, hydraulischer, elektrischer und hydrodynamischer Übertragungen, um die Studierenden mit dem notwendigen Wissen für die Entwicklung und den Einsatz von Bahnfahrzeugen auszustatten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9wGaieWzAOd0" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Elektrische_Bahnen> ;
    dcterms:subject <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Drehstromantriebe>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Elektrotraktion>,
        <http://example.org/education/concept/Gleichstromantriebe>,
        <http://example.org/education/concept/Hydrodynamische_Antriebe>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Schienenfahrzeugtechnik>,
        <http://example.org/education/concept/Triebfahrzeuge>,
        <http://example.org/education/concept/Zugkraft%C3%BCbertragung> ;
    dcterms:title "Fahrdynamik Bahnfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8nXUhBfW2uUQ a edu:LearningResource ;
