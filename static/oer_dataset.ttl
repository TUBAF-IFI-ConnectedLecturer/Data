        oer:14umgRR7A705o,
        oer:7jzqVYSuU-qk,
        oer:7pM26d_aLADM ;
    dcterms:creator <http://example.org/education/person/Hacker> ;
    dcterms:description "Die Diskussion um den Begriff \"Grundbestand\" in Bibliotheken zeigt, dass es keine einheitliche Definition gibt und jede Einrichtung ihren eigenen Grundbestand definiert. Der Grundbestand ist abhängig von der Leserschaft, Regionalität und dem Erwerbungskonzept einer Bibliothek. Durch die Kenntnis des Grundbestandes können Bibliothekare sicherstellen, dass sie alle wichtigen Medien im Bestand haben und diese für ihre Nutzer verfügbar machen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11qHrDb5s-92A" ;
    dcterms:subject <http://example.org/education/concept/Archivierung>,
        <http://example.org/education/concept/Bibliothek>,
        <http://example.org/education/concept/Erwerbungskonzept>,
