    dcterms:description "Das Lernszenario behandelt die Sortieralgorithmen Bubblesort und Quicksort für Schüler der 11./12. Klasse im Fach Informatik. Durch die interaktive Präsentation, LearningApp und Programmierübung können die Schüler ihr Wissen über Algorithmen anwenden, ihre Selbstkompetenz fördern und die Sortieralgorithmen verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3hRxvgno4Xyc" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Bubblesort>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Digital_Lernen>,
        <http://example.org/education/concept/Game-based_Learning>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Lehrplanentwicklung>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Quicksort>,
        <http://example.org/education/concept/Sortieralgorithmen> ;
    dcterms:title "Fachseminar Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:7NWNUT6XPgXA a edu:LearningResource ;
    sim:similarTo oer:8394JVb2Sy_E,
        oer:8D_aAB-c5ok0,
        oer:8KphU5s6MJZQ,
        oer:8OTiIMWePGR4,
        oer:8c-80cDbnMX8,
        oer:8sTG35VRIK7Q,
        oer:9ZbxarbRc8xs,
        oer:9ysxFnUUqULY ;
    dcterms:creator <http://example.org/education/person/Rohland>,
        <http://example.org/education/person/Sebastian_Michalowski_Vates> ;
    dcterms:description "Die virtuelle Lernumgebung \"Logikgatter\" bietet eine umfassende Wiederholung von Inhalten der logischen Schaltungen und Gatter, um Universitäten und Schulen zu entlasten und den Kursteilnehmern das Erlangen von Wissen und Können auf diesem Themengebiet zu erleichtern. Durch die gezielte Steuerung des Lernenden ist ein Wissenserwerb der wichtigsten Inhalte sichergestellt, und die Nutzung des Tools am Ende der VLU bietet eine praktische Anwendung des eben gelernten Wissens. Die Lernumgebung ermöglicht es den Kursteilnehmern, die grundlegende Funktionsweise von Gattern zu verstehen, Symbole und Fachbegriffe zu kennen und logische Schaltungen aufzubauen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7NWNUT6XPgXA" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Didaktisches_Modell>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Gatter>,
        <http://example.org/education/concept/Informatikdidaktik>,
        <http://example.org/education/concept/Logische_Schaltungen>,
        <http://example.org/education/concept/Onlinetests>,
        <http://example.org/education/concept/Physikunterricht>,
        <http://example.org/education/concept/Selbstlernkurs>,
        <http://example.org/education/concept/Stromkreis>,
        <http://example.org/education/concept/Virtuelle_Lernumgebung> ;
    dcterms:title "Dokumentation der virtuellen Lernumgebung Logikgatter"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

