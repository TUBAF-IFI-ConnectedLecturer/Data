        <http://example.org/education/concept/Schnittkraft>,
        <http://example.org/education/concept/Schubtragf%C3%A4higkeit>,
        <http://example.org/education/concept/Windlast> ;
    dcterms:title "Bemessung Horizontale Lasten und Aussteifung"@de ;
