    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von Schienenfahrzeugen und konzentriert sich auf den Luftwiderstand als einen wichtigen Faktor für die Fahrzeugbewegung. Durch die Lektüre dieser Unterlagen können Studierende die grundlegenden Konzepte des Luftwiderstands, seine Einflussfaktoren und Berechnungsverfahren verstehen. Zudem werden sie in die Lage versetzt, den Luftwiderstand bei verschiedenen Zugtypen und Tunnelkonfigurationen zu analysieren und zu bewerten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "16AQ9e3t7-cSU" ;
    dcterms:subject <http://example.org/education/concept/Aerodynamik>,
        <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Eisenbahntechnik>,
        <http://example.org/education/concept/Energieeffizienz>,
        <http://example.org/education/concept/Fahrwiderstand>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Luftwiderstand>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Traktion>,
        <http://example.org/education/concept/Zugfahrtsimulation> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

