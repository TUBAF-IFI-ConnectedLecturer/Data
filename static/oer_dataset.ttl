oer:7J0AvcaryQOY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Lernpaket behandelt theoretische Verteilungsfunktionen, insbesondere die Normalverteilung und ihre Eigenschaften, sowie die Umrechnung auf standardisierte Verteilungen. Es werden auch andere Verteilungstypen wie Lognormal- und Extremwertverteilungen erläutert und ihre Anwendungsbereiche genannt. Durch das Lernpaket können Studierende ihr Verständnis von Wahrscheinlichkeitspapieren und statistischen Konzepten verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7J0AvcaryQOY" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_f%C3%BCr_Elektrotechnik_und_Informationstechnik> ;
