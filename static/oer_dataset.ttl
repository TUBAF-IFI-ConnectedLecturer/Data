        <http://example.org/education/concept/Str%C3%B6mungsklassierung>,
        <http://example.org/education/concept/Str%C3%B6mungsmechanik>,
        <http://example.org/education/concept/Turbulenz> ;
    dcterms:title "Strömungsprobleme der Mechanischen Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

