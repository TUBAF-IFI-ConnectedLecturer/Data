    dcterms:creator <http://example.org/education/person/Braun> ;
    dcterms:description "Die Vorlesung behandelt die Konzepte von Microservices und DevOps, einschließlich ihrer Architekturen, Entwicklung und Verteilung in Cloud-Umgebungen. Durch das Studium dieser Materialien können Lernende die Grundlagen von Microservices und DevOps verstehen und erfahren, wie sie diese Konzepte in der Praxis anwenden können. Zudem werden Beispiele für die Implementierung von Microservices und die Verwendung von Tools wie Netflix Spring Cloud und GitLab Pipeline vorgestellt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10AJpQjjYL3zs" ;
    dcterms:subject <http://example.org/education/concept/Agile_Entwicklung>,
        <http://example.org/education/concept/Architektur>,
