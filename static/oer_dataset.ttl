oer:37ylriOxjN3s a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Menzel> ;
    dcterms:description "Die Topologie ist ein mathematisches Fachgebiet, das sich mit den Eigenschaften von Räumen und Objekten beschäftigt, die unter kontinuierlichen Verformungen erhalten bleiben. Durch das Studium der Topologie können Lernende ein tieferes Verständnis davon erlangen, wie komplexe Objekte in einfache Bestandteile zerlegt werden können, um ihre Struktur und Eigenschaften zu analysieren. Dies ermöglicht die Anwendung topologischer Konzepte in verschiedenen Bereichen, wie der Computer-Aided-Geometric-Design oder der Computational Geometry, um komplexe Probleme zu lösen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "37ylriOxjN3s" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Modellierung>,
        <http://example.org/education/concept/Computational_Geometry>,
        <http://example.org/education/concept/Computer-Aided_Design>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Inzidenzrelation>,
        <http://example.org/education/concept/Manifold>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Topologie>,
        <http://example.org/education/concept/Topologische_Transformation>,
        <http://example.org/education/concept/Zellularer_Partition> ;
    dcterms:title "Elemente der Topologie"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

