        <http://example.org/education/concept/Wald> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5ndwoOjSCbvg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Wieser> ;
    dcterms:description "Die Ermittlungen in alle Richtungen werden fortgesetzt, um den Verbleib der Figur des D. Knappe aufzuklären. Die Learner müssen entscheiden, ob sie die ressourcenaufwändige Suche fortsetzen oder ein asiatisches Duplikat mit einer Lieferzeit von 4 Wochen in Auftrag geben sollen. Durch diese Entscheidung lernen sie, zwischen Fake-Duplikaten und teurem Handwerk zu unterscheiden und die Tradition sowie die Existenz ihrer Handwerkskunst zu schätzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5ndwoOjSCbvg" ;
    dcterms:subject <http://example.org/education/concept/Erzgebirge.>,
