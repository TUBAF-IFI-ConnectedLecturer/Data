    dcterms:creator <http://example.org/education/person/Heck> ;
    dcterms:description "Die Lernenden können durch dieses Material die Zahlen von 1 bis 100 auf Russisch aufsagen und den Zahlenwert von Zahlwörtern erkennen. Durch vier Übungen in aufsteigender Schwierigkeit werden die Methodenkompetenzen gefördert, geschriebene Zahlwörter und Zahlen passend zuzuordnen. Die Selbstkompetenz wird durch die selbstständige Arbeit mit der Präsentation unterstützt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "17iHDQLMPPMdc" ;
