    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die Fertigungsplanung in der additiven Fertigung umfasst die Planung und Steuerung des Fertigungsprozesses, einschließlich der Materialauswahl, -lagerung und -kreislauf, sowie der Optimierung von Bauteilen und Prozessen. Durch das Studium dieser Inhalte können Lernende Kenntnisse über die additiven Fertigungstechnologien und ihre Anwendung in verschiedenen Branchen erwerben. Zudem werden sie in die Lage versetzt, effiziente und nachhaltige Fertigungsprozesse zu planen und umzusetzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12eB4bcz0Uulk" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Biokunststoffe>,
        <http://example.org/education/concept/Computer-Aided_Design>,
        <http://example.org/education/concept/Fertigungsplanung>,
        <http://example.org/education/concept/Kreislaufwirtschaft>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Produktionsplanung>,
        <http://example.org/education/concept/Rapid_Prototyping>,
        <http://example.org/education/concept/Werkstoffwissenschaft> ;
    dcterms:title "Fertigungsplanung in der Additiven Fertigung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

