        <http://example.org/education/concept/Raumbezug>,
        <http://example.org/education/concept/Vermessung> ;
    dcterms:title "2. Vorlesung Vermessungslehre - Stand: 2024"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

