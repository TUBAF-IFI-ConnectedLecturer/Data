    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die additive Fertigung wird durch die Verwendung von Preprocessing-Techniken ermöglicht, die es ermöglichen, komplexe Geometrien in schichtweise zu zerlegen und somit für den Druck vorzubereiten. Durch das Verständnis dieser Techniken können Lernende die additive Fertigung effizienter einsetzen und Produkte mit komplexen Strukturen herstellen. Die Parametervergabe, Schichtzerlegung und Positionierung spielen dabei eine zentrale Rolle bei der Erzeugung von Bauteilen mit hoher Genauigkeit und Oberflächenqualität."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5e5vOuLkki0I" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Computer-Aided_Design_%28CAD%29>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Geometrische_Modellierung>,
        <http://example.org/education/concept/Oberfl%C3%A4chenqualit%C3%A4t>,
        <http://example.org/education/concept/Parameter%C3%BCbertragung>,
        <http://example.org/education/concept/Positionierung>,
        <http://example.org/education/concept/Rapid_Prototyping>,
        <http://example.org/education/concept/Schichtmodellierung> ;
    dcterms:title "ADDITIVE FERTIGUNG - PREPROCESSING"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8pj3cogt9v9k a edu:LearningResource ;
    sim:similarTo oer:8sTG35VRIK7Q ;
    dcterms:creator <http://example.org/education/person/Kie%C3%9Fling> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Didaktik der Informatik und vermittelt Kenntnisse über die Erstellung von Präsentationen mit PowerPoint. Durch die Anwendung von Animationen, Hyperlinks und Folienabschnitten können komplexe Präsentationen erstellt werden, die eine Vielzahl von Funktionen und Inhalten aufweisen. Am Ende des Lernprozesses sollen die Teilnehmer in der Lage sein, eigene Präsentationen zu erstellen und sich als Master of Presentation zu präsentieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8pj3cogt9v9k" ;
    dcterms:subject <http://example.org/education/concept/Animationsdesign>,
        <http://example.org/education/concept/Bildschirmpr%C3%A4sentation>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Folienmaster>,
        <http://example.org/education/concept/Grafik-Animationen>,
        <http://example.org/education/concept/Hyperlink>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Kioskmodus>,
        <http://example.org/education/concept/Pr%C3%A4sentationstechniken> ;
    dcterms:title "Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

