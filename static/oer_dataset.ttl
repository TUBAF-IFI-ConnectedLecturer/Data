oer:5kzU8xiBGNa0 a edu:LearningResource ;
    sim:similarTo oer:7JC4PIjQU7QQ,
        oer:8EVQufcxbKck,
        oer:8OzHVRGQE5Q8,
        oer:8Vy--T0Sbb2I,
        oer:8melWvLsp4b0,
        oer:9X60e9UzJ1cs ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Partikelmesstechnik\" behandelt die Kennzeichnung von Merkmalsverteilungen und die Anwendung nicht-normierter Partikelgrößenverteilungen in der Verfahrenstechnik. Durch das Studium dieser Materialien können Lernende die Grundlagen der Partikelmesstechnik verstehen, verschiedene Methoden zur Charakterisierung von Partikeln kennenlernen und die Anwendung dieser Methoden in der Praxis nachvollziehen. Insbesondere werden Beispiele aus der Literatur und Fallstudien vorgestellt, um die praktische Relevanz der Partikelmesstechnik zu veranschaulichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5kzU8xiBGNa0" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Dynamische_Lichtstreuung>,
        <http://example.org/education/concept/Elektrische_Mobilit%C3%A4tsAnalyse>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Laserbeugung>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fenverteilung>,
        <http://example.org/education/concept/Partikelmesstechnik>,
        <http://example.org/education/concept/Zentrifugationsanalyse>,
        <http://example.org/education/concept/akademische_Ver%C3%B6ffentlichungen>,
        <http://example.org/education/concept/bibliographische_Katalogisierung>,
        <http://example.org/education/concept/wissenschaftliche_Literatur> ;
    dcterms:title "Fakultät Maschinenwesen Institut für Verfahrenstechnik und Umwelttechnik, AG Mechanische Verfahrenstechnik Lehrveranstaltung Partikelmesstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6WGxpeWqlpiY a edu:LearningResource ;
    sim:similarTo oer:7I6eto_fcIHY,
        oer:7_RxHwW83d2g,
        oer:87UU29VhCFNw,
        oer:8Fvb_vR8Gqco,
        oer:8Nzf3_jmBwfQ,
        oer:8Vrzf7vTIpOw,
        oer:8g2Okf1Bq7tM,
        oer:8sHza3Gtp0KY,
        oer:9NQzyiBVDiIk,
        oer:9Z3Pf-hj8U3A ;
    dcterms:creator <http://example.org/education/person/Fricke> ;
    dcterms:description "Die Neigetechnik ermöglicht es, Kurven mit höheren Geschwindigkeiten zu durchfahren, indem der Wagenkasten in die Kurve geneigt wird, was zu einer Reduzierung der Reisezeit und einer Verbesserung des Fahrkomforts führt. Die Voraussetzungen für bogenschnelles Fahren umfassen die Anpassung der Übergangsbögen, Sicherheitsvorkehrungen bei Ausfall und eine redundante Sensorik und Steuerung. Durch die Neigetechnik können Fahrgäste von einer höheren Reisequalität profitieren, insbesondere auf Strecken mit vielen Kurven."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6WGxpeWqlpiY" ;
    dcterms:publisher <http://example.org/education/organization/EI> ;
    dcterms:subject <http://example.org/education/concept/Bahnanlage>,
        <http://example.org/education/concept/Bogenschnellfahren>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Gleis%C3%BCberh%C3%B6hung>,
        <http://example.org/education/concept/Hochgeschwindigkeitsverkehr>,
        <http://example.org/education/concept/Neigetechnik>,
        <http://example.org/education/concept/Reisezeitoptimierung>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Streckeninfrastruktur> ;
    dcterms:title "Grundlagen Sft: 7. Spezielle Ausrüstungen Neigetechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8E349pg5D4i4 a edu:LearningResource ;
    sim:similarTo oer:8KGSsS03GigI,
        oer:8WscXHl_uNWk,
        oer:8ZXC3ues4hiI,
        oer:8ge_amaTTtBc,
        oer:8mqDmRgDPbLI,
        oer:91u_Sx_XhjMQ,
        oer:9BDND88Y2yQA,
        oer:9tCsH9JHkET0 ;
    dcterms:creator <http://example.org/education/person/Kowalzik> ;
    dcterms:description "Die Hausaufgabe behandelt drei Aufgaben zur Matrizenrechnung und linearen Algebra, bei denen die Lösungen schrittweise entwickelt werden. Durch das Lösen dieser Aufgaben können Studierende ihre Fähigkeiten in der Berechnung von Matrixprodukten, der Lösung von Gleichungssystemen und der Bestimmung von Matrizen verbessern. Die Aufgaben umfassen die Berechnung von Matrixpotenzen, die Lösung eines linearen Gleichungssystems und die Bestimmung einer Matrix, die mit einer gegebenen Matrix verknüpft ist."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8E349pg5D4i4" ;
    dcterms:publisher <http://example.org/education/organization/LAG> ;
    dcterms:subject <http://example.org/education/concept/Einheitsmatrix>,
        <http://example.org/education/concept/Eliminationsverfahren>,
        <http://example.org/education/concept/Gauss-Jordan-Verfahren>,
        <http://example.org/education/concept/Gleichungssysteme>,
        <http://example.org/education/concept/Induktion>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Matrixmultiplikation>,
        <http://example.org/education/concept/Matrizen>,
        <http://example.org/education/concept/Vektoren>,
        <http://example.org/education/concept/komplexe_Zahlen> ;
    dcterms:title "LAG N2.1 Hausaufgabe"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9X60e9UzJ1cs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Babick>,
        <http://example.org/education/person/Gail>,
        <http://example.org/education/person/Gommel> ;
    dcterms:description "Die Vorlesung \"Reine Technologien\" behandelt die Messmethoden und -geräte für Aerosole, einschließlich gravimetrischer, photometrischer und elektrischer Verfahren, um Partikelgrößenverteilungen und Konzentrationen zu bestimmen. Durch das Studium dieser Materialien können Lernende die Prinzipien und Ausführungen von verschiedenen Messmethoden verstehen und anwenden, um Aerosole in verschiedenen Anwendungen zu charakterisieren. Die Kenntnis dieser Methoden ist für die Prozesskontrolle, Luftqualitätsmessung und Expositionsbestimmung von Bedeutung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9X60e9UzJ1cs" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen_Institut_f%C3%BCr_Verfahrenstechnik_und_Umwelttechnik> ;
    dcterms:subject <http://example.org/education/concept/Aerosolmesstechnik>,
        <http://example.org/education/concept/Aerosolzentrifugen>,
        <http://example.org/education/concept/Elektrometer>,
        <http://example.org/education/concept/Filtration>,
        <http://example.org/education/concept/Gravimetrische_Methoden>,
        <http://example.org/education/concept/Kondensationskernz%C3%A4hler>,
        <http://example.org/education/concept/Luftqualit%C3%A4t>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fenverteilung>,
        <http://example.org/education/concept/Photometrische_Methoden>,
        <http://example.org/education/concept/Umweltaerosole> ;
    dcterms:title "Reine Technologien"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9mPIG_CuYCtw a edu:LearningResource ;
    sim:similarTo oer:9o2uVOV3V5MY,
        oer:9wGQwH-t-3K8 ;
    dcterms:creator <http://example.org/education/person/Germershaus> ;
    dcterms:description "Die Selbstlernpräsentation vermittelt grundlegendes Wissen über Energie und unterscheidet die Energieformen potentiell und kinetisch, um Schülern das Verständnis von Energieumwandlung und -übertragung zu ermöglichen. Durch Animationen und Diagramme können sie den Prozess der Energieumwandlung langsam wiedergeben und simultan quantitativ betrachten. Die Selbstlernpräsentation eignet sich für die individuelle Wiederholung oder Zusammenfassung in späteren Klassenstufen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9mPIG_CuYCtw" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
