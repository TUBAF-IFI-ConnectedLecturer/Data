        <http://example.org/education/concept/Plasmapolymerisation>,
        <http://example.org/education/concept/Schleifen_und_Polieren> ;
    dcterms:title "Additive Fertigung Sommersemester 2020"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

