    dcterms:creator <http://example.org/education/person/Babick>,
        <http://example.org/education/person/Wessely> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der mechanischen Verfahrenstechnik, insbesondere die Durchströmten und fluidisierten Schüttungen, Wirbelschichten und ihre Anwendungen in verschiedenen Prozessen wie Trocknung, Granulation, Beschichtung und Verbrennung. Die Lernenden erhalten Einblick in die Berechnungsgleichungen und Zustandsdiagramme von Wirbelschichten sowie ihre Erscheinungsformen und Anwendungsbereiche. Durch das Studium dieser Vorlesung können die Lernenden die physikalischen Grundlagen und technischen Anwendungen von Wirbelschichten verstehen und in der Praxis anwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4FNOx1_Svn9w" ;
    dcterms:subject <http://example.org/education/concept/Chemische_Reaktionen>,
        <http://example.org/education/concept/Fluidisierung>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Partikeltechnologie>,
        <http://example.org/education/concept/Prozesssimulation>,
        <http://example.org/education/concept/Sch%C3%BCttgutverhalten>,
        <http://example.org/education/concept/Stoffaustausch>,
        <http://example.org/education/concept/Str%C3%B6mungsmechanik>,
        <http://example.org/education/concept/W%C3%A4rme%C3%BCbertragung>,
        <http://example.org/education/concept/Wirbelschichten> ;
    dcterms:title "Grundlagen der Mechanischen Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:54xbykdMnCOg a edu:LearningResource ;
    sim:similarTo oer:561qmu8RWCmg,
        oer:5TePYc-kiYw0,
        oer:5kfrY6hp_Y94,
        oer:5kzU8xiBGNa0,
        oer:8EVQufcxbKck,
        oer:8OzHVRGQE5Q8,
        oer:8Vy--T0Sbb2I,
        oer:8melWvLsp4b0,
        oer:9X60e9UzJ1cs ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Partikelmesstechnik\" behandelt die Grundlagen und Anwendungen der Partikelmesstechnik im Kontext der Verfahrenstechnik, einschließlich der Charakterisierung disperser Systeme, der Einflüsse auf die Produktqualität und der technischen Relevanz disperser Eigenschaften. Durch das Studium dieser Vorlesung können Lernende ein Verständnis dafür entwickeln, wie die Partikelgröße und -form den Dispersitätszustand und die Eigenschaften von Suspensionen beeinflussen. Zudem werden sie in der Lage sein, Produkt- und Prozessmodelle zu erstellen und die Aufgaben der Partikelmesstechnik in verschiedenen Anwendungsbereichen zu identifizieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "54xbykdMnCOg" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen_Institut_f%C3%BCr_Verfahrenstechnik_und_Umwelttechnik> ;
    dcterms:subject <http://example.org/education/concept/Agglomerierung>,
        <http://example.org/education/concept/Disperse_Systeme>,
        <http://example.org/education/concept/Flie%C3%9Fverhalten>,
        <http://example.org/education/concept/Granulometrie>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Partikelmesstechnik>,
        <http://example.org/education/concept/Porosit%C3%A4t>,
        <http://example.org/education/concept/Suspensionen>,
        <http://example.org/education/concept/Umwelttransport.> ;
    dcterms:title "Folie 7 LV: Partikelmesstechnik Frank Babick, AG Mechanische Verfahrenstechnik, 2024"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5TePYc-kiYw0 a edu:LearningResource ;
    sim:similarTo oer:5kzU8xiBGNa0,
        oer:7JC4PIjQU7QQ,
        oer:8EVQufcxbKck,
        oer:8OzHVRGQE5Q8,
        oer:9X60e9UzJ1cs ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Partikelmesstechnik\" behandelt die Kennzeichnung von Merkmalsverteilungen und die grafische Darstellung von Partikelgrößenverteilungen, einschließlich der logarithmischen Normalverteilung und anderer Verteilungsfunktionen. Durch das Studium dieser Materialien können Lernende die verschiedenen Methoden zur Beschreibung von Partikelsystemen verstehen und anwenden, um die Eigenschaften von Partikeln zu charakterisieren. Die Kenntnis dieser Konzepte ist für die Analyse und Charakterisierung von Partikelsystemen in verschiedenen wissenschaftlichen Disziplinen von großer Bedeutung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5TePYc-kiYw0" ;
    dcterms:subject <http://example.org/education/concept/Momente>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fenverteilung>,
        <http://example.org/education/concept/Partikelmesstechnik>,
        <http://example.org/education/concept/Sauter-Durchmesser>,
        <http://example.org/education/concept/Tr%C3%A4gheitsmoment>,
        <http://example.org/education/concept/Verfahrenstechnik>,
        <http://example.org/education/concept/logarithmische_Normalverteilung>,
        <http://example.org/education/concept/mittlere_Partikelgr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/polydisperse_Systeme>,
        <http://example.org/education/concept/volumengewichteter_Erwartungswert> ;
    dcterms:title "Fakultät Maschinenwesen Institut für Verfahrenstechnik und Umwelttechnik, AG Mechanische Verfahrenstechnik Lehrveranstaltung Partikelmesstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

