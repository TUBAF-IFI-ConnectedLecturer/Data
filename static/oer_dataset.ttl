oer:7YIsfs57owuM a edu:LearningResource ;
    sim:similarTo oer:7v8U2x8tGrOU,
        oer:8Qx2WQd_ANdI ;
    dcterms:creator <http://example.org/education/person/Coseriu>,
        <http://example.org/education/person/Frank-Job>,
        <http://example.org/education/person/Labov> ;
    dcterms:description "Die Bedeutung von Diskurstraditionen für die Sprachwandelforschung wird untersucht, um die Verbindung zwischen sprachexternen Faktoren und sprachlichen Wandelerscheinungen zu erklären. Durch die Analyse der Diskurstraditionen können die im Kommunikationsakt beteiligten Instanzen und ihre sich wandelnden Interessen und Bedürfnisse berücksichtigt werden, um wesentliche Elemente zur Erklärung von Sprachwandelprozessen zu erhalten. Die Untersuchung der Diskurstraditionen ermöglicht es, die Entwicklung historischer Einzelsprachen und ihres Varietätengefüges besser zu verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7YIsfs57owuM" ;
    dcterms:subject <http://example.org/education/concept/Diskursanalyse>,
        <http://example.org/education/concept/Historische_Linguistik>,
        <http://example.org/education/concept/Kommunikationstheorie>,
        <http://example.org/education/concept/Latein>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Romanische_Sprachen>,
        <http://example.org/education/concept/Soziolinguistik>,
        <http://example.org/education/concept/Sprachkontakt>,
        <http://example.org/education/concept/Sprachwandel>,
        <http://example.org/education/concept/Variet%C3%A4tlinguistik> ;
    dcterms:title "Sprachwandel und Sprachvariation: Zur Bedeutung von Diskurstraditionen für die Sprachwandelforschung"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:8Qx2WQd_ANdI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Lasch>,
        <http://example.org/education/person/Niebaum>,
        <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die Grundlagen der Linguistik und Sprachgeschichte des Deutschen werden in diesem Dokument erläutert, insbesondere die Dimensionen der Variation, wie diastratische, diaphasische, diatopische und diachrone Variation. Durch das Studium dieser Inhalte können Lernende ein Verständnis dafür entwickeln, wie Sprache variiert und wie diese Variationen in verschiedenen Kontexten verwendet werden. Die Erläuterungen zu den Begriffen und Konzepten der Dialektologie des Deutschen ermöglichen es Lernenden, die deutsche Sprache in all ihren Facetten zu verstehen und zu analysieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8Qx2WQd_ANdI" ;
    dcterms:subject <http://example.org/education/concept/Deutsch_als_Fremdsprache>,
        <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Dialekte>,
        <http://example.org/education/concept/Dialektologie>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Linguistische_Terminologie>,
        <http://example.org/education/concept/Soziolinguistik>,
        <http://example.org/education/concept/Sprachgeschichte>,
        <http://example.org/education/concept/Sprachvariation>,
        <http://example.org/education/concept/Variationslinguistik> ;
    dcterms:title "Grundlagen der Linguistik und Sprachgeschichte des Deutschen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

