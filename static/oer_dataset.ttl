        <http://example.org/education/concept/Resampling>,
        <http://example.org/education/concept/Transformationen> ;
    dcterms:title "Grundlagen GIS  TU Bergakademie Freiberg"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

