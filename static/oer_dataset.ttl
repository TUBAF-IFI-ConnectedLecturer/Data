        <http://example.org/education/concept/Nullstellen>,
        <http://example.org/education/concept/Taylor-Reihe>,
        <http://example.org/education/concept/Wirtschaftsmathematik> ;
    dcterms:title "Wirtschaftsmathematik II Hausaufgabe 5"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

