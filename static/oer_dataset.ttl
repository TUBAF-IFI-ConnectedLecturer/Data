    dcterms:title "Einstiegs- und Abschlussgeschichte"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10cXo4klLqHbE a edu:LearningResource ;
    dcterms:description "Die Umkehrrelation und die Komposition zweier Relationen werden definiert und ihre Eigenschaften werden bewiesen. Durch die Anwendung dieser Konzepte auf Beispiele können Lernende das Verständnis von Relationen und ihren Operationen verbessern. Die Lösungen der Aufgaben dienen als Nachweis für die Richtigkeit der Beweise und verdeutlichen die Anwendung der Relationenalgebra in der Mathematik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10cXo4klLqHbE" ;
    dcterms:subject <http://example.org/education/concept/Abstrakte_Algebra>,
        <http://example.org/education/concept/Algebraische_Struktur>,
        <http://example.org/education/concept/Bin%C3%A4re_Relationen>,
        <http://example.org/education/concept/Komposition_von_Relationen>,
        <http://example.org/education/concept/Logik>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Menge>,
