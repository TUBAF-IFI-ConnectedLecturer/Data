    dcterms:type <http://example.org/education/type/Materialhandreichung> .

oer:93TuA_ufL5c8 a edu:LearningResource ;
    sim:similarTo oer:9B75gAUmeMS0,
        oer:9F5_6vfAUMtg,
        oer:9LnXOs6zIBSA,
        oer:9MG0scNtvTqo,
