oer:8TydVEL8Jit8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Grimm> ;
    dcterms:description "Dieses Dokument behandelt die Grundlagen der Programmierung in Java, einschließlich der Deklaration von Variablen, Kontrollstrukturen und Schleifenkonstrukten. Durch das Studium dieses Materials können Lernende die grundlegenden Konzepte der Java-Programmierung verstehen und anwenden, um eigene Programme zu erstellen. Darüber hinaus werden wichtige Aspekte wie Zugriffsmodifikatoren, primitive Typen und Objekttypen erläutert, um eine solide Basis für die weitere Entwicklung von Programmierfähigkeiten zu schaffen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "8TydVEL8Jit8" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Bibliotheksverwaltung>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Informationssysteme>,
        <http://example.org/education/concept/Katalogisierung>,
        <http://example.org/education/concept/Programmiersprache_Java>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/akademische_Literatur>,
        <http://example.org/education/concept/objektorientierte_Programmierung> ;
    dcterms:title "Der Bibliotheksassistent für die bibliographische Katalogisierung und Indexierung."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8WHdX00ey7mg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kuper> ;
    dcterms:description "Diese Übung behandelt die Umwandlung von Dezimal- und Binärzahlen sowie die Konvertierung von Text in ASCII-Binärdarstellung und umgekehrt. Durch das Bearbeiten dieser Aufgaben erwerben Lerner Kenntnisse über die Grundlagen der Datenrepräsentation. Die Übung besteht aus vier Aufgaben, die den Umgang mit Dezimal- und Binärzahlen sowie die Anwendung der ASCII-Tabelle vermitteln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8WHdX00ey7mg" ;
    dcterms:subject <http://example.org/education/concept/ASCII-Tabelle>,
        <http://example.org/education/concept/Bin%C3%A4rzahlen>,
        <http://example.org/education/concept/Computerwissenschaften>,
        <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datenmanagement>,
        <http://example.org/education/concept/Dezimalzahlen>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Textkonvertierung>,
        <http://example.org/education/concept/Zahlensysteme> ;
    dcterms:title "Datenmanagement und Datenbanken SoSe 2022 Übung 2"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8Xro1g-SQaQ8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Spencer> ;
    dcterms:description "Die Nachbereitungsaufgabe behandelt die Anzahl der Teiler von 111111 und die Berechnung der letzten Ziffer einer Zahl mit der Methode Quadrieren und Multiplizieren. Durch die Lösung dieser Aufgaben können Lerner ihr Verständnis für die Teilbarkeit von Zahlen und die Anwendung algebraischer Methoden verbessern. Die Aufgabe bietet eine praktische Übung zur Anwendung mathematischer Konzepte in verschiedenen Kontexten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8Xro1g-SQaQ8" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bin%C3%A4rschreibweise>,
        <http://example.org/education/concept/Dezimalschreibweise>,
        <http://example.org/education/concept/Mathematische_Analyse>,
        <http://example.org/education/concept/Modulo-Rechnung>,
        <http://example.org/education/concept/Multiplizieren>,
        <http://example.org/education/concept/Primzahlen>,
        <http://example.org/education/concept/Quadrieren>,
        <http://example.org/education/concept/Teilbarkeit>,
        <http://example.org/education/concept/Zahlensysteme>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "DS Nachbereitungsaufgabe N5"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8d71J0SwR_XM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Martin_Dei%C3%9Fler> ;
    dcterms:description "Der Aufbau und die Funktionsweise eines Regional Packet-Gateways (LBO) werden beschrieben, um die IoT- und M2M-Kundenanforderungen sowie lokaler und regionaler Restriktionen zu erfüllen. Durch den Einsatz dieses Services soll die Latenz verkürzt und die Erfüllung staatlicher Gesetze garantiert werden. Die Anwendung des Regional Packet-Gateways wird anhand von Beispielen wie Südkorea oder Amerika verdeutlicht, um Navigation und Zugriff auf Daten effizient zu gewährleisten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8d71J0SwR_XM" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_F%C3%BCr_Technik__Wirtschaft_Und_Kultur_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Daten%C3%BCbertragung>,
        <http://example.org/education/concept/IoT>,
        <http://example.org/education/concept/Landesgrenzen>,
        <http://example.org/education/concept/Latenzzeit>,
        <http://example.org/education/concept/M2M>,
        <http://example.org/education/concept/Navigationssysteme>,
        <http://example.org/education/concept/Netzwerkinfrastruktur>,
        <http://example.org/education/concept/Regierungsvorschriften>,
        <http://example.org/education/concept/Round-Trip-Time>,
        <http://example.org/education/concept/Telekommunikation> ;
    dcterms:title "Projektarbeit 2. Fachsemester"@de ;
    dcterms:type <http://example.org/education/type/Projektarbeit> .

