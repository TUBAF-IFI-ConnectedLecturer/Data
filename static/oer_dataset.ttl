    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von Schienenfahrzeugen und vermittelt grundlegende Kenntnisse über Fahrwiderstandskräfte, Antriebskräfte, Traktionsvermögen und Leistungs- und Energiebedarf. Durch das Studium dieser Materialien können Lernende die Notwendigkeit einer Leistungsübertragung verstehen, verschiedene Typen von Leistungsübertragungen wie hydrodynamische, elektrische und mechanische kennenlernen und die Charakterisierung von Dieselmotoren und Drehstromasynchronmaschinen nachvollziehen. Zudem werden wichtige Aspekte wie thermische Robustheit, Umkehr des Leistungsflusses bei Bremsvorgängen und hoher Übertragungswirkungsgrad behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3FLNEKE2mrpI" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_The_Following_Hints_About_The_Author%27s_Institution%3A%2A_%22professur_F%C3%BCr_Technik_Spurgef%C3%BChrter_Fahrzeuge%22_%28professorship_For_Technology_Of_Rail-bound_Vehicles%29%2A_%22sommersemester_2019%22_%28summer_Semester_2019%29the_Prominent_Institution_Mentioned_Is%3A%2A%2Auniversit%C3%A4t%2A%2A_%28no_Specific_University_Name_Is_Given__But_The_Context_Suggests_a_German_University%29> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Dieselmotor>,
        <http://example.org/education/concept/Drehstromasynchronmaschine>,
        <http://example.org/education/concept/Elektromotor>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Hydrodynamische_Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Traktionsverm%C3%B6gen>,
        <http://example.org/education/concept/Zugkraftdiagramm> ;
    dcterms:title "Fahrdynamik für Verkehrsingenieure Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

