        <http://example.org/education/concept/Sedimentationsanalyse>,
        <http://example.org/education/concept/Sinkgeschwindigkeit>,
        <http://example.org/education/concept/Str%C3%B6mungsregime>,
        <http://example.org/education/concept/Suspension> ;
    dcterms:title "Übungsaufgaben Grundlagen der MVT"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

