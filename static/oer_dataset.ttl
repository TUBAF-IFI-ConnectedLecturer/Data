        <http://example.org/education/concept/Raumgeometrie>,
        <http://example.org/education/concept/Scheitelwinkel>,
        <http://example.org/education/concept/Stumpfer_Winkel>,
        <http://example.org/education/concept/Winkel> ;
    dcterms:title "Mathe"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6ukO_NGkYg4o a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/H%C3%A4nicke> ;
    dcterms:description "Der Text beschäftigt sich mit der Beziehung zwischen dem Blick aus dem Fenster und der Wahrnehmung von zwei verschiedenen Welten. Durch den Wechsel des Blicks entsteht ein visueller Eindruck von Vielfalt und Diversität. Der Raum und der Blick stehen in einer wechselseitigen Beziehung, die das Verständnis für die Umwelt fördert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6ukO_NGkYg4o" ;
    dcterms:subject <http://example.org/education/concept/Architektur>,
        <http://example.org/education/concept/Au%C3%9Fenraum>,
        <http://example.org/education/concept/Blickfeld>,
        <http://example.org/education/concept/Fenster>,
        <http://example.org/education/concept/Innenarchitektur>,
        <http://example.org/education/concept/Raumgestaltung>,
        <http://example.org/education/concept/Raumwahrnehmung>,
        <http://example.org/education/concept/Sichtbarkeit>,
        <http://example.org/education/concept/Umgebung>,
        <http://example.org/education/concept/Visuelle_Wahrnehmung> ;
    dcterms:title "Innenarchitektur Übung 0 The world outside"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6ukZmwxl2Ri0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Helmert> ;
    dcterms:description "Die Implementierung eines lock-free Mechanismus für den Schreibzugriff auf Python-Dictionaries ermöglicht eine signifikante Beschleunigung von Numba-kompatiblen Python-Programmen, die viel Zeit mit Schreiboperationen auf Dictionaries verbringen. Durch die Verwendung mehrerer Dictionaries und threadübergreifender Warteschlangen kann der gleichzeitige Schreibzugriff auf dasselbe Dictionary vermieden werden. Die Lösung führt zu einer Steigerung des Datendurchsatzes um 200 und reduziert die Zeit eines Benchmark-Laufes um ca. 33."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6ukZmwxl2Ri0" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Dictionary>,
        <http://example.org/education/concept/Hochleistungsrechnen>,
        <http://example.org/education/concept/Multithreading>,
        <http://example.org/education/concept/Numba>,
        <http://example.org/education/concept/Parallelverarbeitung>,
        <http://example.org/education/concept/Python>,
        <http://example.org/education/concept/Schreibzugriff>,
        <http://example.org/education/concept/Synchronisation> ;
    dcterms:title "Lock-Free Concurrent Python-Numba Dictionary Mutation"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

