        <http://example.org/education/concept/Neorealismus>,
        <http://example.org/education/concept/Sicherheitspolitik>,
        <http://example.org/education/concept/Supermacht> ;
    dcterms:title "Einführung in das Studium der internationalen Beziehungen Proseminar 4 Textanalyse"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

