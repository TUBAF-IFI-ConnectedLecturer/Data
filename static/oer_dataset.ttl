    dcterms:creator <http://example.org/education/person/Bertrand>,
        <http://example.org/education/person/Bombach>,
        <http://example.org/education/person/Riemer> ;
    dcterms:description "Die Übung behandelt Themen der Numerischen Mathematik, insbesondere Vektorfolgen und Stetigkeit von Funktionen, und bietet Aufgaben zur Berechnung von Grenzwerten und Eigenwerten sowie zur Untersuchung der Konvergenz von Vektorfolgen. Durch die Bearbeitung dieser Aufgaben können Lernende ihre Fähigkeiten in der Analyse und Lösung mathematischer Probleme verbessern. Die Übung richtet sich an Studierende der Mathematik im Wintersemester 2023 an der TU Chemnitz."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9FRCCI6SEjxE" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Basisvektoren>,
        <http://example.org/education/concept/Eigenwerte>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Grenzwerte>,
        <http://example.org/education/concept/Konvergenz>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematische_Analyse>,
        <http://example.org/education/concept/Numerische_Mathematik>,
        <http://example.org/education/concept/Stetigkeit>,
        <http://example.org/education/concept/Vektorfolgen> ;
    dcterms:title "Mathematik III (für IF, ET, Ph) Wintersemester 2023"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

