    dcterms:title "Gliederung Exposé"@de ;
    dcterms:type <http://example.org/education/type/Expos%C3%A9> .

oer:4hkUXp37v2Rc a edu:LearningResource ;
    sim:similarTo oer:4oGBsZhMgvpI,
