        oer:9cVKpYXboopo,
        oer:9ysxFnUUqULY ;
    dcterms:creator <http://example.org/education/person/Mathiszik> ;
    dcterms:description "Die Einführung in die Fachdidaktik II behandelt das Thema des problem- und anwendungsorientierten Chemieunterrichts und vermittelt den Studierenden Kenntnisse über die Planung und Gestaltung von Unterrichtseinheiten sowie die Reflexion ihres eigenen Lernprozesses. Durch die Auseinandersetzung mit technischen Systemen, Problemstellungen und Analyseverfahren sollen die Studierenden authentische Problemstellungen entwickeln und ihre methodischen Entscheidungen begründen können. Am Ende des Moduls sollen die Studierenden in der Lage sein, sukzessive eigene Unterrichtskonzepte zur Erschließung chemisch-technischer Inhalte zu gestalten und ihre Lernerfolge kritisch zu evaluieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4oMRgvgozwC8" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Analyseverfahren>,
        <http://example.org/education/concept/Berufsp%C3%A4dagogik>,
        <http://example.org/education/concept/Chemietechnik>,
        <http://example.org/education/concept/Chemieunterricht>,
        <http://example.org/education/concept/Curriculum>,
        <http://example.org/education/concept/Fachdidaktik>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Lernprozess>,
        <http://example.org/education/concept/Reflexion>,
        <http://example.org/education/concept/Selbststudium> ;
    dcterms:title "Einführung SoSe 2024 Fachdidaktik II: Problem- und anwendungsorientierter Chemieunterricht, Teil 1"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

