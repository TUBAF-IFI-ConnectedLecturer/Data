        <http://example.org/education/concept/Teiler>,
        <http://example.org/education/concept/Vollkommene_Zahlen>,
        <http://example.org/education/concept/Zahlenfolgen> ;
    dcterms:title "4.5 Algorithmierung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8kyewbTbXF0g a edu:LearningResource ;
