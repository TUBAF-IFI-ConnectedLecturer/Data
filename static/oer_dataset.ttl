oer:8h0bBWWSX0HI a edu:LearningResource ;
    sim:similarTo oer:8vf1yH7Vt-tg ;
    dcterms:description "Das Calliope mini-Projekt \"Küchenmusik\" ermöglicht es Schülern, ein Musikinstrument aus Alltagsgegenständen zu basteln und die Grundlagen der Elektronik und des Stromkreises zu erlernen. Durch das Projekt können sie erfahren, wie der Stromkreis funktioniert und wie sie ihn nutzen können, um Musik zu spielen. Am Ende des Projekts haben die Schüler ein eigenes Musikinstrument gebaut und grundlegende Kenntnisse über Elektronik und Stromkreise erworben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8h0bBWWSX0HI" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Alltagsgegenst%C3%A4nde>,
        <http://example.org/education/concept/Calliope_mini>,
        <http://example.org/education/concept/Elektronik>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Leitf%C3%A4higkeit>,
        <http://example.org/education/concept/MakeCode-Editor>,
        <http://example.org/education/concept/Musikinstrument>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Schaltung>,
        <http://example.org/education/concept/Stromkreis> ;
    dcterms:title "Calliope mini Projekt Küchenmusik"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:9__K_TLj3ons a edu:LearningResource ;
    sim:similarTo oer:9eywwe78hGWA ;
    dcterms:creator <http://example.org/education/person/Engel> ;
    dcterms:description "Die Verwendung taktiler Grafiken und Karten ermöglicht Menschen mit Sehbeeinträchtigung oder Blindheit, komplexe Informationen zu erfassen und sich in unbekannten Umgebungen zurechtzufinden. Durch die Kombination von Haptik und Akustik können Nutzer eine Vielzahl von Informationen aufnehmen und verarbeiten, um ihre räumliche Mobilität zu verbessern. Dieses Material bietet einen Überblick über verschiedene Ansätze und Technologien für taktiler Grafiken und Karten, die für die Barrierefreiheit in verschiedenen Anwendungsbereichen eingesetzt werden können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9__K_TLj3ons" ;
    dcterms:subject <http://example.org/education/concept/Alternative_Darstellungsformen>,
        <http://example.org/education/concept/Barrierefreiheit>,
        <http://example.org/education/concept/Behindertenfreundlichkeit>,
        <http://example.org/education/concept/Bildbeschreibungen>,
        <http://example.org/education/concept/Digitale_Barrierefreiheit>,
        <http://example.org/education/concept/Haptik>,
        <http://example.org/education/concept/Inklusion>,
        <http://example.org/education/concept/Taktile_Grafiken>,
        <http://example.org/education/concept/Zug%C3%A4nglichkeit> ;
    dcterms:title "Taktile Grafiken und Karten für Menschen mit Sehbehinderung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

