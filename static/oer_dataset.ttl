oer:129t2qHvuQH-s a edu:LearningResource ;
    sim:similarTo oer:12KqTU9doxa-A,
        oer:12pHudk4KYim8,
        oer:12tQiefgBOTOM,
        oer:5saLiHxSXyEY,
        oer:7BcIE5VX2h6U,
