oer:4XscSS4zV8Fc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Philandrier>,
        <http://example.org/education/person/Sagredo> ;
    dcterms:description "Der Text behandelt die Architekturtheorie von Vitruv und ihre Auswirkungen auf die Renaissance-Architektur. Durch die Lektüre dieses Dokuments können Leser die Grundlagen der Architekturtheorie von Vitruv verstehen, einschließlich seiner Vorstellungen über Symmetrie, Proportionen und die Bedeutung des menschlichen Körpers als Vorbild für architektonische Formen. Zudem werden sie mit wichtigen Architekten und ihren Werken wie Donato Bramante, Leon Battista Alberti und Andrea Palladio vertraut gemacht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4XscSS4zV8Fc" ;
    dcterms:subject <http://example.org/education/concept/Antike>,
        <http://example.org/education/concept/Architekten>,
        <http://example.org/education/concept/Architekturtheorie>,
        <http://example.org/education/concept/Baukunst>,
        <http://example.org/education/concept/Ingenieure>,
        <http://example.org/education/concept/Proportionen>,
        <http://example.org/education/concept/Renaissance>,
        <http://example.org/education/concept/Stadtbau>,
        <http://example.org/education/concept/Tempelbau>,
        <http://example.org/education/concept/Vitruv> ;
    dcterms:title "Vitruv Basilika in Fano"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

