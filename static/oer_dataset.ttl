        <http://example.org/education/concept/Wissenschaftliche_Kommunikation>,
        <http://example.org/education/concept/Wissenschaftliches_Schreiben>,
        <http://example.org/education/concept/wissenssoziologische_Diskursforschung> ;
    dcterms:title "Workshop: Wie schreibe ich wissenschaftlich?"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6CRJOBIRXuzc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Babick>,
        <http://example.org/education/person/Neumann> ;
    dcterms:description "Die Vorlesung behandelt die Grenzflächenphänomene und ihre Bedeutung für die Verfahrenstechnik, insbesondere die Wechselwirkungen zwischen Feststoffen und Flüssigkeiten. Die Studierenden lernen die verschiedenen Methoden zur Messung von Kontaktwinkeln und Oberflächenspannungen kennen, wie zum Beispiel die optische Kontaktwinkelmessung und die Bildanalyse an Pulvern und Presslingen. Durch diese Vorlesung erhalten die Studierenden ein Verständnis für die physikalischen Grundlagen der Grenzflächenphänomene und ihre Anwendung in der Verfahrenstechnik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6CRJOBIRXuzc" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen> ;
    dcterms:subject <http://example.org/education/concept/Feststoffe>,
        <http://example.org/education/concept/Fl%C3%BCssigkeit-Phasengrenze>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenph%C3%A4nomene>,
        <http://example.org/education/concept/Kontaktwinkel>,
        <http://example.org/education/concept/L%C3%B6semittel>,
        <http://example.org/education/concept/Oberfl%C3%A4cheneigenschaften>,
        <http://example.org/education/concept/Superhydrophobie>,
        <http://example.org/education/concept/Umwelttechnik>,
        <http://example.org/education/concept/Verfahrenstechnik>,
        <http://example.org/education/concept/molekulare_Interaktionen> ;
    dcterms:title "Grenzflächenphänomene"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

