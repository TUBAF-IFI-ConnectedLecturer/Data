    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/D%C3%BCrrschmidt>,
        <http://example.org/education/person/Schultze> ;
    dcterms:description "Die Vorlesung \"Fahrzeuge des Schienenpersonennahverkehrs\" behandelt die Fahrdynamik von Straßenbahnen und Stadtbahnen, einschließlich der Charakterisierung von Fahrzeugen, Fahrdynamischen Aspekten und Energiebedarf. Durch das Studium dieser Vorlesung können Lernende ein Verständnis dafür entwickeln, wie sich verschiedene Faktoren auf die Fahrdynamik von Schienenfahrzeugen auswirken und wie sie bei der Planung und dem Betrieb von Nahverkehrssystemen berücksichtigt werden müssen. Zudem werden wichtige Konzepte und Formeln zur Berechnung des Fahrwiderstands und des Energiebedarfs vorgestellt, die für die Entwicklung effizienter und umweltfreundlicher Schienenfahrzeuge von Bedeutung sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3fSMOO5ZdS_Y" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Verkehrswissenschaften> ;
    dcterms:subject <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Energieeffizienz>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Nahverkehr>,
        <http://example.org/education/concept/Schienenfahrzeug>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Stadtbahn>,
        <http://example.org/education/concept/Stra%C3%9Fenbahn>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Fahrzeuge des Schienenpersonennahverkehrs"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

