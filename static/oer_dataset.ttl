oer:105ftMDChNGeQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Klose> ;
    dcterms:description "Das Szenario beschreibt eine wöchentliche Rabattaktion in einem Supermarkt, bei der verschiedene Waren um ein paar Prozent reduziert werden und ab bestimmten Prozentsätzen ein Buzzword erhalten. Die Aufgaben umfassen die Berechnung von Aktionspreisen und die Planung eines Einkaufs unter Berücksichtigung der Rabattaktion. Durch das Bearbeiten dieser Aufgaben können Lernende ihre Fähigkeiten im Bereich des Rechnens und der Kostenplanung verbessern."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "105ftMDChNGeQ" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Einkaufen>,
        <http://example.org/education/concept/Ern%C3%A4hrung>,
        <http://example.org/education/concept/Haushalt>,
        <http://example.org/education/concept/Lebensmittel>,
        <http://example.org/education/concept/Preise>,
        <http://example.org/education/concept/Rabatte>,
        <http://example.org/education/concept/Supermarkt>,
        <http://example.org/education/concept/Verbraucher>,
        <http://example.org/education/concept/Werbung>,
        <http://example.org/education/concept/Wirtschaft> ;
    dcterms:title "Digitale Medien in der Schule von Universität Leipzig (Klose)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:105ifaamjVTMA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/R%C3%BCfner> ;
    dcterms:description "Die Lernaufgabe behandelt die regulären Sprachen und Ausdrücke im Kontext der Informatik und verlangt von den Schülern, dass sie die Begriffe definieren, Aufbau und Struktur beschreiben und einfache sowie mehrelementige reguläre Ausdrücke entwickeln. Durch die Bearbeitung dieser Aufgaben sollen die SuS die Syntax und Semantik regulärer Ausdrücke verstehen und lernen, wie sie in der Praxis angewendet werden können. Die Lernaufgabe bietet Beispiele für die Anwendung regulärer Ausdrücke, wie zum Beispiel die Überprüfung von E-Mail-Adressen oder die Abbildung von Schulnoten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "105ifaamjVTMA" ;
    dcterms:subject <http://example.org/education/concept/Computerwissenschaften>,
        <http://example.org/education/concept/E-Mail-Adressen>,
        <http://example.org/education/concept/Gymnasium>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Mustererkennung>,
        <http://example.org/education/concept/Programmiersprache_Python>,
        <http://example.org/education/concept/Regul%C3%A4re_Ausdr%C3%BCcke>,
        <http://example.org/education/concept/Textanalyse>,
        <http://example.org/education/concept/formale_Sprachen>,
        <http://example.org/education/concept/regul%C3%A4re_Syntax> ;
    dcterms:title "Lernaufgaben Samuel Rüfner"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:106jWTWon4lSM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hirte> ;
    dcterms:description "Die Vorlesung behandelt die europäische Integration und regionale Entwicklung, indem sie die grundlegenden Fragen der Integration, die Stufen der Integration und die ökonomischen Argumente für einen Integrationsprozess erörtert. Durch die Lektüre dieser Materialien können Lernende ein Verständnis dafür entwickeln, wie die europäische Integration die wirtschaftliche Entwicklung von Regionen beeinflusst und welche Maßnahmen ergriffen werden, um eine nachhaltige und integrierte Entwicklung zu fördern. Insbesondere werden die Förderfähigkeit in der Programmperiode 2014-2021, die Entwicklung der Regionalpolitik und die Datenliterarität behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "106jWTWon4lSM" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomische_Geografie>,
        <http://example.org/education/concept/EU-F%C3%B6rderpolitik>,
        <http://example.org/education/concept/Europ%C3%A4ische_Integration>,
        <http://example.org/education/concept/Europ%C3%A4ische_Union>,
        <http://example.org/education/concept/Handelstheorie>,
        <http://example.org/education/concept/Regionale_Entwicklung>,
        <http://example.org/education/concept/Regionalpolitik>,
        <http://example.org/education/concept/Umwelt%C3%B6konomie>,
        <http://example.org/education/concept/Wachstumstheorie>,
        <http://example.org/education/concept/Wirtschaftsintegration> ;
    dcterms:title "Europäische Integration und Regionale Entwicklung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:107XWp-nTjO6g a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Dorenburg> ;
    dcterms:description "Lernende erkennen und lösen Aufgaben zur Formenlehre, indem sie die verschiedenen Zeitformen wie Präsens, Imperfekt, Perfekt, Plusquamperfekt und Futur 1 und 2 verstehen und anwenden. Durch den Einsatz im Unterricht können Lernende ihre Kenntnisse in der Formenlehre festigen, bevor sie Partizipien und Konjunktivformen erlernen. Die Lösungsweg für die gestellten Aufgaben helfen Lernenden, die grammatischen Strukturen zu erkennen und anzuwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "107XWp-nTjO6g" ;
    dcterms:subject <http://example.org/education/concept/Formenlehre>,
        <http://example.org/education/concept/Grammatikunterricht>,
        <http://example.org/education/concept/Konjunktivformen>,
        <http://example.org/education/concept/Lateinische_Grammatik>,
        <http://example.org/education/concept/Lateinunterricht>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Partizipien>,
        <http://example.org/education/concept/Sprachunterricht>,
        <http://example.org/education/concept/Verbalkonjugation>,
        <http://example.org/education/concept/Zeitformen> ;
    dcterms:title "Lösungsweg für die gestellten Aufgaben"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:108i5vftivR0A a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Gr%C3%BCnert>,
        <http://example.org/education/person/Gronek>,
        <http://example.org/education/person/Reiche> ;
    dcterms:description "Das Materialpaket unterstützt die Erstellung eines Legetechnik-Films zum Thema Klassenausflug ins Schwimmbad. Es enthält Tafelmaterial, einen Stadtplan und einen Busfahrplan, um Schülerinnen und Schülern die Planung und Durchführung eines solchen Ausflugs zu erleichtern. Durch die Arbeit mit diesem Materialpaket können Lernende ihre Fähigkeiten im Bereich der Organisation und Zeitplanung verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "108i5vftivR0A" ;
    dcterms:subject <http://example.org/education/concept/Busfahrten>,
        <http://example.org/education/concept/Drehbuch>,
        <http://example.org/education/concept/Fahrradfahren>,
        <http://example.org/education/concept/Filmproduktion>,
        <http://example.org/education/concept/Klassenausflug>,
        <http://example.org/education/concept/Legetechnik>,
        <http://example.org/education/concept/Schulaktivit%C3%A4ten>,
        <http://example.org/education/concept/Schwimmbad>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Verkehrsmittel> ;
    dcterms:title "Materialpaket LERNUMGEBUNG ZUR ERSTELLUNG EINES LEGETECHNIK-FILMS"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:108rcZzWt8ekI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Cygankov>,
        <http://example.org/education/person/Hautau> ;
    dcterms:description "Die Broschüre informiert Schüler der Sekundarstufe 2 über die Gefahren rechter Subkulturen auf sozialen Netzwerken und bietet eine Diskussionsgrundlage für den Unterricht. Durch die Lektüre können Jugendliche erkennen, wie sich Online-Subkulturen entwickeln und welche Risiken sie bergen. Das Quiz am Ende der Broschüre soll die Schüler animieren, ihr Wissen zu vertiefen und neue Sichtweisen auf das Thema zu gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "108rcZzWt8ekI" ;
    dcterms:subject <http://example.org/education/concept/Alt-Right>,
        <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Gefahrenpr%C3%A4vention>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Jugendliche>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Online-Subkulturen>,
        <http://example.org/education/concept/Politische_Bildung>,
        <http://example.org/education/concept/Rechte_Subkulturen>,
        <http://example.org/education/concept/Soziale_Netzwerke> ;
    dcterms:title "Bericht über die Ausarbeitung"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:10BP4b8DQfRNs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/H%C3%A4nicke> ;
    dcterms:description "Die Neue Nationalgalerie Berlin ist ein Museumsbau, der von Ludwig Mies van der Rohe entworfen und zwischen 1965 und 1968 errichtet wurde. Der Bau zeichnet sich durch seine quadratische Stahl-Pavillon-Struktur mit einer Glasfassade und einem stützenfreien Innenraum aus. Die Analyse des Baus bietet Einblicke in die Architektonische Haltung von Mies van der Rohe und die Entwicklung des Bauwerks, einschließlich seiner Konzeption, Planung und Ausführung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10BP4b8DQfRNs" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Architektur>,
        <http://example.org/education/concept/Bauwerke>,
        <http://example.org/education/concept/Glasfassade>,
        <http://example.org/education/concept/Klassizismus>,
        <http://example.org/education/concept/Ludwig>,
        <http://example.org/education/concept/Mies_van_der_Rohe>,
        <http://example.org/education/concept/Moderne_Architektur>,
        <http://example.org/education/concept/Museen>,
        <http://example.org/education/concept/Nationalgalerie_Berlin>,
        <http://example.org/education/concept/Stahlbau> ;
    dcterms:title "TU Dresden  Fakultät Architektur Analyse: Neue Nationalgalerie Berlin"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

