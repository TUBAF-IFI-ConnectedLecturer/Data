oer:1JaeTrzsipmg a edu:LearningResource ;
    sim:similarTo oer:6C94YY1u1JRU ;
    dcterms:creator <http://example.org/education/person/Kie%C3%9Fling> ;
    dcterms:description "Diese Aufgabenpool für Theoretische Informatik behandelt formale Sprachen und Automaten, einschließlich der Einordnung von Grammatiken nach Chomsky und der Erkennung von Worten durch Automaten. Durch die Bearbeitung dieser Aufgaben erwerben Lernende Kenntnisse über die Klassifizierung von formalen Sprachen und die Funktionsweise von Automaten bei der Worterkennung. Die Lösungen zu diesen Aufgaben helfen dabei, das Verständnis für die Theoretische Informatik zu vertiefen und die Fähigkeit zur Anwendung von Konzepten wie kontextfreien Grammatiken und nichtdeterministischen Automaten zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1JaeTrzsipmg" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Automaten>,
        <http://example.org/education/concept/Chomsky-Hierarchie>,
        <http://example.org/education/concept/Formale_Sprachen>,
        <http://example.org/education/concept/Grammatiktypen>,
        <http://example.org/education/concept/K%C3%BCnstliche_Sprachen>,
        <http://example.org/education/concept/Kontextfreiheit>,
        <http://example.org/education/concept/Nichtdeterminismus>,
        <http://example.org/education/concept/Regul%C3%A4re_Sprachen>,
        <http://example.org/education/concept/Theoretische_Informatik>,
        <http://example.org/education/concept/Turingmaschine> ;
    dcterms:title "Theoretische Informatik: Automaten und Sprachen (LB8A)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

