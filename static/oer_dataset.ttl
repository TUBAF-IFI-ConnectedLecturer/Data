        <http://example.org/education/concept/Sportunterricht>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Umfrage> ;
    dcterms:title "Arbeitsauftrag"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:60vHJpv8YMB0 a edu:LearningResource ;
    dcterms:description "Die Forschungsfragen 1 und 2 bergen das Risiko, dass die Antworten bereits voreingenommen werden und somit den wissenschaftlichen Prozess beeinträchtigen. Die Fragestellungen sollten vielmehr offen gehalten werden, um ein breiteres Spektrum möglicher Antworten zuzulassen. Durch die Analyse dieser Forschungsfragen können Lernende das Verständnis für eine wissenschaftliche Vorgehensweise und die Bedeutung offener Fragestellungen entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "60vHJpv8YMB0" ;
    dcterms:subject <http://example.org/education/concept/%C3%96sterreich>,
        <http://example.org/education/concept/Akzeptanz>,
        <http://example.org/education/concept/Bundesheer>,
        <http://example.org/education/concept/Forschungsmethodik>,
        <http://example.org/education/concept/Fragestellungen>,
        <http://example.org/education/concept/Frauen>,
        <http://example.org/education/concept/Geschlechterforschung>,
        <http://example.org/education/concept/Milit%C3%A4r>,
        <http://example.org/education/concept/Soldatinnen>,
        <http://example.org/education/concept/Wissensstand> ;
    dcterms:title "Übung 05-01 Anmerkungen zu Thema, Fragestellung und Forschungsfragen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:614fgd_AFWKQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Frede-Dick>,
        <http://example.org/education/person/Herrmann>,
        <http://example.org/education/person/Sperl> ;
    dcterms:description "Historische Schulbibliotheken in Nordrhein-Westfalen bieten eine Fülle von Möglichkeiten für den Latein- und Griechischunterricht, indem sie Schülerinnen und Schülern Zugang zu alten Texten und Quellen verschaffen. Durch die Nutzung dieser Ressourcen können Lernende ihre Kompetenzen in der Übersetzung und Interpretation alter Texte verbessern und ein tieferes Verständnis für die Kultur und Geschichte der Antike entwickeln. Zudem werden Anregungen für den Einsatz digitaler Tools und Methoden im Unterricht gegeben, um die Lernprozesse zu unterstützen und zu fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "614fgd_AFWKQ" ;
    dcterms:subject <http://example.org/education/concept/Akademische_Schriften>,
        <http://example.org/education/concept/Antike_Philosophie>,
        <http://example.org/education/concept/Augustinus>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Ern%C3%A4hrungsgeschichte>,
        <http://example.org/education/concept/Frauenforschung>,
        <http://example.org/education/concept/Geschlechterstudien>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Katalogisierung>,
        <http://example.org/education/concept/Latein> ;
    dcterms:title "Lateinunterricht heute"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

