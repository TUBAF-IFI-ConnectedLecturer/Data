    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Das Übungsblatt 11 zum Thema Geometrie im Sommersemester 2025 an der Hochschule für Technik und Wirtschaft Dresden enthält sechs Aufgaben mit Lösungshilfe, die die Parameterdarstellung von geometrischen Objekten wie Kegelschnitten, Ellipsen und Ringtori behandeln. Durch das Bearbeiten dieser Aufgaben können Lernende ihre Fähigkeiten in der analytischen Geometrie verbessern und ihre Kenntnisse über affine Abbildungen und Kongruenzabbildungen erweitern. Die Lösungshinweise und Beispiele dienen als Hilfsmittel, um die eigenen Lösungen zu entwickeln und alternative Ansätze zu diskutieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3CTbRF1Wks_U" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Affine_Abbildungen>,
        <http://example.org/education/concept/Algebraische_Geometrie>,
        <http://example.org/education/concept/Ebene_Geometrie>,
        <http://example.org/education/concept/Ellipse>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Kongruente_Abbildungen>,
        <http://example.org/education/concept/Kugeloberfl%C3%A4che>,
        <http://example.org/education/concept/Lineare_Transformationen>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Ringtorus> ;
    dcterms:title "Übungsblatt 11 Aufgaben mit Lösungshilfe"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

