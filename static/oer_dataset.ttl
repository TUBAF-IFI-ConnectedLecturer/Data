oer:3OOGAzonZ5EY a edu:LearningResource ;
    sim:similarTo oer:3umSuWKyTTCo ;
    dcterms:creator <http://example.org/education/person/Stadler>,
        <http://example.org/education/person/Wolf> ;
    dcterms:description "Die Eutrophierung von Gewässern wird durch den Eintrag von Nährstoffen wie Stickstoff und Phosphor verursacht, was zu einer Überdüngung des Wassers führen kann. In kommunalen Kläranlagen können diese Stoffe entfernt werden, um die Wasserqualität zu verbessern. Durch das Verständnis dieser Prozesse können Lerner die Bedeutung von Nitrat und Phosphor im Wasserkreislauf erkennen und Maßnahmen zur Reduzierung ihrer Einträge entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3OOGAzonZ5EY" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologie>,
        <http://example.org/education/concept/Abwasserbehandlung>,
        <http://example.org/education/concept/Eutrophierung>,
        <http://example.org/education/concept/Gew%C3%A4sserbelastung>,
