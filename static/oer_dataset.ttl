oer:5Q9DbrTcVyDA a edu:LearningResource ;
    sim:similarTo oer:5QCtlYBjmwXM,
        oer:5Zz_ZGxORBqM,
        oer:5e7O7g02eF1I ;
    dcterms:description "Das Erzgebirge bietet eine einzigartige Kultur und Tradition, die eng mit dem Bergbau verbunden ist, und umfasst Bergparaden, Hutzenabenden, spezielle Gerichte und Feste sowie eine weltweit einmalige Handwerkskunst. Durch das Studium dieser Materialien können Lernende die Geschichte des Erzgebirges, seine Kultur und Traditionen kennenlernen und verstehen, wie der Bergbau die Region geprägt hat. Sie gewinnen Einblick in die Nachhaltigkeit in der damaligen Zeit und reflektieren über die Chancen und Probleme des Bergbaus."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Q9DbrTcVyDA" ;
    dcterms:subject <http://example.org/education/concept/Bergbau>,
        <http://example.org/education/concept/Bergbaugeschichte>,
        <http://example.org/education/concept/Erzgebirge>,
        <http://example.org/education/concept/Geologie>,
        <http://example.org/education/concept/Gesteine>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Montanarch%C3%A4ologie>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Sachsen>,
        <http://example.org/education/concept/Umweltwirkungen> ;
    dcterms:title "Spuren des Bergbaus - Ein Lehrpfad durch Dippoldiswalde"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5XwSd98zcRII a edu:LearningResource ;
    sim:similarTo oer:5s3lhChS-WzE,
        oer:6nFyHU_vy4hM,
        oer:7qOZz4QXrqPw ;
    dcterms:creator <http://example.org/education/person/Achtziger>,
        <http://example.org/education/person/Richert> ;
    dcterms:description "Die Übersicht beschreibt verschiedene Vegetationstypen in Weinbergen, insbesondere in Sachsen, und listet typische Pflanzenarten auf. Durch die Kategorisierung der Vegetationstypen nach Merkmalen wie Standort, Bewuchs und Pflanzenarten können Leser ein besseres Verständnis für die Biodiversität in Weinbergen entwickeln. Die Übersicht bietet somit eine umfassende Darstellung der verschiedenen Vegetationstypen und ihrer Charakteristika, um die Anpassungen an den Klimawandel zu unterstützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5XwSd98zcRII" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
