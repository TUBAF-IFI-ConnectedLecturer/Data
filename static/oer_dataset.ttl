oer:15T55Qup56oi8 a edu:LearningResource ;
    sim:similarTo oer:15g2GtDSrPF3o,
        oer:15suPyArRiqpw,
        oer:348XYSOnGXds,
        oer:3sKXN6I0IPsg,
        oer:3tv9zu0-ICAA ;
    dcterms:description "Die Aufgabenstellung behandelt die Optimierung eines verfahrenstechnischen Systems durch die Anwendung der achsenparallelen Suche und die Beschreibung der Systemstruktur. Durch die Lösung der Aufgaben soll der optimale Eingangsstrom auf die Zweige bestimmt werden, um den Gehalt an nicht umgesetzter Komponente A im Produktstrom zu minimieren. Die Lösung umfasst auch die Veränderung des Verfahrens bei notwendiger Reinigung des Reaktors während der Produktion."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "15T55Qup56oi8" ;
    dcterms:subject <http://example.org/education/concept/Chemische_Reaktion>,
        <http://example.org/education/concept/Chemische_Verfahrenstechnik>,
        <http://example.org/education/concept/Destillationskolonne>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Prozessleittechnik>,
        <http://example.org/education/concept/Prozessoptimierung>,
        <http://example.org/education/concept/R%C3%BChrkesselreaktor>,
        <http://example.org/education/concept/Reaktorschaltung>,
        <http://example.org/education/concept/Systemverfahrenstechnik>,
        <http://example.org/education/concept/Verfahrenstechnik> ;
    dcterms:title "AUFGABENSTELLUNG"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:15g2GtDSrPF3o a edu:LearningResource ;
    sim:similarTo oer:15suPyArRiqpw,
        oer:348XYSOnGXds,
        oer:3sKXN6I0IPsg ;
    dcterms:description "Das Übungsblatt behandelt die Optimierung eines Reaktorsystems, bei dem ein Edukt in zwei Prozessgruppen zu einem Zwischenprodukt umgesetzt wird. Ziel ist es, die Produktion des Zwischenproduktes auf die beiden Gruppen aufzuteilen, um den Strom des nicht umgesetzten Zwischenproduktes zu minimieren. Durch die Lösung dieser Aufgabe können Studierende ihr Verständnis von Reaktionsvorgängen und Prozessoptimierung verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "15g2GtDSrPF3o" ;
    dcterms:subject <http://example.org/education/concept/Chemische_Reaktionen>,
        <http://example.org/education/concept/Isotherme_Prozesse>,
        <http://example.org/education/concept/Prozessleittechnik>,
        <http://example.org/education/concept/Prozessoptimierung>,
        <http://example.org/education/concept/R%C3%BChrkesselreaktoren>,
        <http://example.org/education/concept/Reaktionskinetik>,
        <http://example.org/education/concept/Reaktortechnik>,
        <http://example.org/education/concept/Verfahrenstechnik>,
        <http://example.org/education/concept/Volumenstrom>,
        <http://example.org/education/concept/Zwischenprodukte> ;
    dcterms:title "ÜBUNG 5 AUFGABE - OPTIMIERUNG EINES REAKTORSYSTEMS"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:16VIyBnKuUJjs a edu:LearningResource ;
    sim:similarTo oer:6a1ePs5kWyb0 ;
    dcterms:creator <http://example.org/education/person/Spallek> ;
    dcterms:description "Die Informationsdarstellung und -verarbeitung sind zentrale Aspekte der Informatik, die sich mit der Darstellung, Übertragung und Verarbeitung von Informationen beschäftigen. Durch das Studium dieser Themen können Lernende ein grundlegendes Verständnis dafür entwickeln, wie Computer funktionieren und wie sie verwendet werden können, um komplexe Aufgaben zu lösen. Sie erwerben Kenntnisse über die Grundlagen der Informationsverarbeitung, einschließlich der Codierung, Diskretisierung und Quantisierung von Signalen, sowie die Architektur von Computern und ihre Funktionen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "16VIyBnKuUJjs" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
