    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Diese Übungssammlung behandelt grundlegende Konzepte der Geometrie und linearen Algebra, indem sie eine Vielzahl von Aufgaben und Lösungen bereitstellt, die die Anwendung von affinen Abbildungen auf Punkte, Vektoren und Figuren demonstrieren. Durch das Bearbeiten dieser Aufgaben können Lernende ihre Fähigkeiten im Umgang mit affinen Abbildungen verbessern und ein tieferes Verständnis der zugrundeliegenden mathematischen Konzepte entwickeln. Die Übungssammlung deckt eine breite Palette von Themen ab, darunter die Untersuchung von Fixpunkten, die Berechnung von Bildern und die Analyse von affinen Abbildungen in verschiedenen Koordinatensystemen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12SzMLdp5AHSc" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_F%C3%BCr_Technik_Und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/B%C3%A9zier-Kurven>,
        <http://example.org/education/concept/Ebene>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Koordinatensysteme>,
