oer:7HAMS2OvGsQ0 a edu:LearningResource ;
    sim:similarTo oer:7_uTTDF4X3PM,
        oer:9ZJKoyUnW92o ;
    dcterms:description "Dieses Lehrmaterial behandelt die Grundlagen der Thermodynamik, insbesondere den Ersten und Zweiten Hauptsatz, sowie Anwendungen auf thermochemische Prozesse und Entropie. Durch das Studium dieses Materials können Lernende die wichtigsten Begriffe und Konzepte der Thermodynamik verstehen und anwenden, um komplexe physikalisch-chemische Vorgänge zu analysieren und zu beschreiben. Die Inhalte umfassen Definitionen, Sätze und Anwendungen von thermodynamischen Größen wie Enthalpie, Entropie und Wärmekapazität, sowie die Arbeit wichtiger Wissenschaftler auf diesem Gebiet."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7HAMS2OvGsQ0" ;
    dcterms:subject <http://example.org/education/concept/Chemische_Reaktionen>,
        <http://example.org/education/concept/Energie>,
        <http://example.org/education/concept/Entropie>,
        <http://example.org/education/concept/Haupts%C3%A4tze_der_Thermodynamik>,
        <http://example.org/education/concept/Phasen%C3%BCberg%C3%A4nge>,
        <http://example.org/education/concept/Physikalische_Chemie>,
        <http://example.org/education/concept/Thermochemie>,
        <http://example.org/education/concept/Thermodynamik>,
        <http://example.org/education/concept/W%C3%A4rme%C3%BCbertragung>,
        <http://example.org/education/concept/Zustands%C3%A4nderungen> ;
    dcterms:title "Thermodynamik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7pM26d_aLADM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hacker> ;
    dcterms:description "Die Bestandskalkulation ist ein Verfahren zur Ermittlung des relativen Flächenbedarfs differenziert nach einzelnen Gruppen des Bestands, das ein Etatverteilungsmodell umfasst, das vor allem die Anzahl der Ausleihen ebenfalls differenziert nach Bestandsgruppen zugrunde legt. Durch die Anwendung dieser Methode können Bibliotheken ihre Bestände gezielt entwickeln und ihre Ressourcen effizienter nutzen. Die Kenntnis der Bestandskalkulation ermöglicht es Bibliothekaren, fundierte Entscheidungen über den Aufbau und die Pflege ihrer Bestände zu treffen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7pM26d_aLADM" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Benutzungsanalyse>,
        <http://example.org/education/concept/Bestandskalkulation>,
        <http://example.org/education/concept/Bibliotheksstatistik>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Erwerbung>,
        <http://example.org/education/concept/Etatverteilung>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Informationswissenschaft>,
        <http://example.org/education/concept/Katalogisierung>,
        <http://example.org/education/concept/Medienmarkt> ;
    dcterms:title "Bestandskalkulation und Indexierung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

