oer:4oHMGSTyhzDo a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Bartusch>,
        <http://example.org/education/person/Rzadtki> ;
    dcterms:description "ETFE-Folie wird als geeignetes Bedachungsmaterial für Gewächshäuser beschrieben, da sie eine hohe Lichttransmission aufweist und leichter ist als Glas. Die Befestigung der Folie erfolgt durch Kleben oder mit Hilfe von Klemmen, wobei ETFE-Foliekissen verwendet werden können, um U-Werte von bis zu 0,6 W(m²K) zu erzielen. Durch die Verwendung von ETFE-Folie können Architekten und Ingenieure Gewächshäuser entwerfen, die eine gute Balance zwischen Lichttransmission und Wärmedämmung aufweisen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4oHMGSTyhzDo" ;
    dcterms:publisher <http://example.org/education/organization/UdK_Berlin> ;
    dcterms:subject <http://example.org/education/concept/Architektur>,
        <http://example.org/education/concept/Baustoffe>,
        <http://example.org/education/concept/Bedachungsmaterial>,
        <http://example.org/education/concept/Energieeffizienz>,
        <http://example.org/education/concept/Folien>,
        <http://example.org/education/concept/Gartenbau>,
        <http://example.org/education/concept/Gew%C3%A4chsh%C3%A4user>,
        <http://example.org/education/concept/Isolierung>,
        <http://example.org/education/concept/Lichttransmission>,
        <http://example.org/education/concept/Tropenh%C3%A4user> ;
    dcterms:title "Neubau Tropenschauhaus Botanischer Garten Dresden"@de ;
    dcterms:type <http://example.org/education/type/Bachelor-_oder_Masterarbeit> .

oer:4okI2j4_u8EI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kreidler> ;
    dcterms:description "Pure Data ist eine Open-Source-Plattform für die Verarbeitung und Erzeugung von Audio-Signalen, die auf verschiedenen Plattformen läuft und durch Erweiterungen in vielen Programmiersprachen anpassbar ist. Durch den Einsatz von Pure Data können Anwender verschiedene Anwendungen wie Software-Synthesizer, Soundeffekte, Prototyping für Videospiele und Multimedia-Projekte realisieren. Dieses Tutorial bietet eine Einführung in die Verwendung von Pure Data und unterstützt Lernende bei der ersten Annäherung an diese Plattform."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4okI2j4_u8EI" ;
    dcterms:subject <http://example.org/education/concept/Audioverarbeitung>,
        <http://example.org/education/concept/Forschung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Multimediaprojekte>,
        <http://example.org/education/concept/Musiksynthese>,
        <http://example.org/education/concept/Netzkunst>,
        <http://example.org/education/concept/Open-Source-Software>,
        <http://example.org/education/concept/Programmiersprachen>,
        <http://example.org/education/concept/Schnittstellen>,
        <http://example.org/education/concept/Soundeffekte> ;
    dcterms:title "Pure Data - Getting started"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:4pnrqNj9IZHg a edu:LearningResource ;
    dcterms:description "Der Indikatorbericht bietet eine umfassende Übersicht über den Zustand der Umwelt in Deutschland und zeigt die Entwicklung von Umweltbelastungen auf. Durch die Analyse von 24 Indikatoren werden die Auswirkungen menschlicher Aktivitäten auf die Umwelt sichtbar gemacht, um eine nachhaltige Entwicklung zu fördern. Die Lektüre dieses Berichts ermöglicht es Lesern, sich über die wichtigsten Umweltprobleme in Deutschland zu informieren und Maßnahmen zur Verbesserung der Umweltsituation zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4pnrqNj9IZHg" ;
    dcterms:publisher <http://example.org/education/organization/I%27ve_Analyzed_The_Document_And_Found_No_E-mail_Addresses_With_University_Domains._Therefore__I_Will_Return_An_Empty_String.> ;
    dcterms:subject <http://example.org/education/concept/%C3%96kosysteme>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
        <http://example.org/education/concept/Erneuerbare_Energien>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Landnutzung>,
        <http://example.org/education/concept/Luftschadstoffe>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Treibhausgase>,
        <http://example.org/education/concept/Umweltbelastungen>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Daten zur Umwelt 2017"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:4pywoIUaj3a4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/St%C3%A4hele> ;
    dcterms:description "Der Themenvorschlag für eine Abschlussarbeit im Diplomstudiengang Bauingenieurwesen beschreibt die Möglichkeiten und Potenziale zur Besserung der Bauarbeiten durch Robotik und Automatisierung im Robau. Der Vorschlag wird von Prof. Dr.-Ing."@de ;
