    dcterms:creator <http://example.org/education/person/Herzler> ;
    dcterms:description "Das Materialhandbuch zum Thema Algorithmen und Datentypen richtet sich an Schüler der 10. Klasse eines Gymnasiums und soll ihnen helfen, ihre Fähigkeiten im Bereich Informatik zu überprüfen und zu verbessern. Durch die Bearbeitung von zehn Fragen, darunter Entscheidungsfragen und eine Quelltext-Aufgabe, können die Schüler ihren Lernfortschritt ermitteln und ihre Kenntnisse in Algorithmen und Datentypen festigen. Das Material eignet sich insbesondere zum Einsatz im Selbststudium, um den eigenen Lernprozess zu überwachen und zu steuern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "6rNBc-JCeDPE" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/ClassFlow>,
        <http://example.org/education/concept/Compiler>,
        <http://example.org/education/concept/Datentypen>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Lernplattform>,
        <http://example.org/education/concept/Programmiersprache_Delphi>,
        <http://example.org/education/concept/Sch%C3%BClerfeedbacksystem>,
        <http://example.org/education/concept/Selbstkontrolle>,
        <http://example.org/education/concept/digitale_Medien> ;
    dcterms:title "Schülerfeedbacksystem zum Thema Algorithmen"@de ;
    dcterms:type <http://example.org/education/type/Materialhandreichung> .

