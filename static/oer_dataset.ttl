    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik für das Verkehrsingenieurwesen behandelt die Grundlagen der Antriebskräfte und des Traktionsvermögens von Schienenfahrzeugen, einschließlich der Kraftschlussausnutzung und -mechanismus. Durch das Studium dieser Inhalte können Lernende die physikalischen und technischen Grenzen der Zugkraft und Leistung von Schienenfahrzeugen verstehen und berechnen. Dieses Wissen ermöglicht es, Fahrzeuge und Antriebe optimal auszulegen und die Energieeffizienz zu verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9jfKL3NiIpew" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Elektrische_Bahnen> ;
