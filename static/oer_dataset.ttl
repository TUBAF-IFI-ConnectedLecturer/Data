        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/fossile_Energietr%C3%A4ger> ;
    dcterms:title "Klimawandel Grundlagen, Folgen, Lösungen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

