    dcterms:creator <http://example.org/education/person/Debus>,
        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übung behandelt die Entwicklung von Laurentreihen und den Residuensatz für komplexe Funktionen. Durch die Lösung der Aufgaben können Studierende ihre Fähigkeiten im Bereich der Funktionentheorie verbessern und ein tieferes Verständnis für die Anwendung des Residuensatzes erlangen. Insbesondere werden sie lernen, Laurentreihen in verschiedenen Gebieten zu entwickeln und komplexe Kurvenintegrale mit Hilfe des Residuensatzes zu berechnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11EPbclFYKcu4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Cauchyscher_Integralsatz>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Komplexe_Analysis>,
        <http://example.org/education/concept/Kurvenintegrale>,
        <http://example.org/education/concept/Laurent-Reihe>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Numerik>,
        <http://example.org/education/concept/Partielle_Differentialgleichungen>,
        <http://example.org/education/concept/Residuensatz>,
        <http://example.org/education/concept/Singularit%C3%A4ten> ;
    dcterms:title "Professur Numerik partieller Differentialgleichungen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

