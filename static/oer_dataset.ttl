oer:3zEZKqDTo1aU a edu:LearningResource ;
    sim:similarTo oer:44bOn1IEUJiY,
        oer:4iU7PFQ1hIY0,
        oer:56WpE4QqH8Yc,
        oer:9wGQwH-t-3K8 ;
    dcterms:creator <http://example.org/education/person/Beutel>,
        <http://example.org/education/person/Melzer> ;
    dcterms:description "Das Projekt behandelt das Socio-Scientific-Issue \"Nitrat im Grundwasser\" und verbindet chemische und geographische Aspekte mit sozialen und ökologischen Fragestellungen. Durch die Auseinandersetzung mit diesem Thema erwerben Lernende Kenntnisse über den Stickstoffkreislauf, Eutrophierung und Nitratbelastung von Gewässern sowie die Auswirkungen auf die Umwelt und die Gesellschaft. Sie entwickeln zudem Fähigkeiten im selbstorganisierten Lernen, Experimentieren und Problemlösen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "3zEZKqDTo1aU" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%96kotoxikologie>,
        <http://example.org/education/concept/Abwasserbehandlung>,
        <http://example.org/education/concept/Au%C3%9Ferschulisches_Lernen>,
        <http://example.org/education/concept/Bildungsprojekt>,
        <http://example.org/education/concept/Eutrophierung>,
        <http://example.org/education/concept/Gew%C3%A4sserschutz>,
        <http://example.org/education/concept/Nachhaltige_Entwicklung>,
        <http://example.org/education/concept/Nitratbelastung>,
        <http://example.org/education/concept/Umweltbildung>,
        <http://example.org/education/concept/Wasserreinhaltung> ;
    dcterms:title "Socio Scientific Issue"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:43NdsHIKHWCM a edu:LearningResource ;
    sim:similarTo oer:4BP4tOj8Ac8o,
        oer:4J20iGKDyYXM,
        oer:4fsc1hQMmkhM,
        oer:4zgmcPXsfAIY ;
    dcterms:creator <http://example.org/education/person/Walter> ;
    dcterms:description "Die zahnärztliche Vergütung wird durch den Bundesmantelvertrag und die Gebührenordnungen BEMA, GOZ und GOÄ geregelt, welche die abrechnungsfähigen Leistungen und ihre Bewertung festlegen. Durch das Verständnis dieser Regelwerke können Zahnärzte ihre Leistungen korrekt abrechnen und ihre Patienten entsprechend informieren. Die Kenntnis der kassenzahnärztlichen Vereinigung, der Krankenkassen und ihrer Richtlinien ermöglicht es Zahnärzten, ihre Arbeit effizienter zu organisieren und die Qualität der Patientenversorgung zu verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "43NdsHIKHWCM" ;
    dcterms:subject <http://example.org/education/concept/Abrechnung_von_zahn%C3%A4rztlichen_Leistungen>,
        <http://example.org/education/concept/Bundesmantelvertrag>,
        <http://example.org/education/concept/Dokumentation_in_der_Zahnarztpraxis>,
        <http://example.org/education/concept/Gesetzliche_Krankenversicherung>,
        <http://example.org/education/concept/Kassenzahn%C3%A4rztliche_Vereinigung>,
        <http://example.org/education/concept/Krankenkassen>,
        <http://example.org/education/concept/Private_Krankenversicherung>,
        <http://example.org/education/concept/Richtlinien_des_Bundesausschusses_der_Zahn%C3%A4rzte_und_Krankenkassen>,
        <http://example.org/education/concept/Zahn%C3%A4rztliche_Leistungen>,
        <http://example.org/education/concept/Zahnmedizin> ;
    dcterms:title "DIE VERGÜTUNG VON ZAHNÄRZTLICHEN LEISTUNGEN NACH BEMA, GOZ UND GOÄ"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:43xyKg83RDGs a edu:LearningResource ;
    sim:similarTo oer:440k9ckn-IBQ,
        oer:48GbkVQq6tl0,
        oer:7neTMhzFCXPA,
        oer:9ZcJ1MbNt77g ;
    dcterms:description "Die Aufgabe besteht darin, eine aussagenlogische Formel φ zu finden, die eine bestimmte Eigenschaft erfüllt, nämlich dass für je zwei Belegungen von p, q und r, die sich genau in einem Wert unterscheiden, die Wahrheitswerte von φ übereinstimmen. Die Lösung wird durch die Formel ϕ(pqr)(pqr) gegeben, die sicherstellt, dass der Wahrheitswert für zwei Belegungen, die sich nur in einem Wert von p, q oder r unterscheiden, unterschiedlich ist. Durch das Lösen dieser Aufgabe können Studierende ihre Fähigkeiten im Bereich der Aussagenlogik verbessern und ein tieferes Verständnis für die Eigenschaften logischer Formeln entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "43xyKg83RDGs" ;
    dcterms:subject <http://example.org/education/concept/Aussagenlogik>,
        <http://example.org/education/concept/Aussagenvariable>,
        <http://example.org/education/concept/Belegung>,
        <http://example.org/education/concept/Boolesche_Algebra>,
        <http://example.org/education/concept/Formel>,
        <http://example.org/education/concept/Logische_Operationen>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Propositionale_Logik>,
        <http://example.org/education/concept/Wahrheitswert>,
        <http://example.org/education/concept/mathematische_Logik> ;
    dcterms:title "Aufgabe 3.6"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

