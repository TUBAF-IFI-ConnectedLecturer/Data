        <http://example.org/education/concept/Elektrosicherheit>,
        <http://example.org/education/concept/Gef%C3%A4hrdungsbeurteilung>,
        <http://example.org/education/concept/Gesundheitsgef%C3%A4hrdung>,
        <http://example.org/education/concept/Maschinensicherheit>,
        <http://example.org/education/concept/Staubentwicklung> ;
    dcterms:title "Bohrmaschine_Identifizierung_der_Gefaehrdungen"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:9IfjsKiimn3Y a edu:LearningResource ;
    sim:similarTo oer:9_sFBGwrgG-E,
        oer:9t-AeLTUPFuU,
        oer:9yDtAm7JR2W8 ;
    dcterms:creator <http://example.org/education/person/Debus>,
        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übungsaufgaben behandeln die Themen diskrete Verteilungen und Wahrscheinlichkeitstheorie, indem sie die Lösung von Aufgaben zu Zufallsvariablen, Verteilungsfunktionen und Erwartungswerten anleiten. Durch das Bearbeiten dieser Aufgaben können Lernende ihre Fähigkeiten in der Anwendung statistischer Konzepte auf praktische Probleme verbessern. Die Übung umfasst sechs Aufgaben, die von der Bestimmung von Verteilungsfunktionen und Erwartungswerten bis hin zur Anwendung von Poisson-Verteilungen reichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9IfjsKiimn3Y" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Diskrete_Mathematik>,
        <http://example.org/education/concept/Erwartungswert>,
        <http://example.org/education/concept/Mathematische_Statistik>,
