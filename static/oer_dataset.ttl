oer:9CUiwaw3vJGU a edu:LearningResource ;
    sim:similarTo oer:9LZQPW70zooM ;
    dcterms:creator <http://example.org/education/person/Bach>,
        <http://example.org/education/person/Becker>,
        <http://example.org/education/person/Blumenberg> ;
    dcterms:description "Die Öffentlichen Bibliotheken spielen eine zentrale Rolle bei der Förderung von Bildung und Kultur in Deutschland, bieten jedoch aufgrund fehlender Finanzen und unzureichender Personalgewinnung nur begrenzte Möglichkeiten für ihre Nutzerinnen. Der Deutsche Bibliotheksverband fordert deshalb die Bundesregierung und Kommunen auf, die Budgets anzupassen, Infrastrukturmaßnahmen zu fördern und die Sonntagsöffnung zu ermöglichen, um die Zukunftsfähigkeit von Bibliotheken nachhaltig zu sichern. Durch diese Maßnahmen können Bibliotheken ihre Angebote ausbauen, mehr Menschen erreichen und somit zur Bildungsgerechtigkeit beitragen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9CUiwaw3vJGU" ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentliche_Bibliotheken>,
        <http://example.org/education/concept/Bibliotheken>,
        <http://example.org/education/concept/Bildungseinrichtungen>,
        <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/Informationsdienstleistungen>,
        <http://example.org/education/concept/Kulturelle_Einrichtungen>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Schulbibliothekssysteme>,
        <http://example.org/education/concept/Sonntags%C3%B6ffnung>,
        <http://example.org/education/concept/Wissenschaftliche_Bibliotheken> ;
    dcterms:title "Bericht zur Lage der Bibliotheken in Deutschland"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

