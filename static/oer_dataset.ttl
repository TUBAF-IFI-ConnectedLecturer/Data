    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die additive Fertigung wird als Zukunftstechnologie vorgestellt, die sich durch ihre Flexibilität und Vielfältigkeit von traditionellen Fertigungsverfahren unterscheidet. Durch das Studium dieser Materialien können Lernende ein grundlegendes Verständnis der additiven Fertigungstechnologien und ihrer Anwendungsbereiche erwerben, einschließlich der Stereolithographie, des 3D-Drucks und der Rapid Manufacturing. Zudem werden die Entwicklung und Zukunftsaussichten dieser Technologie sowie ihre Bedeutung für verschiedene Industrien wie Luft- und Raumfahrt, Automobilindustrie und Medizin dargestellt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11PdrcePkZt6Q" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Computer-Aided_Design>,
        <http://example.org/education/concept/Fused_Deposition_Modeling>,
        <http://example.org/education/concept/Industrielle_Anwendungen>,
        <http://example.org/education/concept/Luft-_und_Raumfahrttechnik>,
        <http://example.org/education/concept/Medizintechnik>,
        <http://example.org/education/concept/Rapid_Prototyping>,
        <http://example.org/education/concept/Selektives_Laserschmelzen>,
        <http://example.org/education/concept/Stereolithographie> ;
    dcterms:title "Additive Fertigung Einführung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5URXMl65S4e4 a edu:LearningResource ;
    sim:similarTo oer:5f2120dpWRzA,
        oer:6SoThGOL0XtY,
        oer:6Uk3SuF9rzjM,
        oer:6Yln4mrFrqPw,
        oer:82wMUbbUVRKk,
        oer:8jcbbYQ_EqVg,
        oer:91zCnQXHW0H4,
        oer:981sj_8QUGLc,
