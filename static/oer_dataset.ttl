oer:109qEPikhJYmI a edu:LearningResource ;
    sim:similarTo oer:10PboRWh69dG4,
        oer:10hDYSfzwMCN8,
        oer:10nBe1zdb2NNM,
        oer:10nX6vGWUr8q8,
