oer:121EVAGmzA3uI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Mustermann> ;
    dcterms:description "Die Ausarbeitung beschreibt zwei Methoden zur automatischen Extraktion von Produktinformationen aus semistrukturierten Quellen, nämlich das Template-basierte Verfahren und das MDR-Verfahren. Durch die Anwendung dieser Methoden können Produktinformationen effizienter gewonnen werden, insbesondere wenn sie in bestimmten Bereichen von Webseiten zu finden sind. Die Lernenden erfahren, wie sie Informationen aus dem WWW extrahieren und verarbeiten können, um relevante Daten für die Produktinformationsextraktion zu gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "121EVAGmzA3uI" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Informationsextraktion>,
        <http://example.org/education/concept/Informationsgewinnung>,
        <http://example.org/education/concept/Mining_Data_Records>,
        <http://example.org/education/concept/Produktinformation>,
        <http://example.org/education/concept/Template-basierte_Verfahren>,
        <http://example.org/education/concept/Textanalyse>,
        <http://example.org/education/concept/WWW>,
        <http://example.org/education/concept/Webseiten>,
        <http://example.org/education/concept/semistrukturierte_Quellen> ;
    dcterms:title "Review zur Ausarbeitung Product Information Extraction"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:121qOy34xpV-Q a edu:LearningResource ;
    dcterms:description "Die Übung vergleicht zwei Methoden zur Darstellung der Bevölkerungsdichte Deutschlands auf Karten, nämlich Natural Breaks und Equal Interval Methode. Durch den Vergleich werden die Vor- und Nachteile beider Methoden verdeutlicht, um eine sinnvolle Visualisierung von Bevölkerungsdaten zu ermöglichen. Die Learner erfahren, wie sie die passende Methode für ihre Kartographie-Projekte auswählen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "121qOy34xpV-Q" ;
    dcterms:subject <http://example.org/education/concept/Bev%C3%B6lkerungsdichte>,
        <http://example.org/education/concept/Demographie>,
        <http://example.org/education/concept/Deutschland>,
        <http://example.org/education/concept/Equal_Interval_Methode>,
        <http://example.org/education/concept/Geoinformationssysteme>,
        <http://example.org/education/concept/Kartenvisualisierung>,
        <http://example.org/education/concept/Kartographie>,
        <http://example.org/education/concept/Natural_Breaks>,
        <http://example.org/education/concept/Raumbezogene_Daten>,
        <http://example.org/education/concept/Statistik> ;
    dcterms:title "Übung zur Lehrveranstaltung Kartographie im WS 2023/2024"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

