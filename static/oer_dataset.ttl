oer:51rk5ZDqVnkc a edu:LearningResource ;
    sim:similarTo oer:5l6iB0AgYLNM,
        oer:8V12n0GK9sQw,
        oer:9uoS64AUfbAY ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Das Seminar behandelt die historische Semantik des Deutschen, insbesondere den semantischen Wandel von Wortbedeutungen im Mittelalter. Durch die Analyse von Lehnwörtern, Lehnbildungen und Lehnbedeutungen wird der Einfluss mittelalterlicher Fach- und Sondersprachen auf das heutige Deutsch verdeutlicht. Die Lernenden gewinnen Einsicht in die kulturgeschichtlichen Rahmenbedingungen der Karolingischen Bildungsreform und ihre Auswirkungen auf den deutschen Wortschatz."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "51rk5ZDqVnkc" ;
    dcterms:subject <http://example.org/education/concept/Althochdeutsch>,
        <http://example.org/education/concept/Bildungsreform>,
