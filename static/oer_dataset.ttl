oer:11nq9A9Pc-bo8 a edu:LearningResource ;
    sim:similarTo oer:3RZ9RyhqG1W4 ;
    dcterms:creator <http://example.org/education/person/Braun> ;
    dcterms:description "Die Sicherheit von Web-Diensten ist ein wichtiger Aspekt bei der Entwicklung von Anwendungen, da sie den Schutz von Daten und die Authentifizierung von Benutzern gewährleisten muss. Dieses Dokument behandelt verschiedene Sicherheitsaspekte, wie Transportsicherheit mit TLS/SSL, Nachrichtensicherheit mit WS-Security und Identitätsprotokolle wie SAML und OpenID Connect, um eine sichere Kommunikation zwischen Web-Diensten zu ermöglichen. Durch das Verständnis dieser Konzepte können Entwickler sicherere Anwendungen erstellen, die den Anforderungen von Unternehmen und Kunden gerecht werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11nq9A9Pc-bo8" ;
    dcterms:subject <http://example.org/education/concept/Authentifizierung>,
        <http://example.org/education/concept/Autorisierung>,
        <http://example.org/education/concept/Datensicherheit>,
        <http://example.org/education/concept/Netzwerksicherheit>,
        <http://example.org/education/concept/Secure_Sockets_Layer_%28SSL%29>,
        <http://example.org/education/concept/Service-Oriented_Architecture_%28SOA%29>,
        <http://example.org/education/concept/Sicherheit>,
        <http://example.org/education/concept/Transport_Layer_Security_%28TLS%29>,
        <http://example.org/education/concept/Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Web-Services> ;
    dcterms:title "Sicherheit in SOA"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:121AajijhoRTQ a edu:LearningResource ;
    sim:similarTo oer:12V-d__wbcETs,
