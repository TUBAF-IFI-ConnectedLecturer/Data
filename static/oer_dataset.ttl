        <http://example.org/education/concept/Netzsimulation>,
        <http://example.org/education/concept/Schutztechnik>,
        <http://example.org/education/concept/Stromnetze> ;
    dcterms:title "Einführung in die Netzberechnung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

