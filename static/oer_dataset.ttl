    dcterms:creator <http://example.org/education/person/Fricke>,
        <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Stephan> ;
    dcterms:description "Die Leistungsauslegung von Triebfahrzeugen basiert auf der Fahrdynamik und berücksichtigt Faktoren wie die Anfangsbeschleunigung, die Übergangsgeschwindigkeit und die erforderliche mittlere Beschleunigung. Durch die Anwendung von Zugförderprogrammen und fahrdynamischen Berechnungen können die notwendigen Leistungen für Triebfahrzeuge ermittelt werden. Die Kenntnis dieser Grundlagen ermöglicht es, die Leistungsauslegung von Triebfahrzeugen zu verstehen und anzuwenden, um effiziente und sichere Fahrzeugkonstruktionen zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12d_ts_xx_y1k" ;
    dcterms:subject <http://example.org/education/concept/Antriebskonfigurationen>,
        <http://example.org/education/concept/Batterien>,
