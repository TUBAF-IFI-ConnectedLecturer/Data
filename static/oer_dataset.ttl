oer:8aUGmsWi2Duk a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Lauber-R%C3%B6nsberg> ;
    dcterms:description "Das Urheberrechtsgesetz (UrhG) schützt persönliche geistige Schöpfungen wie Werke der Literatur, Musik und bildenden Kunst, sowie wissenschaftliche und organisatorische Leistungen. Durch das UrhG werden bestimmte Nutzungsbefugnisse wie Zitatrecht, Unterrichts- und Lehrmedien, Text und Data Mining ermöglicht, während Änderungen an Werken grundsätzlich verboten sind. Die Creative-Commons-Lizenzen bieten eine alternative Möglichkeit, Werke unter bestimmten Bedingungen frei zu nutzen und weiterzugeben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8aUGmsWi2Duk" ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentliche_Wiedergabe>,
        <http://example.org/education/concept/Bildungseinrichtungen>,
        <http://example.org/education/concept/Creative_Commons>,
        <http://example.org/education/concept/Leistungsschutzrechte>,
        <http://example.org/education/concept/Lizenzvarianten>,
        <http://example.org/education/concept/Text_und_Data_Mining>,
        <http://example.org/education/concept/Urheberrecht>,
        <http://example.org/education/concept/Urheberrechte>,
        <http://example.org/education/concept/Vervielf%C3%A4ltigung>,
        <http://example.org/education/concept/Wissenschaftliche_Forschung> ;
    dcterms:title "Urheberrechtlich und OER IRGET"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

