        <http://example.org/education/concept/r%C3%A4umliche_Darstellung>,
        <http://example.org/education/concept/visuelles_Lernen> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

