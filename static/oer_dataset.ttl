        <http://example.org/education/concept/Solarzelle>,
        <http://example.org/education/concept/Strom-Spannungs-Kennlinie>,
        <http://example.org/education/concept/Stromkreis>,
        <http://example.org/education/concept/Widerstand> ;
    dcterms:title "Praktikum Elektrotechnik für Nichtelektrotechniker Versuch 3"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

