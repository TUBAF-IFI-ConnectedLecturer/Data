oer:8etcKB4hvGaA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kurschner> ;
    dcterms:description "Das Seminar behandelt numerische Methoden im Data Science und Machine Learning, insbesondere die Anwendung von Singularwertzerlegung und Hauptkomponentenanalyse auf eine gegebene Datenmatrix. Die Übungsaufgaben umfassen die Berechnung von Kennzahlen wie der effektiven Konditionszahl und des numerischen Rangs sowie die Approximation einer Matrix durch eine niederrangige Matrix. Durch das Lösen dieser Aufgaben erwerben die Lernenden Kenntnisse über die Anwendung numerischer Methoden auf reale Datenprobleme."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8etcKB4hvGaA" ;
    dcterms:subject <http://example.org/education/concept/Data_Science>,
        <http://example.org/education/concept/Datenmatrix>,
        <http://example.org/education/concept/Hauptkomponentenanalyse>,
        <http://example.org/education/concept/Machine_Learning>,
        <http://example.org/education/concept/Matrizenrechnung>,
        <http://example.org/education/concept/Numerische_Analysis>,
        <http://example.org/education/concept/Singularwertzerlegung>,
        <http://example.org/education/concept/Varianzanalyse>,
        <http://example.org/education/concept/exponentielles_Modell>,
        <http://example.org/education/concept/lineare_Regression> ;
    dcterms:title "Numerische Methoden im Data Science Machine Learning"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

