    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik für das Verkehrsingenieurwesen behandelt die Zugkrafterzeugung und -übertragung bei verschiedenen Triebfahrzeugen, einschließlich Diesel-, elektrischer und unkonventioneller Antriebe. Durch das Studium dieser Materialien können Lernende die fahrdynamischen Charakteristiken von Schienenfahrzeugen verstehen und die Vorteile und Nachteile unterschiedlicher Leistungsübertragungstechnologien erkennen. Die Inhalte umfassen Übersichten über mechanische, hydraulische, elektrische und hydrodynamische Leistungsübertragungen sowie Beispiele von Triebfahrzeugen wie der Vossloh G 1206 oder der BR 642."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6VzqzVlH_LrA" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Elektrische_Bahnen> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Elektrofahrzeug>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Energiespeicherung>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Triebfahrzeug>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Zugkrafterzeugung> ;
    dcterms:title "Fahrdynamik für das Verkehrsingenieurwesen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

