        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Streckenplanung>,
        <http://example.org/education/concept/Zugwiderstand> ;
    dcterms:title "Fahrdynamik Bahnfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

