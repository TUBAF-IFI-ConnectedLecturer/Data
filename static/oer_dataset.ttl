oer:3L5Jrqt7LRsg a edu:LearningResource ;
    sim:similarTo oer:3M_zk2UJyabA,
        oer:3V4nUxzaOjAM,
        oer:3_PhPw4AnLvA,
        oer:3dwLRvq2kh-k,
        oer:3i_LT0lozlPk,
        oer:3wnkfl7XzxUk,
        oer:3zez7VC5ots8,
        oer:5f2120dpWRzA,
        oer:8fwxVXkMqHK8 ;
    dcterms:creator <http://example.org/education/person/Menzel> ;
    dcterms:description "Die Vermaschung von Objekten in polytopale Zellen ermöglicht die Anwendung von Interpolationsmethoden auf unregelmäßig verteilten Punkten, wobei die natürliche Nachbarschaftsbeziehung zwischen den Punkten berücksichtigt wird. Durch die Verwendung von Voronoi-Diagrammen und Delaunay-Triangulationen können komplexe geometrische Objekte in simpler zu handhabende Teilbereiche aufgeteilt werden, um anschließend Interpolationsmethoden anzuwenden. Diese Methoden finden Anwendung in verschiedenen Bereichen wie Computer-Aided-Design, Geoinformatik und Computational Geometry."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3L5Jrqt7LRsg" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Computational_Geometry>,
        <http://example.org/education/concept/Computer-Aided_Design>,
        <http://example.org/education/concept/Delaunay-Triangulation>,
        <http://example.org/education/concept/Geoinformatik>,
        <http://example.org/education/concept/Geometrische_Modellierung>,
        <http://example.org/education/concept/Interpolation>,
        <http://example.org/education/concept/Polytope>,
        <http://example.org/education/concept/Triangulation>,
        <http://example.org/education/concept/Vermaschung>,
        <http://example.org/education/concept/Voronoi-Diagramm> ;
    dcterms:title "3D Geomodellierung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:3PCQ3XSFsu8s a edu:LearningResource ;
    sim:similarTo oer:3PIwrztvGTbE,
        oer:4UJwn8XP8zPQ,
        oer:4XvimtshZPvI,
        oer:4cSeDq9baFdU,
        oer:4yZwBJ0I1_oA,
        oer:5T9BfmE3c3xU,
        oer:88pj197JX-Yg,
        oer:8OTiIMWePGR4,
        oer:8ZqTzDCGz0OY ;
    dcterms:creator <http://example.org/education/person/Burchhardt> ;
    dcterms:description "Diese Aufgabenstellung zum Entity-Relationship-Modell dient der Vorbereitung auf die mündliche Abiturprüfung im Fach Informatik und behandelt die Grundlagen von ER-Diagrammen, ihre Bestandteile und Anwendungsbereiche. Durch das Bearbeiten dieser Aufgaben erwerben die Lernenden Kenntnisse über die Modellierung von Daten und die Visualisierung von Ausschnitten der realen Welt mittels ER-Modellen. Sie lernen, ein ER-Diagramm zu erstellen, Primärschlüssel und Fremdschlüssel zu kennzeichnen sowie Kardinalitäten nach Chen anzugeben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3PCQ3XSFsu8s" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Abiturpr%C3%BCfung>,
        <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datenbanksysteme>,
        <http://example.org/education/concept/Datenmanagement>,
        <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Entity-Relationship-Modell>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Lehrplan>,
        <http://example.org/education/concept/relationale_Datenbanken> ;
    dcterms:title "Mündliche Abiturprüfung Fach Informatik - Grundkurs"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3kL2VRHg4TrE a edu:LearningResource ;
    sim:similarTo oer:5JYM9D6ZalyQ ;
    dcterms:creator <http://example.org/education/person/Michael>,
        <http://example.org/education/person/Scheuerer> ;
    dcterms:description "Die Interpolation ist ein wichtiger Schritt in der Geomodellierung, bei dem aus bekannten Daten eine Vorschrift entwickelt wird, um unbekannte Werte an Positionen ohne gegebene Werte vorherzusagen. Durch die Anwendung von Interpolationsverfahren wie stückweiser konstanter, linearer oder polynomialer Interpolation können Lernende plausible Vorhersagen treffen und ihre Fähigkeiten in der Datenanalyse und -interpretation verbessern. Die verschiedenen Verfahren werden ausführlich erläutert, um die Lernenden bei der Auswahl des geeigneten Verfahrens für ihre spezifischen Anwendungen zu unterstützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3kL2VRHg4TrE" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Modellierung>,
        <http://example.org/education/concept/Computerunterst%C3%BCtzte_Verfahren>,
        <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Geoinformatik>,
        <http://example.org/education/concept/Geomodellierung>,
        <http://example.org/education/concept/Interpolation>,
        <http://example.org/education/concept/Kartographie>,
        <http://example.org/education/concept/Raumbezogene_Datenverarbeitung>,
        <http://example.org/education/concept/mathematische_Modellierung>,
        <http://example.org/education/concept/numerische_Mathematik> ;
    dcterms:title "3D-Geomodellierung und Interpolation"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

