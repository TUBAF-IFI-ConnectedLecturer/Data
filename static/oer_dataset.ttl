oer:11q2SkkM21dLo a edu:LearningResource ;
    sim:similarTo oer:12tc-IR-g3AXs,
        oer:6HImeEcR-rN0 ;
    dcterms:creator <http://example.org/education/person/Schimpf> ;
    dcterms:description "Der Versuch behandelt das Verhalten eines Kondensators in zwei Fällen: im Gleichstromkreis und im Wechselstromkreis. Durch die Messungen wird gezeigt, dass die Spannung am Kondensator von der Frequenz abhängt und mit zunehmender Frequenz sinkt. Die Auswertung der Ergebnisse ermöglicht es, das Verhalten des Kondensators in verschiedenen Stromkreisen zu verstehen und Fehlerquellen zu berücksichtigen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "11q2SkkM21dLo" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Elektromagnetismus>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Entladevorgang>,
        <http://example.org/education/concept/Frequenz>,
        <http://example.org/education/concept/Gleichstromkreis>,
        <http://example.org/education/concept/Kondensator>,
        <http://example.org/education/concept/Ladevorgang>,
        <http://example.org/education/concept/Spannung>,
        <http://example.org/education/concept/Stromst%C3%A4rke>,
        <http://example.org/education/concept/Wechselstromkreis> ;
    dcterms:title "Protokoll Versuch 2: Kondensator im Gleichstromkreis"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:11tHqH-7XLM90 a edu:LearningResource ;
