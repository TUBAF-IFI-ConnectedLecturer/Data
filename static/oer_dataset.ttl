oer:3SwGY_3Uq__o a edu:LearningResource ;
    sim:similarTo oer:3pSfHmOi5QEw,
        oer:3tnfjIIoVraY,
        oer:7sLC81F06_2Q ;
    dcterms:creator <http://example.org/education/person/Zahn> ;
    dcterms:description "Die Arbeit beschreibt die Durchführung von Messungen zur Punk-zu-Punkt-Kommunikation mittels MPI auf einem Hochleistungsrechnercluster und analysiert die Ergebnisse hinsichtlich der Übertragungszeiten und -raten. Die Messungen zeigen, dass die konkrete Speicherarchitektur und die Verwendung von Infiniband einen erheblichen Einfluss auf die Kommunikationsgeschwindigkeit haben. Durch das Studium dieser Arbeit können Lerner Einblick in die Funktionsweise von Hochleistungsrechnerclustern und die Optimierung von parallelen Anwendungen gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3SwGY_3Uq__o" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bandbreitenmessung.>,
        <http://example.org/education/concept/Cache-Hierarchy>,
        <http://example.org/education/concept/Cluster-Computing>,
        <http://example.org/education/concept/Hochleistungsrechnen>,
        <http://example.org/education/concept/InfiniBand>,
        <http://example.org/education/concept/MPI>,
        <http://example.org/education/concept/Message_Passing_Interface>,
        <http://example.org/education/concept/Parallelverarbeitung>,
        <http://example.org/education/concept/Punkt-zu-Punkt-Kommunikation>,
        <http://example.org/education/concept/Speicherarchitektur> ;
    dcterms:title "3. Punkt-zu-Punkt-Kommunikation mit MPI"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:3XnOWIyGUC-M a edu:LearningResource ;
    sim:similarTo oer:7K0qgKq4b3Rs ;
    dcterms:description "In diesem Tutorial lernen Sie, wie Sie mit einem Arduino und einer RGB-LED alle sichtbaren Farben erzeugen können, indem Sie die PWM-Funktion nutzen, um die Helligkeit der LEDs anzupassen. Durch den Einsatz von analogWrite() anstelle von digitalWrite() können Sie feinere Abstufungen der Farben erreichen und somit eine Vielzahl von Farbtönen erzeugen. Am Ende des Tutorials haben Sie gelernt, ein Farbthermometer zu erstellen, das verschiedene Temperaturen durch unterschiedliche Farben anzeigt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3XnOWIyGUC-M" ;
    dcterms:subject <http://example.org/education/concept/Arduino>,
        <http://example.org/education/concept/Elektronik>,
        <http://example.org/education/concept/Farbe>,
        <http://example.org/education/concept/Farbmischung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/LED>,
        <http://example.org/education/concept/Mikrocontroller>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/RGB-LED>,
        <http://example.org/education/concept/Steuerungstechnik> ;
    dcterms:title "Farbthermometer"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

