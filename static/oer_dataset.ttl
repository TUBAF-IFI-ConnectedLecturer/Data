    dcterms:title "Quaternionen Rechenoperationen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7JHwQIcWTZpo a edu:LearningResource ;
    sim:similarTo oer:7e0VkFDi10Do ;
    dcterms:description "Die Vorlesung behandelt die Torsion von Stäben mit verschiedenen Querschnitten, einschließlich kreisrundem und rechteckigem Vollquerschnitt sowie dunnwandigem, geschlossenem Profil. Es werden die grundlegenden Gleichungen und Beziehungen für die Berechnung der Torsionsmomente, Schubspannungen und Verdrillung hergeleitet. Durch das Studium dieser Vorlesung können Lernende die erforderlichen Kenntnisse und Fähigkeiten erwerben, um Probleme der Torsion in der Technischen Mechanik zu lösen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7JHwQIcWTZpo" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Beanspruchung>,
