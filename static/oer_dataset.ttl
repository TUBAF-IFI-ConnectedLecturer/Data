        <http://example.org/education/concept/Sch%C3%BCttungsparameter>,
        <http://example.org/education/concept/disperses_System> ;
    dcterms:title "Fakultät für Verfahrenstechnik - Lehrstuhl für Mechanische Verfahrenstechnik - Einführung in die Verfahrenstechnik - Kapitel 3: Kennzeichnung disperser Systeme"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:17yOCO6tYUsww a edu:LearningResource ;
    sim:similarTo oer:3QH5B3Zfs3Xg,
        oer:6I-f_TmeM3m8,
