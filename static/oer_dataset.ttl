oer:11C_D31Y_IPnk a edu:LearningResource ;
    sim:similarTo oer:11KGzO3yMNF-M,
        oer:7czQ436Ao9kw,
        oer:8zLWa81hV7Y4 ;
    dcterms:creator <http://example.org/education/person/Winter> ;
    dcterms:description "Die Universitätsbibliothek der Humboldt-Universität zu Berlin hat ihr Etatverteilungsmodell (EVM) überarbeitet, um die Mittelverteilung zwischen den Fächern gerechter und transparenter zu gestalten. Das neue Modell berücksichtigt externe Kennzahlen wie Durchschnittspreise für gedruckte und elektronische Medien sowie Studierendenzahlen, um eine faire Verteilung der Mittel sicherzustellen. Durch die Anwendung des EVM können Bibliotheken ihre Ressourcen effektiver planen und bereitstellen, um den Bedarf der Studierenden und Forschenden besser zu erfüllen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11C_D31Y_IPnk" ;
    dcterms:publisher <http://example.org/education/organization/Humboldt-Universit%C3%A4t_zu_Berlin> ;
    dcterms:subject <http://example.org/education/concept/Akademische_Bibliotheken>,
        <http://example.org/education/concept/Bibliographische_Katalogisierung>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Etatverteilung>,
        <http://example.org/education/concept/Hochschulbibliotheken>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Informationsressourcen>,
        <http://example.org/education/concept/Medienkommission>,
        <http://example.org/education/concept/Universit%C3%A4tsbibliothek>,
        <http://example.org/education/concept/Wissenschaftliche_Literatur> ;
    dcterms:title "Etatverteilungsmodell 2020"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:11GVBkbJZ1vxQ a edu:LearningResource ;
    sim:similarTo oer:12hgjSZ3jyAXw,
        oer:3O8RL0OohEQw,
        oer:6haLhg9U_nME ;
    dcterms:creator <http://example.org/education/person/Bechet> ;
    dcterms:description "Die Aufgaben behandeln die Beschreibung von Geraden in einem Punktsystem und die Bestimmung paralleler Geraden durch einen bestimmten Punkt. Die Lösungen erfordern das Verständnis geometrischer Beziehungen zwischen Punkten und Geraden. Durch das Lösen dieser Aufgaben können Lerner ihr Wissen über die Geometrie von Geraden und Punkten festigen und ihre Fähigkeit zur Anwendung geometrischer Konzepte verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11GVBkbJZ1vxQ" ;
    dcterms:subject <http://example.org/education/concept/Analytische_Geometrie>,
        <http://example.org/education/concept/Ebene_Geometrie>,
