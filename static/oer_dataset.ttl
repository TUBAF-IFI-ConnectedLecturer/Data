        <http://example.org/education/concept/Pflanzen%C3%B6kologie>,
        <http://example.org/education/concept/Pflanzenschutz>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Vegetationskunde> ;
    dcterms:title "BIODIVINA - Datenbank zur Biodiversität in Weinbergen"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

