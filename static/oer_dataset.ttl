oer:9cOjlSsSnjVw a edu:LearningResource ;
    sim:similarTo oer:9hWZpjyhQa-o,
        oer:9tEDZ6frJBbM ;
    dcterms:creator <http://example.org/education/person/Greulich>,
        <http://example.org/education/person/Kobel>,
        <http://example.org/education/person/Zimmermann> ;
    dcterms:description "Das Lehrstrategie-Board der TU Dresden diskutiert und beschließt Maßnahmen zur Verbesserung der Lehre und des Lernens, insbesondere im Bereich der Digitalisierung und Kompetenzorientierung. Durch die Umsetzung dieser Vorschläge sollen Studierende befähigt werden, sich an einer zunehmend digital geprägten Arbeitswelt zu beteiligen und lebenslanges Lernen zu ermöglichen. Die Dokumentation der Sitzung bietet Einblick in die strategischen Ziele und Empfehlungen für die Praxis des Lehrens und Lernens an der TU Dresden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9cOjlSsSnjVw" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Barrierefreiheit>,
        <http://example.org/education/concept/Bildungspolitik>,
        <http://example.org/education/concept/Digitalisierung_in_der_Lehre>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Hochschulentwicklung>,
        <http://example.org/education/concept/Kompetenzorientierung>,
        <http://example.org/education/concept/Lehrstrategie>,
        <http://example.org/education/concept/Open_Educational_Resources>,
        <http://example.org/education/concept/Qualit%C3%A4tsmanagement>,
        <http://example.org/education/concept/Studienreform> ;
    dcterms:title "Sitzungsprotokoll Lehrstrategie-Board"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:9fZ2aiBlvsr8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Bertrand>,
        <http://example.org/education/person/Bombach>,
        <http://example.org/education/person/Riemer> ;
    dcterms:description "Diese Übungsaufgaben behandeln Implizite Funktionen und Extremwertaufgaben im Mathematik-III-Kurs für IF, ET und Ph-Studierende am Wintersemester 2023/24. Durch die Lösung der Aufgaben können Studierende ihre Fähigkeiten in der Berechnung von Punkten, Tangenten und Extrema von Funktionen verbessern. Die Aufgaben decken verschiedene Aspekte ab, darunter die Bestimmung von lokalen Extrema, die Berechnung von Tangenten und die Optimierung von Funktionen unter Nebenbedingungen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9fZ2aiBlvsr8" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Analysis>,
