        <http://example.org/education/concept/stumpfwinklig>,
        <http://example.org/education/concept/unregelm%C3%A4%C3%9Fig> ;
    dcterms:title "Mathematik 6 Innenwinkelsumme von Dreiecken"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8NWQgwzhq_ZY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Mustermann> ;
    dcterms:description "Dieses Schuljahreszeugnis enthält die Noten eines Schülers namens Max Mustermann in verschiedenen Fächern wie Deutsch, Mathematik und Englisch. Die Noten sind für zwei Halbjahre aufgeführt, sowie der Jahresdurchschnitt und der Notendurchschnitt berechnet wurden. Durch das Studium dieses Zeugnisses können Lerner die Entwicklung ihrer Leistungen in verschiedenen Fächern verfolgen und ihre Stärken und Schwächen erkennen."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "8NWQgwzhq_ZY" ;
    dcterms:subject <http://example.org/education/concept/Bildungsmanagement>,
        <http://example.org/education/concept/Durchschnittsberechnung>,
        <http://example.org/education/concept/Jahresdurchschnitt>,
        <http://example.org/education/concept/Leistungsbeurteilung>,
        <http://example.org/education/concept/Notenberechnung>,
        <http://example.org/education/concept/Notensystem>,
        <http://example.org/education/concept/Sch%C3%BClerleistung>,
        <http://example.org/education/concept/Schuljahresergebnis>,
        <http://example.org/education/concept/Schulzeugnis>,
        <http://example.org/education/concept/Zeugnisausstellung> ;
    dcterms:title "Notenberechnung für Schuljahreszeugnis"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:8NqBCEt2G2ws a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hanke>,
        <http://example.org/education/person/K%C3%BChn>,
        <http://example.org/education/person/Kurzmanowski> ;
    dcterms:description "Die Arbeit beschreibt die Entwicklung einer mobilen App zur Messeplanung, die es Nutzern ermöglicht, ihre Zeit auf der Messe effizient zu planen und alle notwendigen Schritte auszuführen. Die App bietet Funktionen wie einen Zeitplan, Zugriff auf Details und eine Übersicht über alle Infos auf einen Blick. Durch die Anwendung dieser App können Nutzer ihr Ziel erreichen, alles auf der Messe ohne viel Stress zu bewältigen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "8NqBCEt2G2ws" ;
    dcterms:subject <http://example.org/education/concept/Ausbildungsmessen>,
        <http://example.org/education/concept/Benutzeroberfl%C3%A4che>,
        <http://example.org/education/concept/Berufsbildung>,
