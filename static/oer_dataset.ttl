        <http://example.org/education/concept/Raumgeometrie> ;
    dcterms:title "Hausaufgaben 1"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:11K3AvwQ0V0dg a edu:LearningResource ;
    sim:similarTo oer:14YY5xaASB3Sg,
        oer:14uuEK4cYnJ-o,
        oer:7aTXZnyoFnec ;
    dcterms:description "Die Organisation einer Bibliothek kann nach verschiedenen Prinzipien erfolgen, wie der Funktionalorganisation, die sich auf Funktionen oder Verrichtungen konzentriert, oder der Divisional-Spartenorganisation, die sich auf Produkte oder Objekte fokussiert. Durch das Verständnis dieser Organisationsprinzipien können Bibliothekare ihre Arbeit besser strukturieren und koordinieren. Die Analyse von Organigrammen aus verschiedenen Bibliotheken kann dabei helfen, die Stärken und Schwächen unterschiedlicher Organisationsformen zu erkennen und die eigene Arbeitsweise zu verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11K3AvwQ0V0dg" ;
    dcterms:publisher <http://example.org/education/organization/Karlsruher_Institut_f%C3%BCr_Technologie> ;
    dcterms:subject <http://example.org/education/concept/Bibliotheksleitung>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Divisionalorganisation>,
        <http://example.org/education/concept/Funktionalorganisation>,
        <http://example.org/education/concept/Hierarchieebenen>,
        <http://example.org/education/concept/Linienorganisation>,
        <http://example.org/education/concept/Matrixorganisation>,
        <http://example.org/education/concept/Organisationsstruktur>,
        <http://example.org/education/concept/Stablinienorganisation>,
        <http://example.org/education/concept/Verwaltungsbibliothek> ;
    dcterms:title "Organisationsmodelle in Bibliotheken"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:11NAawlrz_yBU a edu:LearningResource ;
    sim:similarTo oer:3QEDhmgYi9aE,
        oer:3TsMMJFjsFEk,
        oer:3pSfHmOi5QEw ;
    dcterms:creator <http://example.org/education/person/Merkel> ;
    dcterms:description "Der Vergleich von Straight-Mergesort und Rekursivem Mergesort zeigt die Leistung von drei verschiedenen Implementierungen (O1, O2, O3) bei der Sortierung von 1 Million Elementen in absteigender Reihenfolge. Die Ergebnisse werden in Form von Perfstat-Werten wie task-clock, cycles und IPC dargestellt. Durch das Studium dieser Daten können Lerner die Effizienz von verschiedenen Algorithmen für die Lösung von Sortierproblemen besser verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11NAawlrz_yBU" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Cache-Gr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Hochleistungsrechnen>,
        <http://example.org/education/concept/Leistungsbewertung>,
        <http://example.org/education/concept/Mehrkernprozessoren>,
        <http://example.org/education/concept/Mergesort>,
        <http://example.org/education/concept/Parallelverarbeitung>,
        <http://example.org/education/concept/Prozessoren>,
        <http://example.org/education/concept/Rechnerarchitektur>,
        <http://example.org/education/concept/Sortierverfahren> ;
    dcterms:title "Straight-Mergesort - µBefehle: O1 vs. O2 vs. O3"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

