        <http://example.org/education/concept/Oberschule>,
        <http://example.org/education/concept/Programmierumgebung>,
        <http://example.org/education/concept/Robot_Karol> ;
    dcterms:title "Modul Didaktik der INF - E-Learning und Tools Lehramt Informatik (Gy, MS, BS, FS)"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

