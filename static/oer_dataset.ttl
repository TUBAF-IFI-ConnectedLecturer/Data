oer:4ongZA5js2I8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hartmann> ;
    dcterms:description "Die Microservice-Architektur (MSA) ist ein Architekturstil, der Systeme durch kleine, unabhängige und self-contained Services definiert und erzeugt, die eng an die Geschäftsarchitektur und Geschäftsaktivitäten angelehnt sind. Durch die Anwendung von MSA können Unternehmen schnellere Reaktionszeiten auf Änderungen des Marktes erreichen und die Vorteile moderner Paradigmen wie CICD und DevOps nutzen. Learner erfahren, wie sie eine MSA implementieren, welche Eigenschaften und Prinzipien dabei zu beachten sind und wie sie die Vorteile von Microservices nutzen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4ongZA5js2I8" ;
    dcterms:subject <http://example.org/education/concept/Cloud-Computing>,
        <http://example.org/education/concept/Continuous_Integration>,
        <http://example.org/education/concept/DevOps>,
        <http://example.org/education/concept/Enterprise-Architektur>,
        <http://example.org/education/concept/Gesch%C3%A4ftsprozesse>,
        <http://example.org/education/concept/Informationstechnologie>,
        <http://example.org/education/concept/Microservices-Architektur>,
        <http://example.org/education/concept/Service-Oriented_Architecture>,
        <http://example.org/education/concept/Software-Entwicklung>,
        <http://example.org/education/concept/verteilte_Systeme> ;
    dcterms:title "VERTEILTE ANWENDUNGEN"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:4qbfyMWfbMJ8 a edu:LearningResource ;
    sim:similarTo oer:4rYWZir_z0Dw,
        oer:4yAS21D64AOo,
        oer:8TPKAUQBPDh4,
        oer:8WUS9X_72XAE ;
    dcterms:description "Die Risikobeurteilung einer Verpackungsanlage identifiziert und bewertet mögliche Gefährdungen für die Arbeitnehmer, wie mechanische, elektrische, thermische und psychische Belastungen, um Maßnahmen zur Risikominimierung zu entwickeln. Durch die Analyse der Arbeitsprozesse und -bedingungen werden potenzielle Gefahrenquellen ermittelt und ihre Auswirkungen auf die Arbeitnehmer beschrieben. Die Beurteilung dient als Grundlage für die Entwicklung von Sicherheitskonzepten und Schulungsprogrammen, um die Arbeitssicherheit zu verbessern und Unfälle zu vermeiden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4qbfyMWfbMJ8" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Arbeitsplatzgestaltung>,
        <http://example.org/education/concept/Arbeitssicherheit>,
        <http://example.org/education/concept/Elektrosicherheit>,
