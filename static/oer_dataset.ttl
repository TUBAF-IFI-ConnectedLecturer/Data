        <http://example.org/education/concept/Stadtsysteme>,
        <http://example.org/education/concept/Standorttheorie>,
        <http://example.org/education/concept/Wirtschaftsgeographie> ;
    dcterms:title "TU Dresden Georg Hirte: Regional- und Stadtökonomie"@de ;
