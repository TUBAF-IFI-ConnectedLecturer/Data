        <http://example.org/education/concept/Mischbarkeit>,
        <http://example.org/education/concept/Mischungsdichte>,
        <http://example.org/education/concept/Stoffeigenschaften>,
        <http://example.org/education/concept/Suspension>,
        <http://example.org/education/concept/Verfahrenstechnik>,
        <http://example.org/education/concept/Volumen> ;
    dcterms:title "Übungsaufgaben Grundlagen der MVT"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:12ndjv2dIsBj8 a edu:LearningResource ;
    sim:similarTo oer:7YIsfs57owuM,
