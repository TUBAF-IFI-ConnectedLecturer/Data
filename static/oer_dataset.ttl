        <http://example.org/education/concept/Digitale_Logik>,
        <http://example.org/education/concept/FlipFlops>,
        <http://example.org/education/concept/Multiplexer>,
        <http://example.org/education/concept/Rechnerarchitektur>,
        <http://example.org/education/concept/Schaltwerke>,
        <http://example.org/education/concept/Synthese_von_Schaltwerken> ;
    dcterms:title "Vorlesung Rechnerarchitektur  Digitale Logik und Schaltwerke"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:12jjhwXs5PN_w a edu:LearningResource ;
    sim:similarTo oer:5ju6DUf2wqG0,
        oer:5rNgIPOp086A,
        oer:6kXhp-LEXyPc,
        oer:7-p5vgbhqc7w ;
    dcterms:creator <http://example.org/education/person/Martin> ;
    dcterms:description "Die Studie untersucht den Zusammenhang zwischen der individuellen Ausprägung des Kognitionsbedürfnisses (NFC) und dem Entscheidungsverhalten in risikobehafteten Situationen, wobei die Iowa Gambling Task (IGT) als Entscheidungsspiel eingesetzt wird. Durch die Replikation einer vorherigen Studie soll ein tieferes Verständnis für die Mechanismen der Entscheidungsfindung in unsicheren und risikobehafteten Situationen entwickelt werden. Die Ergebnisse können dazu beitragen, die Wechselwirkung zwischen NFC und Entscheidungsverhalten besser zu verstehen und mögliche Anwendungen in verschiedenen Alltagssituationen zu identifizieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12jjhwXs5PN_w" ;
    dcterms:subject <http://example.org/education/concept/Entscheidungsfindung>,
        <http://example.org/education/concept/Entscheidungstheorie>,
        <http://example.org/education/concept/Experimentelle_Psychologie>,
        <http://example.org/education/concept/Framing-Effekt>,
        <http://example.org/education/concept/Iowa-Gambling-Task>,
        <http://example.org/education/concept/Kognitionswissenschaft>,
        <http://example.org/education/concept/Kognitive_Psychologie>,
        <http://example.org/education/concept/Need-for-Cognition>,
        <http://example.org/education/concept/Risikoverhalten>,
        <http://example.org/education/concept/Verhaltens%C3%B6konomie> ;
    dcterms:title "Individual differences in need for cognition and decision making in the Iowa Gambling Task"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:12jutJ1wIfxPQ a edu:LearningResource ;
    sim:similarTo oer:12nWFst8tMjKo,
