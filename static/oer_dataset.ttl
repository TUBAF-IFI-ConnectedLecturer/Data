        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Robotik>,
        <http://example.org/education/concept/Sensor>,
        <http://example.org/education/concept/Smart-Home>,
        <http://example.org/education/concept/Stromkreis> ;
    dcterms:title "Calliope mini Projekt Nachtlichter"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

