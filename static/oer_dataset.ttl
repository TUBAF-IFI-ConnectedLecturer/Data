oer:78w635-K5Fuc a edu:LearningResource ;
    sim:similarTo oer:7WwVJm0CaNyg,
        oer:9hWZpjyhQa-o ;
    dcterms:creator <http://example.org/education/person/Th%C3%BCmmler> ;
    dcterms:description "Die Technische Universität Dresden sucht eine Professur für Berufliche Didaktik der Sozialpädagogik am Institut für Berufspädagogik und Berufliche Didaktiken. Die Stelle umfasst die Ausbildung von Studierenden für das Lehramt an berufsbildenden Schulen in der beruflichen Fachrichtung Sozialpädagogik und die Leitung dieser beruflichen Fachrichtung. Bewerber sollten Erfahrungen in der beruflichen Didaktik der Sozialpädagogik, einschlägige Publikationen und einen einschlägigen Studienabschluss haben."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "78w635-K5Fuc" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Berufsbildung>,
        <http://example.org/education/concept/Berufsp%C3%A4dagogik>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Erziehungswissenschaften>,
        <http://example.org/education/concept/Hochschullehre>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Sozialarbeit>,
        <http://example.org/education/concept/Sozialp%C3%A4dagogik>,
        <http://example.org/education/concept/Universit%C3%A4tslehre>,
        <http://example.org/education/concept/Wohlfahrtswissenschaften> ;
    dcterms:title "An der Fakultät Erziehungswissenschaften ist im Institut für Berufspädagogik und Berufliche Didaktiken zum 01.04.2026 die Professur (W2) für Berufliche Didaktik der Sozialpädagogik zu besetzen."@de ;
    dcterms:type <http://example.org/education/type/Stellenausschreibung> .

oer:7AA32ws7QdPY a edu:LearningResource ;
    sim:similarTo oer:7AkY3YU2dfbc,
        oer:7GJbUAre7_4g ;
    dcterms:creator <http://example.org/education/person/Tosch> ;
    dcterms:description "Die Bestimmung der Biegeeigenschaften von Kunststoffen erfolgt nach der Norm DIN EN ISO 178:2019-08 durch eine 3-Punkt-Biegeprüfung. Die Prüfungen werden an verschiedenen Proben durchgeführt, um die Werkstoffkennwerte wie E-Modul, maximale Kraft und Bruchspannung zu bestimmen. Durch diese Prüfungen können die Eigenschaften von Kunststoffen wie PA, PS, ABS und PP untersucht und ihre Verwendung in der Praxis optimiert werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7AA32ws7QdPY" ;
    dcterms:publisher <http://example.org/education/organization/Leichtbau> ;
    dcterms:subject <http://example.org/education/concept/Biegeeigenschaften>,
        <http://example.org/education/concept/DIN_EN_ISO_178>,
        <http://example.org/education/concept/Festigkeit>,
        <http://example.org/education/concept/ISO_178>,
        <http://example.org/education/concept/Kunststoffe>,
        <http://example.org/education/concept/Kunststoffpr%C3%BCfung>,
        <http://example.org/education/concept/Materialwissenschaft>,
        <http://example.org/education/concept/Mechanische_Eigenschaften>,
        <http://example.org/education/concept/Polymer>,
        <http://example.org/education/concept/Werkstoffpr%C3%BCfung> ;
    dcterms:title "Bestimmung der Biegeeigenschaften von Kunststoffen Nach (ISO 178:2019)"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

