oer:8fxaKKSXSVoU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/L%C3%BChr>,
        <http://example.org/education/person/Motsch> ;
    dcterms:description "Das Wortfeld um Ansehen und Ehre wird im Deutschen und Französischen untersucht, wobei die Bedeutungsgeschichte und Konzepte wie Macht, Würde und Reputation analysiert werden. Durch die Analyse der Wortfelder können Lernende die Entwicklung von Begriffen und ihre Verbindungen zu anderen Konzepten verstehen. Dieses Wissen kann ihnen helfen, komplexe Texte besser zu interpretieren und feinere Nuancen in der Bedeutung von Wörtern wie Ansehen und Ehre zu erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8fxaKKSXSVoU" ;
    dcterms:subject <http://example.org/education/concept/Achtung>,
        <http://example.org/education/concept/Ansehen>,
        <http://example.org/education/concept/Ehre>,
        <http://example.org/education/concept/Macht>,
        <http://example.org/education/concept/Neuhochdeutsch>,
        <http://example.org/education/concept/Prestige>,
        <http://example.org/education/concept/Reputation>,
        <http://example.org/education/concept/Ruhm>,
        <http://example.org/education/concept/Schiller>,
        <http://example.org/education/concept/W%C3%B6rterbuch> ;
    dcterms:title "Wortfeldvergleich"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:8fyPV1vyBU8M a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Popp> ;
    dcterms:description "Das Arbeitsblatt behandelt die homologe Reihe der Alkane im Unterrichtsfach Chemie für die 9. Klasse und ermöglicht Lernenden, sich selbstständig mit Hilfe von Formeln und Schreibweisen vertraut zu machen. Durch die Bearbeitung des Materials können sie allgemeine Muster innerhalb der homologen Reihe erkennen und die Tabelle vollständig ausfüllen. Nach der Bearbeitung können Lernende die Formeln und Namen der ersten zehn Alkane sowie allgemeine Aussagen über den Fortschritt der homologen Reihe treffen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "8fyPV1vyBU8M" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Alkane>,
        <http://example.org/education/concept/Chemieunterricht>,
        <http://example.org/education/concept/Erd%C3%B6l_und_Erdgas>,
        <http://example.org/education/concept/Kohlenwasserstoffe>,
        <http://example.org/education/concept/Lernmaterial>,
        <http://example.org/education/concept/Struktur-Eigenschaften-Beziehung>,
        <http://example.org/education/concept/Unterrichtsplanung>,
        <http://example.org/education/concept/digitale_Medien_im_Unterricht>,
        <http://example.org/education/concept/homologe_Reihe>,
        <http://example.org/education/concept/organische_Chemie> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Arbeitsblatt> .

oer:8ghSvCejq2-E a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schr%C3%B6n> ;
    dcterms:description "Das Quiz zielt darauf ab, Schülerinnen und Schülern grundlegende Kenntnisse und Fähigkeiten zu testen und ihr Selbstvertrauen zu stärken. Durch die progressive Steigerung der Anforderungen werden sie dazu ermutigt, ihr Wissen weiter zu vertiefen, kritisch zu denken und Probleme zu lösen. Am Ende des Quizes können sich die Schülerinnen und Schüler selbstständig einordnen und ihre Leistung überprüfen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "8ghSvCejq2-E" ;
    dcterms:subject <http://example.org/education/concept/Bewertung_von_Informationen>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Kognitive_F%C3%A4higkeiten>,
        <http://example.org/education/concept/Lehrmethoden>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Motivation>,
        <http://example.org/education/concept/Probleml%C3%B6sungsstrategien>,
        <http://example.org/education/concept/Quiz>,
        <http://example.org/education/concept/Selbstvertrauen> ;
    dcterms:title "Kein Titel gefunden."@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:8hpFOUKRc8BU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Balzert>,
        <http://example.org/education/person/Breymann>,
        <http://example.org/education/person/M%C3%BCller> ;
    dcterms:description "Die Lehrveranstaltung behandelt die Grundlagen der Informatik und vermittelt den Studierenden ein systematisches Vorgehen bei der Lösung von Informatik-Problemen. Durch das Erlernen einer Programmiersprache und -umgebung sollen die Teilnehmer in der Lage sein, ein Programm zu erstellen, das genau definierte Aufgaben ausführt. Die Veranstaltung behandelt zudem die Geschichte der Rechenmaschinen, die digitale Funktionsweise und die Verwendung von Computern in verschiedenen Einsatzgebieten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8hpFOUKRc8BU" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Automatisierung>,
        <http://example.org/education/concept/Computerarchitektur>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Digitale_Systeme>,
        <http://example.org/education/concept/Geschichte_der_Informatik>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Informationstechnik>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Rechenmaschinen> ;
    dcterms:title "Grundlagen der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:8mOnvVb-il9E a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Spencer> ;
    dcterms:description "Die Nachbereitungsaufgabe behandelt zwei mathematische Aussagen und ihre Beweise. Die erste Aufgabe befasst sich mit der Verknüpfung von Mengenoperationen und dem Einsatz von De Morgan-Regeln, während die zweite Aufgabe die Potenzmenge einer Menge berechnet. Durch das Lösen dieser Aufgaben können Lernende ihre Fähigkeiten im Bereich der Mengenlehre und Logik verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8mOnvVb-il9E" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Assoziativit%C3%A4t>,
        <http://example.org/education/concept/Aussagenlogik>,
        <http://example.org/education/concept/Boolesche_Algebra>,
        <http://example.org/education/concept/De-Morgan-Regeln>,
        <http://example.org/education/concept/Kombinatorik>,
        <http://example.org/education/concept/Mengenoperationen>,
        <http://example.org/education/concept/Mengentheorie>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie>,
        <http://example.org/education/concept/formale_Systeme>,
        <http://example.org/education/concept/mathematische_Strukturen> ;
    dcterms:title "Nachbereitungsaufgabe N1"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8nlNdlriUZXI a edu:LearningResource ;
    dcterms:description "Die Bedienungsanleitung für eine Schlagbohrmaschine informiert über die bestimmungsgemäße Verwendung, Sicherheitshinweise und Wartung des Geräts, um einen sicheren und effizienten Einsatz zu gewährleisten. Durch das Lesen dieser Anleitung können Benutzer die Funktionsweise der Maschine verstehen, potenzielle Gefahren erkennen und Maßnahmen ergreifen, um Unfälle zu vermeiden. Darüber hinaus werden auch Hinweise zur Entsorgung von Elektrowerkzeugen und zum Umweltschutz gegeben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8nlNdlriUZXI" ;
    dcterms:subject <http://example.org/education/concept/Abfallentsorgung>,
        <http://example.org/education/concept/Bohrmaschinen>,
        <http://example.org/education/concept/Elektrosicherheit>,
        <http://example.org/education/concept/Elektrowerkzeuge>,
        <http://example.org/education/concept/Ger%C3%A4tebedienung>,
        <http://example.org/education/concept/Gewerbliche_Anwendung>,
        <http://example.org/education/concept/Schlagbohren>,
        <http://example.org/education/concept/Sicherheitshinweise>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Werkzeugwartung> ;
    dcterms:title "Bohrmaschine Bedienungsanleitung"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

