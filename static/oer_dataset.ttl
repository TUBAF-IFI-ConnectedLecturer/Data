        oer:4qbfyMWfbMJ8,
        oer:4rYWZir_z0Dw,
        oer:8TPKAUQBPDh4 ;
    dcterms:description "Die Identifizierung von Gefährdungen bei der Inbetriebnahme einer Verpackungsanlage ist das zentrale Thema dieses Werkes. Es werden verschiedene mechanische und physikalische Gefährdungen aufgezeigt, die durch die Maschine oder die Arbeitssituation entstehen können. Durch die Kenntnis dieser Gefährdungen sollen Beschäftigte Maßnahmen ergreifen, um Unfälle zu vermeiden und die Sicherheit am Arbeitsplatz zu erhöhen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4hb9bUa9KeGY" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Arbeitsplatzgestaltung>,
        <http://example.org/education/concept/Arbeitsschutz>,
        <http://example.org/education/concept/Arbeitssicherheit>,
        <http://example.org/education/concept/Betriebssicherheit>,
        <http://example.org/education/concept/Gef%C3%A4hrdungsanalyse>,
        <http://example.org/education/concept/Gesundheitsgef%C3%A4hrdung>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Verpackungstechnik>,
        <http://example.org/education/concept/Vibrationen>,
        <http://example.org/education/concept/mechanische_Gef%C3%A4hrdungen> ;
    dcterms:title "Identifizierung der Gefährdungen Inbetriebnahme"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:53tBeSBqRZ9g a edu:LearningResource ;
    sim:similarTo oer:69ihz2C4F4us,
        oer:6klZzss5aRIk,
        oer:7NWNUT6XPgXA,
        oer:8sTG35VRIK7Q ;
    dcterms:creator <http://example.org/education/person/Reithmeier>,
        <http://example.org/education/person/Reps> ;
    dcterms:description "Das Projekt \"Virtuelles Gestalten von Körper und Raum\" verbindet die Fächer Kunst und Informatik, indem virtuelle Plastiken angefertigt werden. Durch dieses Projekt gewinnen die Lernenden Einblick in die Theorie digitaler und analoger Vertreter, 3-dimensionale Plastiken und ihre Möglichkeiten sowie das Arbeiten mit 3-dimensionalen Programmen wie Tinkercad, Blender und Unreal Engine. Am Ende des Projekts können die Lernenden historische und aktuelle Vertreter und berühmte Werke kennen, Programme für 3D-Modellierung anwenden und Anwendungsbeispiele virtueller Plastiken erklären."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "53tBeSBqRZ9g" ;
    dcterms:subject <http://example.org/education/concept/3D-Modellierung>,
        <http://example.org/education/concept/Bildende_Kunst>,
        <http://example.org/education/concept/Computer-Aided_Design_%28CAD%29>,
        <http://example.org/education/concept/Digitale_Kunst>,
        <http://example.org/education/concept/Grafikdesign>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Kunst>,
        <http://example.org/education/concept/Medieninformatik>,
        <http://example.org/education/concept/Multimediadesign>,
        <http://example.org/education/concept/Virtuelle_Realit%C3%A4t> ;
    dcterms:title "Virtuelles Gestalten von Körper und Raum"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

