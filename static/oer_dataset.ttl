        <http://example.org/education/concept/Metallbearbeitung>,
        <http://example.org/education/concept/Oberfl%C3%A4chentechnik>,
        <http://example.org/education/concept/Plasmabehandlung>,
        <http://example.org/education/concept/Werkstoffwissenschaft> ;
    dcterms:title "Fertigungsplanung in der Additiven Fertigung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

