    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Bremsen der Schienenfahrzeuge werden im Hinblick auf ihre Grundlagen und Funktionen erläutert, wobei die verschiedenen Arten von Bremssohlen, wie Grauguss- und Verbundstoff-Sohlen, sowie ihre Eigenschaften und Anwendungen vorgestellt werden. Durch das Studium dieser Materialien können Lernende ein Verständnis dafür entwickeln, wie Bremsen in Schienenfahrzeugen funktionieren und welche Faktoren ihren Einsatz beeinflussen. Zudem werden die Auswirkungen von Bremssohlen auf den Radverschleiß und die Lärmemission behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "16hFoQkwhxORY" ;
    dcterms:subject <http://example.org/education/concept/Bremsen>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Fahrzeugkomponenten>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Materialwissenschaft>,
        <http://example.org/education/concept/Reibung>,
        <http://example.org/education/concept/Schienenbremsen>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Tribologie>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Bremsen der Schienenfahrzeuge (Grundlagen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

