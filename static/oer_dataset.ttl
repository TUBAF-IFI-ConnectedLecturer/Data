oer:10LnI8obGCnJ8 a edu:LearningResource ;
    sim:similarTo oer:10lmDIqgrz-6E,
        oer:11g6pX5tfYyxA,
        oer:11nq9A9Pc-bo8,
        oer:3RZ9RyhqG1W4,
        oer:5CeTpXXFggN0,
        oer:7Ws7c0QKh57E,
        oer:7zPH7AxkHE-A ;
    dcterms:creator <http://example.org/education/person/Braun> ;
    dcterms:description "Die Sicherheit von Webservices und RESTful Services wird durch die Verwendung von Transport Layer Security (TLS), WS-Security und OAuth sichergestellt. Durch den Einsatz dieser Technologien können Vertraulichkeit, Integrität und Authentifizierung in der Kommunikation zwischen Dienstanbietern und -nutzern gewährleistet werden. Die Anwendung dieser Sicherheitsmechanismen ermöglicht es, sichere Transaktionen durchzuführen und die Vertraulichkeit von Daten zu schützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10LnI8obGCnJ8" ;
    dcterms:subject <http://example.org/education/concept/Authentifizierung>,
        <http://example.org/education/concept/Autorisierung>,
        <http://example.org/education/concept/Datenverschl%C3%BCsselung>,
        <http://example.org/education/concept/Netzwerksicherheit>,
        <http://example.org/education/concept/SOAP>,
        <http://example.org/education/concept/SSL>,
        <http://example.org/education/concept/Sicherheit>,
        <http://example.org/education/concept/TLS>,
        <http://example.org/education/concept/Web-Services>,
        <http://example.org/education/concept/XML-Signatur> ;
    dcterms:title "Vorlesung SCC, Sicherheit"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

