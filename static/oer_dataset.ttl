oer:8YYYdz3lz538 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Nachname> ;
    dcterms:description "Das Material ermöglicht Schülern, die Merkmale einer Ballade zu erkennen und eine eigene Ballade filmisch umzusetzen. Durch die Verfilmung von Goethes \"Der Zauberlehrling\" können sie den Inhalt und Aufbau einer Ballade untersuchen und emotionaler zugänglich machen. Die Lernenden entwickeln ihre Fach-, Methoden- und Sozialkompetenz, indem sie in Gruppenarbeiten eine Ballade filmisch darstellen und präsentieren."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
