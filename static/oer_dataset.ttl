        <http://example.org/education/concept/Gleichungen>,
        <http://example.org/education/concept/Komplexanalysis>,
        <http://example.org/education/concept/Komplexe_Zahlen>,
        <http://example.org/education/concept/Mathematische_Analyse>,
        <http://example.org/education/concept/Ungleichungen> ;
    dcterms:title "Musterlösung Aufgabe"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

