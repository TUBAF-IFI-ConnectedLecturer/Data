oer:11oHkHoWuw2hA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/J%C3%A4ger> ;
    dcterms:description "Die Mitwirkung in der Selbstverwaltung der HTW Dresden bietet Studierenden die Möglichkeit, sich an hochschulpolitischen Entscheidungen zu beteiligen und ihre Fähigkeiten zu entwickeln. Durch die Teilnahme an Gremienwahlen im Sommersemester 2025 können sie Vertreterinnen und Vertreter in verschiedenen Gremien wie Senat, Erweiterten Senat und Fakultätsräten werden. Dadurch sammeln sie Erfahrungen für ihr weiteres Leben und entwickeln neue Fähigkeiten bei Entscheidungsfindungen, Kommunikation und Zusammenarbeit."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "11oHkHoWuw2hA" ;
    dcterms:publisher <http://example.org/education/organization/HTW_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Hochschulentwicklung>,
        <http://example.org/education/concept/Hochschulgremien>,
        <http://example.org/education/concept/Hochschulorganisation>,
        <http://example.org/education/concept/Hochschulpolitik>,
        <http://example.org/education/concept/Selbstverwaltung>,
        <http://example.org/education/concept/Studierendenvertretung>,
        <http://example.org/education/concept/Universit%C3%A4tsmanagement>,
        <http://example.org/education/concept/Wahlrecht>,
        <http://example.org/education/concept/akademische_Selbstverwaltung>,
        <http://example.org/education/concept/studentische_Mitbestimmung> ;
    dcterms:title "Mitwirkung in der Selbstverwaltung der HTW Dresden Gremienwahlen im Sommersemester 2025"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

