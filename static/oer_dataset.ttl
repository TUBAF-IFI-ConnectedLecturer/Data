    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7UKIjvHi_hKY a edu:LearningResource ;
    sim:similarTo oer:8wJ5OHRw9HuI ;
    dcterms:creator <http://example.org/education/person/Kruse-Weber> ;
    dcterms:description "Das Werk behandelt den Umgang mit Fehlern im Musikunterricht und beim Musizieren, um eine fehlerfreundliche Haltung zu fördern. Es werden Fehlerfolgen und Fehlerrisiken analysiert, um Strategien für einen erfolgreichen Umgang mit Fehlern zu entwickeln. Durch die Lektüre dieses Werkes können Leserinnen und Leser Kenntnisse über den fehlerfreundlichen Ansatz im Musikunterricht erwerben und ihre Fähigkeiten im Umgang mit Fehlern verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7UKIjvHi_hKY" ;
    dcterms:subject <http://example.org/education/concept/Fehlerbew%C3%A4ltigung>,
        <http://example.org/education/concept/Fehlerkultur>,
        <http://example.org/education/concept/Lehren_und_Lernen>,
        <http://example.org/education/concept/Musikalit%C3%A4t>,
        <http://example.org/education/concept/Musikdidaktik>,
        <http://example.org/education/concept/Musikp%C3%A4dagogik>,
        <http://example.org/education/concept/Musikpraxis>,
        <http://example.org/education/concept/Musikunterricht>,
        <http://example.org/education/concept/P%C3%A4dagogische_Psychologie>,
        <http://example.org/education/concept/Risikomanagement> ;
    dcterms:title "Fehlerfreundlich statt fehlerfrei. Umgang mit Fehlern, Fehlerfolgen und Fehlerrisiken beim Musizieren und Unterrichten"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:7YnTzBndMqqQ a edu:LearningResource ;
    sim:similarTo oer:7alLlsoIrNso ;
    dcterms:creator <http://example.org/education/person/Dettmar>,
        <http://example.org/education/person/Pfoser>,
        <http://example.org/education/person/Sieber> ;
    dcterms:description "Die Fassadenbegrünung bietet vielfältige Vorteile für Gebäude und Umwelt, wie die Verbesserung des Mikroklimas, Energieeinsparung und Förderung der Biodiversität. Durch verschiedene Beispiele und Anwendungen wird gezeigt, wie Fassadenbegrünung in der Praxis umgesetzt werden kann. Die Bildungsunterlagen vermitteln Wissen über die verschiedenen Arten von Fassadenbegrünung, ihre Vorteile und Pflegeanforderungen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "7YnTzBndMqqQ" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Darmstadt> ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologie>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
        <http://example.org/education/concept/Fassadenbegr%C3%BCnung>,
        <http://example.org/education/concept/Fassadengestaltung>,
        <http://example.org/education/concept/Geb%C3%A4udegestaltung>,
        <http://example.org/education/concept/Gr%C3%BCne_Architektur>,
        <http://example.org/education/concept/Landschaftsbau>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Vegetationsfl%C3%A4chen> ;
    dcterms:title "Fassadenbegrünung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:7egVWoorV7Fc a edu:LearningResource ;
    sim:similarTo oer:7w49jBSJeORU ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Lernpaket behandelt die allgemeine Definition und Arten von Leitungen, ihre Einsatzbereiche in verschiedenen Spannungsebenen und die Gründe dafür. Es erläutert die Verwendung von Leitungstypen in der Niederspannungsebene, Mittelspannungsebene und Hoch- und Höchstspannungsebene. Durch das Lernpaket können Studierende ein grundlegendes Verständnis von Leitungen und ihrem Einsatz in Netzen und Betriebsmitteln erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7egVWoorV7Fc" ;
    dcterms:subject <http://example.org/education/concept/Betriebsmittel>,
