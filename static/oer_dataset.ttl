        <http://example.org/education/concept/empirische_Sozialforschung>,
        <http://example.org/education/concept/qualitative_Forschung>,
        <http://example.org/education/concept/soziale_Ungleichheit> ;
    dcterms:title "Methoden der empirischen Sozialforschung"@de ;
