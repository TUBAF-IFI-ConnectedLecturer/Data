        <http://example.org/education/concept/Hochschuldidaktik>,
        <http://example.org/education/concept/Inklusion>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Studienorganisation> ;
    dcterms:title "Welche Vorteile hat digitale Barrierefreiheit und inklusive Lehre für Alle?"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10WY9EgG463sQ a edu:LearningResource ;
