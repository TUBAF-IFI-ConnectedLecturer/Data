    dcterms:creator <http://example.org/education/person/Hacker>,
        <http://example.org/education/person/Patrzek> ;
    dcterms:description "Die Diskussion behandelt die Bedeutung von Bestandsnutzungsmessungen für Bibliotheken, insbesondere im Kontext von Präsenzbeständen und ausleihbaren Medien. Durch die Analyse von Nutzungszahlen können Bibliothekare Entscheidungen treffen, welche Medien zu erhalten oder auszusondern sind, um den Bedürfnissen der Nutzer gerecht zu werden. Die Messung der Bestandsnutzung ist wichtig, um die Effizienz von Bibliotheken zu verbessern und die Verfügbarkeit relevanter Medien für die Nutzer sicherzustellen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "12uDEC93KVQw0" ;
