    dcterms:creator <http://example.org/education/person/Hacker>,
        <http://example.org/education/person/Johanna> ;
    dcterms:description "Die Seminarsitzung behandelt die bibliographische Katalogisierung und Indexierung von Archiven, insbesondere Staats- und Landesarchiven, die aufgrund ihrer historischen Entstehung und Aufgaben eine besondere Bedeutung für die Forschung und die Bevölkerung haben. Durch die Analyse dieser Archive können Lernende Einblicke in die Struktur Deutschlands und die Entwicklung der Archivlandschaft gewinnen. Zudem werden verschiedene Arten von Archiven vorgestellt, wie Parlamentsarchive, Wirtschaftsarchive, Herrschafts- und Adelsarchive, Medienarchive und Literaturarchive, um die Vielfalt der Archivtypen zu verdeutlichen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "11bKPXHMclgnY" ;
    dcterms:publisher <http://example.org/education/organization/After_Analyzing_The_Provided_Text__I_Did_Not_Find_Any_E-mail_Addresses_With_University_Domains._The_Conversation_Appears_To_Be_a_Discussion_About_Bibliographic_Cataloging_And_Indexing__Where_Participants_Share_Their_Thoughts_On_Various_Types_Of_Archives__Such_As_State_Archives__Cultural_Archives__And_Parliamentary_Archives._They_Also_Mention_Specific_Archive_Examples_In_Germany.since_No_E-mail_Addresses_With_University_Domains_Were_Found__I_Will_Return_An_Empty_String.> ;
    dcterms:subject <http://example.org/education/concept/Archivtypen>,
