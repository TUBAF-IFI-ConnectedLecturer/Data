    dcterms:creator <http://example.org/education/person/L%C3%B6ffler> ;
    dcterms:description "Die Vorlesung Triebfahrzeugtechnik behandelt die Gestaltung von Führerständen und Bedienelementen in Triebfahrzeugen, wobei sicherheitsrelevante Aspekte wie crashgerechte Auslegung, ergonomische Gestaltung und Schallschutz berücksichtigt werden müssen. Durch die Vorlesung sollen Studierende Kenntnisse über die Anforderungen an Führerstände und Bedienelemente erwerben, um sicherheitsorientierte und benutzerfreundliche Lösungen entwickeln zu können. Die Inhalte basieren auf Normen und Vorschriften wie EN 15227, UIC 612-0 und DIN 5566."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8Dgw7j88UUaM" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Technik_spurgef%C3%BChrter_Fahrzeuge> ;
    dcterms:subject <http://example.org/education/concept/Bedienungstechnik>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Ergonomie>,
        <http://example.org/education/concept/F%C3%BChrerstand>,
        <http://example.org/education/concept/Fahrzeugausr%C3%BCstung>,
        <http://example.org/education/concept/Instandhaltung>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Mensch-Maschine-Interface>,
        <http://example.org/education/concept/Schallschutz>,
        <http://example.org/education/concept/Triebfahrzeugtechnik> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

