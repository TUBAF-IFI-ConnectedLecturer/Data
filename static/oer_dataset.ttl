        <http://example.org/education/concept/Service-Komposition>,
        <http://example.org/education/concept/Software_as_a_Service>,
        <http://example.org/education/concept/Web-Dienste> ;
    dcterms:title "Vorlesung SCC  Service and Cloud Computing 5. SaaS - Entwicklung und Komposition von Diensten"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

