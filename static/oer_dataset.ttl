oer:10JhYcWXKh3g0 a edu:LearningResource ;
    sim:similarTo oer:11QoO4vE_FJNY,
        oer:11qdwraJKZEuo,
        oer:6uctFRBk4GaM ;
    dcterms:creator <http://example.org/education/person/Etscher>,
        <http://example.org/education/person/Kolb>,
        <http://example.org/education/person/Trost> ;
    dcterms:description "Die Planung von Wegen für Radfahrende und Zufußgehende sollte die Attraktivität der Verbindungen berücksichtigen, indem sie die Aufteilung in den Zustand der Verkehrsoberfläche, der Aufenthaltsqualität und Verkehrssicherheit vornimmt. Die Wahl des Fortbewegungsmittels findet eine Abwägung zwischen Zeit, Bequemlichkeit und Umgebung des Weges statt. Durch die Berücksichtigung dieser Faktoren können Straßenquerschnitte gestaltet werden, die alle Verkehrsarten auf optimale Weise berücksichtigen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10JhYcWXKh3g0" ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentlicher_Nahverkehr>,
        <http://example.org/education/concept/Fu%C3%9Fverkehr>,
        <http://example.org/education/concept/Infrastrukturplanung>,
        <http://example.org/education/concept/Mobilit%C3%A4t>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Radverkehr>,
        <http://example.org/education/concept/St%C3%A4dtebau>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Verkehrsplanung>,
        <http://example.org/education/concept/Verkehrssicherheit> ;
    dcterms:title "1. Übungsaufgabe Infrastrukturplanung"@de ;
