oer:8GmElqtWjrOA a edu:LearningResource ;
    sim:similarTo oer:8q490YOM1QEM,
        oer:9fKACmSQzSc4,
        oer:9mz8TBpZofEs ;
    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Bremsen von Schienenfahrzeugen und deckt Aspekte wie Bremsarten, -stellungen und -funktionen, sowie Anforderungen an die Bedienung und Sicherheit ab. Durch das Studium dieser Materialien können Lernende ein Verständnis dafür entwickeln, wie Bremsen in Schienenfahrzeugen funktionieren und welche sicherheitsrelevanten Aspekte bei der Konstruktion und dem Betrieb berücksichtigt werden müssen. Insbesondere werden die Normen und Regelwerke wie DIN EN 14198 und TSI Loc&Pas erläutert, die für die Entwicklung und den Einsatz von Bremsen in Schienenfahrzeugen maßgeblich sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8GmElqtWjrOA" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Technik_spurgef%C3%BChrter_Fahrzeuge> ;
    dcterms:subject <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Bremsen>,
        <http://example.org/education/concept/Bremssysteme>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/G%C3%BCterz%C3%BCge>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Reisez%C3%BCge>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Bremsen der Schienenfahrzeuge (Grundlagen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9KoYDCX_G-98 a edu:LearningResource ;
    sim:similarTo oer:9LJZYpo36fvs,
        oer:9NQzyiBVDiIk,
        oer:9eovj4dFAMdQ,
        oer:9lrPcoBDQBNs,
        oer:9puwDxajlLA8 ;
    dcterms:creator <http://example.org/education/person/Fricke> ;
    dcterms:description "Die Einschränkungsberechnung von Vollbahnfahrzeugen berücksichtigt die Breiteneinschränkung durch quasistatische Neigung und Unsymmetrie, wobei fünf Eingabewerte wie Fahrzeugbreite, -höhe und -länge sowie Gleisradius und Spurweite Einfluss auf den Einschränkungswert haben. Der Neigungskoeffizient beträgt für das Standardfahrzeug 30 mm und beeinflusst die Größe des Einschränkungswertes. Durch die Anwendung von Schränkungsfaktoren nach UIC 505-1 bzw. EN 15273-2 können Ingenieure und Fachleute die notwendigen Berechnungen durchführen, um sicherzustellen, dass Fahrzeuge den erforderlichen Lichtraumbedarf erfüllen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9KoYDCX_G-98" ;
    dcterms:subject <http://example.org/education/concept/Breiteneinschr%C3%A4nkung>,
        <http://example.org/education/concept/Eisenbahn>,
        <http://example.org/education/concept/Fahrzeugbegrenzungslinie>,
        <http://example.org/education/concept/H%C3%B6heneinschr%C3%A4nkung>,
        <http://example.org/education/concept/Lichtraum>,
        <http://example.org/education/concept/Neigetechnik>,
        <http://example.org/education/concept/Querverschiebung>,
        <http://example.org/education/concept/Schienenfahrzeug>,
        <http://example.org/education/concept/Stromabnehmer>,
        <http://example.org/education/concept/Unsymmetrie> ;
    dcterms:title "Grundlagen Sft: 5. Einschränkungsberechnung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

