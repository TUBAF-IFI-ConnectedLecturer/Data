        <http://example.org/education/concept/homologe_Reihe>,
        <http://example.org/education/concept/multimediales_Lernen>,
        <http://example.org/education/concept/organische_Stoffgemische> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Materialhandreichung> .

