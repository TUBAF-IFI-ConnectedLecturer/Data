oer:5Ng5OA_xyXks a edu:LearningResource ;
    sim:similarTo oer:5VJz59I1k3u0,
        oer:92TjhFR9rAd4,
        oer:9XkG__hcBwSE ;
    dcterms:creator <http://example.org/education/person/Neubauer> ;
    dcterms:description "Diese Klausur zum Sommersemester 2020 an der Berufsakademie Riesa umfasst neun Aufgaben zu Statistik und quantitativen Methoden, die den Studierenden helfen sollen, ihre Fähigkeiten in der Datenanalyse und -interpretation zu verbessern. Die Aufgaben decken Themen wie Deskriptive Statistik, Korrelationsanalyse, Hypothesentests und Wahrscheinlichkeitstheorie ab und fordern von den Studierenden die Anwendung statistischer Konzepte und Formeln auf verschiedene Beispieldaten. Durch das Bearbeiten dieser Klausur können die Studierenden ihre Kenntnisse in der Statistik und ihren Einsatz in der Praxis vertiefen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "5Ng5OA_xyXks" ;
    dcterms:publisher <http://example.org/education/organization/Berufsakademie_Riesa> ;
    dcterms:subject <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Hypothesentestung>,
        <http://example.org/education/concept/Konfidenzintervall>,
        <http://example.org/education/concept/Korrelationskoeffizient>,
        <http://example.org/education/concept/Signifikanztest>,
        <http://example.org/education/concept/Standardabweichung>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Wahrscheinlichkeit>,
        <http://example.org/education/concept/quantitative_Methoden>,
        <http://example.org/education/concept/t-Test> ;
    dcterms:title "PROBE-Klausur Statistik und quantitative Methoden"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

