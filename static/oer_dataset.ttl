oer:9u_N309FmeJQ a edu:LearningResource ;
    sim:similarTo oer:9yDtAm7JR2W8 ;
    dcterms:creator <http://example.org/education/person/Debus>,
        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Die Wahrscheinlichkeitstheorie wird anhand von Beispielen und Aufgaben erläutert, um die Grundlagen der klassischen Wahrscheinlichkeit zu verstehen. Durch das Lösen von Übungsaufgaben können Lerner die Konzepte der σ-Algebra, des Gesetzes der totalen Wahrscheinlichkeit und des Satzes von Bayes anwenden und ihre Fähigkeiten in der Berechnung von Wahrscheinlichkeiten verbessern. Am Ende des Dokuments werden die Lösungen zu den Aufgaben bereitgestellt, um das Verständnis der Lerner zu überprüfen und zu festigen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9u_N309FmeJQ" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Bayes-Theorem>,
        <http://example.org/education/concept/Ereignis>,
        <http://example.org/education/concept/Konditionale_Wahrscheinlichkeit>,
        <http://example.org/education/concept/Schaltungstheorie>,
        <http://example.org/education/concept/Stochastik>,
        <http://example.org/education/concept/Unabh%C3%A4ngigkeit>,
        <http://example.org/education/concept/Wahrscheinlichkeitsma%C3%9F>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie>,
        <http://example.org/education/concept/Zufallsvariable>,
        <http://example.org/education/concept/mathematische_Statistik> ;
    dcterms:title "TU Chemnitz  Professur Numerische Mathematik 10. Juni 2025 Prof. Dr. Oliver Ernst Dr. Sebastian Debus, Dr. Max Winkler Mathematik IV (für IF, ET, Ph) Sommersemester 2025 7. Übung: Klassische Wahrscheinlichkeit"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

