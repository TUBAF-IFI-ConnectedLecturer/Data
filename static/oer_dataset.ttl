oer:122vBtqrTbVfk a edu:LearningResource ;
    sim:similarTo oer:12jjhwXs5PN_w,
        oer:5ju6DUf2wqG0,
        oer:5rNgIPOp086A,
        oer:7-p5vgbhqc7w ;
    dcterms:creator <http://example.org/education/person/Harman> ;
    dcterms:description "Die Studie von Jason L. Harman untersucht den Einfluss des Kognitionsbedürfnisses auf die Entscheidungsfindung bei der Iowa Gambling Task und zeigt, dass Teilnehmer mit niedrigem Kognitionsbedürfnis anfälliger für Entscheidungsfehler sind und vermehrt Wert auf Gewinne legen. Durch die Analyse der IGT-Leistung bei Teilnehmenden mit extremeren NFC-Ausprägungen können individuelle Unterschiede in der komplexen Entscheidungsfindung besser verstanden werden. Die Ergebnisse dieser Studie haben Implikationen für die Beurteilung von Gewinnen und Verlusten in realen Entscheidungssituationen, insbesondere im Finanzsektor."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "122vBtqrTbVfk" ;
    dcterms:subject <http://example.org/education/concept/Emotion>,
        <http://example.org/education/concept/Entscheidungsfindung>,
        <http://example.org/education/concept/Finanzielle_Entscheidungen>,
        <http://example.org/education/concept/Geldanlage>,
        <http://example.org/education/concept/Iowa-Gambling-Task>,
        <http://example.org/education/concept/Kartenspiel-Paradigma>,
        <http://example.org/education/concept/Kognition>,
        <http://example.org/education/concept/Need-for-Cognition>,
        <http://example.org/education/concept/Neurologische_Erkrankungen.>,
        <http://example.org/education/concept/Risikobereitschaft> ;
    dcterms:title "Individual differences in need for cognition and decision making in the Iowa Gambling Task"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:1269BW6oV2DgM a edu:LearningResource ;
