        <http://example.org/education/concept/Verst%C3%A4rkerschaltung> ;
    dcterms:title "Arbeitspunkteinstellung eines Transistors Ein OPAL-Kurs"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

