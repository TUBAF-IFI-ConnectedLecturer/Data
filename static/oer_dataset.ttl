oer:9dqmS-Q2Bhzc a edu:LearningResource ;
    sim:similarTo oer:9fXhxbAr8iOM,
        oer:9fZ2aiBlvsr8,
        oer:9hzbXtf9EzVI,
        oer:9o2sSv7XEqXQ ;
    dcterms:creator <http://example.org/education/person/Bertrand>,
        <http://example.org/education/person/Bombach>,
        <http://example.org/education/person/Riemer> ;
    dcterms:description "Diese Übungsaufgaben behandeln Themen der Differentialrechnung in mehreren Variablen, wie partielle Ableitungen, Richtungsableitungen und totale Differenzierbarkeit von Funktionen. Durch die Lösung dieser Aufgaben können Lernende ihre Fähigkeiten im Bereich der mathematischen Analyse verbessern und ein tieferes Verständnis für die Anwendung von Differentialrechnung in verschiedenen Kontexten entwickeln. Insbesondere werden Konzepte wie Gradienten, Tangentialebenen und Wellengleichungen behandelt, die in vielen Bereichen der Physik, Ingenieurwissenschaften und Wirtschaftswissenschaften angewendet werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9dqmS-Q2Bhzc" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Differentialrechnung>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Gradient>,
        <http://example.org/education/concept/H%C3%B6here_Mathematik>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mathematische_Analyse>,
        <http://example.org/education/concept/Numerische_Mathematik>,
        <http://example.org/education/concept/Partielle_Ableitung>,
        <http://example.org/education/concept/Richtungsableitung>,
