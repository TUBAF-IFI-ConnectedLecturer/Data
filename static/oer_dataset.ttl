    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung \"Fahrdynamik für das Verkehrsingenieurwesen\" behandelt die Grundlagen der Fahrzeugbewegung und -dynamik im Schienenverkehr, einschließlich der Energiebedarfs- und Fahrzeitberechnung. Durch diese Lehrmaterialien erwerben die Lernenden Kenntnisse über die physikalischen Grundlagen des Schienenverkehrs, die Antriebs- und Bremskräfte sowie die Optimierung von Fahrplänen und -zeiten. Die Inhalte dieser Vorlesung dienen der Vorbereitung auf die Planung, den Bau und den Betrieb von Eisenbahnstrecken und -systemen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11CdEerEnTuK0" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Energieeffizienz>,
        <http://example.org/education/concept/Fahrzeugsimulation>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Verkehrswesen> ;
    dcterms:title "Fahrdynamik für das Verkehrsingenieurwesen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

