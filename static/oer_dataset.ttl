        <http://example.org/education/concept/G%C3%B6teborg>,
        <http://example.org/education/concept/Informationskompetenz>,
        <http://example.org/education/concept/Kinderliteratur>,
        <http://example.org/education/concept/Lesef%C3%B6rderung>,
        <http://example.org/education/concept/Mediennutzung>,
        <http://example.org/education/concept/Schweden> ;
    dcterms:title "Leseförderung insbesondere für Kleinkinder am Beispiel Göteborg"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

