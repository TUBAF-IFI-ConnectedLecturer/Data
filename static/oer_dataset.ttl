        <http://example.org/education/concept/Frequenzanalyse>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Signalverarbeitung>,
        <http://example.org/education/concept/Verst%C3%A4rkungstechnik>,
        <http://example.org/education/concept/Winkelmesstechnik> ;
    dcterms:title "Amplitude V Winkel V Amplitude V- Winkel V- Amplitude V0 Winkel V0"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:6qzNh8tndyq0 a edu:LearningResource ;
    sim:similarTo oer:82tjABUZLFQo,
        oer:882FyeR7q5yo,
        oer:8D_aAB-c5ok0,
        oer:8EUTaDBs5bWw,
