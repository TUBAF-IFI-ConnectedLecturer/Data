    dcterms:creator <http://example.org/education/person/Fricke> ;
    dcterms:description "Die Lastannahmen für die Festigkeitsberechnung von Schienenfahrzeugen werden detailliert erläutert, einschließlich der verschiedenen Lastfälle, wie zum Beispiel Auflaufstoß und Bremskräfte, sowie der erforderlichen Sicherheitskonzepte. Durch das Verständnis dieser Lastannahmen können Ingenieure und Fachleute die Festigkeit von Schienenfahrzeugen berechnen und sicherstellen, dass sie den Anforderungen entsprechen. Die Kenntnis dieser Grundlagen ist für die Entwicklung und Konstruktion sicherer und zuverlässiger Schienenfahrzeuge von großer Bedeutung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3U2vAWR0qgR8" ;
    dcterms:subject <http://example.org/education/concept/Bahnanwendungen>,
        <http://example.org/education/concept/Beanspruchungskennwerte>,
        <http://example.org/education/concept/Drehgestellrahmen>,
        <http://example.org/education/concept/Erm%C3%BCdungs-Festigkeitsnachweis>,
        <http://example.org/education/concept/Festigkeitsnachweis>,
        <http://example.org/education/concept/Konstruktionskennwerte>,
        <http://example.org/education/concept/Schienenfahrzeugbau>,
        <http://example.org/education/concept/Sicherheitsfaktoren>,
        <http://example.org/education/concept/Strukturfestigkeit>,
        <http://example.org/education/concept/Werkstoff-Festigkeitskennwerte> ;
    dcterms:title "TW: 5. Lastannahmen Folie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

