oer:3RZ9RyhqG1W4 a edu:LearningResource ;
    sim:similarTo oer:5CeTpXXFggN0,
        oer:7zPH7AxkHE-A ;
    dcterms:creator <http://example.org/education/person/Braun> ;
    dcterms:description "Die Sicherheit von Webservices und RESTful Services wird durch die Verwendung von Transport Layer Security (TLS), WS-Security und OAuth sichergestellt. Durch den Einsatz dieser Technologien können Vertraulichkeit, Integrität und Authentifizierung in der Kommunikation zwischen Dienstanbietern und -nutzern gewährleistet werden. Learner erhalten einen Überblick über die verschiedenen Sicherheitsaspekte und -mechanismen, die für den sicheren Austausch von Nachrichten zwischen Webservices erforderlich sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3RZ9RyhqG1W4" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_That_The_Author_Is_Affiliated_With_%22scc%22_Which_Likely_Stands_For_%22university_Of_Applied_Sciences%22_%28in_German%3A_%22hochschule_F%C3%BCr_Angewandte_Wissenschaften%22%29.however__a_More_Specific_Institution_Name_Is_Mentioned_In_The_Document%3A_%22dr.-ing._Iris_Braun_Vorlesung_Scc__Sicherheit%22._This_Suggests_That_The_Author_Is_Affiliated_With_The_University_Of_Applied_Sciences_%28scc%29_And_Teaches_a_Course_On_Security.therefore__I_Will_Return_The_Institution_Name%3A_%22university_Of_Applied_Sciences%22_Or_Simply_%22scc%22.> ;
    dcterms:subject <http://example.org/education/concept/Authentifizierung>,
