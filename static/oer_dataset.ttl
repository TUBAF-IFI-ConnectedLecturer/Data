    dcterms:creator <http://example.org/education/person/Kie%C3%9Fling> ;
    dcterms:description "Dieses Portfolio behandelt die Didaktik der Informatik und präsentiert eine Vielzahl von Unterrichtsbeispielen und Medien mit höherer Interaktivität, wie Active Inspire, Storytelling, LearningApps und Augmented Reality. Durch das Studium dieser Materialien können Lernende digitale Tafelbilder erstellen, interaktive Schaltflächen einsetzen, Vokabeltests durchführen und AR-Technologien im Unterricht anwenden. Ziel ist es, die Fähigkeiten der Lernenden zu stärken, um eigene Unterrichtsinhalte zu entwickeln und neue Einsatzszenarien zu erschließen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6iLriZu7rrZk" ;
    dcterms:subject <http://example.org/education/concept/Augmented_Reality>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Interaktive_Whiteboardsysteme>,
        <http://example.org/education/concept/Lernanwendungen>,
        <http://example.org/education/concept/Medienbildung>,
        <http://example.org/education/concept/Sch%C3%BClerfeedbacksysteme>,
        <http://example.org/education/concept/Unterrichtsbeispiele> ;
    dcterms:title "Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9LNBOgqmaKvU a edu:LearningResource ;
    sim:similarTo oer:9MXU3lly38Bc,
        oer:9cVKpYXboopo,
        oer:9wx8MYJu8q3I,
        oer:9ysxFnUUqULY ;
    dcterms:description "Die Kurzplanung für den interaktiven Unterricht unterstützt Lehrende bei der Erstellung eines strukturierten und zielführenden Unterrichts, indem sie die Bedingungen und Voraussetzungen der Lernenden berücksichtigt. Durch die Auseinandersetzung mit dem Thema werden die Lernenden befähigt, ihre Fähigkeiten und Kenntnisse zu erweitern und ihre individuellen Lernstile und Interessen zu entwickeln. Die Anwendung von Differenzierungs- und Individualisierungsmaßnahmen ermöglicht es den Lehrenden, auf die Heterogenität der Lernenden einzugehen und einen inklusiven Unterricht zu gestalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9LNBOgqmaKvU" ;
    dcterms:subject <http://example.org/education/concept/Bildungsmanagement>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Differenzierung>,
        <http://example.org/education/concept/Heterogenit%C3%A4t>,
        <http://example.org/education/concept/Inklusiver_Unterricht>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Lernprozesse>,
        <http://example.org/education/concept/Methodische_Analyse>,
        <http://example.org/education/concept/P%C3%A4dagogische_Psychologie>,
        <http://example.org/education/concept/Unterrichtsplanung> ;
    dcterms:title "Podcast-Transkript: Baustein 2: Kurzplanung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

