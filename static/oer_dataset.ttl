    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Diese Lehrmaterialien bieten eine Einführung in die germanistische Sprachwissenschaft und umfassen Themen wie Graphematik, Orthographie, Morphologie, Phonetik, Phonologie, Semantik und Semiotik. Durch das Studium dieser Materialien können Lernende ihre Kenntnisse über die deutsche Sprache erweitern und ihre Fähigkeiten in der Analyse und Beschreibung von sprachlichen Strukturen verbessern. Die Übungen und Aufgaben helfen dabei, die theoretischen Konzepte in die Praxis umzusetzen und die Anwendung auf konkrete Beispiele zu trainieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8oVZfzBpYteg" ;
    dcterms:subject <http://example.org/education/concept/Deutsch_als_Fremdsprache>,
        <http://example.org/education/concept/Graphematik>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Morphologie>,
        <http://example.org/education/concept/Orthographie>,
        <http://example.org/education/concept/Phonetik>,
        <http://example.org/education/concept/Phonologie>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Semiotik>,
        <http://example.org/education/concept/germanistische_Sprachwissenschaft> ;
    dcterms:title "Einführung in die germanistische Sprachwissenschaft"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

