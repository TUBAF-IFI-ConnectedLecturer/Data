    dcterms:creator <http://example.org/education/person/Achtziger>,
        <http://example.org/education/person/Richert> ;
    dcterms:description "Der Text behandelt die Bedeutung der Unterwuchsvegetation im Weinberg und ihre Funktionen für die Biodiversität. Es werden verschiedene Arten und ihre Eigenschaften vorgestellt, wie zum Beispiel Indikatorarten für klimarelevante Standortfaktoren oder Ruderaler Pioniertypen. Durch das Studium dieses Materials können Lernende Kenntnisse über die Vielfalt der Unterwuchsvegetation und ihre wichtigen Funktionen im Weinberg erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5ZKuFpGmSAMo" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kosystemfunktionen>,
        <http://example.org/education/concept/Agrar%C3%B6kosysteme>,
