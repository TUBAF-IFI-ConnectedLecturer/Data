        <http://example.org/education/concept/Storytelling>,
        <http://example.org/education/concept/Unterrichtsmaterialien>,
        <http://example.org/education/concept/maschinelles_Lernen> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Materialhandreichung> .

