oer:1-qe2Zw1m6SU a edu:LearningResource ;
    sim:similarTo oer:10lmDIqgrz-6E,
        oer:16D8qje6LR1QM,
        oer:16apl5AgKohaA,
        oer:1gnG44_FmP1E ;
    dcterms:creator <http://example.org/education/person/Jordan> ;
    dcterms:description "Die Aufgabenstellung behandelt die Grundlagen der Kryptologie und ihre Anwendung auf verschiedene Verschlüsselungsverfahren, wie das Vigenere-Verfahren und PGP. Durch die Bearbeitung dieser Aufgaben können Lernende die Teilgebiete der Kryptologie kennenlernen, Verfahren zur Nachrichtenverschlüsselung verstehen und die Sicherheit von Kommunikationsprozessen beurteilen. Zudem werden sie in die Lage versetzt, die Sinnhaftigkeit bestimmter Maßnahmen zu diskutieren und Schwachstellen in Verschlüsselungsverfahren zu erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1-qe2Zw1m6SU" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Datenverschl%C3%BCsselung>,
        <http://example.org/education/concept/Hybrid-Verfahren>,
        <http://example.org/education/concept/Informationssicherheit>,
        <http://example.org/education/concept/Klassische_Verschl%C3%BCsselungsverfahren>,
        <http://example.org/education/concept/Kryptologie>,
        <http://example.org/education/concept/Nachrichten%C3%BCbertragung>,
        <http://example.org/education/concept/PGP-Verfahren>,
        <http://example.org/education/concept/Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Vigenere-Verfahren> ;
    dcterms:title "Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

