        <http://example.org/education/concept/Psychologie>,
        <http://example.org/education/concept/Sozialpsychologie>,
        <http://example.org/education/concept/Ungerechtigkeit>,
        <http://example.org/education/concept/Viktimisierung> ;
    dcterms:title "Richtlinien zur Erstellung von Manuskripten für psychologische Fachzeitschriften"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

