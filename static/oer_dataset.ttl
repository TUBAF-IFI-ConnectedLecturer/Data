oer:5TYC6DWjR5r4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Reiter> ;
    dcterms:description "Die Erkundung des Mondes und anderer Himmelskörper ist ein wichtiger Schritt für die Zukunft der Raumfahrt und kann zu neuen Erkenntnissen und Entdeckungen führen. Durch die Analyse von Missionen wie Apollo, Cassini-Huygens und Chang'e 4 können wir Erfahrungen sammeln und neue Technologien entwickeln, um zukünftige Expeditionen auf den Mond und andere Planeten zu unterstützen. Die Erkundung des Weltraums kann auch zu neuen Entdeckungen in der Geologie, Biologie und Physik führen und unseren Blick auf das Universum erweitern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5TYC6DWjR5r4" ;
    dcterms:subject <http://example.org/education/concept/Apollo-Programm>,
        <http://example.org/education/concept/Astronaut>,
        <http://example.org/education/concept/Erkundung>,
        <http://example.org/education/concept/Mond>,
        <http://example.org/education/concept/Mondoberfl%C3%A4che>,
        <http://example.org/education/concept/NASA>,
        <http://example.org/education/concept/Raumfahrt>,
        <http://example.org/education/concept/Raumsonde>,
        <http://example.org/education/concept/Tr%C3%A4gerrakete>,
        <http://example.org/education/concept/Weltraum> ;
    dcterms:title "Die Exploration des Mondes und die Rolle Europas darin"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

