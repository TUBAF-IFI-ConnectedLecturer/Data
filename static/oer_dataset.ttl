oer:50d_80kwIR9k a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Bechler> ;
    dcterms:description "Der E-Book-Markt in Deutschland hat im ersten Halbjahr 2020 um 17,8 Prozent zugelegt, was auf die gestiegenen Umsätze und Absätze zurückzuführen ist. Die durchschnittliche Stückzahl pro Käuferin stieg um 15,0 auf 6,9 Exemplare, und die Pro-Kopf-Ausgaben erhöhten sich um 17,5 auf 44,31 Euro. Der Report bietet eine detaillierte Analyse der E-Book-Marktentwicklung in Deutschland und liefert wichtige Erkenntnisse für den Buchhandel und die Verlage."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "50d_80kwIR9k" ;
    dcterms:subject <http://example.org/education/concept/Buchhandel>,
        <http://example.org/education/concept/Buchmarkt>,
        <http://example.org/education/concept/Corona-Krise>,
        <http://example.org/education/concept/Deutschland>,
        <http://example.org/education/concept/E-Book>,
        <http://example.org/education/concept/E-Commerce>,
        <http://example.org/education/concept/Marktanalyse>,
        <http://example.org/education/concept/Publikumsbuchmarkt>,
        <http://example.org/education/concept/Umsatzentwicklung>,
        <http://example.org/education/concept/Verbraucherverhalten> ;
    dcterms:title "Das E-Book in Deutschland 1. Halbjahr 2020"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:50vfzq_y7vBg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Sieber> ;
    dcterms:description "Monique Wittig argumentiert, dass das heterosexuelle Denken Frauen, Homosexuellen und Lesben unterdrückt, indem es eine totalisierende Interpretation der Geschichte, sozialen Realität, Kultur, Sprache und subjektiven Phänomene produziert. Das heterosexuelle System basiert auf Unterschieden zwischen Mann und Frau, die politische Konzepte von Gegensätzen darstellen. Durch die Zerstörung dieser Kategorien kann das heterosexuelle System beendet werden, wodurch Frauen, Homosexuelle und Lesben ihre eigene Subjektposition einnehmen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "50vfzq_y7vBg" ;
    dcterms:subject <http://example.org/education/concept/Diskursanalyse>,
        <http://example.org/education/concept/Feminismus>,
        <http://example.org/education/concept/Frauenforschung>,
        <http://example.org/education/concept/Gender_Studies>,
        <http://example.org/education/concept/Geschlecht>,
        <http://example.org/education/concept/Heterosexualit%C3%A4t>,
        <http://example.org/education/concept/Homosexualit%C3%A4t>,
        <http://example.org/education/concept/Kulturkritik>,
        <http://example.org/education/concept/Sexuelle_Identit%C3%A4t>,
        <http://example.org/education/concept/Soziologie_des_Geschlechts> ;
    dcterms:title "Seminar Geschlechtersoziologie"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:50xBYB4tPkPc a edu:LearningResource ;
    dcterms:description "Das Lernmaterial behandelt die Symmetrie, insbesondere die Punktspiegelung, und fordert die Beschreibung der Durchführung dieser Operation. Es enthält Beispiele aus dem Alltag und bietet Übungsaufgaben zur Identifizierung punktsymmetrischer Figuren. Durch das Durcharbeiten dieses Materials können Lernende die Symmetrie besser verstehen und anwenden lernen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "50xBYB4tPkPc" ;
    dcterms:subject <http://example.org/education/concept/Dreieck>,
