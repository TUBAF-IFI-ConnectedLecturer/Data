oer:4e9adfGXIIYE a edu:LearningResource ;
    sim:similarTo oer:4pXdhEHhQpHY,
        oer:5s5fLCflWxiQ,
        oer:66pIeQLkVmhQ,
        oer:6SeAIQbBciKs ;
    dcterms:creator <http://example.org/education/person/Kossatz> ;
    dcterms:description "Die Reflexionen über Geschichte und Politik befassen sich mit der Frage, warum politische und gesellschaftliche Strukturen nicht auf wissenschaftliche Erkenntnisse reagieren können, und wie ideologische Instrumentalisierung von Geschichte kollektives Bewusstsein beeinflussen kann. Durch das Studium der Geschichte soll ein plausibles Verständnis der Welt erreicht werden, um eine bessere Zukunft zu gestalten. Die Aufgabe von Historikerinnen besteht darin, das humane Bedürfnis nach Erinnerung zu adressieren und ideologische Geschichtsdeutungen zu vermeiden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4e9adfGXIIYE" ;
    dcterms:publisher <http://example.org/education/organization/Uni_Jena> ;
    dcterms:subject <http://example.org/education/concept/Demokratie>,
        <http://example.org/education/concept/Erziehung>,
        <http://example.org/education/concept/Geschichte>,
        <http://example.org/education/concept/Ideologie>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Kommunismus>,
        <http://example.org/education/concept/Narration>,
        <http://example.org/education/concept/Politische_Bildung>,
        <http://example.org/education/concept/Sozialismus>,
        <http://example.org/education/concept/Wissenschaft> ;
    dcterms:title "Free Writing"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

