oer:17-V9W5WIWhug a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/peprny> ;
    dcterms:description "Bernd-Lutz Lange teilt seine selbst erlebten Ereignisse mit Humor, Sarkasmus und Kritik am System. Die Lesung gibt Einblick in die Jugend und Kindheit während des Kapitalismus und beschreibt die Schutzvorkehrungen gegen Strahlung nach einer Atombombendetonation. Durch diese Reflexion können Lernende Einsichten in die damaligen Verhältnisse und die Manipulation von Informationen gewinnen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "17-V9W5WIWhug" ;
    dcterms:subject <http://example.org/education/concept/Atomkrieg>,
        <http://example.org/education/concept/Deutsch-sowjetische_Freundschaft>,
        <http://example.org/education/concept/Geschichte_der_DDR>,
        <http://example.org/education/concept/Jugendbewegung>,
        <http://example.org/education/concept/Kapitalismus>,
        <http://example.org/education/concept/Milit%C3%A4r>,
        <http://example.org/education/concept/Propaganda>,
        <http://example.org/education/concept/Schulsystem>,
        <http://example.org/education/concept/Sozialistische_Einheitspartei_Deutschlands>,
        <http://example.org/education/concept/Strahlenschutz> ;
    dcterms:title "Reflexion 4: Bernd-Lutz Lange: Lesung Zeitsprünge"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:177JtmEUjeyaQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Heck> ;
    dcterms:description "Dieses Arbeitsmaterial unterstützt Schülerinnen bei der Auseinandersetzung mit Kants Ethik und überprüft ihr Verständnis durch neun Fragen, die verschiedenen Anforderungsbereichen (AFB I-III) zugeordnet sind. Durch die Beantwortung der Fragen können die SuS ihre Kenntnisse und Fähigkeiten im Umgang mit Kants Überlegungen feststellen und kritisch reflektieren. Am Ende des Materials werden Evaluationsfragen gestellt, um den eigenen Lernstand und die Bedeutung des Themengebiets einzuschätzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "177JtmEUjeyaQ" ;
    dcterms:subject <http://example.org/education/concept/Bewertung>,
        <http://example.org/education/concept/Ethik>,
        <http://example.org/education/concept/Immanuel_Kant>,
        <http://example.org/education/concept/Lehrplan>,
        <http://example.org/education/concept/Lernziel>,
        <http://example.org/education/concept/P%C3%A4dagogik>,
        <http://example.org/education/concept/Philosophie>,
        <http://example.org/education/concept/Schulbildung>,
        <http://example.org/education/concept/Selbst%C3%BCberpr%C3%BCfung>,
        <http://example.org/education/concept/Unterrichtsmaterial> ;
    dcterms:title "Überblick der Anforderungsbereiche (AFB I-III)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:179-fnHcGwnb8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Heck> ;
    dcterms:description "Das Artefakt 5 behandelt die Verwendung von 2D-3D-Software, um Körpernetze zu untersuchen und darzustellen. Durch interaktive Übungen sollen die Lernenden verschiedene Darstellungsformen eines Körpers kennenlernen und in einen Zusammenhang bringen. Am Ende dieser Aufgabenstellung können die Lernenden Netz-, Schräg- und Tafelbilder zeichnen und ihre Kenntnisse über die 3D-Darstellung von Körpern vertiefen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "179-fnHcGwnb8" ;
    dcterms:subject <http://example.org/education/concept/3D-Modellierung>,
        <http://example.org/education/concept/Bildverarbeitung>,
        <http://example.org/education/concept/Computergest%C3%BCtzte_Darstellung>,
        <http://example.org/education/concept/Computerunterst%C3%BCtztes_Lernen>,
        <http://example.org/education/concept/Darstellungsformen>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Grafiksoftware>,
        <http://example.org/education/concept/Interaktionsdesign>,
        <http://example.org/education/concept/K%C3%B6rpernetze>,
        <http://example.org/education/concept/Wissenschaftliche_Visualisierung> ;
    dcterms:title "Aufgabenstellung zu Artefakt 5: 2D-3D-Software"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:17KeV1sTxgN4 a edu:LearningResource ;
    dcterms:description "Die Klassifizierung von Kegelschnitten wird anhand der Eigenwerte λ1 und λ2 beschrieben. Es werden verschiedene Fälle unterschieden, darunter Normalform, Ellipse, leere Menge, Hyperbel, Punkt und schneidendes Geradenpaar. Durch das Studium dieser Klassifizierung können Lernende die Eigenschaften von Kegelschnitten besser verstehen und sie in verschiedenen Kontexten anwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "17KeV1sTxgN4" ;
    dcterms:subject <http://example.org/education/concept/Algebraische_Geometrie>,
        <http://example.org/education/concept/Eigenwert>,
        <http://example.org/education/concept/Ellipse>,
        <http://example.org/education/concept/Gerade>,
        <http://example.org/education/concept/Hyperbel>,
        <http://example.org/education/concept/Kegelschnitte>,
        <http://example.org/education/concept/Konforme_Abbildung>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematische_Analyse>,
        <http://example.org/education/concept/Parabel> ;
    dcterms:title "Kegelschnitte Klassifikation"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:17Vohjbct0ZMs a edu:LearningResource ;
    dcterms:description "Die Sonne wird als Stern mittlerer Größe vorgestellt, der durch Kernfusion Energie erzeugt und an die Oberfläche abgibt. Die Bildtafeln zeigen die Strahlungsleistung und das Spektrum der Sonne sowie ihre Bahnen für verschiedene Standorte auf dem 51. Breitengrad. Durch das Studium dieser Materialien können Lernende die grundlegenden Prozesse der Sonne und ihre Bedeutung für die Erde verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "17Vohjbct0ZMs" ;
    dcterms:subject <http://example.org/education/concept/Astronomie>,
        <http://example.org/education/concept/Energieerzeugung>,
        <http://example.org/education/concept/Erneuerbare_Energien>,
        <http://example.org/education/concept/Himmelsmechanik>,
        <http://example.org/education/concept/Kernfusion>,
        <http://example.org/education/concept/Schwarzer_Strahler>,
        <http://example.org/education/concept/Sonne>,
        <http://example.org/education/concept/Spektrum>,
        <http://example.org/education/concept/Strahlungsleistung>,
        <http://example.org/education/concept/Wellenl%C3%A4nge> ;
    dcterms:title "EET-NEE Bilder 4"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

