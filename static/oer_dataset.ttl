        <http://example.org/education/concept/Funk%C3%BCbertragung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/MicroBit>,
        <http://example.org/education/concept/Mikrocontroller>,
        <http://example.org/education/concept/Morsecode>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Simulation> ;
    dcterms:title "Handreichung PhC 1. Kurzvorstellung Simulation eines Morsetasters und Decodierung von Morsecodes"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

