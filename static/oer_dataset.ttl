    dcterms:title "Betriebswirtschaftslehre"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:8KC-Kh1Zzs_k a edu:LearningResource ;
    dcterms:description "Der Bewehrungsplan für den Unterzug eines Bauwerks wird detailliert beschrieben, einschließlich der verwendeten Materialien und Abmessungen. Die Planung erfolgte mit dem Programm Allplan 2020 und enthält Informationen über die Betonklasse, Expositionsklasse und Betondeckung. Durch das Studium dieses Plans können Lernende Kenntnisse über die Planung und Ausführung von Stahlbetonkonstruktionen erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8KC-Kh1Zzs_k" ;
    dcterms:subject <http://example.org/education/concept/Architektur>,
