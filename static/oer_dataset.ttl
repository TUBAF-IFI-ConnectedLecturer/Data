        <http://example.org/education/concept/Selbstst%C3%A4ndiges_Lernen>,
        <http://example.org/education/concept/Umweltchemie> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

