oer:17LVFOlY7Yz8w a edu:LearningResource ;
    sim:similarTo oer:17c-TeiZ-rXRI,
        oer:17zQyupNMpmbU ;
    dcterms:creator <http://example.org/education/person/Carter>,
        <http://example.org/education/person/Johnson>,
        <http://example.org/education/person/Lee> ;
    dcterms:description "Die Geschichte der Computerentwicklung wird von den Anfängen mit Herman Hollerith und Charles Babbage bis hin zu den ersten Personal Computern und Spielkonsolen wie Apple Macintosh und Atari Pong nachgezeichnet. Der Text behandelt die wichtigen Meilensteine, Erfindungen und Personen, die zum heutigen Stand der Computer- und Spieleindustrie beigetragen haben. Durch das Lesen dieses Dokuments können Lernende einen umfassenden Überblick über die Entwicklung der Computertechnologie und ihre Auswirkungen auf die Gesellschaft gewinnen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "17LVFOlY7Yz8w" ;
    dcterms:subject <http://example.org/education/concept/Computerentwicklung>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Geschichte_der_Informatik>,
        <http://example.org/education/concept/Grafische_Benutzeroberfl%C3%A4che>,
        <http://example.org/education/concept/Lochkarten>,
        <http://example.org/education/concept/Mikrocomputer>,
        <http://example.org/education/concept/Personal_Computer>,
        <http://example.org/education/concept/Silicon_Valley>,
        <http://example.org/education/concept/Spielkonsole>,
        <http://example.org/education/concept/Transistor> ;
    dcterms:title "Während Ataris Konsolen in Funktion und Leistung extrem beschränkt waren, gebührt ihnen jedoch ein großes Verdienst: Für viele Nicht-Informatiker waren die Videospiele der erste Kontakt mit einem - wenn auch sehr einfachen - Computer."@de ;
    dcterms:type <http://example.org/education/type/Skript> .

