oer:822YQS63dDR0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Oberst> ;
    dcterms:description "Diese Umfrage erforscht das Nutzungsverhalten von Schülern bezüglich ihres Mobiltelefons im Alltag und Unterricht, einschließlich der Häufigkeit bestimmter Aktivitäten und Gründen für die Nutzung oder Nicht-Nutzung des Geräts in bestimmten Situationen. Die Ergebnisse können Aufschluss über die Bedeutung von Mobiltelefonen im Leben von Schülern geben und wie sie diese Geräte nutzen, um ihre Ziele zu erreichen. Durch die Analyse dieser Daten können Lehrende und Erziehende besser verstehen, wie sie Schüler bei der Verwendung von Mobiltelefonen unterstützen und lenken können."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "822YQS63dDR0" ;
    dcterms:subject <http://example.org/education/concept/Ablenkung>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Informationsverhalten>,
        <http://example.org/education/concept/Jugendliche>,
        <http://example.org/education/concept/Kommunikationstechnologie>,
        <http://example.org/education/concept/Lernverhalten>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Mobiltelefonnutzung>,
        <http://example.org/education/concept/Schulordnung>,
        <http://example.org/education/concept/Unterricht> ;
    dcterms:title "(Mobiltelefon-Nutzung im Unterricht)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:822wZoMLQzBA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Grossmann> ;
    dcterms:description "Dieses Dokument enthält den Zeitplan für die mündlichen Prüfungen im Projektmanagement-Kurs WS 2024/25 an der GU 112. Es listet auf, wann und wo welche Gruppen ihre Präsentationen halten und anschließende mündliche Prüfungen ablegen werden. Durch das Studium dieses Dokuments können Lerner den Ablauf und die Organisation der Prüfungen nachvollziehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "822wZoMLQzBA" ;
    dcterms:subject <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Forschung>,
        <http://example.org/education/concept/Hochschule>,
        <http://example.org/education/concept/Lehre>,
        <http://example.org/education/concept/Pr%C3%BCfungen>,
        <http://example.org/education/concept/Projektmanagement>,
