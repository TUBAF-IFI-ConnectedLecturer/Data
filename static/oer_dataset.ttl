        <http://example.org/education/concept/Hochschulpolitik>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Informationswissenschaft>,
        <http://example.org/education/concept/Katalogisierung>,
        <http://example.org/education/concept/Nationalbibliothek>,
        <http://example.org/education/concept/Wissenschaftsgeschichte> ;
    dcterms:title "Eine Reichsbibliothek?"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:11m6ILX4aKywQ a edu:LearningResource ;
