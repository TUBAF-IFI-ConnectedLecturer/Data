oer:12XyMgoq4XppM a edu:LearningResource ;
    sim:similarTo oer:5tb6umR0gOeg ;
    dcterms:creator <http://example.org/education/person/Grimm>,
        <http://example.org/education/person/Schwenk> ;
    dcterms:description "Die jagdliche Terminologie umfasst eine Vielzahl von Begriffen und Ausdrücken, die sich im Laufe der Zeit entwickelt haben und heute noch in der Jagdpraxis verwendet werden. Durch das Verständnis dieser Fachbegriffe können Jäger und Jagdlehrer ihre Kenntnisse über die Jagd und das Wild erweitern und eine präzisere Kommunikation innerhalb der Jagdgemeinschaft ermöglichen. Insbesondere werden die Begriffe Hochwild, Niederwild, Beizjagd und Vogelfang näher erläutert, um eine klare Unterscheidung zwischen den verschiedenen Jagdformen und -methoden zu ermöglichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12XyMgoq4XppM" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_G%C3%B6ttingen> ;
    dcterms:subject <http://example.org/education/concept/Beizjagd>,
        <http://example.org/education/concept/Falknerei>,
        <http://example.org/education/concept/Jagd>,
        <http://example.org/education/concept/Jagdliteratur>,
        <http://example.org/education/concept/Jagdsprache>,
        <http://example.org/education/concept/Jagdwesen>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Tierbezeichnungen>,
        <http://example.org/education/concept/Weidwerk>,
        <http://example.org/education/concept/Wild> ;
    dcterms:title "Die deutsche Jägersprache als Sondersprache"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:12aflSOUs_e7c a edu:LearningResource ;
    sim:similarTo oer:4GJhgyIoHhAo,
        oer:8FRxJmu4KHIA,
        oer:9nsJRSxYyaw4 ;
    dcterms:creator <http://example.org/education/person/Zitzelsberger> ;
    dcterms:description "Das Kapitel behandelt Schutzmaßnahmen bei elektrischen Antrieben, insbesondere den Schutz vor Folgeschäden und gefährlichen Fehlfunktionen. Es werden relevante Normen und Richtlinien wie DIN EN 60204-01 und Produktsicherheitsgesetz vorgestellt, um die funktionale Sicherheit von Maschinen zu gewährleisten. Durch das Studium dieses Kapitels können Lernende Kenntnisse über Schutzkonzepte und -maßnahmen erwerben, um elektrische Antriebe sicher zu betreiben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12aflSOUs_e7c" ;
    dcterms:subject <http://example.org/education/concept/Aktorik>,
        <http://example.org/education/concept/Elektrische_Antriebe>,
        <http://example.org/education/concept/Elektrische_Sicherheit>,
