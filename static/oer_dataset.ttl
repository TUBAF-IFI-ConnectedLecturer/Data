oer:10Zhn9AV0jcRI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/K%C3%B6nig>,
        <http://example.org/education/person/Preu%C3%9F> ;
    dcterms:description "Das Seminar \"Mediale Kolonialgeschichte\" behandelt die Essais von Michel de Montaigne, insbesondere die Kapitel \"Des cannibales\" und \"Des coches\", die eine Kritik am Kolonialismus und eine Idealierung der Kultur der Indianer darstellen. Durch die Analyse dieser Texte sollen die Studierenden ein Verständnis dafür entwickeln, wie Montaigne die europäische Sicht auf die Neue Welt infrage stellt und wie er die Kultur der Indianer als Gegenentwurf zur europäischen Zivilisation präsentiert. Die Lektüre soll außerdem dazu beitragen, dass die Studierenden ihre Fähigkeit entwickeln, Texten zu analysieren und Autoritäten zu hinterfragen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10Zhn9AV0jcRI" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Barbarei>,
        <http://example.org/education/concept/Brasilien>,
        <http://example.org/education/concept/Essais>,
        <http://example.org/education/concept/Indianer>,
        <http://example.org/education/concept/Kannibalismus>,
        <http://example.org/education/concept/Kolonialismus>,
        <http://example.org/education/concept/Kritik_des_Kolonialismus>,
        <http://example.org/education/concept/Kultureller_Relativismus>,
        <http://example.org/education/concept/Menschenbild>,
        <http://example.org/education/concept/Renaissance> ;
    dcterms:title "Wankende Weltbilder im 16. Jh. Les cannibales und Les coches von Michel de Montaigne"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:10Zui0QcI48MY a edu:LearningResource ;
    dcterms:description "Die Arbeit behandelt die Ausdrückbarkeit logischer Operatoren mit Hilfe von Negation und Implikation und zeigt, dass die Mengen {,} und {f,} funktionale Junktorbasen sind. Durch die Kombination dieser beiden Operatoren können alle anderen grundlegenden logischen Operatoren, wie Konjunktion und Disjunktion, ausgedrückt werden. Die Lernenden erfahren, wie sie boolesche Funktionen darstellen und logische Aussagen analysieren können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10Zui0QcI48MY" ;
    dcterms:subject <http://example.org/education/concept/Aussagenlogik>,
        <http://example.org/education/concept/Boolesche_Algebra>,
        <http://example.org/education/concept/Disjunktion>,
        <http://example.org/education/concept/Implikation>,
        <http://example.org/education/concept/Junktorbasis>,
        <http://example.org/education/concept/Konjunktion>,
        <http://example.org/education/concept/Logik>,
        <http://example.org/education/concept/Negation>,
        <http://example.org/education/concept/logische_Operatoren>,
        <http://example.org/education/concept/mathematische_Logik> ;
    dcterms:title "Beweis: Junktorbasen in der Aussagenlogik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

