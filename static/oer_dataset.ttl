        <http://example.org/education/concept/numerische_Mathematik>,
        <http://example.org/education/concept/quadratische_Programmierung> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

