        <http://example.org/education/concept/Geschwindigkeit>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Lichtschranken>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Variablentypen>,
        <http://example.org/education/concept/Zeitmessung> ;
    dcterms:title "Informatik Enlightened Station 3 - Geschwindigkeitsmessung - Bonus"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3kDu9uhH9yyc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Baumg%C3%A4rtner> ;
    dcterms:description "Dieses Tutorial zeigt, wie man einen virtuellen Klassenraum erstellt, indem man Elemente auf eine leere Folie kopiert und anpasst. Durch den Einsatz von Text-Feldern, Fotos, Avataren und anderen Symbolen kann der Raum individualisiert werden. Am Ende kann ein Screenshot des virtuellen Raums erstellt und in Lernplattformen wie Moodle eingebettet werden."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "3kDu9uhH9yyc" ;
    dcterms:subject <http://example.org/education/concept/Avatar>,
