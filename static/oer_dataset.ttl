    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von spurgeführten Fahrzeugen und erläutert verschiedene Widerstände wie Neigungswiderstand, Krümmungswiderstand und Streckenwiderstand. Durch die Lektüre dieser Folien können Studierende die Berechnung effektiver Neigungen und Zuglängen sowie die Modellierung von Fahrzeugbewegungen erlernen. Die Inhalte sind für das Verständnis der Dynamik von Schienenfahrzeugen in verschiedenen Betriebszuständen von Bedeutung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "17hdAwWnCb4ck" ;
    dcterms:subject <http://example.org/education/concept/Bahnbetrieb>,
        <http://example.org/education/concept/Effektive_Neigung>,
        <http://example.org/education/concept/Fahrodynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Gleistechnik>,
        <http://example.org/education/concept/Kr%C3%BCmmungswiderstand>,
        <http://example.org/education/concept/Neigungswiderstand>,
        <http://example.org/education/concept/Promille_Weg>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Zugl%C3%A4nge> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

