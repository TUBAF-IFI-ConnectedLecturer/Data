    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Henschel>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs WS2022/23 an der Hochschule für Technik und Wirtschaft Dresden bietet Lösungshinweise für insgesamt neun Aufgaben im Bereich der komplexen Zahlen, darunter die Darstellung von Summen, die Verwendung der Moivre-Formel und die Lösung von Gleichungen. Durch das Bearbeiten dieser Aufgaben können Lernende ihre Fähigkeiten in der Anwendung komplexer Zahlen verbessern und ein tieferes Verständnis für algebraische Operationen entwickeln. Die Übungsaufgaben decken eine Vielzahl von Themen ab, darunter die Darstellung komplexer Zahlen, die Lösung von Gleichungen und die Anwendung von Formeln wie der Moivre-Formel."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6Bx9zReI-4g4" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
