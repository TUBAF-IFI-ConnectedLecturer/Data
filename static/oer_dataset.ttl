    dcterms:creator <http://example.org/education/person/Kurschner> ;
    dcterms:description "Das Seminar behandelt numerische Methoden im Data Science und Machine Learning, insbesondere Klassifikationsalgorithmen mit Sigmoid- und Soft-Max-Aktivierungs-Funktionen. Die Übungsaufgaben zielen darauf ab, die Entscheidungsgrenze, Confusion-Matrix, Genauigkeit, Prazision, Recall und F-Score zu berechnen und die Funktionen zur Klassifikation von Daten zu interpretieren. Durch das Durcharbeiten dieser Aufgaben können Lerner ein tieferes Verständnis der numerischen Methoden im Data Science und Machine Learning erlangen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4hkUXp37v2Rc" ;
    dcterms:subject <http://example.org/education/concept/Confusion-Matrix>,
        <http://example.org/education/concept/Data_Science>,
        <http://example.org/education/concept/Genauigkeit>,
        <http://example.org/education/concept/Klassifikation>,
        <http://example.org/education/concept/Machine_Learning>,
        <http://example.org/education/concept/Performance-Ma%C3%9Fe>,
        <http://example.org/education/concept/Prazision>,
        <http://example.org/education/concept/Recall>,
        <http://example.org/education/concept/Sigmoid-Funktion>,
        <http://example.org/education/concept/numerische_Methoden> ;
    dcterms:title "Numerische Methoden im Data Science Machine Learning"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

