    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung \"Partikelmesstechnik\" behandelt die metrologischen Grundlagen und Fehlerquellen bei der Messung von Partikeleigenschaften, um eine zuverlässige Charakterisierung von Partikelsystemen zu ermöglichen. Durch das Verständnis von Messunsicherheiten und Fehlerfortpflanzungen können Studierende geeignete Methoden für die Analyse und Bewertung von Partikelgrößen entwickeln. Die Vorlesung bietet eine umfassende Einführung in die statistischen Verteilungsfunktionen, Fehleranalyse und -bewertung, um eine sichere Anwendung von Partikelmesstechniken in der Praxis zu gewährleisten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "35ZhrY3gn5EY" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Fehleranalyse>,
        <http://example.org/education/concept/Messunsicherheit>,
        <http://example.org/education/concept/Metrologie>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fenverteilung>,
        <http://example.org/education/concept/Partikelmesstechnik>,
        <http://example.org/education/concept/Prozessoptimierung>,
        <http://example.org/education/concept/Qualit%C3%A4tskontrolle>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Verteilungsfunktionen> ;
    dcterms:title "Fakultät Maschinenwesen Institut für Verfahrenstechnik und Umwelttechnik, AG Mechanische Verfahrenstechnik Lehrveranstaltung Partikelmesstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

