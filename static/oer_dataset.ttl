oer:7G-Gl2q7zQvQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/M%C3%B6ller>,
        <http://example.org/education/person/Samsel> ;
    dcterms:description "Das Streben nach Perfektion kann zum Scheitern führen, wenn es zu einer übermäßigen Last wird. Dieser Artikel untersucht die negativen Auswirkungen des Perfektionismus auf das Selbstwertgefühl und die Leistung von Musikern. Durch die Lektüre dieses Artikels können Leser lernen, wie sie ihr Streben nach Perfektion in ein gesundes Maß umsetzen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7G-Gl2q7zQvQ" ;
    dcterms:subject <http://example.org/education/concept/Fehlerkultur>,
        <http://example.org/education/concept/Hochleistung>,
        <http://example.org/education/concept/Leistungsbewertung>,
        <http://example.org/education/concept/Leistungsdruck>,
        <http://example.org/education/concept/Musikp%C3%A4dagogik>,
        <http://example.org/education/concept/Musikpsychologie>,
        <http://example.org/education/concept/Musikunterricht>,
        <http://example.org/education/concept/Perfektionismus>,
        <http://example.org/education/concept/Selbstoptimierung>,
        <http://example.org/education/concept/Selbstzweifel> ;
    dcterms:title "Die Last des Perfektionismus. Wie das Streben nach Perfektion zum Scheitern führen kann"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:7GI3fqOCPvT8 a edu:LearningResource ;
    dcterms:description "Die Einführung einer 30-Stunden-Woche führt zu einer Reduzierung der Gesamtkosten um 50,43%. Durch die Verkürzung der Arbeitszeit werden weniger Ressourcen benötigt, was zu Kosteneinsparungen führt. Trotz einer verlängerten Gesamtdurchlaufzeit kann eine 30-Stunden-Woche wahrscheinlich mehr lohnen als eine 40-Stunden-Woche."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7GI3fqOCPvT8" ;
    dcterms:subject <http://example.org/education/concept/Arbeitsleistung>,
        <http://example.org/education/concept/Arbeitswoche>,
        <http://example.org/education/concept/Arbeitszeit>,
