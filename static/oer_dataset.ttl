oer:10DsUkqZcwvms a edu:LearningResource ;
    sim:similarTo oer:125IIc-VU4crE,
        oer:12DyDK0EKYk6w,
        oer:14vaXqiPH2HdA,
        oer:16CbfO-Chevbo,
        oer:4I_z5C7bMSJg,
        oer:4SVtBKkH3C2g,
        oer:5hPDLklptp3Y,
        oer:9-hEmKK_kTZA,
        oer:91u_Sx_XhjMQ,
        oer:9DRm9kPojLSk ;
    dcterms:creator <http://example.org/education/person/Pl%C3%BCschke> ;
    dcterms:description "Die Aufgaben behandeln die graphische Interpretation von Funktionen, insbesondere die Kosinusfunktion, und die Lösung einer Formel nach der relativen Porenfeuchte. Durch das Lösen dieser Aufgaben können Lernende ihre Fähigkeiten im Bereich der Mathematik und Physik verbessern. Sie erwerben Kenntnisse über die Auswirkungen von Konstanten auf Funktionen und lernen, komplexe Formeln zu lösen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10DsUkqZcwvms" ;
    dcterms:subject <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Kosinusfunktion>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Naturwissenschaften>,
        <http://example.org/education/concept/Periodische_Funktionen>,
        <http://example.org/education/concept/Porenfeuchte>,
        <http://example.org/education/concept/Trigonometrie>,
        <http://example.org/education/concept/Wassergehalt>,
        <http://example.org/education/concept/relative_Feuchte> ;
    dcterms:title "Aufgaben zu Funktionen und Graphen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10GOLJuV0sTP4 a edu:LearningResource ;
    sim:similarTo oer:10VF-Od3tWjh0,
        oer:10gxOszvxz3to,
        oer:10tzGhF3GvGpU,
        oer:11uxBUXssPcAA,
        oer:3rjdleBUPFKI,
        oer:43xyKg83RDGs,
        oer:440k9ckn-IBQ,
        oer:48GbkVQq6tl0,
        oer:77m5cQVpJgYY,
        oer:7y2Vvnr6LpnI ;
    dcterms:description "Die Formel φ(pqr)(pqr)(pqr)(pqr) erfüllt die Eigenschaft, dass sie unterschiedliche Werte annimmt, wenn sich nur eine Variable zwischen zwei Belegungen unterscheidet. Dies entspricht einer XOR-Logik mit drei Variablen und kann in verschiedenen Fällen angewendet werden. Durch den Beweis dieser Eigenschaft können Leser die Funktionsweise von φ besser verstehen und ihre Anwendung in der Logik erlernen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10GOLJuV0sTP4" ;
    dcterms:subject <http://example.org/education/concept/Aussagenlogik>,
        <http://example.org/education/concept/Belegung>,
        <http://example.org/education/concept/Beweis>,
        <http://example.org/education/concept/Boolesche_Algebra>,
        <http://example.org/education/concept/Formel>,
        <http://example.org/education/concept/Logik>,
        <http://example.org/education/concept/Mathematische_Logik>,
        <http://example.org/education/concept/Variable>,
        <http://example.org/education/concept/Wahrheitswert>,
        <http://example.org/education/concept/XOR-Verkn%C3%BCpfung> ;
    dcterms:title "Beweis"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10LslmnDXCFg4 a edu:LearningResource ;
    sim:similarTo oer:10Q_vYFYsCzJA,
        oer:10XcXW-htiNK8,
        oer:10m3P_kbmtPaM,
        oer:86LXMnwmscLE,
        oer:8tp6cQ3lyHWg,
        oer:8zKeSPiSTWGE ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Verkehrswirtschaft und bietet einen Überblick über die verschiedenen Aspekte des Verkehrs, einschließlich Linien- und Gelegenheitsverkehren, Wettbewerbsfaktoren von Seehäfen und Preisregulierung. Durch das Studium dieser Materialien können Lernende ein Verständnis der verkehrswirtschaftlichen Konzepte und Theorien entwickeln und ihre Anwendung in verschiedenen Kontexten erkennen. Die Inhalte dienen als Grundlage für weiterführende Studien im Bereich der Verkehrswirtschaft und unterstützen die Entwicklung von Fachkompetenz in diesem Bereich."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10LslmnDXCFg4" ;
    dcterms:subject <http://example.org/education/concept/G%C3%BCtertransport>,
        <http://example.org/education/concept/Gelegenheitsverkehr>,
        <http://example.org/education/concept/Hafeninfrastruktur>,
        <http://example.org/education/concept/Linienverkehr>,
        <http://example.org/education/concept/Logistikdienstleistungen>,
        <http://example.org/education/concept/Preisregulierung>,
        <http://example.org/education/concept/Seeh%C3%A4fen>,
        <http://example.org/education/concept/Transport%C3%B6konomie>,
        <http://example.org/education/concept/Verkehrswirtschaft>,
        <http://example.org/education/concept/Wettbewerb> ;
    dcterms:title "Einführung in die Verkehrswirtschaft"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10Wj83Q6ThCjg a edu:LearningResource ;
    sim:similarTo oer:11317Id_pG4R4,
        oer:12MvDdlkqXgZs,
        oer:3jCsQQlEluOU,
        oer:4-Mne2WQk2bc,
        oer:47j5aoKRFTWg,
        oer:4eOIxJqW-QFA,
        oer:4ia1SI6J0JzU,
        oer:4rYcQcE8FH0A,
        oer:5b7aD1O5bv7I,
        oer:9ysxFnUUqULY ;
    dcterms:creator <http://example.org/education/person/Albrecht> ;
    dcterms:description "In diesem Unterrichtsmaterial zum Thema Werkstoffe werden Schülerinnen und Schüler angeregt, ein technisches Problem zu lösen, indem sie die Eigenschaften von Metallen wie Eisen, Kupfer und Aluminium untersuchen und eine Duftlampe konstruieren. Durch Experimente und Protokollierung erwerben die Lernenden Kenntnisse über Werkstoffeigenschaften wie Wärmeleitfähigkeit, Leitfähigkeit von elektrischem Strom und Magnetismus. Am Ende des Unterrichts können sie begründete Entscheidungen treffen, um ein geeignetes Material für die Schale einer Duftlampe auszuwählen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
