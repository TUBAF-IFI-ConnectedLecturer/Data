oer:8vI9ufMkcy-I a edu:LearningResource ;
    sim:similarTo oer:8yXTcnQPUTmA ;
    dcterms:description "Die Kalkulation für Verlagsmedien behandelt die Preisbildung im Verlag, indem sie die Einflussfaktoren auf den Preis wie Kosten, Abnehmer und Wettbewerb berücksichtigt. Durch das Verständnis dieser Faktoren können Lernende eine kostendeckende und marktorientierte Preispolitik entwickeln, um ihre Produkte erfolgreich zu vermarkten. Die Kalkulation für Verlagsmedien bietet somit einen Überblick über die wichtigsten Aspekte der Preisbildung im Verlag und unterstützt Lernende bei der Entwicklung einer erfolgreichen Geschäftsstrategie."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8vI9ufMkcy-I" ;
    dcterms:publisher <http://example.org/education/organization/HTWK_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Buchproduktion>,
        <http://example.org/education/concept/Kalkulation>,
        <http://example.org/education/concept/Kostenrechnung>,
        <http://example.org/education/concept/Marktanalyse>,
        <http://example.org/education/concept/Medien%C3%B6konomie>,
        <http://example.org/education/concept/Preispolitik>,
        <http://example.org/education/concept/Publikationsmarkt>,
        <http://example.org/education/concept/Verlagsmanagement>,
        <http://example.org/education/concept/Verlagswesen>,
        <http://example.org/education/concept/Wettbewerbsstrategie> ;
    dcterms:title "Kalkulation für Verlagsmedien WS 202425"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:93wiBJPDMn9o a edu:LearningResource ;
    sim:similarTo oer:9_sFBGwrgG-E,
        oer:9szechZOlZ1Q,
        oer:9u_N309FmeJQ ;
    dcterms:creator <http://example.org/education/person/Debus>,
        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übungsaufgaben aus der Numerischen Mathematik behandeln verschiedene Themen wie Kombinatorik, Ereignisalgebra und Wahrscheinlichkeitstheorie. Durch die Lösung dieser Aufgaben können Lerner ihre Fähigkeiten im Bereich der mathematischen Modellierung und Analyse von Zufallsexperimenten verbessern. Insbesondere werden Konzepte wie die Berechnung von Wahrscheinlichkeiten, die Anwendung von Kombinatorikformeln und die Beschreibung von Ereignissen in verschiedenen Kontexten vermittelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "93wiBJPDMn9o" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Ereignisalgebra>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Kombinatorik>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Lotto>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Morse-Alphabet>,
        <http://example.org/education/concept/Numerische_Mathematik>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie>,
        <http://example.org/education/concept/Zufallsexperimente> ;
    dcterms:title "Mathematik IV (für IF, ET, Ph) Sommersemester 2025"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

