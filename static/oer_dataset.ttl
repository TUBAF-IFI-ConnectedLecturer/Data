oer:5lq2FKWANqIQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/thun> ;
    dcterms:description "Die agile Projektmethode bietet Vorteile wie effizientes und zielorientiertes Arbeiten, Förderung sozialer und methodischer Fähigkeiten sowie Motivation durch schnelle Erfolge. Der Lehrer übernimmt die Rolle des Scrum Masters und Product Owners, um das Projekt zum Erfolg zu bringen. Durch die Anwendung dieser Methode können Schüler Kompetenzen wie Fach-, Sozial- und Kommunikationskompetenz erwerben und ein erfolgreiches Projekt umsetzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5lq2FKWANqIQ" ;
    dcterms:subject <http://example.org/education/concept/Agile_Methoden>,
        <http://example.org/education/concept/Fachkompetenz>,
        <http://example.org/education/concept/Kompetenzentwicklung>,
