        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übung behandelt Differentialoperatoren und ihre Anwendungen auf Vektorfelder, insbesondere die Berechnung von Divergenz und Rotation. Durch die Lösung der Aufgaben können Lerner die grundlegenden Konzepte der partiellen Differentialgleichungen verstehen und anwenden. Die Übung umfasst sieben Aufgaben, die von der Berechnung einfacher Differentialoperatoren bis hin zur Untersuchung komplexer Vektorfelder reichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3oYprFuKQ6xg" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Differentialoperatoren>,
        <http://example.org/education/concept/Divergenz>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Gradientenfelder>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Numerik>,
        <http://example.org/education/concept/Partielle_Differentialgleichungen>,
        <http://example.org/education/concept/Potentialtheorie>,
        <http://example.org/education/concept/Rotationsfelder>,
        <http://example.org/education/concept/Vektoranalysis> ;
    dcterms:title "Mathematik IV (für IF, ET, Ph) Sommersemester 2025"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

