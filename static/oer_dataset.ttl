    dcterms:creator <http://example.org/education/person/M%C3%BCller> ;
    dcterms:description "Die mündliche Abiturprüfung im Fach Informatik behandelt das Thema Klassen und Objekte, bei dem SchülerInnen die Begriffe Klasse, Objekt, Attribut, Methode und ihre Beziehungen zueinander kennenlernen. Durch die Bearbeitung der Aufgaben erwerben sie Fähigkeiten wie die Darstellung von Klassen und Objekten in UML-Diagrammen, das Ordnen von Attributen und Methoden sowie die Anwendung dieser Konzepte auf selbst gewählte Beispiele. Am Ende können SchülerInnen die Begriffe ordnen, UML-Diagramme erstellen und Problemlösungen entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11P_f4Eo8b9K0" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Abiturpr%C3%BCfung>,
        <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Klassen_und_Objekte>,
        <http://example.org/education/concept/Lehrplan>,
        <http://example.org/education/concept/Objektorientierte_Programmierung>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Sachsen>,
        <http://example.org/education/concept/UML> ;
    dcterms:title "Mündliche Abiturprüfung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

