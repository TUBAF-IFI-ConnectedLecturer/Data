oer:9pndqJU_DlNw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schuster> ;
    dcterms:description "Das Institut für Qualität und Wirtschaftlichkeit im Gesundheitswesen (IQWiG) ist ein unabhängiger wissenschaftlicher Akteur, der evidenzbasierte Gutachten zu medizinischen Leistungen erstellt, um die Qualität und Wirtschaftlichkeit des Gesundheitswesens zu verbessern. Durch die Arbeit des IQWiG werden Nutzen und Schaden medizinischer Maßnahmen für Patienten und Patientinnen verdeutlicht, damit informierte Entscheidungen getroffen werden können. Die Gutachten des IQWiG haben einen hohen praktischen Nutzen und tragen zur evidenzbasierten Medizin bei, was sie zu einem wichtigen Akteur in Bezug auf Qualität und Wirtschaftlichkeit macht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9pndqJU_DlNw" ;
    dcterms:subject <http://example.org/education/concept/Evidenzbasierte_Medizin>,
        <http://example.org/education/concept/Gesundheits%C3%B6konomie>,
        <http://example.org/education/concept/Gesundheitspolitik>,
        <http://example.org/education/concept/Gesundheitswesen>,
        <http://example.org/education/concept/Krankenversicherung>,
        <http://example.org/education/concept/Medizinische_Leistungen>,
        <http://example.org/education/concept/Medizinische_Versorgung>,
        <http://example.org/education/concept/Patientenzentrierte_Versorgung>,
        <http://example.org/education/concept/Qualit%C3%A4tsmanagement>,
        <http://example.org/education/concept/Wissenschaftliche_Bewertung> ;
    dcterms:title "Das Institut für Qualität und Wirtschaftlichkeit im Gesundheitswesen (IQWiG)"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:9tEDZ6frJBbM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Faber>,
        <http://example.org/education/person/K%C3%BCmpel>,
        <http://example.org/education/person/Kobel> ;
    dcterms:description "Das Protokoll dokumentiert die Diskussionen und Abstimmungen des Lehrstrategie Boards der TU Dresden zu verschiedenen Handlungsfeldern wie gesellschaftlich verantwortungsvolle Lehre, Nachhaltigkeit in der Lehre und Zusammenarbeit mit außeruniversitären Partnern. Die Teilnehmer diskutieren Lösungsvorschläge und offen Fragen zu Themen wie der Integration ethischer Grundsätze in die Lehre, der curricularen Einbindung von Fragestellungen aus der Praxis und der Entwicklung von Lehr-Lernformaten mit gesellschaftlichem Bezug. Durch die Lektüre dieses Protokolls können Lehrende und Studierende Anregungen für die Gestaltung ihrer eigenen Lehr- und Lernprozesse erhalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9tEDZ6frJBbM" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bildungsinnovation>,
        <http://example.org/education/concept/Curriculare_Einbindung>,
        <http://example.org/education/concept/Ethik_in_der_Wissenschaft>,
        <http://example.org/education/concept/Gesellschaftlich_verantwortungsvolle_Lehre>,
        <http://example.org/education/concept/Hochschuldidaktik>,
        <http://example.org/education/concept/Interdisziplinarit%C3%A4t>,
        <http://example.org/education/concept/Lehrstrategie>,
        <http://example.org/education/concept/Nachhaltigkeit_in_der_Lehre>,
        <http://example.org/education/concept/Studiengangsentwicklung>,
        <http://example.org/education/concept/Universit%C3%A4tslehre> ;
    dcterms:title "Protokoll - Einführung"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:9uBCLdWfR1h0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/John> ;
    dcterms:description "Die Organisierte Kriminalität umfasst verschiedene Formen krimineller Strukturen, wie Rockergruppierungen, italienische und russisch-eurasische Organisationen, die sich durch Korruption, Erpressung und Gewalt auszeichnen. Durch die Analyse von Beispielfällen und Statistiken können Leser ein Verständnis dafür entwickeln, wie diese kriminellen Strukturen funktionieren und wie sie bekämpft werden können. Zudem werden Grundlagen für das Entstehen von Organisierter Kriminalität, wie Zugang zu Ressourcen und sozialer Status, erläutert."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "9uBCLdWfR1h0" ;
    dcterms:subject <http://example.org/education/concept/Drogenhandel>,
        <http://example.org/education/concept/Finanzkontrolle>,
        <http://example.org/education/concept/Geldw%C3%A4sche>,
        <http://example.org/education/concept/Korruption>,
        <http://example.org/education/concept/Kriminalit%C3%A4tsbek%C3%A4mpfung>,
        <http://example.org/education/concept/Organisierte_Kriminalit%C3%A4t>,
        <http://example.org/education/concept/Rechtsstaatlichkeit>,
        <http://example.org/education/concept/Strafverfolgung>,
        <http://example.org/education/concept/Terrorismus>,
        <http://example.org/education/concept/Wirtschaftskriminalit%C3%A4t> ;
    dcterms:title "Organisierte Kriminalität und Korruption"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

