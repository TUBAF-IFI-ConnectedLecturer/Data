    dcterms:title "Tägliche Übung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:802rGFkUWiOM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/H%C3%A4nicke> ;
    dcterms:description "Die Studienarbeiten behandeln die Themen Farbe und Bewegung im Kontext von Smart Materials und Wissensarchitektur an der TU Dresden. Durch die Analyse von Farb- und Bewegungsstudien können Lernende Einblick in die Gestaltung und Funktionsweise intelligenter Materialien gewinnen. Die Arbeiten bieten eine visuelle und experimentelle Annäherung an das Thema, um ein tieferes Verständnis der Zusammenhänge zwischen Design, Materialwissenschaft und Architektur zu erlangen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "802rGFkUWiOM" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
