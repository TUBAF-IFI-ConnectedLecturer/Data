    dcterms:creator <http://example.org/education/person/Krahl> ;
    dcterms:description "Die Hashfunktionen werden als kryptographische Verfahren eingesetzt, um Daten zu verschlüsseln und Adressen zu berechnen. Durch die Anwendung von linearem und quadratischem Sondieren können Kollisionen auftreten, die durch externe Kollisionsauflösungen gelöst werden müssen. Die Hashlisten dienen als Datenstrukturen, um Daten anhand einer Hashfunktion zu speichern und zu verschlüsseln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1Tc-LuexbpL0" ;
    dcterms:subject <http://example.org/education/concept/Adressierung>,
        <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Hashfunktionen>,
        <http://example.org/education/concept/Informationsverschl%C3%BCsselung>,
        <http://example.org/education/concept/Kollisionen>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Passw%C3%B6rter>,
        <http://example.org/education/concept/Salze> ;
    dcterms:title "Hashlisten Kryptographische Hashfunktionen Fazit"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

