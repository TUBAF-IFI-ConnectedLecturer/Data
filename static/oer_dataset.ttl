        <http://example.org/education/concept/Pflanzenauswahl>,
        <http://example.org/education/concept/Standortgerechtigkeit>,
        <http://example.org/education/concept/Temperaturfaktor>,
        <http://example.org/education/concept/Vegetationszone> ;
    dcterms:title "Pflanzenökologie und Standortgerechte Pflanzenwahl"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:3-5GC8zLdWQg a edu:LearningResource ;
    sim:similarTo oer:33mK9X0coRfc,
