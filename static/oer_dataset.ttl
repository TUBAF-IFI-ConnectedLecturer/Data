        <http://example.org/education/concept/Parameter>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Softwareentwicklung> ;
    dcterms:title "Besonderheiten Inline-Funktionen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:4QV3zUKoIYt0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Anderson>,
        <http://example.org/education/person/Lindenberger>,
        <http://example.org/education/person/Maloney> ;
    dcterms:description "Die Aufmerksamkeit spielt eine zentrale Rolle bei der Verarbeitung von Informationen und ermöglicht es uns, bestimmte Reize auszuwählen und anderen zu ignorieren. Durch die Lektüre dieses Dokuments können Lernende die verschiedenen Theorien der selektiven Aufmerksamkeit, wie die Filtertheorie und die Dämpfungstheorie, sowie die neuronalen Mechanismen, die bei der Aufmerksamkeit auf ein Objekt involviert sind, verstehen. Darüber hinaus erfahren sie, wie die visuelle Aufmerksamkeit funktioniert und wie Menschen Objekte mit bestimmten Merkmalen finden können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4QV3zUKoIYt0" ;
    dcterms:publisher <http://example.org/education/organization/RWTH_Aachen> ;
    dcterms:subject <http://example.org/education/concept/Aufmerksamkeit>,
        <http://example.org/education/concept/Bindungsproblem>,
        <http://example.org/education/concept/Gehirnfunktion>,
        <http://example.org/education/concept/Informationsverarbeitung>,
        <http://example.org/education/concept/Kognitive_Psychologie>,
        <http://example.org/education/concept/Merkmalsintegration>,
        <http://example.org/education/concept/Neuronale_Mechanismen>,
        <http://example.org/education/concept/Selektive_Aufmerksamkeit>,
        <http://example.org/education/concept/Visuelle_Wahrnehmung>,
        <http://example.org/education/concept/Wahrnehmungspsychologie> ;
    dcterms:title "Aufmerksamkeit und Wahrnehmung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:4Xxyi9Hz1i2w a edu:LearningResource ;
    sim:similarTo oer:4eOIxJqW-QFA,
        oer:4iU7PFQ1hIY0,
        oer:4oMRgvgozwC8,
        oer:4rYcQcE8FH0A ;
    dcterms:creator <http://example.org/education/person/Mathiszik> ;
    dcterms:description "Dieses Workshop-Material behandelt quantitative Aspekte der Fachdidaktik im Chemieunterricht und unterstützt die Analyse von Lehrplänen hinsichtlich technischer Bildungsinhalte. Durch die Bearbeitung von Aufgabenstellungen und Diskussionspunkten können Lernende Verbindungen zwischen qualitativen und quantitativen Betrachtungsebenen herstellen und ihre Fähigkeiten in der mathematischen Modellierung von Sachverhalten im Chemieunterricht verbessern. Die Materialien umfassen Beispiele aus dem Bereich der chemischen Reaktionen, Stoffumsatzberechnungen und Energieerhaltungssätze."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4Xxyi9Hz1i2w" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Berufliche_Bildung>,
        <http://example.org/education/concept/Chemieunterricht>,
