oer:7JMK9jY3VOoM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Lernpaket behandelt das Vergrößerungsgesetz und seine Anwendung auf verschiedene Verteilungsfunktionen, wie die Normalverteilung und die Doppelexponentialverteilung. Es erklärt den Unterschied zwischen dem Vergrößerungsgesetz für gleichartige Ereignisse und der allgemeinen Form des Gesetzes sowie die Definition des Vergrößerungsfaktors n. Durch das Lernpaket können Studierende die Anwendung des Vergrößerungsgesetzes auf verschiedene statistische Verteilungen verstehen und die Auswirkungen auf die Durchschlagwahrscheinlichkeit erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7JMK9jY3VOoM" ;
    dcterms:subject <http://example.org/education/concept/Elektromagnetische_Vertr%C3%A4glichkeit>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Exponentialverteilung>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Isolationskoordination>,
        <http://example.org/education/concept/Normalverteilung>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Vergr%C3%B6%C3%9Ferungsgesetz>,
        <http://example.org/education/concept/Verteilungsfunktionen>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie> ;
    dcterms:title "SI Lernpaket 8 Das Vergrößerungsgesetz"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

