oer:4qvzmSygONoY a edu:LearningResource ;
    dcterms:description "Dieses Dokument beschreibt einen Wartungsplan für eine Verpackungsanlage und enthält eine Übersicht über die verschiedenen Wartungselemente, Bauteile und Tätigkeiten, die regelmäßig durchgeführt werden müssen. Der Plan umfasst Prüfungen, Reinigungen, Schmierarbeiten und den Austausch von Verschleißteilen, um die Sicherheit und Funktionsfähigkeit der Anlage zu gewährleisten. Durch die Anwendung dieses Wartungsplans können Betreiber eine zuverlässige und sichere Funktion ihrer Verpackungsanlage sicherstellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4qvzmSygONoY" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Arbeitssicherheit>,
        <http://example.org/education/concept/Drucklufttechnik>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/F%C3%B6rdertechnik>,
        <http://example.org/education/concept/Industrielle_Sicherheit>,
        <http://example.org/education/concept/Maschinenwartung>,
        <http://example.org/education/concept/Schutzleitersystem>,
        <http://example.org/education/concept/Verpackungstechnik>,
        <http://example.org/education/concept/Wartungsplan> ;
    dcterms:title "Verpackungsanlage Wartungsplan"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:4r1_c8OvFsU0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Denzel>,
        <http://example.org/education/person/Reiprich> ;
    dcterms:description "Die Analyse der Telegram-Applikation im Rahmen des Moduls Human Computer Interaction bietet Einblicke in die Struktur und Funktionalitäten der Applikation. Durch die Untersuchung leicht auffindbarer Funktionen können Nutzer:innen die Applikation besser verstehen und ihre Einstellungen anpassen. Die Tabelle CASSM-1 stellt eine Übersicht über die gefundenen Funktionen und Einstellungen bereit, um die Interaktion zwischen Nutzer:innen und System zu verdeutlichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4r1_c8OvFsU0" ;
    dcterms:subject <http://example.org/education/concept/Benutzererfahrung>,
        <http://example.org/education/concept/Benutzeroberfl%C3%A4che>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Informationsarchitektur>,
        <http://example.org/education/concept/Interaktionsdesign>,
        <http://example.org/education/concept/Kommunikationsdienste>,
        <http://example.org/education/concept/Mensch-Computer-Interaktion>,
        <http://example.org/education/concept/Messaging-Dienste>,
        <http://example.org/education/concept/Mobile_Applikationen>,
        <http://example.org/education/concept/Sicherheitseinstellungen> ;
    dcterms:title "Human Computer Interaction Vorleistung von Alexander Reiprich und Anna Denzel"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:4sjJ3JX4kr-o a edu:LearningResource ;
    dcterms:description "Karrierenetzwerke wie XING und LinkedIn bieten Möglichkeiten, das eigene Netzwerk aufzubauen, Fach- und Branchenwissen zu erweitern und passende Job-Vorschläge zu erhalten. Durch die effektive Nutzung dieser Plattformen kann man seine persönliche Digitalkompetenz unter Beweis stellen und sich als attraktiver Kandidat für Arbeitgeber präsentieren. Die Vorteile von Karrierenetzwerken liegen in der Profilerstellung, -pflege und dem Zugang zu relevanten Job-Angeboten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4sjJ3JX4kr-o" ;
    dcterms:subject <http://example.org/education/concept/Berufliche_Entwicklung>,
        <http://example.org/education/concept/Digitale_Kompetenz>,
        <http://example.org/education/concept/Jobb%C3%B6rsen>,
        <http://example.org/education/concept/Karriereentwicklung>,
        <http://example.org/education/concept/Karriereplanung>,
        <http://example.org/education/concept/Netzwerken>,
        <http://example.org/education/concept/Online-Karriereportale>,
        <http://example.org/education/concept/Online-Netzwerke>,
        <http://example.org/education/concept/Personalbranding>,
        <http://example.org/education/concept/Soziale_Medien> ;
    dcterms:title "Karrierenetzwerke effektiv nutzen"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

