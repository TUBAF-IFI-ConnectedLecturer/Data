oer:8394JVb2Sy_E a edu:LearningResource ;
    sim:similarTo oer:8c-80cDbnMX8 ;
    dcterms:creator <http://example.org/education/person/Hohenwarter>,
        <http://example.org/education/person/Karanikolas>,
        <http://example.org/education/person/Konrad> ;
    dcterms:description "Das Werkzeug Graphbench wird vorgestellt, um NP-vollständige Probleme der Komplexitätstheorie zu visualisieren und Lösungsalgorithmen zu simulieren. Durch den Einsatz von Graphbench können Lernende die Efﬁzienz von Algorithmen beurteilen, die Berechenbarkeit von Problemen untersuchen und die Klassen P und NP verstehen. Am Ende dieser Stoffeinheit sollen Schülerinnen und Schüler in der Lage sein, die Komplexitätsklassen zu bestimmen, den Aufwand von Algorithmen zu berechnen und die Efﬁzienz von Lösungen zu beurteilen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8394JVb2Sy_E" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_a_Hint_About_The_Author%27s_Institution%3Aeidgen%C3%B6ssische_Technische_Hochschule_%28eth%29this_Is_a_Swiss_University__Specifically_The_Eth_Zurich.> ;
    dcterms:subject <http://example.org/education/concept/Algorithmus>,
        <http://example.org/education/concept/Automatentheorie>,
        <http://example.org/education/concept/Compiler>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Hamiltonkreis>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Komplexit%C3%A4tstheorie>,
        <http://example.org/education/concept/NP-Vollst%C3%A4ndigkeit>,
        <http://example.org/education/concept/Programmierumgebung>,
        <http://example.org/education/concept/Traveling_Salesman_Problem> ;
    dcterms:title "Einsatz von GraphBench in der Sekundarstufe II"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:9B75gAUmeMS0 a edu:LearningResource ;
    sim:similarTo oer:9DRm9kPojLSk,
        oer:9F5_6vfAUMtg,
