    dcterms:creator <http://example.org/education/person/Heidrich> ;
    dcterms:description "Das Material ermöglicht es Lernenden, eine Funktionsgleichung linearer Funktionen anhand einer bildlichen Darstellung des Graphen abzulesen und zu verstehen, wie man die Variable n anhand des Graphen bestimmen kann. Durch den Screencast erwerben sie Kompetenzen wie das Erstellen einer eigenen Mitschrift, Probleme mathematisch lösen und selbstständiges Regulieren des Arbeitstempos. Am Ende können Lernende drei Funktionen vorliegen haben, um die Gleichung selbst abzulesen und zu erarbeiten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3BE2e5QmTxYU" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Funktionsgleichungen>,
        <http://example.org/education/concept/Graphen>,
        <http://example.org/education/concept/Lehrmaterialien>,
        <http://example.org/education/concept/Mathematikdidaktik>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Screencasts>,
        <http://example.org/education/concept/Selbststudium>,
        <http://example.org/education/concept/lineare_Funktionen> ;
    dcterms:title "Digitale Medien in der Schule Universität Leipzig"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

