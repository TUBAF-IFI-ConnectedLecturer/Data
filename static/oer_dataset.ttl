oer:4PL4RJu5ivag a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Doering> ;
    dcterms:description "Die Transformation zu einer stärker pflanzlichen Ernährung ist eine große Herausforderung, um den Fleischkonsum zu reduzieren und die Umweltbilanz zu verbessern. Durch die Förderung von Fleischalternativen und die Schaffung geeigneter Rahmenbedingungen kann die breite Masse vom Fleisch der Zukunft überzeugt werden. Die Verbrauchenden können durch die Berücksichtigung von Preis und Geschmack bei Kaufentscheidungen einen wichtigen Beitrag zur Reduktion des ökologischen Fußabdrucks leisten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4PL4RJu5ivag" ;
    dcterms:subject <http://example.org/education/concept/Abfallentsorgung>,
        <http://example.org/education/concept/Fleischkonsum>,
        <http://example.org/education/concept/Klimagerechtigkeit>,
        <http://example.org/education/concept/Kreislaufwirtschaft>,
        <http://example.org/education/concept/Lebensmittelproduktion>,
        <http://example.org/education/concept/Nachhaltige_Ern%C3%A4hrung>,
        <http://example.org/education/concept/Pflanzenbasierte_Ern%C3%A4hrung>,
        <http://example.org/education/concept/Recycling>,
        <http://example.org/education/concept/Stadt%C3%B6kologie>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Das Fleisch der Zukunft"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

