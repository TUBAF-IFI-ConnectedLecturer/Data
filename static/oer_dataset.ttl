    dcterms:title "Mündliche Prüfung Informatik - Datenbanken - SQL"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:12pHudk4KYim8 a edu:LearningResource ;
    sim:similarTo oer:12tQiefgBOTOM,
