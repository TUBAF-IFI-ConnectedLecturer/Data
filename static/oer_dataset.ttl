    dcterms:title "Kein Titel gefunden."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3iHSCL63l5dI a edu:LearningResource ;
    sim:similarTo oer:52Li3YcIz_0s ;
    dcterms:creator <http://example.org/education/person/Reithmeier> ;
    dcterms:description "Die Routingtabelle ist ein wichtiger Bestandteil von Netzwerken, die es ermöglicht, Pakete zwischen verschiedenen Netzwerken zu leiten und die richtigen Wege zum Ziel zu finden. Durch die Verwendung von IP-Adressen, Gateways und Schnittstellen können Router entscheiden, wohin sie ein Paket senden müssen, um es zum Ziel zu bringen. Die Kenntnis der Routingtabelle ist für das Verständnis des Netzwerkverkehrs und die Konfiguration von Routern essentiell."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3iHSCL63l5dI" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Computernetzwerkarchitektur>,
        <http://example.org/education/concept/Datenkommunikation>,
        <http://example.org/education/concept/Gateway>,
        <http://example.org/education/concept/IP-Adressen>,
        <http://example.org/education/concept/Netzwerke>,
        <http://example.org/education/concept/Netzwerkschnittstellen>,
        <http://example.org/education/concept/Paketvermittlung>,
        <http://example.org/education/concept/Rechnernetze>,
        <http://example.org/education/concept/Router>,
        <http://example.org/education/concept/Routingtabelle> ;
    dcterms:title "Aufbau der Routingtabelle"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:3uEO-mE4x29I a edu:LearningResource ;
    sim:similarTo oer:8G9AM1jMCAYg ;
    dcterms:creator <http://example.org/education/person/Menzel> ;
    dcterms:description "Die Geomodellierung umfasst mathematische Methoden zur Beschreibung und Analyse von geologischen Objekten und Prozessen, wobei verschiedene Konzepte wie Zustandsmodellierung, Prozessmodellierung, Strukturmodellierung und Parametermodellierung kombiniert werden. Durch die Anwendung dieser Konzepte können komplexe geometrische Sachverhalte in der Geologie besser verstanden und visualisiert werden. Die Lernenden erwerben ein Verständnis für die verschiedenen Ansätze der Geomodellierung und ihre Anwendung in der geologischen Praxis."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3uEO-mE4x29I" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Modellierung>,
        <http://example.org/education/concept/Erdwissenschaften>,
        <http://example.org/education/concept/Geologie>,
        <http://example.org/education/concept/Geomodellierung>,
        <http://example.org/education/concept/Mathematische_Modellierung>,
        <http://example.org/education/concept/Parametermodellierung>,
        <http://example.org/education/concept/Physikalische_Modellierung>,
        <http://example.org/education/concept/Prozessmodellierung>,
        <http://example.org/education/concept/Strukturmodellierung>,
        <http://example.org/education/concept/Zustandsmodellierung> ;
    dcterms:title "3D Geomodellierung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:4De2KvQ91QM4 a edu:LearningResource ;
    sim:similarTo oer:4kUZg8MPJjt4 ;
    dcterms:creator <http://example.org/education/person/R%C3%B6tger> ;
    dcterms:description "Dieser Podcast behandelt das Thema Prokrastination und bietet Strategien zur Selbstmotivation und Zeitplanung, um Aufgaben effektiver zu erledigen. Durch die Anwendung dieser Techniken können Lernende ihre Produktivität steigern, Stress reduzieren und ihre Ziele erreichen. Insbesondere werden Gründe für das Prokrastinieren, wie Angst vor dem Scheitern oder falsche Prioritäten, analysiert und Lösungen wie räumliche Trennung von Arbeits- und Entspannungsraum oder die Einholung von Feedback von außen vorgestellt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4De2KvQ91QM4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Abschlussarbeit>,
        <http://example.org/education/concept/Hausarbeit>,
        <http://example.org/education/concept/Karriereplanung>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Prokrastination>,
        <http://example.org/education/concept/Schreiben>,
        <http://example.org/education/concept/Selbstmotivation>,
        <http://example.org/education/concept/Studienorganisation>,
        <http://example.org/education/concept/Universit%C3%A4t>,
        <http://example.org/education/concept/Zeitmanagement> ;
    dcterms:title "Career Nacht des Schreibens"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

