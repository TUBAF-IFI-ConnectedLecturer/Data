oer:107Xy9GRKfpJs a edu:LearningResource ;
    sim:similarTo oer:10Z34LWBdmbOk,
        oer:10fyKuGENQ8fc,
        oer:10oQSo2mexrDk,
        oer:8Oj9WlFLC8LU ;
    dcterms:creator <http://example.org/education/person/Hirte> ;
    dcterms:description "Die neoklassische Theorie des Handels beschreibt die Vorteile des internationalen Handels für Länder mit komparativen Kostenvorteilen und wie Zölle und andere Handelshemmnisse die Wohlfahrt beeinträchtigen können. Durch den Abbau von Handelsschranken kann die Wohlfahrt erhöht werden, aber es gibt auch Gewinner und Verlierer in einem Land. Die Theorie der Integration beschreibt, wie Länder durch den Abbau von Handelshemmnissen ihre Wirtschaftsleistung verbessern können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "107Xy9GRKfpJs" ;
    dcterms:subject <http://example.org/education/concept/Au%C3%9Fenhandel>,
        <http://example.org/education/concept/Au%C3%9Fenwirtschaftstheorie>,
        <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Europ%C3%A4ische_Integration>,
        <http://example.org/education/concept/Freihandel>,
        <http://example.org/education/concept/Handelspolitik>,
        <http://example.org/education/concept/Internationale_Wirtschaft>,
        <http://example.org/education/concept/Protektionismus>,
        <http://example.org/education/concept/Wirtschaftsintegration>,
        <http://example.org/education/concept/Z%C3%B6lle> ;
    dcterms:title "1 Grundlagen 1.1 Neoklassische Handelstheorien"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10L8PyvdZ79II a edu:LearningResource ;
    sim:similarTo oer:10Mw9yrv41paU,
        oer:10_Xsa_7O9hqk,
        oer:5--oS03LGhC4,
        oer:52N97oabbYMM ;
    dcterms:creator <http://example.org/education/person/Hammerm%C3%BCller> ;
    dcterms:description "Das Schreibzentrum der TU Dresden bietet eine Projektphase szdtud von 2021-2023 an, die sich auf das wissenschaftliche Schreiben und Lesen konzentriert. Durch die Teilnahme können Studierende ihre Kompetenzentwicklung in einer bestimmten Zeitspanne dokumentieren und veranschaulichen, indem sie ein E-Portfolio erstellen. Das Projekt umfasst Schreibberatungen, Korrekturhilfe, Co-Teaching für Lehrveranstaltungen und Workshops für Studierende, um ihre Fähigkeiten im wissenschaftlichen Schreiben zu verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10L8PyvdZ79II" ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Digitale_Sammlung>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Kompetenzentwicklung>,
        <http://example.org/education/concept/Lehre>,
        <http://example.org/education/concept/Medienp%C3%A4dagogik>,
        <http://example.org/education/concept/Portfolio>,
        <http://example.org/education/concept/Projektmanagement>,
        <http://example.org/education/concept/Schreibdidaktik>,
        <http://example.org/education/concept/Wissenschaftliches_Schreiben> ;
    dcterms:title "Projektphase szdtud 2021-2023"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

