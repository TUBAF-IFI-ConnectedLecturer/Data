        <http://example.org/education/concept/Turbulenz>,
        <http://example.org/education/concept/Viskosit%C3%A4t>,
        <http://example.org/education/concept/Wandgesetz> ;
    dcterms:title "Übungsaufgaben Strömungsprobleme der MVT TU Dresden, Institut für Verfahrenstechnik und Umwelttechnik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

