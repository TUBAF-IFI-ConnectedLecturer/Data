oer:17zQyupNMpmbU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Carter>,
        <http://example.org/education/person/Johnson>,
        <http://example.org/education/person/Lee> ;
    dcterms:description "Die Geschichte der Computerentwicklung wird von den ersten Rechenmaschinen bis hin zu modernen Mikrocomputern und Spielkonsolen nachgezeichnet, wobei wichtige Erfindungen und Entwicklungen wie der Transistor, die Lochkarte und das erste Computerspiel vorgestellt werden. Durch diese Lektüre können Leser ein Verständnis dafür entwickeln, wie Computer von einfachen Rechenmaschinen zu leistungsfähigen Geräten wurden, die unseren Alltag prägen. Zudem wird gezeigt, wie Unternehmen und Erfinder wie Nolan Bushnell und Herman Hollerith die Entwicklung der Computerbranche beeinflusst haben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "17zQyupNMpmbU" ;
    dcterms:subject <http://example.org/education/concept/Bibliothekswesen>,
        <http://example.org/education/concept/Computerentwicklung>,
        <http://example.org/education/concept/Computerhardware>,
        <http://example.org/education/concept/Geschichte_der_Informatik>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Informationstechnologie>,
        <http://example.org/education/concept/Katalogisierung>,
        <http://example.org/education/concept/Mikroprozessoren>,
        <http://example.org/education/concept/Transistoren>,
        <http://example.org/education/concept/akademische_Ver%C3%B6ffentlichungen> ;
    dcterms:title "Die Geschichte des Computers"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

