    dcterms:creator <http://example.org/education/person/Klose> ;
    dcterms:description "Das Lied behandelt das Thema der elektromagnetischen Induktion und vermittelt den Lernenden das Induktionsgesetz in seiner Wortform. Durch die Verbindung zur Musik können auch weniger interessierte Lernende von der Physik begeistert werden und ihre Fachkompetenz, Methodenkompetenz und Selbstkompetenz stärken. Das Material eignet sich für den Physikunterricht der 9. Klasse in Sachsen und kann bei der Einführung des Gesetzes, zur Wiederholung des Lernbereichs sowie in höheren Klassenstufen zur Aktivierung eingesetzt werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10O5bAqeifiSw" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Audiomedien>,
        <http://example.org/education/concept/Elektromagnetische_Induktion>,
        <http://example.org/education/concept/Energieversorgung>,
        <http://example.org/education/concept/Lehrplan>,
        <http://example.org/education/concept/Lernmaterial>,
        <http://example.org/education/concept/Musik>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Physikunterricht>,
        <http://example.org/education/concept/Sekundarstufe>,
        <http://example.org/education/concept/Unterricht> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenpool> .

