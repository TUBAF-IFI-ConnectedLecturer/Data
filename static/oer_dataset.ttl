        <http://example.org/education/concept/Literatur>,
        <http://example.org/education/concept/MarkenG>,
        <http://example.org/education/concept/Schutzvoraussetzungen>,
        <http://example.org/education/concept/Titelschutz>,
        <http://example.org/education/concept/Urheberrecht>,
        <http://example.org/education/concept/Werke>,
        <http://example.org/education/concept/Wissenschaft>,
        <http://example.org/education/concept/geistiges_Eigentum> ;
    dcterms:title "Institut für Geistiges Eigentum Technikrecht und Medienrecht Vorlesung Urheberrecht II. Schutzvoraussetzungen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

