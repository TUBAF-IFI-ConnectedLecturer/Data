    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs für Ingenieure enthält 14 Aufgaben mit Lösungshilfen zu Wahrscheinlichkeitstheorie und Statistik, die den Lernenden helfen, ihre Fähigkeiten in der Anwendung von Wahrscheinlichkeitsdichten, Verteilungsfunktionen und statistischen Verfahren zu verbessern. Die Aufgaben decken Themen wie Binomialverteilung, Poissonverteilung, Normalverteilung und Exponentialverteilung ab und bieten Lösungshinweise für die Bearbeitung. Durch das Lösen dieser Aufgaben können Lernende ihre mathematischen Fähigkeiten verbessern und ein tieferes Verständnis von Wahrscheinlichkeitstheorie und Statistik erlangen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "888OhN5kAiU0" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Binomialverteilung>,
        <http://example.org/education/concept/Exponentialverteilung>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mathematische_Optimierung>,
        <http://example.org/education/concept/Normalverteilung>,
        <http://example.org/education/concept/Poisson-Verteilung>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie>,
        <http://example.org/education/concept/Zufallsvariable> ;
    dcterms:title "Mathematik für Ingenieure - WS2023/24 Übungsblatt 14"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

