    sim:similarTo oer:9_jXdv3Jgh_Q ;
    dcterms:creator <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übung behandelt verschiedene Optimierungsprobleme, darunter die Standortoptimierung einer Rettungswache und die Projektion eines Punktes auf eine konvexe Menge. Durch die Lösung dieser Aufgaben sollen die Lernenden ihre Fähigkeiten in der mathematischen Modellierung und der Implementierung von Optimierungsproblemen in Matlab verbessern. Die Übung umfasst auch interaktive Tutorials und die Implementierung spezieller Funktionen, wie der Himmelblau-Funktion."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9E-LtGH0Vgh4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Bev%C3%B6lkerungsanzahl>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Hubschrauber>,
        <http://example.org/education/concept/Konvexe_Mengen>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Projektion>,
        <http://example.org/education/concept/Rettungswache>,
        <http://example.org/education/concept/Standortoptimierung> ;
    dcterms:title "Optimierung für Mathematikerinnen Übung 2"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9MXqaVihEfts a edu:LearningResource ;
    sim:similarTo oer:9yK5zsEl6Z2k ;
    dcterms:description "Das Kreuzworträtsel ermöglicht es Schülerinnen, ihr Wissen über Pflanzen und Tiere spielerisch zu überprüfen und logisches Nachdenken zu üben. Durch die Bearbeitung des Rätsels lernen sie, mit gegebenen Hinweisen zu arbeiten und ihre Kenntnisse über Waldlebewesen zu erweitern. Das Material eignet sich für die Grundschule, Klasse 4, im Fach Sachunterricht zum Thema Tiere und Pflanzen im Wald."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9MXqaVihEfts" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologie>,
        <http://example.org/education/concept/Biologie>,
        <http://example.org/education/concept/Grundschule>,
        <http://example.org/education/concept/Kreuzwortr%C3%A4tsel>,
        <http://example.org/education/concept/Lernspiel>,
        <http://example.org/education/concept/Naturwissenschaften>,
        <http://example.org/education/concept/Pflanzen>,
        <http://example.org/education/concept/Sachunterricht>,
        <http://example.org/education/concept/Tiere>,
        <http://example.org/education/concept/Wald%C3%B6kologie> ;
    dcterms:title "Kein Titel gefunden."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9hz9f6wzzUk8 a edu:LearningResource ;
    sim:similarTo oer:9ouqCkhhlSCs ;
    dcterms:creator <http://example.org/education/person/Madubuko> ;
    dcterms:description "Die Verarbeitung von Rassismuserfahrungen bei binationalen Kindern und Jugendlichen in Deutschland wird durch die Erfahrung von Akzeptanz und sozialer Unterstützung beeinflusst. Durch das Empowerment als Erziehungsaufgabe können Eltern und Pädagogen Strategien entwickeln, um Kindern zu helfen, mit Rassismuserfahrungen umzugehen und ein positives Selbstwertgefühl aufzubauen. Dieses Konzept kann dazu beitragen, Benachteiligung und Diskriminierung in Kindertageseinrichtungen und Schulen zu reduzieren und eine inklusivere Gesellschaft zu fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9hz9f6wzzUk8" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_No_Explicit_Mentions_Of_The_Author%27s_Institutional_Affiliation._Therefore__I_Will_Return_An_Empty_String.> ;
    dcterms:subject <http://example.org/education/concept/Akkulturationsstress>,
        <http://example.org/education/concept/Diskriminierung>,
        <http://example.org/education/concept/Erziehung>,
        <http://example.org/education/concept/Identit%C3%A4t>,
        <http://example.org/education/concept/Integration>,
        <http://example.org/education/concept/Interkulturelle_Psychologie>,
        <http://example.org/education/concept/Kindheit>,
        <http://example.org/education/concept/Migration>,
        <http://example.org/education/concept/Rassismus>,
        <http://example.org/education/concept/Selbstwertgef%C3%BChl> ;
    dcterms:title "Empowerment als Erziehungsaufgabe: Verarbeitungsstrategien gegen Rassismuserfahrungen von binationalen Kindern und Jugendlichen"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

