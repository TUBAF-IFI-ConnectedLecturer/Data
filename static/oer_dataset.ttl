oer:8i9O_3XAF_T4 a edu:LearningResource ;
    sim:similarTo oer:8qTdyyZU5U94 ;
    dcterms:creator <http://example.org/education/person/Spencer> ;
    dcterms:description "Die Nachbereitungsaufgabe behandelt die Äquivalenz von Aussagen und die Distributivität von Konjunktion und Disjunktion. Durch die Bearbeitung dieser Aufgaben können Lerner die Regeln der Booleschen Algebra verstehen und anwenden. Die Lösungen dienen als Grundlage für weitere mathematische Überlegungen und Beweise in der Logik und Algebra."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8i9O_3XAF_T4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%84quivalenzrelationen>,
