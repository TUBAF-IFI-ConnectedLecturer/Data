oer:4t9YsmhP8pJA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/St%C3%A4hele> ;
    dcterms:description "Das Exposé beschreibt ein mehrstufiges Vorgehen zur Analyse der Robotik und Automatisierung im Rohbau, um die Möglichkeiten und Grenzen dieser Technologien zu evaluieren und praxisnahe Handlungsempfehlungen für die Bauindustrie zu erarbeiten. Durch die Kombination von Literaturrecherche, Fallstudien, Experteninterviews und Kosten-Nutzen-Analyse soll ein Überblick über den aktuellen Stand der Technik im Bereich der Robotik und Automatisierung im Rohbau gegeben werden. Ziel ist es, die Potentiale dieser Technologien für die Bauindustrie aufzuzeigen und Unternehmen bei der Einführung und Nutzung von Robotik und Automatisierung zu unterstützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4t9YsmhP8pJA" ;
    dcterms:subject <http://example.org/education/concept/Automatisierung>,
        <http://example.org/education/concept/Bauindustrie>,
        <http://example.org/education/concept/Bauprojekt>,
        <http://example.org/education/concept/Bauwesen>,
        <http://example.org/education/concept/Fertigungsindustrie>,
        <http://example.org/education/concept/Innovationsmanagement>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Robotik>,
        <http://example.org/education/concept/Rohbau> ;
    dcterms:title "Exposé: Robotik  Automatisierung  Innovativer Rohbau"@de ;
    dcterms:type <http://example.org/education/type/Expos%C3%A9> .

