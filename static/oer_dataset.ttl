    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:79fMSwFhbI1U a edu:LearningResource ;
    sim:similarTo oer:7HAMS2OvGsQ0,
        oer:7_uTTDF4X3PM ;
    dcterms:creator <http://example.org/education/person/B%C3%B6hmer>,
        <http://example.org/education/person/Breitkopf>,
        <http://example.org/education/person/Dittmann> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Technischen Thermodynamik, einschließlich des ersten und zweiten Hauptsatzes, sowie der Zustandsgrößen, Prozessgrößen und Energieformen. Durch das Studium dieser Materialien können Lernende die thermodynamischen Prinzipien verstehen und anwenden, um Energiesysteme zu analysieren und zu optimieren. Die Ausarbeitung bereitet auf die mündliche Prüfung in Technischer Thermodynamik vor und bietet eine umfassende Übersicht über die relevanten Konzepte und Formeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "79fMSwFhbI1U" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Energiebilanz>,
