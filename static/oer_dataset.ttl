oer:3LhXXYP9AZuE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Ertel>,
        <http://example.org/education/person/Heinrich>,
        <http://example.org/education/person/Valdez> ;
    dcterms:description "Das Bildungsmaterial behandelt die Kommunikationsstrategien für verschiedene Waldbesitzertypen und bietet eine Übersicht über die Angebote von Sachsenforst für Privat- und Körperschaftswälder, einschließlich Beratung, Betreuung, Fortbildung und Infomaterialien. Durch die Verwendung dieses Materials können Lernende Kenntnisse über die Bedürfnisse und Ziele unterschiedlicher Waldbesitzer erwerben und effektive Kommunikationsstrategien entwickeln, um ihre Anliegen zu unterstützen. Darüber hinaus erhalten sie Einblick in die Rechtsgrundlagen und Angebote von Sachsenforst für Waldbesitzer."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "3LhXXYP9AZuE" ;
    dcterms:subject <http://example.org/education/concept/Forstberatung>,
        <http://example.org/education/concept/Forstwirtschaft>,
        <http://example.org/education/concept/K%C3%B6rperschaftswald>,
        <http://example.org/education/concept/Land-_und_Forstwirtschaft>,
