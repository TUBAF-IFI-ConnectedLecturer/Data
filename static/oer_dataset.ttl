oer:58FG8lF2rkE0 a edu:LearningResource ;
    sim:similarTo oer:5P4CJahMkn0E,
        oer:5PJ8bhRKTpzQ,
        oer:5Q9DbrTcVyDA,
        oer:5QCtlYBjmwXM,
        oer:5Zz_ZGxORBqM ;
    dcterms:creator <http://example.org/education/person/Conrad> ;
    dcterms:description "Das Konzept behandelt das Leben in Dippoldiswalde im Mittelalter und ermöglicht Schülern, sich in die Rolle einer Person aus dieser Zeit hineinzuversetzen und Aspekte der Siedlungsgeschichte ihres Heimatraumes zu erkennen. Durch die Bearbeitung von Aufgaben auf dem Bergbaulehrpfad und im Museum erwerben die Schüler Kenntnisse über die mittelalterliche Gesellschaft, die Bedeutung von Dippoldiswalde als Bergbausiedlung und verbessern ihre Fähigkeit, sich in andere hineinzuversetzen. Am Ende des Konzepts können die Schüler die Auswirkungen der Abholzung auf Hänge und die Eigenschaften einer Karte erklären und eine Personenbeschreibung für eine im Mittelalter lebende Person erstellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "58FG8lF2rkE0" ;
    dcterms:subject <http://example.org/education/concept/Bergbau>,
        <http://example.org/education/concept/Fach%C3%BCbergreifender_Unterricht>,
        <http://example.org/education/concept/Geschichte_des_Mittelalters>,
        <http://example.org/education/concept/Heimatgeschichte>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Schulunterricht>,
        <http://example.org/education/concept/Siedlungsgeschichte>,
        <http://example.org/education/concept/Soziale_Schichtung>,
        <http://example.org/education/concept/St%C3%A4ndegesellschaft>,
        <http://example.org/education/concept/Stadtgeschichte> ;
    dcterms:title "Das Leben in Dippoldiswalde im Mittelalter"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

