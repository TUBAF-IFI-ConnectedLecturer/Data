    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von Schienenfahrzeugen wird durch die Kombination von translatorischen und rotatorischen Bewegungen bestimmt, wobei der fahrdynamische Massenfaktor eine wichtige Rolle bei der Berechnung der Trägheit spielt. Durch das Verständnis dieser Konzepte können Lernende die Fahrdynamik von Schienenfahrzeugen besser analysieren und berechnen, um sicherere und effizientere Fahrzeugsysteme zu entwickeln. Die Kenntnisse über die Antriebs- und Bremskräfte, das Massentragheitsmoment und den fahrdynamischen Massenfaktor sind essentiell für die Entwicklung von Schienenfahrzeugen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10aH3JFPYmrbQ" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Berlin> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Bremsentechnik>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Tragheitsmomente>,
        <http://example.org/education/concept/Widerstandskr%C3%A4fte>,
        <http://example.org/education/concept/Zugkraft>,
        <http://example.org/education/concept/kinetische_Energie> ;
    dcterms:title "Lehrbuch Fahrdynamik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

