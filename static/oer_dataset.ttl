oer:8S_vr2Brw-rk a edu:LearningResource ;
    sim:similarTo oer:9flIemN3tGug,
        oer:9od5iuFCNLp0 ;
    dcterms:creator <http://example.org/education/person/Feder> ;
    dcterms:description "Das GIF führt Schritt für Schritt durch das Vorgehen zur Aufstellung von Oxidationszahlen für organische Verbindungen und hilft dabei, die SuS zu unterstützen, indem es eine farbige Unterscheidung vornimmt, um zu verdeutlichen, welches Element an welcher Stelle betrachtet wird. Durch das Material können die SuS lernen, wie sie Oxidationszahlen bei organischen Verbindungen aufstellen können und trainieren sich darin, neue Inhalte mit digitalen Medien zu erarbeiten. Die SuS gewinnen ein besseres Verständnis der Oxidationszahlen und ihrer Anwendung in der Chemie."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "8S_vr2Brw-rk" ;
    dcterms:subject <http://example.org/education/concept/Anorganische_Stoffe>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Chemieunterricht>,
        <http://example.org/education/concept/Chemische_Bindung>,
        <http://example.org/education/concept/Digitale_Medien>,
        <http://example.org/education/concept/Elektronegativit%C3%A4t>,
        <http://example.org/education/concept/Lehrmittel>,
        <http://example.org/education/concept/Multimedia>,
        <http://example.org/education/concept/Organische_Verbindung>,
        <http://example.org/education/concept/Oxidationszahl> ;
    dcterms:title "Kurzbeschreibung eines GIFs zur Aufstellung der Oxidationszahlen für eine organische Verbindung"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:8fyJGPc55dRw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Pietsch> ;
    dcterms:description "Die Vorlesung Sanierungsbergbau an der TU Bergakademie Freiberg behandelt die Renaturierung von bergbaulich beanspruchten Flächen und die damit verbundenen ökologischen und naturschutzfachlichen Aspekte. Durch die Umsetzung von Rekultivierungs- und Sanierungsmaßnahmen können Biodiversität und ökologische Vielfalt in den Bergbaufolgelandschaften verbessert werden. Die Vorlesung bietet Einblicke in die Planung und den Aufbau von Naturschutzflächen, die Ausweisung von FFH- und Vogelschutzgebieten sowie die Kosten für den Waldumbau."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8fyJGPc55dRw" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologie>,
        <http://example.org/education/concept/Bergbau>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
        <http://example.org/education/concept/Braunkohle>,
        <http://example.org/education/concept/Forstwirtschaft>,
        <http://example.org/education/concept/Landschaftsplanung>,
        <http://example.org/education/concept/Naturschutz>,
        <http://example.org/education/concept/Rekultivierung>,
        <http://example.org/education/concept/Sanierung>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Vorlesung Sanierungsbergbau Sommersemester 2023 TU Bergakademie Freiberg"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8ge_amaTTtBc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kowalzik> ;
    dcterms:description "Die Hausaufgabe behandelt die Lösung von linearen Gleichungssystemen mit Hilfe einer Matrix. Es werden drei verschiedene Fälle betrachtet: ein homogenes Gleichungssystem Ax = 0 und zwei inhomogene Gleichungssysteme Ax = b bzw. Ax = c. Durch die Lösung dieser Aufgaben können Lernende ihre Fähigkeiten im Bereich der linearen Algebra verbessern und erfahren, wie sie komplexe Gleichungssysteme effizient lösen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8ge_amaTTtBc" ;
    dcterms:publisher <http://example.org/education/organization/LAG_N3.2> ;
    dcterms:subject <http://example.org/education/concept/Algebraische_Strukturen>,
        <http://example.org/education/concept/Gleichungssysteme>,
        <http://example.org/education/concept/Homogenes_Gleichungssystem>,
        <http://example.org/education/concept/Inhomogenes_Gleichungssystem>,
        <http://example.org/education/concept/L%C3%B6sungsverfahren>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematische_Modellierung>,
        <http://example.org/education/concept/Matrix>,
        <http://example.org/education/concept/Numerische_Analysis.>,
        <http://example.org/education/concept/Vektoren> ;
    dcterms:title "Aufgabenstellung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8iZLpIllhaYQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Grossmann> ;
    dcterms:description "Die Teilmarktanalyse behandelt die Untersuchung von Märkten und Teil Märkten im Kontext des Verlagsmanagements, wobei Schwerpunkte auf der Konkurrenzsituation, Markteintrittsbarrieren, relevanten Marktkräften nach Porter und Zukunftspotenzialen liegen. Durch die Analyse sollen Marktphasen, Marktvolumina, Preisstrukturen und Zielgruppen ermittelt werden, um ein umfassendes Bild des Marktes zu erhalten. Die Anwendung von Modellen wie der Ansoff-Matrix und dem Five-Forces-Modell nach Porter unterstützt die Analyse und Bewertung von Märkten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8iZLpIllhaYQ" ;
    dcterms:publisher <http://example.org/education/organization/HTWK_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Buchmarkt>,
        <http://example.org/education/concept/Konkurrenzsituation>,
        <http://example.org/education/concept/Marktanalyse>,
        <http://example.org/education/concept/Marktforschung>,
        <http://example.org/education/concept/Marktstrategie>,
        <http://example.org/education/concept/Medienwirtschaft>,
        <http://example.org/education/concept/Publishing_industry>,
        <http://example.org/education/concept/Verlagsgesch%C3%A4ft>,
        <http://example.org/education/concept/Verlagsmanagement>,
        <http://example.org/education/concept/Wettbewerb> ;
    dcterms:title "Teilmarktanalyse"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8kSkwgu0kfcI a edu:LearningResource ;
    dcterms:description "Diese Checkliste für eine Hausarbeit unterstützt Studierende bei der Erstellung einer wissenschaftlichen Arbeit, indem sie wichtige Aspekte wie Struktur, Inhalt und Formatierung überprüft. Durch die Verwendung dieser Liste können Lernende sicherstellen, dass ihre Arbeit alle erforderlichen Elemente enthält und den Anforderungen des Instituts entspricht. Die Checkliste hilft dabei, eine gut strukturierte und inhaltlich vollständige Hausarbeit zu erstellen, die alle wichtigen Aspekte einer wissenschaftlichen Arbeit abdeckt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8kSkwgu0kfcI" ;
    dcterms:subject <http://example.org/education/concept/Formatierung>,
        <http://example.org/education/concept/Forschungsmethodik>,
        <http://example.org/education/concept/Hausarbeit>,
        <http://example.org/education/concept/Inhaltsverzeichnis>,
