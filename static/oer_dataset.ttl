oer:10J3cPPfnzJxM a edu:LearningResource ;
    sim:similarTo oer:11TmvtN-PkKJE,
        oer:12cP5Jma48Wt8 ;
    dcterms:creator <http://example.org/education/person/Klein>,
        <http://example.org/education/person/Schindler> ;
    dcterms:description "Die Inklusion und Barrierefreiheit an Hochschulen sind menschenrechtlich normierte Ansprüche von Menschen mit Behinderungen und chronischen Erkrankungen auf eine freie Entfaltung in Hochschulen. Durch die Umsetzung von Barrierefreiheit und Inklusion können Studierende mit Behinderungen und chronischen Erkrankungen ihre Rechte auf Teilhabe unter der Prämisse der Selbstbestimmung umsetzen. Die rechtlichen Grundlagen für die digitale Barrierefreiheit an Hochschulen sind in Gesetzen wie dem Behindertengleichstellungsgesetz (BGG) und den Web Content Accessibility Guidelines (WCAG 2.1) verankert."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "10J3cPPfnzJxM" ;
    dcterms:subject <http://example.org/education/concept/Barrierefreiheit>,
        <http://example.org/education/concept/Behindertenrecht>,
        <http://example.org/education/concept/Bildungspolitik>,
        <http://example.org/education/concept/Chronische_Erkrankungen>,
        <http://example.org/education/concept/Digitale_Medien>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Hochschulbildung>,
        <http://example.org/education/concept/Inklusion>,
        <http://example.org/education/concept/Menschen_mit_Behinderungen>,
        <http://example.org/education/concept/Teilhabe> ;
    dcterms:title "Inklusion und Hochschule: Eine Einführung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10Kdoub7lKZEg a edu:LearningResource ;
    sim:similarTo oer:5Y9RHd4X4FWg,
        oer:7wuDd84YwlLA ;
    dcterms:description "Die Recherche umfasst die Verwendung von Bibliothekskatalogen, Datenbanken und Suchmaschinen, um akademische und wissenschaftliche Dokumente zu finden. Durch die Anwendung von Filterfunktionen und der Spezialisierung von Suchbegriffen können Nutzer gezielt nach relevanten Informationen suchen. Die Verwendung dieser Recherche-Tools ermöglicht es den Lernenden, effizienter und zielführender nach akademischen Quellen zu recherchieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10Kdoub7lKZEg" ;
    dcterms:subject <http://example.org/education/concept/Bibliothekskatalog>,
        <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Elektronische_Zeitschriften>,
