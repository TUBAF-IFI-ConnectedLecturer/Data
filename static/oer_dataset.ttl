        <http://example.org/education/concept/Quicksort>,
        <http://example.org/education/concept/Sortieralgorithmen>,
        <http://example.org/education/concept/Speicherkomplexit%C3%A4t> ;
    dcterms:title "Mündliche Abiturprüfung Fach Informatik - Grundkurs"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

