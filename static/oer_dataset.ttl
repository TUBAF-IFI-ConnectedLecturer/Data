        <http://example.org/education/concept/Spatial_Analysis>,
        <http://example.org/education/concept/Vermessungstechnik> ;
    dcterms:title "Grundlagen GIS"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

