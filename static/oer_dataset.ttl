        oer:91zCnQXHW0H4,
        oer:981sj_8QUGLc,
        oer:9LnXOs6zIBSA ;
    dcterms:description "Dieses Dokument behandelt verschiedene Methoden der Interpolation und Approximation von Funktionen, einschließlich linearer und bilinearer Interpolation, Spline-Interpolation und Polynom-Interpolation, um unbekannte Werte an bestimmten Punkten vorherzusagen. Durch das Studium dieser Methoden können Lernende die Fähigkeit erwerben, komplexe Daten zu analysieren und zu interpretieren, sowie genaue Vorhersagen für verschiedene Anwendungen in der Geographie, Physik und anderen Wissenschaften treffen. Die dargestellten Konzepte und Algorithmen ermöglichen es Lernenden, ihre Fähigkeiten in der Datenanalyse und -modellierung zu verbessern und komplexe Probleme zu lösen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5JYM9D6ZalyQ" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Baryzentrische_Koordinaten>,
        <http://example.org/education/concept/GIS>,
        <http://example.org/education/concept/Geoinformatik>,
        <http://example.org/education/concept/Interpolation>,
        <http://example.org/education/concept/Kartographie>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Polynomfunktionen>,
        <http://example.org/education/concept/Punktgitter>,
        <http://example.org/education/concept/Spatial_Analysis>,
        <http://example.org/education/concept/Spline-Funktionen> ;
    dcterms:title "Grundlagen GIS TU Bergakademie Freiberg"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

