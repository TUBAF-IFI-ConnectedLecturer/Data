oer:3LfJn6Ub-oUA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Wei%C3%9F> ;
    dcterms:description "Der Themenstadtplan Dresden behandelt die Geschichte und Entwicklung von Volksparks in Deutschland, insbesondere in Berlin und Dresden, und zeigt ihre Bedeutung für die Stadtbevölkerung auf. Die Präsentation bietet einen Überblick über die Entstehung und Bedeutung von Volksparke im 19. und 20."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "3LfJn6Ub-oUA" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Berlin> ;
    dcterms:subject <http://example.org/education/concept/Gartenkunst>,
