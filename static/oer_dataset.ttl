    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt bietet Lösungshilfen für Aufgaben aus der Geometrie und behandelt Themen wie Kegelschnitte, affine Abbildungen, Drehkegelflächen und Bézierkurven. Durch die Bearbeitung dieser Aufgaben können Lernende ihre Fähigkeiten in der Anwendung geometrischer Konzepte und Methoden verbessern und ihr Verständnis für die Zusammenhänge zwischen verschiedenen geometrischen Objekten vertiefen. Die Lösungen zu den Aufgaben werden nicht angegeben, sondern es werden Hinweise und Anregungen zur selbständigen Bearbeitung gegeben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4CmAoFw01p4w" ;
    dcterms:publisher <http://example.org/education/organization/Marco.hamann%40htw-dresden.de_%E2%86%92_Hochschule_F%C3%BCr_Technik_Und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Drehkegelfl%C3%A4che>,
