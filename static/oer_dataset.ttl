oer:5HSyfuQPNum0 a edu:LearningResource ;
    sim:similarTo oer:8dmVqV-jz-M8 ;
    dcterms:description "Der Graph 𝐾3,5 wird als vollständiger bipartiter Graph beschrieben, der aus zwei disjunkten Mengen von Knoten besteht. Das Komplement dieses Graphen, 𝐾3,5, wird definiert und seine Eigenschaften werden erläutert. Durch das Studium dieser Graphen können Lernende die Konzepte der Graphentheorie und ihre Anwendungen besser verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5HSyfuQPNum0" ;
    dcterms:subject <http://example.org/education/concept/Adjazenzmatrizen>,
        <http://example.org/education/concept/Bipartite_Graphen>,
        <http://example.org/education/concept/Diagramme>,
        <http://example.org/education/concept/Diskrete_Strukturen>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Kanten>,
        <http://example.org/education/concept/Knoten>,
        <http://example.org/education/concept/Komplemente_von_Graphen>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Vollst%C3%A4ndige_Graphen> ;
    dcterms:title "Formale Beschreibung Der Graph 𝐾3,5"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5IEGza0SZhNU a edu:LearningResource ;
    sim:similarTo oer:7d-lFY-WAlqQ ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Diese Arbeitsaufgaben unterstützen das Verständnis grundlegender Konzepte der germanistischen Sprachwissenschaft, indem sie die Analyse von syntaktischen Strukturen und Kategorien fördern. Durch die Bearbeitung dieser Aufgaben können Lerner ihre Fähigkeiten in der Konstituentenanalyse, der Identifizierung von Ambiguitäten und der Zerlegung komplexer Nominalphrasen verbessern. Die Arbeitsaufgaben decken ein breites Spektrum an Themen ab, darunter die Zuordnung syntaktischer Kategorien, die Analyse von Sätzen und die Identifizierung von Objekten und Adverbialen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5IEGza0SZhNU" ;
    dcterms:subject <http://example.org/education/concept/Ambiguit%C3%A4t>,
        <http://example.org/education/concept/Germanistik>,
