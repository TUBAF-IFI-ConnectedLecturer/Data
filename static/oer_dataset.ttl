oer:10jhRT5qT3E0k a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Gruner> ;
    dcterms:description "Die Übung behandelt die Rassegesetze und Justiz im Nationalsozialismus und bietet eine Literaturliste zu diesem Thema. Durch das Studium dieser Quellen können Lernende Einblick in die Strafjustiz der Diktaturen und den historischen Ort des Münchner Platzes in Dresden gewinnen. Die Literatur behandelt unter anderem die politische Justiz in Dresden zwischen 1933 und 1945 sowie die Erinnerungspolitik an die Opfer politischer Gewaltherrschaft."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10jhRT5qT3E0k" ;
    dcterms:subject <http://example.org/education/concept/Diktatur>,
        <http://example.org/education/concept/Erinnerungspolitik>,
        <http://example.org/education/concept/Geschichte_Deutschlands>,
        <http://example.org/education/concept/Justiz>,
        <http://example.org/education/concept/Kunst_und_Widerstand>,
        <http://example.org/education/concept/Nationalsozialismus>,
        <http://example.org/education/concept/Politische_Gewaltherrschaft>,
        <http://example.org/education/concept/Rassegesetze>,
        <http://example.org/education/concept/Strafjustiz>,
        <http://example.org/education/concept/Widerstand> ;
    dcterms:title "Übung Rassegesetze, Justiz und Gesellschaft im Nationalsozialismus"@de ;
    dcterms:type <http://example.org/education/type/Literaturliste> .

