        <http://example.org/education/concept/Integrationstheorie>,
        <http://example.org/education/concept/Isomorphismus>,
        <http://example.org/education/concept/Lokale_Extrema>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Metrische_R%C3%A4ume>,
        <http://example.org/education/concept/Vektorfelder> ;
    dcterms:title "Mathematik für Informatiker"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

