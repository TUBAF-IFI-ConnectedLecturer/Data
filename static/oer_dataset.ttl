        <http://example.org/education/concept/Lehrmethoden>,
        <http://example.org/education/concept/Physikunterricht>,
        <http://example.org/education/concept/Schwingkreis> ;
    dcterms:title "Die Software verdeutlicht den Sachverhalt eines Elektromagnetischen Schwingkreises."@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

