    dcterms:type <http://example.org/education/type/Programm> .

oer:5PsgNa9Gva_Y a edu:LearningResource ;
    dcterms:description "Ein Herrscher beschließt die Begnadigung von 100 Gefangenen nach einem speziellen System, bei dem die Zellentüren in mehreren Durchgängen geöffnet und geschlossen werden. Ein C-Programm wird entwickelt, um zu bestimmen, welche Türen am Ende offenstehen und wie viele Gefangene freigelassen werden. Durch das Verständnis dieses Systems und des Programmcodes können Lerner die Logik hinter diesem Prozess verstehen und programmierbare Lösungen für ähnliche Probleme entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5PsgNa9Gva_Y" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Begnadigung>,
        <http://example.org/education/concept/C-Programmiersprache>,
        <http://example.org/education/concept/Computersimulation>,
        <http://example.org/education/concept/Gefangene>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Simulation>,
        <http://example.org/education/concept/Zahlenfolgen>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Aufgabe: Aus Anlass seines Geburtstages beschloss ein Herrscher die Begnadigung seiner in 100 Einzelzellen untergebrachten Gefangenen."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

