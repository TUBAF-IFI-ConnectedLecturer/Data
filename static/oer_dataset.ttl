        oer:8VwcsCHDrtQ0,
        oer:9ayicVUSbMyA ;
    dcterms:creator <http://example.org/education/person/Scheffel> ;
    dcterms:description "Das Modul M4 \"Experimentalpsychologisches Arbeiten\" vermittelt Studierenden die Fähigkeit, wissenschaftliche Experimente selbständig zu planen, durchzuführen und auszuwerten, sowie die Ergebnisse in einem Untersuchungsbericht darzustellen. Durch das Praktikum erwerben sie Kenntnisse über die Planung, Durchführung und Auswertung von Experimenten nach den Regeln guter wissenschaftlicher Praxis und Open Science. Am Ende des Moduls können Studierende einen vollständigen Untersuchungsbericht erstellen und ihre Ergebnisse präsentieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11G78-wrBu0J4" ;
    dcterms:subject <http://example.org/education/concept/Berichterstellung>,
        <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Experimentalpsychologie>,
        <http://example.org/education/concept/Forschungspraktikum>,
        <http://example.org/education/concept/Methodenlehre>,
        <http://example.org/education/concept/Open_Science>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Versuchsplanung>,
        <http://example.org/education/concept/Wissenschaftliches_Arbeiten>,
        <http://example.org/education/concept/akademische_Integrit%C3%A4t> ;
    dcterms:title "ES Experimentalpsychologisches Arbeiten 1. Einführung Christoph Scheffel"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

