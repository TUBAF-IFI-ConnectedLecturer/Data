oer:5gFrSvgKiRI0 a edu:LearningResource ;
    sim:similarTo oer:5s5fLCflWxiQ,
        oer:66pIeQLkVmhQ,
        oer:6SeAIQbBciKs,
        oer:6seY40ce3q_E,
        oer:6zYZZf8q4TRI ;
    dcterms:creator <http://example.org/education/person/Kossatz> ;
    dcterms:description "Die Vorlesung behandelt die Konzepte und Theorien der Neuesten Geschichte, insbesondere die Erinnerungsgeschichte und Public History. Durch die Auseinandersetzung mit den zentralen Fragestellungen der Erinnerungsgeschichte wie \"Was verstehen wir unter Erinnerung?\" und \"Wie verlässlich sind Erinnerungen?\" können Historiker:innen ihre Quellen kritisch bewerten und kontextualisieren. Die Lernenden gewinnen ein Verständnis dafür, dass Erinnerungen komplexe Begriffe sind, die von individuellen und kollektiven Faktoren beeinflusst werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5gFrSvgKiRI0" ;
    dcterms:subject <http://example.org/education/concept/Erinnerungsgeschichte>,
        <http://example.org/education/concept/Ged%C3%A4chtnis>,
        <http://example.org/education/concept/Geschichte>,
        <http://example.org/education/concept/Geschichtsschreibung>,
        <http://example.org/education/concept/Historiographie>,
        <http://example.org/education/concept/Kollektives_Ged%C3%A4chtnis>,
        <http://example.org/education/concept/Neurowissenschaften>,
        <http://example.org/education/concept/Oral_History>,
        <http://example.org/education/concept/Public_History>,
        <http://example.org/education/concept/Zeitzeugeninterviews> ;
    dcterms:title "Konzepte und Theorien der Neuesten Geschichte"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5m6bo9fcB_58 a edu:LearningResource ;
    sim:similarTo oer:5saLiHxSXyEY,
        oer:7F-jfGR5OLU4,
        oer:7ohmtOd8ipAE ;
    dcterms:creator <http://example.org/education/person/Holznagel> ;
    dcterms:description "Die Hanse entwickelte eine überregionale, dialektübergreifende Sprachnorm, die sich am Gebrauch der lübeckischen Kanzleien ausrichtet und lautliche Besonderheiten wie Rundung von i zu ü aufweist. Die Hanse als Kaufmanns- und Städtebund spielte eine wichtige Rolle bei der Ausbildung einer norddeutschen Verkehrssprache, die bis weit in den skandinavischen, baltischen und russischen Raum hinein ausstrahlte. Durch das Studium dieser Sprachnorm können Lernende Einblick in die Geschichte der deutschen Sprache und ihre Erforschung gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5m6bo9fcB_58" ;
    dcterms:subject <http://example.org/education/concept/Geschichte_des_Deutschen>,
        <http://example.org/education/concept/Handelsgeschichte>,
        <http://example.org/education/concept/Hanse>,
        <http://example.org/education/concept/Hansest%C3%A4dte>,
        <http://example.org/education/concept/Kaufmannsgilde>,
        <http://example.org/education/concept/Lexikologie>,
        <http://example.org/education/concept/Mittelniederdeutsch>,
        <http://example.org/education/concept/Niederdeutsche_Sprache>,
        <http://example.org/education/concept/Seefahrt>,
        <http://example.org/education/concept/Sprachgeschichte> ;
    dcterms:title "DIE SPRACHE DER HANSE"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:5sNJreFhOmDk a edu:LearningResource ;
    sim:similarTo oer:79GxsJxr7AdE,
        oer:7YCB8Xz8FKfc,
        oer:7fNWkWbsmXoQ ;
    dcterms:description "Diese Richtlinie beschreibt die Anforderungen und Vorgaben für die Erstellung von Protokollen im Lehrgebiet Druckprozesse an der Hochschule für Technik, Wirtschaft und Kultur Leipzig. Sie enthält Hinweise zur Form und Gestaltung, zum Aufbau der Protokolle, zur Aufbereitung von Messdaten und Bildmaterial sowie zu Referenzen und Quellenangaben. Durch die Anwendung dieser Richtlinie sollen Studierende in der Lage sein, wissenschaftlich-technisch fundierte Protokolle anzufertigen, die eine Einschätzung und Reproduzierbarkeit ihrer Arbeit ermöglichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5sNJreFhOmDk" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_F%C3%BCr_Technik__Wirtschaft_Und_Kultur_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Bibliographie>,
        <http://example.org/education/concept/Druckmuster>,
        <http://example.org/education/concept/Druckprozesse>,
        <http://example.org/education/concept/IEEE-Zitierstil>,
        <http://example.org/education/concept/Messwerttabellen>,
        <http://example.org/education/concept/Print-Technologien>,
        <http://example.org/education/concept/Protokoll-Erstellung>,
        <http://example.org/education/concept/Quellcode>,
        <http://example.org/education/concept/Technische_Dokumentation>,
        <http://example.org/education/concept/Wissenschaftliches_Schreiben> ;
    dcterms:title "Richtlinie zur Erstellung von Protokollen im Lehrgebiet Druckprozesse"@de ;
    dcterms:type <http://example.org/education/type/Richtlinie> .

oer:61HZ_uuFSNy8 a edu:LearningResource ;
    sim:similarTo oer:7AIMNZeB_znY,
        oer:8B85pzZxB7xA,
        oer:9emfJNG2j0_Q ;
    dcterms:creator <http://example.org/education/person/Krause> ;
    dcterms:description "Die Aufgaben behandeln grundlegende Konzepte der Computergraphik, insbesondere die Berechnung von Abständen zwischen Geraden und Ebenen sowie die Schnittpunkte zwischen ihnen. Durch die Lösung dieser Aufgaben können Lernende ihre Fähigkeiten in der Anwendung mathematischer Formeln und Algorithmen zur Lösung graphischer Probleme verbessern. Die Inhalte sind für Studierende der Informatik oder verwandter Fachrichtungen von Bedeutung, um ein solides Verständnis der Computergraphik zu erlangen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "61HZ_uuFSNy8" ;
    dcterms:subject <http://example.org/education/concept/Abst%C3%A4nde>,
