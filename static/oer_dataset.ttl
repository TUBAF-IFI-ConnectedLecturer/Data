    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt behandelt grundlegende Konzepte der Algebra und Geometrie, indem es die Lösung von Aufgaben zu Operationen wie ggT, Konjunktion, Disjunktion und Negation sowie algebraischen Strukturen anhand von Beispielen und Tabellen vermittelt. Durch das Bearbeiten dieser Aufgaben können Lernende ihre Fähigkeiten im Bereich der abstrakten Algebra und Geometrie verbessern und ein tieferes Verständnis für die Anwendung dieser Konzepte in verschiedenen mathematischen Kontexten entwickeln. Die Übungsaufgaben decken Themen wie Gruppen, Ringe, Körper und algebraische Strukturen ab, die für das Verständnis von Mathematik und Informatik grundlegend sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5A0TJgla3QJw" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Boolesche_Algebra>,
