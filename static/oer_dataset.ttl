oer:6e8NNjlG5fTY a edu:LearningResource ;
    sim:similarTo oer:7KyYdvgCmtY4 ;
    dcterms:description "Die Renaissance war eine Epoche der Wiederbesinnung auf die Antike, die zwischen 1450 und 1600 stattfand und die Neuzeit einleitete. In dieser Zeit entwickelten sich neue literarische und wissenschaftliche Geistesrichtungen, wie der Humanismus, und es gab bahnbrechende Erkenntnisse in den Naturwissenschaften. Die Renaissance prägte auch die Politik, Gesellschaft, Wirtschaft und Technik Europas, indem sie das alte Feudalsystem ablöste und neue Mächte und Klassen entstehen ließ."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6e8NNjlG5fTY" ;
    dcterms:subject <http://example.org/education/concept/Buchdruck>,
        <http://example.org/education/concept/Fr%C3%BChneuzeit>,
        <http://example.org/education/concept/Humanismus>,
        <http://example.org/education/concept/Kirchengeschichte>,
        <http://example.org/education/concept/Kulturgeschichte>,
        <http://example.org/education/concept/Protestantismus>,
        <http://example.org/education/concept/Reformation>,
        <http://example.org/education/concept/Renaissance>,
        <http://example.org/education/concept/Technikgeschichte>,
        <http://example.org/education/concept/Wissenschaftsgeschichte> ;
    dcterms:title "Kein Titel gefunden."@de ;
    dcterms:type <http://example.org/education/type/Skript> .

