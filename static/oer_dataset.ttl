oer:8Nwhjx28oOU4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Mustermann>,
        <http://example.org/education/person/Nyoro>,
        <http://example.org/education/person/Si> ;
    dcterms:description "In dieser Lehrveranstaltung lernen Studierende, Themen einer mobilen Gesellschaft zu bearbeiten und effizient in Gruppen zusammenzuarbeiten. Sie erwerben Fähigkeiten im einheitlichen Zitieren und Umgang mit Quellen und präsentieren ihre Ergebnisse in einer 30-minütigen Präsentation. Durch die Bearbeitung eines Themas und der anschließenden Präsentation entwickeln sie ihre Kompetenzen in der Elektromobilität."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8Nwhjx28oOU4" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
