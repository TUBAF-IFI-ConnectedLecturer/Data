oer:8w7Gd3W6PXHI a edu:LearningResource ;
    sim:similarTo oer:9h5DzkjuA7nQ,
        oer:9t_nKAZbzrxs ;
    dcterms:creator <http://example.org/education/person/B%C3%B6hm> ;
    dcterms:description "JavaKara ist ein Programm, das die Einstiegsmöglichkeit in die Java-Programmierung bietet und es ermöglicht, einen kleinen Marienkäfer namens Kara durch eine vorher erstellte Welt zu navigieren und dort verschiedene Aufgaben erfüllen zu lassen. Durch die Verwendung von JavaKara können Schülerinnen die Grundlagen objektorientierter Programmierung, einfache Probleme objektorientiert lösen und Programme kritisch bewerten. Das Werkzeug eignet sich insbesondere für den Informatikunterricht am Gymnasium und beruflichen Gymnasium, um ausgewählte Datenstrukturen und Algorithmen in einer Programmierumgebung umzusetzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8w7Gd3W6PXHI" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Java>,
        <http://example.org/education/concept/Lehrpl%C3%A4ne>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Tools>,
        <http://example.org/education/concept/objektorientierte_Programmierung> ;
    dcterms:title "Werkzeuge für den Informatikunterricht ---- JavaKara ----"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

