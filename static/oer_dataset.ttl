        <http://example.org/education/concept/Robotik>,
        <http://example.org/education/concept/Serielle_Roboter> ;
    dcterms:title "Räumliche Kinematik - Sommer 2025 Übungsblatt 7"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

