        oer:9y9ooc8x1mY8,
        oer:9yM7IfLukoZ8 ;
    dcterms:creator <http://example.org/education/person/Neubauer> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Grundlagen der statistischen Analyse, insbesondere die Anwendung von Varianzanalysen und Chi-Quadrat-Tests auf akademische und wissenschaftliche Fragestellungen. Durch das Studium dieses Materials können Lernende die Konzepte und Methoden der deskriptiven Statistik, der Inferenzstatistik und der explorativen Datenanalyse verstehen und anwenden. Sie erwerben Fähigkeiten im Umgang mit statistischen Verfahren in Excel und SPSS, um komplexe Fragestellungen zu beantworten und fundierte Entscheidungen treffen zu können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10OA6bhZnI8CE" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_That_The_Author%27s_Institution_Is%3Aba_%28no_Specific_University_Name_Mentioned%29the_Hint_Was_Found_In_The_Footer_Of_Each_Page__Which_Mentions_%22statistik_Und_Quantitative_Methoden_Ba_Riesa_Maria_Neubauer_07.05.2021_Creative_Commons%3A_Attribution-noncomercial_Cc_By-nc%22._The_%22ba%22_Likely_Stands_For_a_Bachelor%27s_Degree_Program_At_An_Unspecified_University.> ;
    dcterms:subject <http://example.org/education/concept/ANOVA>,
        <http://example.org/education/concept/Chi-Quadrat-Test>,
        <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Forschungsmethoden>,
        <http://example.org/education/concept/Signifikanzniveau>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Stichproben>,
        <http://example.org/education/concept/Varianzanalyse>,
        <http://example.org/education/concept/Verteilungstheorie>,
        <http://example.org/education/concept/Wahrscheinlichkeit> ;
    dcterms:title "Statistik und Quantitative Methoden BA Riesa Maria Neubauer 07.05.2021 Creative Commons: Attribution-NonComercial CC BY-NC"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

