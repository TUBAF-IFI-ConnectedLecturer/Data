oer:12XwfU4ADW4SU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Beckmann>,
        <http://example.org/education/person/Hacker> ;
    dcterms:description "Die Diskussion um die Ausgewogenheit von Bibliotheksbeständen dreht sich darum, wie eine neutrale Auswahl an Medien und Informationen gewährleistet werden kann, ohne bestimmte Meinungen oder Gruppen zu bevorzugen. Durch die Berücksichtigung unterschiedlicher Zielgruppen und Anforderungsprofile können Bibliotheken einen ausgewogenen Bestand aufbauen, der den Informationsbedarf ihrer Nutzer abdeckt. Die Lektüre dieser Diskussion hilft Bibliothekaren, ihre Entscheidungen bei der Medienauswahl zu reflektieren und eine offene und inklusive Informationsinfrastruktur zu schaffen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "12XwfU4ADW4SU" ;
    dcterms:publisher <http://example.org/education/organization/FH_Potsdam> ;
    dcterms:subject <http://example.org/education/concept/Benutzerorientierung>,
        <http://example.org/education/concept/Bibliotheksbestand>,
        <http://example.org/education/concept/Bibliothekskatalogisierung>,
        <http://example.org/education/concept/Fehlinformationen>,
        <http://example.org/education/concept/Informationskompetenz>,
        <http://example.org/education/concept/Medienkritik>,
        <http://example.org/education/concept/Neutralit%C3%A4t>,
        <http://example.org/education/concept/Pluralismus>,
        <http://example.org/education/concept/akademischer_Status>,
        <http://example.org/education/concept/politische_Meinungsbildung> ;
    dcterms:title "Die Rolle der Ausgewogenheit und Neutralität in der bibliographischen Erschliessung"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:12YkZHOiVXDao a edu:LearningResource ;
    sim:similarTo oer:3S9Tob6bgVMM,
        oer:3kcnKgnSAtpk ;
    dcterms:creator <http://example.org/education/person/H%C3%B6rrmann>,
        <http://example.org/education/person/Kessler> ;
    dcterms:description "Das Protokoll beschreibt die Durchführung von vier Aufgaben im Rahmen eines Hardwarepraktikums, bei dem Arduino-Boards und verschiedene Schnittstellen wie RS-232 und DMX verwendet werden. Die Aufgaben umfassen die Übertragung von Signalen, die Verwendung von Logicanalysatoren und die Programmierung von Codes für die Steuerung von Lichtquellen. Durch das Durcharbeiten dieser Aufgaben können Lernende Kenntnisse über die Verwendung von Mikrocontrollern, Schnittstellen und Signalübertragungstechniken erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12YkZHOiVXDao" ;
    dcterms:subject <http://example.org/education/concept/Arduino>,
        <http://example.org/education/concept/Baudrate>,
        <http://example.org/education/concept/Computerprogramm>,
        <http://example.org/education/concept/DMX>,
        <http://example.org/education/concept/Hardwarepraktikum>,
        <http://example.org/education/concept/Logikanalyse>,
        <http://example.org/education/concept/Mikrocontroller>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/RS-232>,
        <http://example.org/education/concept/Signal%C3%BCbertragung> ;
    dcterms:title "Protokoll zum zweiten Hardwarepraktikum"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:12hULUKsEvV38 a edu:LearningResource ;
    sim:similarTo oer:12o5A0JjSpXCg,
        oer:12oEdShL2n9x4,
        oer:12sVIiJmju3b0,
        oer:4SPhWRyLrOzk ;
    dcterms:creator <http://example.org/education/person/Knodel> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Digitalen Logik und Schaltwerke, einschließlich der Analyse und Synthese von Schaltfunktionen, FlipFlops und Automaten. Durch das Studium dieser Materialien können Lernende die Fähigkeit erwerben, komplexe digitale Schaltungen zu entwerfen und zu analysieren. Die Vorlesung umfasst 53 Folien mit Beispielen, Aufgaben und Erklärungen zu verschiedenen Themen der Digitalen Logik und Schaltwerke."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12hULUKsEvV38" ;
    dcterms:subject <http://example.org/education/concept/Analyse_von_Schaltwerken>,
        <http://example.org/education/concept/Automatentheorie>,
        <http://example.org/education/concept/Boolesche_Algebra>,
