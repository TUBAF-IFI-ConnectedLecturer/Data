    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die Fertigungsplanung in der additiven Fertigung behandelt die systematische Vorbereitung und Organisation von Fertigungsprozessen, um Bauteile mit Hilfe von Additive-Fertigungsverfahren herzustellen. Durch das Verständnis der Prozesskette und der verfahrensspezifischen Merkmale können Lernende die Planung und Optimierung von additiven Fertigungsprozessen erfolgreich durchführen. Die Vorlesung bietet einen Überblick über die Struktur des Additive-Fertigungsprozesses, die Schritte zur Planung und die verfahrensspezifischen Merkmale, um die Fertigungsaufgabe zu lösen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6AlsyfwmhwfM" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Computer-Aided_Design_%28CAD%29>,
        <http://example.org/education/concept/Fertigungsplanung>,
        <http://example.org/education/concept/Fertigungstechnik>,
        <http://example.org/education/concept/Konstruktionstechnik>,
        <http://example.org/education/concept/Produktentstehungsprozess>,
        <http://example.org/education/concept/Prozesskette>,
        <http://example.org/education/concept/Rapid_Prototyping>,
        <http://example.org/education/concept/Werkstoffwissenschaft> ;
    dcterms:title "Fertigungsplanung in der Additiven Fertigung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

