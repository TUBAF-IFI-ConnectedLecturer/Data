oer:12TxFC7yCnkSU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kauk>,
        <http://example.org/education/person/Lorius> ;
    dcterms:description "Dieses Tutorial behandelt das Thema Fake News und ermöglicht Schülern, Kriterien zur Überprüfung von Nachrichtenseiten auf Seriosität zu erlernen und psychologische Voreingenommenheiten und Effekte zu erkennen, die das Glauben von Fake News begünstigen. Durch die Bearbeitung des Tutorials erhalten Schüler Einblick in Algorithmen zum Erkennen von Fake News, Verbreitungsdynamiken und Möglichkeiten zur Bildbearbeitung und -manipulation. Ziel ist es, Schülern zu helfen, Fake News zu erkennen und kritisch mit Medien umzugehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12TxFC7yCnkSU" ;
    dcterms:subject <http://example.org/education/concept/Bildbearbeitung>,
        <http://example.org/education/concept/Deep_Fake>,
        <http://example.org/education/concept/Desinformation>,
        <http://example.org/education/concept/F%C3%A4lschungsinformationen>,
        <http://example.org/education/concept/Fakes_News>,
        <http://example.org/education/concept/Informationskompetenz>,
        <http://example.org/education/concept/Journalismus>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Medienkritik>,
        <http://example.org/education/concept/Propaganda> ;
    dcterms:title "Handreichung für Lehrer:innen H5P-App Fake News auf apps.zum.de von Sabine Lorius und Lioba Kauk (Stand 10.08.2021)"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:12WSk2jwrmVC0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Debus>,
        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übungsaufgaben behandeln die stetigen Verteilungen, insbesondere die Exponentialverteilung, und ihre Anwendung auf Zuverlässigkeitsprobleme. Durch das Lösen der Aufgaben können Studierende ihr Verständnis von stetigen Zufallsgrößen und ihrer Parameter wie Erwartungswert und Varianz verbessern. Außerdem werden sie erfahren, wie sie Zuverlässigkeitsanalysen für Systeme und Geräte durchführen können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12WSk2jwrmVC0" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
