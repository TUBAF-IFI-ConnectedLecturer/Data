        <http://example.org/education/concept/Fachdidaktik>,
        <http://example.org/education/concept/Naturwissenschaftliche_Grundbildung>,
        <http://example.org/education/concept/Organisationsebenen>,
        <http://example.org/education/concept/Schulb%C3%BCcher>,
        <http://example.org/education/concept/Scientific_Literacy> ;
    dcterms:title "Einführung in die Biologiedidaktik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:11lyyit5iZdUs a edu:LearningResource ;
    sim:similarTo oer:11xIw0lBYI3sE,
