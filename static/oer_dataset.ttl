        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mengentheorie>,
        <http://example.org/education/concept/Quantoren>,
        <http://example.org/education/concept/Teilmengenbeziehungen>,
        <http://example.org/education/concept/Zahlentheorie>,
        <http://example.org/education/concept/nat%C3%BCrliche_Zahlen>,
        <http://example.org/education/concept/reelle_Zahlen> ;
    dcterms:title "Übungsblatt 2 Mathematik - Winter 2024-25"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

