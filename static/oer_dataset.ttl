        oer:9GnNlFIpzfmI,
        oer:9VxTJ5Pz1B-A,
        oer:9zjgA65FSAmg ;
    dcterms:description "Die Grundlagen des GIS umfassen die Verarbeitung und Analyse von Raster- und Vektor-Daten, einschließlich der Bildsegmentierung, Kantendetektion und Filtermethoden. Durch das Studium dieser Konzepte können Lernende die Fähigkeit erwerben, komplexe raumbezogene Probleme zu lösen und GIS-Anwendungen in verschiedenen Bereichen wie Umwelt, Stadtplanung und Fernerkundung einzusetzen. Die vorgestellten Methoden und Techniken ermöglichen es, aus Daten wertvolle Informationen abzuleiten und diese für die Entscheidungsfindung zu nutzen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5SoRfIZU_QL8" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/%C3%84hnlichkeitssegmentierung>,
        <http://example.org/education/concept/Bildverarbeitung>,
        <http://example.org/education/concept/Fernerkundung>,
        <http://example.org/education/concept/Filtermethoden>,
        <http://example.org/education/concept/GIS>,
        <http://example.org/education/concept/Geoinformatik>,
        <http://example.org/education/concept/Kantendetektion>,
        <http://example.org/education/concept/Kartographie>,
        <http://example.org/education/concept/Rasterdaten>,
        <http://example.org/education/concept/Raumbezugssysteme> ;
    dcterms:title "Grundlagen GIS  TU Bergakademie Freiberg"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:7b7KMN0NpLGg a edu:LearningResource ;
    sim:similarTo oer:7j01GgGvMEiE,
        oer:8E349pg5D4i4,
        oer:8UFrV25s8QGU,
        oer:8ZXC3ues4hiI,
        oer:8koB23KAn9TA,
