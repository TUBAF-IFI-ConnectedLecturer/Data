        <http://example.org/education/concept/Olympiapark>,
        <http://example.org/education/concept/Reisen>,
        <http://example.org/education/concept/Selbstportr%C3%A4t>,
        <http://example.org/education/concept/Tourismus> ;
    dcterms:title "Portfolio Teil 2 (max. 20 Punkte)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:11TzKOf3zc2UU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Torver> ;
    dcterms:description "Die Aufgabenstellung behandelt die Berechnung von Anteilen in Masse-Prozent für eine Sieblinie AB32 und vergleicht diese mit der Grenzsieblinie. Der Zweck dieser Übung ist die Anerkennung des Belegs im Fach Baustofflehre als Voraussetzung für die Prüfungszulassung. Durch die Bearbeitung dieser Aufgabe erwerben die Lernenden Kenntnisse über die Gesteinskörnung und die Anwendung von Sieblinien in der Baustofflehre."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11TzKOf3zc2UU" ;
    dcterms:subject <http://example.org/education/concept/Bauingenieurwesen>,
        <http://example.org/education/concept/Baustofflehre>,
        <http://example.org/education/concept/Baustoffpr%C3%BCfung>,
        <http://example.org/education/concept/Gesteinsk%C3%B6rnung>,
        <http://example.org/education/concept/Granulometrie>,
        <http://example.org/education/concept/Korngr%C3%B6%C3%9Fenverteilung>,
        <http://example.org/education/concept/Lehrgebiet>,
        <http://example.org/education/concept/Siebanalyse>,
        <http://example.org/education/concept/Studiengang>,
        <http://example.org/education/concept/Wintersemester> ;
    dcterms:title "Anerkennung des Beleges ist eine Voraussetzung für die Prüfungszulassung im Fach Baustofflehre."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:11VrOUVe2yWV8 a edu:LearningResource ;
    dcterms:description "Mit Hilfe von Steckwürfeln können Kinder eigene Rechenstrategien entwickeln und mathematische Grundideen wie Zahlenräume, Dezimalsystem und Zahlzerlegung erlernen. Durch den Einsatz dieser Lehrmittel werden Fähigkeiten wie logisches Denken, räumliches Vorstellungsvermögen und Feinmotorik gefördert. Ziel ist es, Kinder zu befähigen, mathematische Operationen wie Addition, Subtraktion, Division und Multiplikation durchzuführen und eigene Lösungswege zu finden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11VrOUVe2yWV8" ;
    dcterms:subject <http://example.org/education/concept/Dezimalsystem>,
        <http://example.org/education/concept/Grundschulp%C3%A4dagogik>,
        <http://example.org/education/concept/Kindergartenp%C3%A4dagogik>,
        <http://example.org/education/concept/Lehrmittel>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Mathematische_Bildung>,
        <http://example.org/education/concept/Mathematische_Grundidee>,
        <http://example.org/education/concept/P%C3%A4dagogik>,
        <http://example.org/education/concept/Rechenoperationen>,
        <http://example.org/education/concept/Zahlbegriff> ;
    dcterms:title "Steckwürfel Beschreibung"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:11YwJYjIpTcyw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Flegr>,
        <http://example.org/education/person/Meier> ;
    dcterms:description "Diese Seminarsitzung behandelt die Verwendung von Simulationen im naturwissenschaftlichen Unterricht und präsentiert ihre Vorteile, wie zum Beispiel die Vereinfachung von Experimenten, die Möglichkeit sehr genauer Messungen und die Förderung motorischer Fähigkeiten. Durch die Teilnahme an dieser Seminarsitzung können Lehrende und Lernende Erfahrungen mit Simulationsexperimenten sammeln und erfahren, wie sie diese in ihrem Unterricht einsetzen können. Die vorgestellten Beispiele und Angebote für Simulationsexperimente unterstützen die Entwicklung von Lehr- und Lernmaterialien für den naturwissenschaftlichen Unterricht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11YwJYjIpTcyw" ;
    dcterms:subject <http://example.org/education/concept/Biologie>,
        <http://example.org/education/concept/Chemie>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Experiment>,
        <http://example.org/education/concept/Fachdidaktik>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Naturwissenschaften>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Simulation>,
        <http://example.org/education/concept/Unterricht> ;
    dcterms:title "Übung Einführung in die Fachdidaktik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

