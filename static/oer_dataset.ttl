oer:1Xjd0hs1bOxE a edu:LearningResource ;
    sim:similarTo oer:1yFnYVkqvY1U,
        oer:8u_gWwR60SoM ;
    dcterms:creator <http://example.org/education/person/Beurskens> ;
    dcterms:description "Die Präsentation behandelt die rechtlichen und technischen Aspekte von e-Assessment, insbesondere bei der Durchführung von Multiple-Choice-Prüfungen an Hochschulen. Sie informiert über die Anforderungen an Prüfungsordnungen, Datenschutz und Barrierefreiheit sowie die Gefahren von Täuschung, Manipulation und technischen Störungen. Durch das Studium dieser Materialien können Lehrende und Prüfungsvorbereiter die rechtlichen und technischen Voraussetzungen für sichere und faire elektronische Prüfungen schaffen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1Xjd0hs1bOxE" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_No_Explicit_Mentions_Of_a_University_Or_Institution_Name._However__There_Are_Some_Hints_That_Suggest_The_Author_Might_Be_Affiliated_With_a_German-speaking_Institution%3A%2A_The_Text_Contains_German_Words_And_Phrases__Such_As_%22pr%C3%BCfungsordnung%22_And_%22datenschutz%22.%2A_The_Formatting_And_Structure_Of_The_Document_Resemble_Those_Commonly_Used_In_German_Academic_Institutions.despite_These_Hints__I_Couldn%27t_Find_Any_Explicit_Mention_Of_An_Institution_Name._Therefore__I_Will_Return_An_Empty_String.> ;
    dcterms:subject <http://example.org/education/concept/Behindertenrecht>,
        <http://example.org/education/concept/Berufsbildung>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/E-Assessment>,
