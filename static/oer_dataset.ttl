oer:12N2MRJF1cwCM a edu:LearningResource ;
    sim:similarTo oer:12QEMMDNkbsTs,
        oer:12kLaNxQ-JOmQ,
        oer:3JO0XkvZhyas,
        oer:3_FzhZ2V5xlI,
