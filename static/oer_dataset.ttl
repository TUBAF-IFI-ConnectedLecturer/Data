oer:80mSGccZruI8 a edu:LearningResource ;
    sim:similarTo oer:8EVQufcxbKck,
        oer:8Vy--T0Sbb2I,
        oer:8dwfrj5jonVw,
        oer:8dzGidlZSGTA,
        oer:9T-qFy0rnpPE ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung behandelt die Raumlufttechnik und Reinraumtechnik im Kontext der Prozessindustrie und diskutiert verschiedene Konzepte wie turbulente und laminare Strömungen, natürliche Konvektion und Schichtenströmung. Durch das Studium dieser Inhalte können Lernende die Grundlagen für die Planung und den Betrieb von Reinräumen und Raumluftsystemen verstehen und anwenden. Zudem werden sie in die Lage versetzt, die Anforderungen an die Luftreinheit und -zirkulation in verschiedenen Industrien zu beurteilen und geeignete Lösungen zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "80mSGccZruI8" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Filtertechnik>,
        <http://example.org/education/concept/Geb%C3%A4udetechnik>,
        <http://example.org/education/concept/Klimatisierung>,
        <http://example.org/education/concept/Konvektion>,
        <http://example.org/education/concept/Luftreinhaltung>,
        <http://example.org/education/concept/Luftstr%C3%B6mung>,
        <http://example.org/education/concept/Raumlufttechnik>,
        <http://example.org/education/concept/Reinraumtechnik>,
        <http://example.org/education/concept/Str%C3%B6mungslehre>,
        <http://example.org/education/concept/Turbulenz> ;
    dcterms:title "Fakultät für Maschinenbau und Verkehrswesen Institut für Fluid- und Thermodynamik Vorlesung Reinraumtechnik - Grundlagen und Anwendungen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

