        <http://example.org/education/concept/Gamification>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Lernprozess>,
        <http://example.org/education/concept/Spieldesign>,
        <http://example.org/education/concept/Spieldidaktik>,
        <http://example.org/education/concept/Unterrichtsmethoden> ;
    dcterms:title "Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:6yDSN_Ht5Wo4 a edu:LearningResource ;
    sim:similarTo oer:7NWNUT6XPgXA,
        oer:8OTiIMWePGR4,
        oer:8lRUmC4DaToE ;
    dcterms:creator <http://example.org/education/person/Rohrbach> ;
    dcterms:description "Die Arbeit beschäftigt sich mit der automatisierten Erstellung mathematischer Übungsaufgaben durch den Einsatz von Large Language Models und evaluiert die Qualität dieser Aufgaben mittels einer Taxonomie. Durch die Anwendung von Prompt Engineering können die Modelle auf bestimmte Aufgabentypen und -komplexe eingestellt werden, um eine Vielzahl an Aufgaben zu generieren. Die Ergebnisse zeigen, dass die maschinelle Evaluation der Aufgaben mit der menschlichen Wahrnehmung übereinstimmt und somit ein großes Potenzial für die Anwendung in der Bildung bietet."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6yDSN_Ht5Wo4" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik__Wirtschaft_und_Kultur_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Artificial_Intelligence>,
        <http://example.org/education/concept/Automatisierte_Erstellung>,
        <http://example.org/education/concept/E-Assessment_Items>,
        <http://example.org/education/concept/Evaluation_von_Aufgaben>,
        <http://example.org/education/concept/Kognitive_Prozessdimension>,
        <http://example.org/education/concept/Large_Language_Models>,
        <http://example.org/education/concept/Machine_Learning>,
        <http://example.org/education/concept/Mathematische_%C3%9Cbungsaufgaben>,
        <http://example.org/education/concept/Taxonomie>,
        <http://example.org/education/concept/Wissensdimension> ;
    dcterms:title "Einsatz von Large Language Models zur automatisierten Erstellung mathematischer Übungsaufgaben"@de ;
    dcterms:type <http://example.org/education/type/Bachelor-Kolloquium> .

