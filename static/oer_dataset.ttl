        <http://example.org/education/concept/Fahrzeugbegrenzungslinie>,
        <http://example.org/education/concept/H%C3%B6heneinschr%C3%A4nkung>,
        <http://example.org/education/concept/Lichtraumberechnung>,
        <http://example.org/education/concept/Neigetechnik>,
        <http://example.org/education/concept/Querverschiebung>,
        <http://example.org/education/concept/Schienenfahrzeug>,
        <http://example.org/education/concept/Stromabnehmer> ;
    dcterms:title "Grundlagen Sft: 5. Einschränkungsberechnung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9bo-jic3k6pY a edu:LearningResource ;
    sim:similarTo oer:9cOjlSsSnjVw ;
    dcterms:creator <http://example.org/education/person/Breiger>,
        <http://example.org/education/person/K%C3%B6hler>,
        <http://example.org/education/person/St%C3%BCtzer> ;
    dcterms:description "Die Vorlesung behandelt die Anwendungen der Bildungstechnologie und ihre Versprechungen und Herausforderungen für Schule und Lehrerbildung. Sie präsentiert sieben Trends in der Bildungstechnologie, darunter BYOD, Offenheit, User-Generated Content, Unabhängiges Lernerverhalten, Sozialisation in neuen Gemeinschaften, Datasation der Bildung und Augmentation durch VR. Durch die Auseinandersetzung mit diesen Trends können Lehrende und Lernende neue Möglichkeiten für das Lernen und Lehren erkennen und ihre Praxis anpassen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9bo-jic3k6pY" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bildungsanalytik>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Computerunterst%C3%BCtztes_Kollaboratives_Lernen>,
        <http://example.org/education/concept/Digitale_Medien_in_der_Bildung>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Fernunterricht>,
        <http://example.org/education/concept/Lernen_mit_Multimedia>,
        <http://example.org/education/concept/Offene_Bildungsressourcen>,
        <http://example.org/education/concept/Soziale_Netzwerke>,
        <http://example.org/education/concept/Virtuelle_Lernumgebung> ;
    dcterms:title "TU Dresden, 03.11.2019 VL Bildungstechnologie II: Anwendungen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

