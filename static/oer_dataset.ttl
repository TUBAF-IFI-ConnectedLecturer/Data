    dcterms:creator <http://example.org/education/person/Fr%C3%B6bel> ;
    dcterms:description "Das digitale Lernszenario ermöglicht es Schülerinnen und Schülern, ihre Kenntnisse zur Abfrage von Queries mithilfe relationaler Algebra zu erweitern und auf die Datenbanksprache SQL zu übertragen. Durch die Bearbeitung von Aufgaben und Übungen auf einer Website können sie ihre Fähigkeiten im Bereich der Datenbankabfragen verbessern und individuelle Vorgehensweisen zur problemorientierten Modellierung entwickeln. Am Ende des Lernszenarios sollen die Schülerinnen und Schüler in der Lage sein, komplexe Datenbankabfragen zu erstellen und ihre Lernfortschritte selbstkritisch zu reflektieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6wEnW_xwgbrU" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Didaktik_der_Informatik>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Fachdidaktik>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/SQL>,
        <http://example.org/education/concept/Unterrichtsmethoden>,
        <http://example.org/education/concept/Website-basiertes_Lernen>,
        <http://example.org/education/concept/relationale_Algebra> ;
    dcterms:title "Entwurf eines digitalen Lernszenariums"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

