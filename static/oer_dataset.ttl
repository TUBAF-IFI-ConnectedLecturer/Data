oer:10QReC0UP4bik a edu:LearningResource ;
    sim:similarTo oer:10XYMbNPEjD6I ;
    dcterms:creator <http://example.org/education/person/H%C3%B6rrmann>,
        <http://example.org/education/person/Schwarz> ;
    dcterms:description "Die Übung im Modul Modellierung behandelt die Aufgabe, zu zeigen, dass für je zwei beliebige Formeln ω und ε AL(P) genau dann ω ε gilt, wenn die Formel ω ε allgemeingültig ist. Durch das Lösen dieser Aufgabe erwerben die Lernenden Kenntnisse über die Gültigkeit von Formeln in der Modellierung. Die Lösung dieser Übungsaufgabe hilft bei der Vertiefung des Verständnisses für die Modellierung und ihre Anwendung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10QReC0UP4bik" ;
    dcterms:publisher <http://example.org/education/organization/HTWK_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Algebraische_Strukturen>,
        <http://example.org/education/concept/Aussagenlogik>,
        <http://example.org/education/concept/Formalsemantik>,
        <http://example.org/education/concept/G%C3%BCltigkeit>,
        <http://example.org/education/concept/Logik>,
        <http://example.org/education/concept/Modellierung>,
        <http://example.org/education/concept/Modelltheorie>,
        <http://example.org/education/concept/Pr%C3%A4dikatenlogik>,
        <http://example.org/education/concept/formale_Systeme>,
        <http://example.org/education/concept/mathematische_Beweise> ;
    dcterms:title "4. Übung im Modul Modellierung Wintersemester 2024/25"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

