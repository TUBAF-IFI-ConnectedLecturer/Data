        <http://example.org/education/concept/Konstruktionstechnik>,
        <http://example.org/education/concept/Technische_Zeichnung>,
        <http://example.org/education/concept/Volumenmodell> ;
    dcterms:title "Einführung in die computergestützte Konstruktion"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:5NzD5yQMyBUQ a edu:LearningResource ;
    dcterms:description "Das Programm berechnet die Oberfläche und das Volumen eines geraden Kreiskegels anhand der eingegebenen Werte für Radius und Höhe. Die Formeln zur Berechnung werden angegeben und die Ausgabe erfolgt in einer übersichtlichen Form. Durch die Verwendung dieses Programms können Lernende die Anwendung mathematischer Formeln auf ein praktisches Problem erlernen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5NzD5yQMyBUQ" ;
    dcterms:subject <http://example.org/education/concept/Berechnung>,
        <http://example.org/education/concept/C-Programm>,
