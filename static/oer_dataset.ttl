    dcterms:title "Text Audioproduktion"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:6aj2cyrF8Ox0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Rudolph> ;
    dcterms:description "Die Lehrveranstaltung behandelt die Grundlagen der Benetzung und ihre Anwendungen, insbesondere im Bereich der Enhanced Oil Recovery mit Surfactanten. Die Studierenden erwerben Kenntnisse über die physikalischen Eigenschaften von Grenzflächen und lernen, diese für die Optimierung von Prozessen in der Ressourcentechnologie einzusetzen. Durch die Vorlesung werden die Teilnehmer in die Lage versetzt, komplexe Phänomene an Grenzflächen zu verstehen und innovative Lösungen für die Ressourcenextraktion zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6aj2cyrF8Ox0" ;
    dcterms:publisher <http://example.org/education/organization/Helmholtz-Institute_Freiberg_for_Resource_Technology> ;
    dcterms:subject <http://example.org/education/concept/Adh%C3%A4sion>,
        <http://example.org/education/concept/Benetzung>,
        <http://example.org/education/concept/Erd%C3%B6l>,
        <http://example.org/education/concept/Erd%C3%B6lf%C3%B6rderung>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenaktive_Substanzen>,
        <http://example.org/education/concept/Koh%C3%A4sion>,
        <http://example.org/education/concept/Oberfl%C3%A4chentechnik>,
        <http://example.org/education/concept/Partikel-Fluid-Wechselwirkungen>,
        <http://example.org/education/concept/Ressourcentechnologie>,
        <http://example.org/education/concept/Tenside> ;
    dcterms:title "Inhalt der Lehrveranstaltung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6apKHvhHjP7Y a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Jacobshagen>,
        <http://example.org/education/person/Semmer> ;
    dcterms:description "Die Wertschätzung am Arbeitsplatz hat eine hohe Bedeutung für Gesundheit, Zufriedenheit und Motivation, da sie ein vertrauensvolles Klima fördert und Stress durch Selbstwertbedrohung mildern kann. Illegitime Aufgaben, die als unzumutbar oder sinnlos erlebt werden, können bei Mitarbeitern Stress auslösen und negative Gefühle gegenüber der Firma hervorrufen. Durch Wertschätzung und Anerkennung im Unternehmen kann die Selbstwertbedrohung reduziert und die Gesundheit, Zufriedenheit und Motivation der Mitarbeiter verbessert werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6apKHvhHjP7Y" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Bern> ;
    dcterms:subject <http://example.org/education/concept/Arbeitspsychologie>,
        <http://example.org/education/concept/Arbeitszufriedenheit>,
        <http://example.org/education/concept/Burnout>,
        <http://example.org/education/concept/Gesundheit>,
        <http://example.org/education/concept/Motivation>,
        <http://example.org/education/concept/Occupational_Health_Psychology>,
        <http://example.org/education/concept/Selbstwert>,
        <http://example.org/education/concept/Stressforschung>,
        <http://example.org/education/concept/Wertsch%C3%A4tzung_am_Arbeitsplatz>,
        <http://example.org/education/concept/Zufriedenheit> ;
    dcterms:title "Arbeit und (mangelnde) Wertschätzung"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

oer:6dnQc9wmOMsw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Philipp> ;
    dcterms:description "Das Modul Projektmanagement im Software-Engineering vermittelt wertvolles Wissen und praktische Fähigkeiten, die für das Studium und die berufliche Laufbahn von Nutzen sind. Durch die Vermittlung von Techniken wie Risikomanagement, Kommunikation und Teamführung, Entwurfsprinzipien und Qualitätssicherung werden die Lernenden in die Lage versetzt, Projekte effektiver zu planen und durchzuführen. Die neuen Kenntnisse und Fähigkeiten fügen sich nahtlos in das bestehende Wissen aus den Bereichen Informatik und Wirtschaftswissenschaften ein."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6dnQc9wmOMsw" ;
    dcterms:subject <http://example.org/education/concept/Entwurfsprinzipien>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Kommunikationstechniken>,
        <http://example.org/education/concept/Projektmanagement>,
        <http://example.org/education/concept/Qualit%C3%A4tssicherung>,
        <http://example.org/education/concept/Risikomanagement>,
        <http://example.org/education/concept/Schnittstellenbeschreibung>,
        <http://example.org/education/concept/Software-Engineering>,
        <http://example.org/education/concept/Teamf%C3%BChrung>,
        <http://example.org/education/concept/Wirtschaftswissenschaften> ;
    dcterms:title "Reflexion zum Modul Projektmanagement im Software-Engineering"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:6fSlYCQBHNyI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Bo> ;
    dcterms:description "Die Montagebeschreibung beschreibt die Schritte zur Montage einer Antriebswelle und eines Getriebes, einschließlich der Installation von Lagern, Zahnrädern und Sicherungselementen. Durch das Folgen dieser Anleitung können Lerner die notwendigen Fähigkeiten erwerben, um eine funktionierende Antriebswelle zu erstellen. Die Montagebeschreibung enthält detaillierte Anweisungen und Bilder, um den Lernprozess zu unterstützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6fSlYCQBHNyI" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Fertigungstechnik>,
        <http://example.org/education/concept/Getriebe>,
        <http://example.org/education/concept/Konstruktionstechnik>,
        <http://example.org/education/concept/Lagerung>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Montage>,
        <http://example.org/education/concept/Schmierung>,
        <http://example.org/education/concept/Werkzeugmaschine>,
        <http://example.org/education/concept/Zahnr%C3%A4der> ;
    dcterms:title "Montagebeschreibung"@de ;
    dcterms:type <http://example.org/education/type/Montagebeschreibung> .

