        <http://example.org/education/concept/Wissenschaftliches_Arbeiten> ;
    dcterms:title "Orientierungshilfe zur Gestaltung von Abschlussarbeiten (WHZ, Fachgruppe Informatik)"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:5A0TJgla3QJw a edu:LearningResource ;
    sim:similarTo oer:5YMUR3d80O6Y,
