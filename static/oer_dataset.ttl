        <http://example.org/education/concept/Medientechnik>,
        <http://example.org/education/concept/Schneidplotterfunktion>,
        <http://example.org/education/concept/Solvent-Inkjet> ;
    dcterms:title "Modul I121 Digitaldruck DIGI1 Solvent Inkjet"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

