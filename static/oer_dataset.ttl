    dcterms:creator <http://example.org/education/person/Robitzki> ;
    dcterms:description "Die Unterrichtsstunde behandelt das Thema \"Was geht beim Stimmzettel? Und was nicht?\" und soll die Lernenden über den Ablauf der Bundestagswahl informieren und ihre demokratischen Kompetenzen stärken. Durch die Interaktion mit dem Lehrer und den Mitschülern sollen die Lernenden ein besseres Verständnis davon erlangen, wie die Wahl funktioniert und welche Bedeutung sie für die Demokratie hat. Am Ende der Stunde sollen die Lernenden in der Lage sein, ihre Kenntnisse über die Bundestagswahl zu vertiefen und ihre Meinungen zu bilden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8EUTaDBs5bWw" ;
    dcterms:subject <http://example.org/education/concept/Berufskolleg>,
        <http://example.org/education/concept/Bundestagswahl>,
        <http://example.org/education/concept/Demokratie>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Partizipation>,
        <http://example.org/education/concept/Politische_Bildung>,
        <http://example.org/education/concept/Schulkultur>,
        <http://example.org/education/concept/Stimmabgabe>,
        <http://example.org/education/concept/Wahlrecht> ;
    dcterms:title "Hospitationsbericht über die Praktikumsschule"@de ;
    dcterms:type <http://example.org/education/type/Hospitationsbericht> .

oer:9M-bnCCAV7AA a edu:LearningResource ;
    sim:similarTo oer:9NVzInLrHnLw,
