        <http://example.org/education/concept/Kartesische_Darstellung>,
        <http://example.org/education/concept/Komplexe_Zahlen>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Polardarstellung>,
        <http://example.org/education/concept/Trigonometrie>,
        <http://example.org/education/concept/Winkelfunktionen>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Mathematik 1 - WS2022/23 Übungsblatt 5"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:96KYDYTG2uu0 a edu:LearningResource ;
    sim:similarTo oer:9GYE_fdB8Ec8,
        oer:9ysxFnUUqULY ;
    dcterms:creator <http://example.org/education/person/Lin%C3%9F> ;
    dcterms:description "Dieses Informatikprojekt behandelt die Erstellung eines digitalen Berichts mit mehreren Kapiteln, bei dem der Inhalt vom Design getrennt wird, um eine übersichtliche und leicht aktualisierbare Gestaltung zu ermöglichen. Durch die Bearbeitung dieser Aufgaben lernen Schülerinnen und Schüler, wie sie ein Datenmodell für eine Schulbibliothek erstellen, ein Automatisches Inhaltsverzeichnis erzeugen und Umfrageergebnisse darstellen und interpretieren können. Zudem werden sie mit wichtigen Konzepten der Informatik wie Klassen, Objekten und Methoden vertraut gemacht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "96KYDYTG2uu0" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t_Leipzig> ;
    dcterms:subject <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Dokumentation>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Klassen_und_Objekte>,
        <http://example.org/education/concept/Methoden_und_Attribute>,
        <http://example.org/education/concept/Objektorientierung>,
        <http://example.org/education/concept/Textverarbeitung>,
        <http://example.org/education/concept/Umfrageergebnisse>,
        <http://example.org/education/concept/Webbasierte_Anwendungen> ;
    dcterms:title "Mündliche Abschlussprüfung Fach Informatik - Klasse 10"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

