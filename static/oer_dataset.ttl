    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs für Ingenieure behandelt die Lösung von Differentialgleichungen und linearen Gleichungssystemen, indem es verschiedene Aufgaben und Beispiele anbietet, um die Fähigkeiten der Studierenden in diesem Bereich zu verbessern. Durch das Bearbeiten dieser Aufgaben können die Lerner ihre Kenntnisse über die Lösung von Differentialgleichungen und linearen Gleichungssystemen erweitern und ihre Fähigkeit zur Anwendung mathematischer Konzepte auf reale Probleme verbessern. Die Übungsaufgaben decken ein breites Spektrum an Themen ab, darunter die Lösung von homogenen und inhomogenen Differentialgleichungen, die Berechnung von Eigenwerten und -vektoren sowie die Anwendung von Verfahren wie dem Streckenzugverfahren nach Euler."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "73V_zpnDsjpQ" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Anfangswertprobleme>,
        <http://example.org/education/concept/Bewegungsgleichungen>,
        <http://example.org/education/concept/D%C3%A4mpfung>,
        <http://example.org/education/concept/Differentialgleichungen>,
        <http://example.org/education/concept/Eigenwerte_und_Eigenvektoren>,
        <http://example.org/education/concept/Federkonstanten>,
        <http://example.org/education/concept/Mathematik_f%C3%BCr_Ingenieure>,
        <http://example.org/education/concept/Numerische_Analysis>,
        <http://example.org/education/concept/Schwingungsgleichungen>,
        <http://example.org/education/concept/lineare_Algebra> ;
    dcterms:title "Mathematik für Ingenieure - WS2023/24 Übungsblatt 9"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

