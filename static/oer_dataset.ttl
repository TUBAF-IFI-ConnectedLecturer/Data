oer:11v5k9wXFX97E a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/B%C3%B6hme>,
        <http://example.org/education/person/Gro%C3%9F>,
        <http://example.org/education/person/Weck> ;
    dcterms:description "Das Interview mit Bon Courage e.V. behandelt die Themen Soziale Ungleichheit, Migrationsgesellschaft und Rassismus, indem es die Erfahrungen von Geflüchteten und Ehrenamtlichen schildert. Durch die Reflexionen und Auswertungen werden die Herausforderungen und Bedürfnisse von Menschen mit Migrationshintergrund verdeutlicht."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "11v5k9wXFX97E" ;
    dcterms:subject <http://example.org/education/concept/Beratung>,
        <http://example.org/education/concept/Diskriminierung>,
        <http://example.org/education/concept/Ehrenamt>,
