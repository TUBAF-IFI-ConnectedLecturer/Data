    dcterms:creator <http://example.org/education/person/Fricke>,
        <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Stephan> ;
    dcterms:description "Die Vorlesung \"Triebfahrzeugtechnik\" behandelt die Antriebskonfigurationen von Dieseltriebfahrzeugen und umfasst die Elemente mechanischer Leistungsübertragungseinrichtungen, wie Schaltkupplungen, Gelenkwellen und Radsätze. Die Auslegung mechanischer Getriebe nach geometrischer Reihe oder konstanter Progression wird erläutert, einschließlich der Berechnung von Übersetzungen und Wirkungsgraden. Durch das Studium dieser Vorlesung können Lernende die Funktionsweise und die Auslegung von Antriebskonfigurationen in Dieseltriebfahrzeugen verstehen und anwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3ikLwq86AfKo" ;
    dcterms:subject <http://example.org/education/concept/Antriebskonfigurationen>,
        <http://example.org/education/concept/Eisenbahnfahrzeuge>,
        <http://example.org/education/concept/Fahrzeugantriebe>,
        <http://example.org/education/concept/Gelenkwellen>,
        <http://example.org/education/concept/Hydromechanische_Getriebe>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Mechanische_Getriebe>,
        <http://example.org/education/concept/Radsatzgetriebe>,
        <http://example.org/education/concept/Schaltgetriebe>,
        <http://example.org/education/concept/Triebfahrzeugtechnik> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

