oer:8jUB5wrc_qf8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Beyer>,
        <http://example.org/education/person/Gerhold> ;
    dcterms:description "Die Übung behandelt die Anwendung von Filteralgorithmen und morphologischen Operatoren mittels GNUOctave zur Extraktion von Bildobjekten. Durch die Bearbeitung dieser Übung erwerben die Lernenden Kenntnisse über die Verwendung von Histogrammen, Schwellwertfiltern und Dilatationen zur Bildverarbeitung. Zudem lernen sie, wie sie morphologische Operationen anwenden können, um bestimmte Bildmerkmale zu extrahieren und zu analysieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8jUB5wrc_qf8" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Bilddatenanalyse>,
        <http://example.org/education/concept/Bildsegmentierung>,
        <http://example.org/education/concept/Bildverarbeitung>,
        <http://example.org/education/concept/Filteralgorithmen>,
        <http://example.org/education/concept/Grauwertebilder>,
