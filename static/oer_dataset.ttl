oer:3sHbAdwM2LZY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Neugebauer>,
        <http://example.org/education/person/Ringel> ;
    dcterms:description "Das Praktikum 8 zum Programmieren 2 behandelt die Lösung eines Programmierproblems unter Benutzung von Klassen aus der Java-Klassenbibliothek und festigt die Programmierkenntnisse. Die Aufgabe besteht darin, ein Java-Programm zu schreiben, das in der Lage ist, eine Textdatei eines digitalen Tagebuches einzulesen und ins Markdown-Format umzuwandeln. Durch die Bearbeitung dieser Aufgabe erwerben die Lernenden Kenntnisse über die Verwendung von Container-Klassen, String-Klassen, regulären Ausdrücken und Datum- und Zeit-Klassen in Java."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3sHbAdwM2LZY" ;
    dcterms:publisher <http://example.org/education/organization/HTW_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Datenformat>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Java>,
        <http://example.org/education/concept/Klassenbibliothek>,
        <http://example.org/education/concept/Markdown>,
        <http://example.org/education/concept/Programmierproblem>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Tagebuch>,
        <http://example.org/education/concept/Textdatei> ;
    dcterms:title "Praktikum 8 - Programmieren 2"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3sXnyBlUTEKE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Wagner> ;
    dcterms:description "Das Exposé beschreibt ein Projekt zum Entwickeln eines Clients für die selbst wiederherstellende Verbindung zu Kafka-Clustern, um die Telekom bei der Datenübertragung von Partnerfirmen wie Huawei, Ciena und Nokia zu unterstützen. Ziel ist es, eine stabile Lösung zu finden, um Informationen von Apache-Kafka-Clustern bereitzustellen. Durch das Projekt soll ein Programm entwickelt werden, das sich automatisiert mit einem vom Nutzer bestimmten Kafka-Cluster verbinden kann."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3sXnyBlUTEKE" ;
    dcterms:subject <http://example.org/education/concept/Apache_Kafka>,
        <http://example.org/education/concept/Daten%C3%BCbertragung>,
        <http://example.org/education/concept/Datenbankauslesen>,
        <http://example.org/education/concept/Echtzeitmessungen>,
        <http://example.org/education/concept/Message-Broker>,
        <http://example.org/education/concept/Programmierung_%28Python%29>,
        <http://example.org/education/concept/Service-%C3%9Cberwachung>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Verbindungs%C3%BCberwachung>,
        <http://example.org/education/concept/Wiederverbindung> ;
    dcterms:title "Exposé Projekt"@de ;
    dcterms:type <http://example.org/education/type/Expos%C3%A9> .

oer:3t-rOZhblk5c a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Rajabi> ;
    dcterms:description "Der Vergleich von Kaffeezubereitungsmethoden mittels elektrischer Filterkaffeemaschine und Handfilterung zeigt Unterschiede in der Temperaturentwicklung während des Brühvorgangs, was Auswirkungen auf den Geschmack und die Qualität des Endprodukts haben kann. Durch die Analyse von Prozessmessungen und Diagrammen können Lernende Erkenntnisse über die Physik der Kaffeezubereitung gewinnen und verstehen, wie kleine Veränderungen im Prozess große Auswirkungen auf das Endprodukt haben können. Dieses Wissen kann dazu beitragen, den Genuss einer perfekten Tasse Kaffee zu verbessern und die Zubereitung von Kaffee zu optimieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3t-rOZhblk5c" ;
    dcterms:subject <http://example.org/education/concept/Br%C3%BChvorgang>,
        <http://example.org/education/concept/Fl%C3%BCssigkeitsstr%C3%B6mung>,
        <http://example.org/education/concept/Getr%C3%A4nketechnologie>,
        <http://example.org/education/concept/Handfilter>,
        <http://example.org/education/concept/Kaffeemaschine>,
        <http://example.org/education/concept/Kaffeezubereitung>,
        <http://example.org/education/concept/Koffein>,
        <http://example.org/education/concept/Lebensmittelverarbeitung>,
        <http://example.org/education/concept/Temperaturmessung>,
        <http://example.org/education/concept/W%C3%A4rme%C3%BCbertragung> ;
    dcterms:title "Protokoll : Messtechnische Erfassung eines Kaffee-Brühvorgangs"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

