        oer:9fXhxbAr8iOM ;
    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs für Ingenieure enthält sieben Aufgaben, die sich mit gewöhnlichen und partiellen Differentialgleichungen befassen. Die Aufgaben umfassen das Erkennen von Differentialgleichungen, das Skizzieren von Richtungsfeldern und Isoklinenschar, sowie die Lösung von Differentialgleichungen unter bestimmten Anfangsbedingungen. Durch das Bearbeiten dieser Aufgaben können Studierende ihre Fähigkeiten im Umgang mit Differentialgleichungen verbessern und ein tieferes Verständnis der mathematischen Konzepte entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9M-bnCCAV7AA" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Differentialgleichungen>,
        <http://example.org/education/concept/Differentialrechnung>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Gew%C3%B6hnliche_Differentialgleichungen>,
        <http://example.org/education/concept/Ingenieurmathematik>,
        <http://example.org/education/concept/Kurvendiskussion.>,
        <http://example.org/education/concept/Mathematik_f%C3%BCr_Ingenieure>,
        <http://example.org/education/concept/Mathematische_Physik>,
        <http://example.org/education/concept/Partielle_Differentialgleichungen> ;
    dcterms:title "Mathematik für Ingenieure - WS2023/24 Übungsblatt 5"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

