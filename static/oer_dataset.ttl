        <http://example.org/education/concept/Wirtschaftsmathematik>,
        <http://example.org/education/concept/akademische_Literatur>,
        <http://example.org/education/concept/lineare_Programmierung>,
        <http://example.org/education/concept/mathematische_Modellierung> ;
    dcterms:title "Lineare Optimierung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

