oer:129pUbtvTeNok a edu:LearningResource ;
    sim:similarTo oer:12JUsn082yQVc,
        oer:8DIYsTEB-vPQ,
        oer:8gBRggtzBxs8 ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Kolloidchemischen Grundlagen der Nanotechnologie werden in diesem Seminar erläutert, wobei die Wechselwirkungen zwischen Partikeln und Elektrolyten sowie die Stabilität von Suspensionen im Mittelpunkt stehen. Durch das Verständnis dieser Prozesse können Learner die Eigenschaften von Nanopartikeln und ihre Anwendungen in verschiedenen Industrien besser verstehen. Die Inhalte umfassen unter anderem die Zetapotenziale, die Elektrochemische Doppelschicht, Flockung und Sedimentation sowie die Stabilität von Suspensionen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "129pUbtvTeNok" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Elektrolyte>,
        <http://example.org/education/concept/Flockung>,
        <http://example.org/education/concept/Kolloidales_Aluminiumoxid>,
        <http://example.org/education/concept/Kolloidchemie>,
        <http://example.org/education/concept/Nanotechnologie>,
