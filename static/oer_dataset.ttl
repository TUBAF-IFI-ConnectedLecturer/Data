        <http://example.org/education/concept/W%C3%A4rmekapazit%C3%A4t>,
        <http://example.org/education/concept/Zustands%C3%A4nderung> ;
    dcterms:title "Thermodynamik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

