        <http://example.org/education/concept/Stabilit%C3%A4t>,
        <http://example.org/education/concept/Suspension>,
        <http://example.org/education/concept/Zetapotenzial> ;
    dcterms:title "Kolloidchemische Grundlagen der Nanotechnologie I"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

