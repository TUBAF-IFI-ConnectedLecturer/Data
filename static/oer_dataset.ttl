    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Henschel>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs WS2022/23 an der Hochschule für Technik und Wirtschaft Dresden enthält sieben Aufgaben zu verschiedenen Themen wie Grenzwerten, Funktionen und Gleichungen. Durch die Bearbeitung dieser Aufgaben können Lernende ihre Fähigkeiten in der Anwendung von mathematischen Konzepten und Verfahren wie der Regel von l'Hospital und dem Newton-Verfahren verbessern. Die Lösungen zu diesen Aufgaben helfen dabei, das Verständnis für komplexe mathematische Zusammenhänge zu vertiefen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10pW3bPlzqiBk" ;
