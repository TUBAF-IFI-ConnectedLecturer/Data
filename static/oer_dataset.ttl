        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Latch>,
        <http://example.org/education/concept/Logikgatter>,
        <http://example.org/education/concept/Schaltungstechnik>,
        <http://example.org/education/concept/Signalverarbeitung> ;
    dcterms:title "Praktikumsbericht 3.1"@de ;
    dcterms:type <http://example.org/education/type/Praktikumsbericht> .

oer:7XFczUkwMZp0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Schulz> ;
    dcterms:description "Diese Vorlesung behandelt die grundlegenden Begriffe und Definitionen von Abbildungen in der Mathematik, einschließlich surjektiver und injektiver Abbildungen. Durch das Studium dieser Materialien können Lernende ein Verständnis dafür entwickeln, wie Abbildungen definiert und klassifiziert werden. Sie lernen außerdem, die verschiedenen Arten von Abbildungen zu unterscheiden und ihre Eigenschaften zu beschreiben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7XFczUkwMZp0" ;
    dcterms:subject <http://example.org/education/concept/Abbildungen>,
        <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Funktionsgraph>,
