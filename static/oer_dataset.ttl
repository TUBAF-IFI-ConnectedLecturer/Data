        <http://example.org/education/concept/Selbstlernpr%C3%A4sentation>,
        <http://example.org/education/concept/Unterrichtsmaterial>,
        <http://example.org/education/concept/Wissenschaftliche_Grundlagen> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

