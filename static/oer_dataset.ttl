        <http://example.org/education/concept/Stra%C3%9Fennetz>,
        <http://example.org/education/concept/Transportproblem>,
        <http://example.org/education/concept/Trinkwasser>,
        <http://example.org/education/concept/Wasserversorgung> ;
    dcterms:title "Optimierung für Mathematikerinnen Übung 8"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

