        <http://example.org/education/concept/Rasterdaten>,
        <http://example.org/education/concept/Spatial-Analyse> ;
    dcterms:title "Übung Grundlagen GIS Interpolation von Punktdaten auf ein Raster"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

