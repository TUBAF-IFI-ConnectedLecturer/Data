    dcterms:title "Ganzzahlen und Speicherorganisation"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:55vxQdMqHgrg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Leo> ;
    dcterms:description "Die Europawahlen werden von nationalen Politiken beeinflusst, wobei die Hypothese des less-at-stake-Arguments bestätigt wird, dass Wählende bei Europawahlen weniger auf dem Spiel sehen als bei nationalen Wahlen. Kleinstparteien haben größere Chancen bei Europawahlen als bei Bundestagswahlen und eine Absenkung der Sperrklausel würde langfristig mehr Auftreib geben. Die Analyse der Wahlergebnisse zeigt, dass liberale und rechte Parteien Stimmen gewinnen, während Volksparteien verlieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "55vxQdMqHgrg" ;
    dcterms:subject <http://example.org/education/concept/Europ%C3%A4ische_Integration>,
        <http://example.org/education/concept/Europawahlen>,
        <http://example.org/education/concept/Parlamentswahlen>,
        <http://example.org/education/concept/Parteien>,
        <http://example.org/education/concept/Politik>,
        <http://example.org/education/concept/Wahlen>,
        <http://example.org/education/concept/Wahlsysteme>,
        <http://example.org/education/concept/Wahlverhalten>,
        <http://example.org/education/concept/politische_Mehrheiten>,
        <http://example.org/education/concept/supranationale_Organisationen> ;
    dcterms:title "(Empty string)"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

