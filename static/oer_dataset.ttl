    dcterms:title "OLAT GRUPPENMANAGEMENT"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:15noRrtY1C09k a edu:LearningResource ;
    sim:similarTo oer:3Qkan0C5F_0k ;
    dcterms:creator <http://example.org/education/person/Khaydarov> ;
    dcterms:description "Die Dynamische Optimierung ist ein Verfahren zur Lösung komplexer Optimierungsprobleme durch Zerlegung in einfache Teilprobleme, wobei sich eine optimale Lösung aus optimalen Lösungen von Teilproblemen zusammensetzen lässt. Durch Anwendung des Bellman-Prinzips können sequentielle Entscheidungsprozesse zeitlich und räumlich über verschiedene Ebenen eines Systems gelöst werden. Die Learner erhalten ein Verständnis der Dynamischen Optimierung als Methode zur Lösung von Optimierungsproblemen in verschiedenen Anwendungsbereichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "15noRrtY1C09k" ;
    dcterms:subject <http://example.org/education/concept/Bellman-Rekursion>,
        <http://example.org/education/concept/Bibliographische_Katalogisierung>,
        <http://example.org/education/concept/Entscheidungsprozesse>,
        <http://example.org/education/concept/Mehrdimensionale_Optimierung>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Systemverfahrenstechnik>,
        <http://example.org/education/concept/Zeitlich-R%C3%A4umliche_Optimierung>,
        <http://example.org/education/concept/Zielfunktion>,
        <http://example.org/education/concept/dynamische_Optimierung>,
        <http://example.org/education/concept/sequentielle_Entscheidungen> ;
    dcterms:title "Mehrdimensionale Optimierung - Dynamische Optimierung PLTSVT"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:16MIIaD2q9X6M a edu:LearningResource ;
    sim:similarTo oer:16Zw35k4WT5pU,
        oer:45NPtqbbzK78,
