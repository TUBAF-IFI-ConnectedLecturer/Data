        oer:9FBJbcDEGkbA,
        oer:9VxTJ5Pz1B-A,
        oer:9zjgA65FSAmg ;
    dcterms:creator <http://example.org/education/person/Gerhards> ;
    dcterms:description "Die Grundlagen des GIS umfassen die Vermaschung von Punkten zu Dreiecken, wobei die Delaunay-Triangulation eine wichtige Methode darstellt, um winkel-maximale Dreiecke zu erstellen. Durch die Berücksichtigung von Zusatzinformationen wie bekannten Höhenlinien oder Linien, die Störungen repräsentieren, kann eine Constrained Delaunay-Triangulation durchgeführt werden, um bestimmte Anforderungen zu erfüllen. Durch das Verständnis dieser Konzepte können Lerner die Grundlagen der Triangulation in GIS-Anwendungen verstehen und anwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3wnkfl7XzxUk" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
