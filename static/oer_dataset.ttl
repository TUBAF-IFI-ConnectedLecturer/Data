        <http://example.org/education/concept/Strukturmechanik>,
        <http://example.org/education/concept/Werkstoffpr%C3%BCfung> ;
    dcterms:title "Übung Berechnung eines Gelenkträgers mittels FEM TW II Ü3 (FEM)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6qTRxR7ekYug a edu:LearningResource ;
