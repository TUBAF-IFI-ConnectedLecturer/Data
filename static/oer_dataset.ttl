        <http://example.org/education/concept/Hochschulbau>,
        <http://example.org/education/concept/Innenarchitektur>,
        <http://example.org/education/concept/Raumplanung>,
        <http://example.org/education/concept/St%C3%A4dtebau>,
        <http://example.org/education/concept/Universit%C3%A4tsgeb%C3%A4ude> ;
    dcterms:title "GSEducationalVersion TU Dresden Fakultät Architektur Lehrstuhl für Industriebauten Sommersemester 2020 Wissenszentrum Designers Hub für die TU Dresden"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

