        <http://example.org/education/concept/Wasserundurchl%C3%A4ssigkeit>,
        <http://example.org/education/concept/Windlast> ;
    dcterms:title "Gebäudehülle und Abdichtung gegen Feuchtigkeit"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:62GQ1bnk-R8w a edu:LearningResource ;
    sim:similarTo oer:66TBksMaAAd8,
        oer:6tvEmcC9ag7w,
        oer:6yydLqK1GMGk,
        oer:8NmRAO8MWzGs,
        oer:9h5DzkjuA7nQ ;
    dcterms:creator <http://example.org/education/person/Arthur_Knospe> ;
    dcterms:description "Kara ist ein Lernwerkzeug, mit dem man spielerisch und anschaulich die Grundlagen des Programmierens lernen kann, indem man einen programmierbaren Marienkäfer durch eine 2-dimensionale Welt bewegt. Durch das Erstellen von Zuständen und Zustandsübergängen kann man Kara anweisen, bestimmte Aktionen auszuführen, wie zum Beispiel Kleeblätter aufzuheben oder umherzuschieben. Durch die Bearbeitung von Aufgaben und dem Experimentieren mit verschiedenen Programmierungen kann man die Fähigkeiten des Programmierens erlernen und verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "62GQ1bnk-R8w" ;
    dcterms:subject <http://example.org/education/concept/Automaten>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Lernwerkzeug>,
        <http://example.org/education/concept/Programmiersprache>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Robotik>,
        <http://example.org/education/concept/Sensoren>,
        <http://example.org/education/concept/Weltmodell>,
        <http://example.org/education/concept/Zustands%C3%BCberg%C3%A4nge> ;
    dcterms:title "Kara Arthur Knospe 1"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:66TBksMaAAd8 a edu:LearningResource ;
    sim:similarTo oer:6tvEmcC9ag7w,
