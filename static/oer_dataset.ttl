    dcterms:creator <http://example.org/education/person/Carter>,
        <http://example.org/education/person/Johnson>,
        <http://example.org/education/person/Lee> ;
    dcterms:description "Die Geschichte der Computerentwicklung wird von den Anfängen mit Herman Holleriths Lochkarten-Zählmaschinen bis hin zu den ersten Personal Computern und Spielkonsolen wie Pong und Atari beschrieben. Der Text behandelt die wichtigen Meilensteine, Erfindungen und Personen, die zum heutigen Stand der Computer- und Spielindustrie beigetragen haben. Durch das Lesen dieses Textes können Lerner einen Überblick über die Entwicklung der Computertechnologie und ihre Auswirkungen auf die Gesellschaft gewinnen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "17Agtk_pdd86A" ;
    dcterms:subject <http://example.org/education/concept/Computerentwicklung>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Geschichte_der_Informatik>,
