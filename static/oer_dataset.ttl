    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von spurgeführten Fahrzeugen wird durch die elektrische Leistungsübertragung beeinflusst, die Vorteile wie beste Ausnutzung des Dieselmotors und flexible Anordnung der Aggregate bietet. Die verschiedenen Arten der Leistungsübertragung, wie mechanisch, hydraulisch, elektrisch und hydrodynamisch, werden vorgestellt und ihre Charakterisierung diskutiert. Durch das Studium dieser Materialien können Lernende die Grundlagen der Fahrdynamik und die Vorteile der elektrischen Leistungsübertragung in spurgeführten Fahrzeugen verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3R96oODuQ4qg" ;
    dcterms:subject <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Dieselmotor>,
        <http://example.org/education/concept/Elektrische_Antriebe>,
        <http://example.org/education/concept/Elektromobilit%C3%A4t>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Energiespeicher>,
        <http://example.org/education/concept/Fahrzeugdynamik>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Schienenfahrzeugtechnik>,
        <http://example.org/education/concept/Zugkraftregelung> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

