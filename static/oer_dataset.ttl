    dcterms:creator <http://example.org/education/person/Hacker> ;
    dcterms:description "Die untere und obere Grenze bei der Erwerbung von Medien für eine Bibliothek beziehen sich auf die Definition des Segments des Medienmarkts, das komplett ausgeschlossen werden soll, um die Arbeit der Bibliothek vernünftig zu machen. Durch die Festlegung dieser Grenzen kann die Bibliothek ihre Medienauswahl auf bestimmte Formate oder Inhalte beschränken und sich auf die Bedürfnisse ihrer Nutzerinnen konzentrieren. Durch die Analyse des Angebots auf dem Markt, der genutzten Medien und des Nutzerinnenprofils können Bibliotheken ihre Erwerbungspolitik anpassen und eine mediale Ausgewogenheit erreichen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "1246CkGsNNnMM" ;
    dcterms:publisher <http://example.org/education/organization/I_Apologize__But_The_Provided_Text_Does_Not_Seem_To_Be_Related_To_a_Document_Named_%221246ckgsnnnmm.docx%22._The_Text_Appears_To_Be_a_Discussion_About_Bibliographic_Cataloging_And_Indexing__With_Mentions_Of_Media_Formats__Libraries__And_User_Statistics._There_Is_No_Mention_Of_a_Specific_Institution_Or_University.if_You_Meant_To_Provide_The_Actual_Content_Of_The_Document_%221246ckgsnnnmm.docx%22__I%27d_Be_Happy_To_Help_You_Search_For_Hints_On_The_Author%27s_Institutional_Affiliation.> ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentliche_Bibliothek>,
        <http://example.org/education/concept/Bestandsmanagement>,
        <http://example.org/education/concept/Bibliothek>,
        <http://example.org/education/concept/Erwerbungspolitik>,
        <http://example.org/education/concept/Indexierung>,
        <http://example.org/education/concept/Informationskompetenz>,
        <http://example.org/education/concept/Katalogisierung>,
        <http://example.org/education/concept/Medienauswahl>,
        <http://example.org/education/concept/Mediennutzung>,
        <http://example.org/education/concept/Non-Print-Medien> ;
    dcterms:title "Die untere und obere Grenze in der Erwerbung von Medien für Öffentliche Bibliotheken"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

