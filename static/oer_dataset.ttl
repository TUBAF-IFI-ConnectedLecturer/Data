oer:8xhUOf1cL058 a edu:LearningResource ;
    sim:similarTo oer:91IFvQJnDRfE ;
    dcterms:creator <http://example.org/education/person/Mark> ;
    dcterms:description "Diese Übungsaufgaben zum Robot Karol ermöglichen es Lernenden, Programmierfähigkeiten zu erwerben und Algorithmen zu entwickeln, um den Roboter bestimmte Aufgaben ausführen zu lassen. Durch die Lösung der verschiedenen Teilaufgaben können Lernende ihre Fähigkeiten in der Programmierung von Robot Karol verbessern und komplexere Aufgaben lösen. Die Übungsaufgaben decken Themen wie Rekursion, Kontrollstrukturen und die Implementierung von Algorithmen ab."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8xhUOf1cL058" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Algorithmische_Geometrie>,
        <http://example.org/education/concept/Aufgabenl%C3%B6sung>,
        <http://example.org/education/concept/Computergrafik>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Robotik>,
        <http://example.org/education/concept/Simulation>,
        <http://example.org/education/concept/Weltmodellierung> ;
    dcterms:title "Robot Karol: Übungsaufgaben"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:91IFvQJnDRfE a edu:LearningResource ;
    sim:similarTo oer:9_c_sVX8ipXc ;
    dcterms:creator <http://example.org/education/person/Mark> ;
    dcterms:description "Robot Karol ist ein didaktisches Werkzeug zum spielerischen Einstieg in die Algorithmierung und Implementierung, das einfache Befehle und kurze Ausdrücke für Anweisungen bietet. Durch die Verwendung von Robot Karol können Lernende grundlegende Konzepte der Informatik wie Kontrollstrukturen, Bedingungen und selbstimplementierte Anweisungen erlernen. Die Software ermöglicht es, Programmcode zu erstellen und visuell darzustellen, um den Einstieg in die Programmierung zu erleichtern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "91IFvQJnDRfE" ;
    dcterms:subject <http://example.org/education/concept/Algorithmik>,
        <http://example.org/education/concept/Algorithmisches_Denken>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Didaktisches_Werkzeug>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Kontrollstrukturen>,
        <http://example.org/education/concept/Lehrplan>,
        <http://example.org/education/concept/Programmiersprache>,
        <http://example.org/education/concept/Robotik>,
        <http://example.org/education/concept/visuelle_Programmierung> ;
    dcterms:title "Vorstellung Robot Karol"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9I8FnA5ufCwI a edu:LearningResource ;
    sim:similarTo oer:9uBCLdWfR1h0 ;
    dcterms:creator <http://example.org/education/person/Erdtel>,
        <http://example.org/education/person/Meydan> ;
    dcterms:description "Die Organisierte Kriminalität wird definiert als planmäßige Begehung von Straftaten durch mehrere Beteiligte, die zur Einflussnahme auf Politik, Medien und Wirtschaft zusammenwirken. Die verschiedenen Typen krimineller Strukturen, wie Rockergruppierungen, italienische Mafiagruppierungen und Clankriminalität, werden vorgestellt und ihre Hauptaktivitäten beschrieben. Durch das Studium dieser Materialien können Lerner ein Verständnis der Organisierten Kriminalität und ihrer Auswirkungen auf die Gesellschaft entwickeln."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9I8FnA5ufCwI" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Cybercrime>,
        <http://example.org/education/concept/Drogenhandel>,
        <http://example.org/education/concept/Geldw%C3%A4sche>,
        <http://example.org/education/concept/Korruption>,
        <http://example.org/education/concept/Kriminalit%C3%A4tsbek%C3%A4mpfung>,
        <http://example.org/education/concept/Menschenhandel>,
        <http://example.org/education/concept/Organisierte_Kriminalit%C3%A4t>,
        <http://example.org/education/concept/Strafverfolgung>,
        <http://example.org/education/concept/Transnationale_organisierte_Kriminalit%C3%A4t>,
        <http://example.org/education/concept/Waffenhandel> ;
    dcterms:title "Fehlende Interventionsmacht des Staats Aktuelles Bundeslagebild zur Organisierten Kriminalität 2019 Ergebnis"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:9UG_zGt5uEvg a edu:LearningResource ;
    sim:similarTo oer:9pSrGXmMyg5o ;
    dcterms:creator <http://example.org/education/person/Stieler> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Anwendungen der Physik im Bereich der Photovoltaik und ermöglicht es Lernenden, sich mit den Grundlagen der Solarstrahlung, den technischen Aspekten von PV-Anlagen und ihrer gesellschaftlichen Einordnung auseinanderzusetzen. Durch die Bearbeitung dieser Inhalte können Schülerinnen und Schüler ihre Kenntnisse über erneuerbare Energien erweitern und lernen, wie sie sich im Alltag auf die Energieversorgung auswirken. Zudem werden sie befähigt, Handlungsoptionen für den Einsatz von PV-Anlagen zu entwickeln und diese in ihrem eigenen Umfeld anzuwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9UG_zGt5uEvg" ;
    dcterms:subject <http://example.org/education/concept/Energiewirtschaft>,
        <http://example.org/education/concept/Erneuerbare_Energie>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Nachhaltige_Entwicklung>,
        <http://example.org/education/concept/Photovoltaik>,
        <http://example.org/education/concept/Physikalische_Grundlagen>,
        <http://example.org/education/concept/Solarenergie>,
        <http://example.org/education/concept/Stromerzeugung>,
        <http://example.org/education/concept/Technische_Aspekte>,
        <http://example.org/education/concept/Umweltbildung> ;
    dcterms:title "Photovoltaik Tom Stieler Anwendungen der Physik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

