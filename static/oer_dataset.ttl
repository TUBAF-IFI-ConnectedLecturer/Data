        oer:3POA6uYgOrMo,
        oer:3RZ9RyhqG1W4,
        oer:7zPH7AxkHE-A ;
    dcterms:creator <http://example.org/education/person/Heckmann> ;
    dcterms:description "Diese mündliche Abiturprüfung im Grundkurs Informatik behandelt das Thema Kryptographie und umfasst zwei Aufgaben, die die Funktionsweise von symmetrischen und asymmetrischen Verschlüsselungsverfahren sowie das Kerckhoffs-Prinzip thematisieren. Durch die Bearbeitung dieser Aufgaben sollen die Lernenden ihr Verständnis von kryptographischen Verfahren und ihrer Anwendung in der Praxis verbessern. Insbesondere werden sie lernen, die Vor- und Nachteile von symmetrischen und asymmetrischen Verschlüsselungsverfahren zu beschreiben und das Kerckhoffs-Prinzip zu begründen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10lmDIqgrz-6E" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Asymmetrische_Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Hybride_Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Kerckhoffs-Prinzip>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Kryptologie>,
        <http://example.org/education/concept/Sicherheit>,
        <http://example.org/education/concept/Symmetrische_Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Verschl%C3%BCsselungsverfahren> ;
    dcterms:title "Prüfungsaufgaben Kryptographie"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

