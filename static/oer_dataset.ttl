    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:12Cem6G7IX-Bg a edu:LearningResource ;
    dcterms:description "Dieses Dokument behandelt die Implementierung einer rekursiven Funktion in Python, um die Summe einer Liste von Zahlen zu berechnen. Durch das Verständnis des Basisfalls und des rekursiven Falls können Lerner eine funktionierende Lösung entwickeln und die Vorteile der Rekursion erkennen. Am Ende des Dokuments können Lerner eine iterative Lösung mit einer deklarativen Schleife implementieren und die Funktion sum in Python benutzen, um die Summe einer Liste zu berechnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12Cem6G7IX-Bg" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Listen>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Python>,
        <http://example.org/education/concept/Rekursion>,
        <http://example.org/education/concept/Zahlen> ;
    dcterms:title "Keine Angst vor dem Code Basisfall und rekursiven Fall in Pythoncode umsetzen."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:12DC40pTyAYZQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Uhlig> ;
    dcterms:description "Die Präsentation behandelt die Eigenschaften von Geraden, insbesondere ihre Beziehungen zueinander wie Schnittpunkte, Orthogonalität und Parallelität. Durch das Studium dieser Inhalte können Lernende die grundlegenden Konzepte der Geometrie verstehen und anwenden. Die Präsentation bietet eine Übersicht über die verschiedenen Arten von Geradenbeziehungen mit Beispielen und Erläuterungen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
