oer:9_jXdv3Jgh_Q a edu:LearningResource ;
    sim:similarTo oer:9dqmS-Q2Bhzc,
        oer:9fXhxbAr8iOM,
        oer:9fZ2aiBlvsr8 ;
    dcterms:creator <http://example.org/education/person/Bertrand>,
        <http://example.org/education/person/Bombach>,
        <http://example.org/education/person/Riemer> ;
    dcterms:description "Diese Übung behandelt Extremwertaufgaben und lokale Extrema von Funktionen in zwei Variablen, wobei die Lösungen mittels partieller Ableitungen und der Hesse-Matrix bestimmt werden. Durch das Lösen dieser Aufgaben erwerben die Lernenden Fähigkeiten im Bereich der mathematischen Optimierung und Analyse von Funktionen. Die Übung umfasst insgesamt acht Aufgaben, die sich mit verschiedenen Aspekten der Extremwertanalyse beschäftigen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9_jXdv3Jgh_Q" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Blechdosenherstellung>,
        <http://example.org/education/concept/Extremwertaufgaben>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Hesse-Matrix>,
        <http://example.org/education/concept/Lokale_Extrema>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Numerische_Mathematik>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Partielle_Ableitung> ;
    dcterms:title "TU Chemnitz  Professur Numerische Mathematik 4. Dezember 2023 Prof. Dr. Fleurianne Bertrand C. Bombach, T.-C. Riemer, Dr. M. Winkler Mathematik III (für IF, ET, Ph) Wintersemester 202324 5. Übung: Extremwertaufgaben (Lösungen)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

