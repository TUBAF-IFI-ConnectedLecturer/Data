    dcterms:creator <http://example.org/education/person/Fricke>,
        <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Stephan> ;
    dcterms:description "Die Vorlesung \"Triebfahrzeugtechnik (Antriebskonfigurationen)\" behandelt die Grundlagen der Fahrzeugleittechnik, einschließlich ihrer Bestandteile, Anforderungen und Standards. Durch das Studium dieser Materialien können Lernende ein Verständnis dafür entwickeln, wie die Leittechnik in Triebfahrzeugen funktioniert und welche Rolle sie bei der Steuerung und Überwachung von Fahrzeugsystemen spielt. Insbesondere werden Fallbeispiele wie die BR 642 und der ICE 3 vorgestellt, um die Anwendung der Leittechnik in der Praxis zu veranschaulichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8wYXWTpig_qE" ;
    dcterms:subject <http://example.org/education/concept/Antriebskonfigurationen>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Eisenbahnwesen>,
