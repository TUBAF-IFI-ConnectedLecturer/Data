oer:4lfeiBfqAgqw a edu:LearningResource ;
    sim:similarTo oer:5pahFvxuA2NA,
        oer:6FQvI6cjASfk,
        oer:6GcXf46ynNGw,
        oer:86txCjR7ScoA,
