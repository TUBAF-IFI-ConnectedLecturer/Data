        oer:9BDND88Y2yQA,
        oer:9J4jFKGi5NT8,
        oer:9_uF1SOzsZso ;
    dcterms:description "Die Lösung beschreibt die Bestimmung der dritten Wurzeln einer komplexen Zahl mittels trigonometrischer und exponentieller Form. Durch die Berechnung von Betrag und Argument wird die komplexe Zahl in ihre trigonometrische und exponentielle Form überführt, um dann die drei Lösungen für z zu bestimmen. Die Skizze verdeutlicht die Lage der Wurzeln auf einem Kreis um den Ursprung mit dem Radius 2, wobei ein regelmäßiges Dreieck entsteht."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7jCaN9avlweU" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Exponentialfunktionen>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Gleichungen>,
        <http://example.org/education/concept/Komplexe_Analysis>,
        <http://example.org/education/concept/Komplexe_Zahlen>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Trigonometrie>,
        <http://example.org/education/concept/Wurzeln>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Keine Titelinformation gefunden."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

