    dcterms:title "Paukst du noch oder lernst du schon?!"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:61m04PDltEYM a edu:LearningResource ;
    sim:similarTo oer:6gEFYWCNHeqI ;
    dcterms:creator <http://example.org/education/person/Arnold> ;
    dcterms:description "Die kritische Interaktionssituation \"Italienischer Kalenderchaos\" beschreibt ein Missverständnis zwischen einem deutschen Geschäftsführer und italienischen Kunden bezüglich der Nutzung eines Kalenders für Terminvereinbarungen. Durch die Analyse dieser Situation können Lernende Einsichten in kulturelle Unterschiede und ihre Auswirkungen auf soziale Interaktionen gewinnen. Die Situation dient als Beispiel für die Anwendung von Kulturstandards nach Alexander Thomas, um kulturelle Überschneidungssituationen zu verstehen und zu erklären."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "61m04PDltEYM" ;
    dcterms:subject <http://example.org/education/concept/Deutschland>,
        <http://example.org/education/concept/Gesch%C3%A4ftsf%C3%BChrung>,
        <http://example.org/education/concept/Interaktion>,
        <http://example.org/education/concept/Italien>,
        <http://example.org/education/concept/Kalender>,
        <http://example.org/education/concept/Kommunikation>,
        <http://example.org/education/concept/Kultur>,
        <http://example.org/education/concept/Kulturspezifit%C3%A4t>,
        <http://example.org/education/concept/Kundenverhalten>,
        <http://example.org/education/concept/Sozialisation> ;
    dcterms:title "Kulturstandards in Aktion"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

