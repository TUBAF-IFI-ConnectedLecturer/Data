        <http://example.org/education/concept/Trainingswissenschaft>,
        <http://example.org/education/concept/Werfen>,
        <http://example.org/education/concept/Wurftechniken> ;
    dcterms:title "Selbstlernpräsentation zu den Biomechanischen Ansichten des Wurfes"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

