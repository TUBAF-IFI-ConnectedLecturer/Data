oer:15gjJeUwewB5Q a edu:LearningResource ;
    sim:similarTo oer:15gqAru7ohgCU,
        oer:15oFpybZIoAek ;
    dcterms:creator <http://example.org/education/person/Borcherding> ;
    dcterms:description "Die integrative Verhandlungsführung behandelt mehrere Themen und erweitert damit den Verhandlungsspielraum, um eine Win-Win-Situation für beide Verhandlungspartner zu ermöglichen. Durch die Anwendung von Taktiken wie der Fokus auf Interessen, Optionenkreieren und Bridging-Lösungen können Verhandlungspartner einen größtmöglichen Gewinn mit dem geringstmöglichen Verlust erzielen. Dieses Seminarmaterial vermittelt Studierenden Kenntnisse über die integrative Verhandlungsführung und ihre Anwendung in der Konfliktlösung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "15gjJeUwewB5Q" ;
    dcterms:publisher <http://example.org/education/organization/HEG_Freiburg> ;
    dcterms:subject <http://example.org/education/concept/Distributive_Verhandlung>,
        <http://example.org/education/concept/Integrative_Verhandlung>,
        <http://example.org/education/concept/Interkulturelle_Kommunikation>,
        <http://example.org/education/concept/Kommunikation>,
        <http://example.org/education/concept/Konfliktl%C3%B6sung>,
        <http://example.org/education/concept/Negotiation_Strategies>,
        <http://example.org/education/concept/Sozialpsychologie>,
        <http://example.org/education/concept/Verhandlungsf%C3%BChrung>,
        <http://example.org/education/concept/Verhandlungstheorie>,
        <http://example.org/education/concept/Win-Win-Verhandlung> ;
    dcterms:title "Seminar: Verhandlungsführung und Konfliktlösung"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:15sR8PfXHEAuI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/de_Folieto> ;
    dcterms:description "Die Kraniche dienen als Vorbild für die Mönche, indem sie aufmerksam und wachsam sind, um ihre Gefährten zu schützen. Durch ihr Verhalten können die Mönche lernen, wie sie ihre eigenen Gedanken und Affekte kontrollieren sollten, um auf dem rechten Weg zu bleiben. Der Text veranschaulicht, dass Christus als der Fels des Geistes dient, der den Menschen auf seinem Weg begleitet."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "15sR8PfXHEAuI" ;
    dcterms:subject <http://example.org/education/concept/Affekt>,
