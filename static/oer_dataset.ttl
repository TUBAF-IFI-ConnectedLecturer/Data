    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die additive Fertigungstechnik wird als Zukunftstechnologie vorgestellt, die eine Vielzahl von Anwendungsbereichen in der Industrie und im täglichen Leben bietet. Durch diese Technologie können komplexe Bauteile ohne Werkzeug hergestellt werden, was zu einer Reduzierung von Kosten und Zeit führt. Die Lernenden erhalten einen Überblick über die Geschichte, Entwicklung und Anwendungsgebiete der additiven Fertigungstechnik sowie ihre Zukunftsvisionen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7j-aYl1qIEjI" ;
    dcterms:publisher <http://example.org/education/organization/Henning.zeidler%40imkf.tu-freiberg.de_%E2%86%92_Technische_Universit%C3%A4t_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Fertigungstechnik>,
