        oer:5gOgS_SEhd9g ;
    dcterms:creator <http://example.org/education/person/Allhoff>,
        <http://example.org/education/person/Bilinski> ;
    dcterms:description "Dieses Lehr- und Übungsbuch behandelt die Themen Rhetorik, Kommunikation und Körpersprache, um den Lesern zu helfen, souverän aufzutreten und effektiv zu präsentieren. Durch various Übungen und Anleitungen können die Lerner ihre Fähigkeiten im Bereich der nonverbalen Kommunikation verbessern und lernen, wie sie ihre Körperhaltung, Gestikulation und Blickverhalten einsetzen können, um eine positive Wirkung auf ihr Publikum zu erzielen. Durch das Verständnis der Körpersprache und ihrer Auswirkungen auf die Kommunikation können die Lerner ihre Selbstsicherheit und Überzeugungskraft stärken."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12oopPaAYjVak" ;
    dcterms:subject <http://example.org/education/concept/Blickverhalten>,
