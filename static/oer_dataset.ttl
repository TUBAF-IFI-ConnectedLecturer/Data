oer:96C9KHZzzwpE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Stieler> ;
    dcterms:description "Die Unterrichtsskizze führt Schülerinnen und Schüler an die Konzepte der Unbestimmtheit und Unbestimmtheitsrelation heran, indem sie Experimente mit Stern-Gerlach-Apparaten, Einzel- und Doppelspalt-Experimenten sowie Polarisationsfiltern durchführen. Durch diese Simulationen entwickeln die Lernenden ein Verständnis dafür, dass die Unbestimmtheit nicht nur auf Orts- und Impulsmessungen beschränkt ist, sondern auf alle nicht-kommutierenden Observablen von Quantenobjekten übertragen werden kann. Am Ende des Unterrichts können die Schülerinnen und Schüler erste Hypothesen zu den Beobachtungen formulieren und eine präzise Formulierung der Unbestimmtheit entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "96C9KHZzzwpE" ;
    dcterms:subject <http://example.org/education/concept/Messungstechniken>,
        <http://example.org/education/concept/Physikdidaktik>,
        <http://example.org/education/concept/Physikunterricht>,
        <http://example.org/education/concept/Quantenmechanik>,
        <http://example.org/education/concept/Quantenobjekte>,
        <http://example.org/education/concept/Quantenphysik>,
        <http://example.org/education/concept/Sch%C3%BClervorstellungen>,
        <http://example.org/education/concept/Unbestimmtheit>,
        <http://example.org/education/concept/Unterrichtsskizze>,
        <http://example.org/education/concept/Zufall> ;
    dcterms:title "Entwickeln Sie eine Unterrichtsskizze zur Einführung und Erklärung der Unbestimmtheit und der Unbestimmtheitsrelation."@de ;
    dcterms:type <http://example.org/education/type/Skript> .

