        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Methodenkompetenz>,
        <http://example.org/education/concept/Selbstkompetenz>,
        <http://example.org/education/concept/Sozialkompetenz>,
        <http://example.org/education/concept/Sportunterricht>,
        <http://example.org/education/concept/Trainingslehre> ;
    dcterms:title "Digitale Medien in der Schule"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenpool> .

