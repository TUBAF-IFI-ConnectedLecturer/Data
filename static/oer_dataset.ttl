    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von Schienenfahrzeugen, insbesondere den Luftwiderstand und seine Einflussfaktoren wie Formgebung, Geschwindigkeit und Tunnelquerschnitt. Durch das Studium dieser Inhalte können Lernende die physikalischen Grundlagen des Luftwiderstands verstehen und berechnen, um die Energieeffizienz und Fahrleistung von Schienenfahrzeugen zu optimieren. Die Vorlesung bietet eine umfassende Einführung in die Aerodynamik im Schienenverkehr und ihre Anwendung in der Praxis."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "37KuSzmfMl5M" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_That_The_Author_Is_Affiliated_With%3Aprofessur_F%C3%BCr_Elektrische_Bahnenwhich_Suggests_That_The_Institution_Is_a_University_Or_a_Technical_University_%28tu%29_With_a_Department_Of_Electrical_Engineering_Or_Railway_Engineering._However__The_Exact_Name_Of_The_Institution_Is_Not_Explicitly_Mentioned.if_I_Had_To_Make_An_Educated_Guess_Based_On_The_Context_And_The_Mention_Of_%22professur_F%C3%BCr_Elektrische_Bahnen%22__I_Would_Suggest_That_The_Institution_Might_Be_a_German_University__Possibly_a_Technical_University_%28tu%29_With_a_Strong_Focus_On_Electrical_Engineering_Or_Railway_Engineering._But_Without_More_Explicit_Information__It%27s_Difficult_To_Pinpoint_The_Exact_Institution.so__My_Response_Would_Be_An_Empty_String__As_I_Couldn%27t_Find_a_Clear_Indication_Of_The_Institution%27s_Name.> ;
    dcterms:subject <http://example.org/education/concept/Aerodynamik>,
        <http://example.org/education/concept/Bahntechnik>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Luftwiderstand>,
        <http://example.org/education/concept/Maschinenbau>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Tunnelwiderstand>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

