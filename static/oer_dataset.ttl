oer:5Xz5A2frvMh4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Gutenberg> ;
    dcterms:description "Die Druckwerke Gutenbergs werden aufgelistet und datiert, darunter der Donat-Kalender-Type von 1445, die Türkenkalender und -bulle sowie die Gutenberg-Bibel. Die Zusammenstellung bietet einen Überblick über die frühen Druckwerke des berühmten Buchdruckers Johannes Gutenberg. Durch das Studium dieser Liste können Leser Einblicke in die Entwicklung der Drucktechnik und die Bedeutung Gutenbergs für die Geschichte des Buchdrucks gewinnen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Xz5A2frvMh4" ;
    dcterms:subject <http://example.org/education/concept/Buchgeschichte>,
        <http://example.org/education/concept/Druckerei>,
        <http://example.org/education/concept/Druckwerk>,
        <http://example.org/education/concept/Fr%C3%BChdruck>,
        <http://example.org/education/concept/Gutenberg>,
        <http://example.org/education/concept/Handschrift>,
        <http://example.org/education/concept/Inkunabel>,
        <http://example.org/education/concept/Kalender>,
        <http://example.org/education/concept/Mainz>,
        <http://example.org/education/concept/Typografie> ;
    dcterms:title "Die Druckwerke Gutenbergs"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

oer:5YCchYpcSX0g a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Neumann> ;
    dcterms:description "Die Wildnispädagogik fördert die Entdeckung von Dingen, Lebewesen und Fähigkeiten durch das Trainieren der Wahrnehmung, Langsamkeit und Draußensein. Durch diese Methode kann eine innere Notwendigkeit im Menschen geweckt werden, um in Gemeinschaft zu lernen und sich seinem persönlichen Weg zu nähern. Die Bildung neu denken- Ansätze unterstützen eine zukunftsfähige, nachhaltige und persönlichkeitsformende Bildung durch die Verbindung von Natur und Mensch."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5YCchYpcSX0g" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologie>,
        <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Erlebnisp%C3%A4dagogik>,
        <http://example.org/education/concept/Erziehung_zur_Nachhaltigkeit>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Naturerziehung>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitsentwicklung>,
        <http://example.org/education/concept/Umweltbildung>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Wildnisp%C3%A4dagogik> ;
    dcterms:title "Weitwinkelblick - Bildung neu denken"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

