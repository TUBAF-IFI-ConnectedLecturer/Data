oer:4jvLV_PJVS2g a edu:LearningResource ;
    sim:similarTo oer:5S4KBCxhyXnU,
        oer:7I6eto_fcIHY,
        oer:7sbLguFs_84Y,
        oer:8Fvb_vR8Gqco,
        oer:8Nzf3_jmBwfQ,
