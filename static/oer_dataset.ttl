    dcterms:title "Hausaufgabe (Nachbereitung)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9mz8TBpZofEs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Bremsauslegung eines Güterwagens mit zwei Radsätzen wird auf physikalischer Basis berechnet und die erforderlichen Kräfte und Übersetzungen bestimmt. Durch die Berechnungen und Beispiele können Studierende die Grundlagen der Schienenfahrzeugbremstechnik verstehen und anwenden. Die Auslegung umfasst die Bestimmung der Bremskraft, des erforderlichen Kraftschlusses und der mittleren Klotzkraft unter Berücksichtigung von Fahrdynamik und Bremsmechanik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9mz8TBpZofEs" ;
    dcterms:subject <http://example.org/education/concept/Bremsen>,
        <http://example.org/education/concept/Bremsmechanik>,
        <http://example.org/education/concept/Bremssysteme>,
        <http://example.org/education/concept/Eisenbahn>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Klotzbremse>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Verkehrstechnik> ;
    dcterms:title "Bremsen der Schienenfahrzeuge (Grundlagen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

