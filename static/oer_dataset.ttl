    dcterms:title "Datenmanagement und Datenbanken SoSe 2022 Übung 3 Aufgabe 1: Sammlungsmanagementtabelle formatieren"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5yi81_XY4maI a edu:LearningResource ;
    dcterms:description "In diesem Lehrmaterial geht es um die naturwissenschaftliche Erkundung eines unbekannten Objekts, einer Black Box, durch Formulierung von Vermutungen und deren Überprüfung. Die Lernenden sollen durch einfache Experimente und Beobachtungen Erkenntnisse über den Aufbau und die Struktur der Black Box gewinnen. Am Ende erstellen sie ein Tafelbild, um ihre Ergebnisse und das Vorgehen bei der naturwissenschaftlichen Erkenntnisgewinnung zu präsentieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5yi81_XY4maI" ;
    dcterms:subject <http://example.org/education/concept/Black_Box>,
        <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Erkenntnisgewinnung>,
        <http://example.org/education/concept/Experiment>,
        <http://example.org/education/concept/Forschung>,
        <http://example.org/education/concept/Naturwissenschaften>,
        <http://example.org/education/concept/Ph%C3%A4nomen>,
        <http://example.org/education/concept/Untersuchung>,
        <http://example.org/education/concept/Wissenschaftliches_Arbeiten>,
        <http://example.org/education/concept/naturwissenschaftliche_Methoden> ;
    dcterms:title "Naturwissenschaftliche Erkenntnisgewinnung 22.04.2025 Black Box - Ein unbekanntes Phänomen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

