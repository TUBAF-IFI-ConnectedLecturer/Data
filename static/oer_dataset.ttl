oer:10UyAw3rkKyjw a edu:LearningResource ;
    sim:similarTo oer:3GFZMDtuiYCY,
        oer:4ik3f_fLbWQg,
        oer:7fbJ_JVHp_j0,
        oer:9aggXCl1eGzc ;
    dcterms:creator <http://example.org/education/person/Barnes>,
        <http://example.org/education/person/G%C3%A4rtner> ;
    dcterms:description "Die Vorlesung behandelt die Charakterisierung und Diagnose von Persönlichkeitsstörungen, einschließlich ihrer Einteilung in drei Cluster (A: Sonderbar-exzentrisch, B: Dramatisch-emotional, C: Ängstlich-furchtsam) und der Beschreibung spezifischer Störungen wie Borderline- oder Narzisstische Persönlichkeitsstörung. Durch die Lektüre dieser Vorlesung können Studierende die Merkmale und Diagnosekriterien von Persönlichkeitsstörungen nachvollziehen und ein Verständnis dafür entwickeln, wie diese Störungen behandelt werden können. Zudem werden aktuelle Entwicklungen in der Forschung zu Persönlichkeitsstörungen vorgestellt, um ein umfassendes Bild dieser komplexen Thematik zu vermitteln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10UyAw3rkKyjw" ;
    dcterms:subject <http://example.org/education/concept/ADHS>,
        <http://example.org/education/concept/Borderline-Pers%C3%B6nlichkeitsst%C3%B6rung>,
        <http://example.org/education/concept/Diagnostik>,
        <http://example.org/education/concept/Dialektisch-Behaviorale_Therapie>,
        <http://example.org/education/concept/Klinische_Psychologie>,
        <http://example.org/education/concept/Kognitive_Verhaltenstherapie>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitsst%C3%B6rungen>,
        <http://example.org/education/concept/Psychologische_Behandlungsmethoden>,
        <http://example.org/education/concept/Psychopathologie>,
        <http://example.org/education/concept/Psychotherapie> ;
    dcterms:title "S.PP 06 Anwendungsbereich Klinische Psychologie: Persönlichkeitsstörungen Differentielle und Persönlichkeitspsychologie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10VO66R923VoI a edu:LearningResource ;
    sim:similarTo oer:10gJWncYHldeE,
        oer:10qTO5W7UD0SA,
        oer:10r48hRkbqxsU,
        oer:11DbrkwywMj-Q,
        oer:56EO2w2PQ-q0,
        oer:8yTi_zfDDnfs ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Diese Lehrveranstaltung behandelt die Kontrastive Linguistik und ihre Anwendung auf verschiedenen Sprachebenen, um Gemeinsamkeiten und Unterschiede zwischen Sprachsystemen zu erkennen. Durch die Analyse von Beispielen aus verschiedenen Sprachen wie Türkisch, Vietnamesisch, Deutsch, Russisch, Italienisch und Yukatekisch werden grundlegende Begriffe und Methoden des Sprachevergleichs vermittelt. Die Teilnehmer erwerben Kenntnisse über die typologischen Besonderheiten europäischer Sprachen im Vergleich und lernen, Unterschiede und Gemeinsamkeiten zwischen dem Deutschen und anderen modernen europäischen Sprachen zu erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10VO66R923VoI" ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cbersetzungswissenschaft>,
        <http://example.org/education/concept/Europ%C3%A4ische_Sprachen>,
        <http://example.org/education/concept/Kontrastive_Linguistik>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Morphologie>,
        <http://example.org/education/concept/Phonologie>,
        <http://example.org/education/concept/Sprachtypologie>,
        <http://example.org/education/concept/Sprachvergleich>,
        <http://example.org/education/concept/Syntax>,
        <http://example.org/education/concept/Vergleichende_Sprachwissenschaft> ;
    dcterms:title "Verschiedenheit auf verschiedenen Sprachebenen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

