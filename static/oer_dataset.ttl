oer:5k5csdcmmLmk a edu:LearningResource ;
    sim:similarTo oer:5kz5Q9DGAO3E,
        oer:6g4kxeEQlo94,
        oer:8KxD4v_QJXjY ;
    dcterms:description "Dieses Dokument behandelt die Grundlagen von Kurs und Rendite im Kontext von Tilgungsprozessen und Anleihen, einschließlich der Definitionen und Berechnungen von Nominal- und Realzinssätzen, Barwerten und Agio/Disagio. Durch das Studium dieses Materials können Lernende die Zusammenhänge zwischen Kurs und Rendite verstehen und praktische Beispiele für die Anwendung dieser Konzepte in der Finanzwelt lösen. Die Inhalte dienen als Grundlage für weiterführende Studien im Bereich der Finanzen und Wirtschaft."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5k5csdcmmLmk" ;
    dcterms:subject <http://example.org/education/concept/Anleihe>,
        <http://example.org/education/concept/Annuit%C3%A4t>,
        <http://example.org/education/concept/Finanzmathematik>,
        <http://example.org/education/concept/Kapitalmarkt>,
        <http://example.org/education/concept/Kurs>,
        <http://example.org/education/concept/Nominalzinssatz>,
        <http://example.org/education/concept/Realzinssatz>,
        <http://example.org/education/concept/Rendite>,
        <http://example.org/education/concept/Tilgungsprozess>,
        <http://example.org/education/concept/Zinssatz> ;
    dcterms:title "Kurs und Rendite"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:5nfC-lThYeR0 a edu:LearningResource ;
    sim:similarTo oer:74vvb6iorlGg ;
    dcterms:description "Das Buchwesen der Renaissance umfasst die Entwicklung des Buchdrucks mit beweglichen Lettern, die Ablösung der Handschrift durch das gedruckte Buch und die Entstehung neuer Schriftarten wie Antiqua-Schriften und gebrochene Schriften. Durch die Reformation und Gegenreformation erlebte das Buchgewerbe eine Belebung, es erschienen zahlreiche Flugschriften, wissenschaftliche Bücher und unterhaltsame Literatur. Die Illustrationen in Büchern nahmen zu, bedeutende Künstler wie Dürer und Cranach widmeten sich dem Holzschnitt und Kupferstich."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5nfC-lThYeR0" ;
    dcterms:subject <http://example.org/education/concept/Buchdruck>,
        <http://example.org/education/concept/Buchkunst>,
        <http://example.org/education/concept/Buchwesen>,
        <http://example.org/education/concept/Druckschriften>,
        <http://example.org/education/concept/Holzschnitt>,
        <http://example.org/education/concept/Illustrationen>,
        <http://example.org/education/concept/Inkunabeln>,
        <http://example.org/education/concept/Kupferstich>,
        <http://example.org/education/concept/Renaissance>,
        <http://example.org/education/concept/Typographie> ;
    dcterms:title "Buchwesen der Renaissance"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:672rPrIF6F6o a edu:LearningResource ;
    sim:similarTo oer:6GrWWom2ZAUo,
