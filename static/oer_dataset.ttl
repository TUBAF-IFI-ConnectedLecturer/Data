    dcterms:creator <http://example.org/education/person/Bregulla>,
        <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik im Schienenverkehr und vermittelt grundlegende Kenntnisse über Fahrwiderstandskräfte, Antriebskräfte, Traktionsvermögen und Leistungs- und Energiebedarf. Durch die Lektüre dieser Vorlesung können Studierende die Fähigkeit erwerben, die maximal mögliche Wagenzugmasse zu berechnen, die von einem Triebfahrzeug auf einem bestimmten Laufweg befördert werden kann. Zudem werden praxisnahe Beispiele und Schätzungen für fehlende Parameter vorgestellt, um die Anwendung der theoretischen Grundlagen in der Praxis zu verdeutlichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11OLLaIJQxKYY" ;
    dcterms:publisher <http://example.org/education/organization/Professur_f%C3%BCr_Elektrische_Bahnen> ;
    dcterms:subject <http://example.org/education/concept/Antriebskr%C3%A4fte>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Fahrwiderstandskr%C3%A4fte>,
        <http://example.org/education/concept/Fahrzeitberechnung>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Leistungsbedarf>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Traktionsverm%C3%B6gen>,
        <http://example.org/education/concept/Verkehrsingenieurwesen> ;
    dcterms:title "Fahrdynamik für das Verkehrsingenieurwesen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

