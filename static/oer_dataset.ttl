        <http://example.org/education/concept/Sachsen>,
        <http://example.org/education/concept/Silber>,
        <http://example.org/education/concept/Verarbeitung> ;
    dcterms:title "Ort der Erinnerung: Bergbau und Kunsthandwerk im Deutsch-Tschechischen Erinnerungsort."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

