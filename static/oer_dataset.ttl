        <http://example.org/education/concept/Mengentheorie>,
        <http://example.org/education/concept/Relationen>,
        <http://example.org/education/concept/Verkn%C3%BCpfung> ;
    dcterms:title "Hausaufgabe Nr. 10"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

