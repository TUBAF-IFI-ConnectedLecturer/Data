        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Sekundarstufe_II>,
        <http://example.org/education/concept/Vertraulichkeit> ;
    dcterms:title "CrypTool 2 Didaktik Aspekte"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

