        <http://example.org/education/concept/optische_Sensoren>,
        <http://example.org/education/concept/spektrale_R%C3%BCckstreuung> ;
    dcterms:title "LV: Partikelmesstechnik Frank Babick, AG Mechanische Verfahrenstechnik, 2024"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

