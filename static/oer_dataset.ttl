oer:3ju_hJxrxFjI a edu:LearningResource ;
    sim:similarTo oer:805f-AUiaTeM,
        oer:8fk_RATCEyWM ;
    dcterms:creator <http://example.org/education/person/Beyer>,
        <http://example.org/education/person/Gerhold> ;
    dcterms:description "Die Übung behandelt die Grundlagen der Photogrammetrie und ihre Anwendung auf die Bildverarbeitung. Durch die praktische Durchführung von Aufgaben wie der Berechnung der relativen Orientierung und der Modellierung in 3D-Viewer können Lernende die Qualitätsbeurteilung von Verknüpfungspunkten erlernen. Die Photogrammetrie hat vielfältige Anwendungsbereiche, darunter Unfallforschung, Architektur, Bergbau und Archäologie."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3ju_hJxrxFjI" ;
    dcterms:subject <http://example.org/education/concept/3D-Modellierung>,
