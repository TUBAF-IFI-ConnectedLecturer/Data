        <http://example.org/education/concept/Schriftarten>,
        <http://example.org/education/concept/Typografie>,
        <http://example.org/education/concept/visuelle_Kommunikation> ;
    dcterms:title "Medien begriff Gestaltungs- regeln visuelle Medien Präsentation auditive Medien Moderation"@de ;
