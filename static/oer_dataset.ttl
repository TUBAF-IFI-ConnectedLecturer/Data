oer:9cbOrOoIrprQ a edu:LearningResource ;
    sim:similarTo oer:9h_vYcI6Oin4,
        oer:9wAjsR0aqZ_M ;
    dcterms:creator <http://example.org/education/person/Alkhawaja>,
        <http://example.org/education/person/Sharaf> ;
    dcterms:description "Der Zellersche Kongruenz-Algorithmus wird vorgestellt, ein mathematischer Algorithmus zur Berechnung des Wochentags eines beliebigen Datums im gregorianischen Kalender. Durch die Implementierung dieses Algorithmus in einem digitalen Schaltkreis werden die Grundlagen der Schaltungsentwicklung und -synthese vermittelt. Die Anwendung von Constraints, kritischen Timing-Pfaden und Flächeneigenschaften ermöglicht eine effiziente und wirtschaftliche Entwicklung von Schaltungsdesigns."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9cbOrOoIrprQ" ;
    dcterms:subject <http://example.org/education/concept/Digitaler_Schaltkreis>,
        <http://example.org/education/concept/Finite-State-Maschine>,
        <http://example.org/education/concept/Kalenderalgorithmus>,
        <http://example.org/education/concept/Mikroelektronik>,
        <http://example.org/education/concept/Rechnerarchitektur>,
        <http://example.org/education/concept/Register-Transfer-Folge>,
        <http://example.org/education/concept/Schaltungsentwurf>,
        <http://example.org/education/concept/Simulationssoftware>,
        <http://example.org/education/concept/Verilog-Code>,
        <http://example.org/education/concept/Zeitverz%C3%B6gerung> ;
    dcterms:title "Beitrag zur Entwicklung eines Hardware-Algorithmus für die Berechnung von Wochentagen nach Zeller"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9qXj_6dE9e_o a edu:LearningResource ;
    dcterms:description "Das Arbeitsblatt führt Schüler in das Thema Lichtbrechung ein und ermöglicht ihnen, das Prinzip des schnellsten Weges zu verstehen und grundlegende Erkenntnisse induktiv zu erarbeiten. Durch die Anwendungsaufgabe soll der Transfer zwischen Theorie und Praxis gefördert werden. Die SuS können sich selbstständig dem Thema annähern und ihre Kenntnisse über Licht als Strahlen, Winkel und trigonometrische Funktionen vertiefen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9qXj_6dE9e_o" ;
    dcterms:subject <http://example.org/education/concept/Arbeitsblatt>,
