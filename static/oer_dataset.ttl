oer:51rmKT-rmXoQ a edu:LearningResource ;
    sim:similarTo oer:5Sw_UvohNgMo,
        oer:5h1P-4hlFJNg ;
    dcterms:creator <http://example.org/education/person/Brose> ;
    dcterms:description "Der Elektro Fox Wochenumsatzbericht bietet eine Übersicht über den Umsatz von Elektrogeräten in verschiedenen Filialen und Warengruppen. Die Daten werden täglich und wöchentlich aufgeschlüsselt, um die Entwicklung des Umsatzes zu verfolgen. Durch die Analyse dieser Zahlen können Einblicke in die Verkaufsstrategien und -trends gewonnen werden."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "51rmKT-rmXoQ" ;
    dcterms:subject <http://example.org/education/concept/Absatzstatistik>,
