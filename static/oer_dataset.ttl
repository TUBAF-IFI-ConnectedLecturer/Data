        <http://example.org/education/concept/Naturschutz>,
        <http://example.org/education/concept/Privatwald>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Waldbesitzer>,
        <http://example.org/education/concept/Waldmanagement> ;
    dcterms:title "Informationsmaterialien von Sachsenforst für den Privat- und Körperschaftswald"@de ;
    dcterms:type <http://example.org/education/type/Pr%C3%A4sentation> .

