oer:450OoYYuSvPo a edu:LearningResource ;
    sim:similarTo oer:9pSrGXmMyg5o ;
    dcterms:creator <http://example.org/education/person/Hartig>,
        <http://example.org/education/person/Wesselak> ;
    dcterms:description "Die Umweltenergien gliedern sich in direkte und indirekte Nutzung der Sonnenenergie, wobei Photovoltaik und Solarthermie zu den wichtigsten Technologien zählen. Durch die Verwendung dieser Energien können Nutzenergien für Heizung, Warmwasseraufbereitung, Prozesswärme und Stromerzeugung gewonnen werden. Die Kenntnis der Strom-Spannungs-Kennlinie einer PV-Zelle und des Wirkungsgrades von Solarthermie-Kollektoren ist für die effiziente Nutzung dieser Energien entscheidend."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "450OoYYuSvPo" ;
    dcterms:subject <http://example.org/education/concept/Elektrische_Leistung>,
        <http://example.org/education/concept/Energieerzeugungstechnologien>,
        <http://example.org/education/concept/Kennlinie>,
        <http://example.org/education/concept/Photovoltaik>,
        <http://example.org/education/concept/Regenerative_Energien>,
        <http://example.org/education/concept/Solarenergie>,
