oer:12c4Hc69DPiek a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Bergner> ;
    dcterms:description "Eine Liste in Python wird durch eine Kette von Objekten realisiert, bei der jedes Element auf sein nächstes Element verweist und einen Wert speichert. Durch die Implementierung einer Liste mittels objektorientierter Programmierung können Elemente hinzugefügt und die Liste erweitert werden. Durch das Verständnis dieser Implementation können Lerner die Funktionsweise von Listen in Python besser verstehen und effizientere Programme entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12c4Hc69DPiek" ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Datenrepr%C3%A4sentation>,
        <http://example.org/education/concept/Datenstrukturen>,
        <http://example.org/education/concept/Implementierung>,
        <http://example.org/education/concept/Listen>,
        <http://example.org/education/concept/Objektorientierte_Programmierung>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Python>,
        <http://example.org/education/concept/Rekursion>,
        <http://example.org/education/concept/Speicherorganisation> ;
    dcterms:title "Implementation einer Liste in Python"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:12dton3FdYbfY a edu:LearningResource ;
    dcterms:description "Diese Vorlesung behandelt die grundlegenden Konzepte und Eigenschaften von Zufallsvariablen, einschließlich diskreter und stetiger Verteilungen, Erwartungswerten, Momenten und Varianzen. Durch das Studium dieser Materialien können Lernende ein tiefes Verständnis der statistischen Grundlagen entwickeln und ihre Fähigkeiten in der Anwendung von Zufallsvariablen in verschiedenen Kontexten verbessern. Die Vorlesung bietet eine umfassende Einführung in die Theorie und Anwendung von Zufallsvariablen, die für Studierende der Statistik und verwandter Fachgebiete von großem Nutzen ist."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12dton3FdYbfY" ;
    dcterms:subject <http://example.org/education/concept/Diskrete_Zufallsvariable>,
        <http://example.org/education/concept/Erwartungswert>,
        <http://example.org/education/concept/Moment>,
        <http://example.org/education/concept/Stetige_Zufallsvariable>,
        <http://example.org/education/concept/Varianz>,
        <http://example.org/education/concept/Verteilungsfunktion>,
        <http://example.org/education/concept/Wahrscheinlichkeitsdichte>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie>,
        <http://example.org/education/concept/Zufallsvariable>,
        <http://example.org/education/concept/mathematische_Statistik> ;
    dcterms:title "Zufallsvariablen und ihre Kenngrößen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:12eUGUXb2ArN4 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Herbing> ;
    dcterms:description "Die kulturelle Identität einer Person bildet einen wesentlichen Eckpfeiler ihrer Persönlichkeit und wird durch Erfahrungen, Werte und Erziehung geprägt. Durch Selbstreflexion kann man seine eigene Identität besser verstehen und sich als Individuum positionieren. Dieser Text bietet Einblicke in die Entwicklung der kulturellen Identität eines Menschen und wie sie durch Lebenserfahrungen und -entscheidungen geformt wird."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12eUGUXb2ArN4" ;
    dcterms:subject <http://example.org/education/concept/Akkulturation>,
