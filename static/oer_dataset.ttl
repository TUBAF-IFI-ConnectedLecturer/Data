oer:7P1U5I-w0aLM a edu:LearningResource ;
    sim:similarTo oer:8D_aAB-c5ok0,
        oer:8EUTaDBs5bWw,
        oer:8c-80cDbnMX8,
        oer:9ysxFnUUqULY ;
    dcterms:creator <http://example.org/education/person/Reinhardt> ;
    dcterms:description "Die SuS erwerben ein Grundverständnis des Aufbaus von Informatiksystemen und entwickeln eigenständige Denkprozesse durch die Anregung der Lehrkraft. Sie lernen, die drei Hauptbestandteile eines Informatiksystems zu identifizieren und Beispiele für Hardware-, Software- und Netzwerkkomponenten anzugeben. Durch Gruppenarbeit und Präsentation ihrer Entscheidungen verbessern die SuS ihre sozialen Fähigkeiten und lernen, ihre Meinung vor einer Klasse zu vertreten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7P1U5I-w0aLM" ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Computerhardware>,
        <http://example.org/education/concept/Computersoftware>,
        <http://example.org/education/concept/Gruppenarbeit>,
        <http://example.org/education/concept/Informatiksysteme>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Lernen_im_Alltag>,
        <http://example.org/education/concept/Netzwerke>,
        <http://example.org/education/concept/Soziale_F%C3%A4higkeiten>,
        <http://example.org/education/concept/Unterrichtsmethoden> ;
    dcterms:title "Unterrichtsaufgaben zum Lernbereich: Informatik im Alltag"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7mo9F1qEFIg4 a edu:LearningResource ;
    sim:similarTo oer:7v8U2x8tGrOU,
        oer:88A7JwgP02xU ;
    dcterms:creator <http://example.org/education/person/Huning>,
        <http://example.org/education/person/Kirkpatrick> ;
    dcterms:description "Die Wortbildung in germanischen Sprachen wie Deutsch und Niederländisch wird durch die Konvergenz sprachlicher Entwicklungen geprägt, die sich in der Zunahme von Produktivität in bestimmten Wortbildungsprozessen zeigt. Durch den Vergleich dieser Prozesse können Lernende Einblicke in die Strukturen und Besonderheiten der jeweiligen Sprachen gewinnen und ihre Kenntnisse über die Wortbildung erweitern. Insbesondere werden Aspekte wie Komposition, Derivation und Entlehnung behandelt, um ein vertieftes Verständnis von Konvergenz und Divergenz in der Wortbildung zu ermöglichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7mo9F1qEFIg4" ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Fremdsprachenunterricht>,
        <http://example.org/education/concept/Germanische_Sprachen>,
        <http://example.org/education/concept/Kontrastive_Linguistik>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Morphologie>,
        <http://example.org/education/concept/Niederl%C3%A4ndische_Sprache>,
        <http://example.org/education/concept/Sprachvergleich>,
        <http://example.org/education/concept/Sprachwandel>,
        <http://example.org/education/concept/Wortbildung> ;
    dcterms:title "Konvergenz und Divergenz in der Wortbildung"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7rHQilTRqVMI a edu:LearningResource ;
    sim:similarTo oer:9CUiwaw3vJGU,
        oer:9LZQPW70zooM ;
    dcterms:creator <http://example.org/education/person/Engelkenmeier>,
        <http://example.org/education/person/Mo%C3%9Fburger>,
        <http://example.org/education/person/Schade> ;
    dcterms:description "Bibliotheken müssen ihre Identität neu definieren und ihr Image profilieren, um sich in Zeiten von Social Media, Fake News und zunehmender Ökonomisierung von Information zu positionieren. Durch die Entwicklung einer zeitgemäßen Definition von Bibliothek und der Klärung ihrer Werte und Dienstleistungen können sie ihre Legitimität für die Gesellschaft begründen und sich von Wettbewerbern auf dem Informations- und Medienmarkt unterscheiden. Dieser Prozess erfordert die Einbeziehung aller Akteurinnen und Akteure aus dem Berufsfeld Bibliothek, um eine Identität zu entwickeln, die von allen getragen und mit Stolz gezeigt werden darf."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7rHQilTRqVMI" ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentlichkeitsarbeit>,
        <http://example.org/education/concept/Berufsbild>,
        <http://example.org/education/concept/Bibliothek>,
        <http://example.org/education/concept/Bibliotheks-_und_Informationswesen>,
        <http://example.org/education/concept/Bildungspolitik>,
        <http://example.org/education/concept/Fachkr%C3%A4ftemangel>,
        <http://example.org/education/concept/Identit%C3%A4tsentwicklung>,
        <http://example.org/education/concept/Informationsmanagement>,
        <http://example.org/education/concept/Medieninformatik>,
        <http://example.org/education/concept/Personalgewinnung> ;
    dcterms:title "[Berufsfeld.rebooting ...]"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:86txCjR7ScoA a edu:LearningResource ;
    sim:similarTo oer:8EVYFC-BIuww,
        oer:8Iq1XDtZbkZo ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Vorlesung behandelt Strömungsprobleme der Mechanischen Verfahrenstechnik und bietet eine Einführung in die Wirbelschichten, einschließlich ihrer Klassifikation, Zustandsdiagrammen und Visualisierung. Die Studierenden lernen, die verschiedenen Arten von Wirbelschichten zu unterscheiden und ihre Eigenschaften zu verstehen, um sie in der Verfahrenstechnik anwenden zu können. Durch die Vorlesung erhalten die Studierenden ein grundlegendes Verständnis der Strömungsprobleme und ihrer Lösungen in der Mechanischen Verfahrenstechnik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "86txCjR7ScoA" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Maschinenwesen_Institut_f%C3%BCr_Verfahrenstechnik_und_Umwelttechnik> ;
    dcterms:subject <http://example.org/education/concept/Archimedes-Zahl>,
        <http://example.org/education/concept/Fluidisierung>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Omega-Zahl>,
        <http://example.org/education/concept/Partikel-Froude-Zahl>,
        <http://example.org/education/concept/Partikel-Reynolds-Zahl>,
        <http://example.org/education/concept/Str%C3%B6mungsdynamik>,
        <http://example.org/education/concept/Str%C3%B6mungsprobleme>,
        <http://example.org/education/concept/Wirbelbettporosit%C3%A4t>,
        <http://example.org/education/concept/Wirbelschichten> ;
    dcterms:title "Strömungsprobleme der Mechanischen Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8M3KAxLcgQp0 a edu:LearningResource ;
    sim:similarTo oer:90XIez_Rhq80,
        oer:91_YQeMeSPgA,
