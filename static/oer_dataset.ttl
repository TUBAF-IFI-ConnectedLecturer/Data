    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Vorlesung behandelt die Fahrdynamik von spurgeführten Fahrzeugen und deckt Themen wie Antriebskräfte, Zugkraft-Diagramme und Traktionsvermögen ab. Durch das Studium dieser Materialien können Lernende ein Verständnis der grundlegenden Kräfte und Leistungen von Schienenfahrzeugen entwickeln und die Fahrzeitberechnung durchführen. Die Beispiele und Diagramme in der Vorlesung unterstützen die Anwendung theoretischer Konzepte auf reale Zugfahrzeuge wie den BR 101 oder die Traxx F140 DE."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5opQEnoJqkrc" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Diesellokomotive>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Elektrotraktion>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Traktion>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

