    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik-Vorlesung behandelt die Leistungsübertragung von Dieselmotoren auf Fahrzeuge, insbesondere den idealen Volllast-Betriebspunkt und die verschiedenen Arten der Leistungsübertragung. Durch diese Vorlesung erwerben die Lernenden Kenntnisse über die Charakteristik von Dieselmotoren, die Bewertung des Traktionsvermögens und die Grundlagen der Fahrzeitberechnung. Die Inhalte umfassen auch die Darstellung von Drehmoment- und Leistungsdiagrammen sowie die Notwendigkeit einer Leistungsübertragung in verschiedenen Anwendungsbereichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "13etrSjEhikqg" ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Dieselmotoren>,
        <http://example.org/education/concept/Energiebedarf>,
        <http://example.org/education/concept/Fahrwiderstand>,
        <http://example.org/education/concept/Fahrzeitberechnung>,
        <http://example.org/education/concept/Fahrzeugelektrik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Traktionsverm%C3%B6gen>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

