oer:12plZF6xssBnU a edu:LearningResource ;
    sim:similarTo oer:7vWE16fX7-S8 ;
    dcterms:creator <http://example.org/education/person/Meier>,
        <http://example.org/education/person/Wiedmer>,
        <http://example.org/education/person/Wober> ;
    dcterms:description "Der Studiengang Lehramt Biologie bietet eine umfassende Ausbildung in den Fächern Biologie und Fachdidaktik, um Lehrerinnen und Lehrer auszubilden, die Schülerinnen und Schüler auf ihrem Weg zum Verständnis der biologischen Phänomene begleiten können. Durch das Studium werden Kenntnisse in verschiedenen biologischen Disziplinen wie Botanik, Zoologie, Genetik, Mikrobiologie und Biochemie erworben, die für den Unterricht an Schulen erforderlich sind. Zudem werden Fähigkeiten im Bereich der Fachdidaktik entwickelt, um Lehr-Lern-Prozesse zu gestalten und durchzuführen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12plZF6xssBnU" ;
