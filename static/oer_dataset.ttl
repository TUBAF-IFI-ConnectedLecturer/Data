oer:5Xq4C1ZoPjGI a edu:LearningResource ;
    sim:similarTo oer:9I8FnA5ufCwI,
        oer:9uBCLdWfR1h0 ;
    dcterms:creator <http://example.org/education/person/Erdtel>,
        <http://example.org/education/person/Meydan> ;
    dcterms:description "Die Organisierte Kriminalität wird definiert als planmäßige Begehung von Straftaten durch mehrere Beteiligte über einen längeren Zeitraum, die von Gewinn- oder Machtstreben bestimmt sind und erhebliche Bedeutung haben. Die verschiedenen Formen organisierter Kriminalität, wie Rockergruppierungen, Clan-Gruppierungen und andere, werden beschrieben und ihre Hauptaktivitäten, wie Rauschgift- und Eigentumskriminalität, aufgezeigt. Durch das Verständnis dieser Phänomene können Maßnahmen entwickelt werden, um die Organisierte Kriminalität zu bekämpfen und die Sicherheit in der Gesellschaft zu erhöhen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Xq4C1ZoPjGI" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Cybercrime>,
        <http://example.org/education/concept/Eigentumskriminalit%C3%A4t>,
        <http://example.org/education/concept/Geldw%C3%A4sche>,
        <http://example.org/education/concept/Gewaltkriminalit%C3%A4t>,
        <http://example.org/education/concept/Korruption>,
        <http://example.org/education/concept/Kriminalit%C3%A4t>,
        <http://example.org/education/concept/Organisierte_Kriminalit%C3%A4t>,
        <http://example.org/education/concept/Rauschgiftkriminalit%C3%A4t>,
        <http://example.org/education/concept/Straftaten>,
        <http://example.org/education/concept/Transnationale_Kriminalit%C3%A4t> ;
    dcterms:title "Vertiefende Grundlagen der nationalen Politik"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:5Z67jT2fA_Dg a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kossatz> ;
    dcterms:description "Die Emotionsgeschichte erforscht die Rolle von Emotionen in verschiedenen Bereichen und zeigt, dass sie ein soziales Zusammenleben ermöglichen und sich durch Erfahrungen ändern. Durch die Analyse von Quellen wie Traueranzeigen können historische Veränderungen gesellschaftlicher Normen aufgezeigt werden. Die Erkenntnisse der Emotionsgeschichte betonen die Bedeutung des historischen Kontextes und dass Konzepte nicht einfach auf andere Zeiten übertragen werden können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5Z67jT2fA_Dg" ;
    dcterms:subject <http://example.org/education/concept/Affektgeschichte>,
        <http://example.org/education/concept/Emotionen>,
        <http://example.org/education/concept/Gef%C3%BChle>,
        <http://example.org/education/concept/Geschichte>,
        <http://example.org/education/concept/Gesellschaftswissenschaften>,
        <http://example.org/education/concept/Historische_Forschung>,
        <http://example.org/education/concept/Kulturgeschichte>,
        <http://example.org/education/concept/Psychologie>,
        <http://example.org/education/concept/Soziale_Beziehungen>,
        <http://example.org/education/concept/Sozialgeschichte> ;
    dcterms:title "Konzepte und Theorien der Neuesten Geschichte"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

