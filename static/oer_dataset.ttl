    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Meinhold> ;
    dcterms:description "Dieses Übungsblatt zum Mathematik-Kurs für Ingenieure bietet Lösungshilfen und Aufgaben zu Differentialgleichungen, einschließlich Variation der Konstanten, Anfangswertaufgaben und linearen Differentialgleichungen. Durch die Bearbeitung dieser Aufgaben können Lernende ihre Fähigkeiten im Bereich der Differentialrechnung verbessern und ein tieferes Verständnis für die Lösung von Differentialgleichungen entwickeln. Die Übungsaufgaben decken verschiedene Aspekte der Differentialrechnung ab, darunter auch die Wronski-Determinante und lineare Unabhängigkeit."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8UFrV25s8QGU" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_f%C3%BCr_Technik_und_Wirtschaft_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cbungsaufgaben>,
        <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Differentialgleichungen>,
        <http://example.org/education/concept/Funktionentheorie>,
        <http://example.org/education/concept/Hochschulaufgaben>,
        <http://example.org/education/concept/Ingenieuraufgaben>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mathematische_Physik> ;
    dcterms:title "Mathematik für Ingenieure - WS2023/24 Übungsblatt 7"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

