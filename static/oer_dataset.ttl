        <http://example.org/education/concept/Politisches_System>,
        <http://example.org/education/concept/Wahlbeteiligung>,
        <http://example.org/education/concept/Wahlsysteme>,
        <http://example.org/education/concept/Wahlverhalten>,
        <http://example.org/education/concept/politische_Mitte>,
        <http://example.org/education/concept/politische_Parteien> ;
    dcterms:title "Das politische System der Europäischen Union Nebenwahlthese"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

