oer:4eA93iFcfXGE a edu:LearningResource ;
    sim:similarTo oer:4kv_qpC94mdY,
        oer:5ySw59JFdyX4,
        oer:6-TtE0KDtg50,
        oer:66BFD588LBO4,
        oer:6CRJOBIRXuzc ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die elektrochemische Doppelschicht spielt eine zentrale Rolle bei der Wechselwirkung zwischen Oberflächen und Ionen in Lösungen, wobei die Ladungsregulierung und Adsorption von ionischen Spezies den Verlauf des elektrischen Potenzials beeinflussen. Durch das Verständnis dieser Prozesse können Lernende die Eigenschaften von Partikeln und Oberflächen besser verstehen und ihre Anwendung in verschiedenen Bereichen wie der Verfahrenstechnik und Umwelttechnik optimieren. Insbesondere werden sie erfahren, wie die elektrochemische Doppelschicht die Stabilität von Suspensionen und die Wechselwirkung zwischen Partikeln und Oberflächen beeinflusst."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4eA93iFcfXGE" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Elektrochemische_Doppelschicht>,
        <http://example.org/education/concept/Elektrostatische_Wechselwirkung>,
        <http://example.org/education/concept/Grenzfl%C3%A4chenph%C3%A4nomene>,
        <http://example.org/education/concept/Ionische_Adsorption>,
        <http://example.org/education/concept/Kolloidale_Systeme>,
        <http://example.org/education/concept/Kolloidchemie>,
        <http://example.org/education/concept/Ladungsregulierung>,
        <http://example.org/education/concept/Oberfl%C3%A4cheneigenschaften>,
        <http://example.org/education/concept/Partikel-Partikel-Wechselwirkung>,
        <http://example.org/education/concept/Suspensionsverhalten> ;
    dcterms:title "Grenzflächenphänomene"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:4lLbBlk5qCfE a edu:LearningResource ;
    sim:similarTo oer:8KphU5s6MJZQ,
