    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die Photopolymerisation ist ein additiv geführtes Fertigungsverfahren, bei dem flüssiges Monomer durch Licht-aktiviertes Polymerisationsreaktionen zu festem Polymer umgesetzt wird. Durch die Verwendung von Fotoinitiatoren kann die Polymerisation auf einen bestimmten Bereich begrenzt werden, wodurch eine gezielte Fertigung ermöglicht wird. Dieses Verfahren findet Anwendung in der additiven Fertigung und bietet Möglichkeiten für die Herstellung komplexer Bauteile mit hoher Präzision."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12PE7hoWVLGjA" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Chemische_Reaktionen>,
        <http://example.org/education/concept/Fertigungstechnik>,
        <http://example.org/education/concept/Laserstrahlung>,
        <http://example.org/education/concept/Photopolymerisation>,
        <http://example.org/education/concept/Polymerchemie>,
        <http://example.org/education/concept/Rapid_Prototyping>,
        <http://example.org/education/concept/Ultraviolette_Strahlung>,
        <http://example.org/education/concept/Werkstoffwissenschaft> ;
    dcterms:title "ADDITIVE FERTIGUNG PHOTO- POLYMERISATION I  GRUNDLAGEN"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

