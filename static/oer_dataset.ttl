        <http://example.org/education/concept/Dichte>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Partikelgr%C3%B6%C3%9Fe>,
        <http://example.org/education/concept/Quarzpulver>,
        <http://example.org/education/concept/Sedimentation>,
        <http://example.org/education/concept/Sedimentationszeit>,
        <http://example.org/education/concept/Sinkgeschwindigkeit>,
        <http://example.org/education/concept/Suspensionsmittel>,
        <http://example.org/education/concept/Wasser> ;
    dcterms:title "Übungsaufgaben Grundlagen der MVT"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

