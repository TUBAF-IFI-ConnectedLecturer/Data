        <http://example.org/education/concept/Interaktive_Medien>,
        <http://example.org/education/concept/Mediengestaltung>,
        <http://example.org/education/concept/Web-Editoren> ;
    dcterms:title "Hypertext und Hypermedia"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

