oer:9ugrJPzIVLKw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hagedorn> ;
    dcterms:description "Diese Präsentation behandelt die Grundlagen der deutschen Grammatik, insbesondere die Wortarten Verb, Substantiv, Adjektiv und Artikel, sowie ihre Merkmale und Funktionen. Durch das Studium dieser Inhalte können Lerner ein grundlegendes Verständnis der deutschen Sprache erwerben und ihre Fähigkeiten im Bereich der Grammatik verbessern. Die Präsentation bietet viele Beispiele und Erklärungen, um die komplexen Regeln und Strukturen der deutschen Sprache zu verdeutlichen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "9ugrJPzIVLKw" ;
    dcterms:subject <http://example.org/education/concept/Adjektiv>,
        <http://example.org/education/concept/Artikel>,
        <http://example.org/education/concept/Deutsch_als_Fremdsprache>,
        <http://example.org/education/concept/Deutsche_Grammatik>,
        <http://example.org/education/concept/Grammatische_Kategorien>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Sprachlehre>,
        <http://example.org/education/concept/Substantiv>,
        <http://example.org/education/concept/Verb>,
        <http://example.org/education/concept/Wortarten> ;
    dcterms:title "Erklärung zur Bedienung der Präsentation"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9uzhAcEjAjq8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Debus>,
        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übung behandelt die Berechnung von Wahrscheinlichkeiten und Parameterbestimmung für normalverteilte Zufallsgrößen. Die Aufgaben umfassen die Lösung von Problemen aus der Elektrotechnik und der Qualitätssicherung, bei denen normalverteilte Zufallsgrößen auftreten. Durch das Lösen dieser Aufgaben erwerben die Lernenden Fähigkeiten im Umgang mit normalverteilten Zufallsgrößen und ihrer Anwendung in der Praxis."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9uzhAcEjAjq8" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Exponentialverteilung>,
        <http://example.org/education/concept/G%C3%BCtekontrolle>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Normalverteilung>,
        <http://example.org/education/concept/Produktionstechnik>,
        <http://example.org/education/concept/Qualit%C3%A4tskontrolle>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Stetige_Verteilungen>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie>,
        <http://example.org/education/concept/Zuverl%C3%A4ssigkeitstheorie> ;
    dcterms:title "Mathematik IV (für IF, ET, Ph) Sommersemester 2025"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

