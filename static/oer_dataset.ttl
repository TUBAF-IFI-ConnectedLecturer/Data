        <http://example.org/education/concept/Relation>,
        <http://example.org/education/concept/Symmetrie>,
        <http://example.org/education/concept/Transitivit%C3%A4t> ;
    dcterms:title "Aufgabe 7.6"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

