        <http://example.org/education/concept/Selbstmanagement>,
        <http://example.org/education/concept/Sozialverhalten>,
        <http://example.org/education/concept/Teamarbeit> ;
    dcterms:title "Tutorial Teamwork makes the dream work?"@de ;
