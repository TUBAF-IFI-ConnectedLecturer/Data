    dcterms:creator <http://example.org/education/person/Kie%C3%9Fling> ;
    dcterms:description "Die Didaktik der Informatik umfasst Übungsaufgaben und Anwendungen, die es Lernenden ermöglichen, interaktive Apps, digitale Tafelbilder und Quizze mit Schülerfeedbacksystemen zu erstellen. Durch das Bearbeiten dieser Aufgaben können Lernende ihre Fähigkeiten im Bereich der Medienbildung und des Einsatzes von Technologien im Unterricht verbessern. Am Ende des Prozesses sollen Lernende in der Lage sein, digitale Tafelbilder mit interaktiven Schaltflächen zu erstellen, zwischen verschiedenen Schülerfeedbacksystemen auszuwählen und eine interaktive Learning-App zu einem eigenen Unterrichtsinhalt zu entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "63t7EbLfVcFw" ;
    dcterms:subject <http://example.org/education/concept/Augmented_Reality>,
        <http://example.org/education/concept/Didaktik_der_Informatik>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Interaktive_Medien>,
        <http://example.org/education/concept/LearningApps>,
        <http://example.org/education/concept/Medienbildung>,
        <http://example.org/education/concept/Sch%C3%BClerfeedbacksysteme>,
        <http://example.org/education/concept/Screencast>,
        <http://example.org/education/concept/Unterrichtsbeispiele> ;
    dcterms:title "Didaktik der Informatik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9FDy_31nB7EQ a edu:LearningResource ;
    sim:similarTo oer:9KCaqnartL8w,
        oer:9SpbLmFx9_zw,
        oer:9W8sGkH8n5W0,
        oer:9jg_2sauMsCE,
        oer:9mKHm68tgAI0,
        oer:9nJGa8UNfPR8,
        oer:9sH_uM8xdACs,
        oer:9zh012Kp4s_c ;
    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die Vorlesung behandelt die additive Fertigung in der Medizintechnik und zeigt Beispiele für die Anwendung von 3D-Druck in verschiedenen Bereichen wie Herzchirurgie, Orthopädie und Zahnmedizin. Durch das Studium dieser Materialien können Lernende Kenntnisse über die Möglichkeiten und Grenzen der additiven Fertigung in der Medizintechnik erwerben und verstehen, wie diese Technologie verwendet werden kann, um Patienten zu helfen. Die Vorlesung deckt auch Aspekte wie Topologieoptimierung, bionischen Leichtbau und Meta-Materialien ab, die für die Entwicklung innovativer medizinischer Produkte von Bedeutung sind."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9FDy_31nB7EQ" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Bionik>,
        <http://example.org/education/concept/Computer-Aided_Design_%28CAD%29>,
        <http://example.org/education/concept/Konstruktionslehre>,
        <http://example.org/education/concept/Leichtbau>,
        <http://example.org/education/concept/Medizintechnik>,
        <http://example.org/education/concept/Meta-Materialien>,
        <http://example.org/education/concept/Topologieoptimierung>,
        <http://example.org/education/concept/Zellulare_Strukturen> ;
    dcterms:title "DESIGN FÜR DIE ADDITIVE FERTIGUNG"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

