oer:15xlZSnSoqI58 a edu:LearningResource ;
    sim:similarTo oer:3sKXN6I0IPsg,
        oer:3tv9zu0-ICAA,
        oer:4pjErgOWPj5Q,
        oer:5AJNtBA0Atek,
        oer:8mqDmRgDPbLI,
        oer:9-hEmKK_kTZA,
        oer:9LnXOs6zIBSA ;
    dcterms:description "Die Dynamische Optimierung wird angewendet, um die mittlere Gesamtverweilzeit in einer Reaktorkaskade zu minimieren. Durch Anwendung des Bellman'schen Optimalitätsprinzips können optimale Verweilzeiten und Stoffmengenkonzentrationen berechnet werden. Die Lösung des Problems erfolgt durch Rückwärtsrechnen, wobei die Zielfunktion minimiert wird, um die optimalen Werte für die Steuergrößen und Zustandsgrößen zu erhalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "15xlZSnSoqI58" ;
    dcterms:subject <http://example.org/education/concept/Chemische_Reaktion>,
        <http://example.org/education/concept/Dynamische_Optimierung>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Mathematische_Modellierung>,
        <http://example.org/education/concept/Optimalit%C3%A4tsprinzip>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Prozessleittechnik>,
        <http://example.org/education/concept/Reaktorkaskade>,
        <http://example.org/education/concept/Stoffmengenbilanz>,
        <http://example.org/education/concept/Systemverfahrenstechnik> ;
    dcterms:title "LÖSUNG - DYNAMISCHE OPTIMIERUNG EINER REAKTORKASKADE"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:16pOukccnOAgk a edu:LearningResource ;
    sim:similarTo oer:16rLcbAFyNRC8,
        oer:17Agtk_pdd86A,
        oer:17LVFOlY7Yz8w,
        oer:17c-TeiZ-rXRI,
        oer:17zQyupNMpmbU ;
    dcterms:creator <http://example.org/education/person/J%C3%BCttner> ;
    dcterms:description "Die Geschichte der Computerentwicklung wird von den Anfängen mit Lochkarten und mechanischen Rechnern bis hin zur Erfindung des Transistors und der Mikroprozessoren nachgezeichnet. Durch die Entwicklung dieser Technologien konnten Computer immer kleiner, schneller und leistungsfähiger werden, was letztendlich zum Personal Computer führte. Dieser Überblick ermöglicht es Lesern, die wichtigsten Meilensteine in der Geschichte der Computertechnologie zu verstehen und ihre Bedeutung für die heutige Gesellschaft zu erkennen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "16pOukccnOAgk" ;
    dcterms:subject <http://example.org/education/concept/Computer-Spiel>,
        <http://example.org/education/concept/Computerentwicklung>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/Geschichte_der_Informatik>,
        <http://example.org/education/concept/Heimcomputer>,
        <http://example.org/education/concept/Integrierter_Schaltkreis>,
        <http://example.org/education/concept/Lochkarten-Technologie>,
        <http://example.org/education/concept/Mikrocomputer>,
        <http://example.org/education/concept/Spielkonsole>,
        <http://example.org/education/concept/Transistor> ;
    dcterms:title "Die Geburtsstunde des Computers"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

oer:1Xj3dyhC7AyA a edu:LearningResource ;
    sim:similarTo oer:5hSnIFh2B99Y,
        oer:5yNtTEFs_TDs,
        oer:8DbkfAcGUFu8 ;
    dcterms:description "Die Lernplattform OPAL bietet eine Vielzahl von Funktionen für die Verwaltung und Gestaltung von Kursen und Lerninhalten, einschließlich der Erstellung von Kursbausteinen, der Verwaltung von Teilnehmern und der Steuerung des Zugriffs auf Inhalte. Durch die Nutzung dieser Funktionen können Lehrende ihre Kurse effektiv verwalten und anpassen, um eine optimale Lernerfahrung für ihre Studierenden zu gewährleisten. Die Plattform bietet zudem Möglichkeiten zur Bewertung von Leistungen, zur Verwaltung von Gruppen und zur Kontaktaufnahme mit Teilnehmern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "1Xj3dyhC7AyA" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Benutzerverwaltung>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/E-Learning>,
