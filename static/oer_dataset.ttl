oer:9oymdMlIaP4g a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Dieses Material behandelt die Grundlagen der Linguistik und Sprachgeschichte des Deutschen, insbesondere die Syntax, Satztypen, Satzmodi und das Topologische Feldermodell. Durch das Studium dieses Materials können Lernende die Struktur von Sätzen im Deutschen verstehen, verschiedene Satztypen erkennen und die Verwendung von Verbformen und Satzgliedern analysieren. Zudem werden sie in der Lage sein, komplexe Sätze zu analysieren und die Funktion von Präpositionalobjekten und Adverbialen zu unterscheiden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9oymdMlIaP4g" ;
    dcterms:subject <http://example.org/education/concept/Bibliographische_Katalogisierung>,
        <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Grammatik>,
        <http://example.org/education/concept/Konstituententests>,
        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Phrasenstrukturb%C3%A4ume>,
        <http://example.org/education/concept/Satzglieder>,
        <http://example.org/education/concept/Satzstruktur>,
        <http://example.org/education/concept/Syntax>,
        <http://example.org/education/concept/Topologisches_Feldermodell> ;
    dcterms:title "UE Grundlagen der Linguistik und Sprachgeschichte des Deutschen"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

