        <http://example.org/education/concept/Ultraviolett-Bestrahlung>,
        <http://example.org/education/concept/Wasserreinigung> ;
    dcterms:title "Folie 250 LV: Reine Technologien Frank Babick, AG Mechanische Verfahrenstechnik, 2024"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

