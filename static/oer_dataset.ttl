        <http://example.org/education/concept/Fahrzeugleittechnik>,
        <http://example.org/education/concept/Lokomotivbau>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/Triebfahrzeugtechnik>,
        <http://example.org/education/concept/Verkehrswissenschaften>,
        <http://example.org/education/concept/Zugsteuerung> ;
    dcterms:title "Vorlesung Triebfahrzeugtechnik (Antriebskonfigurationen)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

