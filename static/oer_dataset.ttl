oer:8nP6opOM6diw a edu:LearningResource ;
    sim:similarTo oer:8riiCUlJs1nQ,
        oer:8zr-fKp8zAf4,
        oer:9cOjlSsSnjVw,
        oer:9cVKpYXboopo ;
    dcterms:creator <http://example.org/education/person/Lewerenz> ;
    dcterms:description "Das Seminar \"Politikunterricht digital gestalten\" behandelt die Auswirkungen der Digitalisierung auf den Politikunterricht und wie Lehrerinnen und Lehrer diese nutzen können, um ihre Schülerinnen und Schüler auf eine zeitgemäße Weise zu unterrichten. Durch das Seminar sollen Teilnehmende lernen, digitale Tools und Anwendungen sinnvoll einzusetzen, um die politische Urteils-, Handlungs- und Methodenkompetenz ihrer Schülerinnen und Schüler zu fördern. Zudem werden sie sich mit den Bedingungen des digitalen Lernens auseinandersetzen und eigene kollaborative Lernprodukte gestalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8nP6opOM6diw" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Digitale_Urteilsf%C3%A4higkeit>,
        <http://example.org/education/concept/Digitalisierung>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Here_is_the_list_of_assigned_keywords%3APolitische_Bildung>,
        <http://example.org/education/concept/Lehrerbildung>,
        <http://example.org/education/concept/Medienkompetenz>,
        <http://example.org/education/concept/Politikunterricht>,
        <http://example.org/education/concept/Schulische_Lernumgebung>,
        <http://example.org/education/concept/Unterrichtspraxis> ;
    dcterms:title "01 Organisatorisches und Erwartungsmanagement Professur für Didaktik der politischen Bildung Rico Lewerenz S: Politikunterricht digital gestalten 14. April 2021 Folie 1"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8pD15DW0SNsc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/G%C3%B6hler>,
        <http://example.org/education/person/Jasper> ;
    dcterms:description "Das Masterseminar \"Trends in Deep Learning\" an der TU Bergakademie Freiberg behandelt aktuelle Entwicklungen im Bereich des Deep Learning und vermittelt Studierenden die Fähigkeit, wissenschaftliche Arbeiten zu recherchieren, zu zitieren und zu erstellen. Durch die Bearbeitung von Aufgaben und Referaten erwerben die Teilnehmer Kenntnisse über verschiedene Aspekte des Deep Learning, einschließlich seiner Anwendungen und Grenzen. Am Ende des Seminars sollen die Studierenden in der Lage sein, komplexe Fragestellungen im Bereich des Deep Learning zu bearbeiten und wissenschaftliche Arbeiten zu erstellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8pD15DW0SNsc" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Akademische_Arbeit>,
        <http://example.org/education/concept/Bibliographie>,
        <http://example.org/education/concept/Deep_Learning>,
        <http://example.org/education/concept/Forschungsmethoden>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/K%C3%BCnstliche_Intelligenz>,
        <http://example.org/education/concept/Literaturverwaltung>,
        <http://example.org/education/concept/Wissenschaftliche_Kommunikation>,
        <http://example.org/education/concept/Wissenschaftliches_Schreiben>,
        <http://example.org/education/concept/Zitation> ;
    dcterms:title "Masterseminar Trends in Deep Learning"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:8zGGrgCCUEjY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Cassack> ;
    dcterms:description "Die Übung behandelt ein mittelständisches Maschinebauunternehmen, das drei Produkte A, B und C herstellt, und die Geschäftsführung muss Verbesserungsmaßnahmen ergreifen, um die Produktion zu optimieren. Die Aufgaben umfassen die Analyse der Lorenzkurve und des Wert- und Mengenanteils sowie die Einteilung der Arbeitszeit. Durch das Lösen dieser Aufgaben können Studierende ihre Fähigkeiten in der Betriebswirtschaftslehre verbessern und Strategien für die Optimierung von Produktionsprozessen entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8zGGrgCCUEjY" ;
    dcterms:subject <http://example.org/education/concept/Betriebswirtschaftslehre>,
        <http://example.org/education/concept/Ertragsgesetz>,
        <http://example.org/education/concept/Kapazit%C3%A4tsrestriktion>,
        <http://example.org/education/concept/Kostenfunktion>,
        <http://example.org/education/concept/Lieferantenauswahl>,
        <http://example.org/education/concept/Mengenanteil>,
        <http://example.org/education/concept/Produktionsprogrammplanung>,
        <http://example.org/education/concept/Produktionstheorie>,
        <http://example.org/education/concept/Wertanteil> ;
    dcterms:title "Betriebswirtschaftslehre Prof. Dr. Ingo Cassack 322"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

