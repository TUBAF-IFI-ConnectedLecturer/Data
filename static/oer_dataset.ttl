oer:7Som0mnHdPUU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Arnold>,
        <http://example.org/education/person/Ratteit> ;
    dcterms:description "Das Praktikumsbericht behandelt die Implementierung und Analyse von digitalen Schaltungen, insbesondere des RS-Latch und D-Flipflop, um die Funktionsweise und Verhaltensweisen dieser Bausteine zu verstehen. Durch praktische Experimente und Berechnungen werden die Ausgangsspannungen und Zustände der Schaltungen untersucht und Fehlerquellen identifiziert. Die Arbeit ermöglicht es den Lernenden, grundlegende Konzepte der Digitaltechnik zu erlernen und anzuwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7Som0mnHdPUU" ;
    dcterms:subject <http://example.org/education/concept/Digitalelektronik>,
        <http://example.org/education/concept/Digitaltechnik>,
        <http://example.org/education/concept/Elektronische_Messger%C3%A4te>,
