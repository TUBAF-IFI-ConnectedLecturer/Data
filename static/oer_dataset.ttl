    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:12mhRsKRcGP7w a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Menzel> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Grundlagen von Geoinformationssystemen (GIS) und Topologien in ArcGIS, um Fehler in Feature Classes zu beheben und konsistente Daten zu erstellen. Durch die Anwendung von Topologien können Regeln definiert werden, um die Einhaltung von Konsistenzregeln innerhalb von Feature Datasets zu überprüfen und herzustellen. Die Praxisbeispiele und Übungen helfen Lernenden, Topologie-Objekte zu erstellen, Fehler zu überprüfen und zu beheben, sowie konsistente Daten in ArcGIS zu verwalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12mhRsKRcGP7w" ;
    dcterms:subject <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Feature_Classes>,
