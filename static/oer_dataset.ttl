    dcterms:creator <http://example.org/education/person/Kern> ;
    dcterms:description "Diese Aufgabenreihe behandelt die Bodendynamik und Wellenausbreitung in einem linear elastischen, isotropen Kontinuum, wobei die Lösungen für ein Blockfundament und eine horizontal polarisierte S-Welle berechnet werden müssen. Die Aufgaben umfassen die Ermittlung dynamischer Grundeigenschaften, die Berechnung von Wellenzahlen und Reflexionswinkeln sowie die Auswertung von Erdbebendaten. Durch das Lösen dieser Aufgaben können Studierende ihr Verständnis der Bodendynamik und Wellenausbreitung verbessern und ihre Fähigkeit zur Anwendung mathematischer Konzepte in der Ingenieurpraxis entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12Mf0KHrHex6o" ;
    dcterms:subject <http://example.org/education/concept/Bodendynamik>,
        <http://example.org/education/concept/Bodenmechanik>,
        <http://example.org/education/concept/Dynamik>,
        <http://example.org/education/concept/Elastizit%C3%A4t>,
        <http://example.org/education/concept/Erdbeben>,
        <http://example.org/education/concept/Festk%C3%B6rperdynamik>,
        <http://example.org/education/concept/Ingenieurgeologie>,
        <http://example.org/education/concept/Schwingungen>,
        <http://example.org/education/concept/Strukturmechanik>,
        <http://example.org/education/concept/Wellenausbreitung> ;
    dcterms:title "Probeklausur Bodendynamik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

