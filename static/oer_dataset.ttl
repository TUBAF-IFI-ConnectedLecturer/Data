oer:63MERiERArlk a edu:LearningResource ;
    sim:similarTo oer:67asiEvWQUNE,
        oer:6yDSN_Ht5Wo4,
        oer:7NWNUT6XPgXA,
        oer:8OTiIMWePGR4 ;
    dcterms:creator <http://example.org/education/person/Rohrbach> ;
    dcterms:description "Die Arbeit konzentriert sich auf die automatisierte Generierung mathematischer Aufgaben mittels Generativer Künstlicher Intelligenz (GKI) und untersucht, wie die Qualität und Einordnung der Aufgaben maschinell überprüft werden können. Durch diese Arbeit soll erreicht werden, dass Aufgaben im QTI-Format erstellt oder umgewandelt werden können, um das Bereitstellen von Aufgaben zu vereinfachen. Die Ergebnisse dieser Arbeit sollen Lehrenden und Lernenden helfen, individuelle Unterstützung beim Lernen mit sofortigem Feedback zu bieten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "63MERiERArlk" ;
