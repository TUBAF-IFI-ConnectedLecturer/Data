oer:3DB-r99pWiLE a edu:LearningResource ;
    sim:similarTo oer:3zEZKqDTo1aU,
        oer:44bOn1IEUJiY,
        oer:4iU7PFQ1hIY0,
        oer:56WpE4QqH8Yc,
        oer:9wGQwH-t-3K8 ;
    dcterms:creator <http://example.org/education/person/Beutel>,
        <http://example.org/education/person/Melzer> ;
    dcterms:description "Schülerinnen und Schüler lernen durch die Bearbeitung des Socio-Scientific-Issues \"Nitratbelastung von Grundwasser\" die Bedeutung von Wasser für das Leben aller Lebewesen und die Auswirkungen von Nitratsalzen auf den Menschen und die Umwelt. Sie erkennen, dass Wasser nicht gleich Wasser ist, sondern Inhaltsstoffe wie Salze enthält, die bei übermäßigem Konsum gesundheitsschädlich sein können. Durch die Auseinandersetzung mit diesem Thema gewinnen sie Einblicke in chemische Reaktionen, Stoffeigenschaften und Umweltauswirkungen und entwickeln ihre Fähigkeit zur kritischen Reflexion und Problemlösung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3DB-r99pWiLE" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kotoxikologie>,
        <http://example.org/education/concept/Abwasserbehandlung>,
        <http://example.org/education/concept/Bildung_f%C3%BCr_nachhaltige_Entwicklung>,
        <http://example.org/education/concept/Chemische_Reaktionen>,
        <http://example.org/education/concept/Eutrophierung>,
        <http://example.org/education/concept/Nachhaltige_Entwicklung>,
        <http://example.org/education/concept/Schadstoffe>,
        <http://example.org/education/concept/Stickstoffkreislauf>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Wasserreinigung> ;
    dcterms:title "Schalenmodell, Atombindung, Dipole und die Oktettregel."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3JEXb2-i-ASE a edu:LearningResource ;
    sim:similarTo oer:3RbE6wPqMly4,
        oer:3jrwqG_8-m9Y,
