        <http://example.org/education/concept/Psychologische_Tests>,
        <http://example.org/education/concept/Schulnoten>,
        <http://example.org/education/concept/Soziale_Intelligenz>,
        <http://example.org/education/concept/kognitive_F%C3%A4higkeiten> ;
    dcterms:title "Emotionsmanagement (Fähigkeit, eigene Emotionen zu steuern)"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

