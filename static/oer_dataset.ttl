        <http://example.org/education/concept/Recht_auf_Datenschutz> ;
    dcterms:title "Einführung in eAssessment"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:1bDH5JdxmyTw a edu:LearningResource ;
    sim:similarTo oer:3rjdleBUPFKI,
        oer:7j01GgGvMEiE ;
    dcterms:description "Dieses Dokument präsentiert die grundlegenden Rechenregeln für Vektoren im zweidimensionalen Raum R2, einschließlich der Kommutativität, Assoziativität und Distributivität von Vektoroperationen. Es werden acht Regeln aufgeführt, die die algebraischen Eigenschaften von Vektoren beschreiben. Durch das Studium dieser Regeln können Lernende ein Verständnis für die grundlegenden Operationen mit Vektoren entwickeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1bDH5JdxmyTw" ;
    dcterms:subject <http://example.org/education/concept/Abstrakte_Algebra>,
        <http://example.org/education/concept/Algebraische_Struktur>,
        <http://example.org/education/concept/Assoziativit%C3%A4t>,
        <http://example.org/education/concept/Kommutativit%C3%A4t>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Neutraler_Vektor>,
        <http://example.org/education/concept/Reelle_Zahlen>,
        <http://example.org/education/concept/Vektoren>,
        <http://example.org/education/concept/Vektorraum> ;
    dcterms:title "Rechenregeln in R2"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:1mOIfdfft_8w a edu:LearningResource ;
    dcterms:description "Das Gauß-Jordan-Verfahren wird beschrieben, um die inverse Matrix einer gegebenen Matrix A zu bestimmen. Durch elementare Zeilenumformungen wird die Matrix (AE) in die Form (EB) umgeformt, wodurch die inverse Matrix B berechnet werden kann. Dieses Verfahren ermöglicht es, die inverse Matrix einer Matrix zu finden, sofern sie existiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1mOIfdfft_8w" ;
    dcterms:subject <http://example.org/education/concept/Algebraische_Strukturen>,
        <http://example.org/education/concept/Elementare_Zeilenumformungen>,
        <http://example.org/education/concept/Gau%C3%9F-Jordan-Verfahren>,
        <http://example.org/education/concept/Inverse_Matrix>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Lineare_Transformationen>,
        <http://example.org/education/concept/Mathematische_Analyse>,
        <http://example.org/education/concept/Matrix>,
        <http://example.org/education/concept/Matrizenrechnung>,
        <http://example.org/education/concept/Numerische_Mathematik> ;
    dcterms:title "Inverse Matrix Gauß-Jordan-Verfahren"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

