oer:1659LasZbBKdY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Berk>,
        <http://example.org/education/person/Pelz>,
        <http://example.org/education/person/Toulmin> ;
    dcterms:description "Diese Argumentationstechniken helfen bei der Strukturierung von Präsentationen und unterstützen die Überzeugungskraft durch eine logische Reihenfolge von Argumenten. Durch die Anwendung dieser Techniken können Lernende ihre Meinung ändern, neues Wissen erwerben oder ihr Verhalten ändern. Die vorgestellten Methoden wie die logische Folgerung, der Kompromiss und die Ausklammerung ermöglichen es, eine überzeugende Argumentation aufzubauen und Ziele zu erreichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1659LasZbBKdY" ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cberzeugungstechniken>,
        <http://example.org/education/concept/Argumentationstechniken>,
        <http://example.org/education/concept/Entscheidungsfindung>,
