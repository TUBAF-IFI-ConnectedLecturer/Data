        <http://example.org/education/concept/Stromversorgung>,
        <http://example.org/education/concept/elektrische_Maschinen> ;
    dcterms:title "Nmenn und Indexierung von Drehstrommaschinen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

