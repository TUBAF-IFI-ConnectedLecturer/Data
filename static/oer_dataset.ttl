    dcterms:creator <http://example.org/education/person/Bertrand>,
        <http://example.org/education/person/Bombach>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übung behandelt die Anwendung von Fourier- und Laplacetransformationen auf verschiedene Funktionen und Differentialgleichungen. Durch die Lösung der Aufgaben können Studierende ihre Fähigkeiten im Bereich der mathematischen Analysis und der Lösung von Anfangswertproblemen verbessern. Insbesondere werden Kenntnisse über die Fouriertransformation, die Laplacetransformation und ihre Anwendung in der Lösung von Differentialgleichungen vermittelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4kg0nCX4Z3qY" ;
