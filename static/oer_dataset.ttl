    dcterms:creator <http://example.org/education/person/M%C3%BCnster>,
        <http://example.org/education/person/Malchow> ;
    dcterms:description "Die Erstellung einer bibliographischen Katalogisierung und Indexierung für akademische Zwecke wird unterstützt durch die Entwicklung von Aufgabenstellungen zum Thema Wissenschaft Informatik. Durch die Bearbeitung dieser Aufgaben können Lerner grundlegende Modellierungstechniken, wie das Relationenmodell und ER-Diagramm, anwenden und ihre Fähigkeiten in der Datenbank-Entwicklung und -Analyse verbessern. Zudem werden sie befähigt, sich zu Fragen der Datennutzung und des Datenschutzes zu positionieren und die Auswirkungen von Technologie auf Gesellschaft und Wirtschaft zu reflektieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8OTiIMWePGR4" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Datenanalyse>,
        <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datenschutzgesetz>,
        <http://example.org/education/concept/ER-Diagramm>,
        <http://example.org/education/concept/Informatik>,
        <http://example.org/education/concept/Java-Anwendungen>,
        <http://example.org/education/concept/QR-Codes>,
        <http://example.org/education/concept/Relationenmodell>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Temperatursensoren> ;
    dcterms:title "Wissenschaft Informatik als mündliche Prüfung im Abitur"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

