        <http://example.org/education/concept/Morphologie>,
        <http://example.org/education/concept/R%C3%B6misch-deutsches_Reich>,
        <http://example.org/education/concept/Syntax> ;
    dcterms:title "UE Einführung in die germanistische Sprachwissenschaft WiSe 2024"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:5tb6umR0gOeg a edu:LearningResource ;
    sim:similarTo oer:8V12n0GK9sQw ;
    dcterms:creator <http://example.org/education/person/Tsapaeva> ;
    dcterms:description "Die historische Semantik der Jagdterminologie wird untersucht, um die Entwicklung von Fachsprachen und Sondersprachen im Mittelalter zu verstehen. Durch die Analyse von Quellen und Lexika werden die Entlehnungen aus dem Französischen und die indigenen Ausdrücke in der mittelhochdeutschen Sprache aufgezeigt. Die Lernenden gewinnen Einblick in die soziale Bewertung der Jagd, die höfische Kultur und die Herausbildung von Fachsprachen im Mittelalter."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5tb6umR0gOeg" ;
    dcterms:subject <http://example.org/education/concept/Adelsgeschichte>,
        <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Fachsprache>,
        <http://example.org/education/concept/Geschichte_der_Jagd>,
        <http://example.org/education/concept/H%C3%B6fische_Kultur>,
        <http://example.org/education/concept/Historische_Semantik>,
        <http://example.org/education/concept/Jagd>,
        <http://example.org/education/concept/Jagdsprache>,
        <http://example.org/education/concept/Lexikographie>,
        <http://example.org/education/concept/Mittelhochdeutsch> ;
    dcterms:title "Historische Semantik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:657d57g6IfTE a edu:LearningResource ;
    sim:similarTo oer:6BEqZgxewvo8 ;
    dcterms:creator <http://example.org/education/person/Neugebauer> ;
    dcterms:description "Die Getter-Setter-Methoden ermöglichen die Kapselung von Attributen und bieten Möglichkeiten zur Zugriffssteuerung und Fehlererkennung. Durch die Verwendung von Setter-Methoden kann das Verhalten bei Änderungen von Attributen beeinflusst werden, während Getter-Methoden den Zugriff auf Attribute steuern. Die Anwendung dieser Methoden in Java-Klassen unterstützt eine saubere und sichere Programmierung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "657d57g6IfTE" ;
    dcterms:subject <http://example.org/education/concept/Datenkapselung>,
        <http://example.org/education/concept/Getter-Setter-Methoden>,
        <http://example.org/education/concept/Java>,
        <http://example.org/education/concept/Klassen>,
        <http://example.org/education/concept/Objektorientierte_Programmierung>,
        <http://example.org/education/concept/Packages>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Vererbung>,
        <http://example.org/education/concept/Zugriffsrechte> ;
    dcterms:title "Programmierung I"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:6AZOj2Jywvrc a edu:LearningResource ;
    sim:similarTo oer:7oOq7_6IJR3E ;
    dcterms:creator <http://example.org/education/person/Scheffel> ;
    dcterms:description "Das Seminar \"Neurobiologie individueller Unterschiede\" behandelt die Forschungsfelder der Neurobiologie und vermittelt Kenntnisse über neurobiologische Einflussfaktoren auf individuelle Unterschiede in Temperament, Kognition und Sozialverhalten. Die Studierenden erwerben Fähigkeiten bei der Analyse neurobiologischer Parameter und lernen, Fragestellungen prägnant zu präsentieren und kritisch zu diskutieren. Durch das Seminar sollen die Teilnehmer eine Basis für die Realisierung eigener Projektideen erarbeiten und einen Überblick über aktuelle Forschungsfelder im Bereich der Neurobiologie individueller Unterschiede erhalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6AZOj2Jywvrc" ;
    dcterms:subject <http://example.org/education/concept/Differentielle_Psychologie>,
        <http://example.org/education/concept/Emotionsregulation>,
        <http://example.org/education/concept/Forschungsmethoden>,
        <http://example.org/education/concept/Hochschullehre>,
        <http://example.org/education/concept/Kognitive_Psychologie>,
        <http://example.org/education/concept/Neurobiologie>,
        <http://example.org/education/concept/Pers%C3%B6nlichkeitspsychologie>,
        <http://example.org/education/concept/Psychologische_Forschung>,
        <http://example.org/education/concept/Seminare>,
        <http://example.org/education/concept/Wissenschaftliches_Arbeiten> ;
    dcterms:title "EINFÜHRUNG M.Sc. Christoph Scheffel"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6FlfQuqp_fG0 a edu:LearningResource ;
    sim:similarTo oer:8RCwGTxWabDo ;
    dcterms:creator <http://example.org/education/person/Hirsch> ;
    dcterms:description "Dieses Dokument behandelt die Berechnung von Wasserständen und Abflüssen in einem Flussabschnitt unter Berücksichtigung hydrologischer und hydraulischer Randbedingungen. Durch die Lösung von Aufgabenstellungen können Lernende die Grundlagen der Technischen Hydromechanik und des Wasserbaus erlernen und anwenden. Die Berechnungen umfassen die Bestimmung des Bemessungshochwasserabflusses, die Ermittlung der Wasserstand-Abfluss-Beziehung und die Analyse von Windstau-Effekten auf ein Reservoir."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6FlfQuqp_fG0" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Bauingenieurwesen> ;
    dcterms:subject <http://example.org/education/concept/Freibordbemessung>,
        <http://example.org/education/concept/Gew%C3%A4sserkunde>,
        <http://example.org/education/concept/Hochwasserabfluss>,
        <http://example.org/education/concept/Hydrologie>,
        <http://example.org/education/concept/Hydromechanik>,
        <http://example.org/education/concept/Ingenieurwesen>,
        <http://example.org/education/concept/Stauanlage>,
        <http://example.org/education/concept/Wasserbau>,
        <http://example.org/education/concept/Wasserstand-Abfluss-Beziehung>,
        <http://example.org/education/concept/Windstau> ;
    dcterms:title "Aufgabenstellung über OPAL Modul BIW2-08: Grundlagen der Technischen Hydromechanik und des Wasserbaus"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6Mc1tFLtfsCo a edu:LearningResource ;
    sim:similarTo oer:7i00Q-WpSkLg ;
    dcterms:description "Dieses Lehrmaterial behandelt grundlegende Konzepte der Wirtschaft und des Managements, einschließlich der Unterscheidung zwischen Erzeugnissen und Waren, der Definition von Stakeholdern und dem ökonomischen Prinzip. Es umfasst auch Themen wie die Produktivität und Wirtschaftlichkeit von Mitarbeitern, die Zielsetzung in Unternehmen und die Analyse von Entscheidungssituationen mittels Nutzenmatrizen. Durch das Studium dieses Materials können Lerner ein grundlegendes Verständnis der wirtschaftlichen Grundlagen und Managementkonzepte erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6Mc1tFLtfsCo" ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomie>,
        <http://example.org/education/concept/Betriebswirtschaftslehre>,
        <http://example.org/education/concept/Entscheidungsfindung>,
        <http://example.org/education/concept/Management>,
        <http://example.org/education/concept/Marktanalyse>,
        <http://example.org/education/concept/Produktivit%C3%A4t>,
        <http://example.org/education/concept/Risikobewertung>,
        <http://example.org/education/concept/Unternehmensf%C3%BChrung>,
        <http://example.org/education/concept/Wirtschaftlichkeit>,
        <http://example.org/education/concept/Zielsetzung> ;
    dcterms:title "Aufgaben zur Vorlesung \"Grundlagen der Betriebswirtschaftslehre\""@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:6Qs7Xe0orIxI a edu:LearningResource ;
    sim:similarTo oer:9GpKZdKJ_keA ;
    dcterms:creator <http://example.org/education/person/Sch%C3%A4fer-Kunz> ;
    dcterms:description "Die Materialwirtschaft befasst sich mit der Beschaffung und Logistik von Gütern für alle Bereiche und Kunden eines Unternehmens, um die Versorgung und Entsorgung sicherzustellen. Durch die Anwendung von Entscheidungsregeln wie Laplace-, Maximin- und Minimax-Regel können Unternehmen unter Ungewissheit entscheiden und Risiken minimieren. Die optimale Bestellmenge kann durch die Berücksichtigung von Lager- und Bestellkosten ermittelt werden, um Kosten zu reduzieren und die Logistik zu optimieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6Qs7Xe0orIxI" ;
    dcterms:subject <http://example.org/education/concept/Beschaffung>,
        <http://example.org/education/concept/Bestellpolitik>,
        <http://example.org/education/concept/Einkaufspreis>,
        <http://example.org/education/concept/Inventur>,
        <http://example.org/education/concept/Just-in-Time-Produktion>,
        <http://example.org/education/concept/Lagerhaltung>,
        <http://example.org/education/concept/Lagerkosten>,
        <http://example.org/education/concept/Logistik>,
        <http://example.org/education/concept/Materialwirtschaft>,
        <http://example.org/education/concept/Risikoentscheidung> ;
    dcterms:title "Grundlagen der Betriebswirtschaftslehre Vertiefung Entscheidungstheorie"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

