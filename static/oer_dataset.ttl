        <http://example.org/education/concept/Raumbezug>,
        <http://example.org/education/concept/Spline-Interpolation> ;
    dcterms:title "Grundlagen GIS  TU Bergakademie Freiberg"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

