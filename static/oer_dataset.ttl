oer:4NKCikDwqdr0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kolb> ;
    dcterms:description "Der Lernstile-Test nach David Kolb ermöglicht es, den eigenen Lernstil zu erkennen und vier verschiedene Lernphasen als Zyklus zu absolvieren. Durch die Beantwortung von Fragen kann der individuelle Lernstil ermittelt werden, um erfolgreiches Lernen zu fördern. Die Erkennung des eigenen Lernstils hilft bei der Auswahl geeigneter Lernmethoden und -situationen, um das Lernen effektiver zu gestalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4NKCikDwqdr0" ;
    dcterms:subject <http://example.org/education/concept/Bildungsforschung>,
        <http://example.org/education/concept/Didaktik>,
        <http://example.org/education/concept/Erwachsenenbildung>,
        <http://example.org/education/concept/Erziehungswissenschaft>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/Lernmethoden>,
        <http://example.org/education/concept/Lernstile>,
        <http://example.org/education/concept/P%C3%A4dagogik>,
        <http://example.org/education/concept/Selbstlernkompetenz>,
        <http://example.org/education/concept/Wissenserwerb> ;
    dcterms:title "David Kolb selektiv 1 Test: Welche Lern-Stile haben Sie?"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:4RGR9A8JPshE a edu:LearningResource ;
    sim:similarTo oer:4ySEAJSxTp6c,
        oer:58Z9ZUgE3bp4 ;
    dcterms:description "Dieses Dokument behandelt die antike Welt aus verschiedenen Perspektiven, wie Geschlechtergeschichte, Ernährungsgeschichte und Kindheitsgeschichte, und basiert auf griechischen und lateinischen Quellen. Es bietet eine Einführung in die Geschichte des Mittelmeerraums von der Antike bis zur Römischen Kaiserzeit und behandelt Themen wie politische Ordnung, Frauen in Kulten und Geschlechterrollen. Durch das Studium dieses Dokuments können Lernende ein umfassendes Verständnis der antiken Welt und ihrer komplexen Strukturen erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4RGR9A8JPshE" ;
    dcterms:subject <http://example.org/education/concept/Alte_Geschichte>,
        <http://example.org/education/concept/Antike>,
        <http://example.org/education/concept/Arch%C3%A4ologische_Quellen>,
        <http://example.org/education/concept/Epigraphische_Quellen>,
        <http://example.org/education/concept/Frauen_in_der_Antike>,
        <http://example.org/education/concept/Geschlechtergeschichte>,
        <http://example.org/education/concept/Numismatische_Quellen>,
        <http://example.org/education/concept/Philologische_Quellen>,
        <http://example.org/education/concept/Quellenarten>,
        <http://example.org/education/concept/R%C3%B6mische_Republik> ;
    dcterms:title "Ancient World"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

