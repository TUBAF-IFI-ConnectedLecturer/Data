oer:6i9GFRsJHlUw a edu:LearningResource ;
    sim:similarTo oer:6rzprfpwzz38,
        oer:7fsofecU9RvY,
        oer:816GmnNSeXJQ ;
    dcterms:creator <http://example.org/education/person/Jaenichen> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Bremstechnik im Hochgeschwindigkeitsverkehr und umfasst die Algorithmen der Bremsberechnung sowie experimentelle Methoden der Bremsbewertung. Durch diese Inhalte können Studierende das erforderliche Bremsvermögen für die Zugfahrt und den Zugstillstand verstehen und berechnen. Die Vorlesung bietet eine umfassende Einführung in die Bremstechnik, einschließlich der Bewertungsgrößen für das Bremsvermögen und der Methoden zur Bestimmung des Bremsvermögens."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6i9GFRsJHlUw" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Anhalteweg>,
        <http://example.org/education/concept/Bremsberechnung>,
        <http://example.org/education/concept/Bremstechnik>,
        <http://example.org/education/concept/Experimentelle_Methoden>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Hochgeschwindigkeitsverkehr>,
        <http://example.org/education/concept/Schnellbremsung>,
        <http://example.org/education/concept/Verz%C3%B6gerungsprofil>,
        <http://example.org/education/concept/Zugfahrt> ;
    dcterms:title "Grundlagen der Bremstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6q0fXGCKpKRY a edu:LearningResource ;
    sim:similarTo oer:7ZOFS2nOIcZs ;
    dcterms:description "Die Programmiersprachen werden systematisch nach verschiedenen Kriterien wie Paradigmen, Anwendungsgebieten und Merkmalen klassifiziert, um ihre Eigenschaften und Verwendungszwecke zu verstehen. Durch das Studium dieser Systematik können Lerner die grundlegenden Konzepte der Programmierung erkennen und die passende Sprache für ein bestimmtes Projekt auswählen. Zudem werden wichtige Aspekte wie Compiler- und Interpreter-Arbeitsweise, objektorientierte Programmierung und Softwareentwicklungsprozesse behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6q0fXGCKpKRY" ;
    dcterms:subject <http://example.org/education/concept/Codegenerierung>,
        <http://example.org/education/concept/Compiler>,
        <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Lexikalische_Analyse>,
