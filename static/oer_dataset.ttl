        <http://example.org/education/concept/Nichtlineare_Ausgleichung>,
        <http://example.org/education/concept/Parameteridentifizierung>,
        <http://example.org/education/concept/Zielfunktion>,
        <http://example.org/education/concept/lineare_Regression> ;
    dcterms:title "(Leer)"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

