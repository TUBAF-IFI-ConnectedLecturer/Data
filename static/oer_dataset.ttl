        <http://example.org/education/concept/Fremdsprachenlernen>,
        <http://example.org/education/concept/M%C3%BCndliche_Kommunikation>,
        <http://example.org/education/concept/Schriftliche_Kommunikation>,
        <http://example.org/education/concept/Sprachunterricht>,
        <http://example.org/education/concept/Storytelling>,
        <http://example.org/education/concept/Unterrichtsmaterial> ;
    dcterms:title "Übersicht zum Material Unterrichtsfach Deutsch als Zweitsprache (DaZ)"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

