oer:8pQLDKXCH_c0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Johansson>,
        <http://example.org/education/person/Willer> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Infrarot-Technologie und ihre Anwendungen in verschiedenen Bereichen wie Militär, Industrie, Medizin und Wissenschaft. Die Studierenden lernen die physikalischen Grundlagen der Infrarotstrahlung, die Messgrößen und -methoden sowie die verschiedenen Arten von Infrarotsensoren und -kameras kennen. Durch das Verständnis dieser Konzepte können sie die Infrarot-Technologie in ihrer beruflichen Praxis anwenden, um Prozesse zu überwachen, Temperaturen zu messen und Bilder zu erstellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8pQLDKXCH_c0" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Bildverarbeitung>,
        <http://example.org/education/concept/Infrarot-Strahlung>,
        <http://example.org/education/concept/Infrarotsensoren>,
        <http://example.org/education/concept/Optische_Messverfahren>,
        <http://example.org/education/concept/Strahlungsgr%C3%B6%C3%9Fen>,
        <http://example.org/education/concept/Temperaturmessung>,
        <http://example.org/education/concept/Thermografie>,
        <http://example.org/education/concept/W%C3%A4rmestrahlung> ;
    dcterms:title "IR-Messtechnik 0. Einführung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8pua0E6UrrfM a edu:LearningResource ;
    dcterms:description "Die Inflation kann durch Angebots- und Nachfrageschocks erzeugt werden und hat reale Kosten wie Menu Cost und Schuhsohlenkosten. Der Tradeoff zwischen Inflation und Output existiert allenfalls kurzfristig, während sich Erwartungen anpassen und Inflationierung nicht zu mehr Output führt. Durch das Studium dieser Materialien können Lerner die Faktoren verstehen, die Inflation erklären, und die Kosten der Inflation erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8pua0E6UrrfM" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomie>,
        <http://example.org/education/concept/Angebotsschock>,
        <http://example.org/education/concept/Fiskalpolitik>,
        <http://example.org/education/concept/Geldmengenwachstum>,
        <http://example.org/education/concept/Geldpolitik>,
        <http://example.org/education/concept/Inflation>,
        <http://example.org/education/concept/Nachfragekomponenten>,
        <http://example.org/education/concept/Preisindex>,
        <http://example.org/education/concept/Staatsfinanzen>,
        <http://example.org/education/concept/Wirtschaftswachstum> ;
    dcterms:title "Inflation"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:8q9qdNq1mYbA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kuper> ;
    dcterms:description "Die Übung behandelt das Thema Unicode und die Verwendung nicht-lateinischer Zeichensätze. Die Aufgabe besteht darin, drei verschiedene Zeichensätze auszuwählen und eine Zeichenkette mit mindestens 5 Zeichen in jedem Zeichensatz zu erzeugen. Durch diese Übung können Lerner das Konzept von Unicode und die Anwendung nicht-lateinischer Zeichensätze in der Datenverarbeitung verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8q9qdNq1mYbA" ;
    dcterms:subject <http://example.org/education/concept/Buginesisch>,
        <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datenmanagement>,
        <http://example.org/education/concept/Informationstechnologie>,
        <http://example.org/education/concept/Kodierung>,
        <http://example.org/education/concept/Nicht-Lateinische_Schriften>,
        <http://example.org/education/concept/Sprachcodes>,
        <http://example.org/education/concept/Textverarbeitung>,
        <http://example.org/education/concept/Unicode>,
        <http://example.org/education/concept/Zeichens%C3%A4tze> ;
    dcterms:title "Datenmanagement und Datenbanken SoSe 2022 (KW 17) Übung 4 Unicode Aufgabe 1"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8qaa1dm1iz4Q a edu:LearningResource ;
    dcterms:description "Dieses Lehrmaterial behandelt grundlegende Konzepte der Mikroökonomie, einschließlich Produktionsfaktoren, Technologien und Indifferenzkurven, um die Entscheidungsfindung von Unternehmen und Landwirten zu erklären. Durch die Bearbeitung von Aufgaben und Beispielen können Lernende das Verständnis ökonomischer Modelle und ihre Anwendung in verschiedenen Szenarien verbessern. Die Inhalte dienen der Vorbereitung auf Klausuren und Übungen im Bereich der Mikroökonomie."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8qaa1dm1iz4Q" ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomische_Modelle>,
        <http://example.org/education/concept/Indifferenzkurve>,
        <http://example.org/education/concept/Isokosten-Kurve>,
        <http://example.org/education/concept/Kapitalismus>,
        <http://example.org/education/concept/Landwirtschaft>,
        <http://example.org/education/concept/Mikro%C3%B6konomie>,
