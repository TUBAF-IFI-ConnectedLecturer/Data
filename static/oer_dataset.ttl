        <http://example.org/education/concept/kognitiver_Prozess> ;
    dcterms:title "Arbeitsblatt Didaktische Herausforderungen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9jUftCDAzhCA a edu:LearningResource ;
    dcterms:description "Mit Hilfe der Geometriesoftware können Schülerinnen die Auswirkungen von Graphen selbstständig erforschen und eigenständig die Funktion des Graphen erarbeiten. Durch den Einsatz des Schiebereglers können sie Veränderungen am Graphen beobachten und Lösungen ableiten. Dieses Material eignet sich besonders gut dafür, weil es individuelles Arbeiten und Ausprobieren ermöglicht und somit selbstständiges Lernen fördert."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9jUftCDAzhCA" ;
    dcterms:subject <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Geometriesoftware>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Interaktive_Medien>,
        <http://example.org/education/concept/Koordinatensysteme>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Mathematische_Modellierung>,
        <http://example.org/education/concept/Schulische_Bildung.>,
        <http://example.org/education/concept/Selbstst%C3%A4ndiges_Lernen>,
        <http://example.org/education/concept/lineare_Gleichungssysteme> ;
    dcterms:title "Materialhandreichung: Geometriesoftware zu Auswirkungen von Graphen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:9od5iuFCNLp0 a edu:LearningResource ;
    dcterms:description "Das GIF zeigt die Auswirkung des Trägheitsmomentes auf die Winkelgeschwindigkeit eines sich drehenden Eiskunstläufers und kann im Unterricht eingesetzt werden, um Schülern das Prinzip zu verdeutlichen. Durch die Verwendung dieses GIFs können SuS die grundlegenden Funktionsweise von Kreisbewegungen besser verstehen. Das Material ist besonders geeignet für den Einsatz im Physik- und Sportunterricht."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "9od5iuFCNLp0" ;
    dcterms:subject <http://example.org/education/concept/Bewegungslehre>,
        <http://example.org/education/concept/Drehimpuls>,
        <http://example.org/education/concept/Eiskunstlauf>,
        <http://example.org/education/concept/Kreisbewegung>,
        <http://example.org/education/concept/Mechanik>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Sportunterricht>,
        <http://example.org/education/concept/Tr%C3%A4gheitsmoment>,
        <http://example.org/education/concept/Unterrichtsmaterial>,
        <http://example.org/education/concept/Winkelgeschwindigkeit> ;
    dcterms:title "Kurzbeschreibung eines GIFs zum Trägheitsmoment bei Eiskunstläufern"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

