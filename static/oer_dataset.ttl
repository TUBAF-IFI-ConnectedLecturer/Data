oer:10icN5i99wDUk a edu:LearningResource ;
    sim:similarTo oer:10u2FLKt0ieZs,
        oer:10w0l3DCqcr4I,
        oer:10xw09Htu2BAo,
        oer:127Eotvpi1DTE,
        oer:4RtUVvUILKSU ;
    dcterms:description "Das Gedächtnis als mentale Fähigkeit, Informationen aufzunehmen, zu speichern und wiederzugeben, kann mittels künstlicher neuronaler Netzwerke erforscht und simuliert werden. Durch Lern- und Vergessensprozesse können biologische Relevanz besitzende Erfahrungen und Wissensinhalte im Zentralnervensystem gespeichert werden. Die Kenntnis der Funktionsweise des Gedächtnisses hilft bei der Optimierung von Lernprozessen und dem Verständnis von Erinnerungs- und Vergessensphänomenen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10icN5i99wDUk" ;
    dcterms:publisher <http://example.org/education/organization/USEB_HS_Zittau> ;
    dcterms:subject <http://example.org/education/concept/Engramme>,
        <http://example.org/education/concept/Ged%C3%A4chtnis>,
        <http://example.org/education/concept/Informationsverarbeitung>,
        <http://example.org/education/concept/Kognitionswissenschaft>,
        <http://example.org/education/concept/Kurzzeitged%C3%A4chtnis>,
        <http://example.org/education/concept/Langzeitged%C3%A4chtnis>,
        <http://example.org/education/concept/Lernpsychologie>,
        <http://example.org/education/concept/Neuronale_Netzwerke>,
        <http://example.org/education/concept/Wahrnehmungspsychologie>,
        <http://example.org/education/concept/Zentralnervensystem> ;
    dcterms:title "Lernen und Gedächtnis"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:10oQSo2mexrDk a edu:LearningResource ;
    sim:similarTo oer:10rJQY58ku9MQ,
        oer:10yLo231CnA9k,
        oer:4XqF74yv38yA ;
    dcterms:creator <http://example.org/education/person/Hirte> ;
    dcterms:description "Die Neue Ökonomische Geographie (NÖG) erklärt die räumliche Struktur einer Ökonomie durch mikroökonomische Effekte wie Skaleneffekte, Transportkosten, Marktmacht und Mobilität von Kunden und Anbietern. Durch das Verständnis dieser Theorie können Lerner den Einfluss von Integration auf die räumliche Struktur einer Ökonomie nachvollziehen und die Hypothesen zum Einfluss von Handels- und Transportkosten auf die Standortwahl von Firmen und Arbeitnehmern verstehen. Die NÖG bietet somit ein wichtiges Werkzeug zur Analyse der räumlichen Allokation von ökonomischen Aktivitäten und ihrer Veränderungen durch Integration."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10oQSo2mexrDk" ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomische_Geographie>,
        <http://example.org/education/concept/Agglomerationseffekte>,
        <http://example.org/education/concept/Allgemeines_Gleichgewichtsmodell>,
        <http://example.org/education/concept/Handelskosten>,
        <http://example.org/education/concept/Integrationstheorie>,
        <http://example.org/education/concept/Mikro%C3%B6konomie>,
        <http://example.org/education/concept/Neue_%C3%96konomische_Geographie>,
        <http://example.org/education/concept/R%C3%A4umliche_%C3%96konomie>,
        <http://example.org/education/concept/Skaleneffekte>,
        <http://example.org/education/concept/Transportkosten> ;
    dcterms:title "Europäische Integration und regionale Entwicklung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

