        <http://example.org/education/concept/Linguistik>,
        <http://example.org/education/concept/Mittelalter>,
        <http://example.org/education/concept/Sprachwandel> ;
    dcterms:title "Historische Semantik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

