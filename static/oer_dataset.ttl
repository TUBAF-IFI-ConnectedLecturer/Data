oer:129YOCGIiq4Bg a edu:LearningResource ;
    sim:similarTo oer:12Mf0KHrHex6o,
        oer:12RFMLWTox8sg,
        oer:12Wn0DS9CMUaM,
        oer:12ri2IFIcDe_k,
        oer:12x-HTkYDl5oM,
        oer:12xYDaZDbZc-Y,
        oer:12xqSyjOxIoIQ,
        oer:12yYzT1YKcjes,
        oer:6lq3Ajojjy4E ;
    dcterms:creator <http://example.org/education/person/Kern>,
        <http://example.org/education/person/Nagel> ;
    dcterms:description "Die Vorlesung Bodendynamik behandelt die experimentelle und numerische Erfassung von Bodeneigenschaften, indem sie verschiedene Messverfahren wie Refraktionsseismik, Zyklische Zug- und Torsionsversuche sowie Modellversuche vorstellt. Durch diese Methoden können dynamische Bodenkennwerte wie Elastizitätsparameter, Dämpfung und Schubspannungszustand bestimmt werden. Die Vorlesung vermittelt den Studierenden ein Verständnis der bodendynamischen Prozesse und ihre Anwendung in der Geotechnik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "129YOCGIiq4Bg" ;
    dcterms:subject <http://example.org/education/concept/Bodendynamik>,
        <http://example.org/education/concept/Bodenmechanik>,
        <http://example.org/education/concept/Bohrlochmessungen>,
        <http://example.org/education/concept/Geophysik>,
        <http://example.org/education/concept/Geotechnik>,
        <http://example.org/education/concept/Materiald%C3%A4mpfung>,
        <http://example.org/education/concept/Refraktion>,
        <http://example.org/education/concept/Schwingungs%C3%BCbertragung>,
        <http://example.org/education/concept/Seismik>,
        <http://example.org/education/concept/Wellenausbreitung> ;
    dcterms:title "Vorlesung Bodendynamik Sommersemester 2023"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:12EyFsjjNd_y8 a edu:LearningResource ;
    sim:similarTo oer:12UsnfMH5alxY,
        oer:12VKjfJClNzgg,
        oer:12Vq8BBfxSDfQ,
        oer:12Wn0DS9CMUaM,
        oer:12trc5E-lHZ0c,
        oer:12xYDaZDbZc-Y,
        oer:4_ik7D6a_8ow ;
    dcterms:creator <http://example.org/education/person/Kern>,
        <http://example.org/education/person/Nagel> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen der Bodendynamik und vermittelt ein Verständnis für die Wellenausbreitung im Erdkörper, einschließlich P-Wellen, S-Wellen, Rayleigh-Wellen und Love-Wellen. Durch die Lektüre dieser Vorlesung können Studierende die physikalischen Prinzipien der Seismik verstehen und ihre Anwendung in der Geotechnik und Erdbebenauswertung erkennen. Die Inhalte umfassen auch die kinematischen und dynamischen Aspekte der Wellenausbreitung, Reflexion und Transmission an Übergängen sowie die Auswirkungen auf den Boden und die Umgebung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12EyFsjjNd_y8" ;
    dcterms:subject <http://example.org/education/concept/Bodendynamik>,
        <http://example.org/education/concept/Bodenmechanik>,
        <http://example.org/education/concept/Elastizit%C3%A4tstheorie>,
        <http://example.org/education/concept/Geotechnik>,
        <http://example.org/education/concept/Kontinuumsmechanik>,
        <http://example.org/education/concept/P-Wellen>,
        <http://example.org/education/concept/Rayleigh-Wellen>,
        <http://example.org/education/concept/S-Wellen>,
        <http://example.org/education/concept/Seismologie>,
        <http://example.org/education/concept/Wellenausbreitung>,
        <http://example.org/education/concept/elastische_Wellen> ;
    dcterms:title "Vorlesung Bodendynamik Sommersemester 2023"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:12KEn1PTJuBqA a edu:LearningResource ;
    sim:similarTo oer:12TgBkvhFWJLA,
        oer:12djGNGDPWabU,
        oer:13OpBQTD3rBnA,
        oer:17_3VgcUFw-_E,
        oer:32AdYV6jW83Y ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Klausuraufgaben behandeln Strömungsprobleme der Mechanischen Verfahrenstechnik und konzentrieren sich auf die Emulgierung einer Sonnenblumenöl-in-Wasser-Emulsion mit einem Scheibenrührer. Die Aufgaben umfassen die Berechnung der Rührerleistung, der massenspezifischen Energiedissipation und des Emulgatorbedarfs sowie die Bestimmung der maximalen Tropfengröße unter Berücksichtigung von Turbulenzelementen und viskosen Eigenschaften. Durch das Lösen dieser Aufgaben können Studierende ihr Verständnis von Strömungsproblemen und Emulgierprozessen verbessern und ihre Fähigkeiten in der Anwendung physikalischer Grundlagen und mathematischer Modelle stärken."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12KEn1PTJuBqA" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Emulgatoren>,
        <http://example.org/education/concept/Emulsionstechnik>,
        <http://example.org/education/concept/Energie%C3%BCbertragung>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Oberfl%C3%A4chenspannung>,
        <http://example.org/education/concept/Partikelbildung>,
        <http://example.org/education/concept/R%C3%BChrtechnik>,
        <http://example.org/education/concept/Str%C3%B6mungsmechanik>,
        <http://example.org/education/concept/Turbulenz>,
        <http://example.org/education/concept/Viskosit%C3%A4t> ;
    dcterms:title "Klausuraufgaben Strömungsprobleme der MVT"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:12KqTU9doxa-A a edu:LearningResource ;
    sim:similarTo oer:12tQiefgBOTOM,
        oer:7BcIE5VX2h6U,
        oer:7v8U2x8tGrOU ;
    dcterms:creator <http://example.org/education/person/%C3%96hmann> ;
    dcterms:description "Die Vertretung der mit c (bzw. ç) bezeichneten französischen Affrikata und Spiranten im Deutschen wird untersucht, wobei die Entwicklung des Lautwerts von c im Französischen und seine Auswirkungen auf die deutsche Sprache analysiert werden. Durch das Studium dieser Entwicklung können Leser ein tieferes Verständnis der historischen Beziehungen zwischen dem Französischen und Deutschen erlangen und die Entlehnung von Fremdwörtern besser verstehen. Insbesondere wird die Bedeutung des Überganges von ts zu s im Französischen für die deutsche Sprache aufgezeigt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12KqTU9doxa-A" ;
    dcterms:subject <http://example.org/education/concept/Deutsche_Sprache>,
        <http://example.org/education/concept/Franz%C3%B6sischer_Einfluss>,
        <http://example.org/education/concept/Geschichte_der_deutschen_Sprache>,
        <http://example.org/education/concept/Mittelhochdeutsch>,
        <http://example.org/education/concept/Neuhochdeutsch>,
        <http://example.org/education/concept/Philologie>,
        <http://example.org/education/concept/Schriftsprache>,
        <http://example.org/education/concept/Sprachkontakt>,
        <http://example.org/education/concept/Sprachwandel>,
        <http://example.org/education/concept/Wortgeschichte> ;
    dcterms:title "Zur Geschichte des französischen Einflusses auf die deutsche Sprache"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

