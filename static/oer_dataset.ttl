    dcterms:creator <http://example.org/education/person/Herzog> ;
    dcterms:description "Dieses Dokument enthält eine Sammlung von Quizfragen und Antworten zum Thema mathematische Optimierung, insbesondere zur Verwendung des Matlab-Verfahrens fminunc. Durch die Bearbeitung dieser Fragen können Lerner ihr Verständnis von Optimierungsproblemen und der Anwendung von fminunc verbessern. Die Themen umfassen die Lösung freier Optimierungsaufgaben, die Überprüfung von Ergebnissen und die Bedeutung von Startschätzungen und Nebenbedingungen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "14Wo_ZlxfDKe0" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Algorithmus>,
        <http://example.org/education/concept/Matlab>,
        <http://example.org/education/concept/Nichtlineare_Programmierung>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Zielfunktionen>,
        <http://example.org/education/concept/freie_Optimierungsaufgaben>,
        <http://example.org/education/concept/globale_Minima>,
        <http://example.org/education/concept/lokale_Minima>,
        <http://example.org/education/concept/mathematische_Modellierung>,
        <http://example.org/education/concept/numerische_Verfahren> ;
    dcterms:title "Fragen und Antworten 1"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

