oer:99XG5IxOQCho a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Roth> ;
    dcterms:description "Das Quiz dient als Vorbereitung auf das Abitur im Fach Sport und behandelt Themen aus der Sporttheorie, insbesondere die Lernbereiche 1, 3 und 4. Durch die wöchentlichen Fragen soll der aktuelle Lernstand ermittelt werden, um gezielt den Schwierigkeitsgrad anzupassen. Die Visualisierung durch Bilder unterstützt das Verständnis komplexer Inhalte, wie beispielsweise die Übung Oberarm-Curl oder Schaubilder wie Superkompensation."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "99XG5IxOQCho" ;
    dcterms:subject <http://example.org/education/concept/Abiturvorbereitung>,
        <http://example.org/education/concept/Biomechanik>,
        <http://example.org/education/concept/Kompetenzorientierte_Bewertung>,
        <http://example.org/education/concept/Lehrer-Sch%C3%BCler-Kommunikation>,
        <http://example.org/education/concept/Lernplattformen>,
        <http://example.org/education/concept/Schulische_Bildung>,
        <http://example.org/education/concept/Sportunterricht>,
        <http://example.org/education/concept/Trainingslehre>,
        <http://example.org/education/concept/Unterrichtsmedien>,
        <http://example.org/education/concept/digitale_Medien> ;
    dcterms:title "Schülerfeedback Artefakt Begründung"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:9HE7VGK9tGQA a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hammerschmidt>,
        <http://example.org/education/person/Kafurke> ;
    dcterms:description "Das Lernmodul behandelt das Thema Ökologie im Kontext des Ökosystems Wald und ermöglicht Schülern der 9. Klasse, ihre Kenntnisse über Lebensräume, Umweltfaktoren und Lebewesen zu erweitern und zu vertiefen. Durch die Bearbeitung des Moduls können Schüler die Begriffe Ökosystem, Lebensraum und Umweltfaktoren erklären, verschiedene Lebensräume und ihre Besonderheiten kennen sowie den Energiefluss im Ökosystem Wald beschreiben. Zudem lernen sie, biotische und abiotische Einflussfaktoren zu unterscheiden und ihre Kenntnisse auf unbekannte Lebewesen anzuwenden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9HE7VGK9tGQA" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologie>,
        <http://example.org/education/concept/%C3%96kosystem>,
        <http://example.org/education/concept/Biologieunterricht>,
        <http://example.org/education/concept/Biotop>,
        <http://example.org/education/concept/Lebensr%C3%A4ume>,
        <http://example.org/education/concept/Lernmodul>,
        <http://example.org/education/concept/Nahrungspyramide>,
        <http://example.org/education/concept/SchulOPAL>,
        <http://example.org/education/concept/Umweltfaktoren>,
        <http://example.org/education/concept/Wald%C3%B6kologie> ;
    dcterms:title "Ökologie - Lehrplan Oberschule, Biologie Klasse 9"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:9TrHPcMQLGuQ a edu:LearningResource ;
    dcterms:description "Dieses Dokument behandelt grundlegende Konzepte der Mengenlehre und Logik, einschließlich Vereinigungs-, Schnitt- und Differenzmengen sowie Aussagenlogik mit Induktionsschritten. Durch das Studium dieses Materials können Lernende ein Verständnis für die Anwendung von mengentheoretischen Konzepten in der Mathematik und Logik entwickeln. Die Beispiele und Aufgaben im Dokument helfen dabei, die theoretischen Grundlagen zu vertiefen und praktische Fähigkeiten zu erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9TrHPcMQLGuQ" ;
    dcterms:subject <http://example.org/education/concept/Aussagenlogik>,
        <http://example.org/education/concept/Boolesche_Algebra>,
        <http://example.org/education/concept/Differenzmenge>,
