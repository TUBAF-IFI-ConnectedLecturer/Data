        <http://example.org/education/concept/Schulstatistik>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/arithmetisches_Mittel> ;
    dcterms:title "Kurzbeschreibung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

