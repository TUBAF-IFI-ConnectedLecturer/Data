oer:11qdwraJKZEuo a edu:LearningResource ;
    sim:similarTo oer:6uctFRBk4GaM ;
    dcterms:creator <http://example.org/education/person/Moritz> ;
    dcterms:description "Das Fuß-Rad-Prinzip zielt auf die Stärkung des Umweltverbunds durch die Förderung von Fuß- und Radverkehr, wobei sicherer und barrierefreier Zugang zu öffentlichen Räumen gewährleistet werden soll. Der Entwurf von Fußverkehrsanlagen umfasst sechs Planungsschritte, die auf die Bedürfnisse aller Verkehrsteilnehmer abgestimmt sind. Durch die Anwendung dieser Prinzipien und Maßnahmen können Lernende Kenntnisse über die Planung und Gestaltung von Fußverkehrsanlagen erwerben, um eine barrierefreie und sichere Mobilität für alle zu ermöglichen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11qdwraJKZEuo" ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentlicher_Verkehr>,
        <http://example.org/education/concept/Barrierefreiheit>,
        <http://example.org/education/concept/Behindertenfreundlichkeit>,
        <http://example.org/education/concept/Fu%C3%9Fverkehr>,
        <http://example.org/education/concept/Infrastruktur>,
        <http://example.org/education/concept/Mobilit%C3%A4t>,
        <http://example.org/education/concept/Nahverkehr>,
        <http://example.org/education/concept/Radverkehr>,
        <http://example.org/education/concept/Stadtplanung>,
        <http://example.org/education/concept/Verkehrsplanung> ;
    dcterms:title "Fuß-Rad-Prinzip"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:11sRiT6Y_4AHc a edu:LearningResource ;
