    dcterms:creator <http://example.org/education/person/Zeidler> ;
    dcterms:description "Die Vorlesung \"Design für die Additive Fertigung\" behandelt die Grundlagen der additiven Fertigung und ihre Anwendung in der industriellen Produktion. Durch diese Vorlesung sollen Studierende ein Verständnis dafür entwickeln, wie additive Fertigungsprozesse funktionieren und wie sie in verschiedenen Branchen eingesetzt werden können. Sie lernen außerdem, die Vorteile und Nachteile dieser Technologie zu bewerten und ihre Anwendung in der Praxis zu planen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7-FB-_bhwayw" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/3D-Druck>,
        <http://example.org/education/concept/Additive_Fertigung>,
        <http://example.org/education/concept/Fertigungsplanung>,
        <http://example.org/education/concept/Fertigungstechnik>,
        <http://example.org/education/concept/Getriebe>,
        <http://example.org/education/concept/Langlebigkeit>,
        <http://example.org/education/concept/Produktionsqualit%C3%A4t>,
        <http://example.org/education/concept/Selektives_Laserschmelzen>,
        <http://example.org/education/concept/Zahnr%C3%A4der>,
        <http://example.org/education/concept/Zuverl%C3%A4ssigkeit> ;
    dcterms:title "Design für die Additive Fertigung"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

