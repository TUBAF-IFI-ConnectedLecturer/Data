        oer:8zGGrgCCUEjY ;
    dcterms:creator <http://example.org/education/person/Faik>,
        <http://example.org/education/person/Fischer> ;
    dcterms:description "Die Betriebswirtschaftslehre beschäftigt sich mit der Erforschung und Analyse des Wirtschaftens in und von Unternehmen, um die Bedürfnisse der Menschen zu befriedigen. Durch das Studium dieser Disziplin können Lernende die Grundlagen des Wirtschaftens verstehen, wie zum Beispiel die Knappheit von Gütern, die Bedeutung von Märkten und die verschiedenen Arten von Unternehmen. Sie erwerben außerdem Kenntnisse über die Anwendung von Prinzipien wie dem Maximum- und Minimumprinzip, um optimale Entscheidungen treffen zu können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7rkjI9ssjrhE" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
