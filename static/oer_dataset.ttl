        <http://example.org/education/concept/kinematische_Berechnung>,
        <http://example.org/education/concept/statische_Berechnung> ;
    dcterms:title "Einschränkungsberechnung eines Packwagens"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:90XIez_Rhq80 a edu:LearningResource ;
    sim:similarTo oer:91_YQeMeSPgA,
        oer:9D5wu8e6svuw,
        oer:9HreH51NgxaY,
        oer:9YVLtkyFWI18,
        oer:9kN_0mCqkYic,
        oer:9slu5O19Kji4,
        oer:9tAhccX3AbEU ;
    dcterms:creator <http://example.org/education/person/Urbas> ;
    dcterms:description "Die Lehrveranstaltung Systemverfahrenstechnik behandelt die Optimierung von Prozessen und Systemen, indem sie Lösungsverfahren für Flowsheet-Simulationen und Grundlagen von Optimierungsproblemen und -methoden vorstellt. Die Studierenden erwerben Kenntnisse über verschiedene Suchverfahren wie Rastersuchverfahren, Random-Walk Suche und Downhill-Simplex-Verfahren. Durch diese Lehrveranstaltung können sie ihre Fähigkeiten im Bereich der Systemverfahrenstechnik verbessern und komplexe Probleme lösen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "90XIez_Rhq80" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Flowsheet-Simulation>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Mathematische_Modellierung>,
        <http://example.org/education/concept/Nichtlineare_Programmierung>,
        <http://example.org/education/concept/Optimierung>,
        <http://example.org/education/concept/Prozessleittechnik>,
        <http://example.org/education/concept/Regelungstechnik>,
        <http://example.org/education/concept/Simulation>,
        <http://example.org/education/concept/Suchverfahren>,
        <http://example.org/education/concept/Systemverfahrenstechnik> ;
    dcterms:title "Lehrveranstaltung Systemverfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9D5wu8e6svuw a edu:LearningResource ;
    sim:similarTo oer:9HreH51NgxaY,
        oer:9YVLtkyFWI18,
        oer:9kN_0mCqkYic,
        oer:9slu5O19Kji4,
        oer:9tAhccX3AbEU ;
    dcterms:creator <http://example.org/education/person/Biegler>,
        <http://example.org/education/person/Kl%C3%B6den>,
        <http://example.org/education/person/Urbas> ;
    dcterms:description "Die Lehrveranstaltung \"Einführung in die Systemverfahrenstechnik\" behandelt die Grundlagen der systemverfahrenstechnischen Modellierung und Simulation, einschließlich der Strukturierung und Hierarchie verfahrenstechnischer Systeme. Durch diese Veranstaltung erwerben die Lernenden Kenntnisse über die kybernetische Sichtweise auf Systeme, die Elemente und Prozesse von Systemen sowie die mathematischen Modellgleichungen und -gleichungssysteme. Ziel ist es, die Fähigkeit zur Analyse und Simulation komplexer industrieller Stoff- und Energiewandlungsprozesse zu erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9D5wu8e6svuw" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Chemische_Verfahrenstechnik>,
        <http://example.org/education/concept/Ingenieurwissenschaften>,
        <http://example.org/education/concept/Kybernetik>,
        <http://example.org/education/concept/Modellierung>,
        <http://example.org/education/concept/Prozessleittechnik>,
        <http://example.org/education/concept/Simulation>,
        <http://example.org/education/concept/Systemanalyse>,
        <http://example.org/education/concept/Systemtheorie>,
        <http://example.org/education/concept/Systemverfahrenstechnik>,
        <http://example.org/education/concept/Verfahrenstechnik> ;
    dcterms:title "Einführung in die Systemverfahrenstechnik PLTSVT"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:9ZjHDSeGipRg a edu:LearningResource ;
    sim:similarTo oer:9nAhfbEr5HQQ,
        oer:9puwDxajlLA8,
        oer:9tx_ZwEDp02s ;
    dcterms:creator <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Vo%C3%9F>,
        <http://example.org/education/person/Werner> ;
    dcterms:description "Die kollisionssichere Auslegung von Eisenbahnfahrzeugen erfordert die Berücksichtigung physikalischer Grundlagen, wie der Stoßmechanik und Energieumwandlungen, um sicherzustellen, dass Fahrzeuge bei Kollisionen Schäden minimieren und Insassen schützen. Durch die Anwendung von Crashkonzepten und -technologien können Fahrzeughersteller und Ingenieure kollisionssichere Fahrzeuge entwickeln, die den Anforderungen der Normen und Richtlinien entsprechen. Die Umsetzung dieser Konzepte und Technologien kann zu einer Verbesserung der Sicherheit im Eisenbahnbetrieb beitragen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9ZjHDSeGipRg" ;
    dcterms:subject <http://example.org/education/concept/Crashkonzept>,
        <http://example.org/education/concept/Eisenbahnsicherheit>,
        <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Fahrzeugfront>,
        <http://example.org/education/concept/Kollisionsschutz>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Sto%C3%9Fd%C3%A4mpfung>,
        <http://example.org/education/concept/Unfalluntersuchung>,
        <http://example.org/education/concept/Verkehrstechnik>,
        <http://example.org/education/concept/Zugsicherung> ;
    dcterms:title "6. Kollisionsschutzgerechte Konstruktion"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

