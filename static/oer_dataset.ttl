        <http://example.org/education/concept/Unterrichtsplanung>,
        <http://example.org/education/concept/p%C3%A4dagogische_R%C3%BCckmeldung>,
        <http://example.org/education/concept/politische_Bildung> ;
    dcterms:title "Angaben zum Praktikum Lehramt"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:9yDtAm7JR2W8 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Debus>,
        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übung behandelt diskrete Verteilungen und ihre Anwendung auf verschiedene Probleme, wie die Berechnung von Wahrscheinlichkeiten und Erwartungswerten. Durch die Lösung der Aufgaben können Lerner ihr Verständnis von Binomial- und Poissonverteilungen verbessern und erfahren, wie sie in der Praxis eingesetzt werden. Die Übung umfasst sechs Aufgaben, die sich mit verschiedenen Szenarien befassen, wie zum Beispiel die Wahrscheinlichkeit von Treffern bei unabhängigen Versuchen oder die Anzahl von Ausfällen eines Automaten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9yDtAm7JR2W8" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Binomialverteilung>,
        <http://example.org/education/concept/Erwartungswert>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Poisson-Verteilung>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Stochastik>,
        <http://example.org/education/concept/Varianz>,
        <http://example.org/education/concept/Wahrscheinlichkeitsfunktion>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie>,
        <http://example.org/education/concept/diskrete_Verteilungen> ;
    dcterms:title "Mathematik IV (für IF, ET, Ph) Sommersemester 2025 8. Übung: Diskrete Verteilungen"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

