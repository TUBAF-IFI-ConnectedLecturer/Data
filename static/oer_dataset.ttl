oer:8D-6jOBfDYRA a edu:LearningResource ;
    sim:similarTo oer:8pR7-Yeu8iQI ;
    dcterms:creator <http://example.org/education/person/E.>,
        <http://example.org/education/person/G.>,
        <http://example.org/education/person/P.> ;
    dcterms:description "Das Interview mit Otto von Bismarck behandelt die Grundlegung einer modernen Gesellschaft in Wirtschaft und Politik in Deutschland vom Beginn des 19. Jahrhunderts bis zum Ersten Weltkrieg. Durch das Material können Lernende ihre Hörkompetenz trainieren und neue Informationen über die deutsche Politik zur Zeit Bismarcks kennenlernen. Die Verwendung setzt voraus, dass die Lernenden bereits den Unterpunkt Beurteilen von Lösungsansätzen zur Sozialen Frage bis in die 1920er Jahre behandelt haben und einen allgemeinen Überblick über die Lage im Deutschen Reich besitzen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "8D-6jOBfDYRA" ;
    dcterms:subject <http://example.org/education/concept/19._Jahrhundert>,
        <http://example.org/education/concept/Audiountericht>,
        <http://example.org/education/concept/Bildung>,
        <http://example.org/education/concept/Deutschland>,
        <http://example.org/education/concept/Erster_Weltkrieg>,
        <http://example.org/education/concept/Geschichte>,
        <http://example.org/education/concept/Gesellschaft>,
        <http://example.org/education/concept/Otto_von_Bismarck>,
        <http://example.org/education/concept/Politik>,
        <http://example.org/education/concept/Wirtschaft> ;
    dcterms:title "Anforderungen an die Lehrkraft"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

