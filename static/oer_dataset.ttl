        <http://example.org/education/concept/Energietechnik>,
        <http://example.org/education/concept/Erzeugerz%C3%A4hlpfeilsystem>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Netzberechnung>,
        <http://example.org/education/concept/Verbraucherz%C3%A4hlpfeilsystem>,
        <http://example.org/education/concept/Z%C3%A4hlpfeilsystem> ;
    dcterms:title "EÜV Lernpaket 4 Rechnungsgrundlagen Teil 3"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

