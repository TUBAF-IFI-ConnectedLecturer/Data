    dcterms:title "Arbeitsblatt - die eigene Mediennutzung reflektieren"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7WHJI6v8vPjQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Kretzschmar>,
        <http://example.org/education/person/Noack>,
        <http://example.org/education/person/Weller> ;
    dcterms:description "Die Präsentation behandelt die Gruppenarbeit und ihre Bedeutung im akademischen und beruflichen Kontext. Sie bietet einen Überblick über die Vorteile und Nachteile von Gruppenarbeit, Merkmale leistungsstarker und -schwacher Lerngruppen sowie Grundsätze und Spielregeln für erfolgreiche Zusammenarbeit. Durch diese Präsentation können Lernerinnen und Lerner Kenntnisse über die Organisation und Führung von Gruppenarbeiten erwerben und ihre sozialen Kompetenzen verbessern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "7WHJI6v8vPjQ" ;
    dcterms:subject <http://example.org/education/concept/Entscheidungsfindung>,
