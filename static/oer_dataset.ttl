oer:10V8fluoCbn5M a edu:LearningResource ;
    dcterms:description "Diese Übung behandelt die Arbeit mit einer Datenbank und umfasst acht Aufgaben, die die Anwendung von SQL-Befehlen wie SELECT, DESC und Fremdschlüsseln verlangen. Durch das Lösen dieser Aufgaben können Studierende ihre Fähigkeiten im Umgang mit relationalen Datenbanken verbessern und Erfahrungen im Bereich der Datenbankabfrage sammeln. Die Übung deckt verschiedene Aspekte der Datenbankarbeit ab, wie die Auswahl bestimmter Datensätze, das Filtern von Ergebnissen und das Verknüpfen von Tabellen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10V8fluoCbn5M" ;
    dcterms:publisher <http://example.org/education/organization/WiSe> ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cbungsaufgaben>,
        <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datenbankmodellierung>,
        <http://example.org/education/concept/Datenbanksysteme>,
        <http://example.org/education/concept/Informationssuche>,
        <http://example.org/education/concept/SQL>,
        <http://example.org/education/concept/Structured_Query_Language>,
        <http://example.org/education/concept/akademische_Datenbanken>,
        <http://example.org/education/concept/bibliographische_Metadaten>,
        <http://example.org/education/concept/relational_Datenbanken> ;
    dcterms:title "Datenbankensysteme WiSe 2425 Übung 2 Structured Query Language Aufgaben"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10Vsd8yKfdm-M a edu:LearningResource ;
    dcterms:description "Der investigative Journalismus deckt Missstände und Machtmissbrauch auf, indem er komplexe Themen wie politische Extremismen und Klimawandel untersucht. Durch die Verwendung moderner digitaler Tools und Methoden können Investigativ-Journalisten langfristige und umfangreiche Recherchen durchführen, um der Wahrheit näherzukommen. Die Arbeit von Investigativ-Journalisten trägt dazu bei, die Öffentlichkeit zu informieren und ein gesellschaftliches Bewusstsein für Missstände zu schaffen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10Vsd8yKfdm-M" ;
    dcterms:subject <http://example.org/education/concept/Investigativer_Journalismus>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Korruption>,
        <http://example.org/education/concept/Machtmissbrauch>,
        <http://example.org/education/concept/Medienkritik>,
        <http://example.org/education/concept/Neonazi-Szene>,
        <http://example.org/education/concept/Recherche>,
        <http://example.org/education/concept/Verschwiegenheitserkl%C3%A4rungen>,
        <http://example.org/education/concept/digitale_Forensik>,
        <http://example.org/education/concept/politische_Extremismen> ;
    dcterms:title "Investigativer Journalismus"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

