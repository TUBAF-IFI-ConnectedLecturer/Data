        <http://example.org/education/concept/Microservices>,
        <http://example.org/education/concept/Softwareentwicklung>,
        <http://example.org/education/concept/Systemintegration> ;
    dcterms:title "Vorlesung SCC, Microservices"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

