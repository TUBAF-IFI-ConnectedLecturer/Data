    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik von Schienenfahrzeugen wird durch den fahrdynamischen Massenfaktor beschrieben, der die virtuelle Erhöhung der Fahrzeugmasse darstellt und von der Fahrzeugbauart, dem Beladungszustand und dem Radverschleiß abhängt. Der Faktor wird für verschiedene Fahrzeugtypen wie E-Lok, Dieselelektrische Lokomotiven und Reisezugwagen berechnet und dient zur Reduktion auf translatorische Bewegung bei gleichzeitiger Berücksichtigung rotatorischer Trägheiten. Durch die Anwendung des fahrdynamischen Massenfaktors können Ingenieure und Fachleute die Fahrdynamik von Schienenfahrzeugen besser verstehen und optimieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10CufmUQOIFOs" ;
    dcterms:subject <http://example.org/education/concept/Eisenbahnwesen>,
        <http://example.org/education/concept/Energieansatz>,
        <http://example.org/education/concept/Fahrdynamik>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Lokomotiven>,
        <http://example.org/education/concept/Massenfaktor>,
        <http://example.org/education/concept/Rotationsbewegung>,
        <http://example.org/education/concept/Schienenfahrzeuge>,
        <http://example.org/education/concept/Schienenverkehr>,
        <http://example.org/education/concept/translatorische_Bewegung> ;
    dcterms:title "Fahrdynamik der Schienenfahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

