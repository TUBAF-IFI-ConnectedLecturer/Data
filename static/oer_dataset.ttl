oer:10go0jgM3_XiI a edu:LearningResource ;
    sim:similarTo oer:11TQJQrLRlSIU,
        oer:125MiATToGB3I,
        oer:12XiifqZ5qD5A,
        oer:12bg9tuBeBjYg,
        oer:12djGNGDPWabU,
        oer:12pw-EmwjR_3Y,
        oer:32AdYV6jW83Y,
        oer:3AzaXlIVpLUw,
        oer:4ZjFF_hT8QvU,
        oer:6GcXf46ynNGw,
        oer:8EVQufcxbKck ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Übungsaufgaben behandeln Strömungsprobleme der Mechanischen Verfahrenstechnik und befassen sich mit der Berechnung von Luftvolumenströmen, Reynoldszahlen und Bremswegen für verschiedene Partikelgrößen. Durch die Lösung dieser Aufgaben können Lernende ihre Fähigkeiten in der Anwendung physikalischer Gesetze und Formeln auf praktische Probleme verbessern. Die Übungsaufgaben bieten eine umfassende Einführung in die Thematik der Strömungsprobleme und bereiten Lernende auf die Lösung komplexer Aufgaben in diesem Bereich vor."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10go0jgM3_XiI" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Aerosolpartikel>,
        <http://example.org/education/concept/Cunningham-Korrektur>,
        <http://example.org/education/concept/D%C3%BCsenstr%C3%B6mung>,
        <http://example.org/education/concept/Gasstr%C3%B6mung>,
        <http://example.org/education/concept/Knudsen-Zahl>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Partikelbewegung>,
        <http://example.org/education/concept/Reynoldszahl>,
        <http://example.org/education/concept/Str%C3%B6mungsmechanik>,
        <http://example.org/education/concept/Tr%C3%A4gheitsabscheidung> ;
    dcterms:title "Übungsaufgaben Strömungsprobleme der MVT"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:10npINWAxgVmQ a edu:LearningResource ;
    sim:similarTo oer:10oQSo2mexrDk,
        oer:10oT1hbimnGDU,
        oer:10rJQY58ku9MQ,
        oer:10yLo231CnA9k,
        oer:4XqF74yv38yA ;
    dcterms:creator <http://example.org/education/person/Hirte> ;
    dcterms:description "Die Raumwirtschaftslehre befasst sich mit der Allokation ökonomischer Aktivität im Raum und untersucht die Auswirkungen von Transportkosten auf Handel und Standortentscheidungen. Durch das Studium dieser Theorie können Lernende verstehen, wie räumliche Faktoren wie Entfernung, Lage und Zugänglichkeit die Wirtschaft beeinflussen und wie sie bei der Entscheidungsfindung berücksichtigt werden müssen. Die Raumwirtschaftslehre bietet somit ein wichtiges Werkzeug für die Analyse und Gestaltung von Wirtschaftsräumen und -systemen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10npINWAxgVmQ" ;
    dcterms:subject <http://example.org/education/concept/%C3%96konomische_Theorie>,
        <http://example.org/education/concept/Makro%C3%B6konomie>,
        <http://example.org/education/concept/Mikro%C3%B6konomie>,
        <http://example.org/education/concept/Raumplanung>,
        <http://example.org/education/concept/Raumwirtschaft>,
        <http://example.org/education/concept/Regional%C3%B6konomie>,
        <http://example.org/education/concept/Stadt%C3%B6konomie>,
        <http://example.org/education/concept/Standorttheorie>,
        <http://example.org/education/concept/Transportkosten>,
        <http://example.org/education/concept/Wirtschaftsgeographie> ;
    dcterms:title "Regional- und Stadtökonomie"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:10twWW1bMYKbA a edu:LearningResource ;
    sim:similarTo oer:10yHenKwaCudA,
        oer:3kqppOFH8iR0,
        oer:4PM4B1ALSrmA,
        oer:5Rf43XDBhops,
        oer:6AgaxM3bkONk,
        oer:6WMD7f5NuKWc,
        oer:6wd_U07ps9c8,
        oer:79fMSwFhbI1U,
        oer:7HAMS2OvGsQ0,
        oer:7_uTTDF4X3PM,
        oer:9ZJKoyUnW92o ;
    dcterms:description "Dieses Lehrmaterial behandelt die Grundlagen der Thermodynamik, insbesondere den Zweiten und Dritten Hauptsatz, sowie die Entropie, Freie Energie und Freie Enthalpie von Systemen. Durch das Studium dieses Materials können Lernende die thermodynamischen Prozesse und Zustandsänderungen verstehen, die für die Beschreibung von Phasenübergängen und chemischen Reaktionen notwendig sind. Zudem werden wichtige Konzepte wie das chemische Potential, die Gibbs-Energie und die Carnot-Wirkungsgrad einer Wärmekraftmaschine erläutert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10twWW1bMYKbA" ;
    dcterms:subject <http://example.org/education/concept/Chemisches_Potential>,
        <http://example.org/education/concept/Clausius-Clapeyron-Gleichung>,
        <http://example.org/education/concept/Entropie>,
        <http://example.org/education/concept/Freie_Energie>,
        <http://example.org/education/concept/Gibbs-Energie>,
        <http://example.org/education/concept/Helmholtz-Energie>,
        <http://example.org/education/concept/Phasen%C3%BCberg%C3%A4nge>,
        <http://example.org/education/concept/Thermodynamik>,
        <http://example.org/education/concept/W%C3%A4rmekapazit%C3%A4t>,
        <http://example.org/education/concept/Zustands%C3%A4nderungen.> ;
    dcterms:title "Thermodynamik"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:114z56_Yg_c8A a edu:LearningResource ;
