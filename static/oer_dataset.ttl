        <http://example.org/education/concept/Kettenlinie>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mechanik>,
        <http://example.org/education/concept/Nichtlineare_Differentialgleichungen>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Schwingungen>,
        <http://example.org/education/concept/Seilkurve> ;
    dcterms:title "Gewhnliche Differentialgleichungen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

