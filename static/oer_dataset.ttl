oer:9szechZOlZ1Q a edu:LearningResource ;
    sim:similarTo oer:9u_N309FmeJQ ;
    dcterms:creator <http://example.org/education/person/Debus>,
        <http://example.org/education/person/Ernst>,
        <http://example.org/education/person/Winkler> ;
    dcterms:description "Diese Übungsaufgaben behandeln kombinatorische und ereignisalgebraische Konzepte, um mathematische Fähigkeiten zu entwickeln und Probleme zu lösen. Durch die Bearbeitung dieser Aufgaben können Lerner ihre Kenntnisse in der Kombinatorik und Ereignisalgebra erweitern und ihre Fähigkeit verbessern, komplexe Probleme zu analysieren und Lösungen zu finden. Die Übungsaufgaben decken Themen wie Permutationen, Wahrscheinlichkeiten und Ereignisräume ab."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "9szechZOlZ1Q" ;
    dcterms:publisher <http://example.org/education/organization/TU_Chemnitz> ;
    dcterms:subject <http://example.org/education/concept/Ereignisalgebra>,
        <http://example.org/education/concept/Graphentheorie>,
