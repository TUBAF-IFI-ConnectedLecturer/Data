oer:3sGpoOC-VBJI a edu:LearningResource ;
    sim:similarTo oer:9LVePof2uasM ;
    dcterms:creator <http://example.org/education/person/Horvath>,
        <http://example.org/education/person/Merkel> ;
    dcterms:description "Die Studie untersucht den Einfluss von geschlechtergerechter Sprache auf die Wahrnehmung von Berufen und Führungspositionen, insbesondere in Bezug auf die Teilhabe von Frauen an der Arbeitswelt. Durch die Analyse von Experimenten und Daten wird gezeigt, dass eine geschlechtergerechte Sprache die mentale Einbeziehung von Frauen verstärkt und ihre Sichtbarkeit in Berufen erhöht. Lernende können aus dieser Studie erfahren, wie wichtig es ist, geschlechtergerechte Sprache zu verwenden, um die Geschlechterparität in der Arbeitswelt zu fördern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3sGpoOC-VBJI" ;
    dcterms:subject <http://example.org/education/concept/Berufsbeschreibung>,
        <http://example.org/education/concept/Berufswelt>,
        <http://example.org/education/concept/F%C3%BChrungsrolle>,
        <http://example.org/education/concept/Frauen_in_F%C3%BChrungspositionen>,
        <http://example.org/education/concept/Gender-Fair_Language>,
        <http://example.org/education/concept/Geschlechterforschung>,
        <http://example.org/education/concept/Geschlechtergleichstellung>,
        <http://example.org/education/concept/Global_Gender_Gap_Index>,
        <http://example.org/education/concept/Sprache_und_Geschlecht>,
        <http://example.org/education/concept/Wirtschaft_und_Politik> ;
    dcterms:title "BELEGARBEIT Gendern oder Nicht-Gendern in der Berufswelt"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

