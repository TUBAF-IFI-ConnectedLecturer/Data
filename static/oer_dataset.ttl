oer:4vEEVSi3HDCU a edu:LearningResource ;
    sim:similarTo oer:7TC_03Md4vSc,
        oer:8UOyIeIZw9dM,
        oer:9yDGII9Hh4gw ;
    dcterms:creator <http://example.org/education/person/Zitzelsberger> ;
    dcterms:description "Das Lehrmaterial behandelt den Bewegungsvorgang in elektrischen Maschinen und Antrieben, wobei die Grundlagen der Kraft- und Drehmomentbildung, Widerstands- und Trägheitsmomente sowie die Umrechnungsgesetze zwischen Rotation und Translation erläutert werden. Durch das Studium dieses Materials können Lernende ein tiefes Verständnis der physikalischen Prinzipien und Mechanismen entwickeln, die für den Entwurf und die Optimierung von elektrischen Antrieben erforderlich sind. Darüber hinaus werden auch Aspekte wie Bremsarten, Reibmomente und Arbeitspunktstabilität behandelt, um eine umfassende Sicht auf die Thematik zu bieten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "4vEEVSi3HDCU" ;
    dcterms:publisher <http://example.org/education/organization/After_Searching_The_Document__I_Found_a_Reference_To_The_Author%27s_Institution%3A%22professur_F%C3%BCr_Elektrische_Maschinen_Und_Antriebe%22this_Suggests_That_The_Author_Is_Affiliated_With_a_University_Or_Technical_University_%28tu%29_In_Germany._However__a_Specific_University_Name_Is_Not_Explicitly_Mentioned.upon_Further_Review__I_Found_Another_Hint%3A%22lehrstuhl_F%C3%BCr_Elektrotechnik%22this_Phrase_Translates_To_%22chair_Of_Electrical_Engineering_%22_Which_Is_Often_Used_At_German_Universities.given_These_Hints__I%27m_Going_To_Take_An_Educated_Guess_That_The_Author_Is_Affiliated_With_a_Technical_University_%28tu%29_In_Germany._However__Without_More_Explicit_Information__I_Cannot_Pinpoint_a_Specific_Institution.therefore__My_Response_Is%3A%22%22> ;
    dcterms:subject <http://example.org/education/concept/Antriebstechnik>,
        <http://example.org/education/concept/Bewegungsvorgang>,
        <http://example.org/education/concept/Drehmoment>,
        <http://example.org/education/concept/Elektromaschinen>,
        <http://example.org/education/concept/Elektrotechnik>,
