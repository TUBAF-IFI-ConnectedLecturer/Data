oer:10lS462UJROPI a edu:LearningResource ;
    sim:similarTo oer:17wI_n2HL60Rk,
        oer:3lWHGnW4Rw88,
        oer:6oHi0AdIaiYY,
        oer:7nfOecn5trz4,
