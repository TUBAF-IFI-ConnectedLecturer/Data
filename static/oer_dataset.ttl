        <http://example.org/education/concept/Schulbibliotheken>,
        <http://example.org/education/concept/Schule_und_%C3%96ffentlichkeit> ;
    dcterms:title "Etherpad-Seminarsitzung am 16. Juni 2020"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

