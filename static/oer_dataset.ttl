        <http://example.org/education/concept/Van-der-Waals-Kr%C3%A4fte>,
        <http://example.org/education/concept/Wechselwirkungen> ;
    dcterms:title "3 Adhäsions-Kohäsionsarbeit"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:69DBygYz0224 a edu:LearningResource ;
    sim:similarTo oer:6moBpyesACKU,
