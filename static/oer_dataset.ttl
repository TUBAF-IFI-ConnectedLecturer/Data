    dcterms:title "Laboraufgabe BPMN"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7Qih_XQ6V1u8 a edu:LearningResource ;
    dcterms:description "Die Masterarbeit zielt darauf ab, eine Vertriebsstrategie für digitale Werbeflächen auf einem globalen Netzwerk von Reiseportalen zu entwickeln und umzusetzen, um die Werbeeinnahmen des untersuchten Unternehmens zu erhöhen. Durch die Analyse der Faktoren, die die erfolgreiche Vermarktung von digitalen Werbeflächen beeinflussen, soll eine optimierte Vertriebsstrategie entwickelt werden, die auf die Bedürfnisse und Erwartungen der Zielgruppe abzielt. Die Arbeit soll praktische Einblicke in die Optimierung der Vermarktung von digitalen Werbeflächen für das Reiseportalnetzwerk bieten und Unternehmen mit ähnlichen Herausforderungen unterstützen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7Qih_XQ6V1u8" ;
    dcterms:publisher <http://example.org/education/organization/Universit%C3%A4t> ;
    dcterms:subject <http://example.org/education/concept/Effektivit%C3%A4tsanalyse>,
        <http://example.org/education/concept/Kundenbindung>,
        <http://example.org/education/concept/Marketingmanagement>,
        <http://example.org/education/concept/Online-Werbung>,
        <http://example.org/education/concept/Preisstrategie>,
        <http://example.org/education/concept/Reiseportal-Netzwerk>,
        <http://example.org/education/concept/Verkaufsprozess>,
        <http://example.org/education/concept/Vertriebsstrategie>,
        <http://example.org/education/concept/Zielgruppenansprache>,
        <http://example.org/education/concept/digitale_Werbung> ;
    dcterms:title "Einleitung"@de ;
    dcterms:type <http://example.org/education/type/Masterarbeit> .

oer:7St4UDVTvWpE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Hamann>,
        <http://example.org/education/person/Ringel>,
        <http://example.org/education/person/Schneider> ;
    dcterms:description "In dieser Lehrveranstaltung lernen die Teilnehmer programmieren und erwerben praktische Fähigkeiten durch eigenes Handeln anhand von Aufgaben und Problemstellungen. Die Organisation der Lehrveranstaltung umfasst Vorlesungen, PC-Pool-Sitzungen und eine schriftliche Prüfung. Durch die Teilnahme an dieser Lehrveranstaltung können die Lernenden Programmierkenntnisse erwerben und sich auf dem Gebiet der Wirtschaftsingenieurwesen Industrie 4.0 weiterbilden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7St4UDVTvWpE" ;
