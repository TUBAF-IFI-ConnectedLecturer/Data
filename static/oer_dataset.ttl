        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Tabellenkalkulation> ;
    dcterms:title "Excel Übung - Personalauswertung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:53GXPnmeg__0 a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Fischer> ;
    dcterms:description "Der Text behandelt den Einfluss von Halteres auf die Leistung im Standweitsprung und vergleicht drei verschiedene Sprungarten mit und ohne Armeinsatz sowie mit Zusatzgewichten. Durch die Analyse der Sprungweiten und -höhen können Lernende physikalische Konzepte wie den freien Fall, die Anfangsgeschwindigkeit und die Zentripetalkraft verstehen und anwenden. Die praktischen Übungen helfen dabei, das Verständnis von Bewegungsabläufen zu verbessern und die Bedeutung von Halteres für die Leistung im Standweitsprung aufzuzeigen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "53GXPnmeg__0" ;
    dcterms:subject <http://example.org/education/concept/Bewegung>,
        <http://example.org/education/concept/Geschwindigkeit>,
        <http://example.org/education/concept/Kraft>,
        <http://example.org/education/concept/Leistung>,
        <http://example.org/education/concept/Mechanik>,
        <http://example.org/education/concept/Physik>,
        <http://example.org/education/concept/Schwerkraft>,
        <http://example.org/education/concept/Sport>,
        <http://example.org/education/concept/Sprung>,
        <http://example.org/education/concept/Wurf> ;
    dcterms:title "Praktikumsaufgabe 5.1 Dokumentation"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:55BGxh5m625w a edu:LearningResource ;
    dcterms:description "Graphen können als isomorph betrachtet werden, wenn eine bijektive Abbildung zwischen ihren Knotenmengen existiert, die ihre Kantenstruktur bewahrt. Durch diese Isomorphie kann die grundlegende Struktur und Eigenschaften von Graphen identifiziert werden, unabhängig von ihrer Darstellung. Dieser Ansatz ermöglicht es, Graphen zu vergleichen und ihre Ähnlichkeiten zu erkennen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "55BGxh5m625w" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Bijektive_Abbildung>,
        <http://example.org/education/concept/Graphdarstellung>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Isomorphie>,
        <http://example.org/education/concept/Kantenstruktur>,
        <http://example.org/education/concept/Knotenmenge>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Netzwerktheorie>,
        <http://example.org/education/concept/Struktureigenschaften> ;
    dcterms:title "Kein Titel gefunden."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:55TBSOJVwdlc a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Seifert> ;
    dcterms:description "Dieses Dokument behandelt die Grundlagen der Datenrepräsentation und -speicherung in Computern, einschließlich der Umwandlung von Dezimalzahlen in Binärzahlen, der Darstellung von Ganzzahlen, negativen Zahlen und Fließkommazahlen. Es erläutert auch die verschiedenen Datentypen in C, wie char, short und long, sowie ihre Eigenschaften und Anwendungsbereiche. Durch das Studium dieses Dokuments können Lerner ein Verständnis dafür entwickeln, wie Computer Daten speichern und verarbeiten."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "55TBSOJVwdlc" ;
    dcterms:subject <http://example.org/education/concept/Bin%C3%A4rsystem>,
        <http://example.org/education/concept/Computerarchitektur>,
        <http://example.org/education/concept/Datentypen>,
