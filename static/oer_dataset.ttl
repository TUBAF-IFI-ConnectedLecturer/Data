oer:12G3tJtEm1mQ8 a edu:LearningResource ;
    dcterms:description "Die Normalverteilung wird als Wahrscheinlichkeitsdichte für eine kontinuierliche Zufallsvariable definiert, die durch zwei Parameter µ und σ² beschrieben wird. Die Dichtefunktion wird hergeleitet und grafisch dargestellt, um die Verteilungseigenschaften zu veranschaulichen. Durch das Studium dieser Materialien können Lernende die Grundlagen der Normalverteilung und ihre Anwendung in der Statistik verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12G3tJtEm1mQ8" ;
    dcterms:subject <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Normalverteilung>,
        <http://example.org/education/concept/Parameter>,
        <http://example.org/education/concept/Standardabweichung>,
        <http://example.org/education/concept/Statistik>,
        <http://example.org/education/concept/Verteilungsfunktion>,
        <http://example.org/education/concept/Wahrscheinlichkeitsdichte>,
        <http://example.org/education/concept/Wahrscheinlichkeitstheorie>,
        <http://example.org/education/concept/Zufallsvariable>,
        <http://example.org/education/concept/stochastische_Prozesse> ;
    dcterms:title "Normalverteilung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

