        <http://example.org/education/concept/Kryptoanalyse>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Netzwerksicherheit>,
        <http://example.org/education/concept/Sicherheit_von_Informationen>,
        <http://example.org/education/concept/Verschl%C3%BCsselungsverfahren> ;
    dcterms:title "Stoffverteilungsplan Schulform Gymnasium Klassenstufe 11/12 Lernbereich Nr. 3 Lernbereich Name Sicherheit von Informationen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7Y4GacTP0tBw a edu:LearningResource ;
    sim:similarTo oer:7bE8m7gQzs7k,
        oer:7lBo50jMKx_s,
        oer:7nfOecn5trz4,
        oer:9SX181GMEJNM ;
    dcterms:creator <http://example.org/education/person/Wallbaum> ;
    dcterms:description "Das Arbeitsblatt ermöglicht es Schülern, ein unbekanntes Musikstück ästhetisch-kulturell zu erfahren und zu beschreiben, indem sie ihre ersten Höreindrücke sammeln und mit der Lehrkraft ins Gespräch kommen. Durch die Aufgabenstellungen können die SuS ihre Fähigkeiten im Bereich Musik hören und erschließen entwickeln und Kompetenzen auf den Niveaus 1-4 nach DQR erwerben. Das Material eignet sich für den Musikunterricht in der Klassenstufe 8, kann aber auch in anderen Klassenstufen mit Anpassungen eingesetzt werden."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "7Y4GacTP0tBw" ;
    dcterms:subject <http://example.org/education/concept/%C3%84sthetische_Bildung>,
        <http://example.org/education/concept/Fachkompetenz>,
        <http://example.org/education/concept/Methodenkompetenz>,
        <http://example.org/education/concept/Musik_erschlie%C3%9Fen>,
        <http://example.org/education/concept/Musik_h%C3%B6ren>,
        <http://example.org/education/concept/Musikalische_Kompetenz>,
        <http://example.org/education/concept/Musikp%C3%A4dagogik>,
        <http://example.org/education/concept/Musikunterricht>,
        <http://example.org/education/concept/Polarit%C3%A4tsprofil>,
        <http://example.org/education/concept/Selbstkompetenz> ;
    dcterms:title "Arbeitsblattvorlage für den ersten Höreindruck zu einem unbekannten Musikstück"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7iAREf8F6na4 a edu:LearningResource ;
    sim:similarTo oer:8ghSvCejq2-E,
        oer:8x4p3KjahjXg,
        oer:95Hf9Atfnows,
        oer:9GK7zjWFEhIU ;
    dcterms:creator <http://example.org/education/person/Despang> ;
    dcterms:description "Das Quiz unterstützt Lehrkräfte dabei, das Verständnis ihrer SchülerInnen über einen Roman zu überprüfen und eventuelle Verständnisprobleme aufzudecken. Durch die Beantwortung von sechs Fragen können die Lernenden ihr Wissen über den Inhalt des Romans und seine Rahmenbedingungen unter Beweis stellen. Die Lehrkraft kann dann gemeinsam mit der Klasse das Ergebnis auswerten und gegebenenfalls weitere Schritte einleiten, um das Verständnis zu fördern."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "7iAREf8F6na4" ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Deutschunterricht>,
        <http://example.org/education/concept/Fragebogen>,
