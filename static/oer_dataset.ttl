        <http://example.org/education/concept/Rapid_Prototyping>,
        <http://example.org/education/concept/Verfahrens-_und_Energietechnik>,
        <http://example.org/education/concept/Werkstoffkunde> ;
    dcterms:title "ADDITIVE FERTIGUNG EINFÜHRUNG I ORGANISATORISCHES Sommersemester 2020"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

