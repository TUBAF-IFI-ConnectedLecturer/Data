oer:1nSyVPO2adeI a edu:LearningResource ;
    sim:similarTo oer:1s-lSNZZPd-c ;
    dcterms:creator <http://example.org/education/person/Gnahs>,
        <http://example.org/education/person/L.>,
        <http://example.org/education/person/Reinhold> ;
    dcterms:description "Die Qualitätsentwicklung in der Erwachsenenbildung wird durch die Auseinandersetzung mit verschiedenen Qualitätsbegriffen und -kriterien gefördert, um eine pädagogische Qualität zu erreichen, die auf Kundenbedürfnissen und -erwartungen basiert. Durch die Implementierung von Qualitätsmanagement und -sicherung können Bildungsanbieter ihre Leistungen verbessern und eine höhere Zufriedenheit der Teilnehmenden erzielen. Die Reflexion über Qualität und Qualitätssicherung in der Erwachsenenbildung ermöglicht es, die eigenen pädagogischen Prinzipien und das eigene Leistungsprofil zu präzisieren und nachvollziehbare Erfolgskriterien zu etablieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1nSyVPO2adeI" ;
    dcterms:subject <http://example.org/education/concept/Bildungspolitik>,
        <http://example.org/education/concept/Bildungsqualit%C3%A4t>,
        <http://example.org/education/concept/Erwachsenenbildung>,
        <http://example.org/education/concept/Lernen>,
        <http://example.org/education/concept/P%C3%A4dagogische_Qualit%C3%A4t>,
        <http://example.org/education/concept/Qualit%C3%A4tsdiskussion>,
        <http://example.org/education/concept/Qualit%C3%A4tskriterien>,
        <http://example.org/education/concept/Qualit%C3%A4tsmanagement>,
        <http://example.org/education/concept/Qualit%C3%A4tssicherung>,
        <http://example.org/education/concept/Weiterbildung> ;
    dcterms:title "Qualitätsentwicklung Folie Nr. 17"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

