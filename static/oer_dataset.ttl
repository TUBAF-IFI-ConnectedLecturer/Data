        <http://example.org/education/concept/Konversationelle_Implikaturen>,
        <http://example.org/education/concept/Perlokution>,
        <http://example.org/education/concept/Pragmatik>,
        <http://example.org/education/concept/Semantik>,
        <http://example.org/education/concept/Sprachwissenschaft>,
        <http://example.org/education/concept/Sprechakte> ;
    dcterms:title "Einführung in die germanistische Sprachwissenschaft"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7K9CCAxsUFXU a edu:LearningResource ;
    sim:similarTo oer:7w49jBSJeORU ;
    dcterms:creator <http://example.org/education/person/Schufft> ;
    dcterms:description "Das Lernpaket behandelt die Themen Freileitungen und Masten in der Elektrotechnik, einschließlich ihrer Komponenten, Anforderungen und Funktionen. Es werden auch Begriffe wie Mastkopfbild, Traversen und Verdrillung erklärt sowie Aspekte wie Seiltemperaturen, Überlastbarkeit und Planungsgrenzwerte erläutert. Durch das Lernpaket können Studierende ein grundlegendes Verständnis der Funktionsweise und Anforderungen von Freileitungen und Masten in der Elektrotechnik erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7K9CCAxsUFXU" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_f%C3%BCr_Elektrotechnik_und_Informationstechnik> ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cberlastbarkeit>,
        <http://example.org/education/concept/Armaturen>,
        <http://example.org/education/concept/Betriebsmittel>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Energie%C3%BCbertragung>,
        <http://example.org/education/concept/Freileitungen>,
        <http://example.org/education/concept/Hochspannungstechnik>,
        <http://example.org/education/concept/Isolatoren>,
        <http://example.org/education/concept/Leiterseile>,
        <http://example.org/education/concept/Netze> ;
    dcterms:title "Netze und Betriebsmittel"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:7MHLJEY22AWg a edu:LearningResource ;
    sim:similarTo oer:7ciNaZ7SL_Y8 ;
    dcterms:description "Die Eigenschaften konvergenter Reihen werden beschrieben, insbesondere die Gliedweise Multiplikation mit einer Konstanten und die Gliedweise Addition und Subtraktion von Reihen. Durch das Studium dieser Eigenschaften können Lernende die Regeln für die Manipulation konvergenter Reihen verstehen und anwenden. Die Kenntnis dieser Regeln ist für die Lösung von Aufgaben in der Mathematik und anderen naturwissenschaftlichen Fächern erforderlich."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7MHLJEY22AWg" ;
    dcterms:subject <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Analysis>,
        <http://example.org/education/concept/Funktionenreihen>,
        <http://example.org/education/concept/Konvergenz>,
        <http://example.org/education/concept/Lineare_Algebra>,
        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mathematische_Analyse>,
        <http://example.org/education/concept/Matrizen>,
        <http://example.org/education/concept/Reihen>,
        <http://example.org/education/concept/Vektorr%C3%A4ume> ;
    dcterms:title "Unendliche Reihen Eigenschaften Satz 10.2"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:7Nt1sBBgXcNc a edu:LearningResource ;
    sim:similarTo oer:7sLC81F06_2Q ;
    dcterms:creator <http://example.org/education/person/Platte> ;
    dcterms:description "Die Vorlesung behandelt die Grundlagen von Audio-over-IP-Netzwerken und deren Komponenten, einschließlich der Synchronisation von Medien-Uhren und der Verwendung von Protokollen wie PTP, RTP und RTCP. Die Studierenden lernen, wie diese Technologien in der Praxis eingesetzt werden, um eine zuverlässige Übertragung von Audio- und Videodaten zu gewährleisten. Durch das Studium dieser Materialien erhalten die Lernenden ein Verständnis für die Funktionsweise und die Anwendung von Audio-over-IP-Netzwerken in der Medientechnik."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "7Nt1sBBgXcNc" ;
    dcterms:publisher <http://example.org/education/organization/Fakult%C3%A4t_Medien> ;
    dcterms:subject <http://example.org/education/concept/Audio-%C3%BCber-IP>,
