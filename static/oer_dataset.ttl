    dcterms:title "Kein Titel gefunden."@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:1s2Zpvj7e8CI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Gundlach> ;
    dcterms:description "Die Dramaturgie spielt eine wichtige Rolle bei der Inszenierung von Kommunikationsprozessen aller Art und umfasst vier wesentliche Formen: szenische, architektonische, interaktive und strategische Dramaturgie. Durch die Anwendung dieser Formen können Veranstalter Inhalte vermitteln, emotionale Gemeinschaften schaffen und Zielgruppen involvieren. Die Kenntnis der Dramaturgie ermöglicht es, Ereignisse zu planen und durchzuführen, die eine bestimmte Wirkung auf das Publikum haben sollen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "1s2Zpvj7e8CI" ;
    dcterms:subject <http://example.org/education/concept/%C3%96ffentlichkeitsarbeit>,
        <http://example.org/education/concept/Dramaturgie>,
