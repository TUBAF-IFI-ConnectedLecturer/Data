oer:12Owhvaa-F2ng a edu:LearningResource ;
    sim:similarTo oer:12esSeQmXwaFA,
        oer:6MsVtutRJ6E4,
        oer:7qOZz4QXrqPw ;
    dcterms:creator <http://example.org/education/person/M%C3%BCller> ;
    dcterms:description "Die vorliegende Dokumentation beschreibt die Ergebnisse einer botanischen Erkundung in verschiedenen Habitaten eines Waldgebietes, bei der eine Vielzahl von Pflanzenarten identifiziert und dokumentiert wurden. Durch das Studium dieser Dokumentation können Lernende Kenntnisse über die Artenvielfalt in verschiedenen Ökosystemen erwerben und ihre Fähigkeiten in der Bestimmung von Pflanzenarten verbessern. Die Dokumentation enthält detaillierte Informationen zu den aufgefundenen Arten, einschließlich ihrer Häufigkeit, Verbreitung und ökologischen Bedeutung."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12Owhvaa-F2ng" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kosystem>,
        <http://example.org/education/concept/Botanik>,
        <http://example.org/education/concept/Geobotanik>,
        <http://example.org/education/concept/Landschafts%C3%B6kologie>,
        <http://example.org/education/concept/Naturschutz>,
        <http://example.org/education/concept/Pflanzengemeinschaft>,
        <http://example.org/education/concept/Pflanzensoziologie>,
        <http://example.org/education/concept/Umweltschutz>,
        <http://example.org/education/concept/Vegetations%C3%B6kologie>,
        <http://example.org/education/concept/Wald%C3%B6kologie> ;
    dcterms:title "Exposition und Vegetationserhebung"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:12PQW3axBeXSU a edu:LearningResource ;
    sim:similarTo oer:7CSKkbxotp68,
        oer:7CeAWOxoZYLA,
        oer:9sDb5Y_aRCJs ;
    dcterms:description "Die Entwicklung von Bibliotheken in der Renaissance war geprägt durch den Kauf als wichtigste Erwerbungsart und die Einführung erster Pflichtexemplargesetze, was zu einer Verzehnfachung des Bestandsumfangs führte. Die Räume und Ausstattung der Bibliotheken passten sich der neuen Größenordnung an, wobei das Pultsystem mit angeketteten Büchern (libri catenati) die typische Aufstellungsform darstellte. Durch die Entstehung erster Bibliothekssäle und die Ernennung von Präfekten für bedeutende Bibliotheken wie der Vatikanischen Bibliothek kam es zu einer Professionalisierung der Bibliotheksarbeit."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12PQW3axBeXSU" ;
    dcterms:subject <http://example.org/education/concept/B%C3%BCchersammlung>,
        <http://example.org/education/concept/Bibliotheksbau>,
        <http://example.org/education/concept/Bibliotheksbestand>,
        <http://example.org/education/concept/Bibliotheksgeschichte>,
        <http://example.org/education/concept/Bibliotheksorganisation>,
        <http://example.org/education/concept/Buchkultur>,
        <http://example.org/education/concept/Gelehrtenbibliothek>,
        <http://example.org/education/concept/Hofbibliothek>,
        <http://example.org/education/concept/Landesbibliothek>,
        <http://example.org/education/concept/Renaissance> ;
    dcterms:title "Bibliotheken in der Renaissance"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

