    dcterms:creator <http://example.org/education/person/Kache> ;
    dcterms:description "Die Fahrdynamik-Vorlesung behandelt die mechanische und hydromechanische Leistungsübertragung bei Dieseltriebfahrzeugen, insbesondere die Funktion von Getrieben, Kupplungen und Radsätzen. Durch das Studium dieser Vorlesung können Lernende die grundlegenden Prinzipien der Leistungsübertragung in Dieselfahrzeugen verstehen und die Vorteile und Nachteile unterschiedlicher Übertragungstechniken erkennen. Zudem werden sie in die Lage versetzt, die Anforderungen an die Leistungsübertragung in Abhängigkeit von Fahrzeugtyp und Betriebsbedingungen zu analysieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "13jRtb2MF8j8c" ;
    dcterms:subject <http://example.org/education/concept/Dieselmotor>,
        <http://example.org/education/concept/Fahrzeugaufbau>,
        <http://example.org/education/concept/Fahrzeugtechnik>,
        <http://example.org/education/concept/Geschwindigkeit>,
        <http://example.org/education/concept/Getriebe>,
        <http://example.org/education/concept/Hydromechanische_%C3%9Cbertragung>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
        <http://example.org/education/concept/Mechanische_%C3%9Cbertragung>,
        <http://example.org/education/concept/Schienenfahrzeug>,
        <http://example.org/education/concept/Zugkraft> ;
    dcterms:title "Fahrdynamik Professur für Technik spurgeführter Fahrzeuge"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

