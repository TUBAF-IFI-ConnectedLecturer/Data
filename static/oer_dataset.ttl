        <http://example.org/education/concept/Selbstlernen>,
        <http://example.org/education/concept/Unterrichtstechniken> ;
    dcterms:title "Artefakt 3"@de ;
    dcterms:type <http://example.org/education/type/Tutorial> .

oer:11Nuz0MVNicbM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Simmert> ;
    dcterms:description "Die IKT-Funktionen umfassen Präsentations-, Gegenstands-, Werkzeug-, Organisations- und Kommunikations-Funktionen, die im Bildungsbereich eingesetzt werden, um Lernen und Lehren zu unterstützen. Durch das Verständnis dieser Funktionen können Lernende die Möglichkeiten der Informations- und Kommunikationstechnologien nutzen, um ihre Arbeit effizienter zu gestalten und ihre Ziele zu erreichen. Die Kombination dieser Funktionen ermöglicht es, komplexe Anwendungen zu entwickeln, die den Lehr- und Lernprozess verbessern."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11Nuz0MVNicbM" ;
    dcterms:publisher <http://example.org/education/organization/TU> ;
    dcterms:subject <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Computergest%C3%BCtzte_Arbeitsweise>,
        <http://example.org/education/concept/Computerunterst%C3%BCtztes_Lernen>,
        <http://example.org/education/concept/E-Learning>,
        <http://example.org/education/concept/Informatikunterricht>,
        <http://example.org/education/concept/Informations-_und_Kommunikationstechnologien>,
        <http://example.org/education/concept/Lehrmittel>,
        <http://example.org/education/concept/Mediendidaktik>,
        <http://example.org/education/concept/Technologiebasiertes_Lernen>,
        <http://example.org/education/concept/Unterrichtsmedien> ;
    dcterms:title "Thema 18: Die Funktionen der Informations- und Kommunikationstechnologien"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:11OvSuc24ewtU a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Herzog> ;
    dcterms:description "Dieses Lehrmaterial behandelt Themen aus dem Bereich Graphentheorie und Netzwerkanalyse, insbesondere gerichtete Graphen, Transportgraphen und Inzidenzmatrizen. Durch die Bearbeitung von Quizfragen und Aufgaben können Lernende ihr Verständnis dieser Konzepte verbessern und ihre Fähigkeiten in der Anwendung graphentheoretischer Methoden stärken. Die Inhalte sind auf die Vorbereitung einer Prüfung ausgerichtet, die zwischen dem 19.01.2021 und dem 23.03.2021 stattfindet."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11OvSuc24ewtU" ;
    dcterms:subject <http://example.org/education/concept/Flussprobleme>,
        <http://example.org/education/concept/Graphenalgorithmen>,
        <http://example.org/education/concept/Graphentheorie>,
