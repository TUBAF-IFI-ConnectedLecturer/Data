        <http://example.org/education/concept/Printmedien>,
        <http://example.org/education/concept/Publikationsmanagement>,
        <http://example.org/education/concept/Verlagswesen> ;
    dcterms:title "Herstellungskosten - Berechnungsgrundlage"@de ;
    dcterms:type <http://example.org/education/type/Buch> .

oer:8QB-KXaW8_U0 a edu:LearningResource ;
    sim:similarTo oer:8S0M4Xh5qGOY ;
    dcterms:creator <http://example.org/education/person/Kuper> ;
    dcterms:description "Die Übung behandelt das Sammlungsmanagement und die Terminologiekontrolle im Sommersemester 2022. Die Aufgaben umfassen das Erkunden von Websites wie Wikidata und der Digitalen Bibliothek, um Datensätze anzusehen und URLs zu notieren. Durch diese Übung sollen die Teilnehmer Erfahrungen im Umgang mit Online-Ressourcen und der Erhebung von Metadaten sammeln."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "8QB-KXaW8_U0" ;
    dcterms:subject <http://example.org/education/concept/Bibliothekswesen>,
