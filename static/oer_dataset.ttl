    dcterms:creator <http://example.org/education/person/Fricke>,
        <http://example.org/education/person/Kache>,
        <http://example.org/education/person/Stephan> ;
    dcterms:description "Die Vorlesung behandelt die Leistungsübertragungen in Triebfahrzeugen, insbesondere die hydrodynamischen Getriebe und ihre Anwendung in Lokomotiven und Rangierfahrzeugen. Durch das Studium dieser Materialien können Lernende die Funktionsweise und den Aufbau von hydrodynamischen Wandlern, Kupplungen und Retardern verstehen sowie die Berechnung von Pumpendrehmoment und -drehzahl erlernen. Zudem werden verschiedene Getriebearten wie Dreiwandlergetriebe, Turbowendegetriebe und Wandler-Kupplungs-Getriebe vorgestellt und ihre Anwendung in verschiedenen Fahrzeugtypen diskutiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6N1ggFcTCAMM" ;
    dcterms:subject <http://example.org/education/concept/Antriebskonfigurationen>,
        <http://example.org/education/concept/Dieselmotoren>,
        <http://example.org/education/concept/Fahrzeugaufbau>,
        <http://example.org/education/concept/Hydrodynamische_Getriebe>,
        <http://example.org/education/concept/Leistungs%C3%BCbertragung>,
