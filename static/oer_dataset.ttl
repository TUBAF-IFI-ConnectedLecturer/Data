        <http://example.org/education/concept/Polen>,
        <http://example.org/education/concept/akademische_Bibliotheken>,
        <http://example.org/education/concept/wissenschaftliche_Literatur> ;
    dcterms:title "Deutsch-polnische Kooperationen im Bibliotheksbereich"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

