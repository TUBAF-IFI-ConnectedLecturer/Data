oer:5ju6DUf2wqG0 a edu:LearningResource ;
    sim:similarTo oer:5rNgIPOp086A,
        oer:7-p5vgbhqc7w ;
    dcterms:creator <http://example.org/education/person/Kobisch> ;
    dcterms:description "Die Studie untersucht die Beziehung zwischen dem Kognitionsbedürfnis (NFC) und dem Entscheidungsverhalten mittels des Iowa-Gambling-Tasks (IGT), um zu klären, ob das NFC einen Einfluss auf die Entscheidungen im IGT hat. Die Ergebnisse zeigen jedoch keine signifikante Beziehung zwischen beiden Variablen, was Zweifel an der Eignung der Kombination von IGT und NFC für die Untersuchung individueller Unterschiede im Entscheidungsverhalten aufwirft. Durch diese Studie können Leser Einblick in die Komplexität des Entscheidungsprozesses und die Limitationen von Messinstrumenten wie dem IGT und NFC gewinnen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "docx" ;
    dcterms:identifier "5ju6DUf2wqG0" ;
    dcterms:subject <http://example.org/education/concept/Entscheidungstheorie>,
        <http://example.org/education/concept/Entscheidungsverhalten>,
        <http://example.org/education/concept/Experimentelle_Psychologie>,
        <http://example.org/education/concept/Forschungsmethoden>,
        <http://example.org/education/concept/IGT>,
        <http://example.org/education/concept/Iowa-Gambit-Task>,
        <http://example.org/education/concept/Kognitionsbed%C3%BCrfnis>,
        <http://example.org/education/concept/Kognitive_Psychologie>,
        <http://example.org/education/concept/Need_for_Cognition>,
        <http://example.org/education/concept/Replikation> ;
    dcterms:title "Die Beziehung zwischen Kognitionsbedürfnis und Entscheidungsverhalten"@de ;
    dcterms:type <http://example.org/education/type/Paper> .

