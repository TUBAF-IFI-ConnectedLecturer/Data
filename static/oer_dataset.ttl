    dcterms:creator <http://example.org/education/person/Ivainsky> ;
    dcterms:description "Die kollisionssichere Auslegung von Schienenfahrzeugen erfordert die Berücksichtigung von statischen und dynamischen Lasten, um die Sicherheit der Insassen und des Fahrzeugs zu gewährleisten. Durch die Anwendung von Crash-Konzepten und Energieaufnahmesystemen kann die Kollisionssicherheit verbessert werden, indem die Energie bei einem Zusammenstoß kontrolliert aufgenommen wird. Die Umsetzung dieser Konzepte in der Fahrzeugkonstruktion ermöglicht es, die Anforderungen von Normen wie EN 15227 zu erfüllen und die Sicherheit im Schienenverkehr zu erhöhen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "10bcf4sdpJ8Cw" ;
    dcterms:subject <http://example.org/education/concept/Crashkonzept>,
        <http://example.org/education/concept/Eisenbahntechnik>,
        <http://example.org/education/concept/Eisenbahnunf%C3%A4lle>,
        <http://example.org/education/concept/Fahrzeugaufprall>,
        <http://example.org/education/concept/Kollisionssicherheit>,
        <http://example.org/education/concept/Schienenfahrzeugtechnik>,
        <http://example.org/education/concept/Sto%C3%9Fd%C3%A4mpfung>,
        <http://example.org/education/concept/Unfallanalyse>,
        <http://example.org/education/concept/Verkehrssicherheit>,
        <http://example.org/education/concept/Zugungl%C3%BCcke> ;
    dcterms:title "6. Kollisionsschutzgerechte Konstruktion"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

