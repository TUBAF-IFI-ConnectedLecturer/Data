        <http://example.org/education/concept/Mathematik>,
        <http://example.org/education/concept/Mengenlehre>,
        <http://example.org/education/concept/Rekursion>,
        <http://example.org/education/concept/Transfinite>,
        <http://example.org/education/concept/Typen_von_Funktionen>,
        <http://example.org/education/concept/Zahlentheorie>,
        <http://example.org/education/concept/reelle_Zahlen> ;
    dcterms:title "Zum Hilbertschen Aufbau der reellen Zahlen. Von Wilhelm Ackermann in Göttingen."@de ;
    dcterms:type <http://example.org/education/type/Paper> .

