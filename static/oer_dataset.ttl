        <http://example.org/education/concept/Preise>,
        <http://example.org/education/concept/Umrechnung>,
        <http://example.org/education/concept/Verpackungen> ;
    dcterms:title "Wocheneinkauf"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:11gn1NRtfCgTI a edu:LearningResource ;
    dcterms:description "Diese Lehrplananalyse behandelt die historische Entwicklung des Logarithmus und seine Beziehung zur Eulerschen Zahl, um Schülern eine genetische Methode zur Erarbeitung mathematischer Konzepte anzubieten. Durch die Analyse wichtiger historischer Beiträge und die Darstellung der Logarithmusfunktion werden die Grundlagen für das Verständnis komplexer mathematischer Inhalte gelegt. Schüler erwerben durch diese Materialien propädeutische Vorstellungen vom Unendlichen und vom Grenzwertbegriff sowie die Fähigkeit, heuristische Verfahren anzuwenden und Zahlenbereiche zu systematisieren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "11gn1NRtfCgTI" ;
    dcterms:subject <http://example.org/education/concept/Exponentialfunktion>,
        <http://example.org/education/concept/Genetische_Methode>,
        <http://example.org/education/concept/Geschichte_der_Mathematik>,
        <http://example.org/education/concept/Historische_Beitr%C3%A4ge>,
        <http://example.org/education/concept/Lehrplananalyse>,
        <http://example.org/education/concept/Logarithmus>,
        <http://example.org/education/concept/Mathematikgeschichte>,
        <http://example.org/education/concept/Mathematikunterricht>,
        <http://example.org/education/concept/Mathematische_Funktionen>,
        <http://example.org/education/concept/Zahlentheorie> ;
    dcterms:title "Eine Lehrplanalyse Einige historische Beiträge und die genetische Methode Die Eulersche Zahl als Vorbereitung zum Logarithmus Die Erfindung des Logarithmus"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:11hA6g04O79uM a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Gries> ;
    dcterms:description "Das Übungsdokument behandelt die Verschlüsselung von Nachrichten mittels einer Schlüsselzahl und der TEIL-Funktion, um einen Text in Einzelbuchstaben zu zerlegen. Durch die Anwendung der CODE-Funktion können die Buchstaben in ASCII-Codes umgewandelt werden. Die Learner erfahren, wie sie eine Nachricht verschlüsseln und entschlüsseln können, indem sie die Schlüsselzahl auf die ASCII-Codes anwenden."@de ;
    dcterms:format "xlsx" ;
    dcterms:identifier "11hA6g04O79uM" ;
    dcterms:subject <http://example.org/education/concept/ASCII-Codes>,
        <http://example.org/education/concept/Algorithmen>,
        <http://example.org/education/concept/Datenverschl%C3%BCsselung>,
        <http://example.org/education/concept/Funktionen>,
        <http://example.org/education/concept/Informationssicherheit>,
        <http://example.org/education/concept/Kryptographie>,
        <http://example.org/education/concept/Tabellenkalkulation>,
        <http://example.org/education/concept/Textverarbeitung>,
        <http://example.org/education/concept/Verschl%C3%BCsselung>,
        <http://example.org/education/concept/Zeichencodierung> ;
    dcterms:title "Übung 2"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

