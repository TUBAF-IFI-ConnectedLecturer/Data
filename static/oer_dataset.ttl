oer:5CmKlg38jRpA a edu:LearningResource ;
    dcterms:description "Diese Episode behandelt die Lebensprinzipien von Gary Vaynerchuk und Christian Lindner, zwei erfolgreiche Kommunikatoren, die ihre Rhetorik und Schlagfertigkeit vorstellen. Durch diese Prinzipien können Lernende Strategien für wirksames Reden und Überzeugen erlernen, wie zum Beispiel das Setzen auf Stärken, Geduld und Ausführung von Ideen. Weiterhin werden Tipps für mehr Schlagfertigkeit in Diskussionen und Debatten vorgestellt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5CmKlg38jRpA" ;
    dcterms:publisher <http://example.org/education/organization/Technische_Universit%C3%A4t_Dresden> ;
    dcterms:subject <http://example.org/education/concept/%C3%9Cberzeugen>,
        <http://example.org/education/concept/Erfolg>,
        <http://example.org/education/concept/Humor>,
        <http://example.org/education/concept/K%C3%B6rpersprache>,
        <http://example.org/education/concept/Kommunikation>,
        <http://example.org/education/concept/Lebensprinzipien>,
        <http://example.org/education/concept/Rhetorik>,
        <http://example.org/education/concept/Schlagfertigkeit>,
        <http://example.org/education/concept/Selbstbewusstsein>,
        <http://example.org/education/concept/Unternehmertum> ;
    dcterms:title "Wirkungsvoll reden und überzeugen (Extended Version)"@de ;
    dcterms:type <http://example.org/education/type/Podcast> .

oer:5DLX-cecb_7s a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Grafe>,
        <http://example.org/education/person/Kirst>,
        <http://example.org/education/person/Schubert> ;
    dcterms:description "Dieses Lehrmaterial behandelt die Modellierung von Datenbanken und vermittelt Lernenden Kenntnisse über die Strukturierung von Daten, den Aufbau und die Aufgaben eines Datenbankmanagementsystems sowie die Planung und Erstellung einer relationalen Datenbank. Durch die Bearbeitung dieses Materials können Lernende Beispiele ordnen, Aussagen über den Aufbau und die Aufgaben eines Datenbanksystems abgleichen und ein DBMS nutzen, um Daten einzugeben, zu sortieren und Abfragen darauf auszuführen. Zudem lernen sie, eine Datenbank auf die Kriterien Datensicherheit und Datenschutz zu beurteilen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5DLX-cecb_7s" ;
    dcterms:subject <http://example.org/education/concept/Datenbanken>,
        <http://example.org/education/concept/Datenbanksysteme>,
        <http://example.org/education/concept/Datenintegration>,
        <http://example.org/education/concept/Datenmanagement>,
        <http://example.org/education/concept/Datenmodellierung>,
        <http://example.org/education/concept/Datenschutz>,
        <http://example.org/education/concept/Datensicherheit>,
        <http://example.org/education/concept/Lernen_mit_Projekten>,
        <http://example.org/education/concept/Projektmanagement>,
        <http://example.org/education/concept/Relationale_Datenbanken> ;
    dcterms:title "Stoﬀverteilungsplan Modellierung von Datenbanken"@de ;
    dcterms:type <http://example.org/education/type/Sto%EF%AC%80verteilungsplan> .

oer:5DSIaJpKBYhw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Achtziger>,
        <http://example.org/education/person/K%C3%B6stner>,
        <http://example.org/education/person/Richert> ;
    dcterms:description "Die BIODIVina-Bildungsmodule behandeln die Bedeutung der Biodiversität bei der Anpassung des Weinbaus an den Klimawandel und bieten eine umfassende Einführung in die Grundlagen der Biodiversität, einschließlich ihrer Definition, Geschichte und Komponenten. Durch das Studium dieser Module können Lernende ein Verständnis dafür entwickeln, wie die Biodiversität funktioniert und warum sie für die Erhaltung der Ökosysteme und die nachhaltige Nutzung von Ressourcen wichtig ist. Zudem werden konkrete Methoden und Werkzeuge vorgestellt, um die Biodiversität zu messen und zu bewerten, wie zum Beispiel der Shannon-Diversitätsindex und die Evenness."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5DSIaJpKBYhw" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologie>,
        <http://example.org/education/concept/%C3%96kosystem>,
        <http://example.org/education/concept/Artendiversit%C3%A4t>,
        <http://example.org/education/concept/Biodiversit%C3%A4t>,
        <http://example.org/education/concept/Biologische_Vielfalt>,
        <http://example.org/education/concept/Klimawandel>,
        <http://example.org/education/concept/Nachhaltigkeit>,
        <http://example.org/education/concept/Naturschutz>,
        <http://example.org/education/concept/Umweltforschung>,
        <http://example.org/education/concept/Umweltschutz> ;
    dcterms:title "Biodiversität - Grundlagen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

