        <http://example.org/education/concept/Projektplanung>,
        <http://example.org/education/concept/Qualit%C3%A4tsicherung>,
        <http://example.org/education/concept/Scrum>,
        <http://example.org/education/concept/Soziale_Kompetenz>,
        <http://example.org/education/concept/Teamarbeit> ;
    dcterms:title "Vor- und Nachteile der agilen Projektmethode"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:5lzay-4HbiuI a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Meier> ;
    dcterms:description "Die Vorlesung behandelt die steuerliche Planung und Optimierung von Einkünften aus verschiedenen Quellen, wie Arbeitnehmer, Vermieter und Erben, um die Steuerlast zu minimieren. Durch die Anwendung von Steuergestaltungsmöglichkeiten und -wahlrechten können Unternehmen und Einzelpersonen ihre steuerliche Situation verbessern und Kosten einsparen. Die Lektüre vermittelt Kenntnisse über die verschiedenen Steuergesetze und -regelungen, um eine optimale Steuerplanung durchführen zu können."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5lzay-4HbiuI" ;
    dcterms:publisher <http://example.org/education/organization/Nach_Durchsuchen_Des_Dokuments_Habe_Ich_Keine_Hinweise_Auf_Die_Herkunftsinstitution_Des_Autors_Gefunden._Daher_Gebe_Ich_Einen_Leeren_String_Zur%C3%BCck.> ;
    dcterms:subject <http://example.org/education/concept/Bilanzpolitik>,
        <http://example.org/education/concept/Einkommensteuer>,
        <http://example.org/education/concept/Ertragsteuer>,
        <http://example.org/education/concept/Finanzierungspolitik>,
        <http://example.org/education/concept/Gewerbesteuer>,
        <http://example.org/education/concept/K%C3%B6rperschaftsteuer>,
        <http://example.org/education/concept/Rechtsformwahl>,
        <http://example.org/education/concept/Standortwahl>,
        <http://example.org/education/concept/Steueroptimierung>,
        <http://example.org/education/concept/Steuerplanung> ;
    dcterms:title "Steuerplanung und Steuergerechtigkeit"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:5mK5F-2ZPUvs a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Almadhi> ;
    dcterms:description "Die Wahl von Emotionsregulationsstrategien ist flexibel und situationsspezifisch, wobei Distraction bei hoher Intensität und Reappraisal bei niedriger Intensität bevorzugt werden. Die Studie untersucht den Einfluss von Emotionsintensität, kognitiver Belastung und zeitlichem Abstand auf die Wahl zwischen Distraction und Reappraisal. Durch die Erkenntnisse über flexible Emotionsmanagement können Anwendungsmöglichkeiten für Therapie und individuelle Emotionskontrolle entwickelt werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5mK5F-2ZPUvs" ;
    dcterms:subject <http://example.org/education/concept/Angstst%C3%B6rungen>,
        <http://example.org/education/concept/Distraction>,
        <http://example.org/education/concept/Emotionale_Intensit%C3%A4t>,
        <http://example.org/education/concept/Emotionsregulation>,
        <http://example.org/education/concept/Flexibilit%C3%A4t>,
        <http://example.org/education/concept/Kognitive_Belastung>,
        <http://example.org/education/concept/Reappraisal>,
        <http://example.org/education/concept/Selbstkontrolle>,
        <http://example.org/education/concept/Strategiewahl>,
        <http://example.org/education/concept/Zeitlicher_Abstand> ;
    dcterms:title "Zusammenfassung der experimentellen Ergebnisse"@de ;
    dcterms:type <http://example.org/education/type/Seminararbeit> .

oer:5maH4Eef6SUw a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Merker>,
        <http://example.org/education/person/Seidel> ;
    dcterms:description "Das Projekt MoVUsO zielt auf die Flexibilisierung der Kombination verschiedener Navigationsformen in Tests und Testabschnitten ab, um die Usability beim Handling von Variablen zu verbessern und die Verwaltung von Tests und Testteilen zu erleichtern. Durch das Projekt sollen Autoren unterstützt werden, OPAL-Nutzerdaten in ONYX verfügbar zu machen und die korrekte Antwort (CORRECT_RESPONSE) zu ändern. Lerner können von diesem Projekt profitieren, indem sie flexiblere Tests und eine verbesserte Handhabung von Variablen erfahren."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5maH4Eef6SUw" ;
    dcterms:subject <http://example.org/education/concept/Autorenunterst%C3%BCtzung>,
        <http://example.org/education/concept/Bildungstechnologie>,
        <http://example.org/education/concept/Computerunterst%C3%BCtztes_Lernen>,
