oer:12HXxEczj9Z3Y a edu:LearningResource ;
    sim:similarTo oer:12esSeQmXwaFA,
        oer:17OarZM3R2C5c ;
    dcterms:creator <http://example.org/education/person/Hellbach>,
        <http://example.org/education/person/M%C3%BCller> ;
    dcterms:description "Die Vegetation im Südpark in Dresden ist durch Sukzession entstanden und setzt sich aus Wiesenflächen, ruderalen Staudenfluren, Gehölzstreifen und waldartigen Flächen unterschiedlicher Entwicklungsstufen zusammen. Durch die Analyse der Vegetationsaufnahmen können sechs Typen mit ihren dazugehörigen Eigenschaften identifiziert werden, was für die Entwicklung eines Vegetationskonzepts von Bedeutung ist. Die Kenntnis dieser Vegetationsgesellschaften ermöglicht es, Maßnahmen zur Lebensraumverbesserung für geschützte Arten wie die Feldlerche zu ergreifen und den Südpark als wichtigen Teil der städtischen Biodiversität zu erhalten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12HXxEczj9Z3Y" ;
    dcterms:subject <http://example.org/education/concept/%C3%96kologische_Sukzession>,
        <http://example.org/education/concept/Biotopvernetzung>,
        <http://example.org/education/concept/Gr%C3%BCnordnung>,
        <http://example.org/education/concept/Landschaftsplanung>,
        <http://example.org/education/concept/Naturschutz>,
        <http://example.org/education/concept/Stadtgr%C3%BCn>,
        <http://example.org/education/concept/Stadtklimatologie>,
        <http://example.org/education/concept/Umweltschutz.>,
        <http://example.org/education/concept/Vegetations%C3%B6kologie>,
        <http://example.org/education/concept/Vegetationsanalyse> ;
    dcterms:title "Vegetationskonzept für den Südpark in Dresden"@de ;
    dcterms:type <http://example.org/education/type/Bachelor-_oder_Masterarbeit> .

oer:12IVVtroo82Uk a edu:LearningResource ;
    sim:similarTo oer:12mhRsKRcGP7w,
        oer:38uPV4VdYK1s ;
    dcterms:creator <http://example.org/education/person/Donath> ;
    dcterms:description "Topologien in ArcGIS ermöglichen die Überprüfung und Herstellung von Konsistenzregeln innerhalb von Feature Classes, um sicherzustellen, dass die Elemente bestimmten Regeln entsprechen. Durch die Anwendung von Topologien können Fehler erkannt und behoben werden, wie z.B. Überlappungen oder Lücken zwischen Polygonen."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
