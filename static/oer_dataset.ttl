oer:3Ft_7SCOHgeg a edu:LearningResource ;
    sim:similarTo oer:3V5F_dlMuvnI ;
    dcterms:description "Die DIN-Norm 18703 beschreibt die Anforderungen an Nivellierlatten für einfache Nivellements, Geländeaufnahmen und Baustellen, um eine einheitliche Genauigkeit und Abmessung sicherzustellen. Durch diese Norm können Hersteller und Anwender die erforderlichen Maßnahmen treffen, um die Genauigkeit der Latten zu gewährleisten und eine Abschätzung der erreichbaren Messgenauigkeit durchzuführen. Die Norm behandelt Aspekte wie Teilung, Bezifferung, Nullpunktabweichung, Beschläge und Kennzeichnung von Nivellierlatten."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3Ft_7SCOHgeg" ;
    dcterms:publisher <http://example.org/education/organization/Berufsakademie_Sachsen_Staatliche_Studienakademie_Glauchau> ;
    dcterms:subject <http://example.org/education/concept/Bauwesen>,
        <http://example.org/education/concept/Geod%C3%A4sie>,
        <http://example.org/education/concept/Ingenieurvermessung>,
        <http://example.org/education/concept/Landesvermessung>,
        <http://example.org/education/concept/Levelling_staffs>,
        <http://example.org/education/concept/Messger%C3%A4t>,
        <http://example.org/education/concept/Messtechnik>,
        <http://example.org/education/concept/Nivellement>,
        <http://example.org/education/concept/Nivellierger%C3%A4t>,
        <http://example.org/education/concept/Vermessung> ;
    dcterms:title "DIN 18703 Nivellierlatten"@de ;
    dcterms:type <http://example.org/education/type/Dokumentation> .

oer:3KT6YGm1p4fU a edu:LearningResource ;
    sim:similarTo oer:4RGR9A8JPshE,
        oer:4ySEAJSxTp6c,
