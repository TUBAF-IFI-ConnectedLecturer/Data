    dcterms:creator <http://example.org/education/person/Matthes>,
        <http://example.org/education/person/Schiermeyer> ;
    dcterms:description "Die Kombinatorik beschäftigt sich mit der Bestimmung von Anzahlen bestimmter Abbildungen zwischen endlichen Mengen unter Berücksichtigung von Symmetrien und Identifizierungen. Durch die Lektüre dieses Materials können Lerner die grundlegenden Konzepte und Methoden der Kombinatorik erlernen, wie zum Beispiel die Basissätze, die Stirling-Zahlen und die Ramsey-Theorie. Dadurch werden sie in der Lage sein, komplexe kombinatorische Probleme zu lösen und Anwendungen in verschiedenen mathematischen Disziplinen zu verstehen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6WtIyhpHURnA" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/%C3%84quivalenzrelation>,
        <http://example.org/education/concept/Algebra>,
        <http://example.org/education/concept/Bijektion>,
        <http://example.org/education/concept/Graphentheorie>,
        <http://example.org/education/concept/Kombinatorik>,
        <http://example.org/education/concept/Permutationsgruppe>,
        <http://example.org/education/concept/Unterhaltungsmathematik>,
        <http://example.org/education/concept/Wahrscheinlichkeitsrechnung>,
        <http://example.org/education/concept/Zahlentheorie>,
        <http://example.org/education/concept/diskrete_Mathematik> ;
    dcterms:title "DISKRETE MATHEMATIK Mitschriften der Vorlesung von Prof. Dr. Ingo Schiermeyer Institut für Diskrete Mathematik und Algebra TU Bergakademie Freiberg geschrieben von Sascha Matthes"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

