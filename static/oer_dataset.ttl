oer:12gc2VpOPfNMw a edu:LearningResource ;
    sim:similarTo oer:3udeaC5IR08A,
        oer:4H6SuQJITwlw,
        oer:4PSJbuIud3oM,
        oer:4c_VRiKjzy3U,
        oer:6-OuQNqvr40E,
        oer:9NUSW9eh1Jc0 ;
    dcterms:creator <http://example.org/education/person/Kleinert> ;
    dcterms:description "Das Praktikum Elektrotechnik für Nichtelektrotechniker behandelt den Versuch 3, bei dem die Messungen und Berechnungen an einer Solarzelle durchgeführt werden, um die Leistungs-, Strom- und Spannungsanpassung zu untersuchen. Durch die Ausführung des Praktikums können Studierende ein ausgewähltes Solarmodul kennenlernen und Erfahrungen im Umgang mit verschiedenen Messgeräten sammeln. Die Aufgabenstellungen umfassen die Berechnung von Leistungen, die Bestimmung von Widerständen und die Darstellung von Kennlinien in Diagrammen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12gc2VpOPfNMw" ;
    dcterms:publisher <http://example.org/education/organization/Hochschule_Mittweida_University_of_Applied_Sciences> ;
    dcterms:subject <http://example.org/education/concept/Digitalmultimeter>,
        <http://example.org/education/concept/Elektromessung>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Gleichspannungsversorgung>,
