        <http://example.org/education/concept/Optimierungsaufgaben>,
        <http://example.org/education/concept/Wissenschaftliches_Rechnen> ;
    dcterms:title "Kurskonzept: Vorlesung Skript"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

