    dcterms:title "Reflexe gesprochener Sprache im Mittelniederdeutschen"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:89T0mlw33VfE a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Babick> ;
    dcterms:description "Die Übungsaufgaben behandeln die Grundlagen der Verfahrenstechnik und Naturstofftechnik, insbesondere die Filtration und Durchströmung von Haufwerken, sowie die statische Oberflächenfiltration mit kompressiblen Filterkuchen. Die Aufgaben dienen dazu, die grundlegenden Konzepte und Gleichungen der Filtration zu vermitteln und die Fähigkeit zur Anwendung dieser Konzepte in verschiedenen Szenarien zu entwickeln. Durch das Durcharbeiten dieser Übungsaufgaben können Lerner ein tiefes Verständnis der physikalischen Prozesse und mathematischen Modelle der Filtration erwerben."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "89T0mlw33VfE" ;
    dcterms:publisher <http://example.org/education/organization/TU_Dresden> ;
    dcterms:subject <http://example.org/education/concept/Druckverlust>,
        <http://example.org/education/concept/Filterkuchen>,
        <http://example.org/education/concept/Filtration>,
        <http://example.org/education/concept/Mechanische_Verfahrenstechnik>,
        <http://example.org/education/concept/Porosit%C3%A4t>,
        <http://example.org/education/concept/Reynolds-Zahl>,
        <http://example.org/education/concept/Sch%C3%BCttgutgeometrie>,
        <http://example.org/education/concept/Str%C3%B6mungsmechanik>,
        <http://example.org/education/concept/Verfahrenstechnik>,
        <http://example.org/education/concept/Viskosit%C3%A4t> ;
    dcterms:title "Übungsaufgaben Grundlagen der Verfahrenstechnik und Naturstofftechnik 1-1 - MVT TU Dresden, AG Mechanische Verfahrenstechnik"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:8KGSsS03GigI a edu:LearningResource ;
    sim:similarTo oer:8M83gGt_sh-M,
