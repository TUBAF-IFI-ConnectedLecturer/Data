oer:3CjglHSmUuiY a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Braun> ;
    dcterms:description "Die Plattform-as-a-Service-(PaaS)-Anbieter stellen eine Umgebung für die Entwicklung und Ausführung von Anwendungen in der Cloud bereit, indem sie Infrastrukturdienste aufsetzen und Load Balancing, Autoscaling, Monitoring etc. zur Verfügung stellen. Durch die Nutzung von PaaS können Entwickler sich auf die Logik und den Inhalt der eigentlichen Anwendung konzentrieren, während Serverkonfiguration oder andere Voraussetzungen für die optimale Lauffähigkeit über die Cloud geregelt werden. Die Vorteile von PaaS liegen in der reduzierten Komplexität, Kostenersparnis und verbesserten Skalierbarkeit."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3CjglHSmUuiY" ;
    dcterms:subject <http://example.org/education/concept/Business_Process_Management_Services_%28BPM_PaaS%29>,
        <http://example.org/education/concept/Cloud-Anwendungen>,
        <http://example.org/education/concept/Cloud_Computing>,
        <http://example.org/education/concept/Datenbank_als_Dienstleistung_%28DBaaS%29>,
        <http://example.org/education/concept/Entwicklungsplattformen>,
        <http://example.org/education/concept/Funktion_als_Dienstleistung_%28FaaS%29>,
        <http://example.org/education/concept/Integrationsplattformen>,
        <http://example.org/education/concept/NoSQL-Datenbanken>,
        <http://example.org/education/concept/Platform_as_a_Service_%28PaaS%29>,
        <http://example.org/education/concept/Serverless_Computing> ;
    dcterms:title "Vorlesung Service and Cloud Computing"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

