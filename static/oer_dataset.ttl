oer:12dzA6j3dlUNY a edu:LearningResource ;
    sim:similarTo oer:12vRNpE3_gmA4,
        oer:99TopKFWKIMo ;
    dcterms:creator <http://example.org/education/person/Menzel> ;
    dcterms:description "Die Übung behandelt die Klassifikation von Rasterdaten mittels Maximum-Likelihood-Klassifikation und Hauptkomponentenanalyse, um eine Landnutzungsklassifikation durchzuführen. Durch die Anwendung dieser Verfahren können Lernende ein Polygon-Feature-Class erstellen, das lokale Regionen gleicher Klasse beschreibt. Die Übung vermittelt Kenntnisse über die Erstellung von Trainingsdaten, die Berechnung multivariater Klassenstatistiken und die Vektorisierung klassifizierter Raster."@de ;
    dcterms:format "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        "pptx" ;
    dcterms:identifier "12dzA6j3dlUNY" ;
    dcterms:subject <http://example.org/education/concept/Fernerkundung>,
        <http://example.org/education/concept/Geoinformationssysteme>,
        <http://example.org/education/concept/Hauptkomponentenanalyse>,
        <http://example.org/education/concept/Klassifikation>,
        <http://example.org/education/concept/Landnutzungsklassifikation>,
        <http://example.org/education/concept/Maximum-Likelihood-Klassifikation>,
        <http://example.org/education/concept/Principle_Component_Analysis_%28PCA%29>,
        <http://example.org/education/concept/Rasterdaten>,
        <http://example.org/education/concept/Satellitenbildverarbeitung>,
        <http://example.org/education/concept/Vektorisierung> ;
    dcterms:title "Grundlagen GIS Klassifikation von Rasterdaten"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:12ixojwyYa9ps a edu:LearningResource ;
    sim:similarTo oer:5TP4Rl2uTJEE,
        oer:6Uot3W5RSusA ;
    dcterms:description "Die Relation R(M) auf der Potenzmenge einer Menge M wird definiert durch RM = {(X, Y) | X ⊆ Y}. Die Reflexivität, Symmetrie und Transitivität dieser Relation werden gezeigt, um ihre Äquivalenzeigenschaften zu beweisen. Durch die Anwendung dieser Relation auf verschiedenen Mengen Mi können Äquivalenzklassen gebildet und ihre Mächtigkeit bestimmt werden."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "12ixojwyYa9ps" ;
    dcterms:subject <http://example.org/education/concept/%C3%84quivalenzrelation>,
        <http://example.org/education/concept/Algebra>,
