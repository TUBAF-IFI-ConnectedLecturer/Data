        <http://example.org/education/concept/Selbstbewusstsein>,
        <http://example.org/education/concept/Unterrichtsplanung>,
        <http://example.org/education/concept/Wissenschaftliches_Arbeiten> ;
    dcterms:title "Lernziel-Taxonomien für die Hochschullehre"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

oer:9AKlxKdT0z54 a edu:LearningResource ;
    sim:similarTo oer:9BDND88Y2yQA,
