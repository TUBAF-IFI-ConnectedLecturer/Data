        <http://example.org/education/concept/Ungleichungsnebenbedingungen>,
        <http://example.org/education/concept/constraint_qualifications>,
        <http://example.org/education/concept/lineare_Optimierung>,
        <http://example.org/education/concept/mathematische_Programmierung>,
        <http://example.org/education/concept/quadratische_Optimierung> ;
    dcterms:title "Optimierung für Mathematikerinnen Übung 14"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

