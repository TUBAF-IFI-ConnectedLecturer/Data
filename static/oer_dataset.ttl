        <http://example.org/education/concept/Spannungstensor>,
        <http://example.org/education/concept/Technische_Mechanik>,
        <http://example.org/education/concept/Werkstoffkunde>,
        <http://example.org/education/concept/Zugversuch> ;
    dcterms:title "AG Betriebsfestigkeit Technische Universitat Dresden Technische Mechanik I - Vorlesung WiSe 2019/20"@de ;
    dcterms:type <http://example.org/education/type/Vorlesungsfolien> .

oer:6pyf44GCfAf8 a edu:LearningResource ;
    sim:similarTo oer:74Nq4fv-LTNU ;
    dcterms:creator <http://example.org/education/person/Achtziger>,
        <http://example.org/education/person/K%C3%B6stner>,
        <http://example.org/education/person/Richert> ;
    dcterms:description "Die BIODIVina-Initiative untersucht die Bedeutung von Biodiversität und Ökosystemleistungen für die Anpassung an den Klimawandel im Weinbau. Durch die Vielfalt von Vegetationsdecke und Wurzelsystem können Ökosystemleistungen wie Erosionsschutz, Wasserinfiltration und Klimaregulation verbessert werden. Die Initiative bietet somit ein Potenzial für die Entwicklung nachhaltiger Weinbaupraktiken unter Berücksichtigung von Klimaänderungen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "6pyf44GCfAf8" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
