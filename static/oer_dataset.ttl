        <http://example.org/education/concept/Soziale_F%C3%A4higkeiten>,
        <http://example.org/education/concept/Wissen> ;
    dcterms:title "Fachdidaktik Biologie: Grundlagen - Vorlesung Übung (SS2025)"@de ;
    dcterms:type <http://example.org/education/type/Vorlesung> .

oer:5ktdqqT2hnWQ a edu:LearningResource ;
    dcterms:creator <http://example.org/education/person/Meier>,
        <http://example.org/education/person/Wulff> ;
    dcterms:description "Das Lehrmaterial behandelt die Biologie von Wasserflöhen als Teil des Planktons in stehenden Gewässern wie Weiher, Teich und See. Durch die Erkundung dieser kleinen Lebewesen sollen Schüler ihre Kenntnisse über den Bau und die Lebensweise von Wasserflöhen erweitern. Die Arbeitsmaterialien sind für den Biologie-Unterricht an Realschulen konzipiert."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "5ktdqqT2hnWQ" ;
