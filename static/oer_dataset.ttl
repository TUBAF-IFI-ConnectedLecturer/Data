        oer:9VxTJ5Pz1B-A,
        oer:9zjgA65FSAmg ;
    dcterms:description "Dieses Dokument behandelt die Grundlagen von GIS-Transformationen, einschließlich Fläche-zu-Punkt-, Punkt-in-Polygon- und Resampling-Transformationen, um Geoobjekte mit Attributen zu verarbeiten und abzufragen. Durch das Studium dieser Transformationen können Lernende Methoden zum Testen, ob ein Punkt innerhalb eines Polygons liegt, und Verfahren zur Ausdünnung von Liniendaten erlernen. Zudem werden Probleme der Fläche-zu-Fläche-Transformation und des Samplings von Geoobjekten behandelt."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3rDqYW55q8ks" ;
    dcterms:publisher <http://example.org/education/organization/TU_Bergakademie_Freiberg> ;
    dcterms:subject <http://example.org/education/concept/Algorithmus>,
        <http://example.org/education/concept/Aufl%C3%B6sung>,
        <http://example.org/education/concept/Datenverarbeitung>,
        <http://example.org/education/concept/GIS>,
        <http://example.org/education/concept/Geoinformatik>,
        <http://example.org/education/concept/Geometrie>,
        <http://example.org/education/concept/Interpolation>,
        <http://example.org/education/concept/Kartographie>,
        <http://example.org/education/concept/Polygon>,
        <http://example.org/education/concept/Raumbezug> ;
    dcterms:title "Grundlagen GIS"@de ;
    dcterms:type <http://example.org/education/type/Skript> .

