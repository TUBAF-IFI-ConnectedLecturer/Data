        <http://example.org/education/concept/Physical_Computing>,
        <http://example.org/education/concept/Programmierung>,
        <http://example.org/education/concept/Scratch>,
        <http://example.org/education/concept/Spieleentwicklung>,
        <http://example.org/education/concept/Steuereinheit> ;
    dcterms:title "Handreichung: Physical Computing 1. Kurzvorstellung"@de ;
    dcterms:type <http://example.org/education/type/Aufgabenblatt> .

oer:3aOKcgemVC_g a edu:LearningResource ;
    sim:similarTo oer:5GjzPU31wCEU,
        oer:5Q0kdAEb2iqY,
        oer:80T7TVMBvgtA,
        oer:8JSQ4YJATjoM,
        oer:8jEm1U5hXRPY ;
    dcterms:creator <http://example.org/education/person/Behl>,
        <http://example.org/education/person/Zylla> ;
    dcterms:description "Das Praktikum behandelt die induktive Wegmessung mit verschiedenen Sensoren und Materialien, um die Profilschwankungen und Drehzahlen von rotierenden Rädern zu bestimmen. Durch die Messungen werden die Kennlinien der Sensoren aufgenommen und die Abhängigkeit von den Materialien untersucht. Die Ergebnisse zeigen die Möglichkeiten und Grenzen der induktiven Wegmessung für verschiedene Anwendungen auf."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3aOKcgemVC_g" ;
    dcterms:publisher <http://example.org/education/organization/Massachusetts_Institute_of_Technology> ;
    dcterms:subject <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Ferromagnetismus>,
        <http://example.org/education/concept/Induktive_Wegmessung>,
        <http://example.org/education/concept/Informationstechnik>,
        <http://example.org/education/concept/LVDT-Messtaster>,
        <http://example.org/education/concept/Magnetisierungsverluste>,
        <http://example.org/education/concept/Oberfl%C3%A4chenprofil>,
        <http://example.org/education/concept/Rotierendes_Rad>,
        <http://example.org/education/concept/Sensor-_und_Sensorsignalauswertung>,
        <http://example.org/education/concept/Wirbelstromsensor> ;
    dcterms:title "Praktikum Sensor- und Sensorsignalauswertung"@de ;
    dcterms:type <http://example.org/education/type/Protokoll> .

oer:3fclyEjFcU3E a edu:LearningResource ;
    sim:similarTo oer:4NlrbBrv_hkE,
        oer:6QpZP5SScMe0,
        oer:9wAjsR0aqZ_M ;
    dcterms:creator <http://example.org/education/person/Grafe>,
        <http://example.org/education/person/Thun> ;
    dcterms:description "Die Lernenden sollen in die Lage versetzt werden, Stromstarken und Spannungen aus dem Kennlinienfeld abzulesen und diese Größen zu verwenden, um den Basisspannungsteiler zu berechnen. Sie erwerben Kompetenzen wie das Verständnis eines Bipolartransistors, einer Verstarkerschaltung und des Kennlinienfeldes sowie die Fähigkeit, das Kennlinienfeld zu analysieren. Durch diese Lerninhalte werden sie in der Lage sein, einen Basisspannungsteiler zu dimensionieren und eine Transistorverstarkerschaltung für einen gegebenen Transistor zu entwerfen."@de ;
    dcterms:format "application/pdf",
        "pdf" ;
    dcterms:identifier "3fclyEjFcU3E" ;
    dcterms:subject <http://example.org/education/concept/Arbeitspunkt>,
        <http://example.org/education/concept/Bipolartransistor>,
        <http://example.org/education/concept/Elektrochemie>,
        <http://example.org/education/concept/Elektrotechnik>,
        <http://example.org/education/concept/Kennlinienfeld>,
        <http://example.org/education/concept/Lernplattform>,
        <http://example.org/education/concept/Physiklaborant>,
        <http://example.org/education/concept/Signaltechnik>,
        <http://example.org/education/concept/Spannungsteiler>,
        <http://example.org/education/concept/Transistorverst%C3%A4rker> ;
    dcterms:title "Pflichtenheft Thun, Grafe"@de ;
    dcterms:type <http://example.org/education/type/Pflichtenheft> .

